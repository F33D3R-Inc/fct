{
  "name": "facet",
  "displayName": "Facet",
  "description": "Syntax highlighting and language support for the Facet application language (.fct), backed by the `facet lsp` language server.",
  "version": "1.0.0",
  "publisher": "facet",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:facet"],
  "contributes": {
    "languages": [
      {
        "id": "facet",
        "aliases": ["Facet", "facet"],
        "extensions": [".fct"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "facet",
        "scopeName": "source.facet",
        "path": "./syntaxes/facet.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Facet",
      "properties": {
        "facet.serverPath": {
          "type": "string",
          "default": "facet",
          "description": "Path to the `facet` binary used to run the language server (`facet lsp`)."
        }
      }
    }
  }
}
