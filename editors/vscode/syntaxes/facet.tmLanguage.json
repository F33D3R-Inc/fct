{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Facet",
  "scopeName": "source.facet",
  "fileTypes": ["fct"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotations" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#typenames" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.facet"
    },
    "strings": {
      "name": "string.quoted.double.facet",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.facet" },
        {
          "name": "meta.interpolation.facet",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.facet" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.facet" } },
          "patterns": [
            { "include": "#builtins" },
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#typenames" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "annotations": {
      "match": "@(client|server|secret|optimistic)\\b",
      "name": "storage.modifier.annotation.facet"
    },
    "numbers": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.facet"
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(app|auth|entity|enum|state|derive|policy|action|job|component|layout|theme|view)\\b",
          "name": "keyword.declaration.facet"
        },
        {
          "match": "\\b(for|in|where|by|limit|if|requires|check|on|start|every|at|desc|asc)\\b",
          "name": "keyword.control.facet"
        },
        {
          "match": "\\b(box|text|button|input|select|option|form|upload|use|slot|link|add|set|remove|clear|bind|placeholder|label)\\b",
          "name": "keyword.other.node.facet"
        }
      ]
    },
    "types": {
      "match": "\\b(int|text|bool|money|date)\\b",
      "name": "support.type.facet"
    },
    "constants": {
      "match": "\\b(true|false|actor|role|verified)\\b",
      "name": "constant.language.facet"
    },
    "builtins": {
      "match": "\\b(now|rand|count|sum|abs|min|max|floor|round|money|len|upper|lower|trim|year|month|day)\\b(?=\\s*\\()",
      "name": "support.function.builtin.facet"
    },
    "operators": {
      "match": "->|=>|==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!]",
      "name": "keyword.operator.facet"
    },
    "typenames": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.facet"
    }
  }
}
