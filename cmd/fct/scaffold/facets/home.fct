# Home — your landing facet. It composes standard-library facets (Card, Badge,
# Button) to prove the whole catalog is available out of the box. Edit the looks
# block, save, and `fct dev` reloads it live. The full catalog — Avatar, PostCard,
# LiveChat, TipGoal, VideoControls, … — is ready to use the same way.

facet Home:
    looks:
        <section class="fa-home">
            <h1>It works.</h1>
            <Card title="Facet Architecture">
                <Badge label="live" tone="accent" />
                <p>This page is server-rendered and pushed over SSE. The heart below
                   is a live facet — click it and the server re-renders just that
                   button. Facets live in <code>facets/</code>.</p>
                <a href="/about" data-nav>About this app →</a>
            </Card>
        </section>
