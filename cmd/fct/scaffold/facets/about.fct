# About — a second route. Navigating here from Home via a data-nav link swaps this
# content in WITHOUT a page reload; the SSE connection stays open the whole time.

facet About:
    looks:
        <section class="fa-home">
            <Card title="About">
                <p>This page was reached by client-side navigation — no full reload.
                   The server rendered it; the runtime swapped it into the page.</p>
                <a href="/" data-nav>← Back home</a>
            </Card>
        </section>
