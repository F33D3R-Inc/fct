# LikeButton — a live facet. Clicking it POSTs `post.like` to /events. The
# `when post.like:` block below IS the handler: it declares that the server
# re-renders this facet and swaps it in. The app only supplies the new state
# (app/like.go) — it never builds events or facet-id strings by hand.

facet LikeButton:
    what:
        post: Post
        count: int
        liked: bool

    looks:
        <button class="post-action post-action--like{ if liked } active{ end }" data-action="post.like" data-post-id="{post.id}" aria-label="Like">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="{ if liked }currentColor{ else }none{ end }" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
            if count:
                <span class="btn-like__count">{count}</span>
        </button>

    when post.like:
        replace LikeButton
