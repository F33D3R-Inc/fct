package app

import (
	"html/template"

	"github.com/F33D3R-Inc/fct/fa"
)

// registerRoutes maps URLs to pages. A normal load returns the full page; a
// data-nav link (see the .fct files) is swapped in WITHOUT a reload, so the SSE
// connection and the live LikeButton survive across pages. rc.Param("…") reads
// path parameters like "/u/:handle".
func registerRoutes(app *fa.App) {
	app.Route("/", "Home", func(rc fa.RouteCtx) template.HTML {
		// Home plus the live like button rendered at its current server state.
		return catalog.MustRender("Home", nil) + likeFragment()
	})
	app.Route("/about", "About", func(rc fa.RouteCtx) template.HTML {
		return catalog.MustRender("About", nil)
	})
}
