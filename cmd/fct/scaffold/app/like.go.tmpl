package app

import (
	"html/template"

	"github.com/F33D3R-Inc/fct/fa"
)

// The "like" feature, whole, in one file. Note what is NOT here: no facet-id
// strings, no fa.Event construction, no manual re-render-and-push. The facet's
// `when post.like:` block (facets/like_button.fct) declares all of that. This
// file supplies only the part the language can't: the server-authoritative
// state and how a click changes it.

// post is server-authoritative state: the real state lives here, not in the
// browser. A real app would load this from a store keyed by the request.
var post = struct {
	ID    string
	Count int
	Liked bool
}{ID: "p1", Count: 3}

// likeData is the data the LikeButton renders from — used both for the initial
// page (routes.go) and for the live re-render after a click.
func likeData() map[string]any {
	return map[string]any{
		"Post":  map[string]any{"ID": post.ID},
		"Count": post.Count,
		"Liked": post.Liked,
	}
}

// likeFragment renders the button at its current state, for the initial page.
func likeFragment() template.HTML {
	return catalog.MustRender("LikeButton", likeData())
}

// registerLike wires the post.like client event to the facet's `when` block via
// AutoWire. The reducer is the whole handler: toggle state, return the new data.
// AutoWire renders LikeButton, derives the facet-id from that render, and pushes
// the swap — none of which this file has to spell out.
func registerLike(app *fa.App) {
	app.AutoWire(catalog, "post.like", func(ctx fa.Ctx) (any, error) {
		if post.Liked {
			post.Liked, post.Count = false, post.Count-1
		} else {
			post.Liked, post.Count = true, post.Count+1
		}
		return likeData(), nil
	})
}
