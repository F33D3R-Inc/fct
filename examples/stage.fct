# Stage — the canvas/tile/sprite scene node (ast.Stage/ast.Sprite), the first
# piece of the F33D3R game-engine work: a `stage` draws a tile background and
# one or more `sprite` layers on an actual <canvas>, reactive exactly the way
# a `for` is — a sprite's collection changing (a piece moving) redraws it live
# on every connected client, with no extra wiring, the same free liveness
# every other entity write already gets.
#
#   export FACET_DATABASE_URL=postgres://user:pw@localhost:5432/db
#   facet run examples/stage.fct

app StageDemo:
    entity Piece:
        id: int
        x: int
        y: int
        facing: int
        name: text
        icon: text

    state background: text = "1,2,3,4,3,2,1"

    action spawn(px: int, py: int, label: text):
        add Piece { x: px, y: py, facing: 0, name: label, icon: "dot" }

    action nudge(id: int, dx: int, dy: int):
        set Piece(id).x = Piece(id).x + dx
        set Piece(id).y = Piece(id).y + dy

    view Main at "/":
        box:
            text "Stage demo — {count(Piece)} pieces on the board"
            stage width 400 height 300:
                tiles from background
                sprite for m in Piece at (m.x, m.y) facing m.facing image m.icon label "{m.name}"
            button "spawn a piece" -> spawn(40, 40, "hero")
            button "nudge piece 1 right" -> nudge(1, 10, 0)
