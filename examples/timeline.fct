# Timeline — the reference for components inside reactive lists (docs/REACTIVITY.md).
#
# This is the x.com shape: a feed of items, each its own stateful component. The
# `for t in feed.data` is reactive (feed is an async query), so it lifts to a client
# region; inside it, `<Tweet .../>` is a CHILD FACET CALL. The compiler emits a
# fill-renderable client `view` for Tweet, and the runtime instantiates one per row
# in the browser — each with its OWN signals (liked), its own bindings, and its own
# click handler — passing the row object's fields as props. Like React/Svelte
# components in a list, but compiled, server-authoritative by transport (the feed is
# a normal endpoint), and fine-grained.

facet Tweet:
    what:
        author: str
        text: str
    state:
        liked = false

    actions:
        like:
            liked = !liked

    looks:
        <article class="tweet">
            <strong class="tweet__author">{author}</strong>
            <p class="tweet__text">{text}</p>
            <button class="tweet__like" on:click="like" aria-pressed="{liked}">♥</button>
        </article>

facet Timeline:
    query:
        feed from "/api/feed"

    looks:
        <div class="timeline">
            <p hidden="{!feed.loading}">Loading your timeline…</p>
            for t in feed.data:
                <Tweet author="{t.author}" text="{t.text}"/>
        </div>
