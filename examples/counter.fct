# Counter — the Brick 4 reference for client reactivity (docs/REACTIVITY.md).
#
# This is the wedge: a facet that runs FULLY CLIENT-SIDE with zero round-trip.
# The compiler bakes the reactive graph into the output — no virtual DOM, no diff,
# no shipped framework — so clicking the button updates the count instantly, with
# no server involved.
#
#   state:    local reactive values (signals), each with an initial value.
#   actions:  named, reusable handlers that mutate signals (the "controller").
#   on:click  on an element wires a DOM event to an action.
#   {signal}  in looks: becomes a live binding — the compiler marks the node and
#             the runtime patches exactly it when the signal changes.
#
# Persistent, shared, or authorization-gated state still belongs in what:/when:
# (server-authoritative — the security moat). state: is for ephemeral local UI.

facet Counter:
    state:
        count = 0

    actions:
        increment:
            count = count + 1
        decrement:
            count = count - 1
        reset:
            count = 0

    looks:
        <div class="counter">
            <button on:click="decrement" aria-label="Decrease">−</button>
            <output class="counter__value">{count}</output>
            <button on:click="increment" aria-label="Increase">+</button>
            <button on:click="reset" class="counter__reset">reset</button>
        </div>
