# The smallest program that IS the Facet thesis.
#
# Two state cells, two actions, one view — and NOTHING in this file says
# "frontend" or "backend". The compiler reads the placement calculus off the
# state lifecycle:
#
#   count  -> authoritative (the default)        -> lives on the SERVER
#   bonus  -> @client (ephemeral, local)         -> lives on the CLIENT
#
# From that, action placement falls out automatically:
#
#   increment  writes count  -> SERVER action  -> round-trips, authoritative
#   addBonus   writes bonus  -> CLIENT action  -> runs locally, zero network
#
# `total` is a derive: a named value the compiler inlines and recomputes wherever
# it is read. It spans both domains (count is server, bonus is client), so it can
# only be computed where every input is visible — the client, off its mirror of
# server state — and it refreshes whenever either side changes. You never said
# where it runs. Same syntax, two execution domains, fine-grained updates —
# chosen by the compiler, not written by you.

app Counter:
    state count: int = 0
    state bonus: int = 0 @client

    derive total: int = count + bonus

    action increment:
        count = count + 1

    action addBonus:
        bonus = bonus + 1

    view Main:
        box:
            text "Server count: {count}"
            text "Client bonus: {bonus}"
            text "Total (count + bonus): {total}"
            button "increment (server, round-trips)" -> increment
            button "add bonus (client, no network)" -> addBonus
