# Forecast — the Brick 11 reference for async / queries (docs/REACTIVITY.md).
#
# A `query:` declares an async fetch the runtime exposes to the reactive layer as a
# structured value with three fields:
#
#   forecast.loading   true until the fetch settles
#   forecast.error     true if it failed
#   forecast.data      the decoded JSON body (null until loaded)
#
# The runtime seeds {loading:true} on mount, fetches once, then writes the result
# and flushes — so the loading / error / data states are just Brick-8 show bindings
# and a Brick-4 text binding over a query value. This is React's data-fetching
# story (loading/error/data), server-authoritative by transport: `/api/forecast`
# is a normal same-origin endpoint the app's backend serves.

facet Forecast:
    query:
        forecast from "/api/forecast"

    looks:
        <div class="forecast">
            <p class="forecast__status" hidden="{!forecast.loading}">Loading the forecast…</p>
            <p class="forecast__status" hidden="{!forecast.error}">Could not load the forecast.</p>
            <p class="forecast__summary" hidden="{forecast.loading}">{forecast.data.summary}</p>
        </div>
