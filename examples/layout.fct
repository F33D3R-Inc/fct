# Slots — a layout facet (Card) wraps arbitrary content via `slot:`.
# A parent uses the child in BLOCK form (<Card …> … </Card>); the content
# between the tags renders in the PARENT's data scope and is injected at the
# child's slot. When the child is used self-closing/empty, the slot's default
# content shows instead.

facet Card:
    what:
        title: str
    looks:
        <section class="card">
            <h3 class="card__title">{title}</h3>
            <div class="card__body">
                slot:
                    <p class="card__empty">No content.</p>
            </div>
        </section>

facet Avatar:
    what:
        user: User
        size: str
    looks:
        <img class="avatar avatar--{size}" src="{user.url}" alt="@{user.handle}" />

facet Page:
    what:
        user: User
    looks:
        <main class="page">
            <Card title="Welcome">
                <p>Hello, {user.name}!</p>
                <Avatar user="{user}" size="small" />
            </Card>
        </main>
