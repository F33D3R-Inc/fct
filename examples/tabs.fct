# Tabs — the reference for reactive structural control flow (docs/REACTIVITY.md).
#
# `if tab == "home"` is a condition over a state SIGNAL, so the compiler lifts it
# to a client region (<fa-if>). Unlike a `hidden=""` show-binding (which keeps both
# branches in the DOM), a region truly MOUNTS the active branch and UNMOUNTS the
# other — the inactive panel is not in the document at all. Switching tabs swaps
# which subtree exists, exactly like React's conditional rendering. `else:` gives
# the alternate branch.
#
# A condition over a what: field (server data) still renders on the server as a
# static {{if}} — only reactive conditions become live regions.

facet Tabs:
    state:
        tab = "home"

    actions:
        showHome:
            tab = "home"
        showSettings:
            tab = "settings"

    looks:
        <div class="tabs">
            <nav class="tabs__nav">
                <button on:click="showHome">Home</button>
                <button on:click="showSettings">Settings</button>
            </nav>
            if tab == "home":
                <section class="tabs__panel">Welcome home.</section>
            else:
                <section class="tabs__panel">Your settings live here.</section>
        </div>
