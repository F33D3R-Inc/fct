# Composition example — the keystone of authoring real UIs.
#
# ProfileHeader COMPOSES two smaller facets, Avatar and FollowButton, with plain
# <Child .../> tags. The rendered output nests their data-facet-ids:
#
#   ProfileHeader:user:42
#   ├── Avatar:user:42
#   └── FollowButton:target:42
#
# so clicking Follow re-renders ONLY the button — the avatar and name are
# untouched. No diffing, no keys, no client reconciliation.

facet Avatar:
    what:
        user: User
        size: str
    looks:
        <img class="avatar avatar--{size}" src="{user.url}" alt="@{user.handle}" />

facet FollowButton:
    what:
        target: User
        following: bool
    looks:
        <button class="btn-follow{ if following } btn-follow--on{ end }" data-action="follow.toggle" data-fa-optimistic="btn-follow--on" data-target-id="{target.id}">
            if following:
                Following
            else:
                Follow
        </button>
    when follow.changed:
        replace FollowButton with event.payload

facet ProfileHeader:
    what:
        user: User
        following: bool
    looks:
        <header class="profile-header">
            <Avatar user="{user}" size="large" />
            <div class="profile-header__meta">
                <span class="display-name">{user.name}</span>
                <span class="handle">@{user.handle}</span>
            </div>
            <FollowButton target="{user}" following="{following}" />
        </header>
