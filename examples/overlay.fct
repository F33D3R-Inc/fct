# Overlays & typeahead — two interactive view nodes.
#
#   - `overlay bind <boolCell>:` is a modal layer shown while the bound @client bool
#     is true. A dimmed backdrop centers a panel of the children; clicking the
#     backdrop sets the cell false (closes it). Open it from a client action that
#     sets the cell true. No new control flow — it reuses the reactive cell.
#   - `typeahead bind <textCell> from <Entity>.<field>` is a text input wired to a
#     native completion list of the field's existing values, so the actor gets
#     suggestions as they type. The chosen text binds to the cell like any input.
#
# Run it:  facet dev examples/overlay.fct
app Tagger:
    state composing: bool = false @client
    state tagQuery: text = "" @client
    state draft: text = "" @client

    entity Tag:
        id: int
        name: text
    entity Note:
        id: int
        body: text
        tag: text

    action openComposer():
        composing = true

    action save(body: text, tag: text):
        check body != "" "write something first"
        add Note { body: body, tag: tag }
        add Tag { name: tag }

    view Home at "/":
        box:
            button "New note" -> openComposer()
            for n in Note by id desc limit 20:
                row:
                    text "{n.body}"
                    badge "{n.tag}"

            # The composer is a modal. It closes on a backdrop click; `save` adds the
            # note and records the tag, which then feeds the typeahead's suggestions.
            overlay bind composing:
                box:
                    text "New note"
                    input bind draft placeholder "what's on your mind?"
                    typeahead bind tagQuery from Tag.name placeholder "tag (suggested as you type)"
                    button "Save" -> save(draft, tagQuery)
