# A multi-file Facet app. The data + behavior live in their own module
# (posts.fct); this file pulls them in with `import` and adds auth and the UI.
# The compiler merges every module into one graph before placement, so this
# compiles, runs, and is hardened exactly like a single-file app — it is just
# kept in small files that point to each other instead of one growing file.
#
#   facet build examples/modular/app.fct   # see the merged IR
#   facet dev   examples/modular/app.fct   # run it (editing posts.fct hot-reloads too)
#
# The first account to sign up becomes the admin.

import "posts.fct"

app Modular:
    auth

    state username: text = "" @client
    state password: text = "" @client
    state draft: text = "" @client

    view Home at "/":
        box:
            text "{postCount} posts"
            if actor == "guest":
                input bind username placeholder "username"
                input bind password placeholder "password"
                button "sign up" -> signup(username, password)
                button "log in" -> login(username, password)
            if actor != "guest":
                text "signed in as {actor} ({role})"
                button "log out" -> logout
                input bind draft placeholder "what's happening?"
                button "post" -> post(draft)
            for p in Post by created desc limit 50:
                box:
                    text "{p.author}: {p.body}"
                    button "👎 {p.dislikes}" -> dislike(p.id)
