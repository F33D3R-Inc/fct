# A reusable module ("facet"): the Post data plus the behavior that goes with it
# — including a self-contained "dislike" capability (its own field + its own
# server action). Another app pulls this in with `import "posts.fct"` and gets
# all of it at once. Placement is still computed over the merged graph, so this
# module never has to know that `post`/`dislike` run on the server while the UI
# that calls them runs on the client.
#
# A module is itself a valid app, so you can build/test it on its own:
#   facet build examples/modular/posts.fct

app Posts:
    entity Post:
        id: int
        author: text
        body: text
        dislikes: int
        created: int

    derive postCount: int = count(Post)

    action post(body: text):
        check body != "" "say something first"
        add Post { author: actor, body: body, dislikes: 0, created: now() }

    action dislike(id: int) @optimistic:
        set Post(id).dislikes = Post(id).dislikes + 1
