# The structural brick. A wireframe carves the surface into typed sockets and
# lays them out in a `frame`. It is pure structure — no data, no behavior. Each
# socket declares the kind of facet allowed to snap in; the studs only fit if the
# kinds match. The frame is a `row`, so the three regions sit side by side on a
# wide window and stack into one column on a narrow one.
import "nav.fct"
import "feed.fct"
import "trends.fct"

wireframe Shell:
    socket nav: ui
    socket feed: data
    socket aside: ui

    frame:
        row:
            box:
                slot nav
            box:
                slot feed
            box:
                slot aside
