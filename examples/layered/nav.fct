# A ui facet. It snaps into the `nav` socket (declared `ui`) and contributes the
# left rail's content. A ui facet is skin and presentation — it may not declare
# durable data; that belongs in a data facet.
ui Nav in nav:
    content:
        text "𝕏 · F33D3R"
        link "Home" -> "/"
        if actor != "guest":
            text "signed in as {actor}"
            button "log out" -> logout
