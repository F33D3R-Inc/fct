# The baseplate. A playground holds global concerns — auth and the theme — and
# mounts exactly one wireframe. It accepts nothing else: a data or ui facet can't
# sit on bare playground, only a wireframe can. Run this file:
#
#   facet dev examples/layered/playground.fct
#
# Everything else (the wireframe, the ui/data bricks) is pulled in by import and
# composited into ONE surface. The layering is how the app is built, never how it
# looks.
import "wireframe.fct"

playground X:
    auth

    theme:
        bg "#15202b"
        fg "#f7f9f9"
        muted "#8b98a5"
        accent "#1d9bf0"
        border "#38444d"
        card-border "#38444d"
        radius "16px"
        maxwidth "1100px"

    mount Shell
