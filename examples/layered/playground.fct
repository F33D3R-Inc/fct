# The baseplate. It mounts two screens — a guest-only login screen and a
# member-only home/feed — and the runtime routes between them by their guards:
# a guest hitting "/" is bounced to "/login"; a member hitting "/login" is bounced
# to "/". Login and logout just reload; the guards do the routing. Run this file:
#
#   facet dev examples/layered/playground.fct
import "login.fct"
import "wireframe.fct"

playground X:
    auth

    theme:
        bg "#15202b"
        fg "#f7f9f9"
        muted "#8b98a5"
        accent "#1d9bf0"
        border "#38444d"
        card-border "#38444d"
        radius "16px"
        maxwidth "1100px"

    mount Auth  at "/login" requires guest
    mount Shell at "/"      requires member
