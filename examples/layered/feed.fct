# The feed — a data facet snapped into the `feed` socket. It owns the durable
# data, the server actions, and the authorization, plus its own content. This
# screen is member-only, so the content has no guest branch: a guest never reaches
# it (the home screen's guard redirects them to /login). The member/guest policies
# defined here are global, so the playground's screen guards can use them.
data Feed in feed:
    entity Tweet:
        id: int
        author: text
        body: text
        likes: int
        created: int

    state draft: text = "" @client

    derive tweetCount: int = count(Tweet)
    derive totalLikes: int = sum(Tweet.likes)

    # App-wide auth predicates. They are global once merged, so the playground's
    # `requires guest` / `requires member` screen guards resolve to them.
    policy guest:
        actor == "guest"

    policy member:
        actor != "guest"

    policy mine(id: int):
        actor == Tweet(id).author

    action tweet(body: text):
        requires member
        add Tweet { author: actor, body: body, likes: 0, created: now() }

    action like(id: int):
        requires member
        set Tweet(id).likes = Tweet(id).likes + 1

    action delete(id: int):
        requires mine(id)
        remove Tweet(id)

    content:
        text "Home · {tweetCount} tweets · {totalLikes} likes"
        box:
            input bind draft placeholder "what's happening?"
            button "post" -> tweet(draft)
        for t in Tweet by created desc limit 50:
            box:
                text "{t.author} · {t.body}"
                row:
                    button "like" -> like(t.id)
                    text "{t.likes} likes"
                if actor == t.author:
                    button "delete" -> delete(t.id)
