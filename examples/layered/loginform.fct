# The sign-in form — a ui facet that owns its own client fields and snaps into the
# Auth wireframe's `form` socket. login/signup are auth builtins; on success they
# reload, and the member is routed to "/" by the home screen's guard.
ui LoginForm in form:
    state username: text = "" @client
    state password: text = "" @client

    content:
        text "𝕏 · F33D3R"
        text "Sign in to X"
        box:
            input bind username placeholder "username"
            input bind password placeholder "password"
            button "log in" -> login(username, password)
            button "sign up" -> signup(username, password)
