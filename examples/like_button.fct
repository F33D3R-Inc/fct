# LikeButton — the v0 walking-skeleton reference Facet.
#
# Block keywords (canonical, see docs/TAXONOMY.md):
#   what:  the data the facet needs
#   looks: the rendered template
#   when:  an event handler (subscription is implied)
#
# HTML tags are closed explicitly (`</button>`). Indentation inside `looks:`
# is structural ONLY for `if` / `for` control lines — never for auto-closing
# HTML. See docs/FDL-v0.md.

facet LikeButton:
    what:
        post: Post
        count: int
        liked: bool

    looks:
        <button class="post-action post-action--like{ if liked } active{ end }" data-action="post.like" data-fa-optimistic="active" data-post-id="{post.id}" aria-label="Like">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="{ if liked }currentColor{ else }none{ end }" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
            if count:
                <span class="btn-like__count">{count}</span>
        </button>

    when post.like_toggled:
        replace LikeButton with event.payload
