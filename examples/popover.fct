# Popover — an anchored dropdown menu, `overlay`'s sibling.
#
#   - `overlay bind <boolCell>:` (examples/overlay.fct) is a modal layer: a dimmed
#     backdrop CENTERS a panel over the whole viewport.
#   - `popover bind <boolCell>:` is the same reactive-cell contract — a layer
#     shown while its bound @client bool is true, closed by an outside click or
#     by flipping the cell again — but the panel is positioned BESIDE whatever
#     rendered immediately before it (its anchor), not centered. A `popover`
#     written as the first node in a block has no previous sibling to anchor
#     beside and is refused at parse/compile time.
#
# Run it:  facet dev examples/popover.fct
# Then open a browser, click the "…" button, and confirm the menu opens next to
# it — not centered, not full-screen.
app Cards:
    state menuOpen: bool = false @client

    action pin():
        check true "noop"

    view Home at "/":
        box:
            text "A post with a menu"
            row:
                text "Some post content sits here, to its left."
                # The trigger. A `toggle` is the only node that may write a
                # @client bool cell, so this button IS the writer `menuOpen`
                # needs; the popover right after it is the reader, anchored
                # beside it rather than centered over the page.
                toggle bind menuOpen label "…"
                popover bind menuOpen:
                    box:
                        button "Pin" -> pin()
                        text "Menu item two"
                        toggle bind menuOpen label "Close"
