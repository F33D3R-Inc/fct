# Poll — the Brick 5 reference for client-derived values (docs/REACTIVITY.md).
#
# `total` is a computed `what:` field, but every term is a state signal — so the
# compiler classifies it as CLIENT-DERIVED and recomputes it in the browser when
# either signal changes. No round-trip: voting updates both the tallies and the
# derived total instantly.
#
# This is the thesis made literal: a computed field IS a reactive derived value
# (a signal). The same `name = expr` you already write for server-side computed
# fields becomes fine-grained client reactivity when its inputs are signals.

facet Poll:
    state:
        yes = 0
        no = 0

    what:
        total = yes + no

    actions:
        voteYes:
            yes = yes + 1
        voteNo:
            no = no + 1

    looks:
        <div class="poll">
            <button on:click="voteYes">Yes ({yes})</button>
            <button on:click="voteNo">No ({no})</button>
            <p class="poll__total">{total} votes</p>
        </div>
