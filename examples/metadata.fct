# Page metadata + design-system control. Two presentation features:
#
#   - `meta title "…"` / `meta description "…"` per view → rendered server-side into
#     <title>, <meta name=description>, and OpenGraph tags (og:title/description).
#     The strings interpolate, so a dynamic route gets a per-record title for SEO
#     and link previews — and it stays correct across SPA navigation.
#   - `theme dark:` declares token overrides applied under the OS dark scheme
#     (@media prefers-color-scheme: dark). One declarative source restyles the whole
#     UI for both light and dark — design-system control, not ad-hoc CSS.
#
# Run it:  facet dev examples/metadata.fct  (toggle your OS appearance to see dark).
app Blog:
    theme:
        bg "#ffffff"
        fg "#16181c"
        accent "#1d9bf0"
        card-border "#eceef0"
    theme dark:
        bg "#000000"
        fg "#e7e9ea"
        accent "#1d9bf0"
        card-border "#2f3336"

    state draftTitle: text = "" @client
    state draftBody: text = "" @client

    entity Post:
        id: int
        title: text
        body: text

    action publish(title: text, body: text):
        check title != "" "a post needs a title"
        add Post { title: title, body: body }

    view Home at "/":
        meta title "The Blog — latest posts"
        meta description "Everything we have published, newest first."
        box:
            form "Publish" -> publish(draftTitle, draftBody):
                input bind draftTitle placeholder "title"
                input bind draftBody placeholder "body"
            for p in Post by id desc limit 20:
                box:
                    text "{p.title}"

    view Read at "/post/:id":
        meta title "{Post(id).title} — The Blog"
        meta description "{Post(id).body}"
        box:
            text "{Post(id).title}"
            text "{Post(id).body}"
