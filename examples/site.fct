# Site — the Brick 10 reference for routing (docs/REACTIVITY.md).
#
# `route` is a built-in reactive signal seeded from the URL path and updated on
# every client navigation (the runtime already swaps <a data-nav> links without a
# reload, keeping the one SSE connection alive). A client router then falls straight
# out of Brick 8: each section is shown/hidden by a boolean-attribute binding on the
# route. Links that match the current path get .fa-active + aria-current for free.
#
# No server route table to wire, no per-page reload — the whole site is one facet
# that reveals the section matching `route`.

facet Site:
    looks:
        <div class="site">
            <nav class="site__nav">
                <a href="/" data-nav>Home</a>
                <a href="/about" data-nav>About</a>
                <a href="/contact" data-nav>Contact</a>
            </nav>

            <section class="site__page" hidden="{route != "/"}">
                <h1>Home</h1>
                <p>Welcome to the one-facet site.</p>
            </section>
            <section class="site__page" hidden="{route != "/about"}">
                <h1>About</h1>
                <p>Routing is just a reactive `route` signal plus a show binding.</p>
            </section>
            <section class="site__page" hidden="{route != "/contact"}">
                <h1>Contact</h1>
                <p>Every section lives in the DOM; only the matching one is shown.</p>
            </section>
        </div>
