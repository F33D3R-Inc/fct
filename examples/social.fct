# Social — proto-f33d3r: built-in auth, two routed pages, a query feed, and the
# server clock — the whole thing in one file. Placement is computed; nothing here
# says "frontend" or "backend".
#
#   export FACET_DATABASE_URL=postgres://user:pw@localhost:5432/db
#   facet run examples/social.fct
#
# The first account to sign up becomes the admin.

app Social:
    auth

    entity Post:
        id: int
        author: text
        body: text
        created: int

    state username: text = "" @client
    state password: text = "" @client
    state draft: text = "" @client

    derive postCount: int = count(Post)

    action post(body: text):
        add Post { author: actor, body: body, created: now() }

    view Home at "/":
        box:
            text "{postCount} posts"
            link "about" -> "/about"
            if actor == "guest":
                input bind username placeholder "username"
                input bind password placeholder "password"
                button "sign up" -> signup(username, password)
                button "log in" -> login(username, password)
            if actor != "guest":
                text "signed in as {actor} ({role})"
                button "log out" -> logout
                input bind draft placeholder "what's happening?"
                button "post" -> post(draft)
            for p in Post by created desc limit 50:
                box:
                    text "{p.author}: {p.body}"

    view About at "/about":
        box:
            text "Social — a tiny feed built with Facet."
            link "back home" -> "/"
