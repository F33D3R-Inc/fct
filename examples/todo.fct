# Todo — the Brick 6 reference for reactive lists (docs/REACTIVITY.md).
#
# `items` is a list-valued signal. The `for item in items` loop over it compiles
# to an empty <fa-for> host plus a client item template; the runtime renders each
# item and reconciles the host's children BY KEY when the list changes — reusing
# unchanged nodes, inserting/removing/reordering the rest. No virtual DOM diff of
# the whole tree, no round-trip.
#
# Appending is `items = items + [draft]` — the `+` concatenates the list with a
# one-element list (the client evaluator mirrors the compiler's `add`). `count`
# is a client-derived value (Brick 5) over the list length is not yet a builtin,
# so we track it as its own signal for now.

facet Todo:
    state:
        items = []

    actions:
        addCoffee:
            items = items + ["Coffee"]
        addTea:
            items = items + ["Tea"]
        clear:
            items = []

    looks:
        <div class="todo">
            <button on:click="addCoffee">+ Coffee</button>
            <button on:click="addTea">+ Tea</button>
            <button on:click="clear">clear</button>
            <ul class="todo__list">
                for item in items:
                    <li>{item}</li>
            </ul>
        </div>
