# Feed — the reference for virtualized lists (docs/REACTIVITY.md).
#
# `for row in rows virtual 48` windows the list: only the rows intersecting the
# scroll viewport (plus a small overscan) are ever in the DOM, each a fixed 48px
# tall. A 100k-row list stays O(viewport) in the DOM — the reconciler keys, reuses,
# and minimally moves the visible rows (LIS) on scroll, so scrolling a huge feed
# stays smooth. The app sizes the scroll area (here the `.feed` height); the
# windowed <fa-for> fills it.
#
# Drop `virtual 48` and it is an ordinary keyed reactive list — same reconciler,
# every row rendered. Add it when the list can grow large.

facet Feed:
    state:
        rows = ["Alice", "Bob", "Carol", "Dave", "Erin"]

    actions:
        clear:
            rows = []

    looks:
        <div class="feed" style="height:400px">
            for row in rows virtual 48:
                <div class="feed__row">{row}</div>
        </div>
