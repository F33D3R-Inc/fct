# Greeter — the Brick 9 reference for forms / two-way binding (docs/REACTIVITY.md).
#
# `bind:value="name"` ties an input to the `name` signal BOTH ways: every keystroke
# writes the signal (the runtime reads the control on `input`), and any change to
# the signal writes the control back (skipping a focused field so the caret never
# jumps). `greeting` is a client-derived value (Brick 5) over the signal, so the
# paragraph updates live as you type — no round-trip, no framework.
#
# Only a `state:` signal can receive a binding: what: fields are server-authoritative
# and a query/route value is read-only, so neither can absorb a user's keystrokes.

facet Greeter:
    state:
        name = ""

    what:
        greeting = "Hello, " + name + "!"

    looks:
        <form class="greeter">
            <label class="greeter__label">
                Your name
                <input type="text" bind:value="name" placeholder="type here…">
            </label>
            <p class="greeter__out">{greeting}</p>
        </form>
