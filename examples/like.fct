# Like — the Brick 8 reference for attribute / class / show bindings (docs/REACTIVITY.md).
#
# Brick 4 could only patch TEXT. Brick 8 lets a signal drive an *attribute*: the
# compiler bakes the initial value, marks the element data-fa-bind-attr, and the
# runtime re-evaluates it on every change. Two flavours:
#
#   value attrs   aria-pressed="{liked}"   → setAttribute (string value)
#   boolean attrs hidden="{!liked}"        → toggled by PRESENCE — this is "show":
#                                            `hidden` true removes the node from view,
#                                            and disabled="false" (the foot-gun) can
#                                            never happen.
#
# Together they fill the heart on a like button with zero hand-written JS.

facet LikeButton:
    state:
        liked = false
        likes = 0

    actions:
        toggle:
            liked = !liked
            likes = likes + 1

    looks:
        <button class="like" on:click="toggle" aria-pressed="{liked}">
            <span class="like__heart like__heart--full" hidden="{!liked}">♥</span>
            <span class="like__heart like__heart--empty" hidden="{liked}">♡</span>
            <span class="like__count">{likes}</span>
        </button>
