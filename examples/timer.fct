# after — a client-only, fire-once timer, for exactly the thing an action
# alone cannot do: run later. An action's placement is inferred from what it
# touches (see LANGUAGE.md), but nothing makes it run on a delay — only on a
# button click, a form submit, or a control's own change event. `after
# <duration>: <cell = expr>` closes that gap: it runs once, client-side, this
# many seconds after the node it's declared under is (re)rendered — most
# commonly nested right under the `if` that just made a toast/banner visible,
# so showing it and scheduling its own dismissal are the same block.
#
# Duration reuses job/daemon's own grammar (`30s`, `5m`, `2h`); the body may
# only assign a @client cell — no entity/service access, since a timer never
# touches the authority.
#
# Run it:  facet dev examples/timer.fct
# Click "Copy link", watch the toast appear and disappear on its own 3s later.
app Clipboard:
    state showToast: bool = false @client
    state toastMsg: text = "" @client

    action copyLink():
        toastMsg = "Link copied"
        showToast = true

    view Home at "/":
        box:
            heading 1 "Share"
            button "Copy link" -> copyLink()

            if showToast:
                row class "x-toast":
                    text "{toastMsg}"
                # Fires once, 3s after this branch renders, and flips the same
                # cell that showed it — the toast dismisses itself with no
                # round trip to the authority and no click required.
                after 3s:
                    showToast = false
