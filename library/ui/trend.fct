# Trend — one row in the "What's happening" rail: a muted category line, the bold
# tag, and a muted count.
app FacetUI:
    component Trend(category: text, tag: text, count: text):
        box class "x-trend":
            text "{category} · Trending" class "x-muted x-small"
            text "{tag}" class "x-strong"
            text "{count}" class "x-muted x-small"
