# Trends — the right rail ("What's happening"). A self-contained `ui` facet for the
# `aside` socket.
import "trend.fct"
ui Trends in aside:
    content:
        box class "x-card":
            heading 2 "What's happening"
            use Trend("Tech", "#FacetLang", "1,234 posts")
            use Trend("News", "#Facet", "987 posts")
