# Trends — the right rail ("What's happening"). A self-contained `ui` facet for the
# `aside` socket.
ui Trends in aside:
    content:
        text "What's happening"
        box:
            text "Tech · Trending"
            text "#FacetLang"
            text "1,234 posts"
        box:
            text "News · Trending"
            text "#Facet"
            text "987 posts"
