# Nav — the left rail as a `ui` brick for the `nav` socket of a wireframe: logo,
# the rail items, the Post button, and who is signed in. Pure presentation.
import "icons.fct"
import "navitem.fct"
ui Nav in nav:
    content:
        icon "logo" class "x-logo"
        use NavItem("home", "Home", "/")
        use NavItem("search", "Explore", "/")
        use NavItem("bell", "Notifications", "/")
        use NavItem("follow", "Follow", "/")
        use NavItem("chat", "Chat", "/")
        use NavItem("more", "More", "/")
        link "Post" -> "/" class "x-pill x-primary x-post-btn"
        box class "x-account":
            text "{actor}" class "x-strong"
            button "log out" -> logout class "x-pill"
