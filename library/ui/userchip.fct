# UserChip — avatar + display name (with verified mark) + @handle. The identity
# unit used in the account chip, "who to follow", and notifications.
import "avatar.fct"
import "verifiedbadge.fct"
app FacetUI:
    component UserChip(name: text, handle: text, verified: bool):
        row class "x-chip":
            use Avatar(name)
            box:
                row class "x-author":
                    text "{name}" class "x-strong"
                    use VerifiedBadge(verified)
                text "@{handle}" class "x-muted"
