# WhoToFollow — one suggestion in the "Who to follow" rail: identity + a follow
# button. `following` (compute with exists() in the host) drives follow/unfollow.
import "../ui/userchip.fct"
import "followbutton.fct"
app FacetSocial:
    component WhoToFollow(name: text, handle: text, verified: bool, following: bool):
        row:
            use UserChip(name, handle, verified)
            use FollowButton(handle, following)
