# EngagementBar — the reply/repost/like/bookmark action row under a post. Counts
# are passed in (compute them in the host with count(x in … where …)). The buttons
# call host actions by convention: like(id), repost(id), bookmark(id).
app FacetSocial:
    component EngagementBar(id: int, likes: int, replies: int, reposts: int):
        row:
            text "💬 {replies}"
            button "🔁 {reposts}" -> repost(id)
            button "♥ {likes}" -> like(id)
            button "🔖" -> bookmark(id)
