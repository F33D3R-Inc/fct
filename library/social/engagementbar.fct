# EngagementBar — the action row under a post: reply, repost, like, views,
# bookmark — each a glyph beside its count, rendered compact ("1.3K"). The
# buttons call host actions by convention: repost(id), like(id), bookmark(id).
# Counts are passed in (compute them in the host with count(x in … where …)).
import "../ui/icons.fct"
app FacetSocial:
    component EngagementBar(id: int, replies: int, reposts: int, likes: int, views: int):
        row class "x-bar":
            text "{compact(replies)}" class "x-glyph-reply"
            button "{compact(reposts)}" -> repost(id) class "x-repost x-glyph-repost"
            button "{compact(likes)}" -> like(id) class "x-like x-glyph-heart"
            text "{compact(views)}" class "x-glyph-views"
            button "" -> bookmark(id) class "x-glyph-bookmark"
