# PostCard — a whole post the way a timeline shows it: an optional "Pinned" line,
# the avatar in its own left column, then the author line with a relative time,
# the body (text, richtext, or a media frame), and the engagement bar.
#
# It takes the ROW — `use PostCard(t, replies, reposts, likes, views)` — and reads
# the Tweet's own fields (author, handle, verified, kind, body, media, pinned,
# created). The counts are aggregates only the host can compute, so they are
# passed in: `count(l in Like where l.tweet == t.id)`.
import "../ui/avatar.fct"
import "../ui/authorrow.fct"
import "../ui/mediacard.fct"
import "../ui/icons.fct"
import "engagementbar.fct"
app FacetSocial:
    component PostCard(t: Tweet, replies: int, reposts: int, likes: int, views: int):
        box class "x-post":
            if t.pinned:
                row class "x-pinned":
                    icon "pin"
                    text "Pinned"
            row class "x-postrow":
                use Avatar(t.author)
                box class "x-postbody":
                    use AuthorRow(t.author, t.handle, t.verified, ago(t.created))
                    match t.kind:
                        case "richtext":
                            richtext "{t.body}"
                        else:
                            if t.body != "":
                                text "{t.body}" class "x-body"
                    if t.media != "":
                        use MediaCard(t.kind, t.media, false, views)
                    use EngagementBar(t.id, replies, reposts, likes, views)
