# PostCard — a whole post: identity, kind-aware body (text/richtext/video), and the
# engagement bar. `kind` selects how the body renders. Counts are passed in.
import "../ui/userchip.fct"
import "engagementbar.fct"
app FacetSocial:
    component PostCard(id: int, author: text, handle: text, verified: bool, kind: text, body: text, media: text, likes: int, replies: int, reposts: int):
        box:
            use UserChip(author, handle, verified)
            match kind:
                case "richtext":
                    richtext "{body}"
                case "video":
                    video "{media}"
                else:
                    text "{body}"
            use EngagementBar(id, likes, replies, reposts)
