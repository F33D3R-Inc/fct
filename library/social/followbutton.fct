# FollowButton — follow a handle. `following` (compute with exists() in the host)
# picks the state; calls host follow(handle).
#
# NOTE: unfollow needs delete-by-non-id-key (remove a Follow row matching
# follower+followee), which the language can't express yet (remove is by id only).
# Surfaced building this facet — see SPRINT_LOG. Follow-only until then.
app FacetSocial:
    component FollowButton(handle: text, following: bool):
        if following:
            text "Following"
        if !following:
            button "Follow" -> follow(handle)
