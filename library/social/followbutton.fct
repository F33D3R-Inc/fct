# FollowButton — follow / unfollow a handle. `following` (compute with exists() in
# the host) picks the state: when already following it offers Unfollow, otherwise
# Follow. Calls the host follow(handle) / unfollow(handle) actions.
#
# unfollow is a delete-by-non-id-key (remove the Follow row matching
# follower+followee) — expressible since v1.17.0's `remove … where`. The host
# action is `remove f in Follow where f.follower == actor && f.followee == handle`.
app FacetSocial:
    component FollowButton(handle: text, following: bool):
        if following:
            button "Following" -> unfollow(handle)
        if !following:
            button "Follow" -> follow(handle)
