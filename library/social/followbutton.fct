# FollowButton — follow / unfollow a handle, as a pill. `following` (compute
# with exists() in the host) picks the state. Calls the host follow(handle) /
# unfollow(handle) actions.
app FacetSocial:
    component FollowButton(handle: text, following: bool):
        if following:
            button "Following" -> unfollow(handle) class "x-pill"
        if !following:
            button "Follow" -> follow(handle) class "x-pill x-light"
