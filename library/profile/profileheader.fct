# ProfileHeader — the top of a profile page: the 3:1 banner, the oversized avatar
# overlapping its bottom edge, the Follow pill on the right, then name + verified
# check, @handle, bio, a "Joined …" line with a calendar glyph, and the stats row.
# The Posts / Replies / Media tabs are the host's — they hold the host's lists.
import "../ui/icons.fct"
import "../ui/verifiedbadge.fct"
import "../social/followbutton.fct"
app FacetProfile:
    component ProfileHeader(name: text, handle: text, verified: bool, bio: text, banner: text, joined: text, following: bool, follows: int, followers: int):
        box class "x-profile":
            image "{banner}" alt "" class "x-banner"
            row class "x-profile-head":
                image "https://api.dicebear.com/7.x/thumbs/svg?seed={name}" alt "{name}" class "x-avatar-xl"
                use FollowButton(handle, following)
            box class "x-profile-body":
                row class "x-author":
                    heading 2 "{name}"
                    use VerifiedBadge(verified)
                text "@{handle}" class "x-muted"
                if bio != "":
                    text "{bio}" class "x-body"
                row class "x-meta":
                    icon "calendar"
                    text "Joined {joined}"
                row class "x-stats":
                    row:
                        text "{commas(follows)}" class "x-strong"
                        text "Following"
                    row:
                        text "{compact(followers)}" class "x-strong"
                        text "Followers"
