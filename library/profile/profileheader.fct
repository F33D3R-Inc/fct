# ProfileHeader — the top of a profile: banner, avatar, display name + verified mark,
# @handle, bio, and a follow/unfollow button. `following` (exists() in the host)
# drives the button. Pure presentation composed from the identity atoms.
import "../ui/avatar.fct"
import "../ui/verifiedbadge.fct"
import "../social/followbutton.fct"
app FacetProfile:
    component ProfileHeader(name: text, handle: text, verified: bool, bio: text, following: bool):
        box:
            row:
                use Avatar(name)
                use FollowButton(handle, following)
            row:
                text "{name}"
                use VerifiedBadge(verified)
            text "@{handle}"
            text "{bio}"
