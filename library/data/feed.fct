# Feed — a `data` facet: a whole vertical slice (durable data + server logic +
# authorization + content) that snaps into the `feed` socket. Its presentation is
# composed from the SHARED component atoms (PostCard / ComposeBox / SearchBox /
# WhoToFollow) — the same files the plain-app track imports — now that a layered
# build can pull in component-only modules (the shareable-component gap, closed in
# v1.17.0). Exercises the v1.16 language end to end: filtered count/exists, tabs,
# match, richtext/video, pending/failed, contains/search, components, image/badge,
# and `remove … where` (unfollow).
import "../social/postcard.fct"
import "../social/composebox.fct"
import "../social/whotofollow.fct"
import "../forms/searchbox.fct"
data Feed in feed:
    enum Kind: text, richtext, video

    entity Tweet:
        id: int
        author: text
        handle: text
        verified: bool
        kind: Kind
        body: text
        media: text
        pinned: bool
        created: int
    entity Like:
        id: int
        tweet: Tweet
        user: text
    entity Repost:
        id: int
        tweet: Tweet
        user: text
    entity Bookmark:
        id: int
        tweet: Tweet
        user: text
    entity Follow:
        id: int
        follower: text
        followee: text

    state draft: text = "" @client
    state feedTab: text = "foryou" @client
    state q: text = "" @client
    state shown: int = 20 @client

    policy member:
        actor != "guest"

    action post(body: text):
        requires member
        add Tweet { author: actor, handle: actor, verified: false, kind: Kind.text, body: body, media: "", pinned: false, created: now() }
    action like(id: int):
        requires member
        add Like { tweet: id, user: actor }
    action repost(id: int):
        requires member
        add Repost { tweet: id, user: actor }
    action bookmark(id: int):
        requires member
        add Bookmark { tweet: id, user: actor }
    action follow(handle: text):
        requires member
        add Follow { follower: actor, followee: handle }
    action unfollow(handle: text):
        requires member
        remove f in Follow where f.follower == actor && f.followee == handle
    action loadMore:
        shown = shown + 20

    content:
        use ComposeBox()
        use SearchBox()
        tabs bind feedTab:
            tab "For you" -> "foryou":
                for t in Tweet where contains(lower(t.body), lower(q)) by created desc limit shown more loadMore:
                    use PostCard(t, 0, count(r in Repost where r.tweet == t.id), count(l in Like where l.tweet == t.id), 0)
            tab "Following" -> "following":
                for t in Tweet where exists(f in Follow where f.follower == actor && f.followee == t.author) by created desc limit shown more loadMore:
                    use PostCard(t, 0, count(r in Repost where r.tweet == t.id), count(l in Like where l.tweet == t.id), 0)
        text "Who to follow"
        use WhoToFollow("Grace Hopper", "grace", true, exists(f in Follow where f.follower == actor && f.followee == "grace"))
        use WhoToFollow("Alan Turing", "alan", false, exists(f in Follow where f.follower == actor && f.followee == "alan"))
