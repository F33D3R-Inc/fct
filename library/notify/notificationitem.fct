# NotificationItem — one row in the notifications list: who did what, and an unread
# dot. `actor`/`verb`/`subject` are passed in; `unread` styles the row. The host
# produces rows by fanning an action out to other users (Tier-2 notifications).
import "../ui/avatar.fct"
app FacetNotify:
    component NotificationItem(who: text, verb: text, subject: text, unread: bool):
        row:
            use Avatar(who)
            box:
                row:
                    text "{who}"
                    if unread:
                        badge "●"
                text "{verb} {subject}"
