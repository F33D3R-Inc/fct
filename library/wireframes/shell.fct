# Shell — the 3-column app skeleton. A `wireframe`: pure structure that declares
# typed sockets and lays them out. `ui` facets snap into nav/aside, a `data` facet
# into feed; the kinds must match or the bricks don't fit.
#
# It imports the look, so every brick that snaps in renders in it: a sticky rail
# on the left, a 600px hairline-bordered main column, a sticky aside on the right.
import "../ui/look.fct"
import "../ui/nav.fct"
import "../data/feed.fct"
import "../ui/trends.fct"
wireframe Shell:
    socket nav: ui
    socket feed: data
    socket aside: ui
    frame:
        row class "x-shell":
            box class "x-rail":
                slot nav
            box class "x-main":
                slot feed
            box class "x-aside":
                slot aside
