# f33d3r — the playground (the baseplate): global concerns (auth, theme) and the
# one mount of the Shell wireframe. The compiler composites the whole brick stack —
# wireframe + ui/data facets + components — into one placement-sound surface.
#
#   facet dev library/f33d3r.fct
import "wireframes/shell.fct"
playground F33D3R:
    auth
    theme:
        bg "#15202b"
        fg "#f7f9f9"
        muted "#8b98a5"
        accent "#1d9bf0"
        border "#38444d"
        card-border "#38444d"
        radius "16px"
        maxwidth "1100px"
    mount Shell at "/"
