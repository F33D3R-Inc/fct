# f33d3r home (plain-app composition track) — the reference app assembled from the
# library's atoms: the look, the rail, post cards with media and an engagement
# bar, infinite scroll, a profile page, and the sign-in surfaces a visitor sees.
# Demonstrates the *component* facet type, vs the typed-brick stack in f33d3r.fct
# (playground/wireframe/ui/data).
#
#   facet dev library/home.fct
import "ui/look.fct"
import "ui/navrail.fct"
import "ui/signupcard.fct"
import "ui/guestbanner.fct"
import "ui/topbar.fct"
import "ui/trend.fct"
import "social/postcard.fct"
import "social/quotecard.fct"
import "social/composebox.fct"
import "social/whotofollow.fct"
import "profile/profileheader.fct"
import "forms/searchbox.fct"

app F33D3RHome:
    auth

    enum Kind: text, richtext, video, image

    entity Tweet:
        id: int
        author: text
        handle: text
        verified: bool
        kind: Kind
        body: text
        media: text
        quoted: int
        pinned: bool
        created: int
    entity Like:
        id: int
        tweet: Tweet
        user: text
    entity Repost:
        id: int
        tweet: Tweet
        user: text
    entity Bookmark:
        id: int
        tweet: Tweet
        user: text
    entity Follow:
        id: int
        follower: text
        followee: text

    state draft: text = "" @client
    state feedTab: text = "foryou" @client
    state profileTab: text = "posts" @client
    state q: text = "" @client
    state shown: int = 20 @client
    state username: text = "" @client
    state password: text = "" @client

    policy member:
        actor != "guest"

    action post(body: text):
        requires member
        add Tweet { author: actor, handle: actor, verified: false, kind: Kind.text, body: body, media: "", quoted: 0, pinned: false, created: now() }
    action postVideo(body: text, media: text):
        requires member
        add Tweet { author: actor, handle: actor, verified: true, kind: Kind.video, body: body, media: media, quoted: 0, pinned: true, created: now() }
    action like(id: int):
        requires member
        add Like { tweet: id, user: actor }
    action repost(id: int):
        requires member
        add Repost { tweet: id, user: actor }
    action bookmark(id: int):
        requires member
        add Bookmark { tweet: id, user: actor }
    action follow(handle: text):
        requires member
        add Follow { follower: actor, followee: handle }
    action unfollow(handle: text):
        requires member
        remove f in Follow where f.follower == actor && f.followee == handle
    action loadMore:
        shown = shown + 20

    view Home at "/":
        row class "x-shell":
            box class "x-rail":
                use NavRail(actor, actor, false, "/")
            box class "x-main":
                use TopBar("Home", "")
                if actor != "guest":
                    use ComposeBox()
                use SearchBox()
                tabs bind feedTab:
                    tab "For you" -> "foryou":
                        for t in Tweet where contains(lower(t.body), lower(q)) by created desc limit shown more loadMore:
                            use PostCard(t, 0, count(r in Repost where r.tweet == t.id), count(l in Like where l.tweet == t.id), 0)
                    tab "Following" -> "following":
                        for t in Tweet where exists(f in Follow where f.follower == actor && f.followee == t.author) by created desc limit shown more loadMore:
                            use PostCard(t, 0, count(r in Repost where r.tweet == t.id), count(l in Like where l.tweet == t.id), 0)
            box class "x-aside":
                if actor == "guest":
                    use SignUpCard("New to F33D3R?", "/login")
                box class "x-card":
                    heading 2 "What's happening"
                    use Trend("Tech", "#FacetLang", "1,234 posts")
                    use Trend("News", "#Facet", "987 posts")
                box class "x-card":
                    heading 2 "Who to follow"
                    use WhoToFollow("Grace Hopper", "grace", true, exists(f in Follow where f.follower == actor && f.followee == "grace"))
                    use WhoToFollow("Alan Turing", "alan", false, exists(f in Follow where f.follower == actor && f.followee == "alan"))
        if actor == "guest":
            use GuestBanner("/login")

    view Profile at "/u/:handle":
        row class "x-shell":
            box class "x-rail":
                use NavRail(actor, actor, false, "/")
            box class "x-main":
                use TopBar(handle, count(t in Tweet where t.handle == handle) + " posts")
                use ProfileHeader(handle, handle, false, "", "https://picsum.photos/seed/" + handle + "/1200/400", "June 2026", exists(f in Follow where f.follower == actor && f.followee == handle), count(f in Follow where f.follower == handle), count(f in Follow where f.followee == handle))
                box class "x-profile":
                    tabs bind profileTab:
                        tab "Posts" -> "posts":
                            for t in Tweet where t.handle == handle by created desc limit shown more loadMore:
                                use PostCard(t, 0, count(r in Repost where r.tweet == t.id), count(l in Like where l.tweet == t.id), 0)
                        tab "Media" -> "media":
                            for t in Tweet where t.handle == handle && t.media != "" by created desc limit shown more loadMore:
                                use PostCard(t, 0, count(r in Repost where r.tweet == t.id), count(l in Like where l.tweet == t.id), 0)
            box class "x-aside":
                if actor == "guest":
                    use SignUpCard("New to F33D3R?", "/login")
        if actor == "guest":
            use GuestBanner("/login")

    view Login at "/login":
        box class "x-card" style "max-width: 400px; margin: 10vh auto;":
            icon "logo" class "x-logo"
            heading 2 "Happening now"
            input bind username placeholder "Username"
            input bind password placeholder "Password"
            button "Create account" -> signup(username, password) class "x-pill x-light x-wide"
            button "Log in" -> login(username, password) class "x-pill x-wide"
            richtext "By signing up, you agree to the [Terms of Service](/terms) and [Privacy Policy](/privacy)." class "x-fine"
