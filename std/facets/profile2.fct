# fa.std — profile / channel pages: header, tabs, stats, bio, pinned.

facet ProfileCover:
    what:
        user: User
    looks:
        <div class="fa-pcover"><img src="{user.banner_url}" alt="" /></div>

facet ProfileHeader:
    what:
        user: User
        following: bool
    looks:
        <header class="fa-pheader">
            <div class="fa-pcover"><img src="{user.banner_url}" alt="" /></div>
            <div class="fa-pheader__row">
                <Avatar src="{user.avatar_url}" alt="{user.handle}" size="large" />
                if following:
                    <Button label="Following" variant="secondary" action="follow.toggle" />
                else:
                    <Button label="Follow" variant="primary" action="follow.toggle" />
            </div>
            <div class="fa-pheader__id">
                <span class="fa-pheader__name">{user.display_name}</span>
                <span class="fa-post__handle">@{user.handle}</span>
            </div>
        </header>

facet BioBlock:
    what:
        user: User
    looks:
        <div class="fa-bio">
            <p class="fa-bio__text">{user.bio}</p>
            <div class="fa-bio__meta">
                <span>📍 {user.location}</span>
                <span>📅 Joined {user.joined}</span>
            </div>
        </div>

facet ProfileStats:
    what:
        user: User
    looks:
        <div class="fa-pstats">
            <button class="fa-pstat" data-action="profile.following"><strong>{user.following_count}</strong> Following</button>
            <button class="fa-pstat" data-action="profile.followers"><strong>{user.follower_count}</strong> Followers</button>
        </div>

facet ProfileTab:
    what:
        label: str
        active: bool
    looks:
        <button class="fa-ptab{ if active } fa-ptab--active{ end }" data-action="profile.tab" data-tab="{label}">{label}</button>

facet ProfileTabs:
    what:
        page: TabPage
    looks:
        <nav class="fa-ptabs">
            for t in page.tabs:
                <ProfileTab label="{t.label}" active="{t.active}" />
        </nav>

facet EditProfileButton:
    looks:
        <button class="fa-btn fa-btn--secondary" data-action="profile.edit">Edit profile</button>

facet PinnedPostBadge:
    looks:
        <span class="fa-pinned">📌 Pinned</span>

facet ProfileLink:
    what:
        url: str
        label: str
    looks:
        <a class="fa-plink" href="{url}" rel="me">🔗 {label}</a>
