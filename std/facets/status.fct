# fa.std — status atoms: dots, pills, ratings, chips, verified.

facet StatusDot:
    what:
        online: bool
    looks:
        <span class="fa-statusdot{ if online } fa-statusdot--online{ end }"></span>

facet Pill:
    what:
        label: str
        tone: str
    looks:
        <span class="fa-pill fa-pill--{tone}">{label}</span>

facet Stars:
    what:
        rating: int
    looks:
        <span class="fa-stars" aria-label="Rating">
            if rating >= 1:
                ★
            else:
                ☆
            if rating >= 2:
                ★
            else:
                ☆
            if rating >= 3:
                ★
            else:
                ☆
            if rating >= 4:
                ★
            else:
                ☆
            if rating >= 5:
                ★
            else:
                ☆
        </span>

facet Chip:
    what:
        label: str
    looks:
        <span class="fa-chip">{label}<button class="fa-chip__x" data-action="chip.remove" aria-label="Remove">×</button></span>

facet VerifiedTick:
    looks:
        <span class="fa-verified" aria-label="Verified" title="Verified">✓</span>
