# fa.std — overlays: sheets, drawers, menus, tooltips, dialogs, pickers, lightbox.

facet Sheet:
    what:
        open: bool
    looks:
        <div class="fa-sheet{ if open } fa-sheet--open{ end }">
            <div class="fa-sheet__backdrop" data-action="sheet.close"></div>
            <div class="fa-sheet__panel">
                <div class="fa-sheet__grip"></div>
                slot:
                    <span></span>
            </div>
        </div>

facet Drawer:
    what:
        open: bool
        side: str
    looks:
        <div class="fa-drawer fa-drawer--{side}{ if open } fa-drawer--open{ end }">
            slot:
                <span></span>
        </div>

facet Dropdown:
    what:
        open: bool
    looks:
        <div class="fa-dropdown{ if open } fa-dropdown--open{ end }" role="menu">
            slot:
                <span></span>
        </div>

facet MenuItem:
    what:
        label: str
        action: str
        icon: str
    looks:
        <button class="fa-menuitem" data-action="{action}" role="menuitem">
            if icon:
                <span class="fa-menuitem__icon">{icon}</span>
            <span>{label}</span>
        </button>

facet ContextMenu:
    looks:
        <div class="fa-ctxmenu" role="menu">
            slot:
                <span></span>
        </div>

facet Tooltip:
    what:
        text: str
    looks:
        <span class="fa-tooltip" role="tooltip">{text}</span>

facet ConfirmDialog:
    what:
        title: str
        message: str
        confirm_label: str
    looks:
        <div class="fa-confirm" role="alertdialog">
            <h3 class="fa-confirm__title">{title}</h3>
            <p>{message}</p>
            <div class="fa-confirm__actions">
                <button class="fa-btn fa-btn--secondary" data-action="dialog.cancel">Cancel</button>
                <button class="fa-btn fa-btn--danger" data-action="dialog.confirm">{confirm_label}</button>
            </div>
        </div>

facet Lightbox:
    what:
        open: bool
    looks:
        <div class="fa-lightbox{ if open } fa-lightbox--open{ end }" data-action="lightbox.close">
            <button class="fa-lightbox__close" data-action="lightbox.close" aria-label="Close">×</button>
            slot:
                <span></span>
        </div>

facet EmojiPicker:
    looks:
        <div class="fa-emojipicker" role="listbox">
            slot:
                <span></span>
        </div>

facet GifPicker:
    looks:
        <div class="fa-gifpicker">
            <input class="fa-input" placeholder="Search GIFs" data-action="gif.search" />
            <div class="fa-gifpicker__grid">
                slot:
                    <span></span>
            </div>
        </div>
