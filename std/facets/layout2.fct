# fa.std — app shell containers: sidebar, topbar, bottom nav, grid, scroll.

facet Sidebar:
    looks:
        <aside class="fa-sidebar">
            slot:
                <span></span>
        </aside>

facet TopBar:
    what:
        title: str
    looks:
        <header class="fa-topbar">
            <span class="fa-topbar__title">{title}</span>
            <div class="fa-topbar__actions">
                slot:
                    <span></span>
            </div>
        </header>

facet BottomNav:
    looks:
        <nav class="fa-bottomnav">
            slot:
                <span></span>
        </nav>

facet Grid:
    what:
        cols: int
    looks:
        <div class="fa-grid" style="grid-template-columns:repeat({cols},minmax(0,1fr))">
            slot:
                <span></span>
        </div>

facet ScrollArea:
    looks:
        <div class="fa-scroll">
            slot:
                <span></span>
        </div>

facet Center:
    looks:
        <div class="fa-center">
            slot:
                <span></span>
        </div>

facet Spacer:
    looks:
        <div class="fa-spacer"></div>
