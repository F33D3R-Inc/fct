# fa.std — atomic facets: the smallest reusable building blocks.
# All presentational; style via the shipped std.CSS (fa-* classes).

facet Button:
    what:
        label: str
        variant: str
        action: str
    looks:
        <button class="fa-btn fa-btn--{variant}" data-action="{action}">{label}</button>

facet IconButton:
    what:
        path: str
        label: str
        action: str
    looks:
        <button class="fa-iconbtn" data-action="{action}" aria-label="{label}" title="{label}">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="{path}"/></svg>
        </button>

facet Icon:
    what:
        path: str
        label: str
    looks:
        <svg class="fa-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-label="{label}"><path d="{path}"/></svg>

facet Avatar:
    what:
        src: str
        alt: str
        size: str
    looks:
        <img class="fa-avatar fa-avatar--{size}" src="{src}" alt="{alt}" />

facet Badge:
    what:
        label: str
        tone: str
    looks:
        <span class="fa-badge fa-badge--{tone}">{label}</span>

facet Tag:
    what:
        label: str
    looks:
        <span class="fa-tag">{label}</span>

facet Count:
    what:
        value: int
        label: str
    looks:
        <span class="fa-count" aria-label="{label}">{value}</span>

facet Spinner:
    looks:
        <svg class="fa-spinner" viewBox="0 0 24 24" width="20" height="20" fill="none" role="status" aria-label="Loading">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"/>
            <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        </svg>

facet Skeleton:
    what:
        width: str
    looks:
        <span class="fa-skeleton" style="width:{width}"></span>

facet Divider:
    looks:
        <hr class="fa-divider" />

facet Link:
    what:
        href: str
        label: str
    looks:
        <a class="fa-link" href="{href}" data-nav>{label}</a>

facet Toggle:
    what:
        on: bool
        label: str
        action: str
    looks:
        <button class="fa-toggle{ if on } fa-toggle--on{ end }" data-action="{action}" data-fa-optimistic="fa-toggle--on" role="switch" aria-checked="{on}">
            <span class="fa-toggle__track"><span class="fa-toggle__thumb"></span></span>
            <span class="fa-toggle__label">{label}</span>
        </button>
