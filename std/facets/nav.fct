# fa.std — navigation facets.

facet NavBar:
    looks:
        <nav class="fa-nav">
            slot:
                <span></span>
        </nav>

facet NavItem:
    what:
        href: str
        label: str
        path: str
        active: bool
    looks:
        <a class="fa-nav__item{ if active } fa-nav__item--active{ end }" href="{href}" data-nav>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="{path}"/></svg>
            <span>{label}</span>
        </a>

facet TabBar:
    looks:
        <div class="fa-tabs" role="tablist">
            slot:
                <span></span>
        </div>

facet Tab:
    what:
        label: str
        active: bool
        action: str
    looks:
        <button class="fa-tab{ if active } fa-tab--active{ end }" role="tab" aria-selected="{active}" data-action="{action}" data-fa-optimistic="fa-tab--active">{label}</button>

facet Crumb:
    what:
        href: str
        label: str
        last: bool
    looks:
        if last:
            <span class="fa-crumb fa-crumb--current" aria-current="page">{label}</span>
        else:
            <a class="fa-crumb" href="{href}" data-nav>{label}</a>
