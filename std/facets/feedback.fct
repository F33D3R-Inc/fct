# fa.std — feedback facets: status, messages, progress.

facet Alert:
    what:
        tone: str
        title: str
    looks:
        <div class="fa-alert fa-alert--{tone}" role="alert">
            <strong class="fa-alert__title">{title}</strong>
            <div class="fa-alert__body">
                slot:
                    <span></span>
            </div>
        </div>

facet Toast:
    what:
        tone: str
        message: str
    looks:
        <div class="fa-toast fa-toast--{tone}" role="status">{message}</div>

facet EmptyState:
    what:
        title: str
        hint: str
    looks:
        <div class="fa-empty">
            <h3 class="fa-empty__title">{title}</h3>
            <p class="fa-empty__hint">{hint}</p>
            <div class="fa-empty__action">
                slot:
                    <span></span>
            </div>
        </div>

facet ProgressBar:
    what:
        value: int
        label: str
    looks:
        <div class="fa-progress" role="progressbar" aria-label="{label}" aria-valuenow="{value}" aria-valuemin="0" aria-valuemax="100">
            <span class="fa-progress__fill" style="width:{value}%"></span>
        </div>
