# fa.std — comment threads (video / post discussions).

facet CommentComposer:
    what:
        user: User
    looks:
        <form class="fa-ccompose" data-action="comment.create">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="small" />
            <input class="fa-input" name="body" placeholder="Add a comment…" autocomplete="off" />
            <button class="fa-btn fa-btn--primary" type="submit">Comment</button>
        </form>

facet CommentVote:
    what:
        comment: Comment
        liked: bool
    looks:
        <div class="fa-cvote">
            <button class="fa-cvote__btn{ if liked } fa-cvote__btn--on{ end }" data-action="comment.like" data-comment-id="{comment.id}" data-fa-optimistic="fa-cvote__btn--on">👍</button>
            <span class="fa-cvote__count">{comment.likes}</span>
            <button class="fa-cvote__btn" data-action="comment.dislike" data-comment-id="{comment.id}">👎</button>
            <button class="fa-cvote__reply" data-action="comment.reply" data-comment-id="{comment.id}">Reply</button>
        </div>

facet CommentNode:
    what:
        comment: Comment
        author: User
        liked: bool
    looks:
        <div class="fa-cnode">
            <Avatar src="{author.avatar_url}" alt="{author.handle}" size="small" />
            <div class="fa-cnode__main">
                <div class="fa-cnode__head">
                    <span class="fa-post__name">{author.display_name}</span>
                    <span class="fa-post__handle">{comment.time}</span>
                </div>
                <p class="fa-cnode__body">{comment.body}</p>
                <CommentVote comment="{comment}" liked="{liked}" />
            </div>
        </div>

facet ReplyToggle:
    what:
        count: int
    looks:
        <button class="fa-replytoggle" data-action="comment.expand">▾ {count} replies</button>

facet CommentThread:
    what:
        thread: Thread
    looks:
        <div class="fa-cthread">
            for c in thread.comments:
                <CommentNode comment="{c}" author="{c.author}" liked="{c.liked}" />
        </div>

facet CommentSortBar:
    what:
        label: str
    looks:
        <div class="fa-csort">
            <button class="fa-sortbar" data-action="comment.sort">Sort by: {label} ⌄</button>
        </div>

facet PinnedComment:
    what:
        comment: Comment
        author: User
    looks:
        <div class="fa-cnode fa-cnode--pinned">
            <span class="fa-cnode__pin">📌 Pinned by creator</span>
            <Avatar src="{author.avatar_url}" alt="{author.handle}" size="small" />
            <div class="fa-cnode__main">
                <span class="fa-post__name">{author.display_name}</span>
                <p class="fa-cnode__body">{comment.body}</p>
            </div>
        </div>
