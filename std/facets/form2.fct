# fa.std — extended form controls: switch, radio, slider, upload, counters.

facet Switch:
    what:
        on: bool
        label: str
    looks:
        <label class="fa-switch">
            if on:
                <input type="checkbox" data-action="switch.toggle" checked />
            else:
                <input type="checkbox" data-action="switch.toggle" />
            <span class="fa-switch__track"></span>
            <span>{label}</span>
        </label>

facet RadioOption:
    what:
        name: str
        value: str
        label: str
        checked: bool
    looks:
        <label class="fa-radio">
            if checked:
                <input type="radio" name="{name}" value="{value}" checked />
            else:
                <input type="radio" name="{name}" value="{value}" />
            <span>{label}</span>
        </label>

facet Slider:
    what:
        name: str
        value: int
        min: int
        max: int
    looks:
        <input class="fa-slider" type="range" name="{name}" value="{value}" min="{min}" max="{max}" data-action="slider.change" />

facet FileUpload:
    what:
        name: str
        label: str
    looks:
        <label class="fa-upload">
            <span class="fa-upload__label">{label}</span>
            <input type="file" name="{name}" />
        </label>

facet SearchInput:
    what:
        value: str
        placeholder: str
    looks:
        <div class="fa-searchinput">
            <input class="fa-input" type="search" value="{value}" placeholder="{placeholder}" data-action="search.input" autocomplete="off" />
        </div>

facet OTPInput:
    what:
        name: str
    looks:
        <input class="fa-otp" name="{name}" inputmode="numeric" maxlength="6" autocomplete="one-time-code" data-action="otp.input" />

facet CharCounter:
    what:
        count: int
        max: int
    looks:
        <span class="fa-charcount{ if count > max } fa-charcount--over{ end }">{count}/{max}</span>

facet FieldError:
    what:
        message: str
    looks:
        if message:
            <span class="fa-fielderror">{message}</span>
        else:
            <span></span>
