# fa.std — composer: post box, replies, quotes, polls, media, scheduling.

facet Composer:
    what:
        user: User
    looks:
        <form class="fa-composer" data-action="post.create">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="medium" />
            <div class="fa-composer__main">
                <textarea class="fa-composer__input" name="body" placeholder="What's happening?"></textarea>
                <div class="fa-composer__bar">
                    <div class="fa-composer__tools">
                        <button class="fa-iconbtn" type="button" data-action="compose.media" aria-label="Media">🖼</button>
                        <button class="fa-iconbtn" type="button" data-action="compose.gif" aria-label="GIF">GIF</button>
                        <button class="fa-iconbtn" type="button" data-action="compose.poll" aria-label="Poll">📊</button>
                        <button class="fa-iconbtn" type="button" data-action="compose.emoji" aria-label="Emoji">☺</button>
                    </div>
                    <button class="fa-btn fa-btn--primary" type="submit">Post</button>
                </div>
            </div>
        </form>

facet ReplyComposer:
    what:
        user: User
        target: Post
    looks:
        <form class="fa-composer fa-composer--reply" data-action="reply.create" data-target-id="{target.id}">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="small" />
            <input class="fa-composer__input" name="body" placeholder="Post your reply" autocomplete="off" />
            <button class="fa-btn fa-btn--primary" type="submit">Reply</button>
        </form>

facet QuoteComposer:
    what:
        quoted: Post
        author: User
    looks:
        <form class="fa-composer" data-action="quote.create" data-target-id="{quoted.id}">
            <textarea class="fa-composer__input" name="body" placeholder="Add a comment"></textarea>
            <QuotedPost post="{quoted}" author="{author}" />
            <button class="fa-btn fa-btn--primary" type="submit">Post</button>
        </form>

facet PollChoiceInput:
    what:
        value: str
    looks:
        <input class="fa-polledit__opt fa-input" name="option" value="{value}" placeholder="Choice" />

facet PollEditor:
    what:
        poll: Poll
    looks:
        <div class="fa-polledit">
            for opt in poll.options:
                <PollChoiceInput value="{opt.value}" />
            <button class="fa-btn fa-btn--secondary" type="button" data-action="poll.add">Add choice</button>
        </div>

facet PollBar:
    what:
        option: PollOption
    looks:
        <button class="fa-pollbar" data-action="poll.vote" data-option-id="{option.id}">
            <span class="fa-pollbar__fill" style="width:{option.percent}%"></span>
            <span class="fa-pollbar__label">{option.label}</span>
            <span class="fa-pollbar__pct">{option.percent}%</span>
        </button>

facet Poll:
    what:
        poll: Poll
    looks:
        <div class="fa-poll">
            for opt in poll.options:
                <PollBar option="{opt}" />
            <div class="fa-poll__meta">{poll.total} votes · {poll.ends}</div>
        </div>

facet MediaPreview:
    what:
        media: Media
    looks:
        <div class="fa-mediapreview">
            <img src="{media.thumb}" alt="" />
            <button class="fa-mediapreview__x" data-action="media.remove" data-media-id="{media.id}" aria-label="Remove">×</button>
        </div>

facet AudienceSelector:
    what:
        label: str
    looks:
        <button class="fa-audience" type="button" data-action="compose.audience">🌐 {label}</button>

facet ScheduleBar:
    what:
        when: str
    looks:
        <div class="fa-schedule">
            <span>⏰ Scheduled for {when}</span>
            <button class="fa-iconbtn" data-action="schedule.clear" aria-label="Clear">×</button>
        </div>

facet DraftPill:
    what:
        count: int
    looks:
        <button class="fa-draftpill" data-action="drafts.open">Drafts · {count}</button>

facet ComposeFab:
    looks:
        <button class="fa-fab" data-action="compose.open" aria-label="New post">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
        </button>
