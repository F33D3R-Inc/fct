# fa.std — notifications.

facet NotificationItem:
    what:
        notification: Notification
        actor: User
    looks:
        <a class="fa-notif{ if notification.unread } fa-notif--unread{ end }" href="{notification.url}" data-nav>
            <Avatar src="{actor.avatar_url}" alt="{actor.handle}" size="small" />
            <div class="fa-notif__body">
                <span class="fa-post__name">{actor.display_name}</span> {notification.text}
                <span class="fa-notif__time">{notification.time}</span>
            </div>
        </a>

facet NotificationList:
    looks:
        <div class="fa-notiflist">
            slot:
                <span></span>
        </div>

facet NotificationBell:
    what:
        count: int
    looks:
        <button class="fa-bell" data-action="notif.open" aria-label="Notifications">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2a6 6 0 00-6 6v3l-2 3v1h16v-1l-2-3V8a6 6 0 00-6-6zm0 20a2 2 0 002-2h-4a2 2 0 002 2z"/></svg>
            if count:
                <span class="fa-bell__badge">{count}</span>
        </button>

facet ToastStack:
    looks:
        <div class="fa-toaststack" aria-live="polite">
            slot:
                <span></span>
        </div>

facet Banner:
    what:
        tone: str
        message: str
    looks:
        <div class="fa-bannermsg fa-bannermsg--{tone}" role="status">
            <span>{message}</span>
            <button class="fa-iconbtn" data-action="banner.dismiss" aria-label="Dismiss">×</button>
        </div>
