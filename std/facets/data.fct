# fa.std — analytics / creator-studio dashboards: stats, tables, charts.

facet StatCard:
    what:
        label: str
        value: str
    looks:
        <div class="fa-statcard">
            <span class="fa-statcard__value">{value}</span>
            <span class="fa-statcard__label">{label}</span>
        </div>

facet MetricDelta:
    what:
        value: str
        up: bool
    looks:
        if up:
            <span class="fa-delta fa-delta--up">▲ {value}</span>
        else:
            <span class="fa-delta fa-delta--down">▼ {value}</span>

facet AnalyticsCard:
    what:
        title: str
        value: str
        delta: str
        up: bool
    looks:
        <div class="fa-anacard">
            <span class="fa-anacard__title">{title}</span>
            <span class="fa-anacard__value">{value}</span>
            <MetricDelta value="{delta}" up="{up}" />
        </div>

facet KPIRow:
    what:
        page: KPIPage
    looks:
        <div class="fa-kpirow">
            for k in page.kpis:
                <StatCard label="{k.label}" value="{k.value}" />
        </div>

facet TableHead:
    looks:
        <thead class="fa-thead">
            <tr>
                slot:
                    <span></span>
            </tr>
        </thead>

facet TableCell:
    what:
        value: str
    looks:
        <td class="fa-td">{value}</td>

facet TableRow:
    what:
        row: TableRowData
    looks:
        <tr class="fa-tr">
            for cell in row.cells:
                <TableCell value="{cell.value}" />
        </tr>

facet TableBody:
    what:
        data: TableData
    looks:
        <tbody>
            for r in data.rows:
                <TableRow row="{r}" />
        </tbody>

facet Table:
    looks:
        <table class="fa-table">
            slot:
                <span></span>
        </table>

facet Sparkline:
    what:
        points: str
    looks:
        <svg class="fa-spark" viewBox="0 0 100 30" preserveAspectRatio="none"><polyline points="{points}" fill="none" stroke="currentColor" stroke-width="2"/></svg>

facet DataLegend:
    what:
        label: str
        color: str
    looks:
        <span class="fa-legend"><span class="fa-legend__dot" style="background:{color}"></span>{label}</span>
