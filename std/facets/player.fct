# fa.std — media player: controls, scrubber, thumbnails, grids, carousels.

facet PlayButton:
    what:
        playing: bool
    looks:
        <button class="fa-playbtn" data-action="player.toggle" data-fa-optimistic="is-playing" aria-label="Play or pause">
            if playing:
                ⏸
            else:
                ▶
        </button>

facet Scrubber:
    what:
        percent: int
    looks:
        <div class="fa-scrubber" data-action="player.seek">
            <span class="fa-scrubber__fill" style="width:{percent}%"></span>
            <span class="fa-scrubber__thumb" style="left:{percent}%"></span>
        </div>

facet VolumeSlider:
    what:
        level: int
    looks:
        <div class="fa-volume" data-action="player.volume">
            <span class="fa-volume__fill" style="width:{level}%"></span>
        </div>

facet TimeDisplay:
    what:
        current: str
        total: str
    looks:
        <span class="fa-time">{current} / {total}</span>

facet VideoControls:
    what:
        playing: bool
        percent: int
        current: str
        total: str
    looks:
        <div class="fa-vidctl">
            <PlayButton playing="{playing}" />
            <TimeDisplay current="{current}" total="{total}" />
            <Scrubber percent="{percent}" />
            <button class="fa-iconbtn" data-action="player.fullscreen" aria-label="Fullscreen">⛶</button>
        </div>

facet MediaThumb:
    what:
        media: Media
    looks:
        <a class="fa-thumb" href="{media.url}" data-nav>
            <img src="{media.thumb}" alt="" loading="lazy" />
            if media.duration:
                <span class="fa-thumb__dur">{media.duration}</span>
        </a>

facet MediaGrid:
    looks:
        <div class="fa-mediagrid">
            slot:
                <span></span>
        </div>

facet Carousel:
    looks:
        <div class="fa-carousel">
            <div class="fa-carousel__track">
                slot:
                    <span></span>
            </div>
        </div>
