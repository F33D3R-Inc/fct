# fa.std — form facets.

facet FormField:
    what:
        label: str
        hint: str
    looks:
        <label class="fa-field">
            <span class="fa-field__label">{label}</span>
            <div class="fa-field__control">
                slot:
                    <span></span>
            </div>
            if hint:
                <span class="fa-field__hint">{hint}</span>
        </label>

facet TextInput:
    what:
        name: str
        value: str
        placeholder: str
        kind: str
    looks:
        <input class="fa-input" name="{name}" type="{kind}" value="{value}" placeholder="{placeholder}" />

facet TextArea:
    what:
        name: str
        value: str
        placeholder: str
    looks:
        <textarea class="fa-textarea" name="{name}" placeholder="{placeholder}">{value}</textarea>

facet Checkbox:
    what:
        name: str
        label: str
        checked: bool
    looks:
        <label class="fa-checkbox">
            if checked:
                <input type="checkbox" name="{name}" checked />
            else:
                <input type="checkbox" name="{name}" />
            <span>{label}</span>
        </label>

facet SubmitButton:
    what:
        label: str
    looks:
        <button class="fa-btn fa-btn--primary" type="submit">{label}</button>
