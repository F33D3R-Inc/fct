# fa.std — stories / reels.

facet StoryRing:
    what:
        user: User
        seen: bool
    looks:
        <button class="fa-storyring{ if seen } fa-storyring--seen{ end }" data-action="story.open" data-user-id="{user.id}">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="medium" />
            <span class="fa-storyring__handle">{user.handle}</span>
        </button>

facet StoryBar:
    looks:
        <div class="fa-storybar">
            slot:
                <span></span>
        </div>

facet StoryProgress:
    what:
        percent: int
    looks:
        <div class="fa-storyprog"><span class="fa-storyprog__fill" style="width:{percent}%"></span></div>

facet StoryViewer:
    what:
        user: User
    looks:
        <div class="fa-storyviewer">
            <header class="fa-storyviewer__head">
                <Avatar src="{user.avatar_url}" alt="{user.handle}" size="small" />
                <span class="fa-post__name">{user.display_name}</span>
                <button class="fa-iconbtn" data-action="story.close" aria-label="Close">×</button>
            </header>
            <div class="fa-storyviewer__media">
                slot:
                    <span></span>
            </div>
            <form class="fa-storyviewer__reply" data-action="story.reply">
                <input class="fa-input" name="body" placeholder="Reply…" autocomplete="off" />
            </form>
        </div>
