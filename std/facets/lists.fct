# fa.std — lists, collections, bookmarks, subscriptions.

facet ListCard:
    what:
        list: List
    looks:
        <a class="fa-listcard" href="{list.url}" data-nav>
            <img class="fa-listcard__cover" src="{list.cover}" alt="" />
            <div class="fa-listcard__meta">
                <span class="fa-listcard__name">{list.name}</span>
                <span class="fa-vcard__sub">{list.member_count} members</span>
            </div>
        </a>

facet ListRow:
    what:
        list: List
    looks:
        <a class="fa-listrow" href="{list.url}" data-nav>
            <span class="fa-listrow__name">{list.name}</span>
            <span class="fa-vcard__sub">{list.member_count} members · {list.owner}</span>
        </a>

facet BookmarkRow:
    what:
        post: Post
        author: User
    looks:
        <a class="fa-bookmarkrow" href="{post.url}" data-nav>
            <div class="fa-bookmarkrow__head">
                <Avatar src="{author.avatar_url}" alt="{author.handle}" size="small" />
                <span class="fa-post__name">{author.display_name}</span>
            </div>
            <p class="fa-bookmarkrow__body">{post.body}</p>
        </a>

facet CollectionCard:
    what:
        collection: Collection
    looks:
        <a class="fa-collcard" href="{collection.url}" data-nav>
            <div class="fa-collcard__cover"><img src="{collection.cover}" alt="" /></div>
            <span class="fa-listcard__name">{collection.name}</span>
            <span class="fa-vcard__sub">{collection.count} saved</span>
        </a>

facet SubscriptionRow:
    what:
        channel: Channel
        subscribed: bool
    looks:
        <div class="fa-subrow">
            <Avatar src="{channel.avatar_url}" alt="{channel.name}" size="small" />
            <div class="fa-subrow__meta">
                <span class="fa-post__name">{channel.name}</span>
                <span class="fa-vcard__sub">{channel.subscribers} subscribers</span>
            </div>
            <SubscribeButton subscribed="{subscribed}" price="0" />
        </div>
