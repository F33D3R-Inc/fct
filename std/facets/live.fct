# fa.std — live streaming. Covers the broadcast surface: player, chat, tips,
# gifts, viewer state, broadcaster controls, private shows.

facet LiveBadge:
    looks:
        <span class="fa-live"><span class="fa-live__dot"></span>LIVE</span>

facet ViewerCount:
    what:
        count: int
    looks:
        <span class="fa-viewers"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 5c-7 0-11 7-11 7s4 7 11 7 11-7 11-7-4-7-11-7zm0 11a4 4 0 110-8 4 4 0 010 8z"/></svg>{count}</span>

facet LiveStreamPlayer:
    what:
        stream: Stream
    looks:
        <div class="fa-stream">
            <video class="fa-stream__video" data-facet-player="{stream.id}" poster="{stream.poster}" autoplay playsinline></video>
            <div class="fa-stream__topbar">
                <LiveBadge />
                <ViewerCount count="{stream.viewer_count}" />
            </div>
            <div class="fa-stream__overlay">
                slot:
                    <span></span>
            </div>
        </div>

facet ChatMessage:
    what:
        message: ChatMsg
    looks:
        <div class="fa-chatmsg">
            <span class="fa-chatmsg__user" style="color:{message.color}">{message.handle}</span>
            <span class="fa-chatmsg__body">{message.body}</span>
        </div>

facet TipMessage:
    what:
        tip: Tip
    looks:
        <div class="fa-chatmsg fa-chatmsg--tip">
            <span class="fa-chatmsg__user">{tip.handle}</span>
            tipped <strong>{tip.amount}</strong> tokens!
        </div>

facet LiveChat:
    looks:
        <div class="fa-livechat" aria-live="polite">
            slot:
                <span></span>
        </div>

facet ChatComposer:
    what:
        stream: Stream
    looks:
        <form class="fa-chatcompose" data-action="chat.send" data-stream-id="{stream.id}">
            <input class="fa-input" name="body" placeholder="Say something…" autocomplete="off" />
            <button class="fa-iconbtn" data-action="chat.emoji" type="button" aria-label="Emoji">☺</button>
            <button class="fa-btn fa-btn--primary" type="submit">Chat</button>
        </form>

facet ReactionFly:
    what:
        emoji: str
    looks:
        <span class="fa-reactfly">{emoji}</span>

facet ReactionRail:
    looks:
        <div class="fa-reactrail">
            <button class="fa-reactbtn" data-action="react.send" data-emoji="heart" aria-label="Heart">❤️</button>
            <button class="fa-reactbtn" data-action="react.send" data-emoji="fire" aria-label="Fire">🔥</button>
            <button class="fa-reactbtn" data-action="react.send" data-emoji="clap" aria-label="Clap">👏</button>
            <button class="fa-reactbtn" data-action="react.send" data-emoji="wow" aria-label="Wow">😮</button>
        </div>

facet TipButton:
    what:
        amount: int
    looks:
        <button class="fa-tip" data-action="tip.send" data-amount="{amount}">🪙 {amount}</button>

facet TipGoal:
    what:
        current: int
        goal: int
        label: str
    looks:
        <div class="fa-tipgoal">
            <div class="fa-tipgoal__label">{label} — {current} / {goal}</div>
            <div class="fa-progress"><span class="fa-progress__fill" style="width:{current * 100 / goal}%"></span></div>
        </div>

facet GiftButton:
    what:
        gift: Gift
    looks:
        <button class="fa-gift" data-action="gift.send" data-gift-id="{gift.id}">
            <span class="fa-gift__icon">{gift.icon}</span>
            <span class="fa-gift__cost">{gift.cost}</span>
        </button>

facet GoLiveButton:
    looks:
        <button class="fa-golive" data-action="stream.start"><span class="fa-live__dot"></span>Go Live</button>

facet BroadcastControls:
    what:
        stream: Stream
        live: bool
    looks:
        <div class="fa-broadcast">
            <ViewerCount count="{stream.viewer_count}" />
            <button class="fa-iconbtn" data-action="stream.mute" aria-label="Mute">🎙</button>
            <button class="fa-iconbtn" data-action="stream.camera" aria-label="Flip camera">🎥</button>
            if live:
                <button class="fa-btn fa-btn--danger" data-action="stream.end">End Stream</button>
            else:
                <GoLiveButton />
        </div>

facet StreamEndCard:
    what:
        stream: Stream
    looks:
        <div class="fa-streamend">
            <h2>Stream ended</h2>
            <p>{stream.viewer_count} watched · {stream.duration}</p>
            <button class="fa-btn fa-btn--primary" data-action="stream.replay">Watch replay</button>
        </div>

facet OfflineCard:
    what:
        user: User
    looks:
        <div class="fa-offline">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="large" />
            <p>@{user.handle} is offline</p>
            <Button label="Notify me" variant="secondary" action="stream.notify" />
        </div>

facet TokenBalance:
    what:
        tokens: int
    looks:
        <span class="fa-tokens">🪙 {tokens}</span>

facet PrivateShowBar:
    what:
        price: int
    looks:
        <div class="fa-privshow">
            <span>Private show · {price} tokens/min</span>
            <button class="fa-btn fa-btn--primary" data-action="show.private">Start Private</button>
        </div>

facet ViewerRow:
    what:
        user: User
    looks:
        <div class="fa-viewerrow">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="small" />
            <span class="fa-post__handle">@{user.handle}</span>
            if user.tipper:
                <Badge label="Top tipper" tone="accent" />
        </div>
