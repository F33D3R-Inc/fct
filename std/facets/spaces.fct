# fa.std — live audio rooms / spaces.

facet LiveAudioBadge:
    looks:
        <span class="fa-audiobadge"><span class="fa-live__dot"></span> LIVE</span>

facet SpaceCard:
    what:
        space: Space
    looks:
        <a class="fa-spacecard" href="{space.url}" data-nav>
            <div class="fa-spacecard__head">
                <span class="fa-audiobadge"><span class="fa-live__dot"></span> LIVE</span>
                <span class="fa-spacecard__listeners">{space.listeners} listening</span>
            </div>
            <span class="fa-spacecard__title">{space.title}</span>
            <span class="fa-vcard__sub">{space.host}</span>
        </a>

facet SpaceBar:
    what:
        space: Space
    looks:
        <div class="fa-spacebar">
            <span class="fa-audiobadge"><span class="fa-live__dot"></span></span>
            <span class="fa-spacebar__title">{space.title}</span>
            <button class="fa-btn fa-btn--primary" data-action="space.join">Join</button>
        </div>

facet SpeakerTile:
    what:
        user: User
        speaking: bool
    looks:
        <div class="fa-speaker{ if speaking } fa-speaker--active{ end }">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="large" />
            <span class="fa-speaker__name">{user.display_name}</span>
        </div>

facet ListenerTile:
    what:
        user: User
    looks:
        <div class="fa-listener">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="medium" />
            <span class="fa-vcard__sub">{user.handle}</span>
        </div>

facet SpeakerGrid:
    what:
        room: Room
    looks:
        <div class="fa-speakergrid">
            for s in room.speakers:
                <SpeakerTile user="{s}" speaking="{s.speaking}" />
        </div>

facet MicButton:
    what:
        muted: bool
    looks:
        <button class="fa-micbtn{ if muted } fa-micbtn--muted{ end }" data-action="room.mic" data-fa-optimistic="fa-micbtn--muted" aria-label="Microphone">
            if muted:
                🔇
            else:
                🎤
        </button>

facet RaiseHandButton:
    what:
        raised: bool
    looks:
        <button class="fa-handbtn{ if raised } fa-handbtn--on{ end }" data-action="room.hand" data-fa-optimistic="fa-handbtn--on" aria-label="Raise hand">✋</button>

facet RoomHeader:
    what:
        room: Room
    looks:
        <header class="fa-roomhead">
            <span class="fa-roomhead__title">{room.title}</span>
            <span class="fa-vcard__sub">{room.listeners} listening</span>
            <button class="fa-iconbtn" data-action="room.leave" aria-label="Leave">×</button>
        </header>

facet RoomControls:
    what:
        muted: bool
        raised: bool
    looks:
        <div class="fa-roomctl">
            <MicButton muted="{muted}" />
            <RaiseHandButton raised="{raised}" />
            <button class="fa-btn fa-btn--danger" data-action="room.leave">Leave</button>
        </div>
