# fa.std — app shell: rails, columns, nav, feed tabs, section headers.

facet AppShell:
    looks:
        <div class="fa-appshell">
            slot:
                <span></span>
        </div>

facet LeftRail:
    looks:
        <aside class="fa-leftrail">
            slot:
                <span></span>
        </aside>

facet MainColumn:
    looks:
        <main class="fa-maincol">
            slot:
                <span></span>
        </main>

facet RightRail:
    looks:
        <aside class="fa-rightrail">
            slot:
                <span></span>
        </aside>

facet NavRailItem:
    what:
        label: str
        icon: str
        href: str
        active: bool
    looks:
        <a class="fa-navrail__item{ if active } fa-navrail__item--active{ end }" href="{href}" data-nav>
            <span class="fa-navrail__icon">{icon}</span>
            <span class="fa-navrail__label">{label}</span>
        </a>

facet NavRail:
    looks:
        <nav class="fa-navrail">
            slot:
                <span></span>
        </nav>

facet FeedTab:
    what:
        label: str
        active: bool
    looks:
        <button class="fa-feedtab{ if active } fa-feedtab--active{ end }" data-action="feed.tab" data-tab="{label}">{label}</button>

facet FeedTabs:
    what:
        page: TabPage
    looks:
        <nav class="fa-feedtabs">
            for t in page.tabs:
                <FeedTab label="{t.label}" active="{t.active}" />
        </nav>

facet SectionHeader:
    what:
        title: str
    looks:
        <header class="fa-sectionhead"><h2>{title}</h2></header>

facet BackBar:
    what:
        title: str
    looks:
        <header class="fa-backbar">
            <button class="fa-iconbtn" data-action="nav.back" aria-label="Back">←</button>
            <span class="fa-backbar__title">{title}</span>
        </header>

facet RightRailCard:
    what:
        title: str
    looks:
        <section class="fa-rrcard">
            <h2 class="fa-rrcard__title">{title}</h2>
            slot:
                <span></span>
        </section>
