# fa.std — layout facets: containers that wrap content via slots.
# Use these in BLOCK form: <Card title="x"> …content… </Card>

facet Card:
    what:
        title: str
    looks:
        <section class="fa-card">
            if title:
                <h3 class="fa-card__title">{title}</h3>
            <div class="fa-card__body">
                slot:
                    <span></span>
            </div>
        </section>

facet Stack:
    what:
        gap: str
    looks:
        <div class="fa-stack" style="gap:{gap}">
            slot:
                <span></span>
        </div>

facet Row:
    what:
        gap: str
    looks:
        <div class="fa-row" style="gap:{gap}">
            slot:
                <span></span>
        </div>

facet Modal:
    what:
        title: str
        open: bool
    looks:
        <div class="fa-modal{ if open } fa-modal--open{ end }" role="dialog" aria-modal="true" aria-label="{title}">
            <div class="fa-modal__backdrop" data-action="modal.close"></div>
            <div class="fa-modal__panel">
                <header class="fa-modal__header">
                    <h2 class="fa-modal__title">{title}</h2>
                    <button class="fa-modal__close" data-action="modal.close" aria-label="Close">×</button>
                </header>
                <div class="fa-modal__body">
                    slot:
                        <span></span>
                </div>
            </div>
        </div>
