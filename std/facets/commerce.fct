# fa.std — monetization: coins/tokens, tips, subscriptions, paywalls, wallet.

facet CoinBalance:
    what:
        coins: int
    looks:
        <span class="fa-coins">🪙 {coins}</span>

facet SubscribeButton:
    what:
        subscribed: bool
        price: int
    looks:
        if subscribed:
            <button class="fa-btn fa-btn--secondary" data-action="sub.toggle" data-fa-optimistic="is-on">Subscribed</button>
        else:
            <button class="fa-btn fa-btn--primary" data-action="sub.toggle">Subscribe · {price}/mo</button>

facet Paywall:
    what:
        price: int
    looks:
        <div class="fa-paywall">
            <div class="fa-paywall__lock">🔒</div>
            <p>Unlock for {price} tokens</p>
            <button class="fa-btn fa-btn--primary" data-action="content.unlock">Unlock</button>
        </div>

facet PriceTag:
    what:
        amount: int
        currency: str
    looks:
        <span class="fa-price">{currency}{amount}</span>

facet WalletCard:
    what:
        balance: int
    looks:
        <div class="fa-wallet">
            <span class="fa-wallet__label">Balance</span>
            <span class="fa-wallet__amount">🪙 {balance}</span>
            <button class="fa-btn fa-btn--primary" data-action="wallet.topup">Add Tokens</button>
        </div>

facet GiftItem:
    what:
        gift: Gift
    looks:
        <button class="fa-giftitem" data-action="gift.select" data-gift-id="{gift.id}">
            <span class="fa-giftitem__icon">{gift.icon}</span>
            <span class="fa-giftitem__name">{gift.name}</span>
            <span class="fa-giftitem__cost">🪙 {gift.cost}</span>
        </button>

facet GiftTray:
    looks:
        <div class="fa-gifttray">
            slot:
                <span></span>
        </div>
