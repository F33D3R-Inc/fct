# fa.std — direct-message facets.

facet MessageBubble:
    what:
        message: Message
        mine: bool
    looks:
        <div class="fa-msg{ if mine } fa-msg--mine{ end }">
            <div class="fa-msg__bubble">{message.body}</div>
            <span class="fa-msg__time">{message.time}</span>
        </div>

facet MessageList:
    looks:
        <div class="fa-msglist">
            slot:
                <span></span>
        </div>

facet DMComposer:
    what:
        thread: Thread
    looks:
        <form class="fa-dmcompose" data-action="dm.send" data-thread-id="{thread.id}">
            <input class="fa-input" name="body" placeholder="Start a message" autocomplete="off" />
            <button class="fa-btn fa-btn--primary" type="submit">Send</button>
        </form>

facet ThreadListItem:
    what:
        thread: Thread
        user: User
    looks:
        <a class="fa-thread" href="{thread.url}" data-nav>
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="medium" />
            <div class="fa-thread__meta">
                <span class="fa-post__name">{user.display_name}</span>
                <span class="fa-thread__preview">{thread.last_message}</span>
            </div>
            if thread.unread:
                <span class="fa-thread__dot" aria-label="unread"></span>
        </a>

facet TypingIndicator:
    looks:
        <div class="fa-typing" aria-label="typing"><span></span><span></span><span></span></div>
