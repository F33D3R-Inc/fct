# fa.std — loading / error / pagination states.

facet ErrorState:
    what:
        title: str
        message: str
    looks:
        <div class="fa-errorstate">
            <div class="fa-errorstate__icon">⚠️</div>
            <h3>{title}</h3>
            <p>{message}</p>
            <button class="fa-btn fa-btn--primary" data-action="retry">Try again</button>
        </div>

facet RetryCard:
    what:
        message: str
    looks:
        <div class="fa-retry">
            <span>{message}</span>
            <button class="fa-btn fa-btn--secondary" data-action="retry">Retry</button>
        </div>

facet LoadMoreButton:
    what:
        label: str
    looks:
        <button class="fa-loadmore" data-action="feed.more">{label}</button>

facet NewItemsPill:
    what:
        count: int
    looks:
        <button class="fa-newpill" data-action="feed.refresh">↑ {count} new posts</button>

facet Paginator:
    what:
        page: int
        total: int
    looks:
        <div class="fa-paginator">
            <button class="fa-iconbtn" data-action="page.prev" aria-label="Previous">←</button>
            <span class="fa-paginator__label">{page} / {total}</span>
            <button class="fa-iconbtn" data-action="page.next" aria-label="Next">→</button>
        </div>

facet RefreshButton:
    looks:
        <button class="fa-iconbtn" data-action="feed.refresh" aria-label="Refresh">↻</button>

facet SkeletonCard:
    looks:
        <div class="fa-skelcard">
            <div class="fa-skeleton fa-skelcard__avatar"></div>
            <div class="fa-skelcard__lines">
                <div class="fa-skeleton" style="width:60%"></div>
                <div class="fa-skeleton" style="width:90%"></div>
            </div>
        </div>

facet OfflineBanner:
    looks:
        <div class="fa-offlinebanner">You're offline. Reconnecting…</div>

facet EndOfFeed:
    what:
        message: str
    looks:
        <div class="fa-endfeed">{message}</div>
