# fa.std — auth facets. These compose FormField (slot) and FormError.

facet FormError:
    what:
        message: str
    looks:
        if message:
            <div class="fa-formerror" role="alert">{message}</div>
        else:
            <span></span>

facet OAuthButton:
    what:
        provider: str
        label: str
    looks:
        <button class="fa-oauth fa-oauth--{provider}" data-action="auth.oauth" data-provider="{provider}">{label}</button>

facet LoginForm:
    what:
        error: str
    looks:
        <form class="fa-auth" data-action="auth.login">
            <h1 class="fa-auth__title">Sign in</h1>
            <FormError message="{error}" />
            <FormField label="Email" hint="">
                <input class="fa-input" name="email" type="email" />
            </FormField>
            <FormField label="Password" hint="">
                <input class="fa-input" name="password" type="password" />
            </FormField>
            <button class="fa-btn fa-btn--primary" type="submit">Sign in</button>
        </form>

facet SignupForm:
    what:
        error: str
    looks:
        <form class="fa-auth" data-action="auth.signup">
            <h1 class="fa-auth__title">Create account</h1>
            <FormError message="{error}" />
            <FormField label="Name" hint="">
                <input class="fa-input" name="name" />
            </FormField>
            <FormField label="Email" hint="">
                <input class="fa-input" name="email" type="email" />
            </FormField>
            <FormField label="Password" hint="">
                <input class="fa-input" name="password" type="password" />
            </FormField>
            <button class="fa-btn fa-btn--primary" type="submit">Sign up</button>
        </form>
