# fa.std — video platform: cards, channel, engagement, chapters, playlists.

facet VideoCard:
    what:
        video: Video
        channel: Channel
    looks:
        <a class="fa-vcard" href="{video.url}" data-nav>
            <div class="fa-vcard__thumb">
                <img src="{video.thumb}" alt="" loading="lazy" />
                <span class="fa-vcard__dur">{video.duration}</span>
            </div>
            <div class="fa-vcard__row">
                <Avatar src="{channel.avatar_url}" alt="{channel.name}" size="small" />
                <div class="fa-vcard__meta">
                    <span class="fa-vcard__title">{video.title}</span>
                    <span class="fa-vcard__sub">{channel.name}</span>
                    <span class="fa-vcard__sub">{video.views} views · {video.age}</span>
                </div>
            </div>
        </a>

facet VideoCardCompact:
    what:
        video: Video
        channel: Channel
    looks:
        <a class="fa-vcardc" href="{video.url}" data-nav>
            <div class="fa-vcardc__thumb">
                <img src="{video.thumb}" alt="" loading="lazy" />
                <span class="fa-vcard__dur">{video.duration}</span>
            </div>
            <div class="fa-vcardc__meta">
                <span class="fa-vcardc__title">{video.title}</span>
                <span class="fa-vcard__sub">{channel.name}</span>
                <span class="fa-vcard__sub">{video.views} views · {video.age}</span>
            </div>
        </a>

facet VideoGrid:
    what:
        page: VideoPage
    looks:
        <div class="fa-vgrid">
            for v in page.videos:
                <VideoCard video="{v}" channel="{v.channel}" />
        </div>

facet WatchNextList:
    what:
        page: VideoPage
    looks:
        <div class="fa-watchnext">
            for v in page.videos:
                <VideoCardCompact video="{v}" channel="{v.channel}" />
        </div>

facet ChannelHeader:
    what:
        channel: Channel
        subscribed: bool
    looks:
        <header class="fa-channelhead">
            <img class="fa-channelhead__banner" src="{channel.banner_url}" alt="" />
            <div class="fa-channelhead__row">
                <Avatar src="{channel.avatar_url}" alt="{channel.name}" size="large" />
                <div class="fa-channelhead__meta">
                    <span class="fa-channelhead__name">{channel.name}</span>
                    <span class="fa-vcard__sub">{channel.handle} · {channel.subscribers} subscribers</span>
                </div>
                <SubscribeButton subscribed="{subscribed}" price="0" />
            </div>
        </header>

facet EngagementBar:
    what:
        video: Video
        liked: bool
    looks:
        <div class="fa-engage">
            <button class="fa-engage__btn{ if liked } fa-engage__btn--on{ end }" data-action="video.like" data-fa-optimistic="fa-engage__btn--on">👍 {video.likes}</button>
            <button class="fa-engage__btn" data-action="video.dislike">👎</button>
            <button class="fa-engage__btn" data-action="video.share">↗ Share</button>
            <button class="fa-engage__btn" data-action="video.save">＋ Save</button>
        </div>

facet VideoDescription:
    what:
        video: Video
    looks:
        <div class="fa-vdesc">
            <div class="fa-vdesc__stats">{video.views} views · {video.age}</div>
            <p class="fa-vdesc__body">{video.description}</p>
        </div>

facet ChapterItem:
    what:
        chapter: Chapter
    looks:
        <button class="fa-chapter" data-action="player.seek" data-time="{chapter.start}">
            <img class="fa-chapter__thumb" src="{chapter.thumb}" alt="" />
            <div class="fa-chapter__meta">
                <span class="fa-chapter__title">{chapter.title}</span>
                <span class="fa-vcard__sub">{chapter.timestamp}</span>
            </div>
        </button>

facet ChapterList:
    what:
        video: Video
    looks:
        <div class="fa-chapters">
            for ch in video.chapters:
                <ChapterItem chapter="{ch}" />
        </div>

facet CategoryChip:
    what:
        label: str
        active: bool
    looks:
        <button class="fa-catchip{ if active } fa-catchip--active{ end }" data-action="category.select" data-category="{label}">{label}</button>

facet CategoryChips:
    what:
        page: CategoryPage
    looks:
        <div class="fa-catchips">
            for cat in page.categories:
                <CategoryChip label="{cat.label}" active="{cat.active}" />
        </div>

facet ShortCard:
    what:
        video: Video
    looks:
        <a class="fa-short" href="{video.url}" data-nav>
            <img src="{video.thumb}" alt="" loading="lazy" />
            <div class="fa-short__overlay">
                <span class="fa-short__title">{video.title}</span>
                <span class="fa-short__views">{video.views} views</span>
            </div>
        </a>

facet PlaylistCard:
    what:
        playlist: Playlist
    looks:
        <a class="fa-plcard" href="{playlist.url}" data-nav>
            <div class="fa-plcard__thumb">
                <img src="{playlist.thumb}" alt="" loading="lazy" />
                <span class="fa-plcard__count">{playlist.count} videos</span>
            </div>
            <span class="fa-vcard__title">{playlist.title}</span>
        </a>

facet SortBar:
    what:
        label: str
    looks:
        <button class="fa-sortbar" data-action="sort.open">{label} ⌄</button>
