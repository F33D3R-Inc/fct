# fa.std — feed facets. These compose the atomics (Avatar, Badge) and media
# facets, and use custom-typed fields (Post/User) so each instance gets a unique
# facet-id (PostCard:post:42) — a like surgically updates that one card.

facet PostHeader:
    what:
        author: User
        time: str
    looks:
        <header class="fa-post__header">
            <Avatar src="{author.avatar_url}" alt="{author.handle}" size="medium" />
            <div class="fa-post__meta">
                <span class="fa-post__name">{author.display_name}</span>
                if author.verified:
                    <Badge label="✓" tone="accent" />
                <span class="fa-post__handle">@{author.handle}</span>
                <span class="fa-post__time">· {time}</span>
            </div>
        </header>

facet PostBody:
    what:
        post: Post
    looks:
        <div class="fa-post__body">{post.body}</div>

facet PostActionBar:
    what:
        post: Post
        liked: bool
        reposted: bool
    looks:
        <div class="fa-post__actions">
            <button class="fa-post__action" data-action="post.reply" data-post-id="{post.id}" aria-label="Reply">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                <span>{post.reply_count}</span>
            </button>
            <button class="fa-post__action{ if reposted } fa-post__action--reposted{ end }" data-action="post.repost" data-fa-optimistic="fa-post__action--reposted" data-post-id="{post.id}" aria-label="Repost">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4 M3 11V9a4 4 0 014-4h14 M7 23l-4-4 4-4 M21 13v2a4 4 0 01-4 4H3"/></svg>
                <span>{post.repost_count}</span>
            </button>
            <button class="fa-post__action{ if liked } fa-post__action--liked{ end }" data-action="post.like" data-fa-optimistic="fa-post__action--liked" data-post-id="{post.id}" aria-label="Like">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                <span>{post.like_count}</span>
            </button>
            <button class="fa-post__action" data-action="post.share" data-post-id="{post.id}" aria-label="Share">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8 M16 6l-4-4-4 4 M12 2v13"/></svg>
            </button>
        </div>

facet PostCard:
    what:
        post: Post
        author: User
        liked: bool
        reposted: bool
    looks:
        <article class="fa-post">
            <PostHeader author="{author}" time="{post.time}" />
            <PostBody post="{post}" />
            if post.media_url:
                <Image src="{post.media_url}" alt="{post.media_alt}" />
            <PostActionBar post="{post}" liked="{liked}" reposted="{reposted}" />
        </article>

facet QuotedPost:
    what:
        post: Post
        author: User
    looks:
        <a class="fa-quote" href="{post.url}" data-nav>
            <div class="fa-quote__head">
                <Avatar src="{author.avatar_url}" alt="{author.handle}" size="small" />
                <span class="fa-post__name">{author.display_name}</span>
                <span class="fa-post__handle">@{author.handle}</span>
            </div>
            <div class="fa-quote__body">{post.body}</div>
        </a>

facet CommentItem:
    what:
        comment: Comment
        author: User
    looks:
        <div class="fa-comment">
            <Avatar src="{author.avatar_url}" alt="{author.handle}" size="small" />
            <div class="fa-comment__body">
                <span class="fa-post__name">{author.display_name}</span>
                <span class="fa-post__handle">@{author.handle}</span>
                <p class="fa-comment__text">{comment.body}</p>
            </div>
        </div>

facet WhoToFollowRow:
    what:
        user: User
        following: bool
    looks:
        <div class="fa-wtf">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="small" />
            <div class="fa-wtf__meta">
                <span class="fa-post__name">{user.display_name}</span>
                <span class="fa-post__handle">@{user.handle}</span>
            </div>
            if following:
                <Button label="Following" variant="secondary" action="follow.toggle" />
            else:
                <Button label="Follow" variant="primary" action="follow.toggle" />
        </div>

facet Timeline:
    looks:
        <div class="fa-timeline">
            slot:
                <span></span>
        </div>
