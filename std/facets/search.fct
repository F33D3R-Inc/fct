# fa.std — search & explore.

facet SearchBar:
    looks:
        <form class="fa-searchbar" data-action="search.submit">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input class="fa-searchbar__input" name="q" placeholder="Search" autocomplete="off" />
        </form>

facet SearchResultPerson:
    what:
        user: User
        following: bool
    looks:
        <div class="fa-sresult">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="medium" />
            <div class="fa-sresult__meta">
                <span class="fa-post__name">{user.display_name}</span>
                <span class="fa-post__handle">@{user.handle}</span>
            </div>
            if following:
                <Button label="Following" variant="secondary" action="follow.toggle" />
            else:
                <Button label="Follow" variant="primary" action="follow.toggle" />
        </div>

facet SearchResultTopic:
    what:
        topic: Topic
    looks:
        <a class="fa-sresult" href="{topic.url}" data-nav>
            <div class="fa-sresult__meta">
                <span class="fa-post__name">#{topic.name}</span>
                <span class="fa-post__handle">{topic.post_count} posts</span>
            </div>
        </a>

facet TrendingItem:
    what:
        topic: Topic
        rank: int
    looks:
        <a class="fa-trend" href="{topic.url}" data-nav>
            <span class="fa-trend__rank">{rank} · Trending</span>
            <span class="fa-trend__name">{topic.name}</span>
            <span class="fa-trend__count">{topic.post_count} posts</span>
        </a>

facet ExploreTile:
    what:
        media: Media
    looks:
        <a class="fa-exploretile" href="{media.url}" data-nav>
            <img src="{media.thumb}" alt="" loading="lazy" />
            if media.is_video:
                <span class="fa-exploretile__play">▶</span>
        </a>
