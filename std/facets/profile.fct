# fa.std — profile facets.

facet ProfileBanner:
    what:
        url: str
    looks:
        <div class="fa-banner" style="background-image:url({url})"></div>

facet StatPill:
    what:
        value: int
        label: str
    looks:
        <span class="fa-stat"><strong>{value}</strong> {label}</span>

facet ProfileSummary:
    what:
        user: User
        following: bool
    looks:
        <section class="fa-profile">
            <ProfileBanner url="{user.banner_url}" />
            <div class="fa-profile__row">
                <Avatar src="{user.avatar_url}" alt="{user.handle}" size="large" />
                if following:
                    <Button label="Following" variant="secondary" action="follow.toggle" />
                else:
                    <Button label="Follow" variant="primary" action="follow.toggle" />
            </div>
            <h2 class="fa-profile__name">{user.display_name}</h2>
            <span class="fa-post__handle">@{user.handle}</span>
            <p class="fa-profile__bio">{user.bio}</p>
            <div class="fa-profile__stats">
                <StatPill value="{user.following_count}" label="Following" />
                <StatPill value="{user.follower_count}" label="Followers" />
            </div>
        </section>
