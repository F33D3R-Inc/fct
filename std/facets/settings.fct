# fa.std — settings: sections, rows, toggles, account switching.

facet SettingsSection:
    what:
        title: str
    looks:
        <section class="fa-setsection">
            <h2 class="fa-setsection__title">{title}</h2>
            slot:
                <span></span>
        </section>

facet SettingsRow:
    what:
        label: str
        hint: str
    looks:
        <div class="fa-setrow">
            <div class="fa-setrow__text">
                <span class="fa-setrow__label">{label}</span>
                <span class="fa-setrow__hint">{hint}</span>
            </div>
            <div class="fa-setrow__control">
                slot:
                    <span></span>
            </div>
        </div>

facet SettingsToggleRow:
    what:
        label: str
        hint: str
        on: bool
    looks:
        <div class="fa-setrow">
            <div class="fa-setrow__text">
                <span class="fa-setrow__label">{label}</span>
                <span class="fa-setrow__hint">{hint}</span>
            </div>
            <Toggle on="{on}" label="" action="settings.toggle" />
        </div>

facet SettingsNavItem:
    what:
        label: str
        icon: str
        href: str
    looks:
        <a class="fa-setnav" href="{href}" data-nav>
            <span class="fa-setnav__icon">{icon}</span>
            <span>{label}</span>
            <span class="fa-setnav__chev">›</span>
        </a>

facet SettingsLinkRow:
    what:
        label: str
        value: str
    looks:
        <button class="fa-setrow fa-setrow--link" data-action="settings.open">
            <span class="fa-setrow__label">{label}</span>
            <span class="fa-setrow__value">{value} ›</span>
        </button>

facet DangerButton:
    what:
        label: str
        action: str
    looks:
        <button class="fa-btn fa-btn--danger fa-dangerbtn" data-action="{action}">{label}</button>

facet AccountSwitchRow:
    what:
        user: User
        active: bool
    looks:
        <button class="fa-acctrow{ if active } fa-acctrow--active{ end }" data-action="account.switch" data-user-id="{user.id}">
            <Avatar src="{user.avatar_url}" alt="{user.handle}" size="small" />
            <div class="fa-acctrow__meta">
                <span class="fa-post__name">{user.display_name}</span>
                <span class="fa-post__handle">@{user.handle}</span>
            </div>
        </button>
