# fa.std — media facets. The runtime owns the players (data-facet-player);
# these are the containers.

facet Image:
    what:
        src: str
        alt: str
    looks:
        <img class="fa-media fa-media--img" src="{src}" alt="{alt}" loading="lazy" />

facet VideoPlayer:
    what:
        src: str
        poster: str
    looks:
        <video class="fa-media fa-media--video" data-facet-player="{src}" poster="{poster}" controls preload="none"></video>

facet AudioPlayer:
    what:
        src: str
        title: str
    looks:
        <figure class="fa-media fa-media--audio">
            <figcaption class="fa-media__caption">{title}</figcaption>
            <audio src="{src}" controls preload="none"></audio>
        </figure>

facet GifPlayer:
    what:
        src: str
        alt: str
    looks:
        <div class="fa-media fa-media--gif">
            <img src="{src}" alt="{alt}" loading="lazy" />
            <span class="fa-media__gif-badge">GIF</span>
        </div>

facet LinkPreview:
    what:
        url: str
        title: str
        description: str
        image: str
    looks:
        <a class="fa-linkpreview" href="{url}" data-nav>
            if image:
                <img class="fa-linkpreview__img" src="{image}" alt="" loading="lazy" />
            <div class="fa-linkpreview__body">
                <span class="fa-linkpreview__title">{title}</span>
                <span class="fa-linkpreview__desc">{description}</span>
                <span class="fa-linkpreview__domain">{url}</span>
            </div>
        </a>

facet SensitiveVeil:
    what:
        label: str
    looks:
        <div class="fa-veil" role="button" data-action="media.reveal" tabindex="0">
            <span class="fa-veil__label">{label}</span>
        </div>
