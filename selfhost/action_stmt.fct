import "parser_proc.fct"

app ActionStmtSelfHost:
    # Real, honest self-hosting port of `internal/parser/parser.go`'s
    # `parseAction` BODY statement vocabulary — the gap parser_proc.fct's own
    # closing note (STAGE 9) and program.fct's own header ("OTHER GENUINE
    # GAPS") both name explicitly: an action body is NOT proc-body grammar.
    # stmt.fct's `Stmt`/`parseProcBodySrc` ports `parseProcBody` (pure
    # computation: let/assign/if/loop/do/return/break/continue) — a real
    # action body instead has `check`/`requires`/`add`/`set`/`remove`/
    # `clear`/`call`/`do`/`let`(=bound call-or-do)/`establish`, a bare
    # builtin call, and a plain `target = expr` assignment (parseAction,
    # internal/parser/parser.go:1467-1636, read fresh for this file — an
    # action has NO `if`/`loop`/`return`/`break`/`continue` at all: its
    # switch has no such cases). Reusing stmt.fct's parser here would
    # silently misparse or wrongly reject every real action statement,
    # exactly as previously flagged; this file is the real, separate,
    # additional port that gap calls for.
    #
    # ============================================================
    # WHY THIS FILE CAN NOW `import "parser_proc.fct"` DIRECTLY (fixing the
    # `view Home` problem stmt.fct/program.fct's own headers describe)
    # ============================================================
    # stmt.fct's header (and program.fct's, restating the same point)
    # explains why a THIRD file combining source.fct-shaped tree-splitting
    # with expr.fct's expression grammar used to be impossible: every
    # selfhost file's own `view Home at "/"` collided at merge time. Checked
    # fresh for this task: every one of those views (stmt.fct, nodes.fct,
    # parser.fct, parser_decl2.fct, expr.fct, source.fct, ...) is NOW
    # `private view Home at "..."` — program.fct's own header documents
    # exactly this retrofit ("a real `private` modifier ... now exists ...
    # stmt.fct's and nodes.fct's six colliding `body*` helpers are now
    # `private proc`"). A private declaration mangles to a file-unique name
    # before merge, so two files each naming their own view/helper `Home`/
    # `bodyIndents` no longer collide regardless of the shared name. That
    # means this file can simply `import "parser_proc.fct"` (which chains
    # parser_proc -> stmt -> expr -> expr_tokens/expr_tree) and get
    # `ExprNode`/`parseExprTree`/`emptyNode`/`tokenKinds`/`tokenTexts`/
    # `orNodes`/`argListNodes` (via expr.fct), `firstEqIndex`/
    # `firstParenIndex`/`stmtIsBareCallStmt`/`stmtChildrenOf`/`doArgsNodes`
    # (via stmt.fct — all plain `proc`, not private, so genuinely reusable
    # across files), and the header/text-surgery/`check`-clause helpers
    # (via parser_proc.fct itself: `hasPrefixText`/`trimPrefixText`/
    # `indexOf`/`lastCharIndex`/`isIdentToken`/`headerName`/
    # `headerParamNames`/.../`checkConditionText`/`checkMessageRaw`/
    # `checkStatementValid`) — all WITHOUT restating a fourth copy of any of
    # them. Confirmed live below (this file compiles alongside the rest of
    # the chain — see the closing verification note).
    #
    # ============================================================
    # ActionStmt — ONE struct, a `kind: text` discriminant plus every field
    # any kind needs, exactly stmt.fct's own `Stmt` convention (a struct
    # literal must set every field, so an irrelevant one is left at its own
    # honest "absent" sentinel: `""` for an absent name, `[]` for an absent
    # list, `emptyNode()` for an absent expression, `false` for an absent
    # flag — never a magic number, never an arena index).
    #
    #   kind: one of "check" | "requires" | "add" | "set" | "setWhere" |
    #         "remove" | "removeWhere" | "clear" | "call" | "letCall" |
    #         "do" | "letDo" | "establish" | "assign" | "exprStmt" |
    #         "unsupported".
    #   lineIdx: this statement's own source line index (its caller's
    #         `texts`/`parents` arrays) — always present.
    #   valid: this statement's own accept/reject verdict — parseAction's
    #         own `error` return has no analogue in a language with no
    #         exception channel, so (matching every earlier self-host file's
    #         convention) a malformed line degrades to kind "unsupported"
    #         with valid=false rather than crashing or silently miscoding.
    #
    # Real parseAction routes a `requires` clause into a SEPARATE
    # `ast.Action.Requires` list, never `ast.Action.Body` — this struct
    # still models "requires" as one more ActionStmt kind (matching this
    # task's own brief) so `parseActionBodySrc` returns EVERY body-shaped
    # source line as one flat, source-ordered `[ActionStmt]` without losing
    # information; program.fct's own `ActionDecl` (see that file) then
    # SPLITS this flat list into `requires`/`body` via `actionRequiresOnly`/
    # `actionBodyOnly` below, mirroring ast.Action's real two-list shape
    # exactly once composed.
    #
    #   cond: ExprNode      — check's condition / setWhere's & removeWhere's
    #                          `where` predicate.
    #   msg: text           — check's message, RAW (still quoted/escaped,
    #                          undecoded) — the same choice parser_proc.fct's
    #                          own `checkMessageRaw` already makes and for
    #                          the identical reason (no string-unescape
    #                          builtin exists in this language).
    #   policyName: text    — requires' policy name.
    #   policyArgs: [ExprNode] — requires' policy-call argument list ([] for
    #                          a bare policy name).
    #   entity: text        — add/set/setWhere/remove/removeWhere/clear's
    #                          entity name.
    #   key: ExprNode       — set(by-id)/remove(by-id)'s key expression.
    #   field: text         — set(by-id)'s single field name.
    #   value: ExprNode     — set(by-id)'s RHS / assign's RHS.
    #   itemVar: text       — setWhere/removeWhere's item variable.
    #   fieldNames: [text]  — add's / setWhere's field-init names, index-
    #                          parallel to fieldValues.
    #   fieldValues: [ExprNode] — add's / setWhere's field-init expressions.
    #   serviceName: text   — call/letCall's service name.
    #   opName: text        — call/letCall's operation name.
    #   callArgs: [ExprNode] — call/letCall/do/letDo's argument list.
    #   procName: text      — do/letDo's proc name.
    #   bindName: text      — letCall/letDo's bound local name ("" for the
    #                          fire-and-forget call/do forms).
    #   actor: ExprNode     — establish's actor expression.
    #   hasRole: bool       — establish's optional `role` clause presence.
    #   role: ExprNode      — establish's optional role expression
    #                          (emptyNode() when hasRole is false).
    #   target: text        — plain assign's target name.
    #   exprCall: ExprNode  — exprStmt's bare builtin call, as one real
    #                          "call"-kind ExprNode (its own args already
    #                          nested inside via expr.fct's callNode).
    # ============================================================
    struct ActionStmt:
        kind: text
        lineIdx: int
        cond: ExprNode
        msg: text
        policyName: text
        policyArgs: [ExprNode]
        entity: text
        key: ExprNode
        field: text
        value: ExprNode
        itemVar: text
        fieldNames: [text]
        fieldValues: [ExprNode]
        serviceName: text
        opName: text
        callArgs: [ExprNode]
        procName: text
        bindName: text
        actor: ExprNode
        hasRole: bool
        role: ExprNode
        target: text
        exprCall: ExprNode
        valid: bool

    # actUnsupported: the one honest-degrade constructor every malformed
    # line below falls back to — every field at its neutral sentinel,
    # valid=false, matching stmt.fct's own "unsupported" Stmt kind.
    proc actUnsupported(lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        return ActionStmt{kind: "unsupported", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: false}

    # ============================================================
    # STAGE 1: this file's own local raw-text scanning helpers — the ones
    # parser_proc.fct's own STAGE 1 doesn't already provide, because an
    # action's grammar needs bracket/quote-DEPTH-aware scans (parser.go's
    # own `indexOutside`/`indexAssign`/`splitTop`) that no proc/action
    # header ever needed. Each is a faithful, quirk-preserving restatement
    # of its real Go counterpart (read fresh from parser.go — see this
    # file's own research step), not a "cleaned up" reimplementation.
    # ============================================================

    # actEndOfQuoted: parser.go's own `endOfQuoted`, MINUS its `{...}`
    # string-interpolation special case (`endOfInterp`) — a deliberate,
    # small, honestly-flagged simplification: no real action statement in
    # examples/*.fct or apps/*/*.fct nests a quoted string (let alone one
    # with `{expr}` interpolation containing its own `"`) inside the
    # `where`/`in`/`role` search zones this helper serves, so implementing
    # endOfInterp's own nested-brace-in-string tracking would be
    # disproportionate to any real, exercised case. Backslash-escapes a
    # single following character exactly like real Go.
    private proc actEndOfQuoted(s: text, i: int) -> int:
        let n = len(s)
        let mut j = i + 1
        let mut found = -1
        loop j < n && found == -1:
            let c = charAt(s, j)
            if c == "\\":
                j = j + 1
            else:
                if c == "\"":
                    found = j
            j = j + 1
        return found

    # actIndexOutside: parser.go's own `indexOutside` — the first occurrence
    # of `sep` outside every quoted string AND every bracket depth (every
    # bracket KIND folded into one shared counter, exactly like real Go).
    proc actIndexOutside(s: text, sep: text) -> int:
        let n = len(s)
        let m = len(sep)
        let mut depth = 0
        let mut i = 0
        let mut found = -1
        loop i < n && found == -1:
            let c = charAt(s, i)
            if c == "\"":
                let e = do actEndOfQuoted(s, i)
                if e < 0:
                    return -1
                i = e
            else:
                if c == "(" || c == "[" || c == "{":
                    depth = depth + 1
                else:
                    if c == ")" || c == "]" || c == "}":
                        depth = depth - 1
                    else:
                        if depth == 0:
                            if i + m <= n:
                                if slice(s, i, i + m) == sep:
                                    found = i
            i = i + 1
        return found

    # actIndexAssign: parser.go's own `indexAssign` — the FIRST top-level
    # (depth 0, outside quotes) `=` that is not part of `==`/`!=`/`<=`/`>=`.
    # Used wherever real Go's own parseSet/parseSetWhere use `indexAssign`
    # (the by-id `set` line and each field inside a filtered `set`'s body) —
    # NOT the same as `firstEqIndex` (stmt.fct's naive first-`=` scan),
    # which real parseAction's own plain-assignment DEFAULT case and its
    # `let name = ...` case both use instead (see STAGE 3 below: this file
    # deliberately calls the right one of the two per statement kind,
    # matching real Go's own genuine, if inconsistent, per-kind choice).
    proc actIndexAssign(s: text) -> int:
        let n = len(s)
        let mut depth = 0
        let mut i = 0
        let mut found = -1
        loop i < n && found == -1:
            let c = charAt(s, i)
            if c == "\"":
                let e = do actEndOfQuoted(s, i)
                if e < 0:
                    return -1
                i = e
            else:
                if c == "(" || c == "[" || c == "{":
                    depth = depth + 1
                else:
                    if c == ")" || c == "]" || c == "}":
                        depth = depth - 1
                    else:
                        if c == "=" && depth == 0:
                            let mut isDoubleEq = false
                            if i + 1 < n:
                                if charAt(s, i + 1) == "=":
                                    isDoubleEq = true
                            let mut isTailOfOp = false
                            if i > 0:
                                let prev = charAt(s, i - 1)
                                if prev == "!" || prev == "<" || prev == ">":
                                    isTailOfOp = true
                            if isDoubleEq:
                                i = i + 1
                            else:
                                if !isTailOfOp:
                                    found = i
            i = i + 1
        return found

    # actSplitTopComma: parser.go's own `splitTop(s, ',')` — comma-splitting
    # at the top level, skipping the inside of `(...)`/`{...}`/`[...]` and
    # `"..."` — ported with its own real, naive quote handling preserved
    # verbatim (a bare `"` just TOGGLES a flag; no escape awareness inside
    # this particular scan, exactly matching real Go's own `splitTop`,
    # which is genuinely this naive — a different, smaller quirk than
    # `actEndOfQuoted`'s own escape handling, and not a bug in this port).
    proc actSplitTopComma(s: text) -> [text]:
        let n = len(s)
        let mut depth = 0
        let mut inStr = false
        let mut start = 0
        let mut out = []
        let mut i = 0
        loop i < n:
            let c = charAt(s, i)
            if c == "\"":
                inStr = !inStr
            else:
                if !inStr:
                    if c == "(" || c == "{" || c == "[":
                        depth = depth + 1
                    else:
                        if c == ")" || c == "}" || c == "]":
                            depth = depth - 1
                        else:
                            if c == "," && depth == 0:
                                out = append(out, trim(slice(s, start, i)))
                                start = i + 1
            i = i + 1
        out = append(out, trim(slice(s, start, n)))
        return out

    # actFieldsSplit: Go's own `strings.Fields` — split on any run of
    # whitespace (space/tab, this port's own closed alphabet via
    # expr_tokens.fct's `isSpaceChar`, reused transitively rather than
    # restated), used for `set`/`remove`'s filtered-form header
    # (`item in Entity`), matching real parseSet/parseRemove's own
    # `strings.Fields(head)` exactly.
    proc actFieldsSplit(s: text) -> [text]:
        let n = len(s)
        let mut out = []
        let mut i = 0
        let mut curStart = -1
        loop i < n:
            let c = charAt(s, i)
            let sp = do isSpaceChar(c)
            if sp:
                if curStart >= 0:
                    out = append(out, slice(s, curStart, i))
                    curStart = -1
            else:
                if curStart < 0:
                    curStart = i
            i = i + 1
        if curStart >= 0:
            out = append(out, slice(s, curStart, n))
        return out

    # actBraceDepth: parser.go's own `braceDepth` — folds `(`/`{`/`[` and
    # `)`/`}`/`]` into a running depth (starting from `start`), skipping the
    # inside of `"..."` literals (a bare, un-escaped toggle, exactly like
    # `actSplitTopComma`'s own quote handling — real `braceDepth` is this
    # naive too).
    private proc actBraceDepth(s: text, start: int) -> int:
        let n = len(s)
        let mut depth = start
        let mut inStr = false
        let mut i = 0
        loop i < n:
            let c = charAt(s, i)
            if c == "\"":
                inStr = !inStr
            else:
                if !inStr:
                    if c == "(" || c == "{" || c == "[":
                        depth = depth + 1
                    else:
                        if c == ")" || c == "}" || c == "]":
                            depth = depth - 1
            i = i + 1
        return depth

    # actFirstParenTokenIndex / actCallArgsNodesFor: `call Service.op(args)`/
    # `do ProcName(args)`'s own argument list. Unlike stmt.fct's
    # `doArgsNodes` (which assumes the callee name is exactly ONE token, so
    # the arg list always starts at token index 2), a service call's own
    # `Service.op` is THREE tokens (ident, `.`, ident) before its `(` — so
    # this file finds the `(` token itself, generically, rather than
    # assuming a fixed offset. This one helper correctly covers both a
    # dotted service-op name and a plain single-ident proc name, so this
    # file uses it uniformly for call/letCall/do/letDo instead of also
    # depending on stmt.fct's fixed-offset version.
    private proc actFirstParenTokenIndex(texts: [text]) -> int:
        let n = len(texts)
        let mut i = 0
        let mut found = -1
        loop i < n && found == -1:
            if texts[i] == "(":
                found = i
            i = i + 1
        return found

    proc actCallArgsNodesFor(s: text) -> [ExprNode]:
        let kinds = do tokenKinds(s)
        let texts = do tokenTexts(s)
        let p = do actFirstParenTokenIndex(texts)
        if p < 0:
            return []
        let args = do argListNodes(kinds, texts, p + 1)
        return args

    # ============================================================
    # STAGE 2: this file's own private local indentation tree — the same
    # `bodyIndents`/`bodyTexts`/`bodyParents` restatement stmt.fct's own
    # STAGE 2 already established (now genuinely PRIVATE, so it cannot
    # collide with stmt.fct's own same-named private copies even though
    # both are pulled transitively into this file's own import chain — see
    # this file's header for why that collision is no longer possible).
    # ============================================================
    private proc actBodyIsBlankOrComment(line: text) -> bool:
        let t = trim(line)
        if len(t) == 0:
            return true
        return slice(t, 0, 1) == "#"

    private proc actBodyIndentOf(line: text) -> int:
        let n = len(line)
        let mut count = 0
        loop count < n && charAt(line, count) == " ":
            count = count + 1
        return count

    private proc actBodyIndents(src: text) -> [int]:
        let rawLines = split(src, "\n")
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let raw = rawLines[i]
            let skip = do actBodyIsBlankOrComment(raw)
            if !skip:
                let ind = do actBodyIndentOf(raw)
                out = append(out, ind)
            i = i + 1
        return out

    private proc actBodyTexts(src: text) -> [text]:
        let rawLines = split(src, "\n")
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let raw = rawLines[i]
            let skip = do actBodyIsBlankOrComment(raw)
            if !skip:
                out = append(out, trim(raw))
            i = i + 1
        return out

    private proc actBodyParents(indents: [int]) -> [int]:
        let n = len(indents)
        let mut stackIndent = []
        let mut stackNode = []
        let mut fillI = 0
        loop fillI < n:
            stackIndent = append(stackIndent, -1)
            stackNode = append(stackNode, -1)
            fillI = fillI + 1
        let mut top = -1
        let mut parents = []
        let mut k = 0
        loop k < n:
            let cur = indents[k]
            loop top >= 0:
                if stackIndent[top] >= cur:
                    top = top - 1
                else:
                    break
            let mut parent = -1
            if top >= 0:
                parent = stackNode[top]
            parents = append(parents, parent)
            top = top + 1
            stackIndent[top] = cur
            stackNode[top] = k
            k = k + 1
        return parents

    # actDescendantLines: parser.go's own `flattenLines` — every descendant
    # of `node`, depth-first, in source order (used only by `add`'s own
    # multi-line record-literal continuation, below).
    private proc actDescendantLines(node: int, parents: [int], texts: [text]) -> [text]:
        let kids = do stmtChildrenOf(node, parents)
        let m = len(kids)
        let mut out = []
        let mut i = 0
        loop i < m:
            let k = kids[i]
            out = append(out, texts[k])
            let sub = do actDescendantLines(k, parents, texts)
            let sn = len(sub)
            let mut j = 0
            loop j < sn:
                out = append(out, sub[j])
                j = j + 1
            i = i + 1
        return out

    # actCloseAddRecord: parser.go's own `closeAddRecord` — if `rest`'s own
    # brace/paren/bracket depth doesn't already return to zero (a record
    # literal that continues past its `add Entity {` header line), walk
    # `node`'s descendants depth-first, space-joining each onto `rest` until
    # the running depth returns to zero (FDL's offside rule already nests
    # a multi-line record's remaining fields as children of the `add`
    # line). A record that never balances degrades to returning `rest`
    # unchanged (this file's own `unsupported` fallback then naturally
    # fires downstream, since the unbalanced text has no matching `}`) —
    # the honest-degrade counterpart to real Go's hard parse error here.
    private proc actCloseAddRecord(rest: text, node: int, parents: [int], texts: [text]) -> text:
        let depth0 = do actBraceDepth(rest, 0)
        if depth0 <= 0:
            return rest
        let descendants = do actDescendantLines(node, parents, texts)
        let m = len(descendants)
        let mut result = rest
        let mut depth = depth0
        let mut i = 0
        let mut done = false
        loop i < m && !done:
            result = result + " " + descendants[i]
            let nextDepth = do actBraceDepth(descendants[i], depth)
            depth = nextDepth
            if depth <= 0:
                done = true
            i = i + 1
        return result

    # ============================================================
    # STAGE 3: singleActionStmt — one real action-body LINE (or, for `add`
    # and `set ... where ...:`, one line PLUS its own children — an add's
    # multi-line record continuation, or a filtered set's own `field =
    # expr` block) in, ONE (or for `requires`, one-per-comma-separated-
    # policy — see actRequiresStmts below) real `ActionStmt` out.
    #
    # Prefix-dispatch order is real parseAction's own switch order exactly
    # (check, requires, add, set, remove, clear, call, do, let, establish,
    # isBareCallStmt, default) — confirmed by reading parseAction fresh, not
    # assumed. An action has no `if`/`loop`/`return`/`break`/`continue`
    # case at all (unlike a proc body), so none is ported here — a real gap
    # this file does NOT need to close, since it does not exist.
    # ============================================================
    proc singleActionStmt(texts: [text], parents: [int], lineIdx: int) -> ActionStmt:
        let t = trim(texts[lineIdx])
        let noExpr = do emptyNode()

        let isCheck = do hasPrefixText(t, "check ")
        if isCheck:
            let rest = do trimPrefixText(t, "check ")
            let ok = do checkStatementValid(rest)
            if !ok:
                let u = do actUnsupported(lineIdx)
                return u
            let condSrc = do checkConditionText(rest)
            let condNode = do parseExprTree(condSrc)
            let msgRaw = do checkMessageRaw(rest)
            return ActionStmt{kind: "check", lineIdx: lineIdx, cond: condNode, msg: msgRaw, policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true}

        # `requires` needs to hand back POSSIBLY MULTIPLE ActionStmt entries
        # from one line (`requires owns(id), admin`) — that shape doesn't
        # fit this proc's one-Stmt-in one-Stmt-out contract, so it is
        # dispatched from the block loop directly (actionBlockStmts, STAGE
        # 4 below) via `actRequiresStmts`, never reached here. A `requires `
        # line therefore never reaches this proc's own prefix chain.

        let isAdd = do hasPrefixText(t, "add ")
        if isAdd:
            let s = do actAddStmt(texts, parents, lineIdx)
            return s

        let isSet = do hasPrefixText(t, "set ")
        if isSet:
            let s = do actSetStmt(texts, parents, lineIdx)
            return s

        let isRemove = do hasPrefixText(t, "remove ")
        if isRemove:
            let s = do actRemoveStmt(t, lineIdx)
            return s

        let isClear = do hasPrefixText(t, "clear ")
        if isClear:
            let entRaw = do trimPrefixText(t, "clear ")
            let ent = trim(entRaw)
            let ok = do isIdentToken(ent)
            if !ok:
                let u = do actUnsupported(lineIdx)
                return u
            return ActionStmt{kind: "clear", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: ent, key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true}

        let isCall = do hasPrefixText(t, "call ")
        if isCall:
            let rest = do trimPrefixText(t, "call ")
            let s = do actCallStmt(trim(rest), lineIdx, "")
            return s

        let isDo = do hasPrefixText(t, "do ")
        if isDo:
            let rest = do trimPrefixText(t, "do ")
            let s = do actDoStmt(trim(rest), lineIdx, "")
            return s

        let isLet = do hasPrefixText(t, "let ")
        if isLet:
            let restRaw = do trimPrefixText(t, "let ")
            let rest = trim(restRaw)
            let eq = do firstEqIndex(rest)
            if eq < 0:
                let u = do actUnsupported(lineIdx)
                return u
            let bindName = trim(slice(rest, 0, eq))
            let bindOk = do isIdentToken(bindName)
            if !bindOk:
                let u = do actUnsupported(lineIdx)
                return u
            let rhs = trim(slice(rest, eq + 1, len(rest)))
            let rhsIsCall = do hasPrefixText(rhs, "call ")
            if rhsIsCall:
                let callRestRaw = do trimPrefixText(rhs, "call ")
                let callRest = trim(callRestRaw)
                let s = do actCallStmt(callRest, lineIdx, bindName)
                return s
            let rhsIsDo = do hasPrefixText(rhs, "do ")
            if rhsIsDo:
                let doRestRaw = do trimPrefixText(rhs, "do ")
                let doRest = trim(doRestRaw)
                let s = do actDoStmt(doRest, lineIdx, bindName)
                return s
            let u = do actUnsupported(lineIdx)
            return u

        let isEstablish = do hasPrefixText(t, "establish ")
        if isEstablish:
            let s = do actEstablishStmt(t, lineIdx)
            return s

        let isBareCall = do stmtIsBareCallStmt(t)
        if isBareCall:
            let callNode = do parseExprTree(t)
            let ok = callNode.kind == "call"
            return ActionStmt{kind: "exprStmt", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: callNode, valid: ok}

        # Default: `target = expr` — real parseAction's own DEFAULT case
        # uses the NAIVE first-`=` scan (`strings.IndexByte`), not the
        # smart `indexAssign` `set`/`setWhere` use — matched exactly here
        # via `firstEqIndex` (stmt.fct's own naive scan), not
        # `actIndexAssign`.
        let eq2 = do firstEqIndex(t)
        if eq2 < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let target = trim(slice(t, 0, eq2))
        let targetOk = do isIdentToken(target)
        if !targetOk:
            let u = do actUnsupported(lineIdx)
            return u
        let val = do parseExprTree(trim(slice(t, eq2 + 1, len(t))))
        return ActionStmt{kind: "assign", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: val, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: target, exprCall: noExpr, valid: true}

    # actCallStmt: `Service.op(args)` (the shared shape of both bare `call
    # Service.op(args)` and bound `let name = call Service.op(args)`).
    # `bindName` is "" for the fire-and-forget form.
    proc actCallStmt(rest: text, lineIdx: int, bindName: text) -> ActionStmt:
        let noExpr = do emptyNode()
        let open = do firstParenIndex(rest)
        if open < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let target = trim(slice(rest, 0, open))
        let dot = do indexOf(target, ".")
        if dot < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let svc = trim(slice(target, 0, dot))
        let op = trim(slice(target, dot + 1, len(target)))
        let svcOk = do isIdentToken(svc)
        let opOk = do isIdentToken(op)
        if !svcOk || !opOk:
            let u = do actUnsupported(lineIdx)
            return u
        let close = do lastCharIndex(rest, ")")
        if close < open:
            let u = do actUnsupported(lineIdx)
            return u
        let args = do actCallArgsNodesFor(rest)
        let mut kind = "call"
        if bindName != "":
            kind = "letCall"
        return ActionStmt{kind: kind, lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: svc, opName: op, callArgs: args, procName: "", bindName: bindName, actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true}

    # actDoStmt: `ProcName(args)` (the shared shape of both bare `do
    # ProcName(args)` and bound `let name = do ProcName(args)`).
    proc actDoStmt(rest: text, lineIdx: int, bindName: text) -> ActionStmt:
        let noExpr = do emptyNode()
        let open = do firstParenIndex(rest)
        if open < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let name = trim(slice(rest, 0, open))
        let nameOk = do isIdentToken(name)
        if !nameOk:
            let u = do actUnsupported(lineIdx)
            return u
        let close = do lastCharIndex(rest, ")")
        if close < open:
            let u = do actUnsupported(lineIdx)
            return u
        let args = do actCallArgsNodesFor(rest)
        let mut kind = "do"
        if bindName != "":
            kind = "letDo"
        return ActionStmt{kind: kind, lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: args, procName: name, bindName: bindName, actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true}

    # actEstablishStmt: `establish actor <expr> [role <expr>]`. The
    # `" role "` search is a PLAIN substring index (real Go's own
    # `strings.Index`, not the bracket/quote-depth-aware `indexOutside`) —
    # a real, confirmed quirk (an actor expression containing the literal
    # substring `" role "` inside a nested call argument would be mis-split)
    # preserved verbatim, matching this port's established convention.
    proc actEstablishStmt(t: text, lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let rest0Raw = do trimPrefixText(t, "establish ")
        let rest0 = trim(rest0Raw)
        let hasActor = do hasPrefixText(rest0, "actor ")
        if !hasActor:
            let u = do actUnsupported(lineIdx)
            return u
        let restRaw = do trimPrefixText(rest0, "actor ")
        let rest = trim(restRaw)
        let roleIdx = do indexOf(rest, " role ")
        let mut actorSrc = rest
        let mut hasRole = false
        let mut roleSrc = ""
        if roleIdx >= 0:
            roleSrc = trim(slice(rest, roleIdx + 6, len(rest)))
            actorSrc = trim(slice(rest, 0, roleIdx))
            hasRole = true
        let actorNode = do parseExprTree(actorSrc)
        let mut roleNode = noExpr
        if hasRole:
            let r = do parseExprTree(roleSrc)
            roleNode = r
        return ActionStmt{kind: "establish", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: actorNode, hasRole: hasRole, role: roleNode, target: "", exprCall: noExpr, valid: true}

    # actAddStmt: `add Entity { f: expr, ... }`, including the multi-line
    # record-literal continuation (actCloseAddRecord, above). Field names
    # are NOT validated as identifiers — a real, confirmed quirk: real
    # Go's own parseAdd never calls isIdent on a field's own name, unlike
    # almost every other name in this grammar.
    proc actAddStmt(texts: [text], parents: [int], lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let t = trim(texts[lineIdx])
        let rest0Raw = do trimPrefixText(t, "add ")
        let rest0 = trim(rest0Raw)
        let rest = do actCloseAddRecord(rest0, lineIdx, parents, texts)
        let open = do indexOf(rest, "{")
        let close = do lastCharIndex(rest, "}")
        if open < 0 || close < open:
            let u = do actUnsupported(lineIdx)
            return u
        let ent = trim(slice(rest, 0, open))
        let entOk = do isIdentToken(ent)
        if !entOk:
            let u = do actUnsupported(lineIdx)
            return u
        let body = trim(slice(rest, open + 1, close))
        let mut fieldNames = []
        let mut fieldValues = []
        let mut ok = true
        if body != "":
            let parts = do actSplitTopComma(body)
            let n = len(parts)
            let mut i = 0
            loop i < n && ok:
                let part = parts[i]
                let colon = do indexOf(part, ":")
                if colon < 0:
                    ok = false
                else:
                    let fn = trim(slice(part, 0, colon))
                    let ev = do parseExprTree(trim(slice(part, colon + 1, len(part))))
                    fieldNames = append(fieldNames, fn)
                    fieldValues = append(fieldValues, ev)
                i = i + 1
        if !ok:
            let u = do actUnsupported(lineIdx)
            return u
        return ActionStmt{kind: "add", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: ent, key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: fieldNames, fieldValues: fieldValues, serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true}

    # actSetStmt: the two real forms — `set Entity(key).field = expr`
    # (by-id) and `set item in Entity where cond:` (filtered, its own
    # `field = expr` block read from `lineIdx`'s CHILDREN). The by-id LHS
    # `Entity(key).field` is parsed via expr.fct's OWN expression grammar
    # (`parseExprTree`, expecting the resulting node's kind to be
    # "entityGet") rather than a hand-written parseEntityPath — a genuine,
    # deliberate reuse win: expr_tree.fct's `entityGetNodes` already
    # recurses through its own key expression via `orNodes`, so it composes
    # correctly even for a chained/nested key like
    # `Product(CartLine(lid).product).stock` for free, with no separate
    # matched-paren logic needed here.
    proc actSetStmt(texts: [text], parents: [int], lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let t = trim(texts[lineIdx])
        let restRaw = do trimPrefixText(t, "set ")
        let rest = trim(restRaw)
        let wi = do actIndexOutside(rest, " where ")
        let mut isWhere = false
        if wi >= 0:
            let head0 = slice(rest, 0, wi)
            let inIdx = do actIndexOutside(head0, " in ")
            if inIdx >= 0:
                isWhere = true
        if isWhere:
            let head = trim(slice(rest, 0, wi))
            let condRaw = trim(slice(rest, wi + 7, len(rest)))
            let condNoColon = do trimSuffixText(condRaw, ":")
            let condSrc = trim(condNoColon)
            let hf = do actFieldsSplit(head)
            let mut shapeOk = len(hf) == 3
            if shapeOk:
                if hf[1] != "in":
                    shapeOk = false
            if shapeOk:
                let v0 = do isIdentToken(hf[0])
                let v2 = do isIdentToken(hf[2])
                if !v0 || !v2:
                    shapeOk = false
            let endsColon = do hasSuffixText(t, ":")
            if !shapeOk || !endsColon:
                let u = do actUnsupported(lineIdx)
                return u
            let whereNode = do parseExprTree(condSrc)
            let kids = do stmtChildrenOf(lineIdx, parents)
            let m = len(kids)
            let mut fieldNames = []
            let mut fieldValues = []
            let mut i = 0
            loop i < m:
                let ct = trim(texts[kids[i]])
                let ceq = do actIndexAssign(ct)
                if ceq >= 0:
                    let fname = trim(slice(ct, 0, ceq))
                    let fnOk = do isIdentToken(fname)
                    if fnOk:
                        let fval = do parseExprTree(trim(slice(ct, ceq + 1, len(ct))))
                        fieldNames = append(fieldNames, fname)
                        fieldValues = append(fieldValues, fval)
                i = i + 1
            let overallValid = len(fieldNames) > 0
            return ActionStmt{kind: "setWhere", lineIdx: lineIdx, cond: whereNode, msg: "", policyName: "", policyArgs: [], entity: hf[2], key: noExpr, field: "", value: noExpr, itemVar: hf[0], fieldNames: fieldNames, fieldValues: fieldValues, serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: overallValid}
        let eq = do actIndexAssign(rest)
        if eq < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let lhs = trim(slice(rest, 0, eq))
        let valNode = do parseExprTree(trim(slice(rest, eq + 1, len(rest))))
        let lhsNode = do parseExprTree(lhs)
        if lhsNode.kind != "entityGet":
            let u = do actUnsupported(lineIdx)
            return u
        let fieldOk = do isIdentToken(lhsNode.field)
        if !fieldOk:
            let u = do actUnsupported(lineIdx)
            return u
        return ActionStmt{kind: "set", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: lhsNode.text, key: lhsNode.children[0], field: lhsNode.field, value: valNode, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true}

    # actRemoveStmt: `remove Entity(key)` (by-id) or `remove item in Entity
    # where cond` (filtered — a single line, NOT a block, unlike `set`'s
    # own filtered form: real ast.Remove's filtered shape carries only a
    # predicate, never a block of assignments). The by-id form's own entity
    # name is NOT validated as an identifier — a real, confirmed quirk:
    # real Go's own parseRemove never calls isIdent on it (unlike `add`'s
    # entity name, which IS validated) — preserved here exactly.
    proc actRemoveStmt(t: text, lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let restRaw = do trimPrefixText(t, "remove ")
        let rest = trim(restRaw)
        let wi = do actIndexOutside(rest, " where ")
        let mut isWhere = false
        if wi >= 0:
            let head0 = slice(rest, 0, wi)
            let inIdx = do actIndexOutside(head0, " in ")
            if inIdx >= 0:
                isWhere = true
        if isWhere:
            let head = trim(slice(rest, 0, wi))
            let hf = do actFieldsSplit(head)
            let mut shapeOk = len(hf) == 3
            if shapeOk:
                if hf[1] != "in":
                    shapeOk = false
            if shapeOk:
                let v0 = do isIdentToken(hf[0])
                let v2 = do isIdentToken(hf[2])
                if !v0 || !v2:
                    shapeOk = false
            if !shapeOk:
                let u = do actUnsupported(lineIdx)
                return u
            let condSrc = trim(slice(rest, wi + 7, len(rest)))
            let condNode = do parseExprTree(condSrc)
            return ActionStmt{kind: "removeWhere", lineIdx: lineIdx, cond: condNode, msg: "", policyName: "", policyArgs: [], entity: hf[2], key: noExpr, field: "", value: noExpr, itemVar: hf[0], fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true}
        let open = do firstParenIndex(rest)
        let close = do lastCharIndex(rest, ")")
        if open < 0 || close < open:
            let u = do actUnsupported(lineIdx)
            return u
        let ent = trim(slice(rest, 0, open))
        let keyNode = do parseExprTree(trim(slice(rest, open + 1, close)))
        return ActionStmt{kind: "remove", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: ent, key: keyNode, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true}

    # actRequiresStmts: `requires <policy>` or `requires <policy>(args),
    # <policy2>, ...` — ONE line can produce SEVERAL real ast.Require
    # entries (real Go appends one per comma-separated piece via
    # `splitTop`), so this returns a `[ActionStmt]`, all kind "requires",
    # all sharing the same `lineIdx`.
    proc actRequiresStmts(t: text, lineIdx: int) -> [ActionStmt]:
        let noExpr = do emptyNode()
        let restRaw = do trimPrefixText(t, "requires ")
        let rest = trim(restRaw)
        let pieces = do actSplitTopComma(rest)
        let n = len(pieces)
        let mut out = []
        let mut i = 0
        loop i < n:
            let p = trim(pieces[i])
            let open = do firstParenIndex(p)
            if open < 0:
                let nameOk = do isIdentToken(p)
                if nameOk:
                    out = append(out, ActionStmt{kind: "requires", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: p, policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true})
                else:
                    let u1 = do actUnsupported(lineIdx)
                    out = append(out, u1)
            else:
                let name = trim(slice(p, 0, open))
                let nameOk = do isIdentToken(name)
                let close = do lastCharIndex(p, ")")
                if !nameOk || close < open:
                    let u2 = do actUnsupported(lineIdx)
                    out = append(out, u2)
                else:
                    let inner = trim(slice(p, open + 1, close))
                    let mut args = []
                    if inner != "":
                        let argPieces = do actSplitTopComma(inner)
                        let an = len(argPieces)
                        let mut j = 0
                        loop j < an:
                            let av = do parseExprTree(trim(argPieces[j]))
                            args = append(args, av)
                            j = j + 1
                    out = append(out, ActionStmt{kind: "requires", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: name, policyArgs: args, entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, valid: true})
            i = i + 1
        return out

    # ============================================================
    # STAGE 4: actionBlockStmts — one whole action body (its header's own
    # indented children), flat (no `if`/`loop` recursion exists in this
    # grammar at all — see STAGE 3's own header note). `setWhere`'s own
    # `field = expr` children are read directly by `actSetStmt` from
    # `stmtChildrenOf(lineIdx, parents)` and are NEVER also top-level
    # children of the action's own header node (FDL's offside rule nests
    # them one level under the `set ...:` line itself), so they are never
    # double-visited here — the same non-double-processing property
    # stmt.fct's own if/else lookahead needed an explicit skip for, but
    # here falls out for free from the parent-index tree shape alone.
    # ============================================================
    proc actionBlockStmts(texts: [text], parents: [int], node: int) -> [ActionStmt]:
        let kids = do stmtChildrenOf(node, parents)
        let m = len(kids)
        let mut out = []
        let mut i = 0
        loop i < m:
            let lineIdx = kids[i]
            let t = trim(texts[lineIdx])
            let isRequires = do hasPrefixText(t, "requires ")
            if isRequires:
                let rs = do actRequiresStmts(t, lineIdx)
                let rn = len(rs)
                let mut j = 0
                loop j < rn:
                    out = append(out, rs[j])
                    j = j + 1
            else:
                let s = do singleActionStmt(texts, parents, lineIdx)
                out = append(out, s)
            i = i + 1
        return out

    # parseActionBodySrc: the end-to-end driver this task asks for — raw,
    # dedented action-body TEXT in (exactly what a real `action Name(...):`
    # header's own indented children would look like, joined with `\n`),
    # one flat, real, source-ordered `[ActionStmt]` out.
    proc parseActionBodySrc(src: text) -> [ActionStmt]:
        let indents = do actBodyIndents(src)
        let parents = do actBodyParents(indents)
        let texts = do actBodyTexts(src)
        let r = do actionBlockStmts(texts, parents, -1)
        return r

    # actionBodyOnly / actionRequiresOnly: the split back into real
    # ast.Action's own two-list shape (`Body` excludes `requires`;
    # `Requires` is ONLY `requires`) — program.fct's `buildActionDecl` uses
    # both over one `parseActionBodySrc` result, so no statement's source
    # position or content is lost by modeling `requires` as one more
    # ActionStmt kind up front.
    proc actionBodyOnly(stmts: [ActionStmt]) -> [ActionStmt]:
        let n = len(stmts)
        let mut out = []
        let mut i = 0
        loop i < n:
            if stmts[i].kind != "requires":
                out = append(out, stmts[i])
            i = i + 1
        return out

    proc actionRequiresOnly(stmts: [ActionStmt]) -> [ActionStmt]:
        let n = len(stmts)
        let mut out = []
        let mut i = 0
        loop i < n:
            if stmts[i].kind == "requires":
                out = append(out, stmts[i])
            i = i + 1
        return out

    # ============================================================
    # STAGE 5: action HEADER parsing — `action Name(params) [@optimistic]:`.
    # Real parseAction's own header is `parseSignature(head, ..., false,
    # false)` over the SAME head shape parser_proc.fct's own STAGE 4/5
    # already ports for `proc` (a proc header is `Name(params) [-> Ret]
    # [uses ...]`; an action's is just `Name(params)`, i.e. a proc header
    # with no return/uses clause at all) — so `headerName`/
    # `headerParamNames`/`headerParamTypes`/`headerParamOptionals`/
    # `headerParensValid`/`headerParamsValid`/`headerNameValid` (all
    # already reusable, unmodified, from parser_proc.fct) are reused
    # DIRECTLY over the action's own (`@optimistic`-stripped, `:`-stripped)
    # head text, rather than restated a second time.
    #
    # The one real difference `parseSignature`'s own `allowList=false`
    # argument encodes that parser_proc.fct's existing `headerParamsValid`
    # does NOT check (that helper's own header note says so explicitly: it
    # was written assuming `allowList=true`, since only `proc` ever called
    # it before now) — an action parameter may never be a `[T]` list. That
    # extra rejection is added here, in `actionHeaderValid`, rather than by
    # editing parser_proc.fct (out of scope this round, and the existing
    # helper's own behavior for `proc` must not change).
    # ============================================================
    proc actionHeadOf(lineText: text) -> text:
        let stripped = do trimPrefixText(lineText, "action")
        let trimmed = trim(stripped)
        let r = do trimSuffixText(trimmed, ":")
        return trim(r)

    proc actionIsOptimistic(rawHead: text) -> bool:
        let r = do hasSuffixText(rawHead, "@optimistic")
        return r

    proc actionHeadStripOptimistic(rawHead: text) -> text:
        let isOpt = do actionIsOptimistic(rawHead)
        if isOpt:
            let s = do trimSuffixText(rawHead, "@optimistic")
            return trim(s)
        return rawHead

    proc actionNoListParams(head: text) -> bool:
        let lists = do headerParamLists(head)
        let n = len(lists)
        let mut ok = true
        let mut i = 0
        loop i < n:
            if lists[i]:
                ok = false
            i = i + 1
        return ok

    proc actionHeaderValid(head: text) -> bool:
        let nameOk = do headerNameValid(head)
        if !nameOk:
            return false
        let parensOk = do headerParensValid(head)
        if !parensOk:
            return false
        let paramsOk = do headerParamsValid(head)
        if !paramsOk:
            return false
        let noLists = do actionNoListParams(head)
        return noLists

    # ============================================================
    # STAGE 6: describeActionStmt(s) — proof the `[ActionStmt]` result is
    # genuinely walkable, the same live-verification shape stmt.fct's own
    # STAGE 8 established for `[Stmt]`.
    # ============================================================
    proc describeActionStmt(s: ActionStmt) -> text:
        if s.kind == "check":
            return "check(" + s.msg + ")"
        if s.kind == "requires":
            return "requires(" + s.policyName + ")"
        if s.kind == "add":
            return "add(" + s.entity + ")"
        if s.kind == "set":
            return "set(" + s.entity + "." + s.field + ")"
        if s.kind == "setWhere":
            return "setWhere(" + s.entity + ")"
        if s.kind == "remove":
            return "remove(" + s.entity + ")"
        if s.kind == "removeWhere":
            return "removeWhere(" + s.entity + ")"
        if s.kind == "clear":
            return "clear(" + s.entity + ")"
        if s.kind == "call":
            return "call(" + s.serviceName + "." + s.opName + ")"
        if s.kind == "letCall":
            return "letCall(" + s.bindName + "=" + s.serviceName + "." + s.opName + ")"
        if s.kind == "do":
            return "do(" + s.procName + ")"
        if s.kind == "letDo":
            return "letDo(" + s.bindName + "=" + s.procName + ")"
        if s.kind == "establish":
            return "establish"
        if s.kind == "assign":
            return "assign(" + s.target + ")"
        if s.kind == "exprStmt":
            return "exprStmt"
        return "unsupported"

    proc describeActionStmts(stmts: [ActionStmt]) -> text:
        let n = len(stmts)
        let mut out = ""
        let mut i = 0
        loop i < n:
            let d = do describeActionStmt(stmts[i])
            if i > 0:
                out = out + ","
            out = out + d
            i = i + 1
        return out

    proc describeActionBody(src: text) -> text:
        let r = do parseActionBodySrc(src)
        let d = do describeActionStmts(r)
        return d

    proc topLevelActionStmtCount(src: text) -> int:
        let r = do parseActionBodySrc(src)
        return len(r)

    # ============================================================
    # STAGE 7: the live, HTTP-exercisable driver — POST a real multi-line
    # action body `src` and get back a text summary of the real
    # `[ActionStmt]` tree plus its statement count, exactly stmt.fct's own
    # STAGE 10 shape. The demo body below is `examples/identity.fct`'s own
    # real `login` action body (check/let-call/establish/plain-assign, all
    # hand-verified against that file directly — see this task's own
    # closing report).
    # ============================================================
    state actDemoResult: text = ""
    state actDemoCount: int = 0

    action runParseActionBody(src: text):
        let d = do describeActionBody(src)
        let c = do topLevelActionStmtCount(src)
        actDemoResult = d
        actDemoCount = c

    private view ActionStmtHome at "/action_stmt":
        box:
            text "{actDemoCount} {actDemoResult}"
