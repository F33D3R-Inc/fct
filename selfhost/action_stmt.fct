import "parser_proc.fct"

app ActionStmtSelfHost:
    # Real, honest self-hosting port of `internal/parser/parser.go`'s
    # `parseAction` BODY statement vocabulary — the gap parser_proc.fct's own
    # closing note (STAGE 9) and program.fct's own header ("OTHER GENUINE
    # GAPS") both name explicitly: an action body is NOT proc-body grammar.
    # stmt.fct's `Stmt`/`parseProcBodySrc` ports `parseProcBody` (pure
    # computation: let/assign/if/loop/do/return/break/continue) — a real
    # action body instead has `check`/`requires`/`add`/`set`/`remove`/
    # `clear`/`call`/`do`/`let`/`establish`, a bare builtin call, a plain
    # `target = expr` assignment, and — since the real grammar grew control
    # flow (parser.go's parseActionBody) — `for <range>:` over an entity's
    # rows, `if`/`else`, `let name = expr` and `let id = add …`. An action
    # still has NO `loop`/`return`/`break`/`continue`/`let mut`: those stay
    # proc-only, and `for` takes a view's Range header rather than a proc's
    # `loop <cond>`. Reusing stmt.fct's parser here would therefore still
    # misparse or wrongly reject real action statements; this file is the
    # real, separate port, kept in step with parseActionBody.
    #
    # ============================================================
    # WHY THIS FILE CAN NOW `import "parser_proc.fct"` DIRECTLY (fixing the
    # `view Home` problem stmt.fct/program.fct's own headers describe)
    # ============================================================
    # stmt.fct's header (and program.fct's, restating the same point)
    # explains why a THIRD file combining source.fct-shaped tree-splitting
    # with expr.fct's expression grammar used to be impossible: every
    # selfhost file's own `view Home at "/"` collided at merge time. Checked
    # fresh for this task: every one of those views (stmt.fct, nodes.fct,
    # parser.fct, parser_decl2.fct, expr.fct, source.fct, ...) is NOW
    # `private view Home at "..."` — program.fct's own header documents
    # exactly this retrofit ("a real `private` modifier ... now exists ...
    # stmt.fct's and nodes.fct's six colliding `body*` helpers are now
    # `private proc`"). A private declaration mangles to a file-unique name
    # before merge, so two files each naming their own view/helper `Home`/
    # `bodyIndents` no longer collide regardless of the shared name. That
    # means this file can simply `import "parser_proc.fct"` (which chains
    # parser_proc -> stmt -> expr -> expr_tokens/expr_tree) and get
    # `ExprNode`/`parseExprTree`/`emptyNode`/`tokenKinds`/`tokenTexts`/
    # `orNodes`/`argListNodes` (via expr.fct), `firstEqIndex`/
    # `firstParenIndex`/`stmtIsBareCallStmt`/`stmtChildrenOf`/`doArgsNodes`
    # (via stmt.fct — all plain `proc`, not private, so genuinely reusable
    # across files), and the header/text-surgery/`check`-clause helpers
    # (via parser_proc.fct itself: `hasPrefixText`/`trimPrefixText`/
    # `indexOf`/`lastCharIndex`/`isIdentToken`/`headerName`/
    # `headerParamNames`/.../`checkConditionText`/`checkMessageRaw`/
    # `checkStatementValid`) — all WITHOUT restating a fourth copy of any of
    # them. Confirmed live below (this file compiles alongside the rest of
    # the chain — see the closing verification note).
    #
    # ============================================================
    # ActionStmt — ONE struct, a `kind: text` discriminant plus every field
    # any kind needs, exactly stmt.fct's own `Stmt` convention (a struct
    # literal must set every field, so an irrelevant one is left at its own
    # honest "absent" sentinel: `""` for an absent name, `[]` for an absent
    # list, `emptyNode()` for an absent expression, `false` for an absent
    # flag — never a magic number, never an arena index).
    #
    #   kind: one of "check" | "requires" | "add" | "letAdd" | "set" |
    #         "setWhere" | "remove" | "removeWhere" | "clear" | "call" |
    #         "letCall" | "do" | "letDo" | "let" | "establish" | "assign" |
    #         "exprStmt" | "for" | "if" | "unsupported".
    #   lineIdx: this statement's own source line index (its caller's
    #         `texts`/`parents` arrays) — always present.
    #   valid: this statement's own accept/reject verdict — parseAction's
    #         own `error` return has no analogue in a language with no
    #         exception channel, so (matching every earlier self-host file's
    #         convention) a malformed line degrades to kind "unsupported"
    #         with valid=false rather than crashing or silently miscoding.
    #
    # Real parseAction routes a `requires` clause into a SEPARATE
    # `ast.Action.Requires` list, never `ast.Action.Body` — this struct
    # still models "requires" as one more ActionStmt kind (matching this
    # task's own brief) so `parseActionBodySrc` returns EVERY body-shaped
    # source line as one flat, source-ordered `[ActionStmt]` without losing
    # information; program.fct's own `ActionDecl` (see that file) then
    # SPLITS this flat list into `requires`/`body` via `actionRequiresOnly`/
    # `actionBodyOnly` below, mirroring ast.Action's real two-list shape
    # exactly once composed.
    #
    #   cond: ExprNode      — check's condition / setWhere's & removeWhere's
    #                          `where` predicate.
    #   msg: text           — check's message, RAW (still quoted/escaped,
    #                          undecoded) — the same choice parser_proc.fct's
    #                          own `checkMessageRaw` already makes and for
    #                          the identical reason (no string-unescape
    #                          builtin exists in this language).
    #   policyName: text    — requires' policy name.
    #   policyArgs: [ExprNode] — requires' policy-call argument list ([] for
    #                          a bare policy name).
    #   entity: text        — add/set/setWhere/remove/removeWhere/clear's
    #                          entity name.
    #   key: ExprNode       — set(by-id)/remove(by-id)'s key expression.
    #   field: text         — set(by-id)'s single field name.
    #   value: ExprNode     — set(by-id)'s RHS / assign's RHS.
    #   itemVar: text       — setWhere/removeWhere's item variable.
    #   fieldNames: [text]  — add's / setWhere's field-init names, index-
    #                          parallel to fieldValues.
    #   fieldValues: [ExprNode] — add's / setWhere's field-init expressions.
    #   serviceName: text   — call/letCall's service name.
    #   opName: text        — call/letCall's operation name.
    #   callArgs: [ExprNode] — call/letCall/do/letDo's argument list.
    #   procName: text      — do/letDo's proc name.
    #   bindName: text      — letCall/letDo's bound local name ("" for the
    #                          fire-and-forget call/do forms).
    #   actor: ExprNode     — establish's actor expression.
    #   hasRole: bool       — establish's optional `role` clause presence.
    #   role: ExprNode      — establish's optional role expression
    #                          (emptyNode() when hasRole is false).
    #   target: text        — plain assign's target name / let's local name.
    #   exprCall: ExprNode  — exprStmt's bare builtin call, as one real
    #                          "call"-kind ExprNode (its own args already
    #                          nested inside via expr.fct's callNode).
    #   orderField: text    — for's `by field` ("" = insertion order).
    #   orderDesc: bool     — for's `desc` (false for `asc`/absent).
    #   limit: ExprNode     — for's `limit n` expression (emptyNode() when
    #                          hasLimit is false).
    #   hasLimit: bool      — for's `limit` clause presence.
    #   body: [ActionStmt]  — for's body / if's `then` branch: the SAME
    #                          recursive statement list this struct is one
    #                          element of (stmt.fct's own `Stmt.body` shape).
    #   elseBody: [ActionStmt] — if's `else` branch ([] = no else).
    #
    # Since the real parser grew control flow in an action body (parser.go's
    # parseActionBody — `for <range>:`, `if <cond>:`/`else:`, `let name =
    # expr`, `let id = add …`), this port carries the same: "for"/"if" nest
    # through body/elseBody, "let" is a plain expression bind (target +
    # value), and "letAdd" is an add whose new row's id lands in bindName.
    # ============================================================
    struct ActionStmt:
        kind: text
        lineIdx: int
        cond: ExprNode
        msg: text
        policyName: text
        policyArgs: [ExprNode]
        entity: text
        key: ExprNode
        field: text
        value: ExprNode
        itemVar: text
        fieldNames: [text]
        fieldValues: [ExprNode]
        serviceName: text
        opName: text
        callArgs: [ExprNode]
        procName: text
        bindName: text
        actor: ExprNode
        hasRole: bool
        role: ExprNode
        target: text
        exprCall: ExprNode
        orderField: text
        orderDesc: bool
        limit: ExprNode
        hasLimit: bool
        body: [ActionStmt]
        elseBody: [ActionStmt]
        valid: bool
        # status: a check's failure status or a return's own 2xx (0 =
        # none); hasValue: a `return` that carries `value`; event: an
        # emit's named stream event (payload in `value`); hasTo: an emit's
        # `to <expr>` recipient, held in `key`.
        status: int
        hasValue: bool
        event: text
        hasTo: bool

    # actUnsupported: the one honest-degrade constructor every malformed
    # line below falls back to — every field at its neutral sentinel,
    # valid=false, matching stmt.fct's own "unsupported" Stmt kind.
    proc actUnsupported(lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        return ActionStmt{kind: "unsupported", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: false, status: 0, hasValue: false, event: "", hasTo: false}

    # ============================================================
    # STAGE 1: this file's own local raw-text scanning helpers — the ones
    # parser_proc.fct's own STAGE 1 doesn't already provide, because an
    # action's grammar needs bracket/quote-DEPTH-aware scans (parser.go's
    # own `indexOutside`/`indexAssign`/`splitTop`) that no proc/action
    # header ever needed. Each is a faithful, quirk-preserving restatement
    # of its real Go counterpart (read fresh from parser.go — see this
    # file's own research step), not a "cleaned up" reimplementation.
    # ============================================================

    # actEndOfQuoted: parser.go's own `endOfQuoted`, MINUS its `{...}`
    # string-interpolation special case (`endOfInterp`) — a deliberate,
    # small, honestly-flagged simplification: no real action statement in
    # examples/*.fct or apps/*/*.fct nests a quoted string (let alone one
    # with `{expr}` interpolation containing its own `"`) inside the
    # `where`/`in`/`role` search zones this helper serves, so implementing
    # endOfInterp's own nested-brace-in-string tracking would be
    # disproportionate to any real, exercised case. Backslash-escapes a
    # single following character exactly like real Go.
    private proc actEndOfQuoted(s: text, i: int) -> int:
        let n = len(s)
        let mut j = i + 1
        let mut found = -1
        loop j < n && found == -1:
            let c = charAt(s, j)
            if c == "\\":
                j = j + 1
            else:
                if c == "\"":
                    found = j
            j = j + 1
        return found

    # actIndexOutside: parser.go's own `indexOutside` — the first occurrence
    # of `sep` outside every quoted string AND every bracket depth (every
    # bracket KIND folded into one shared counter, exactly like real Go).
    proc actIndexOutside(s: text, sep: text) -> int:
        let n = len(s)
        let m = len(sep)
        let mut depth = 0
        let mut i = 0
        let mut found = -1
        loop i < n && found == -1:
            let c = charAt(s, i)
            if c == "\"":
                let e = do actEndOfQuoted(s, i)
                if e < 0:
                    return -1
                i = e
            else:
                if c == "(" || c == "[" || c == "{":
                    depth = depth + 1
                else:
                    if c == ")" || c == "]" || c == "}":
                        depth = depth - 1
                    else:
                        if depth == 0:
                            if i + m <= n:
                                if slice(s, i, i + m) == sep:
                                    found = i
            i = i + 1
        return found

    # actIndexAssign: parser.go's own `indexAssign` — the FIRST top-level
    # (depth 0, outside quotes) `=` that is not part of `==`/`!=`/`<=`/`>=`.
    # Used wherever real Go's own parseSet/parseSetWhere use `indexAssign`
    # (the by-id `set` line and each field inside a filtered `set`'s body) —
    # NOT the same as `firstEqIndex` (stmt.fct's naive first-`=` scan),
    # which real parseAction's own plain-assignment DEFAULT case and its
    # `let name = ...` case both use instead (see STAGE 3 below: this file
    # deliberately calls the right one of the two per statement kind,
    # matching real Go's own genuine, if inconsistent, per-kind choice).
    proc actIndexAssign(s: text) -> int:
        let n = len(s)
        let mut depth = 0
        let mut i = 0
        let mut found = -1
        loop i < n && found == -1:
            let c = charAt(s, i)
            if c == "\"":
                let e = do actEndOfQuoted(s, i)
                if e < 0:
                    return -1
                i = e
            else:
                if c == "(" || c == "[" || c == "{":
                    depth = depth + 1
                else:
                    if c == ")" || c == "]" || c == "}":
                        depth = depth - 1
                    else:
                        if c == "=" && depth == 0:
                            let mut isDoubleEq = false
                            if i + 1 < n:
                                if charAt(s, i + 1) == "=":
                                    isDoubleEq = true
                            let mut isTailOfOp = false
                            if i > 0:
                                let prev = charAt(s, i - 1)
                                if prev == "!" || prev == "<" || prev == ">":
                                    isTailOfOp = true
                            if isDoubleEq:
                                i = i + 1
                            else:
                                if !isTailOfOp:
                                    found = i
            i = i + 1
        return found

    # actSplitTopComma: parser.go's own `splitTop(s, ',')` — comma-splitting
    # at the top level, skipping the inside of `(...)`/`{...}`/`[...]` and
    # `"..."` — ported with its own real, naive quote handling preserved
    # verbatim (a bare `"` just TOGGLES a flag; no escape awareness inside
    # this particular scan, exactly matching real Go's own `splitTop`,
    # which is genuinely this naive — a different, smaller quirk than
    # `actEndOfQuoted`'s own escape handling, and not a bug in this port).
    proc actSplitTopComma(s: text) -> [text]:
        let n = len(s)
        let mut depth = 0
        let mut inStr = false
        let mut start = 0
        let mut out = []
        let mut i = 0
        loop i < n:
            let c = charAt(s, i)
            if c == "\"":
                inStr = !inStr
            else:
                if !inStr:
                    if c == "(" || c == "{" || c == "[":
                        depth = depth + 1
                    else:
                        if c == ")" || c == "}" || c == "]":
                            depth = depth - 1
                        else:
                            if c == "," && depth == 0:
                                out = append(out, trim(slice(s, start, i)))
                                start = i + 1
            i = i + 1
        out = append(out, trim(slice(s, start, n)))
        return out

    # actFieldsSplit: Go's own `strings.Fields` — split on any run of
    # whitespace (space/tab, this port's own closed alphabet via
    # expr_tokens.fct's `isSpaceChar`, reused transitively rather than
    # restated), used for `set`/`remove`'s filtered-form header
    # (`item in Entity`), matching real parseSet/parseRemove's own
    # `strings.Fields(head)` exactly.
    proc actFieldsSplit(s: text) -> [text]:
        let n = len(s)
        let mut out = []
        let mut i = 0
        let mut curStart = -1
        loop i < n:
            let c = charAt(s, i)
            let sp = do isSpaceChar(c)
            if sp:
                if curStart >= 0:
                    out = append(out, slice(s, curStart, i))
                    curStart = -1
            else:
                if curStart < 0:
                    curStart = i
            i = i + 1
        if curStart >= 0:
            out = append(out, slice(s, curStart, n))
        return out

    # actBraceDepth: parser.go's own `braceDepth` — folds `(`/`{`/`[` and
    # `)`/`}`/`]` into a running depth (starting from `start`), skipping the
    # inside of `"..."` literals (a bare, un-escaped toggle, exactly like
    # `actSplitTopComma`'s own quote handling — real `braceDepth` is this
    # naive too).
    private proc actBraceDepth(s: text, start: int) -> int:
        let n = len(s)
        let mut depth = start
        let mut inStr = false
        let mut i = 0
        loop i < n:
            let c = charAt(s, i)
            if c == "\"":
                inStr = !inStr
            else:
                if !inStr:
                    if c == "(" || c == "{" || c == "[":
                        depth = depth + 1
                    else:
                        if c == ")" || c == "}" || c == "]":
                            depth = depth - 1
            i = i + 1
        return depth

    # actFirstParenTokenIndex / actCallArgsNodesFor: `call Service.op(args)`/
    # `do ProcName(args)`'s own argument list. Unlike stmt.fct's
    # `doArgsNodes` (which assumes the callee name is exactly ONE token, so
    # the arg list always starts at token index 2), a service call's own
    # `Service.op` is THREE tokens (ident, `.`, ident) before its `(` — so
    # this file finds the `(` token itself, generically, rather than
    # assuming a fixed offset. This one helper correctly covers both a
    # dotted service-op name and a plain single-ident proc name, so this
    # file uses it uniformly for call/letCall/do/letDo instead of also
    # depending on stmt.fct's fixed-offset version.
    private proc actFirstParenTokenIndex(texts: [text]) -> int:
        let n = len(texts)
        let mut i = 0
        let mut found = -1
        loop i < n && found == -1:
            if texts[i] == "(":
                found = i
            i = i + 1
        return found

    proc actCallArgsNodesFor(s: text) -> [ExprNode]:
        let kinds = do tokenKinds(s)
        let texts = do tokenTexts(s)
        let p = do actFirstParenTokenIndex(texts)
        if p < 0:
            return []
        let args = do argListNodes(kinds, texts, p + 1)
        return args

    # ============================================================
    # STAGE 2: this file's own private local indentation tree — the same
    # `bodyIndents`/`bodyTexts`/`bodyParents` restatement stmt.fct's own
    # STAGE 2 already established (now genuinely PRIVATE, so it cannot
    # collide with stmt.fct's own same-named private copies even though
    # both are pulled transitively into this file's own import chain — see
    # this file's header for why that collision is no longer possible).
    # ============================================================
    private proc actBodyIsBlankOrComment(line: text) -> bool:
        let t = trim(line)
        if len(t) == 0:
            return true
        return slice(t, 0, 1) == "#"

    private proc actBodyIndentOf(line: text) -> int:
        let n = len(line)
        let mut count = 0
        loop count < n && charAt(line, count) == " ":
            count = count + 1
        return count

    private proc actBodyIndents(src: text) -> [int]:
        let rawLines = split(src, "\n")
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let raw = rawLines[i]
            let skip = do actBodyIsBlankOrComment(raw)
            if !skip:
                let ind = do actBodyIndentOf(raw)
                out = append(out, ind)
            i = i + 1
        return out

    private proc actBodyTexts(src: text) -> [text]:
        let rawLines = split(src, "\n")
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let raw = rawLines[i]
            let skip = do actBodyIsBlankOrComment(raw)
            if !skip:
                out = append(out, trim(raw))
            i = i + 1
        return out

    private proc actBodyParents(indents: [int]) -> [int]:
        let n = len(indents)
        let mut stackIndent = []
        let mut stackNode = []
        let mut fillI = 0
        loop fillI < n:
            stackIndent = append(stackIndent, -1)
            stackNode = append(stackNode, -1)
            fillI = fillI + 1
        let mut top = -1
        let mut parents = []
        let mut k = 0
        loop k < n:
            let cur = indents[k]
            loop top >= 0:
                if stackIndent[top] >= cur:
                    top = top - 1
                else:
                    break
            let mut parent = -1
            if top >= 0:
                parent = stackNode[top]
            parents = append(parents, parent)
            top = top + 1
            stackIndent[top] = cur
            stackNode[top] = k
            k = k + 1
        return parents

    # actDescendantLines: parser.go's own `flattenLines` — every descendant
    # of `node`, depth-first, in source order (used only by `add`'s own
    # multi-line record-literal continuation, below).
    private proc actDescendantLines(node: int, parents: [int], texts: [text]) -> [text]:
        let kids = do stmtChildrenOf(node, parents)
        let m = len(kids)
        let mut out = []
        let mut i = 0
        loop i < m:
            let k = kids[i]
            out = append(out, texts[k])
            let sub = do actDescendantLines(k, parents, texts)
            let sn = len(sub)
            let mut j = 0
            loop j < sn:
                out = append(out, sub[j])
                j = j + 1
            i = i + 1
        return out

    # actCloseAddRecord: parser.go's own `closeAddRecord` — if `rest`'s own
    # brace/paren/bracket depth doesn't already return to zero (a record
    # literal that continues past its `add Entity {` header line), walk
    # `node`'s descendants depth-first, space-joining each onto `rest` until
    # the running depth returns to zero (FDL's offside rule already nests
    # a multi-line record's remaining fields as children of the `add`
    # line). A record that never balances degrades to returning `rest`
    # unchanged (this file's own `unsupported` fallback then naturally
    # fires downstream, since the unbalanced text has no matching `}`) —
    # the honest-degrade counterpart to real Go's hard parse error here.
    private proc actCloseAddRecord(rest: text, node: int, parents: [int], texts: [text]) -> text:
        let depth0 = do actBraceDepth(rest, 0)
        if depth0 <= 0:
            return rest
        let descendants = do actDescendantLines(node, parents, texts)
        let m = len(descendants)
        let mut result = rest
        let mut depth = depth0
        let mut i = 0
        let mut done = false
        loop i < m && !done:
            result = result + " " + descendants[i]
            let nextDepth = do actBraceDepth(descendants[i], depth)
            depth = nextDepth
            if depth <= 0:
                done = true
            i = i + 1
        return result

    # ============================================================
    # STAGE 3: singleActionStmt — one real action-body LINE (or, for `add`
    # and `set ... where ...:`, one line PLUS its own children — an add's
    # multi-line record continuation, or a filtered set's own `field =
    # expr` block) in, ONE (or for `requires`, one-per-comma-separated-
    # policy — see actRequiresStmts below) real `ActionStmt` out.
    #
    # Prefix-dispatch order is real parseActionBody's own switch order
    # exactly (check, add, set, remove, clear, call, do, for, if, else, let,
    # establish, isBareCallStmt, default) — confirmed by reading it fresh,
    # not assumed. `if` needs to see its SIBLING (`else:` is the next line
    # of the same block, not a child), so like `requires` it is dispatched
    # from the block loop (actionBlockStmts) rather than here; `for` owns
    # only its own children and is handled below. An action still has no
    # `loop`/`return`/`break`/`continue` — those remain proc-only.
    # ============================================================
    proc singleActionStmt(texts: [text], parents: [int], lineIdx: int) -> ActionStmt:
        let t = trim(texts[lineIdx])
        let noExpr = do emptyNode()

        let isCheck = do hasPrefixText(t, "check ")
        if isCheck:
            let rest0 = do trimPrefixText(t, "check ")
            # Trailing clauses, either order: `status N` (the failure status
            # a declared api route answers with, 400-599) and
            # `code "snake_case"` (the machine-readable failure code).
            let mut rest = trim(rest0)
            let mut status = 0
            let mut code = ""
            let mut pass = 0
            loop pass < 2:
                if status == 0:
                    let cst = do actTrailingStatus(rest)
                    if cst.status != 0:
                        if cst.status < 400 || cst.status > 599:
                            let us = do actUnsupported(lineIdx)
                            return us
                        status = cst.status
                        rest = cst.rest
                if code == "":
                    let cc = do actTrailingCode(rest)
                    if cc.code != "":
                        code = cc.code
                        rest = cc.rest
                pass = pass + 1
            let ok = do checkStatementValid(rest)
            if !ok:
                let u = do actUnsupported(lineIdx)
                return u
            let condSrc = do checkConditionText(rest)
            let condNode = do parseExprTree(condSrc)
            let msgRaw = do checkMessageRaw(rest)
            return ActionStmt{kind: "check", lineIdx: lineIdx, cond: condNode, msg: msgRaw, policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: code, exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: status, hasValue: false, event: "", hasTo: false}

        # `requires` needs to hand back POSSIBLY MULTIPLE ActionStmt entries
        # from one line (`requires owns(id), admin`) — that shape doesn't
        # fit this proc's one-Stmt-in one-Stmt-out contract, so it is
        # dispatched from the block loop directly (actionBlockStmts, STAGE
        # 4 below) via `actRequiresStmts`, never reached here. A `requires `
        # line therefore never reaches this proc's own prefix chain.

        let isAdd = do hasPrefixText(t, "add ")
        if isAdd:
            let s = do actAddStmt(texts, parents, lineIdx)
            return s

        let isSet = do hasPrefixText(t, "set ")
        if isSet:
            let s = do actSetStmt(texts, parents, lineIdx)
            return s

        let isRemove = do hasPrefixText(t, "remove ")
        if isRemove:
            let s = do actRemoveStmt(t, lineIdx)
            return s

        let isClear = do hasPrefixText(t, "clear ")
        if isClear:
            let entRaw = do trimPrefixText(t, "clear ")
            let ent = trim(entRaw)
            let ok = do isIdentToken(ent)
            if !ok:
                let u = do actUnsupported(lineIdx)
                return u
            return ActionStmt{kind: "clear", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: ent, key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

        let isCall = do hasPrefixText(t, "call ")
        if isCall:
            let rest = do trimPrefixText(t, "call ")
            let s = do actCallStmt(trim(rest), lineIdx, "")
            return s

        let isDo = do hasPrefixText(t, "do ")
        if isDo:
            let rest = do trimPrefixText(t, "do ")
            let s = do actDoStmt(trim(rest), lineIdx, "")
            return s

        let isFor = do hasPrefixText(t, "for ")
        if isFor:
            let s = do actForStmt(texts, parents, lineIdx)
            return s

        # A bare `else` reaching here had no `if` sibling to attach to
        # (actionBlockStmts consumes the one that does) — real parseActionBody
        # refuses it ("`else` with no matching `if`").
        if t == "else:" || t == "else":
            let u = do actUnsupported(lineIdx)
            return u

        let isLet = do hasPrefixText(t, "let ")
        if isLet:
            let restRaw = do trimPrefixText(t, "let ")
            let rest = trim(restRaw)
            # `let mut` is proc-only: an action local is bound once.
            let isMut = do hasPrefixText(rest, "mut ")
            if isMut:
                let u = do actUnsupported(lineIdx)
                return u
            let eq = do firstEqIndex(rest)
            if eq < 0:
                let u = do actUnsupported(lineIdx)
                return u
            let bindName = trim(slice(rest, 0, eq))
            let bindOk = do isIdentToken(bindName)
            if !bindOk:
                let u = do actUnsupported(lineIdx)
                return u
            let rhs = trim(slice(rest, eq + 1, len(rest)))
            let rhsIsCall = do hasPrefixText(rhs, "call ")
            if rhsIsCall:
                let callRestRaw = do trimPrefixText(rhs, "call ")
                let callRest = trim(callRestRaw)
                let s = do actCallStmt(callRest, lineIdx, bindName)
                return s
            let rhsIsDo = do hasPrefixText(rhs, "do ")
            if rhsIsDo:
                let doRestRaw = do trimPrefixText(rhs, "do ")
                let doRest = trim(doRestRaw)
                let s = do actDoStmt(doRest, lineIdx, bindName)
                return s
            # `let id = add Entity { … }`: the add's record text after `add `
            # goes through the exact same record parsing a bare `add` does,
            # with the new row's id bound to `bindName`.
            let rhsIsAdd = do hasPrefixText(rhs, "add ")
            if rhsIsAdd:
                let addRestRaw = do trimPrefixText(rhs, "add ")
                let s = do actAddText(trim(addRestRaw), texts, parents, lineIdx, bindName)
                return s
            # Any other right-hand side is a plain expression bind.
            let val = do parseExprTree(rhs)
            return ActionStmt{kind: "let", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: val, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: bindName, exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

        # `return [expr] [status N]` — the action's reply (parser.go's
        # return case); a bare `return` ends a no-return action early.
        let isReturn = do hasPrefixText(t, "return ")
        if t == "return" || isReturn:
            let r0 = do trimPrefixText(t, "return")
            let rst = do actTrailingStatus(trim(r0))
            if rst.status != 0 && (rst.status < 200 || rst.status > 299 || rst.status == 204):
                let ur = do actUnsupported(lineIdx)
                return ur
            let mut rv = noExpr
            let hasV = rst.rest != ""
            if hasV:
                let ok2 = do parseExprConsumedAll(rst.rest)
                if !ok2:
                    let ur2 = do actUnsupported(lineIdx)
                    return ur2
                let v = do parseExprTree(rst.rest)
                rv = v
            return ActionStmt{kind: "return", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: rv, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: rst.status, hasValue: hasV, event: "", hasTo: false}

        # `emit [event] Dto{…} [to <expr>]` — a typed stream event.
        let isEmit = do hasPrefixText(t, "emit ")
        if isEmit:
            let e0 = do trimPrefixText(t, "emit ")
            let mut rest = trim(e0)
            let mut toNode = noExpr
            let mut hasTo = false
            let ti = do actIndexOutside(rest, " to ")
            if ti >= 0:
                let toSrc = trim(slice(rest, ti + 4, len(rest)))
                let tok = do parseExprConsumedAll(toSrc)
                if !tok:
                    let ue = do actUnsupported(lineIdx)
                    return ue
                let tn = do parseExprTree(toSrc)
                toNode = tn
                hasTo = true
                rest = trim(slice(rest, 0, ti))
            # `emit … on a, b`: the parameterized stream instance.
            let mut onArgs = []
            let oi = do actIndexOutside(rest, " on ")
            if oi >= 0:
                let parts = do actSplitTopComma(trim(slice(rest, oi + 4, len(rest))))
                let npo = len(parts)
                let mut po = 0
                loop po < npo:
                    let psrc = trim(parts[po])
                    let pok = do parseExprConsumedAll(psrc)
                    if !pok:
                        let ue3 = do actUnsupported(lineIdx)
                        return ue3
                    let pn = do parseExprTree(psrc)
                    onArgs = append(onArgs, pn)
                    po = po + 1
                rest = trim(slice(rest, 0, oi))
            let mut event = ""
            let sp = do indexOf(rest, " ")
            if sp > 0:
                let w = slice(rest, 0, sp)
                let wi = do isIdentToken(w)
                let c0 = charAt(w, 0)
                let upper = c0 >= "A" && c0 <= "Z"
                if wi && !upper:
                    event = w
                    rest = trim(slice(rest, sp, len(rest)))
            let vok = do parseExprConsumedAll(rest)
            if !vok:
                let ue2 = do actUnsupported(lineIdx)
                return ue2
            let ev = do parseExprTree(rest)
            return ActionStmt{kind: "emit", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: toNode, field: "", value: ev, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: onArgs, procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: true, event: event, hasTo: hasTo}

        # `revoke <expr>` — end the live session whose key is expr.
        let isRevoke = do hasPrefixText(t, "revoke ")
        if isRevoke:
            let rk0 = do trimPrefixText(t, "revoke ")
            let rsrc = trim(rk0)
            let rok = do parseExprConsumedAll(rsrc)
            if !rok:
                let uv = do actUnsupported(lineIdx)
                return uv
            let rkn = do parseExprTree(rsrc)
            return ActionStmt{kind: "revoke", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: rkn, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: true, event: "", hasTo: false}

        # `header "Name" <expr>` — a response header on the action's reply.
        let isHeader = do hasPrefixText(t, "header \"")
        if isHeader:
            let hcs = split(t, "")
            let hn = len(hcs)
            let mut q2 = 8
            loop q2 < hn && hcs[q2] != "\"":
                q2 = q2 + 1
            let hname = slice(t, 8, q2)
            let hrest = trim(slice(t, q2 + 1, hn))
            let spaced = q2 + 1 < hn && (hcs[q2 + 1] == " " || hcs[q2 + 1] == "\t")
            if q2 >= hn || !spaced || hrest == "":
                let uh = do actUnsupported(lineIdx)
                return uh
            let hok = do parseExprConsumedAll(hrest)
            if !hok:
                let uh2 = do actUnsupported(lineIdx)
                return uh2
            let hv = do parseExprTree(hrest)
            return ActionStmt{kind: "header", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: hname, value: hv, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: true, event: "", hasTo: false}

        # `restate actor <expr> role <expr>` — re-role an account's live
        # sessions.
        let isRestate = do hasPrefixText(t, "restate ")
        if isRestate:
            let rs0 = do trimPrefixText(t, "restate ")
            let rest = trim(rs0)
            let ri = do actIndexOutside(rest, " role ")
            let hasActor = do hasPrefixText(rest, "actor ")
            if !hasActor || ri < 0:
                let ur = do actUnsupported(lineIdx)
                return ur
            let whoSrc = trim(slice(rest, 6, ri))
            let roleSrc = trim(slice(rest, ri + 6, len(rest)))
            let wok = do parseExprConsumedAll(whoSrc)
            let rok2 = do parseExprConsumedAll(roleSrc)
            if !wok || !rok2:
                let ur2 = do actUnsupported(lineIdx)
                return ur2
            let whoN = do parseExprTree(whoSrc)
            let roleN = do parseExprTree(roleSrc)
            return ActionStmt{kind: "restate", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: whoN, hasRole: true, role: roleN, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

        let isEstablish = do hasPrefixText(t, "establish ")
        if isEstablish:
            let s = do actEstablishStmt(t, lineIdx)
            return s

        let isBareCall = do stmtIsBareCallStmt(t)
        if isBareCall:
            let callNode = do parseExprTree(t)
            let ok = callNode.kind == "call"
            return ActionStmt{kind: "exprStmt", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: callNode, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: ok, status: 0, hasValue: false, event: "", hasTo: false}

        # Default: `target = expr` — real parseAction's own DEFAULT case
        # uses the NAIVE first-`=` scan (`strings.IndexByte`), not the
        # smart `indexAssign` `set`/`setWhere` use — matched exactly here
        # via `firstEqIndex` (stmt.fct's own naive scan), not
        # `actIndexAssign`.
        let eq2 = do firstEqIndex(t)
        if eq2 < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let target = trim(slice(t, 0, eq2))
        let targetOk = do isIdentToken(target)
        if !targetOk:
            let u = do actUnsupported(lineIdx)
            return u
        let val = do parseExprTree(trim(slice(t, eq2 + 1, len(t))))
        return ActionStmt{kind: "assign", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: val, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: target, exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

    # actCallStmt: `Service.op(args)` (the shared shape of both bare `call
    # Service.op(args)` and bound `let name = call Service.op(args)`).
    # `bindName` is "" for the fire-and-forget form.
    # actTrailingStatus: checkStatusRe (`\s+status\s+(\d{3})$`) — the
    # trailing status clause, when anything precedes it.
    struct ActStatus:
        rest: text
        status: int

    proc actTrailingStatus(s: text) -> ActStatus:
        let n = len(s)
        if n < 11:
            return ActStatus{rest: s, status: 0}
        let digits = slice(s, n - 3, n)
        let mut allDigits = true
        let mut i = 0
        loop i < 3:
            let c = charAt(digits, i)
            if c < "0" || c > "9":
                allDigits = false
            i = i + 1
        if !allDigits:
            return ActStatus{rest: s, status: 0}
        let mut j = n - 4
        let mut ws = 0
        loop j >= 0 && (charAt(s, j) == " " || charAt(s, j) == "\t"):
            ws = ws + 1
            j = j - 1
        if ws == 0 || j < 5:
            return ActStatus{rest: s, status: 0}
        if slice(s, j - 5, j + 1) != "status":
            return ActStatus{rest: s, status: 0}
        let k = j - 6
        if k < 0 || (charAt(s, k) != " " && charAt(s, k) != "\t"):
            return ActStatus{rest: s, status: 0}
        let before = trim(slice(s, 0, k + 1))
        if before == "":
            return ActStatus{rest: s, status: 0}
        return ActStatus{rest: before, status: toInt(digits)}

    # actTrailingCode: parseCheck's checkCodeRe — a trailing
    # `code "snake_case"` (a lowercase letter, then lowercase letters,
    # digits and underscores) after whitespace.
    struct ActCode:
        rest: text
        code: text

    proc actTrailingCode(s: text) -> ActCode:
        let none = ActCode{rest: s, code: ""}
        let n = len(s)
        if n < 8 || charAt(s, n - 1) != "\"":
            return none
        let mut q = n - 2
        loop q >= 0 && charAt(s, q) != "\"":
            q = q - 1
        if q < 0:
            return none
        let code = slice(s, q + 1, n - 1)
        if code == "":
            return none
        let cs = split(code, "")
        if cs[0] < "a" || cs[0] > "z":
            return none
        let nc = len(cs)
        let mut i = 1
        loop i < nc:
            let c = cs[i]
            let ok = (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "_"
            if !ok:
                return none
            i = i + 1
        let mut j = q - 1
        let mut ws = 0
        loop j >= 0 && (charAt(s, j) == " " || charAt(s, j) == "\t"):
            ws = ws + 1
            j = j - 1
        if ws == 0 || j < 3 || slice(s, j - 3, j + 1) != "code":
            return none
        let k = j - 4
        if k < 0 || (charAt(s, k) != " " && charAt(s, k) != "\t"):
            return none
        return ActCode{rest: trim(slice(s, 0, k + 1)), code: code}

    proc actQuoteLit(v: text) -> text:
        let cs = split(v, "")
        let n = len(cs)
        let mut out = "\""
        let mut i = 0
        loop i < n:
            let c = cs[i]
            if c == "\"" || c == "\\":
                out = out + "\\" + c
            else:
                if c == "\n":
                    out = out + "\\n"
                else:
                    out = out + c
            i = i + 1
        return out + "\""

    # actMatchStmt: parseActionBody's `match` — desugared on the spot into
    # an `if <expr> == "value": … else: …` chain ending in the required
    # else body.
    proc actMatchStmt(texts: [text], parents: [int], lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let t = trim(texts[lineIdx])
        let m0 = do trimPrefixText(t, "match ")
        let m1 = do trimSuffixText(trim(m0), ":")
        let exprS = trim(m1)
        let endsColon = do hasSuffixText(t, ":")
        let eok = do parseExprConsumedAll(exprS)
        if exprS == "" || !endsColon || !eok:
            let u = do actUnsupported(lineIdx)
            return u
        let subject = do parseExprTree(exprS)
        let kids = do stmtChildrenOf(lineIdx, parents)
        let mut vals = []
        let mut bodies = []
        let mut elseBody = []
        let mut haveElse = false
        let n = len(kids)
        let mut i = 0
        loop i < n:
            let ct = trim(texts[kids[i]])
            let isCase = do hasPrefixText(ct, "case ")
            if isCase:
                let v0 = do trimPrefixText(ct, "case ")
                let v1 = do trimSuffixText(trim(v0), ":")
                let vs = trim(v1)
                let mut val = ""
                let q = do hasPrefixText(vs, "\"")
                if q:
                    let inner = do lowerUnquoteAct(vs)
                    val = inner
                else:
                    let isNum = do actIsIntText(vs)
                    if !isNum:
                        let u2 = do actUnsupported(lineIdx)
                        return u2
                    val = "" + toInt(vs)
                if val in vals:
                    let u3 = do actUnsupported(lineIdx)
                    return u3
                let body = do actionBlockStmts(texts, parents, kids[i])
                if len(body) == 0:
                    let u4 = do actUnsupported(lineIdx)
                    return u4
                vals = append(vals, val)
                bodies = append(bodies, ActionStmt{kind: "block", lineIdx: kids[i], cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: body, elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false})
            else:
                if ct == "else:" || ct == "else":
                    let eb = do actionBlockStmts(texts, parents, kids[i])
                    if len(eb) == 0:
                        let u5 = do actUnsupported(lineIdx)
                        return u5
                    elseBody = eb
                    haveElse = true
                else:
                    let u6 = do actUnsupported(lineIdx)
                    return u6
            i = i + 1
        if len(vals) == 0 || !haveElse:
            let u7 = do actUnsupported(lineIdx)
            return u7
        let mut chain = elseBody
        let mut k = len(vals) - 1
        loop k >= 0:
            let lit = do actQuoteLit(vals[k])
            let litNode = do textLitNode(lit)
            let eq = do binNode("==", subject, litNode)
            let ifs = ActionStmt{kind: "if", lineIdx: lineIdx, cond: eq, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: bodies[k].body, elseBody: chain, valid: true, status: 0, hasValue: false, event: "", hasTo: false}
            chain = [ifs]
            k = k - 1
        return chain[0]

    proc actIsIntText(s: text) -> bool:
        let mut body = s
        if charAt(s, 0) == "-" || charAt(s, 0) == "+":
            body = slice(s, 1, len(s))
        if body == "":
            return false
        let cs = split(body, "")
        let n = len(cs)
        let mut i = 0
        loop i < n:
            if cs[i] < "0" || cs[i] > "9":
                return false
            i = i + 1
        return true

    # lowerUnquoteAct: strconv.Unquote of a `"…"` literal (escapes decoded).
    proc lowerUnquoteAct(raw: text) -> text:
        let n = len(raw)
        let mut out = ""
        let mut i = 1
        loop i < n - 1:
            let c = charAt(raw, i)
            if c == "\\" && i + 1 < n - 1:
                let e = charAt(raw, i + 1)
                if e == "n":
                    out = out + "\n"
                else:
                    if e == "t":
                        out = out + "\t"
                    else:
                        out = out + e
                i = i + 2
            else:
                out = out + c
                i = i + 1
        return out

    proc actCallStmt(rest: text, lineIdx: int, bindName: text) -> ActionStmt:
        let noExpr = do emptyNode()
        let open = do firstParenIndex(rest)
        if open < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let target = trim(slice(rest, 0, open))
        let dot = do indexOf(target, ".")
        if dot < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let svc = trim(slice(target, 0, dot))
        let op = trim(slice(target, dot + 1, len(target)))
        let svcOk = do isIdentToken(svc)
        let opOk = do isIdentToken(op)
        if !svcOk || !opOk:
            let u = do actUnsupported(lineIdx)
            return u
        let close = do lastCharIndex(rest, ")")
        if close < open:
            let u = do actUnsupported(lineIdx)
            return u
        let args = do actCallArgsNodesFor(rest)
        let mut kind = "call"
        if bindName != "":
            kind = "letCall"
        return ActionStmt{kind: kind, lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: svc, opName: op, callArgs: args, procName: "", bindName: bindName, actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

    # actDoStmt: `ProcName(args)` (the shared shape of both bare `do
    # ProcName(args)` and bound `let name = do ProcName(args)`).
    proc actDoStmt(rest: text, lineIdx: int, bindName: text) -> ActionStmt:
        let noExpr = do emptyNode()
        let open = do firstParenIndex(rest)
        if open < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let name = trim(slice(rest, 0, open))
        let nameOk = do isIdentToken(name)
        if !nameOk:
            let u = do actUnsupported(lineIdx)
            return u
        let close = do lastCharIndex(rest, ")")
        if close < open:
            let u = do actUnsupported(lineIdx)
            return u
        let args = do actCallArgsNodesFor(rest)
        let mut kind = "do"
        if bindName != "":
            kind = "letDo"
        return ActionStmt{kind: kind, lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: args, procName: name, bindName: bindName, actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

    # actEstablishStmt: `establish actor <expr> [role <expr>]`. The
    # `" role "` search is a PLAIN substring index (real Go's own
    # `strings.Index`, not the bracket/quote-depth-aware `indexOutside`) —
    # a real, confirmed quirk (an actor expression containing the literal
    # substring `" role "` inside a nested call argument would be mis-split)
    # preserved verbatim, matching this port's established convention.
    proc actEstablishStmt(t: text, lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let rest0Raw = do trimPrefixText(t, "establish ")
        let rest0 = trim(rest0Raw)
        let hasActor = do hasPrefixText(rest0, "actor ")
        if !hasActor:
            let u = do actUnsupported(lineIdx)
            return u
        let restRaw = do trimPrefixText(rest0, "actor ")
        let rest = trim(restRaw)
        let roleIdx = do indexOf(rest, " role ")
        let mut actorSrc = rest
        let mut hasRole = false
        let mut roleSrc = ""
        if roleIdx >= 0:
            roleSrc = trim(slice(rest, roleIdx + 6, len(rest)))
            actorSrc = trim(slice(rest, 0, roleIdx))
            hasRole = true
        let actorNode = do parseExprTree(actorSrc)
        let mut roleNode = noExpr
        if hasRole:
            let r = do parseExprTree(roleSrc)
            roleNode = r
        return ActionStmt{kind: "establish", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: actorNode, hasRole: hasRole, role: roleNode, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

    # actAddStmt: `add Entity { f: expr, ... }`, including the multi-line
    # record-literal continuation (actCloseAddRecord, above). Field names
    # are NOT validated as identifiers — a real, confirmed quirk: real
    # Go's own parseAdd never calls isIdent on a field's own name, unlike
    # almost every other name in this grammar.
    proc actAddStmt(texts: [text], parents: [int], lineIdx: int) -> ActionStmt:
        let t = trim(texts[lineIdx])
        let rest0Raw = do trimPrefixText(t, "add ")
        let s = do actAddText(trim(rest0Raw), texts, parents, lineIdx, "")
        return s

    # actAddText: real parser.go's `parseAddText` — the record text after the
    # `add ` keyword, against the line it came from (whose children hold a
    # multi-line record's continuation). Shared by the bare `add` statement
    # and the bound `let id = add …` form; `bindName` is "" for the former.
    proc actAddText(rest0: text, texts: [text], parents: [int], lineIdx: int, bindName: text) -> ActionStmt:
        let noExpr = do emptyNode()
        let rest = do actCloseAddRecord(rest0, lineIdx, parents, texts)
        let open = do indexOf(rest, "{")
        let close = do lastCharIndex(rest, "}")
        if open < 0 || close < open:
            let u = do actUnsupported(lineIdx)
            return u
        let ent = trim(slice(rest, 0, open))
        let entOk = do isIdentToken(ent)
        if !entOk:
            let u = do actUnsupported(lineIdx)
            return u
        let body = trim(slice(rest, open + 1, close))
        let mut fieldNames = []
        let mut fieldValues = []
        let mut ok = true
        if body != "":
            let parts = do actSplitTopComma(body)
            let n = len(parts)
            let mut i = 0
            loop i < n && ok:
                let part = parts[i]
                let colon = do indexOf(part, ":")
                if colon < 0:
                    ok = false
                else:
                    let fn = trim(slice(part, 0, colon))
                    let ev = do parseExprTree(trim(slice(part, colon + 1, len(part))))
                    fieldNames = append(fieldNames, fn)
                    fieldValues = append(fieldValues, ev)
                i = i + 1
        if !ok:
            let u = do actUnsupported(lineIdx)
            return u
        let mut kind = "add"
        if bindName != "":
            kind = "letAdd"
        return ActionStmt{kind: kind, lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: ent, key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: fieldNames, fieldValues: fieldValues, serviceName: "", opName: "", callArgs: [], procName: "", bindName: bindName, actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

    # actSetStmt: the two real forms — `set Entity(key).field = expr`
    # (by-id) and `set item in Entity where cond:` (filtered, its own
    # `field = expr` block read from `lineIdx`'s CHILDREN). The by-id LHS
    # `Entity(key).field` is parsed via expr.fct's OWN expression grammar
    # (`parseExprTree`, expecting the resulting node's kind to be
    # "entityGet") rather than a hand-written parseEntityPath — a genuine,
    # deliberate reuse win: expr_tree.fct's `entityGetNodes` already
    # recurses through its own key expression via `orNodes`, so it composes
    # correctly even for a chained/nested key like
    # `Product(CartLine(lid).product).stock` for free, with no separate
    # matched-paren logic needed here.
    proc actSetStmt(texts: [text], parents: [int], lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let t = trim(texts[lineIdx])
        let restRaw = do trimPrefixText(t, "set ")
        let rest = trim(restRaw)
        let wi = do actIndexOutside(rest, " where ")
        let mut isWhere = false
        if wi >= 0:
            let head0 = slice(rest, 0, wi)
            let inIdx = do actIndexOutside(head0, " in ")
            if inIdx >= 0:
                isWhere = true
        if isWhere:
            let head = trim(slice(rest, 0, wi))
            let condRaw = trim(slice(rest, wi + 7, len(rest)))
            let condNoColon = do trimSuffixText(condRaw, ":")
            let condSrc = trim(condNoColon)
            let hf = do actFieldsSplit(head)
            let mut shapeOk = len(hf) == 3
            if shapeOk:
                if hf[1] != "in":
                    shapeOk = false
            if shapeOk:
                let v0 = do isIdentToken(hf[0])
                let v2 = do isIdentToken(hf[2])
                if !v0 || !v2:
                    shapeOk = false
            let endsColon = do hasSuffixText(t, ":")
            if !shapeOk || !endsColon:
                let u = do actUnsupported(lineIdx)
                return u
            let whereNode = do parseExprTree(condSrc)
            let kids = do stmtChildrenOf(lineIdx, parents)
            let m = len(kids)
            let mut fieldNames = []
            let mut fieldValues = []
            let mut i = 0
            loop i < m:
                let ct = trim(texts[kids[i]])
                let ceq = do actIndexAssign(ct)
                if ceq >= 0:
                    let fname = trim(slice(ct, 0, ceq))
                    let fnOk = do isIdentToken(fname)
                    if fnOk:
                        let fval = do parseExprTree(trim(slice(ct, ceq + 1, len(ct))))
                        fieldNames = append(fieldNames, fname)
                        fieldValues = append(fieldValues, fval)
                i = i + 1
            let overallValid = len(fieldNames) > 0
            return ActionStmt{kind: "setWhere", lineIdx: lineIdx, cond: whereNode, msg: "", policyName: "", policyArgs: [], entity: hf[2], key: noExpr, field: "", value: noExpr, itemVar: hf[0], fieldNames: fieldNames, fieldValues: fieldValues, serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: overallValid, status: 0, hasValue: false, event: "", hasTo: false}
        let eq = do actIndexAssign(rest)
        if eq < 0:
            let u = do actUnsupported(lineIdx)
            return u
        let lhs = trim(slice(rest, 0, eq))
        let valNode = do parseExprTree(trim(slice(rest, eq + 1, len(rest))))
        let lhsNode = do parseExprTree(lhs)
        if lhsNode.kind != "entityGet":
            let u = do actUnsupported(lineIdx)
            return u
        let fieldOk = do isIdentToken(lhsNode.field)
        if !fieldOk:
            let u = do actUnsupported(lineIdx)
            return u
        return ActionStmt{kind: "set", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: lhsNode.text, key: lhsNode.children[0], field: lhsNode.field, value: valNode, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

    # actForClausePos: splitForClauses' own keyword scan — the first
    # top-level identifier token equal to kw, or -1. Top level means: not
    # inside a "..." literal (a bare toggle, as naive as Go's own), and at
    # paren/brace depth zero — square brackets are deliberately NOT counted,
    # because Go's scan does not count them either.
    private proc actForClausePos(rest: text, kw: text) -> int:
        let n = len(rest)
        let mut inStr = false
        let mut depth = 0
        let mut i = 0
        let mut found = -1
        loop i < n && found == -1:
            let c = charAt(rest, i)
            if c == "\"":
                inStr = !inStr
                i = i + 1
            else:
                if inStr:
                    i = i + 1
                else:
                    if c == "(" || c == "{":
                        depth = depth + 1
                        i = i + 1
                    else:
                        if c == ")" || c == "}":
                            depth = depth - 1
                            i = i + 1
                        else:
                            let st = do isIdentStartChar(c)
                            if depth == 0 && st:
                                let mut j = i
                                let mut run = true
                                loop j < n && run:
                                    let ic = do isIdentChar(charAt(rest, j))
                                    if ic:
                                        j = j + 1
                                    else:
                                        run = false
                                if slice(rest, i, j) == kw:
                                    found = i
                                i = j
                            else:
                                i = i + 1
        return found

    # actForClauseEnd: where a clause starting at `start` ends — the nearest
    # of the other three keyword positions that lies after it, else n.
    private proc actForClauseEnd(start: int, p1: int, p2: int, p3: int, n: int) -> int:
        let mut e = n
        if p1 > start && p1 < e:
            e = p1
        if p2 > start && p2 < e:
            e = p2
        if p3 > start && p3 < e:
            e = p3
        return e

    # actForStmt: real parser.go's `for <range>:` action statement — the
    # header is `parseRange`'s own grammar (`item in Coll [where cond] [by
    # field desc|asc] [limit n] [more action]`, exactly what a view's `for`
    # takes), the body is this same file's block grammar over the line's
    # children. Ported faithfully: the three leading words are peeled off
    # the way parseRange peels them (var, `in`, coll), the clause tail is
    # scanned for its keywords at the TOP level only (parser.go's own
    # `splitForClauses` skips strings and parens, so a `where` nested inside
    # an aggregate's `(… where …)` never splits the header — actIndexOutside
    # is that same scan), and the clauses must come in where→by→limit→more
    # order. `more` is a view's paging control with no meaning in an action,
    # so — as real parseActionBody refuses it — it degrades to unsupported
    # here; so does a header without its trailing `:` or a `for` with no
    # body.
    proc actForStmt(texts: [text], parents: [int], lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let t = trim(texts[lineIdx])
        let endsColon = do hasSuffixText(t, ":")
        if !endsColon:
            let u = do actUnsupported(lineIdx)
            return u
        let headRaw = do trimPrefixText(t, "for ")
        let headNoColon = do trimSuffixText(trim(headRaw), ":")
        let head = trim(headNoColon)
        let fields = do actFieldsSplit(head)
        if len(fields) < 3:
            let u = do actUnsupported(lineIdx)
            return u
        if fields[1] != "in":
            let u = do actUnsupported(lineIdx)
            return u
        let v0 = do isIdentToken(fields[0])
        let v2 = do isIdentToken(fields[2])
        if !v0 || !v2:
            let u = do actUnsupported(lineIdx)
            return u
        # remainder after `<var> in <Coll>` — parseRange's own three trims
        let r1 = trim(slice(head, len(fields[0]), len(head)))
        let r1b = do trimPrefixText(r1, "in")
        let r2 = trim(r1b)
        let r2b = do trimPrefixText(r2, fields[2])
        let r3 = trim(r2b)
        # parser.go's own splitForClauses: each clause keyword is the FIRST
        # top-level identifier token spelling it, a clause's content runs
        # from just after its keyword to the nearest LATER keyword (so the
        # clauses may come in any order, exactly as Go accepts them), an
        # empty clause is refused ("`where` needs a value"), and text no
        # clause claims is ignored — all faithfully mirrored, quirks
        # included.
        let tn = len(r3)
        let wi = do actForClausePos(r3, "where")
        let bi = do actForClausePos(r3, "by")
        let li = do actForClausePos(r3, "limit")
        let mi = do actForClausePos(r3, "more")
        let mut whereS = ""
        let mut clauseOk = true
        if wi >= 0:
            let wEnd = do actForClauseEnd(wi, bi, li, mi, tn)
            whereS = trim(slice(r3, wi + 5, wEnd))
            if whereS == "":
                clauseOk = false
        let mut byS = ""
        if bi >= 0:
            let bEnd = do actForClauseEnd(bi, wi, li, mi, tn)
            byS = trim(slice(r3, bi + 2, bEnd))
            if byS == "":
                clauseOk = false
        let mut limitS = ""
        if li >= 0:
            let lEnd = do actForClauseEnd(li, wi, bi, mi, tn)
            limitS = trim(slice(r3, li + 5, lEnd))
            if limitS == "":
                clauseOk = false
        if !clauseOk:
            let u = do actUnsupported(lineIdx)
            return u
        # `more` is a view's paging control; real parseActionBody refuses it
        # in an action's own `for` whether or not it carries a value.
        if mi >= 0:
            let u = do actUnsupported(lineIdx)
            return u
        let mut whereNode = noExpr
        if whereS != "":
            let wn = do parseExprTree(whereS)
            whereNode = wn
        let mut orderField = ""
        let mut orderDesc = false
        if byS != "":
            let bp = do actFieldsSplit(byS)
            let bn = len(bp)
            if bn < 1 || bn > 2:
                let u = do actUnsupported(lineIdx)
                return u
            let fOk = do isIdentToken(bp[0])
            if !fOk:
                let u = do actUnsupported(lineIdx)
                return u
            orderField = bp[0]
            if bn == 2:
                if bp[1] == "desc":
                    orderDesc = true
                else:
                    if bp[1] != "asc":
                        let u = do actUnsupported(lineIdx)
                        return u
        let mut limitNode = noExpr
        let mut hasLimit = false
        if limitS != "":
            let ln = do parseExprTree(limitS)
            limitNode = ln
            hasLimit = true
        let bodyStmts = do actionBlockStmts(texts, parents, lineIdx)
        if len(bodyStmts) == 0:
            let u = do actUnsupported(lineIdx)
            return u
        return ActionStmt{kind: "for", lineIdx: lineIdx, cond: whereNode, msg: "", policyName: "", policyArgs: [], entity: fields[2], key: noExpr, field: "", value: noExpr, itemVar: fields[0], fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: orderField, orderDesc: orderDesc, limit: limitNode, hasLimit: hasLimit, body: bodyStmts, elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

    # actRemoveStmt: `remove Entity(key)` (by-id) or `remove item in Entity
    # where cond` (filtered — a single line, NOT a block, unlike `set`'s
    # own filtered form: real ast.Remove's filtered shape carries only a
    # predicate, never a block of assignments). The by-id form's own entity
    # name is NOT validated as an identifier — a real, confirmed quirk:
    # real Go's own parseRemove never calls isIdent on it (unlike `add`'s
    # entity name, which IS validated) — preserved here exactly.
    proc actRemoveStmt(t: text, lineIdx: int) -> ActionStmt:
        let noExpr = do emptyNode()
        let restRaw = do trimPrefixText(t, "remove ")
        let rest = trim(restRaw)
        let wi = do actIndexOutside(rest, " where ")
        let mut isWhere = false
        if wi >= 0:
            let head0 = slice(rest, 0, wi)
            let inIdx = do actIndexOutside(head0, " in ")
            if inIdx >= 0:
                isWhere = true
        if isWhere:
            let head = trim(slice(rest, 0, wi))
            let hf = do actFieldsSplit(head)
            let mut shapeOk = len(hf) == 3
            if shapeOk:
                if hf[1] != "in":
                    shapeOk = false
            if shapeOk:
                let v0 = do isIdentToken(hf[0])
                let v2 = do isIdentToken(hf[2])
                if !v0 || !v2:
                    shapeOk = false
            if !shapeOk:
                let u = do actUnsupported(lineIdx)
                return u
            let condSrc = trim(slice(rest, wi + 7, len(rest)))
            let condNode = do parseExprTree(condSrc)
            return ActionStmt{kind: "removeWhere", lineIdx: lineIdx, cond: condNode, msg: "", policyName: "", policyArgs: [], entity: hf[2], key: noExpr, field: "", value: noExpr, itemVar: hf[0], fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}
        let open = do firstParenIndex(rest)
        let close = do lastCharIndex(rest, ")")
        if open < 0 || close < open:
            let u = do actUnsupported(lineIdx)
            return u
        let ent = trim(slice(rest, 0, open))
        let keyNode = do parseExprTree(trim(slice(rest, open + 1, close)))
        return ActionStmt{kind: "remove", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: "", policyArgs: [], entity: ent, key: keyNode, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false}

    # actRequiresStmts: `requires <policy>` or `requires <policy>(args),
    # <policy2>, ...` — ONE line can produce SEVERAL real ast.Require
    # entries (real Go appends one per comma-separated piece via
    # `splitTop`), so this returns a `[ActionStmt]`, all kind "requires",
    # all sharing the same `lineIdx`.
    proc actRequiresStmts(t: text, lineIdx: int) -> [ActionStmt]:
        let noExpr = do emptyNode()
        let restRaw = do trimPrefixText(t, "requires ")
        let rest = trim(restRaw)
        let pieces = do actSplitTopComma(rest)
        let n = len(pieces)
        let mut out = []
        let mut i = 0
        loop i < n:
            let p = trim(pieces[i])
            let open = do firstParenIndex(p)
            if open < 0:
                let nameOk = do isIdentToken(p)
                if nameOk:
                    out = append(out, ActionStmt{kind: "requires", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: p, policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false})
                else:
                    let u1 = do actUnsupported(lineIdx)
                    out = append(out, u1)
            else:
                let name = trim(slice(p, 0, open))
                let nameOk = do isIdentToken(name)
                let close = do lastCharIndex(p, ")")
                if !nameOk || close < open:
                    let u2 = do actUnsupported(lineIdx)
                    out = append(out, u2)
                else:
                    let inner = trim(slice(p, open + 1, close))
                    let mut args = []
                    if inner != "":
                        let argPieces = do actSplitTopComma(inner)
                        let an = len(argPieces)
                        let mut j = 0
                        loop j < an:
                            let av = do parseExprTree(trim(argPieces[j]))
                            args = append(args, av)
                            j = j + 1
                    out = append(out, ActionStmt{kind: "requires", lineIdx: lineIdx, cond: noExpr, msg: "", policyName: name, policyArgs: args, entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: [], elseBody: [], valid: true, status: 0, hasValue: false, event: "", hasTo: false})
            i = i + 1
        return out

    # ============================================================
    # STAGE 4: actionBlockStmts — one whole action body (its header's own
    # indented children), flat (no `if`/`loop` recursion exists in this
    # grammar at all — see STAGE 3's own header note). `setWhere`'s own
    # `field = expr` children are read directly by `actSetStmt` from
    # `stmtChildrenOf(lineIdx, parents)` and are NEVER also top-level
    # children of the action's own header node (FDL's offside rule nests
    # them one level under the `set ...:` line itself), so they are never
    # double-visited here — the same non-double-processing property
    # stmt.fct's own if/else lookahead needed an explicit skip for, but
    # here falls out for free from the parent-index tree shape alone.
    # ============================================================
    proc actionBlockStmts(texts: [text], parents: [int], node: int) -> [ActionStmt]:
        let kids = do stmtChildrenOf(node, parents)
        let m = len(kids)
        let mut out = []
        let mut i = 0
        loop i < m:
            let lineIdx = kids[i]
            let t = trim(texts[lineIdx])
            let isRequires = do hasPrefixText(t, "requires ")
            let isIf = do hasPrefixText(t, "if ")
            let isMatchS = do hasPrefixText(t, "match ")
            if isMatchS:
                let ms = do actMatchStmt(texts, parents, lineIdx)
                out = append(out, ms)
                i = i + 1
                continue
            if isRequires:
                let rs = do actRequiresStmts(t, lineIdx)
                let rn = len(rs)
                let mut j = 0
                loop j < rn:
                    out = append(out, rs[j])
                    j = j + 1
                i = i + 1
            else:
                if isIf:
                    # `if <cond>:` with an optional sibling `else:` — exactly
                    # stmt.fct's stmtBlockStmts shape for a proc body, over this
                    # file's own block grammar. A header without its `:`, an
                    # empty condition, or an empty branch degrades to
                    # unsupported, as real parseActionBody refuses each.
                    let noExpr = do emptyNode()
                    let endsColon = do hasSuffixText(t, ":")
                    let condRaw = do trimPrefixText(t, "if ")
                    let condTrim = trim(condRaw)
                    let condNoColon = do trimSuffixText(condTrim, ":")
                    let condText = trim(condNoColon)
                    let thenStmts = do actionBlockStmts(texts, parents, lineIdx)
                    let mut elseStmts = []
                    let mut consumedElse = false
                    let mut elseEmpty = false
                    if i + 1 < m:
                        let nextLineIdx = kids[i + 1]
                        let nt = trim(texts[nextLineIdx])
                        if nt == "else:" || nt == "else":
                            let es = do actionBlockStmts(texts, parents, nextLineIdx)
                            elseStmts = es
                            consumedElse = true
                            if len(es) == 0:
                                elseEmpty = true
                    if !endsColon || condText == "" || len(thenStmts) == 0 || elseEmpty:
                        let u = do actUnsupported(lineIdx)
                        out = append(out, u)
                    else:
                        let cond = do parseExprTree(condText)
                        out = append(out, ActionStmt{kind: "if", lineIdx: lineIdx, cond: cond, msg: "", policyName: "", policyArgs: [], entity: "", key: noExpr, field: "", value: noExpr, itemVar: "", fieldNames: [], fieldValues: [], serviceName: "", opName: "", callArgs: [], procName: "", bindName: "", actor: noExpr, hasRole: false, role: noExpr, target: "", exprCall: noExpr, orderField: "", orderDesc: false, limit: noExpr, hasLimit: false, body: thenStmts, elseBody: elseStmts, valid: true, status: 0, hasValue: false, event: "", hasTo: false})
                    if consumedElse:
                        i = i + 2
                    else:
                        i = i + 1
                else:
                    let s = do singleActionStmt(texts, parents, lineIdx)
                    out = append(out, s)
                    i = i + 1
        return out

    # parseActionBodySrc: the end-to-end driver this task asks for — raw,
    # dedented action-body TEXT in (exactly what a real `action Name(...):`
    # header's own indented children would look like, joined with `\n`),
    # one flat, real, source-ordered `[ActionStmt]` out.
    proc parseActionBodySrc(src: text) -> [ActionStmt]:
        let indents = do actBodyIndents(src)
        let parents = do actBodyParents(indents)
        let texts = do actBodyTexts(src)
        let r = do actionBlockStmts(texts, parents, -1)
        return r

    # actionBodyOnly / actionRequiresOnly: the split back into real
    # ast.Action's own two-list shape (`Body` excludes `requires`;
    # `Requires` is ONLY `requires`) — program.fct's `buildActionDecl` uses
    # both over one `parseActionBodySrc` result, so no statement's source
    # position or content is lost by modeling `requires` as one more
    # ActionStmt kind up front.
    proc actionBodyOnly(stmts: [ActionStmt]) -> [ActionStmt]:
        let n = len(stmts)
        let mut out = []
        let mut i = 0
        loop i < n:
            if stmts[i].kind != "requires":
                out = append(out, stmts[i])
            i = i + 1
        return out

    proc actionRequiresOnly(stmts: [ActionStmt]) -> [ActionStmt]:
        let n = len(stmts)
        let mut out = []
        let mut i = 0
        loop i < n:
            if stmts[i].kind == "requires":
                out = append(out, stmts[i])
            i = i + 1
        return out

    # ============================================================
    # STAGE 5: action HEADER parsing — `action Name(params) [@optimistic]:`.
    # Real parseAction's own header is `parseSignature(head, ..., false,
    # false)` over the SAME head shape parser_proc.fct's own STAGE 4/5
    # already ports for `proc` (a proc header is `Name(params) [-> Ret]
    # [uses ...]`; an action's is just `Name(params)`, i.e. a proc header
    # with no return/uses clause at all) — so `headerName`/
    # `headerParamNames`/`headerParamTypes`/`headerParamOptionals`/
    # `headerParensValid`/`headerParamsValid`/`headerNameValid` (all
    # already reusable, unmodified, from parser_proc.fct) are reused
    # DIRECTLY over the action's own (`@optimistic`-stripped, `:`-stripped)
    # head text, rather than restated a second time.
    #
    # The one real difference `parseSignature`'s own `allowList=false`
    # argument encodes that parser_proc.fct's existing `headerParamsValid`
    # does NOT check (that helper's own header note says so explicitly: it
    # was written assuming `allowList=true`, since only `proc` ever called
    # it before now) — an action parameter may never be a `[T]` list. That
    # extra rejection is added here, in `actionHeaderValid`, rather than by
    # editing parser_proc.fct (out of scope this round, and the existing
    # helper's own behavior for `proc` must not change).
    # ============================================================
    proc actionHeadOf(lineText: text) -> text:
        let stripped = do trimPrefixText(lineText, "action")
        let trimmed = trim(stripped)
        let r = do trimSuffixText(trimmed, ":")
        return trim(r)

    proc actionIsOptimistic(rawHead: text) -> bool:
        let r = do hasSuffixText(rawHead, "@optimistic")
        return r

    proc actionHeadStripOptimistic(rawHead: text) -> text:
        let isOpt = do actionIsOptimistic(rawHead)
        if isOpt:
            let s = do trimSuffixText(rawHead, "@optimistic")
            return trim(s)
        return rawHead

    proc actionNoListParams(head: text) -> bool:
        let lists = do headerParamLists(head)
        let n = len(lists)
        let mut ok = true
        let mut i = 0
        loop i < n:
            if lists[i]:
                ok = false
            i = i + 1
        return ok

    proc actionHeaderValid(head: text) -> bool:
        let nameOk = do headerNameValid(head)
        if !nameOk:
            return false
        let parensOk = do headerParensValid(head)
        if !parensOk:
            return false
        let paramsOk = do headerParamsValid(head)
        if !paramsOk:
            return false
        let noLists = do actionNoListParams(head)
        return noLists

    # ============================================================
    # STAGE 6: describeActionStmt(s) — proof the `[ActionStmt]` result is
    # genuinely walkable, the same live-verification shape stmt.fct's own
    # STAGE 8 established for `[Stmt]`.
    # ============================================================
    proc describeActionStmt(s: ActionStmt) -> text:
        if s.kind == "check":
            return "check(" + s.msg + ")"
        if s.kind == "requires":
            return "requires(" + s.policyName + ")"
        if s.kind == "add":
            return "add(" + s.entity + ")"
        if s.kind == "set":
            return "set(" + s.entity + "." + s.field + ")"
        if s.kind == "setWhere":
            return "setWhere(" + s.entity + ")"
        if s.kind == "remove":
            return "remove(" + s.entity + ")"
        if s.kind == "removeWhere":
            return "removeWhere(" + s.entity + ")"
        if s.kind == "clear":
            return "clear(" + s.entity + ")"
        if s.kind == "call":
            return "call(" + s.serviceName + "." + s.opName + ")"
        if s.kind == "letCall":
            return "letCall(" + s.bindName + "=" + s.serviceName + "." + s.opName + ")"
        if s.kind == "do":
            return "do(" + s.procName + ")"
        if s.kind == "letDo":
            return "letDo(" + s.bindName + "=" + s.procName + ")"
        if s.kind == "let":
            return "let(" + s.target + ")"
        if s.kind == "letAdd":
            return "letAdd(" + s.bindName + "=" + s.entity + ")"
        if s.kind == "for":
            let inner = do describeActionStmts(s.body)
            let mut clauses = ""
            if s.orderField != "":
                clauses = clauses + " by " + s.orderField
                if s.orderDesc:
                    clauses = clauses + " desc"
            if s.hasLimit:
                clauses = clauses + " limit"
            return "for(" + s.itemVar + " in " + s.entity + clauses + "){" + inner + "}"
        if s.kind == "if":
            let thenD = do describeActionStmts(s.body)
            if len(s.elseBody) == 0:
                return "if{" + thenD + "}"
            let elseD = do describeActionStmts(s.elseBody)
            return "if{" + thenD + "}else{" + elseD + "}"
        if s.kind == "establish":
            return "establish"
        if s.kind == "assign":
            return "assign(" + s.target + ")"
        if s.kind == "exprStmt":
            return "exprStmt"
        return "unsupported"

    proc describeActionStmts(stmts: [ActionStmt]) -> text:
        let n = len(stmts)
        let mut out = ""
        let mut i = 0
        loop i < n:
            let d = do describeActionStmt(stmts[i])
            if i > 0:
                out = out + ","
            out = out + d
            i = i + 1
        return out

    proc describeActionBody(src: text) -> text:
        let r = do parseActionBodySrc(src)
        let d = do describeActionStmts(r)
        return d

    proc topLevelActionStmtCount(src: text) -> int:
        let r = do parseActionBodySrc(src)
        return len(r)

    # ============================================================
    # STAGE 7: the live, HTTP-exercisable driver — POST a real multi-line
    # action body `src` and get back a text summary of the real
    # `[ActionStmt]` tree plus its statement count, exactly stmt.fct's own
    # STAGE 10 shape. The demo body below is `examples/identity.fct`'s own
    # real `login` action body (check/let-call/establish/plain-assign, all
    # hand-verified against that file directly — see this task's own
    # closing report).
    # ============================================================
    state actDemoResult: text = ""
    state actDemoCount: int = 0

    action runParseActionBody(src: text):
        let d = do describeActionBody(src)
        let c = do topLevelActionStmtCount(src)
        actDemoResult = d
        actDemoCount = c

    private view ActionStmtHome at "/action_stmt":
        box:
            text "{actDemoCount} {actDemoResult}"
