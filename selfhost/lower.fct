import "ir_expr.fct"
import "expr.fct"
import "unquote.fct"

app LowerSelfHost:
    # Self-hosting port of internal/ir/build.go's `lower(ex ast.Expr, inline
    # map[string]*Expr, enums map[string][]string) *Expr` — the one function
    # that turns a parsed expression into its serializable IR form — plus
    # its helper `cloneExpr`. The INPUT is expr.fct's `ExprNode` tree (the
    # self-hosted parser's AST, imported via expr.fct -> expr_tokens.fct/
    # expr_tree.fct), the OUTPUT is ir_expr.fct's `IRExpr` (the port of
    # ir.Expr), and `irExprJSON` spells the result exactly as encoding/json
    # spells the real compiler's ir.Expr, so lower_test.go can compare the
    # two byte-for-byte-equivalent trees with reflect.DeepEqual.
    #
    # Go's two maps become parallel lists, since a proc has no map-typed
    # parameter: `inline` is (inlineNames, inlineExprs) — index-parallel,
    # a name's ALREADY-LOWERED replacement at the same index, exactly the
    # `e.inline[name] = p.Expr // already lowered` table envFromIR builds —
    # and `enums` is just its key set `enumNames` (lower() only ever asks
    # `_, isEnum := enums[r.Name]`; the member list is never read here).
    #
    # Every ExprNode kind the self-hosted parser can produce is lowered,
    # case by case as lower()'s own type switch does:
    #   int/float/bool/text -> lit, vtype "int"/"float"/"bool"/"text"
    #       (ast.Lit.Kind's own names). The parser keeps a literal's RAW
    #       token text, so this file does the decoding parseAtom does:
    #       strconv.Atoi for an int (leading zeros dropped), the shortest
    #       round-trip spelling encoding/json gives a float64 (trailing
    #       fraction zeros and a bare `.` dropped — `2.50` -> 2.5, `2.0`
    #       -> 2), and strconv.Unquote for a text literal (surrounding
    #       quotes removed, `\n \t \r \" \\` decoded; any other escape is
    #       kept as the escaped character itself — `\x`/`\u`/octal escapes
    #       are out of scope, the tokenizer never sees them in practice).
    #       An exponent-form float spelling (1e+23) is likewise out of
    #       scope: the tokenizer only produces `<digits>.<digits>`.
    #   ref   -> ref, UNLESS the name is in inlineNames: then a deep copy
    #       (lowerCloneExpr, the port of cloneExpr) of the matching
    #       inlineExprs entry — the policy/derive inlining that makes the
    #       same value compute identically wherever it is read.
    #   bin   -> bin (op, l, r);  un -> un (op, x)
    #   get   -> lit(text) when the object is a bare ref naming an enum
    #       (`Status.active` folds to "active" — checked BEFORE the ref
    #       would be inline-substituted, as the Go `t.Obj.(ast.Ref)` test
    #       is), else get(obj, field).
    #   entityGet -> eget (entity, key, field — "" when bare `Entity(k)`)
    #   index -> index (obj, key);  call -> call (name, args)
    #   list  -> list (args);  map -> map (keys, args parallel)
    #   agg   -> agg (op, coll, field, var, where?, sel?) — where/sel are
    #       0-or-1-element lists on both sides, lowered when present.
    #
    # astate (pending/failed/dirty/touched) -> astate (op, name); struct
    #   -> struct (name, fields, args parallel).
    #
    # Out of scope, because the self-hosted parser cannot produce the node
    # (not because this file could not lower it): ast.Asset
    # (`asset("...")`, a compile-time file inlining with no parser support
    # here), and every operator the parser's own header lists as unsupported
    # (`%`, `<<`/`>>`, membership `in`). Anything that reaches lowerNode
    # with a kind outside the list above degrades to ir_expr.fct's
    # `emptyIR()` sentinel (kind "") — the honest "unsupported" answer this
    # directory's ports use instead of a crash, since a proc has no error
    # channel; lower() itself returns nil there.
    #
    # The test driver at the bottom follows action_stmt.fct's
    # runParseActionBody shape: an action cannot take a list parameter or
    # bind a struct result, so the HTTP entry points take newline-separated
    # text lists and store the emitted JSON in a text state cell.

    # lowerFindName: the index of `name` in `names`, -1 when absent — the
    # `_, ok := inline[name]` / `_, isEnum := enums[name]` lookup over a
    # parallel list.
    proc lowerFindName(names: [text], name: text) -> int:
        return indexOf(names, name, 0)

    # lowerIntText: strconv.Atoi's effect on the spelling — leading zeros
    # go, a lone "0" stays.
    proc lowerIntText(raw: text) -> text:
        let mut s = raw
        loop len(s) > 1 && charAt(s, 0) == "0":
            s = slice(s, 1, len(s))
        return s

    # lowerFloatText: encoding/json's spelling of the float64
    # strconv.ParseFloat reads from `<digits>.<digits>` — its shortest
    # round-trip digits (a float's own text form, FormatFloat 'g' -1, or an
    # integer's digits), laid out as json's floatEncoder does: 'f' form,
    # except 'e' form below 1e-6 or from 1e21 up, its exponent unpadded
    # (`1e-8`, `1e+21`).
    proc lowerFloatText(raw: text) -> text:
        let g = "" + toFloat(raw)
        let mut neg = false
        let mut body = g
        if charAt(body, 0) == "-":
            neg = true
            body = slice(body, 1, len(body))
        # digits (no leading zeros) and dp: value = 0.<digits> × 10^dp
        let mut mant = body
        let mut exp = 0
        let at = indexOf(body, "e", 0)
        if at >= 0:
            mant = slice(body, 0, at)
            exp = toInt(slice(body, at + 1, len(body)))
        let dot = indexOf(mant, ".", 0)
        let mut digits = mant
        let mut dp = len(mant)
        if dot >= 0:
            digits = slice(mant, 0, dot) + slice(mant, dot + 1, len(mant))
            dp = dot
        loop len(digits) > 0 && charAt(digits, 0) == "0":
            digits = slice(digits, 1, len(digits))
            dp = dp - 1
        loop len(digits) > 0 && charAt(digits, len(digits) - 1) == "0":
            digits = slice(digits, 0, len(digits) - 1)
        if digits == "":
            return "0"
        dp = dp + exp
        let mut out = ""
        if dp <= -6 || dp >= 22:
            out = charAt(digits, 0)
            if len(digits) > 1:
                out = out + "." + slice(digits, 1, len(digits))
            let e = dp - 1
            if e < 0:
                out = out + "e-" + (0 - e)
            else:
                out = out + "e+" + e
        else:
            if dp <= 0:
                out = "0."
                let mut z = 0
                loop z < 0 - dp:
                    out = out + "0"
                    z = z + 1
                out = out + digits
            else:
                if dp >= len(digits):
                    out = digits
                    let mut z2 = len(digits)
                    loop z2 < dp:
                        out = out + "0"
                        z2 = z2 + 1
                else:
                    out = slice(digits, 0, dp) + "." + slice(digits, dp, len(digits))
        if neg:
            return "-" + out
        return out

    # lowerUnquote: strconv.Unquote over the tokenizer's raw `"..."` token.
    proc lowerUnquote(raw: text) -> text:
        let u = do goUnquote(raw)
        if u.ok:
            return u.value
        let n = len(raw)
        let mut start = 0
        let mut end = n
        if n > 0 && charAt(raw, 0) == "\"":
            start = 1
        if n > 1 && charAt(raw, n - 1) == "\"":
            end = n - 1
        let mut out = ""
        let mut i = start
        loop i < end:
            let c = charAt(raw, i)
            if c == "\\" && i + 1 < end:
                let e = charAt(raw, i + 1)
                if e == "n":
                    out = out + "\n"
                else:
                    if e == "t":
                        out = out + "\t"
                    else:
                        if e == "r":
                            out = out + "\r"
                        else:
                            out = out + e
                i = i + 2
            else:
                out = out + c
                i = i + 1
        return out

    # lowerCloneExpr: cloneExpr — a deep copy of an IRExpr. Go copies the
    # struct and re-clones each child pointer (L/R/X/Obj/Key/Where, and
    # every Args/Keys element); here every child list is rebuilt node by
    # node so the substituted copy shares nothing with the inline table's
    # entry. (Go's cloneExpr leaves Sel and Fields shared — a serialized
    # tree cannot tell the difference, so this copies those too.)
    proc lowerCloneList(xs: [IRExpr]) -> [IRExpr]:
        let n = len(xs)
        let mut out = []
        let mut i = 0
        loop i < n:
            let c = do lowerCloneExpr(xs[i])
            out = append(out, c)
            i = i + 1
        return out

    proc lowerCloneExpr(e: IRExpr) -> IRExpr:
        let obj = do lowerCloneList(e.obj)
        let key = do lowerCloneList(e.key)
        let args = do lowerCloneList(e.args)
        let keys = do lowerCloneList(e.keys)
        let l = do lowerCloneList(e.l)
        let r = do lowerCloneList(e.r)
        let x = do lowerCloneList(e.x)
        let where = do lowerCloneList(e.where)
        let sel = do lowerCloneList(e.sel)
        let limit = do lowerCloneList(e.limit)
        let orderBy = do lowerCloneList(e.orderBy)
        return IRExpr{kind: e.kind, hasVal: e.hasVal, val: e.val, vtype: e.vtype, name: e.name, field: e.field, obj: obj, key: key, op: e.op, args: args, keys: keys, fields: e.fields, l: l, r: r, x: x, itemVar: e.itemVar, where: where, sel: sel, order: e.order, desc: e.desc, limit: limit, orderBy: orderBy, omit: e.omit, nulls: e.nulls}

    # lowerNodeList: lower() mapped over a child list (a call's args, a
    # list's elements, a map's keys/values, an agg's 0-or-1 where/sel).
    # lowerNodeList / lowerNode: lower() with just an inline table and the
    # enum names (no parameterized derives, no post passes).
    proc lowerNodeList(ns: [ExprNode], inlineNames: [text], inlineExprs: [IRExpr], enumNames: [text]) -> [IRExpr]:
        let ctx = do lowCtxBasic(inlineNames, inlineExprs, enumNames)
        let r = do lowerListC(ns, ctx)
        return r

    proc lowerNode(n: ExprNode, inlineNames: [text], inlineExprs: [IRExpr], enumNames: [text]) -> IRExpr:
        let ctx = do lowCtxBasic(inlineNames, inlineExprs, enumNames)
        let r = do lowerC(n, ctx)
        return r

    # LowCtx: everything env.low reads — the inline table (zero-argument
    # policies and derives), the enum names, the parameterized derives
    # (expanded at every call, expandDerive), and the three post passes'
    # tables: text-typed entity fields (markTextAggs), entity derives a
    # list may order by (deriveOrders), wire types' optional fields
    # (markOmits).
    struct LowFn:
        name: text
        params: [text]
        body: IRExpr
        # ret: the derive's declared type, as written (`T`, `[T]`, `T?`).
        ret: text

    struct LowCtx:
        inlineNames: [text]
        inlineExprs: [IRExpr]
        enumNames: [text]
        fns: [LowFn]
        textFieldKeys: [text]
        deriveKeys: [text]
        deriveExprs: [IRExpr]
        wireOptKeys: [text]
        # wireNullKeys: "Type.field" of every `T or null` wire-type field,
        # in declaration order (markOmits' Nulls).
        wireNullKeys: [text]

    proc lowCtxBasic(inlineNames: [text], inlineExprs: [IRExpr], enumNames: [text]) -> LowCtx:
        return LowCtx{inlineNames: inlineNames, inlineExprs: inlineExprs, enumNames: enumNames, fns: [], textFieldKeys: [], deriveKeys: [], deriveExprs: [], wireOptKeys: [], wireNullKeys: []}

    proc lowerFindFn(ctx: LowCtx, name: text) -> int:
        let n = len(ctx.fns)
        let mut i = 0
        loop i < n:
            if ctx.fns[i].name == name:
                return i
            i = i + 1
        return -1

    # exprRenameCalls: manglePrivate's rewriteInlineCalls over one
    # expression — every call naming one of `from` (a file's private
    # procs) names its mangled `to` instead, at any depth.
    proc exprRenameCalls(ex: ExprNode, from: [text], to: [text]) -> ExprNode:
        let mut x = ex
        if x.kind == "call":
            let at = indexOf(from, x.text, 0)
            if at >= 0:
                x.text = to[at]
        x.children = exprsRenameCalls(ex.children, from, to)
        x.whereClause = exprsRenameCalls(ex.whereClause, from, to)
        x.sel = exprsRenameCalls(ex.sel, from, to)
        x.limit = exprsRenameCalls(ex.limit, from, to)
        x.orderBy = exprsRenameCalls(ex.orderBy, from, to)
        let mut ps = []
        let mut i = 0
        loop i < len(ex.pairs):
            ps = append(ps, Pair{key: exprRenameCalls(ex.pairs[i].key, from, to), value: exprRenameCalls(ex.pairs[i].value, from, to)})
            i = i + 1
        x.pairs = ps
        return x

    proc exprsRenameCalls(xs: [ExprNode], from: [text], to: [text]) -> [ExprNode]:
        let mut out = []
        let mut i = 0
        loop i < len(xs):
            out = append(out, exprRenameCalls(xs[i], from, to))
            i = i + 1
        return out

    # lowFull: env.low — lower(), then markTextAggs, deriveOrders and
    # markOmits over the result. The three passes are one walk (lowPasses):
    # each rewrites a node from that node alone, so running all three at
    # every node of one post-order walk rewrites exactly what three walks
    # would — with deriveOrders' new `by` expression, which the first two
    # walks never visit, given markOmits alone (lowOmits).
    proc lowFull(n: ExprNode, ctx: LowCtx) -> IRExpr:
        let l = do lowerC(n, ctx)
        let c = do lowPasses(l, ctx)
        return c

    # lowPasses: markTextAggs, deriveOrders and markOmits at x and every
    # node below it (Kids(): l r x obj key where sel limit keys args; the
    # `by` expressions get markOmits only).
    proc lowPasses(x0: IRExpr, ctx: LowCtx) -> IRExpr:
        let mut x = x0
        x.l = lowPassesList(x0.l, ctx)
        x.r = lowPassesList(x0.r, ctx)
        x.x = lowPassesList(x0.x, ctx)
        x.obj = lowPassesList(x0.obj, ctx)
        x.key = lowPassesList(x0.key, ctx)
        x.where = lowPassesList(x0.where, ctx)
        x.sel = lowPassesList(x0.sel, ctx)
        x.limit = lowPassesList(x0.limit, ctx)
        x.keys = lowPassesList(x0.keys, ctx)
        x.args = lowPassesList(x0.args, ctx)
        # markTextAggs: min/max of a text field is text
        if x.kind == "agg" && (x.op == "min" || x.op == "max") && x.field != "":
            if (x.name + "." + x.field) in ctx.textFieldKeys:
                x.vtype = "text"
        # deriveOrders: a list ordered `by` an entity derive orders by that
        # derive's expression over the item (`$item` when the list binds
        # no variable)
        if x.kind == "agg" && x.order != "":
            let at = do lowerFindName(ctx.deriveKeys, x.name + "." + x.order)
            if at >= 0:
                if x.itemVar == "":
                    x.itemVar = "$item"
                let rowRef = do irRef(x.itemVar)
                let ob = do lowSubstParams(ctx.deriveExprs[at], ["$row"], [rowRef], [], [])
                x.order = ""
                x.orderBy = [ob.e]
        x.orderBy = lowOmitsList(x.orderBy, ctx)
        let m = do lowOmitAt(x, ctx)
        return m

    proc lowPassesList(xs: [IRExpr], ctx: LowCtx) -> [IRExpr]:
        let mut out = []
        let n = len(xs)
        let mut i = 0
        loop i < n:
            out = append(out, lowPasses(xs[i], ctx))
            i = i + 1
        return out

    # lowOmits: markOmits alone at x and every node below it (Kids() and
    # the `by` expressions).
    proc lowOmits(x0: IRExpr, ctx: LowCtx) -> IRExpr:
        let mut x = x0
        x.l = lowOmitsList(x0.l, ctx)
        x.r = lowOmitsList(x0.r, ctx)
        x.x = lowOmitsList(x0.x, ctx)
        x.obj = lowOmitsList(x0.obj, ctx)
        x.key = lowOmitsList(x0.key, ctx)
        x.where = lowOmitsList(x0.where, ctx)
        x.sel = lowOmitsList(x0.sel, ctx)
        x.limit = lowOmitsList(x0.limit, ctx)
        x.keys = lowOmitsList(x0.keys, ctx)
        x.args = lowOmitsList(x0.args, ctx)
        x.orderBy = lowOmitsList(x0.orderBy, ctx)
        let m = do lowOmitAt(x, ctx)
        return m

    proc lowOmitsList(xs: [IRExpr], ctx: LowCtx) -> [IRExpr]:
        let mut out = []
        let n = len(xs)
        let mut i = 0
        loop i < n:
            out = append(out, lowOmits(xs[i], ctx))
            i = i + 1
        return out

    # lowOmitAt: markOmits at one node — a wire-type literal lists its
    # optional fields (first marking wins) and its `T or null` fields, in
    # declaration order.
    proc lowOmitAt(x0: IRExpr, ctx: LowCtx) -> IRExpr:
        if x0.kind == "struct" && len(x0.omit) == 0:
            let mut x = x0
            let mut omit = []
            let n = len(x.fields)
            let mut i = 0
            loop i < n:
                if (x.name + "." + x.fields[i]) in ctx.wireOptKeys:
                    omit = append(omit, x.fields[i])
                i = i + 1
            let mut nulls = []
            let pre = x.name + "."
            let nn = len(ctx.wireNullKeys)
            let mut k = 0
            loop k < nn:
                let key = ctx.wireNullKeys[k]
                if len(key) > len(pre) && slice(key, 0, len(pre)) == pre:
                    nulls = append(nulls, slice(key, len(pre), len(key)))
                k = k + 1
            x.omit = omit
            x.nulls = nulls
            return x
        return x0

    # ── parameterized derives: expandDerive / substParams / irNames ─────
    proc lowIrNames(x: IRExpr, acc: [text]) -> [text]:
        let mut out = acc
        if x.kind == "ref" && !(x.name in out):
            out = append(out, x.name)
        if x.itemVar != "" && !(x.itemVar in out):
            out = append(out, x.itemVar)
        let lists = [x.l, x.r, x.x, x.obj, x.key, x.where, x.sel, x.limit, x.keys, x.args, x.orderBy]
        let nl = len(lists)
        let mut i = 0
        loop i < nl:
            let ks = lists[i]
            let nk = len(ks)
            let mut j = 0
            loop j < nk:
                let a = do lowIrNames(ks[j], out)
                out = a
                j = j + 1
            i = i + 1
        return out

    struct LowSubst:
        e: IRExpr
        taken: [text]

    struct LowSubstList:
        es: [IRExpr]
        taken: [text]

    proc lowSubstList(xs: [IRExpr], names: [text], vals: [IRExpr], argNames: [text], taken0: [text]) -> LowSubstList:
        let mut out = []
        let mut taken = taken0
        let n = len(xs)
        let mut i = 0
        loop i < n:
            let r = do lowSubstParams(xs[i], names, vals, argNames, taken)
            out = append(out, r.e)
            taken = r.taken
            i = i + 1
        return LowSubstList{es: out, taken: taken}

    proc lowSubstParams(x: IRExpr, names: [text], vals: [IRExpr], argNames: [text], taken0: [text]) -> LowSubst:
        let mut taken = taken0
        if x.kind == "ref":
            let at = do lowerFindName(names, x.name)
            if at >= 0:
                let c = do lowerCloneExpr(vals[at])
                return LowSubst{e: c, taken: taken}
        if x.kind == "get":
            let o = do lowSubstList(x.obj, names, vals, argNames, taken)
            let obj = o.es[0]
            if obj.kind == "eget" && obj.field == "":
                return LowSubst{e: IRExpr{kind: obj.kind, hasVal: obj.hasVal, val: obj.val, vtype: obj.vtype, name: obj.name, field: x.field, obj: obj.obj, key: obj.key, op: obj.op, args: obj.args, keys: obj.keys, fields: obj.fields, l: obj.l, r: obj.r, x: obj.x, itemVar: obj.itemVar, where: obj.where, sel: obj.sel, order: obj.order, desc: obj.desc, limit: obj.limit, orderBy: obj.orderBy, omit: obj.omit, nulls: obj.nulls}, taken: o.taken}
            let g = do irGet(obj, x.field)
            return LowSubst{e: g, taken: o.taken}
        if x.kind == "agg":
            let lim = do lowSubstList(x.limit, names, vals, argNames, taken)
            taken = lim.taken
            let mut inNames = names
            let mut inVals = vals
            let mut v = x.itemVar
            if x.itemVar != "":
                let mut nn = []
                let mut nv = []
                let nb = len(names)
                let mut i = 0
                loop i < nb:
                    if names[i] != x.itemVar:
                        nn = append(nn, names[i])
                        nv = append(nv, vals[i])
                    i = i + 1
                if x.itemVar in argNames:
                    let mut fresh = x.itemVar
                    let mut k = 2
                    loop fresh in taken:
                        fresh = x.itemVar + k
                        k = k + 1
                    taken = append(taken, fresh)
                    let fr = do irRef(fresh)
                    nn = append(nn, x.itemVar)
                    nv = append(nv, fr)
                    v = fresh
                inNames = nn
                inVals = nv
            let w = do lowSubstList(x.where, inNames, inVals, argNames, taken)
            let s = do lowSubstList(x.sel, inNames, inVals, argNames, w.taken)
            let ob = do lowSubstList(x.orderBy, inNames, inVals, argNames, s.taken)
            return LowSubst{e: IRExpr{kind: x.kind, hasVal: x.hasVal, val: x.val, vtype: x.vtype, name: x.name, field: x.field, obj: x.obj, key: x.key, op: x.op, args: x.args, keys: x.keys, fields: x.fields, l: x.l, r: x.r, x: x.x, itemVar: v, where: w.es, sel: s.es, order: x.order, desc: x.desc, limit: lim.es, orderBy: ob.es, omit: x.omit, nulls: x.nulls}, taken: ob.taken}
        let l = do lowSubstList(x.l, names, vals, argNames, taken)
        let r = do lowSubstList(x.r, names, vals, argNames, l.taken)
        let xx = do lowSubstList(x.x, names, vals, argNames, r.taken)
        let obj2 = do lowSubstList(x.obj, names, vals, argNames, xx.taken)
        let key = do lowSubstList(x.key, names, vals, argNames, obj2.taken)
        let args = do lowSubstList(x.args, names, vals, argNames, key.taken)
        let keys = do lowSubstList(x.keys, names, vals, argNames, args.taken)
        return LowSubst{e: IRExpr{kind: x.kind, hasVal: x.hasVal, val: x.val, vtype: x.vtype, name: x.name, field: x.field, obj: obj2.es, key: key.es, op: x.op, args: args.es, keys: keys.es, fields: x.fields, l: l.es, r: r.es, x: xx.es, itemVar: x.itemVar, where: x.where, sel: x.sel, order: x.order, desc: x.desc, limit: x.limit, orderBy: x.orderBy, omit: x.omit, nulls: x.nulls}, taken: keys.taken}

    proc lowerExpandDerive(fn: LowFn, args: [IRExpr]) -> IRExpr:
        let mut argNames = []
        let n = len(fn.params)
        let mut i = 0
        loop i < n && i < len(args):
            let a = do lowIrNames(args[i], argNames)
            argNames = a
            i = i + 1
        let taken = do lowIrNames(fn.body, argNames)
        let r = do lowSubstParams(fn.body, fn.params, args, argNames, taken)
        return r.e

    proc lowerListC(ns: [ExprNode], ctx: LowCtx) -> [IRExpr]:
        let n = len(ns)
        let mut out = []
        let mut i = 0
        loop i < n:
            let e = do lowerC(ns[i], ctx)
            out = append(out, e)
            i = i + 1
        return out

    # lowerNode: lower(), case by case (see the header for the table).
    proc lowerC(n: ExprNode, ctx: LowCtx) -> IRExpr:
        if n.kind == "int":
            let iv = do lowerIntText(n.text)
            let ilit = do irLit(iv, "int")
            return ilit
        if n.kind == "float":
            let fv = do lowerFloatText(n.text)
            let flit = do irLit(fv, "float")
            return flit
        if n.kind == "bool":
            let blit = do irLit(n.text, "bool")
            return blit
        if n.kind == "text":
            let tv = do lowerUnquote(n.text)
            let tlit = do irLit(tv, "text")
            return tlit
        # `asset from "…"` the driver resolved (driverResolveAssets): its
        # literal carries a NUL, then the file's text or the URL it was
        # copied to — lowered exactly as build.go lowers a resolved Asset
        if n.kind == "asset":
            let av = do lowerUnquote(n.text)
            let alit = do irLit(slice(av, 1, len(av)), "text")
            return alit
        if n.kind == "ref":
            let at = do lowerFindName(ctx.inlineNames, n.text)
            if at >= 0:
                let copied = do lowerCloneExpr(ctx.inlineExprs[at])
                return copied
            let ref = do irRef(n.text)
            return ref
        if n.kind == "bin":
            let bl = do lowerC(n.children[0], ctx)
            let br = do lowerC(n.children[1], ctx)
            let bin = do irBin(n.text, bl, br)
            return bin
        if n.kind == "un":
            let ux = do lowerC(n.children[0], ctx)
            let un = do irUn(n.text, ux)
            return un
        if n.kind == "get":
            let gobj = n.children[0]
            if gobj.kind == "ref":
                let enumAt = do lowerFindName(ctx.enumNames, gobj.text)
                if enumAt >= 0:
                    let member = do irLit(n.text, "text")
                    return member
            let gl = do lowerC(gobj, ctx)
            let get = do irGet(gl, n.text)
            return get
        if n.kind == "entityGet":
            let ek = do lowerC(n.children[0], ctx)
            let eget = do irEGet(n.text, ek, n.field)
            return eget
        if n.kind == "index":
            let xo = do lowerC(n.children[0], ctx)
            let xk = do lowerC(n.children[1], ctx)
            let index = do irIndex(xo, xk)
            return index
        if n.kind == "call":
            let cargs = do lowerListC(n.children, ctx)
            let call = do irCall(n.text, cargs)
            let fi = do lowerFindFn(ctx, n.text)
            if fi >= 0:
                let ex = do lowerExpandDerive(ctx.fns[fi], cargs)
                return ex
            return call
        if n.kind == "list":
            let elems = do lowerListC(n.children, ctx)
            let list = do irList(elems)
            return list
        if n.kind == "map":
            let np = len(n.pairs)
            let mut mkeys = []
            let mut mvals = []
            let mut pi = 0
            loop pi < np:
                let mk = do lowerC(n.pairs[pi].key, ctx)
                let mv = do lowerC(n.pairs[pi].value, ctx)
                mkeys = append(mkeys, mk)
                mvals = append(mvals, mv)
                pi = pi + 1
            let map = do irMap(mkeys, mvals)
            return map
        if n.kind == "agg":
            let aw = do lowerListC(n.whereClause, ctx)
            let asel = do lowerListC(n.sel, ctx)
            let alim = do lowerListC(n.limit, ctx)
            let aord = do lowerListC(n.orderBy, ctx)
            return IRExpr{kind: "agg", hasVal: false, val: "", vtype: "", name: n.coll, field: n.field, obj: [], key: [], op: n.text, args: [], keys: [], fields: [], l: [], r: [], x: [], itemVar: n.itemVar, where: aw, sel: asel, order: n.order, desc: n.desc, limit: alim, orderBy: aord, omit: [], nulls: []}
        if n.kind == "astate":
            let ast0 = do irAState(n.text, n.field)
            return ast0
        if n.kind == "struct":
            let sn = len(n.pairs)
            let mut sfields = []
            let mut svals = []
            let mut si = 0
            loop si < sn:
                sfields = append(sfields, n.pairs[si].key.text)
                let sv = do lowerC(n.pairs[si].value, ctx)
                svals = append(svals, sv)
                si = si + 1
            let st = do irStruct(n.text, sfields, svals)
            return st
        let unsupported = do emptyIR()
        return unsupported

    # ── whole-expression drivers ────────────────────────────────────────
    # lowerSrcJSON: parse `src` with the self-hosted parser, lower it with
    # no inline table, and spell the IR as encoding/json would.
    proc lowerSrcJSON(src: text, enumNames: [text]) -> text:
        let tree = do parseExprTree(src)
        let noNames = []
        let noExprs = []
        let e = do lowerNode(tree, noNames, noExprs, enumNames)
        let j = do irExprJSON(e)
        return j

    # lowerInlineTable: each inline source is parsed and lowered in turn —
    # with the entries lowered so far in scope, exactly as the real build
    # lowers each policy/derive against the table built up before it — and
    # the result is the index-parallel `[IRExpr]` half of the inline table.
    proc lowerInlineTable(inlineNames: [text], inlineSrcs: [text], enumNames: [text]) -> [IRExpr]:
        let n = len(inlineSrcs)
        let mut exprs = []
        let mut names = []
        let mut i = 0
        loop i < n:
            let tree = do parseExprTree(inlineSrcs[i])
            let e = do lowerNode(tree, names, exprs, enumNames)
            exprs = append(exprs, e)
            names = append(names, inlineNames[i])
            i = i + 1
        return exprs

    proc lowerSrcWithInlineJSON(src: text, inlineNames: [text], inlineSrcs: [text], enumNames: [text]) -> text:
        let exprs = do lowerInlineTable(inlineNames, inlineSrcs, enumNames)
        let tree = do parseExprTree(src)
        let e = do lowerNode(tree, inlineNames, exprs, enumNames)
        let j = do irExprJSON(e)
        return j

    # ── HTTP driver ─────────────────────────────────────────────────────
    # lowerSplitLines: a newline-separated text list -> [text], "" -> []
    # (strings.Split("", sep) would give one empty entry, which is not an
    # empty table).
    proc lowerSplitLines(s: text) -> [text]:
        if s == "":
            return []
        let parts = split(s, "\n")
        return parts

    proc lowerSrcLinesJSON(src: text, enumLines: text) -> text:
        let enums = do lowerSplitLines(enumLines)
        let j = do lowerSrcJSON(src, enums)
        return j

    proc lowerSrcWithInlineLinesJSON(src: text, nameLines: text, srcLines: text, enumLines: text) -> text:
        let names = do lowerSplitLines(nameLines)
        let srcs = do lowerSplitLines(srcLines)
        let enums = do lowerSplitLines(enumLines)
        let j = do lowerSrcWithInlineJSON(src, names, srcs, enums)
        return j

    state lowerResult: text = ""

    # runLowerSrc: POST {"args": [src, "Enum1\nEnum2"]} -> lowerResult is
    # the IR JSON.
    action runLowerSrc(src: text, enumLines: text):
        let j = do lowerSrcLinesJSON(src, enumLines)
        lowerResult = j

    # runLowerSrcWithInline: POST {"args": [src, "name1\nname2",
    # "src1\nsrc2", "Enum1"]} — inline sources are one per line, index-
    # parallel to the names.
    action runLowerSrcWithInline(src: text, nameLines: text, srcLines: text, enumLines: text):
        let j = do lowerSrcWithInlineLinesJSON(src, nameLines, srcLines, enumLines)
        lowerResult = j

    private view LowerHome at "/lower":
        box:
            text "{lowerResult}"
