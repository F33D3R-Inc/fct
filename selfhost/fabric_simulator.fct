import "fabric_controller_core.fct"

app FabricSimulatorSelfHost:
    # Self-hosting port of the REST of fabric/crates/fabric-simulator/src/
    # — the three files fabric_simulator_base.fct (clock.rs/fault.rs/rng.rs/
    # workload.rs) left unported, read in full before writing a line here:
    #   cluster.rs    (502L) ClusterSpec, SimNode, SimCell, ClusterState
    #   executor.rs   (351L) SimExecutor — the crate's `PlacementExecutor`
    #   simulation.rs (979L, ~520L non-test) Tick, CellLoad, Simulation
    # lib.rs is doc comment + `pub mod`/`pub use` only. ~1 370 real Rust
    # lines: the synthetic fleet, the mechanism that edits it, and the tick
    # loop that observes it. No wall clock, no entropy, no I/O anywhere —
    # confirmed by grepping all three files, not assumed from doc comments.
    #
    # ============================================================
    # WHAT IS PORTED, FUNCTION FOR FUNCTION
    # ============================================================
    # cluster.rs: ClusterSpec (Default impl = `clusterSpecDefault`, with_seed,
    #   node_count); SimNode::new/condition; SimCell::class/profile/holders/
    #   occupies; ClusterState::build/generation/transfer_bytes_per_ms/node/
    #   node_mut (see simplification 2)/nodes/cell/cell_mut/cells/shard/
    #   hosted_placements/stage/unstage/promote/set_owner/drop_copy/topology/
    #   fleet_view/least_loaded_node.
    # executor.rs: PREPARE_MS/CUTOVER_MS/CLEANUP_MS, SimJob::new,
    #   SimExecutor::new/phase_duration_ms/check_destination/apply_completion
    #   and the five trait methods name/supports/plan/begin_phase/poll_phase/
    #   abort.
    # simulation.rs: Tick, CellLoad, Simulation::new/spec/now_ms/clock/state/
    #   executor/topology/fleet_view/generation/targets/schedule_fault/inject/
    #   step/run/due_faults/apply_fault/expire_hotspots/recompute_load/
    #   build_observations/build_messages.
    # Plus, at the bottom, the eight `simulation::tests` translated input for
    #   input (cluster.rs and executor.rs ship no tests — grepped) and the
    #   hand-traced executor / staged-copy scenarios the tests leave
    #   uncovered. Every expected value in fabric_simulator_test.go was
    #   produced by running the real Rust crate against these exact inputs.
    #
    # ============================================================
    # THE COMPOSITION SEAM WITH fabric_controller_core.fct — read this first
    # ============================================================
    # executor.rs exists to be handed to `FabricController::register_executor`
    # as a `Box<dyn PlacementExecutor>`. fabric_controller_core.fct restates
    # that trait object as a CLOSED `Executor` struct (its simplification 1)
    # whose four dispatch procs (`executorPlan/BeginPhase/PollPhase/Abort`)
    # switch on `kind` and implement only "stub"; the struct carries the
    # stub's own state (`removes`/`startedPhases`/`startedAtMs`) and nothing
    # else. The simulated executor needs two things that struct cannot hold
    # without an edit to that file: a `ClusterState` (the world it mutates —
    # `Rc<RefCell<ClusterState>>` in Rust) and a `BTreeMap<ActionTarget,
    # SimJob>`. Adding a `kind == "simulated-placement"` arm would also mean
    # editing those four procs. That file is not edited (this task's own
    # rule), so the seam is bridged from THIS side, in three parts:
    #   (a) `SimExecutor` below is the executor.rs state machine in full,
    #       with the same five trait methods, taking the world explicitly
    #       (see simplification 1) — the mechanism itself is a faithful port.
    #   (b) `simControllerSubmit` / `simControllerAdvance` /
    #       `simControllerAbortWith` are fabric_controller_core.fct's
    #       `fabricControllerSubmit` / `fabricControllerAdvance` /
    #       `fabricControllerAbortWith` restated line for line with ONLY the
    #       executor dispatch lines swapped (`executorPlan` ->
    #       `simExecutorPlan`, etc.) and the executor+world threaded through
    #       the result structs. Everything else those three procs do is the
    #       imported original, called by name: `fabricControllerValidate`,
    #       `fabricControllerValidatePlan`, `fabricControllerCheckMeasurement
    #       Deadline`, `fabricControllerNodeLoss`, the whole `executionRecord*`
    #       / `actionRegistry*` / `replicaLedger*` surface, and
    #       `fabricControllerMeasure` / `fabricControllerRecord` /
    #       `fabricControllerReports` / `fabricControllerMechanisms`, which
    #       never touch an executor and are used AS IS.
    #   (c) `simControllerRegister` registers a placeholder
    #       `Executor{kind: "simulated-placement", name: "simulated-placement"}`
    #       in the controller so `mechanisms()` and the record's `mechanism`
    #       field stay truthful; the imported `fabricControllerAdvance` would
    #       (correctly) abort such a record with an Internal "no mechanism of
    #       kind" fault, which is why (b) exists.
    # The exact blocking seam, stated once: `struct Executor` in
    # fabric_controller_core.fct has no field for a mechanism's own world or
    # job table, and its four `executor*` procs are closed over `kind`.
    #
    # ============================================================
    # WHY fabric_simulator_base.fct IS NOT IMPORTED — the second seam
    # ============================================================
    # `import "fabric_simulator_base.fct"` together with `import
    # "fabric_controller_core.fct"` was tried FIRST, in a two-line scratch
    # file: `facet check` refuses it — `proc "floatApproxEquals" is declared
    # more than once` — because fabric_simulator_base.fct's demo helper of
    # that name collides with fabric_ml.fct's (reached here through
    # fabric_controller_plan.fct -> fabric_optimizer.fct -> fabric_ml.fct).
    # Neither file may be edited, and the controller import is the one this
    # port exists to compose with, so the base's four leaf ports (Rng,
    # SimClock, Fault, ClassProfile/class_profile/diurnal — ~120 real lines)
    # are RESTATED below as `private proc`s (file-local by construction, so
    # they can never collide with anything) under `Sim`-prefixed struct
    # names, copied from fabric_simulator_base.fct verbatim including its
    # three proven operator facts (negative two's-complement constants,
    # wrapping `+`/`*`, `shiftRightLogical64` for Rust's logical `>>`, and
    # `unsignedMod64` for `u64 %`). fabric_simulator_base.fct remains the
    # canonical, separately tested port of those files; this copy is the
    # honest cost of one un-editable name.
    # The same reason keeps `fabric_protocol.fct` out: its `Placement` struct
    # collides with fabric_routing.fct's (also tried in a scratch file), so
    # the four protocol types `build_messages` emits (NodeRegistration,
    # NodeHeartbeat, TelemetrySample, TelemetryBatch, FabricMessage) are
    # restated here as `Sim*` structs with the same fields.
    #
    # ============================================================
    # DELIBERATE SIMPLIFICATIONS — every one named, none silent
    # ============================================================
    # 1. `Rc<RefCell<ClusterState>>` shared between Simulation and
    #    SimExecutor -> the world is passed INTO every executor proc as a
    #    `ClusterState` argument and handed BACK in the result struct. A
    #    driver keeps one value and threads it; the simulator's own state is
    #    `Simulation.world`, and the drivers below always write the returned
    #    world back into the Simulation before stepping it. Aliasing made
    #    explicit, not lost.
    # 2. `&mut self` everywhere -> functional update returning the new value
    #    (this directory's convention). `node_mut`/`cell_mut`/`nodes_mut` are
    #    the private `simNodeRebuild`/`simCellRebuild` helpers plus an index
    #    write-back; procs whose Rust form mutates AND returns bundle both in
    #    an `*Outcome`/`*Result` struct (base's `AppendOutcome` convention).
    # 3. BTreeMap/BTreeSet -> sorted arrays. `nodes` sorted by id (text `<`),
    #    `cells` and `jobs` by `actionTargetLess`, `schedule` by at_ms,
    #    replica/staging sets are the sorted-unique `[text]` that
    #    fabric_controller_core.fct's `replicaTextSetInsert/Remove/Contains`
    #    already implement (reused, not restated). The telemetry batch map
    #    keyed `(node, shard_id)` is a sorted array of accumulators. The
    #    `demand: BTreeMap<String, f64>` is two parallel arrays; its
    #    iteration order only assigns per-node totals, so ordering there is
    #    irrelevant to output and insertion order is kept.
    # 4. Option -> `has`/`val` (or `hasX: bool` + `x` fields on SimJob).
    #    Enums -> text tags: Fault kinds "NodeLoss"|"NodeRecovery"|
    #    "PartitionRegion"|"HealRegion"|"HotShard" (base's own tags),
    #    NodeCondition "healthy"|"degraded"|"unreachable" (target.fct's),
    #    PlanPhase "prepare"|"transfer"|"cutover"|"cleanup" and PlanScope
    #    "coordinate" (plan.fct's), FabricMessage kinds "RegisterNode"|
    #    "Heartbeat"|"Telemetry".
    # 5. `Shard` (fabric_core's, with a grid and storage) is only ever read
    #    for `id` and `workload_domain` here, so `ClusterState.shards` holds
    #    fabric_telemetry.fct's `ObservationShard{id, workloadDomain}` — the
    #    exact shape `Observation` and `TelemetryBatch` carry — rather than a
    #    156-atom grid per shard the simulator never touches.
    #    `TopologyRegistry::place(node.id, &shard, coord, region)` reads only
    #    `shard.id`, so `topologyRegistryPlace(reg, id, shard.id, coord,
    #    region)` is the same call.
    # 6. `f64 as u64` (bytes, storage/network rates, queue depth — all
    #    non-negative) -> `floor()`; `u64::saturating_sub` -> `max(a - b,
    #    0)`; `saturating_add` -> plain `+` (never near 2^63 for real ms).
    #    `(f64).clamp(0,1)` -> fabric_telemetry.fct's `clampFloat`.
    # 7. `{:.1}` in Fault's Display -> `ctrlFloatFixed` (imported). `Display`
    #    for ActionTarget -> `actionTargetDisplay` (imported).
    # 8. Field renames forced by the grammar: `state` -> `seedState` (Rng)
    #    and `world` (ClusterState everywhere).
    # 9. `Serialize`/`Deserialize`/`Debug`/`Clone` derives are not logic;
    #    `Default for ClusterSpec` IS and is `clusterSpecDefault`.
    # Everything imported is used at its real shape: `Coordinate`/`DbmsId`/
    # `Workload`/`workloadNew` (fabric_core.fct), `TopologyRegistry`/
    # `topologyRegistryPlace`/`Placement` (fabric_routing.fct),
    # `Observation`/`ObservationShard`/`WorkloadMetrics`/`observationNew`/
    # `workloadMetricsTotalOperations`/`clampFloat`/`WorkloadAnalyzer`/
    # `WorkloadProfile` (fabric_telemetry.fct), `OptimizationAction`/
    # `OptimizationDecision`/`WorkloadOptimizer` (fabric_optimizer.fct),
    # `ActionTarget`/`NodeStatus`/`FleetView`/`ControlPlaneView`
    # (fabric_controller_target.fct), `PlanRequest`/`PlacementPlan`/
    # `PlanError`/`PhaseProgress`/`ExecutionFault`/`RollbackOutcome`
    # (fabric_controller_plan.fct), and the whole controller surface named
    # above (fabric_controller_core.fct). Nothing is redeclared.

    # ============================================================
    # rng.rs — SplitMix64 (restated from fabric_simulator_base.fct, see
    # "WHY fabric_simulator_base.fct IS NOT IMPORTED" above)
    # ============================================================
    struct SimRng:
        seedState: int

    private proc simRngNew(seed: int) -> SimRng:
        let golden = -7046029254386353131
        return SimRng{seedState: seed ^ golden}

    private proc simShiftRightLogical64(z: int, n: int) -> int:
        if n <= 0:
            return z
        let shifted = z >> n
        let mask = (1 << (64 - n)) - 1
        return shifted & mask

    struct SimRngU64Outcome:
        rng: SimRng
        value: int

    private proc simRngNextU64(r: SimRng) -> SimRngU64Outcome:
        let golden = -7046029254386353131
        let mulA = -4658895280553007687
        let mulB = -7723592293110705685
        let newState = r.seedState + golden
        let shift1 = do simShiftRightLogical64(newState, 30)
        let mixed1 = newState ^ shift1
        let z1 = mixed1 * mulA
        let shift2 = do simShiftRightLogical64(z1, 27)
        let mixed2 = z1 ^ shift2
        let z2 = mixed2 * mulB
        let shift3 = do simShiftRightLogical64(z2, 31)
        let result = z2 ^ shift3
        return SimRngU64Outcome{rng: SimRng{seedState: newState}, value: result}

    struct SimRngF64Outcome:
        rng: SimRng
        value: float

    private proc simRngNextF64(r: SimRng) -> SimRngF64Outcome:
        let drawn = do simRngNextU64(r)
        let shifted = do simShiftRightLogical64(drawn.value, 11)
        let asFloat = toFloat(shifted)
        let scale = 1.0 / 9007199254740992.0
        let value = asFloat * scale
        return SimRngF64Outcome{rng: drawn.rng, value: value}

    private proc simRngRange(r: SimRng, low: float, high: float) -> SimRngF64Outcome:
        let drawn = do simRngNextF64(r)
        let width = high - low
        let scaled = width * drawn.value
        let value = low + scaled
        return SimRngF64Outcome{rng: drawn.rng, value: value}

    private proc simPow2ModN(exp: int, n: int) -> int:
        let mut result = 1 % n
        let mut i = 0
        loop i < exp:
            result = (result * 2) % n
            i = i + 1
        return result

    private proc simUnsignedMod64(x: int, n: int) -> int:
        if x >= 0:
            return x % n
        let wraparound = do simPow2ModN(64, n)
        let mut combined = (x % n) + wraparound
        if combined < 0:
            combined = combined + n
        return combined

    private proc simRngBelow(r: SimRng, n: int) -> SimRngU64Outcome:
        if n == 0:
            return SimRngU64Outcome{rng: r, value: 0}
        let drawn = do simRngNextU64(r)
        let idx = do simUnsignedMod64(drawn.value, n)
        return SimRngU64Outcome{rng: drawn.rng, value: idx}

    struct SimRngForkOutcome:
        rng: SimRng
        forked: SimRng

    private proc simRngFork(r: SimRng) -> SimRngForkOutcome:
        let drawn = do simRngNextU64(r)
        let child = do simRngNew(drawn.value)
        return SimRngForkOutcome{rng: drawn.rng, forked: child}

    # ============================================================
    # clock.rs — SimClock (restated, see above)
    # ============================================================
    struct SimClock:
        startMs: int
        tickMs: int
        ticks: int

    private proc simClockNew(startMs: int, tickMs: int) -> SimClock:
        let mut clampedTickMs = tickMs
        if clampedTickMs < 1:
            clampedTickMs = 1
        return SimClock{startMs: startMs, tickMs: clampedTickMs, ticks: 0}

    private proc simClockNowMs(c: SimClock) -> int:
        return c.startMs + c.ticks * c.tickMs

    struct SimClockAdvanceOutcome:
        clock: SimClock
        nowMs: int

    private proc simClockAdvance(c: SimClock) -> SimClockAdvanceOutcome:
        let advanced = SimClock{startMs: c.startMs, tickMs: c.tickMs, ticks: c.ticks + 1}
        let now = do simClockNowMs(advanced)
        return SimClockAdvanceOutcome{clock: advanced, nowMs: now}

    # ============================================================
    # fault.rs — Fault (restated, see above). Constructors and label/Display
    # are public because a Simulation caller has to build one.
    # ============================================================
    struct SimFault:
        kind: text
        node: DbmsId
        region: text
        target: ActionTarget
        multiplier: float
        durationMs: int

    proc simFaultNodeLoss(node: DbmsId) -> SimFault:
        return SimFault{kind: "NodeLoss", node: node, region: "", target: ActionTarget{shardId: 0, coordinate: Coordinate{x: 0, y: 0}}, multiplier: 0.0, durationMs: 0}

    proc simFaultNodeRecovery(node: DbmsId) -> SimFault:
        return SimFault{kind: "NodeRecovery", node: node, region: "", target: ActionTarget{shardId: 0, coordinate: Coordinate{x: 0, y: 0}}, multiplier: 0.0, durationMs: 0}

    proc simFaultPartitionRegion(region: text) -> SimFault:
        return SimFault{kind: "PartitionRegion", node: DbmsId{value: ""}, region: region, target: ActionTarget{shardId: 0, coordinate: Coordinate{x: 0, y: 0}}, multiplier: 0.0, durationMs: 0}

    proc simFaultHealRegion(region: text) -> SimFault:
        return SimFault{kind: "HealRegion", node: DbmsId{value: ""}, region: region, target: ActionTarget{shardId: 0, coordinate: Coordinate{x: 0, y: 0}}, multiplier: 0.0, durationMs: 0}

    proc simFaultHotShard(target: ActionTarget, multiplier: float, durationMs: int) -> SimFault:
        return SimFault{kind: "HotShard", node: DbmsId{value: ""}, region: "", target: target, multiplier: multiplier, durationMs: durationMs}

    proc simFaultLabel(f: SimFault) -> text:
        if f.kind == "NodeLoss":
            return "node-loss"
        if f.kind == "NodeRecovery":
            return "node-recovery"
        if f.kind == "PartitionRegion":
            return "partition"
        if f.kind == "HealRegion":
            return "heal"
        return "hot-shard"

    proc simFaultDisplay(f: SimFault) -> text:
        if f.kind == "NodeLoss":
            return "node '" + f.node.value + "' lost"
        if f.kind == "NodeRecovery":
            return "node '" + f.node.value + "' recovered"
        if f.kind == "PartitionRegion":
            return "region '" + f.region + "' partitioned from the Fabric"
        if f.kind == "HealRegion":
            return "region '" + f.region + "' rejoined the Fabric"
        let targetText = do actionTargetDisplay(f.target)
        let multiplierText = do ctrlFloatFixed(f.multiplier, 1)
        return targetText + " running " + multiplierText + "x for " + f.durationMs + "ms"

    # ============================================================
    # workload.rs — ClassProfile, class_profile, diurnal (restated, see above)
    # ============================================================
    struct SimClassProfile:
        baseOps: float
        readRatio: float
        readLatencyUs: float
        writeLatencyUs: float
        bytesPerOp: int

    private proc simClassProfile(class: text) -> SimClassProfile:
        if class == "ReadHeavy":
            return SimClassProfile{baseOps: 800.0, readRatio: 0.92, readLatencyUs: 400.0, writeLatencyUs: 1200.0, bytesPerOp: 512}
        if class == "WriteHeavy":
            return SimClassProfile{baseOps: 400.0, readRatio: 0.15, readLatencyUs: 900.0, writeLatencyUs: 2500.0, bytesPerOp: 1024}
        if class == "Mixed":
            return SimClassProfile{baseOps: 500.0, readRatio: 0.55, readLatencyUs: 600.0, writeLatencyUs: 1500.0, bytesPerOp: 768}
        if class == "EventHeavy":
            return SimClassProfile{baseOps: 1200.0, readRatio: 0.35, readLatencyUs: 300.0, writeLatencyUs: 800.0, bytesPerOp: 256}
        if class == "Media":
            return SimClassProfile{baseOps: 150.0, readRatio: 0.85, readLatencyUs: 2500.0, writeLatencyUs: 9000.0, bytesPerOp: 65536}
        if class == "Realtime":
            return SimClassProfile{baseOps: 2000.0, readRatio: 0.60, readLatencyUs: 150.0, writeLatencyUs: 400.0, bytesPerOp: 128}
        return SimClassProfile{baseOps: 100.0, readRatio: 0.50, readLatencyUs: 1000.0, writeLatencyUs: 1000.0, bytesPerOp: 512}

    private proc simDiurnal(nowMs: int, periodMs: int, offsetMs: int) -> float:
        let mut period = periodMs
        if period < 1:
            period = 1
        let position = (nowMs + offsetMs) % period
        let phase = toFloat(position) / toFloat(period)
        let raw = 2.0 * phase - 1.0
        let triangle = 1.0 - abs(raw)
        return 0.6 + 0.8 * triangle

    # ============================================================
    # cluster.rs — ClusterSpec: how to build a cluster. `Default` is
    # `clusterSpecDefault`, every literal copied from the real impl.
    # ============================================================
    struct ClusterSpec:
        seed: int
        tickMs: int
        startMs: int
        regions: [text]
        nodesPerRegion: int
        shardsPerNode: int
        cellsPerShard: int
        placementCapacity: int
        nodeCapacityOps: float
        classes: [text]
        transferBytesPerMs: int
        diurnalPeriodMs: int

    proc clusterSpecDefault() -> ClusterSpec:
        return ClusterSpec{seed: 1, tickMs: 1000, startMs: 1700000000000, regions: ["us-east", "us-west"], nodesPerRegion: 2, shardsPerNode: 1, cellsPerShard: 6, placementCapacity: 12, nodeCapacityOps: 4000.0, classes: ["ReadHeavy", "WriteHeavy", "Mixed", "EventHeavy", "Realtime"], transferBytesPerMs: 100000, diurnalPeriodMs: 600000}

    proc clusterSpecWithSeed(spec: ClusterSpec, seed: int) -> ClusterSpec:
        return ClusterSpec{seed: seed, tickMs: spec.tickMs, startMs: spec.startMs, regions: spec.regions, nodesPerRegion: spec.nodesPerRegion, shardsPerNode: spec.shardsPerNode, cellsPerShard: spec.cellsPerShard, placementCapacity: spec.placementCapacity, nodeCapacityOps: spec.nodeCapacityOps, classes: spec.classes, transferBytesPerMs: spec.transferBytesPerMs, diurnalPeriodMs: spec.diurnalPeriodMs}

    proc clusterSpecNodeCount(spec: ClusterSpec) -> int:
        return len(spec.regions) * spec.nodesPerRegion

    # SimNode: one simulated FacetQL instance. `online` is whether the
    # process runs; `reachable` whether the Fabric can hear it.
    struct SimNode:
        id: DbmsId
        region: text
        online: bool
        reachable: bool
        placementCapacity: int
        capacityOps: float
        servedOps: float
        cpuUtilization: float
        memoryUtilization: float
        queueDepth: int

    proc simNodeNew(id: DbmsId, region: text, placementCapacity: int, capacityOps: float) -> SimNode:
        return SimNode{id: id, region: region, online: true, reachable: true, placementCapacity: placementCapacity, capacityOps: capacityOps, servedOps: 0.0, cpuUtilization: 0.0, memoryUtilization: 0.0, queueDepth: 0}

    # simNodeRebuild: the `&mut SimNode` write-back (simplification 2).
    private proc simNodeRebuild(n: SimNode, online: bool, reachable: bool, servedOps: float, cpuUtilization: float, memoryUtilization: float, queueDepth: int) -> SimNode:
        return SimNode{id: n.id, region: n.region, online: online, reachable: reachable, placementCapacity: n.placementCapacity, capacityOps: n.capacityOps, servedOps: servedOps, cpuUtilization: cpuUtilization, memoryUtilization: memoryUtilization, queueDepth: queueDepth}

    # simNodeCondition: `SimNode::condition` — offline or partitioned are
    # both Unreachable ("silence is silence"); cpu >= 0.95 is Degraded.
    proc simNodeCondition(n: SimNode) -> text:
        if !n.online || !n.reachable:
            return "unreachable"
        if n.cpuUtilization >= 0.95:
            return "degraded"
        return "healthy"

    # SimCell: one placed logical cell and its workload. `replicas` and
    # `staging` are sorted-unique `[text]` sets (simplification 3).
    struct SimCell:
        target: ActionTarget
        workload: Workload
        owner: text
        replicas: [text]
        staging: [text]
        scale: float
        bytes: int
        hotMultiplier: float
        hotUntilMs: int
        phaseOffsetMs: int

    private proc simCellRebuild(c: SimCell, owner: text, replicas: [text], staging: [text], hotMultiplier: float, hotUntilMs: int) -> SimCell:
        return SimCell{target: c.target, workload: c.workload, owner: owner, replicas: replicas, staging: staging, scale: c.scale, bytes: c.bytes, hotMultiplier: hotMultiplier, hotUntilMs: hotUntilMs, phaseOffsetMs: c.phaseOffsetMs}

    proc simCellClass(c: SimCell) -> text:
        return c.workload.class

    proc simCellProfile(c: SimCell) -> SimClassProfile:
        let profile = do simClassProfile(c.workload.class)
        return profile

    # simCellHolders: owner first, then every replica that is not the owner,
    # in id order (the set is already sorted).
    proc simCellHolders(c: SimCell) -> [text]:
        let mut holders = [c.owner]
        let n = len(c.replicas)
        let mut i = 0
        loop i < n:
            if c.replicas[i] != c.owner:
                holders = append(holders, c.replicas[i])
            i = i + 1
        return holders

    proc simCellOccupies(c: SimCell, node: text) -> bool:
        if c.owner == node:
            return true
        let inReplicas = do replicaTextSetContains(c.replicas, node)
        if inReplicas:
            return true
        let inStaging = do replicaTextSetContains(c.staging, node)
        return inStaging

    # ClusterState: the mutable world (simplification 3 for the three maps;
    # simplification 5 for `shards`).
    struct ClusterState:
        nodes: [SimNode]
        cells: [SimCell]
        shards: [ObservationShard]
        generation: int
        transferBytesPerMs: int

    # simNodeArrayInsertSorted: `BTreeMap<String, SimNode>::insert` — keyed
    # by id, overwriting an equal key, ascending text order.
    private proc simNodeArrayInsertSorted(nodes: [SimNode], node: SimNode) -> [SimNode]:
        let n = len(nodes)
        let mut result = []
        let mut inserted = false
        let mut i = 0
        loop i < n:
            if !inserted && node.id.value < nodes[i].id.value:
                result = append(result, node)
                inserted = true
            if nodes[i].id.value == node.id.value:
                if !inserted:
                    result = append(result, node)
                    inserted = true
            else:
                result = append(result, nodes[i])
            i = i + 1
        if !inserted:
            result = append(result, node)
        return result

    # simCellArrayInsertSorted: `BTreeMap<ActionTarget, SimCell>::insert`.
    private proc simCellArrayInsertSorted(cells: [SimCell], cell: SimCell) -> [SimCell]:
        let n = len(cells)
        let mut result = []
        let mut inserted = false
        let mut i = 0
        loop i < n:
            let less = do actionTargetLess(cell.target, cells[i].target)
            let same = do actionTargetEquals(cell.target, cells[i].target)
            if !inserted && less:
                result = append(result, cell)
                inserted = true
            if same:
                if !inserted:
                    result = append(result, cell)
                    inserted = true
            else:
                result = append(result, cells[i])
            i = i + 1
        if !inserted:
            result = append(result, cell)
        return result

    # clusterStateBuild: `ClusterState::build` — every draw from
    # `Rng::new(spec.seed)` in the real loop order (class, scale, phase
    # offset per cell; regions -> nodes -> shards -> cells), so the port is
    # reproducible down to which class landed on which cell.
    proc clusterStateBuild(spec: ClusterSpec) -> ClusterState:
        let rng0 = do simRngNew(spec.seed)
        let mut rng = rng0
        let mut nodes = []
        let mut cells = []
        let mut shards = []
        let cellsPerShard = min(spec.cellsPerShard, 156)
        let mut shardId = 1
        let mut workloadId = 1
        let classCount = len(spec.classes)
        let regionCount = len(spec.regions)
        let mut r = 0
        loop r < regionCount:
            let region = spec.regions[r]
            let mut index = 0
            loop index < spec.nodesPerRegion:
                let id = do dbmsIdNew(region + "-db-" + index)
                let node = do simNodeNew(id, region, spec.placementCapacity, spec.nodeCapacityOps)
                let grownNodes = do simNodeArrayInsertSorted(nodes, node)
                nodes = grownNodes
                let mut s = 0
                loop s < spec.shardsPerNode:
                    let mut cellIndex = 0
                    loop cellIndex < cellsPerShard:
                        let coordinate = Coordinate{x: cellIndex % 12, y: cellIndex / 12}
                        let drawnClass = do simRngBelow(rng, max(classCount, 1))
                        rng = drawnClass.rng
                        let classIdx = min(drawnClass.value, max(classCount - 1, 0))
                        let class = spec.classes[classIdx]
                        let drawnScale = do simRngRange(rng, 0.5, 1.5)
                        rng = drawnScale.rng
                        let scale = drawnScale.value
                        let profile = do simClassProfile(class)
                        let bytes = floor(toFloat(profile.bytesPerOp) * profile.baseOps * scale * 4.0)
                        let drawnOffset = do simRngBelow(rng, max(spec.diurnalPeriodMs, 1))
                        rng = drawnOffset.rng
                        let target = do actionTargetNew(shardId, coordinate)
                        let workload = do workloadNew(workloadId, class)
                        let cell = SimCell{target: target, workload: workload, owner: id.value, replicas: [], staging: [], scale: scale, bytes: bytes, hotMultiplier: 1.0, hotUntilMs: 0, phaseOffsetMs: drawnOffset.value}
                        let grownCells = do simCellArrayInsertSorted(cells, cell)
                        cells = grownCells
                        workloadId = workloadId + 1
                        cellIndex = cellIndex + 1
                    shards = append(shards, ObservationShard{id: shardId, workloadDomain: region})
                    shardId = shardId + 1
                    s = s + 1
                index = index + 1
            r = r + 1
        return ClusterState{nodes: nodes, cells: cells, shards: shards, generation: 1, transferBytesPerMs: max(spec.transferBytesPerMs, 1)}

    proc clusterStateGeneration(world: ClusterState) -> int:
        return world.generation

    proc clusterStateTransferBytesPerMs(world: ClusterState) -> int:
        return world.transferBytesPerMs

    proc clusterStateNodeIndexOf(nodes: [SimNode], id: text) -> int:
        let n = len(nodes)
        let mut i = 0
        loop i < n:
            if nodes[i].id.value == id:
                return i
            i = i + 1
        return -1

    struct SimNodeOption:
        has: bool
        val: SimNode

    proc clusterStateNode(world: ClusterState, id: text) -> SimNodeOption:
        let idx = do clusterStateNodeIndexOf(world.nodes, id)
        if idx == -1:
            let zero = do simNodeNew(DbmsId{value: ""}, "", 0, 0.0)
            return SimNodeOption{has: false, val: zero}
        return SimNodeOption{has: true, val: world.nodes[idx]}

    proc clusterStateCellIndexOf(cells: [SimCell], target: ActionTarget) -> int:
        let n = len(cells)
        let mut i = 0
        loop i < n:
            let same = do actionTargetEquals(cells[i].target, target)
            if same:
                return i
            i = i + 1
        return -1

    struct SimCellOption:
        has: bool
        val: SimCell

    private proc simCellZero() -> SimCell:
        let workload = do workloadNew(0, "Unknown")
        return SimCell{target: ActionTarget{shardId: 0, coordinate: Coordinate{x: 0, y: 0}}, workload: workload, owner: "", replicas: [], staging: [], scale: 0.0, bytes: 0, hotMultiplier: 1.0, hotUntilMs: 0, phaseOffsetMs: 0}

    proc clusterStateCell(world: ClusterState, target: ActionTarget) -> SimCellOption:
        let idx = do clusterStateCellIndexOf(world.cells, target)
        if idx == -1:
            let zero = do simCellZero()
            return SimCellOption{has: false, val: zero}
        return SimCellOption{has: true, val: world.cells[idx]}

    proc clusterStateShardIndexOf(shards: [ObservationShard], shardId: int) -> int:
        let n = len(shards)
        let mut i = 0
        loop i < n:
            if shards[i].id == shardId:
                return i
            i = i + 1
        return -1

    struct ObservationShardOption:
        has: bool
        val: ObservationShard

    proc clusterStateShard(world: ClusterState, shardId: int) -> ObservationShardOption:
        let idx = do clusterStateShardIndexOf(world.shards, shardId)
        if idx == -1:
            return ObservationShardOption{has: false, val: ObservationShard{id: 0, workloadDomain: ""}}
        return ObservationShardOption{has: true, val: world.shards[idx]}

    # clusterStateHostedPlacements: placements a node holds, staged copies
    # included.
    proc clusterStateHostedPlacements(world: ClusterState, node: text) -> int:
        let n = len(world.cells)
        let mut count = 0
        let mut i = 0
        loop i < n:
            let occupies = do simCellOccupies(world.cells[i], node)
            if occupies:
                count = count + 1
            i = i + 1
        return count

    private proc clusterStateWithCells(world: ClusterState, cells: [SimCell]) -> ClusterState:
        return ClusterState{nodes: world.nodes, cells: cells, shards: world.shards, generation: world.generation, transferBytesPerMs: world.transferBytesPerMs}

    private proc clusterStateWithNodes(world: ClusterState, nodes: [SimNode]) -> ClusterState:
        return ClusterState{nodes: nodes, cells: world.cells, shards: world.shards, generation: world.generation, transferBytesPerMs: world.transferBytesPerMs}

    # clusterStateStage: capacity is consumed, traffic is not served.
    proc clusterStateStage(world: ClusterState, target: ActionTarget, node: text) -> ClusterState:
        let idx = do clusterStateCellIndexOf(world.cells, target)
        if idx == -1:
            return world
        let cell = world.cells[idx]
        let staging = do replicaTextSetInsert(cell.staging, node)
        let rebuilt = do simCellRebuild(cell, cell.owner, cell.replicas, staging, cell.hotMultiplier, cell.hotUntilMs)
        let mut cells = world.cells
        cells[idx] = rebuilt
        let updated = do clusterStateWithCells(world, cells)
        return updated

    proc clusterStateUnstage(world: ClusterState, target: ActionTarget, node: text) -> ClusterState:
        let idx = do clusterStateCellIndexOf(world.cells, target)
        if idx == -1:
            return world
        let cell = world.cells[idx]
        let staging = do replicaTextSetRemove(cell.staging, node)
        let rebuilt = do simCellRebuild(cell, cell.owner, cell.replicas, staging, cell.hotMultiplier, cell.hotUntilMs)
        let mut cells = world.cells
        cells[idx] = rebuilt
        let updated = do clusterStateWithCells(world, cells)
        return updated

    # clusterStatePromote: a staged copy becomes a live replica.
    proc clusterStatePromote(world: ClusterState, target: ActionTarget, node: text) -> ClusterState:
        let idx = do clusterStateCellIndexOf(world.cells, target)
        if idx == -1:
            return world
        let cell = world.cells[idx]
        let staging = do replicaTextSetRemove(cell.staging, node)
        let replicas = do replicaTextSetInsert(cell.replicas, node)
        let rebuilt = do simCellRebuild(cell, cell.owner, replicas, staging, cell.hotMultiplier, cell.hotUntilMs)
        let mut cells = world.cells
        cells[idx] = rebuilt
        let updated = do clusterStateWithCells(world, cells)
        return updated

    struct ClusterStateSetOwnerResult:
        changed: bool
        world: ClusterState

    # clusterStateSetOwner: move authority — the only operation that changes
    # the placement map, so the only one that bumps the generation. The
    # previous owner becomes a replica; the new owner leaves staging and
    # replicas.
    proc clusterStateSetOwner(world: ClusterState, target: ActionTarget, node: text) -> ClusterStateSetOwnerResult:
        let idx = do clusterStateCellIndexOf(world.cells, target)
        if idx == -1:
            return ClusterStateSetOwnerResult{changed: false, world: world}
        let cell = world.cells[idx]
        if cell.owner == node:
            return ClusterStateSetOwnerResult{changed: false, world: world}
        let previous = cell.owner
        let staging = do replicaTextSetRemove(cell.staging, node)
        let replicasLess = do replicaTextSetRemove(cell.replicas, node)
        let replicas = do replicaTextSetInsert(replicasLess, previous)
        let rebuilt = do simCellRebuild(cell, node, replicas, staging, cell.hotMultiplier, cell.hotUntilMs)
        let mut cells = world.cells
        cells[idx] = rebuilt
        return ClusterStateSetOwnerResult{changed: true, world: ClusterState{nodes: world.nodes, cells: cells, shards: world.shards, generation: world.generation + 1, transferBytesPerMs: world.transferBytesPerMs}}

    # clusterStateDropCopy: the owner is never dropped this way.
    proc clusterStateDropCopy(world: ClusterState, target: ActionTarget, node: text) -> ClusterState:
        let idx = do clusterStateCellIndexOf(world.cells, target)
        if idx == -1:
            return world
        let cell = world.cells[idx]
        let staging = do replicaTextSetRemove(cell.staging, node)
        let mut replicas = cell.replicas
        if cell.owner != node:
            let removed = do replicaTextSetRemove(cell.replicas, node)
            replicas = removed
        let rebuilt = do simCellRebuild(cell, cell.owner, replicas, staging, cell.hotMultiplier, cell.hotUntilMs)
        let mut cells = world.cells
        cells[idx] = rebuilt
        let updated = do clusterStateWithCells(world, cells)
        return updated

    # clusterStateTopology: the placement map as the Fabric would hold it
    # (simplification 5 for the shard argument).
    proc clusterStateTopology(world: ClusterState) -> TopologyRegistry:
        let empty = do topologyRegistryNew()
        let mut topology = empty
        let n = len(world.cells)
        let mut i = 0
        loop i < n:
            let cell = world.cells[i]
            let shardIdx = do clusterStateShardIndexOf(world.shards, cell.target.shardId)
            let nodeIdx = do clusterStateNodeIndexOf(world.nodes, cell.owner)
            if shardIdx != -1 && nodeIdx != -1:
                let node = world.nodes[nodeIdx]
                let placed = do topologyRegistryPlace(topology, node.id.value, world.shards[shardIdx].id, cell.target.coordinate, node.region)
                topology = placed
            i = i + 1
        return topology

    # clusterStateFleetView: the fleet as the controller would see it.
    proc clusterStateFleetView(world: ClusterState) -> FleetView:
        let empty = do fleetViewNew(world.generation)
        let mut fleet = empty
        let n = len(world.nodes)
        let mut i = 0
        loop i < n:
            let node = world.nodes[i]
            let condition = do simNodeCondition(node)
            let base = do nodeStatusNew(node.id, node.region, condition, node.placementCapacity)
            let hosted = do clusterStateHostedPlacements(world, node.id.value)
            let loaded = do nodeStatusWithLoad(base, hosted, node.cpuUtilization, node.memoryUtilization)
            let inserted = do fleetViewInsert(fleet, loaded)
            fleet = inserted
            i = i + 1
        return fleet

    # clusterStateLeastLoadedNode: the least-loaded healthy node with
    # headroom, other than `exclude`, by cpu then by id (the array is in id
    # order and a tie keeps the earlier node: `best_load <= load` skips).
    proc clusterStateLeastLoadedNode(world: ClusterState, exclude: [text]) -> DbmsIdOption:
        let n = len(world.nodes)
        let mut hasBest = false
        let mut bestId = DbmsId{value: ""}
        let mut bestLoad = 0.0
        let mut i = 0
        loop i < n:
            let node = world.nodes[i]
            let excluded = do replicaTextSetContains(exclude, node.id.value)
            let mut skip = excluded
            if !skip:
                let condition = do simNodeCondition(node)
                if condition != "healthy":
                    skip = true
            if !skip:
                let hosted = do clusterStateHostedPlacements(world, node.id.value)
                if hosted >= node.placementCapacity:
                    skip = true
            if !skip:
                let load = node.cpuUtilization
                if !hasBest || load < bestLoad:
                    hasBest = true
                    bestId = node.id
                    bestLoad = load
            i = i + 1
        return DbmsIdOption{has: hasBest, val: bestId}

    # ============================================================
    # executor.rs — SimExecutor: a `PlacementExecutor` backed by the
    # simulated cluster. The world is threaded explicitly (simplification 1).
    # PREPARE_MS = 2000, CUTOVER_MS = 0, CLEANUP_MS = 1000.
    # ============================================================
    struct SimJob:
        target: ActionTarget
        hasDestination: bool
        destination: text
        hasPhase: bool
        phase: text
        phaseStartedAtMs: int
        cutOver: bool

    private proc simJobNew(target: ActionTarget) -> SimJob:
        return SimJob{target: target, hasDestination: false, destination: "", hasPhase: false, phase: "", phaseStartedAtMs: 0, cutOver: false}

    struct SimExecutor:
        jobs: [SimJob]

    proc simExecutorNew() -> SimExecutor:
        return SimExecutor{jobs: []}

    proc simExecutorName(ex: SimExecutor) -> text:
        return "simulated-placement"

    # simExecutorSupports: Replicate | Move | Isolate | Colocate. Split is
    # declined rather than faked; NoAction is nothing to execute.
    proc simExecutorSupports(ex: SimExecutor, action: OptimizationAction) -> bool:
        let kind = action.kind
        return kind == "Replicate" || kind == "Move" || kind == "Isolate" || kind == "Colocate"

    private proc simJobIndexOf(jobs: [SimJob], target: ActionTarget) -> int:
        let n = len(jobs)
        let mut i = 0
        loop i < n:
            let same = do actionTargetEquals(jobs[i].target, target)
            if same:
                return i
            i = i + 1
        return -1

    # simJobArrayInsertSorted: `BTreeMap<ActionTarget, SimJob>::insert`.
    private proc simJobArrayInsertSorted(jobs: [SimJob], job: SimJob) -> [SimJob]:
        let n = len(jobs)
        let mut result = []
        let mut inserted = false
        let mut i = 0
        loop i < n:
            let less = do actionTargetLess(job.target, jobs[i].target)
            let same = do actionTargetEquals(job.target, jobs[i].target)
            if !inserted && less:
                result = append(result, job)
                inserted = true
            if same:
                if !inserted:
                    result = append(result, job)
                    inserted = true
            else:
                result = append(result, jobs[i])
            i = i + 1
        if !inserted:
            result = append(result, job)
        return result

    private proc simJobArrayRemoveAt(jobs: [SimJob], idx: int) -> [SimJob]:
        let n = len(jobs)
        let mut result = []
        let mut i = 0
        loop i < n:
            if i != idx:
                result = append(result, jobs[i])
            i = i + 1
        return result

    # simExecutorPhaseDurationMs: `phase_duration_ms` — Prepare 2000,
    # Transfer `max(bytes / max(rate, 1), 1)`, Cutover 0, Cleanup 1000.
    private proc simExecutorPhaseDurationMs(world: ClusterState, plan: PlacementPlan, phase: text) -> int:
        if phase == "prepare":
            return 2000
        if phase == "transfer":
            let rate = max(world.transferBytesPerMs, 1)
            return max(plan.estimatedBytes / rate, 1)
        if phase == "cutover":
            return 0
        return 1000

    struct SimExecutionFaultOption:
        has: bool
        fault: ExecutionFault

    # simExecutorCheckDestination: a destination that stopped being usable
    # (missing or offline) is a `DestinationLost` fault, not something to
    # wait on. No destination -> Ok.
    private proc simExecutorCheckDestination(world: ClusterState, hasDestination: bool, destination: text) -> SimExecutionFaultOption:
        let noFault = do executionFaultInternal("")
        if !hasDestination:
            return SimExecutionFaultOption{has: false, fault: noFault}
        let node = do clusterStateNode(world, destination)
        if node.has && node.val.online:
            return SimExecutionFaultOption{has: false, fault: noFault}
        let lost = do executionFaultDestinationLost(DbmsId{value: destination})
        return SimExecutionFaultOption{has: true, fault: lost}

    struct SimExecutorWorldUpdate:
        executor: SimExecutor
        world: ClusterState

    # simExecutorApplyCompletion: `apply_completion` — no job, nothing.
    # Cutover: with a destination, `set_owner` if the plan removes the
    # current owner, else `promote`; the job is marked cut over either way.
    # Cleanup: `drop_copy` for every removed node.
    private proc simExecutorApplyCompletion(ex: SimExecutor, world: ClusterState, plan: PlacementPlan, phase: text) -> SimExecutorWorldUpdate:
        let idx = do simJobIndexOf(ex.jobs, plan.target)
        if idx == -1:
            return SimExecutorWorldUpdate{executor: ex, world: world}
        let job = ex.jobs[idx]
        let mut next = world
        let mut jobs = ex.jobs
        if phase == "cutover":
            if job.hasDestination:
                let cell = do clusterStateCell(world, plan.target)
                let mut ownerIsLeaving = false
                if cell.has:
                    let m = len(plan.removes)
                    let mut i = 0
                    loop i < m:
                        if plan.removes[i].value == cell.val.owner:
                            ownerIsLeaving = true
                        i = i + 1
                if ownerIsLeaving:
                    let moved = do clusterStateSetOwner(world, plan.target, job.destination)
                    next = moved.world
                else:
                    let promoted = do clusterStatePromote(world, plan.target, job.destination)
                    next = promoted
            jobs[idx] = SimJob{target: job.target, hasDestination: job.hasDestination, destination: job.destination, hasPhase: job.hasPhase, phase: job.phase, phaseStartedAtMs: job.phaseStartedAtMs, cutOver: true}
        if phase == "cleanup":
            let m = len(plan.removes)
            let mut i = 0
            loop i < m:
                let dropped = do clusterStateDropCopy(next, plan.target, plan.removes[i].value)
                next = dropped
                i = i + 1
        return SimExecutorWorldUpdate{executor: SimExecutor{jobs: jobs}, world: next}

    # simExecutorPlan: `plan` — the cell must exist; Replicate/Move/Colocate
    # need the named destination; Isolate picks the least-loaded node not
    # already holding or staging a copy; anything else is UnsupportedAction.
    # Replicate is Prepare/Transfer/Cutover with no removes; the rest add
    # Cleanup and remove the source. Estimate = bytes and 2000 + transfer
    # (+ 1000 unless replicating).
    proc simExecutorPlan(ex: SimExecutor, world: ClusterState, request: PlanRequest) -> PlacementPlanNewResult:
        let zero = do placementPlanZero()
        let cell = do clusterStateCell(world, request.target)
        if !cell.has:
            let targetText = do actionTargetDisplay(request.target)
            let missing = do planErrorInfeasible(targetText + " does not exist")
            return PlacementPlanNewResult{ok: false, value: zero, err: missing}
        let kind = request.action.kind
        let mut destination = ""
        if kind == "Replicate" || kind == "Move" || kind == "Colocate":
            if !request.hasDestination:
                let noDest = do planErrorInfeasible("action names no destination")
                return PlacementPlanNewResult{ok: false, value: zero, err: noDest}
            destination = request.destination.value
        else:
            if kind == "Isolate":
                let holders = do simCellHolders(cell.val)
                let mut exclude = holders
                let m = len(cell.val.staging)
                let mut i = 0
                loop i < m:
                    exclude = append(exclude, cell.val.staging[i])
                    i = i + 1
                let chosen = do clusterStateLeastLoadedNode(world, exclude)
                if !chosen.has:
                    let nowhere = do planErrorInfeasible("no healthy node with headroom to isolate onto")
                    return PlacementPlanNewResult{ok: false, value: zero, err: nowhere}
                destination = chosen.val.value
            else:
                let label = do controllerPlanActionLabel(request.action)
                let unsupported = do planErrorUnsupportedAction(label)
                return PlacementPlanNewResult{ok: false, value: zero, err: unsupported}
        let replicating = kind == "Replicate"
        let mut phases = ["prepare", "transfer", "cutover"]
        let mut removes = []
        if !replicating:
            phases = ["prepare", "transfer", "cutover", "cleanup"]
            removes = [DbmsId{value: request.source.dbmsId}]
        let bytes = cell.val.bytes
        let transferMs = max(bytes / max(world.transferBytesPerMs, 1), 1)
        let mut durationMs = 2000 + transferMs + 0
        if !replicating:
            durationMs = durationMs + 1000
        let planned = do placementPlanNew(request.target, request.action, "coordinate", phases, [DbmsId{value: destination}], removes)
        if !planned.ok:
            return planned
        let estimated = do placementPlanWithEstimate(planned.value, bytes, durationMs)
        let noErr = do planErrorEmptyPlan()
        return PlacementPlanNewResult{ok: true, value: estimated, err: noErr}

    struct SimExecutorBeginResult:
        ok: bool
        fault: ExecutionFault
        executor: SimExecutor
        world: ClusterState

    # simExecutorBeginPhase: `begin_phase` — destination = plan.adds.first();
    # a lost destination faults before the job table is touched; the job is
    # created or updated; Prepare stages the copy on the destination.
    proc simExecutorBeginPhase(ex: SimExecutor, world: ClusterState, plan: PlacementPlan, phase: text, atMs: int) -> SimExecutorBeginResult:
        let hasDestination = len(plan.adds) > 0
        let mut destination = ""
        if hasDestination:
            destination = plan.adds[0].value
        let check = do simExecutorCheckDestination(world, hasDestination, destination)
        if check.has:
            return SimExecutorBeginResult{ok: false, fault: check.fault, executor: ex, world: world}
        let idx = do simJobIndexOf(ex.jobs, plan.target)
        let mut cutOver = false
        if idx != -1:
            cutOver = ex.jobs[idx].cutOver
        let job = SimJob{target: plan.target, hasDestination: hasDestination, destination: destination, hasPhase: true, phase: phase, phaseStartedAtMs: atMs, cutOver: cutOver}
        let jobs = do simJobArrayInsertSorted(ex.jobs, job)
        let mut next = world
        if phase == "prepare" && hasDestination:
            let staged = do clusterStateStage(world, plan.target, destination)
            next = staged
        let noFault = do executionFaultInternal("")
        return SimExecutorBeginResult{ok: true, fault: noFault, executor: SimExecutor{jobs: jobs}, world: next}

    struct SimExecutorPollResult:
        ok: bool
        progress: PhaseProgress
        fault: ExecutionFault
        executor: SimExecutor
        world: ClusterState

    # simExecutorPollPhase: `poll_phase` — NotStarted unless this exact phase
    # began; a lost destination faults; Running{elapsed/duration} until the
    # phase's duration has elapsed, then the completion is applied.
    proc simExecutorPollPhase(ex: SimExecutor, world: ClusterState, plan: PlacementPlan, phase: text, atMs: int) -> SimExecutorPollResult:
        let complete = do phaseProgressComplete()
        let idx = do simJobIndexOf(ex.jobs, plan.target)
        let mut started = false
        if idx != -1:
            let found = ex.jobs[idx]
            started = found.hasPhase && found.phase == phase
        if !started:
            let notStarted = do executionFaultNotStarted(phase)
            return SimExecutorPollResult{ok: false, progress: complete, fault: notStarted, executor: ex, world: world}
        let job = ex.jobs[idx]
        let check = do simExecutorCheckDestination(world, job.hasDestination, job.destination)
        if check.has:
            return SimExecutorPollResult{ok: false, progress: complete, fault: check.fault, executor: ex, world: world}
        let durationMs = do simExecutorPhaseDurationMs(world, plan, phase)
        let elapsedMs = max(atMs - job.phaseStartedAtMs, 0)
        let noFault = do executionFaultInternal("")
        if elapsedMs < durationMs:
            let fraction = toFloat(elapsedMs) / toFloat(durationMs)
            let running = do phaseProgressRunning(fraction)
            return SimExecutorPollResult{ok: true, progress: running, fault: noFault, executor: ex, world: world}
        let applied = do simExecutorApplyCompletion(ex, world, plan, phase)
        return SimExecutorPollResult{ok: true, progress: complete, fault: noFault, executor: applied.executor, world: applied.world}

    struct SimExecutorAbortResult:
        ok: bool
        outcome: RollbackOutcome
        fault: ExecutionFault
        executor: SimExecutor
        world: ClusterState

    # simExecutorAbort: `abort` — the job is removed; cut over (per the job
    # or the completed list) with a destination is Irreversible ("authority
    # for {target} already moved to '{dest}'"); not cut over with a
    # destination unstages it and is Restored; no destination but cut over
    # is Irreversible ("{target} already cut over"); otherwise Restored.
    proc simExecutorAbort(ex: SimExecutor, world: ClusterState, plan: PlacementPlan, completed: [text], atMs: int) -> SimExecutorAbortResult:
        let noFault = do executionFaultInternal("")
        let restored = do rollbackOutcomeRestored()
        let idx = do simJobIndexOf(ex.jobs, plan.target)
        let mut jobs = ex.jobs
        let mut hasJob = false
        let emptyJob = do simJobNew(plan.target)
        let mut job = emptyJob
        if idx != -1:
            hasJob = true
            job = ex.jobs[idx]
            let removed = do simJobArrayRemoveAt(ex.jobs, idx)
            jobs = removed
        let next = SimExecutor{jobs: jobs}
        let completedCutover = do planPhaseArrayContains(completed, "cutover")
        let cutOver = (hasJob && job.cutOver) || completedCutover
        let targetText = do actionTargetDisplay(plan.target)
        if hasJob && job.hasDestination:
            if cutOver:
                let irreversible = do rollbackOutcomeIrreversible("authority for " + targetText + " already moved to '" + job.destination + "'")
                return SimExecutorAbortResult{ok: true, outcome: irreversible, fault: noFault, executor: next, world: world}
            let unstaged = do clusterStateUnstage(world, plan.target, job.destination)
            return SimExecutorAbortResult{ok: true, outcome: restored, fault: noFault, executor: next, world: unstaged}
        if cutOver:
            let alreadyCut = do rollbackOutcomeIrreversible(targetText + " already cut over")
            return SimExecutorAbortResult{ok: true, outcome: alreadyCut, fault: noFault, executor: next, world: world}
        return SimExecutorAbortResult{ok: true, outcome: restored, fault: noFault, executor: next, world: world}

    # ============================================================
    # simulation.rs — the protocol messages a tick renders to, restated
    # (see "WHY fabric_simulator_base.fct IS NOT IMPORTED": fabric_protocol
    # .fct cannot be imported here). Field for field the real structs;
    # `NodeRegistration::new` sets `protocol` to "facet/1".
    # ============================================================
    struct SimNodeRegistration:
        protocol: text
        nodeId: DbmsId
        softwareVersion: text
        region: text

    struct SimNodeHeartbeat:
        nodeId: DbmsId
        timestampMs: int
        healthy: bool

    struct SimTelemetrySample:
        coordinate: Coordinate
        operationsPerSecond: float
        readRatio: float
        writeRatio: float
        readLatencyUs: float
        writeLatencyUs: float
        cpuUtilization: float
        memoryUtilization: float
        queueDepth: int
        cellBreakdown: [CellWorkloadMetrics]
        cellBreakdownPartial: bool

    struct SimTelemetryBatch:
        timestampMs: int
        nodeId: DbmsId
        shard: ObservationShard
        samples: [SimTelemetrySample]

    # SimFabricMessage: kind "RegisterNode" | "Heartbeat" | "Telemetry"; the
    # other two real variants (TopologyReport, WorkloadObservation) are
    # never emitted by the simulator.
    struct SimFabricMessage:
        kind: text
        registerNode: SimNodeRegistration
        heartbeat: SimNodeHeartbeat
        telemetry: SimTelemetryBatch

    private proc simMessageRegisterNode(r: SimNodeRegistration) -> SimFabricMessage:
        return SimFabricMessage{kind: "RegisterNode", registerNode: r, heartbeat: SimNodeHeartbeat{nodeId: DbmsId{value: ""}, timestampMs: 0, healthy: false}, telemetry: SimTelemetryBatch{timestampMs: 0, nodeId: DbmsId{value: ""}, shard: ObservationShard{id: 0, workloadDomain: ""}, samples: []}}

    private proc simMessageHeartbeat(h: SimNodeHeartbeat) -> SimFabricMessage:
        return SimFabricMessage{kind: "Heartbeat", registerNode: SimNodeRegistration{protocol: "", nodeId: DbmsId{value: ""}, softwareVersion: "", region: ""}, heartbeat: h, telemetry: SimTelemetryBatch{timestampMs: 0, nodeId: DbmsId{value: ""}, shard: ObservationShard{id: 0, workloadDomain: ""}, samples: []}}

    private proc simMessageTelemetry(b: SimTelemetryBatch) -> SimFabricMessage:
        return SimFabricMessage{kind: "Telemetry", registerNode: SimNodeRegistration{protocol: "", nodeId: DbmsId{value: ""}, softwareVersion: "", region: ""}, heartbeat: SimNodeHeartbeat{nodeId: DbmsId{value: ""}, timestampMs: 0, healthy: false}, telemetry: b}

    # SimTick: everything one step produced. Cells on an unreachable node
    # produce nothing — silence is the observation.
    struct SimTick:
        atMs: int
        faults: [SimFault]
        observations: [Observation]
        messages: [SimFabricMessage]

    # SimCellLoad: per-cell demand for one tick, before it becomes an
    # observation.
    struct SimCellLoad:
        target: ActionTarget
        readsOnOwner: float
        writes: float

    # SimScheduledFaults: one `BTreeMap<u64, Vec<Fault>>` entry.
    struct SimScheduledFaults:
        atMs: int
        faults: [SimFault]

    # Simulation: a synthetic FacetQL fleet under a synthetic workload.
    struct Simulation:
        spec: ClusterSpec
        world: ClusterState
        clock: SimClock
        rng: SimRng
        schedule: [SimScheduledFaults]
        registered: bool

    private proc simulationRebuild(sim: Simulation, world: ClusterState, clock: SimClock, rng: SimRng, schedule: [SimScheduledFaults], registered: bool) -> Simulation:
        return Simulation{spec: sim.spec, world: world, clock: clock, rng: rng, schedule: schedule, registered: registered}

    # simulationNew: `Simulation::new` — build the world from the spec, then
    # fork the seed stream twice: the first fork (`_construction`) is
    # discarded, the second is the workload's own stream, so adding a draw
    # elsewhere cannot shift it.
    proc simulationNew(spec: ClusterSpec) -> Simulation:
        let world = do clusterStateBuild(spec)
        let seedStream = do simRngNew(spec.seed)
        let construction = do simRngFork(seedStream)
        let workload = do simRngFork(construction.rng)
        let clock = do simClockNew(spec.startMs, spec.tickMs)
        return Simulation{spec: spec, world: world, clock: clock, rng: workload.forked, schedule: [], registered: false}

    proc simulationSpec(sim: Simulation) -> ClusterSpec:
        return sim.spec

    proc simulationNowMs(sim: Simulation) -> int:
        let now = do simClockNowMs(sim.clock)
        return now

    proc simulationClock(sim: Simulation) -> SimClock:
        return sim.clock

    # simulationState: `state()` — the shared cluster (simplification 1).
    proc simulationState(sim: Simulation) -> ClusterState:
        return sim.world

    # simulationWithState: the other half of the `Rc<RefCell<_>>` — a
    # driver that let the executor edit the world hands it back here.
    proc simulationWithState(sim: Simulation, world: ClusterState) -> Simulation:
        let rebuilt = do simulationRebuild(sim, world, sim.clock, sim.rng, sim.schedule, sim.registered)
        return rebuilt

    proc simulationExecutor(sim: Simulation) -> SimExecutor:
        let ex = do simExecutorNew()
        return ex

    proc simulationTopology(sim: Simulation) -> TopologyRegistry:
        let topology = do clusterStateTopology(sim.world)
        return topology

    proc simulationFleetView(sim: Simulation) -> FleetView:
        let fleet = do clusterStateFleetView(sim.world)
        return fleet

    proc simulationGeneration(sim: Simulation) -> int:
        return sim.world.generation

    # simulationTargets: every placed cell, in target order.
    proc simulationTargets(sim: Simulation) -> [ActionTarget]:
        let n = len(sim.world.cells)
        let mut targets = []
        let mut i = 0
        loop i < n:
            targets = append(targets, sim.world.cells[i].target)
            i = i + 1
        return targets

    # simulationScheduleFault: `schedule.entry(at_ms).or_default().push(fault)`
    # on a by-at_ms sorted array.
    proc simulationScheduleFault(sim: Simulation, atMs: int, fault: SimFault) -> Simulation:
        let n = len(sim.schedule)
        let mut schedule = []
        let mut inserted = false
        let mut i = 0
        loop i < n:
            let entry = sim.schedule[i]
            if !inserted && atMs < entry.atMs:
                schedule = append(schedule, SimScheduledFaults{atMs: atMs, faults: [fault]})
                inserted = true
            if entry.atMs == atMs:
                let grown = append(entry.faults, fault)
                schedule = append(schedule, SimScheduledFaults{atMs: atMs, faults: grown})
                inserted = true
            else:
                schedule = append(schedule, entry)
            i = i + 1
        if !inserted:
            schedule = append(schedule, SimScheduledFaults{atMs: atMs, faults: [fault]})
        let rebuilt = do simulationRebuild(sim, sim.world, sim.clock, sim.rng, schedule, sim.registered)
        return rebuilt

    # simulationInject: apply a fault immediately, at the current instant.
    proc simulationInject(sim: Simulation, fault: SimFault) -> Simulation:
        let now = do simClockNowMs(sim.clock)
        let world = do simulationApplyFault(sim.world, fault, now)
        let rebuilt = do simulationRebuild(sim, world, sim.clock, sim.rng, sim.schedule, sim.registered)
        return rebuilt

    struct SimulationDueResult:
        schedule: [SimScheduledFaults]
        faults: [SimFault]

    # simulationDueFaults: every entry at or before `at_ms`, removed, in key
    # order.
    private proc simulationDueFaults(schedule: [SimScheduledFaults], atMs: int) -> SimulationDueResult:
        let n = len(schedule)
        let mut faults = []
        let mut remaining = []
        let mut i = 0
        loop i < n:
            let entry = schedule[i]
            if entry.atMs <= atMs:
                let m = len(entry.faults)
                let mut j = 0
                loop j < m:
                    faults = append(faults, entry.faults[j])
                    j = j + 1
            else:
                remaining = append(remaining, entry)
            i = i + 1
        return SimulationDueResult{schedule: remaining, faults: faults}

    # simulationApplyFault: `apply_fault` — NodeLoss zeroes the node and takes
    # it offline; NodeRecovery brings it back; Partition/Heal flip
    # `reachable` for a region; HotShard sets the cell's multiplier until
    # `at_ms + duration_ms`.
    private proc simulationApplyFault(world: ClusterState, fault: SimFault, atMs: int) -> ClusterState:
        if fault.kind == "NodeLoss" || fault.kind == "NodeRecovery":
            let idx = do clusterStateNodeIndexOf(world.nodes, fault.node.value)
            if idx == -1:
                return world
            let node = world.nodes[idx]
            let mut nodes = world.nodes
            if fault.kind == "NodeLoss":
                let lost = do simNodeRebuild(node, false, node.reachable, 0.0, 0.0, 0.0, 0)
                nodes[idx] = lost
            else:
                let back = do simNodeRebuild(node, true, node.reachable, node.servedOps, node.cpuUtilization, node.memoryUtilization, node.queueDepth)
                nodes[idx] = back
            let updated = do clusterStateWithNodes(world, nodes)
            return updated
        if fault.kind == "PartitionRegion" || fault.kind == "HealRegion":
            let reachable = fault.kind == "HealRegion"
            let n = len(world.nodes)
            let mut nodes = world.nodes
            let mut i = 0
            loop i < n:
                let node = world.nodes[i]
                if node.region == fault.region:
                    let flipped = do simNodeRebuild(node, node.online, reachable, node.servedOps, node.cpuUtilization, node.memoryUtilization, node.queueDepth)
                    nodes[i] = flipped
                i = i + 1
            let updated = do clusterStateWithNodes(world, nodes)
            return updated
        let cellIdx = do clusterStateCellIndexOf(world.cells, fault.target)
        if cellIdx == -1:
            return world
        let cell = world.cells[cellIdx]
        let heated = do simCellRebuild(cell, cell.owner, cell.replicas, cell.staging, fault.multiplier, atMs + fault.durationMs)
        let mut cells = world.cells
        cells[cellIdx] = heated
        let updated = do clusterStateWithCells(world, cells)
        return updated

    # simulationExpireHotspots: a cell whose multiplier is not 1.0 and whose
    # `hot_until_ms <= at_ms` is reset.
    private proc simulationExpireHotspots(world: ClusterState, atMs: int) -> ClusterState:
        let n = len(world.cells)
        let mut cells = world.cells
        let mut i = 0
        loop i < n:
            let cell = world.cells[i]
            if cell.hotMultiplier != 1.0 && cell.hotUntilMs <= atMs:
                let cooled = do simCellRebuild(cell, cell.owner, cell.replicas, cell.staging, 1.0, 0)
                cells[i] = cooled
            i = i + 1
        let updated = do clusterStateWithCells(world, cells)
        return updated

    struct SimulationLoadResult:
        world: ClusterState
        rng: SimRng
        loads: [SimCellLoad]

    private proc simDemandIndexOf(ids: [text], id: text) -> int:
        let n = len(ids)
        let mut i = 0
        loop i < n:
            if ids[i] == id:
                return i
            i = i + 1
        return -1

    # simulationRecomputeLoad: `recompute_load` — reads are shared across a
    # cell's ONLINE holders, writes go to all of them, and a staged copy
    # takes the writes while serving nothing. One jitter draw per cell in
    # target order, unconditionally. Then per node: offline -> all zero;
    # else cpu = clamp(served / max(cap, 1)), memory = clamp(0.10 +
    # placements/capacity * 0.35 + cpu * 0.45), queue = cpu > 0.75 ?
    # ((cpu - 0.75) / 0.25) * 25000 : cpu * 400, truncated.
    private proc simulationRecomputeLoad(sim: Simulation, atMs: int) -> SimulationLoadResult:
        let world = sim.world
        let cellCount = len(world.cells)
        let mut rng = sim.rng
        let mut loads = []
        let mut demandIds = []
        let mut demandVals = []
        let mut c = 0
        loop c < cellCount:
            let cell = world.cells[c]
            let profile = do simClassProfile(cell.workload.class)
            let mut hot = 1.0
            if atMs < cell.hotUntilMs:
                hot = cell.hotMultiplier
            let wave = do simDiurnal(atMs, sim.spec.diurnalPeriodMs, cell.phaseOffsetMs)
            let jitterDraw = do simRngRange(rng, 0.95, 1.05)
            rng = jitterDraw.rng
            let jitter = jitterDraw.value
            let ops = profile.baseOps * cell.scale * hot * wave * jitter
            let reads = ops * profile.readRatio
            let writes = ops - reads
            let holders = do simCellHolders(cell)
            let holderCount = len(holders)
            let mut onlineHolders = []
            let mut h = 0
            loop h < holderCount:
                let holder = do clusterStateNode(world, holders[h])
                if holder.has && holder.val.online:
                    onlineHolders = append(onlineHolders, holders[h])
                h = h + 1
            let onlineCount = len(onlineHolders)
            let mut share = 0.0
            if onlineCount > 0:
                share = reads / toFloat(onlineCount)
            let mut k = 0
            loop k < onlineCount:
                let idx = do simDemandIndexOf(demandIds, onlineHolders[k])
                let add = share + writes
                if idx == -1:
                    demandIds = append(demandIds, onlineHolders[k])
                    demandVals = append(demandVals, 0.0 + add)
                else:
                    demandVals[idx] = demandVals[idx] + add
                k = k + 1
            let stagedCount = len(cell.staging)
            let mut s = 0
            loop s < stagedCount:
                let stagedNode = do clusterStateNode(world, cell.staging[s])
                if stagedNode.has && stagedNode.val.online:
                    let idx2 = do simDemandIndexOf(demandIds, cell.staging[s])
                    if idx2 == -1:
                        demandIds = append(demandIds, cell.staging[s])
                        demandVals = append(demandVals, 0.0 + writes)
                    else:
                        demandVals[idx2] = demandVals[idx2] + writes
                s = s + 1
            loads = append(loads, SimCellLoad{target: cell.target, readsOnOwner: share, writes: writes})
            c = c + 1
        let nodeCount = len(world.nodes)
        let mut nodes = []
        let mut n = 0
        loop n < nodeCount:
            let node = world.nodes[n]
            let mut served = 0.0
            let demandIdx = do simDemandIndexOf(demandIds, node.id.value)
            if demandIdx != -1:
                served = demandVals[demandIdx]
            if !node.online:
                let dark = do simNodeRebuild(node, node.online, node.reachable, 0.0, 0.0, 0.0, 0)
                nodes = append(nodes, dark)
            else:
                let cpuRaw = served / max(node.capacityOps, 1.0)
                let cpu = do clampFloat(cpuRaw, 0.0, 1.0)
                let placements = do clusterStateHostedPlacements(world, node.id.value)
                let capacity = toFloat(max(node.placementCapacity, 1))
                let memRaw = 0.10 + (toFloat(placements) / capacity) * 0.35 + cpu * 0.45
                let memory = do clampFloat(memRaw, 0.0, 1.0)
                let mut queue = floor(cpu * 400.0)
                if cpu > 0.75:
                    queue = floor(((cpu - 0.75) / 0.25) * 25000.0)
                let loaded = do simNodeRebuild(node, node.online, node.reachable, served, cpu, memory, queue)
                nodes = append(nodes, loaded)
            n = n + 1
        let updated = do clusterStateWithNodes(world, nodes)
        return SimulationLoadResult{world: updated, rng: rng, loads: loads}

    # simulationBuildObservations: `build_observations` — an unreachable or
    # offline owner reports nothing; stress = 1 + 8 * max(cpu - 0.60, 0)
    # scales the class latencies; byte rates are bytes_per_op * the rate.
    private proc simulationBuildObservations(world: ClusterState, atMs: int, loads: [SimCellLoad]) -> [Observation]:
        let n = len(loads)
        let mut observations = []
        let mut i = 0
        loop i < n:
            let load = loads[i]
            let cell = do clusterStateCell(world, load.target)
            let mut emit = cell.has
            let noNode = do simNodeNew(DbmsId{value: ""}, "", 0, 0.0)
            let mut ownerNode = noNode
            if emit:
                let owner = do clusterStateNode(world, cell.val.owner)
                emit = owner.has && owner.val.online && owner.val.reachable
                ownerNode = owner.val
            let shard = do clusterStateShard(world, load.target.shardId)
            if emit && shard.has:
                let profile = do simClassProfile(cell.val.workload.class)
                let stress = 1.0 + 8.0 * max(ownerNode.cpuUtilization - 0.60, 0.0)
                let bytesPerOp = toFloat(profile.bytesPerOp)
                let metrics = WorkloadMetrics{operationsPerSecond: load.readsOnOwner + load.writes, readsPerSecond: load.readsOnOwner, writesPerSecond: load.writes, readLatencyUs: profile.readLatencyUs * stress, writeLatencyUs: profile.writeLatencyUs * stress, cpuUtilization: ownerNode.cpuUtilization, memoryUtilization: ownerNode.memoryUtilization, storageBytesPerSecond: floor(bytesPerOp * load.writes), networkInBytesPerSecond: floor(bytesPerOp * load.writes), networkOutBytesPerSecond: floor(bytesPerOp * load.readsOnOwner), queueDepth: ownerNode.queueDepth, cellBreakdown: [], cellBreakdownPartial: false}
                let observation = do observationNew(atMs, shard.val, load.target.coordinate, metrics)
                observations = append(observations, observation)
            i = i + 1
        return observations

    # SimBatchAccumulator: one `(node, shard_id) -> Vec<TelemetrySample>`
    # entry, kept in ascending (node, shard_id) order.
    struct SimBatchAccumulator:
        nodeId: text
        shardId: int
        samples: [SimTelemetrySample]

    private proc simBatchInsert(batches: [SimBatchAccumulator], nodeId: text, shardId: int, sample: SimTelemetrySample) -> [SimBatchAccumulator]:
        let n = len(batches)
        let mut result = []
        let mut inserted = false
        let mut i = 0
        loop i < n:
            let b = batches[i]
            let before = nodeId < b.nodeId || (nodeId == b.nodeId && shardId < b.shardId)
            if !inserted && before:
                result = append(result, SimBatchAccumulator{nodeId: nodeId, shardId: shardId, samples: [sample]})
                inserted = true
            if b.nodeId == nodeId && b.shardId == shardId:
                let grown = append(b.samples, sample)
                result = append(result, SimBatchAccumulator{nodeId: nodeId, shardId: shardId, samples: grown})
                inserted = true
            else:
                result = append(result, b)
            i = i + 1
        if !inserted:
            result = append(result, SimBatchAccumulator{nodeId: nodeId, shardId: shardId, samples: [sample]})
        return result

    # simulationBuildMessages: `build_messages` — on the first tick every
    # node registers ("0.13.0"); every online, reachable node heartbeats
    # (healthy = condition Healthy); observations become TelemetrySamples
    # batched by (owner, shard) in that order.
    private proc simulationBuildMessages(world: ClusterState, registered: bool, atMs: int, observations: [Observation]) -> [SimFabricMessage]:
        let mut messages = []
        let nodeCount = len(world.nodes)
        if !registered:
            let mut r = 0
            loop r < nodeCount:
                let node = world.nodes[r]
                let msg = do simMessageRegisterNode(SimNodeRegistration{protocol: "facet/1", nodeId: node.id, softwareVersion: "0.13.0", region: node.region})
                messages = append(messages, msg)
                r = r + 1
        let mut h = 0
        loop h < nodeCount:
            let node = world.nodes[h]
            if node.online && node.reachable:
                let condition = do simNodeCondition(node)
                let beat = do simMessageHeartbeat(SimNodeHeartbeat{nodeId: node.id, timestampMs: atMs, healthy: condition == "healthy"})
                messages = append(messages, beat)
            h = h + 1
        let mut batches = []
        let obsCount = len(observations)
        let mut o = 0
        loop o < obsCount:
            let observation = observations[o]
            let target = do actionTargetNew(observation.shard.id, observation.coordinate)
            let cell = do clusterStateCell(world, target)
            if cell.has:
                let metrics = observation.metrics
                let total = do workloadMetricsTotalOperations(metrics)
                let mut readRatio = 0.0
                let mut writeRatio = 0.0
                if total > 0.0:
                    readRatio = metrics.readsPerSecond / total
                    writeRatio = metrics.writesPerSecond / total
                let sample = SimTelemetrySample{coordinate: observation.coordinate, operationsPerSecond: total, readRatio: readRatio, writeRatio: writeRatio, readLatencyUs: metrics.readLatencyUs, writeLatencyUs: metrics.writeLatencyUs, cpuUtilization: metrics.cpuUtilization, memoryUtilization: metrics.memoryUtilization, queueDepth: metrics.queueDepth, cellBreakdown: metrics.cellBreakdown, cellBreakdownPartial: metrics.cellBreakdownPartial}
                let grown = do simBatchInsert(batches, cell.val.owner, observation.shard.id, sample)
                batches = grown
            o = o + 1
        let batchCount = len(batches)
        let mut b = 0
        loop b < batchCount:
            let batch = batches[b]
            let shard = do clusterStateShard(world, batch.shardId)
            if shard.has:
                let msg = do simMessageTelemetry(SimTelemetryBatch{timestampMs: atMs, nodeId: DbmsId{value: batch.nodeId}, shard: shard.val, samples: batch.samples})
                messages = append(messages, msg)
            b = b + 1
        return messages

    struct SimulationStepResult:
        simulation: Simulation
        tick: SimTick

    # simulationStep: `step` — advance the clock one tick, fire the due
    # faults, expire hotspots, recompute load, observe, render messages.
    proc simulationStep(sim: Simulation) -> SimulationStepResult:
        let advanced = do simClockAdvance(sim.clock)
        let atMs = advanced.nowMs
        let due = do simulationDueFaults(sim.schedule, atMs)
        let faultCount = len(due.faults)
        let mut world = sim.world
        let mut f = 0
        loop f < faultCount:
            let applied = do simulationApplyFault(world, due.faults[f], atMs)
            world = applied
            f = f + 1
        let cooled = do simulationExpireHotspots(world, atMs)
        let staged = do simulationRebuild(sim, cooled, advanced.clock, sim.rng, due.schedule, sim.registered)
        let loaded = do simulationRecomputeLoad(staged, atMs)
        let observations = do simulationBuildObservations(loaded.world, atMs, loaded.loads)
        let messages = do simulationBuildMessages(loaded.world, sim.registered, atMs, observations)
        let next = do simulationRebuild(sim, loaded.world, advanced.clock, loaded.rng, due.schedule, true)
        return SimulationStepResult{simulation: next, tick: SimTick{atMs: atMs, faults: due.faults, observations: observations, messages: messages}}

    struct SimulationRunResult:
        simulation: Simulation
        ticks: [SimTick]

    proc simulationRun(sim: Simulation, ticks: int) -> SimulationRunResult:
        let mut current = sim
        let mut out = []
        let mut i = 0
        loop i < ticks:
            let stepped = do simulationStep(current)
            current = stepped.simulation
            out = append(out, stepped.tick)
            i = i + 1
        return SimulationRunResult{simulation: current, ticks: out}

    # ============================================================
    # THE COMPOSITION SEAM — see this file's header. `FabricController`
    # driven by `SimExecutor`: `register_executor(Box::new(sim.executor()))`
    # + `submit` + `advance` (+ `abort_with`, which `advance` calls) with the
    # executor dispatch swapped; `measure`/`record`/`reports`/`mechanisms`
    # are the imported originals, unchanged.
    # ============================================================

    # simControllerRegister: `controller.register_executor(Box::new(
    # simulation.executor()))` — the placeholder keeps `mechanisms()`
    # truthful (header, seam part (c)).
    proc simControllerRegister(c: FabricController) -> FabricController:
        let placeholder = Executor{kind: "simulated-placement", name: "simulated-placement", removes: [], startedPhases: [], startedAtMs: []}
        let registered = do fabricControllerRegisterExecutor(c, placeholder)
        return registered

    struct SimControllerSubmitResult:
        ok: bool
        id: ActionId
        err: ValidationError
        controller: FabricController
        executor: SimExecutor
        world: ClusterState

    # simControllerSubmit: `fabricControllerSubmit` line for line, with
    # `fabricControllerExecutorIndexSupporting` -> `simExecutorSupports` and
    # `executorPlan` -> `simExecutorPlan`. Ledger seeding happens before
    # planning and is kept even if planning fails, as in the original.
    proc simControllerSubmit(c: FabricController, ex: SimExecutor, world: ClusterState, envelope: DecisionEnvelope, baseline: WorkloadProfile, view: ControlPlaneView) -> SimControllerSubmitResult:
        let validated = do fabricControllerValidate(c, envelope, view)
        if !validated.ok:
            return SimControllerSubmitResult{ok: false, id: ActionId{value: 0}, err: validated.err, controller: c, executor: ex, world: world}
        let target = do validatedDecisionTarget(validated.value)
        let supports = do simExecutorSupports(ex, envelope.decision.action)
        if !supports:
            let label = do decisionEnvelopeActionLabel(envelope)
            let noMechanism = do validationErrorNoMechanism(label)
            return SimControllerSubmitResult{ok: false, id: ActionId{value: 0}, err: noMechanism, controller: c, executor: ex, world: world}
        let sourceId = do validatedDecisionSourceId(validated.value)
        let ledger = do replicaLedgerEnsureSeeded(c.ledger, target, sourceId)
        let seeded = FabricController{policy: c.policy, executors: c.executors, actions: c.actions, ledger: ledger}
        let replicas = do replicaLedgerReplicas(ledger, target)
        let request = do planRequestNew(target, envelope.decision.action, validated.value.source, validated.value.hasDestination, validated.value.destination, replicas, view.nowMs)
        let planned = do simExecutorPlan(ex, world, request)
        if !planned.ok:
            let rejected = do validationErrorPlanRejected(planned.err)
            return SimControllerSubmitResult{ok: false, id: ActionId{value: 0}, err: rejected, controller: seeded, executor: ex, world: world}
        let planCheck = do fabricControllerValidatePlan(seeded, planned.value, validated.value, view)
        if planCheck.has:
            return SimControllerSubmitResult{ok: false, id: ActionId{value: 0}, err: planCheck.err, controller: seeded, executor: ex, world: world}
        let id = do actionRegistryNextId(seeded.actions)
        let mechanism = do simExecutorName(ex)
        let snapshot = do measurementSnapshotFromProfile(baseline, envelope.observedAtMs)
        let record = do executionRecordNew(id, validated.value, planned.value, mechanism, snapshot, view.nowMs)
        let actions = do actionRegistryAdmit(seeded.actions, record)
        let zero = do validationErrorZero()
        return SimControllerSubmitResult{ok: true, id: id, err: zero, controller: FabricController{policy: seeded.policy, executors: seeded.executors, actions: actions, ledger: seeded.ledger}, executor: ex, world: world}

    struct SimControllerStepResult:
        known: bool
        execState: text
        controller: FabricController
        executor: SimExecutor
        world: ClusterState

    # simControllerAbortWith: `fabricControllerAbortWith` with `executorAbort`
    # -> `simExecutorAbort`. A record whose mechanism is not this executor
    # rolls back as Irreversible("mechanism is no longer registered"),
    # exactly the original's unregistered-mechanism branch.
    private proc simControllerAbortWith(c: FabricController, ex: SimExecutor, world: ClusterState, id: ActionId, reason: AbortReason, nowMs: int) -> SimControllerStepResult:
        let got = do actionRegistryGet(c.actions, id)
        if !got.has:
            return SimControllerStepResult{known: false, execState: "failed", controller: c, executor: ex, world: world}
        let record = got.val
        let name = do simExecutorName(ex)
        let unregistered = do rollbackOutcomeIrreversible("mechanism is no longer registered")
        let mut rollback = unregistered
        let mut executor = ex
        let mut next = world
        if record.mechanism == name:
            let aborted = do simExecutorAbort(ex, world, record.plan, record.completedPhases, nowMs)
            executor = aborted.executor
            next = aborted.world
            if aborted.ok:
                rollback = aborted.outcome
            else:
                let faultText = do executionFaultDisplay(aborted.fault)
                let irreversible = do rollbackOutcomeIrreversible(faultText)
                rollback = irreversible
        let mut ledger = c.ledger
        let cutOver = do executionRecordHasCutOver(record)
        if cutOver && rollback.kind == "Irreversible":
            let applied = do replicaLedgerApply(ledger, record.plan)
            ledger = applied
        let concluded = do executionRecordConcludeAborted(record, reason, rollback, nowMs)
        let written = do actionRegistrySetRecord(c.actions, concluded)
        let retired = do actionRegistryRetire(written, id)
        return SimControllerStepResult{known: true, execState: concluded.execState, controller: FabricController{policy: c.policy, executors: c.executors, actions: retired, ledger: ledger}, executor: executor, world: next}

    # simControllerAdvance: `fabricControllerAdvance` line for line —
    # terminal unchanged; awaiting-measurement -> deadline check; node loss
    # and phase timeout abort; admitted begins the first phase; running
    # polls, then begins the next phase or applies the plan to the ledger
    # and commits; every fault is absorbed into an abort — with
    # `executorBeginPhase`/`executorPollPhase` -> the `simExecutor*` procs
    # and the world threaded through.
    proc simControllerAdvance(c: FabricController, ex: SimExecutor, world: ClusterState, id: ActionId, view: ControlPlaneView) -> SimControllerStepResult:
        let nowMs = view.nowMs
        let got = do actionRegistryGet(c.actions, id)
        if !got.has:
            return SimControllerStepResult{known: false, execState: "", controller: c, executor: ex, world: world}
        let record0 = got.val
        let terminal = do executionStateIsTerminal(record0.execState)
        if terminal:
            return SimControllerStepResult{known: true, execState: record0.execState, controller: c, executor: ex, world: world}
        if record0.execState == "awaiting-measurement":
            let deadline = do fabricControllerCheckMeasurementDeadline(c, id, nowMs)
            return SimControllerStepResult{known: true, execState: deadline.execState, controller: deadline.controller, executor: ex, world: world}
        let loss = do fabricControllerNodeLoss(c, id, view)
        if loss.has:
            let lostResult = do simControllerAbortWith(c, ex, world, id, loss.val, nowMs)
            return lostResult
        if record0.execState == "running":
            let elapsed = do executionRecordPhaseElapsedMs(record0, nowMs)
            if elapsed > c.policy.phaseTimeoutMs:
                let timeout = do abortReasonPhaseTimeout(record0.runningPhase, elapsed, c.policy.phaseTimeoutMs)
                let timedOut = do simControllerAbortWith(c, ex, world, id, timeout, nowMs)
                return timedOut
        let name = do simExecutorName(ex)
        if record0.mechanism != name:
            let missing = do executionFaultInternal("mechanism '" + record0.mechanism + "' is no longer registered")
            let missingReason = do abortReasonFault(missing)
            let missingResult = do simControllerAbortWith(c, ex, world, id, missingReason, nowMs)
            return missingResult
        let mut executor = ex
        let mut next = world
        let mut record = record0
        let mut ledger = c.ledger
        let mut hasFault = false
        let noFault = do executionFaultInternal("")
        let mut fault = noFault
        if record0.execState == "admitted":
            let phase = do placementPlanFirstPhase(record0.plan)
            let began = do simExecutorBeginPhase(executor, next, record0.plan, phase, nowMs)
            executor = began.executor
            next = began.world
            if began.ok:
                let started = do executionRecordBeginPhase(record, phase, nowMs)
                record = started
            else:
                hasFault = true
                fault = began.fault
        else:
            if record0.execState == "running":
                let phase = record0.runningPhase
                let polled = do simExecutorPollPhase(executor, next, record0.plan, phase, nowMs)
                executor = polled.executor
                next = polled.world
                if !polled.ok:
                    hasFault = true
                    fault = polled.fault
                else:
                    if polled.progress.kind == "Running":
                        let fractioned = do executionRecordSetFraction(record, phase, polled.progress.fraction)
                        record = fractioned
                    else:
                        let completed = do executionRecordCompletePhase(record, phase)
                        record = completed
                        let after = do placementPlanPhaseAfter(record.plan, phase)
                        if after.has:
                            let began2 = do simExecutorBeginPhase(executor, next, record.plan, after.val, nowMs)
                            executor = began2.executor
                            next = began2.world
                            if began2.ok:
                                let started2 = do executionRecordBeginPhase(record, after.val, nowMs)
                                record = started2
                            else:
                                hasFault = true
                                fault = began2.fault
                        else:
                            let applied = do replicaLedgerApply(ledger, record.plan)
                            ledger = applied
                            let committed = do executionRecordCommit(record, nowMs)
                            record = committed
        let actions = do actionRegistrySetRecord(c.actions, record)
        let stepped = FabricController{policy: c.policy, executors: c.executors, actions: actions, ledger: ledger}
        if hasFault:
            let faultReason = do abortReasonFault(fault)
            let faulted = do simControllerAbortWith(stepped, executor, next, id, faultReason, nowMs)
            return faulted
        return SimControllerStepResult{known: true, execState: record.execState, controller: stepped, executor: executor, world: next}

    # ============================================================
    # DEMO / GROUND-TRUTH FIXTURES — `simulation::tests` (8 tests) translated
    # input for input, plus hand-traced executor and staged-copy scenarios.
    # Each returns one text summary; fabric_simulator_test.go compares each
    # against the value the real Rust crate printed for the same inputs.
    # Floats are compared as `round(v * 1000)` / `round(v * 1e6)` ints —
    # Rust's `f64::round` and this runtime's `round()` are both
    # half-away-from-zero, so the two sides agree on every value produced.
    # ============================================================
    private proc simR3(v: float) -> int:
        return round(v * 1000.0)

    private proc simR6(v: float) -> int:
        return round(v * 1000000.0)

    # simTestSpec: the tests' `spec()` — seed 20260904, 4 cells per shard,
    # 20 000 ops per node, ReadHeavy + Mixed only, everything else default.
    private proc simTestSpec() -> ClusterSpec:
        let base = do clusterSpecDefault()
        return ClusterSpec{seed: 20260904, tickMs: base.tickMs, startMs: base.startMs, regions: base.regions, nodesPerRegion: base.nodesPerRegion, shardsPerNode: base.shardsPerNode, cellsPerShard: 4, placementCapacity: base.placementCapacity, nodeCapacityOps: 20000.0, classes: ["ReadHeavy", "Mixed"], transferBytesPerMs: base.transferBytesPerMs, diurnalPeriodMs: base.diurnalPeriodMs}

    private proc simTickLine(t: SimTick) -> text:
        let n = len(t.observations)
        let mut sr = 0
        let mut sw = 0
        let mut sl = 0
        let mut i = 0
        loop i < n:
            let m = t.observations[i].metrics
            let r = do simR3(m.readsPerSecond)
            let w = do simR3(m.writesPerSecond)
            let l = do simR3(m.readLatencyUs)
            sr = sr + r
            sw = sw + w
            sl = sl + l
            i = i + 1
        return "" + t.atMs + "|" + len(t.faults) + "|" + n + "|" + sr + "|" + sw + "|" + sl

    private proc simTickFull(t: SimTick) -> text:
        let n = len(t.observations)
        let mut s = ""
        let mut i = 0
        loop i < n:
            let o = t.observations[i]
            let m = o.metrics
            let reads = do simR3(m.readsPerSecond)
            let writes = do simR3(m.writesPerSecond)
            let rl = do simR3(m.readLatencyUs)
            let wl = do simR3(m.writeLatencyUs)
            let cpu = do simR6(m.cpuUtilization)
            let mem = do simR6(m.memoryUtilization)
            s = s + o.shard.id + ":" + o.coordinate.x + ":" + o.coordinate.y + ":" + reads + ":" + writes + ":" + rl + ":" + wl + ":" + cpu + ":" + mem + ":" + m.storageBytesPerSecond + ":" + m.networkInBytesPerSecond + ":" + m.networkOutBytesPerSecond + ":" + m.queueDepth + ";"
            i = i + 1
        return s

    private proc simMessagesLine(t: SimTick) -> text:
        let n = len(t.messages)
        let mut s = ""
        let mut i = 0
        loop i < n:
            let msg = t.messages[i]
            if msg.kind == "RegisterNode":
                s = s + "reg:" + msg.registerNode.nodeId.value + ":" + msg.registerNode.softwareVersion + ":" + msg.registerNode.region + ";"
            if msg.kind == "Heartbeat":
                let healthy = do ctrlBoolText(msg.heartbeat.healthy)
                s = s + "hb:" + msg.heartbeat.nodeId.value + ":" + msg.heartbeat.timestampMs + ":" + healthy + ";"
            if msg.kind == "Telemetry":
                let b = msg.telemetry
                s = s + "tel:" + b.timestampMs + ":" + b.nodeId.value + ":" + b.shard.id + ":" + b.shard.workloadDomain + ":["
                let m = len(b.samples)
                let mut j = 0
                loop j < m:
                    let x = b.samples[j]
                    let ops = do simR3(x.operationsPerSecond)
                    let rr = do simR6(x.readRatio)
                    let wr = do simR6(x.writeRatio)
                    let rl = do simR3(x.readLatencyUs)
                    let wl = do simR3(x.writeLatencyUs)
                    let cpu = do simR6(x.cpuUtilization)
                    let mem = do simR6(x.memoryUtilization)
                    s = s + x.coordinate.x + "," + x.coordinate.y + ":" + ops + ":" + rr + ":" + wr + ":" + rl + ":" + wl + ":" + cpu + ":" + mem + ":" + x.queueDepth + ";"
                    j = j + 1
                s = s + "];"
            i = i + 1
        return s

    private proc simProfileLine(p: WorkloadProfile) -> text:
        let ops = do simR3(p.operationsPerSecond)
        let rr = do simR6(p.readRatio)
        let wr = do simR6(p.writeRatio)
        let rl = do simR3(p.readLatencyUs)
        let wl = do simR3(p.writeLatencyUs)
        let cpu = do simR6(p.cpuUtilization)
        let mem = do simR6(p.memoryUtilization)
        let score = do simR6(p.pressureScore)
        return "" + p.shardId + "|" + ops + "|" + rr + "|" + wr + "|" + rl + "|" + wl + "|" + cpu + "|" + mem + "|" + p.queueDepth + "|" + score

    # simFindProfile: the tests' "find the observation for `target`, turn it
    # into a WorkloadProfile" loop body.
    private proc simFindProfile(t: SimTick, target: ActionTarget) -> WorkloadProfileOption:
        let n = len(t.observations)
        let mut i = 0
        loop i < n:
            let o = t.observations[i]
            if o.shard.id == target.shardId && o.coordinate.x == target.coordinate.x && o.coordinate.y == target.coordinate.y:
                let profile = do workloadProfileFromMetrics(o.shard.id, o.coordinate, o.metrics)
                return WorkloadProfileOption{has: true, val: profile}
            i = i + 1
        let zero = do workloadProfileZero()
        return WorkloadProfileOption{has: false, val: zero}

    private proc simFleetLine(sim: Simulation) -> text:
        let fleet = do clusterStateFleetView(sim.world)
        let nodes = do fleetViewNodesSortedById(fleet)
        let n = len(nodes)
        let mut s = "gen=" + fleet.generation + "|"
        let mut i = 0
        loop i < n:
            let st = nodes[i]
            let cpu = do simR6(st.cpuUtilization)
            let mem = do simR6(st.memoryUtilization)
            s = s + st.id.value + ":" + st.region + ":" + st.condition + ":" + st.hostedPlacements + ":" + st.placementCapacity + ":" + cpu + ":" + mem + ";"
            i = i + 1
        return s

    private proc simTopoLine(sim: Simulation) -> text:
        let topology = do clusterStateTopology(sim.world)
        let n = len(topology.placements)
        let mut s = ""
        let mut i = 0
        loop i < n:
            let p = topology.placements[i]
            if i > 0:
                s = s + ";"
            s = s + p.shardId + ":" + p.coordinate.x + ":" + p.coordinate.y + ":" + p.dbmsId + ":" + p.region
            i = i + 1
        return s

    private proc simCellLine(world: ClusterState, target: ActionTarget) -> text:
        let cell = do clusterStateCell(world, target)
        let replicas = do ctrlJoinText(cell.val.replicas, ",")
        let staging = do ctrlJoinText(cell.val.staging, ",")
        let n = len(world.nodes)
        let mut hosted = ""
        let mut i = 0
        loop i < n:
            let count = do clusterStateHostedPlacements(world, world.nodes[i].id.value)
            if i > 0:
                hosted = hosted + ","
            hosted = hosted + world.nodes[i].id.value + "=" + count
            i = i + 1
        return cell.val.owner + "|" + replicas + "|" + staging + "|" + world.generation + "|" + hosted

    private proc simClusterDump(world: ClusterState) -> text:
        let mut s = ""
        let nodeCount = len(world.nodes)
        let mut i = 0
        loop i < nodeCount:
            let n = world.nodes[i]
            let online = do ctrlBoolText(n.online)
            let reachable = do ctrlBoolText(n.reachable)
            s = s + "N:" + n.id.value + ":" + n.region + ":" + online + ":" + reachable + ":" + n.placementCapacity + ":" + floor(n.capacityOps) + ";"
            i = i + 1
        let cellCount = len(world.cells)
        let mut c = 0
        loop c < cellCount:
            let cell = world.cells[c]
            let replicas = do ctrlJoinText(cell.replicas, ",")
            let staging = do ctrlJoinText(cell.staging, ",")
            let scale = do simR6(cell.scale)
            let hot = do simR3(cell.hotMultiplier)
            s = s + "C:" + cell.target.shardId + ":" + cell.target.coordinate.x + ":" + cell.target.coordinate.y + ":" + cell.workload.id + ":" + cell.workload.class + ":" + cell.owner + ":" + replicas + ":" + staging + ":" + scale + ":" + cell.bytes + ":" + hot + ":" + cell.phaseOffsetMs + ";"
            c = c + 1
        return s + "G:" + world.generation + ":" + world.transferBytesPerMs

    private proc simFaultsLine(faults: [SimFault]) -> text:
        let n = len(faults)
        let mut s = ""
        let mut i = 0
        loop i < n:
            let d = do simFaultDisplay(faults[i])
            if i > 0:
                s = s + ";"
            s = s + d
            i = i + 1
        return s

    private proc simDbmsIdsLine(ids: [DbmsId]) -> text:
        let joined = do ctrlDbmsIdsText(ids)
        return joined

    # A: `ClusterState::build` for spec() — every node and cell, every RNG
    # draw's effect (class, scale, phase offset), bytes, owner.
    proc demoClusterBuild() -> text:
        let spec = do simTestSpec()
        let sim = do simulationNew(spec)
        let dump = do simClusterDump(sim.world)
        return dump

    proc demoDefaultCluster() -> text:
        let spec = do clusterSpecDefault()
        let sim = do simulationNew(spec)
        let dump = do simClusterDump(sim.world)
        return dump

    # A2: targets / fleet_view / topology / now_ms / least_loaded_node at
    # construction, plus node_count and with_seed.
    proc demoClusterAccessors() -> text:
        let spec = do simTestSpec()
        let sim = do simulationNew(spec)
        let targets = do simulationTargets(sim)
        let n = len(targets)
        let mut targetText = ""
        let mut i = 0
        loop i < n:
            let d = do actionTargetDisplay(targets[i])
            if i > 0:
                targetText = targetText + ";"
            targetText = targetText + d
            i = i + 1
        let fleet = do simFleetLine(sim)
        let topo = do simTopoLine(sim)
        let now = do simulationNowMs(sim)
        let none = do clusterStateLeastLoadedNode(sim.world, [])
        let excl = do clusterStateLeastLoadedNode(sim.world, ["us-east-db-0"])
        let count = do clusterSpecNodeCount(spec)
        let reseeded = do clusterSpecWithSeed(spec, 7)
        let generation = do simulationGeneration(sim)
        return targetText + "#" + fleet + "#" + topo + "#" + now + "#" + none.val.value + "#" + excl.val.value + "#" + count + "#" + reseeded.seed + "#" + reseeded.cellsPerShard + "#" + generation

    # B: the_same_seed_reproduces_the_run_exactly — two builds of the same
    # 40-tick run with a HotShard at +5s and a NodeLoss at +12s must agree
    # tick for tick; the per-tick digest is then compared with Rust's.
    private proc simTestOneBuild() -> SimulationRunResult:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let hot = do simFaultHotShard(targets[1], 6.0, 20000)
        let sim1 = do simulationScheduleFault(sim0, spec.startMs + 5000, hot)
        let loss = do simFaultNodeLoss(DbmsId{value: "us-west-db-0"})
        let sim2 = do simulationScheduleFault(sim1, spec.startMs + 12000, loss)
        let run = do simulationRun(sim2, 40)
        return run

    proc demoSameSeed() -> text:
        let a = do simTestOneBuild()
        let b = do simTestOneBuild()
        let n = len(a.ticks)
        let mut same = len(b.ticks) == n
        let mut lines = ""
        let mut i = 0
        loop i < n:
            let fa = do simTickFull(a.ticks[i])
            let fb = do simTickFull(b.ticks[i])
            if fa != fb:
                same = false
            let line = do simTickLine(a.ticks[i])
            if i > 0:
                lines = lines + "/"
            lines = lines + line
            i = i + 1
        let sameText = do ctrlBoolText(same)
        return sameText + "|" + lines

    proc demoSameSeedFull() -> text:
        let a = do simTestOneBuild()
        let f0 = do simTickFull(a.ticks[0])
        let f5 = do simTickFull(a.ticks[5])
        let f12 = do simTickFull(a.ticks[12])
        let f39 = do simTickFull(a.ticks[39])
        let faults5 = do simFaultsLine(a.ticks[4].faults)
        let faults12 = do simFaultsLine(a.ticks[11].faults)
        return f0 + "#" + f5 + "#" + f12 + "#" + f39 + "#" + faults5 + "#" + faults12

    proc demoSameSeedMessages() -> text:
        let a = do simTestOneBuild()
        let m0 = do simMessagesLine(a.ticks[0])
        let m1 = do simMessagesLine(a.ticks[1])
        let m12 = do simMessagesLine(a.ticks[11])
        return m0 + "#" + m1 + "#" + m12

    # C: a_different_seed_produces_a_different_run.
    proc demoDifferentSeed() -> text:
        let spec = do simTestSpec()
        let a0 = do simulationNew(spec)
        let spec7 = do clusterSpecWithSeed(spec, 7)
        let b0 = do simulationNew(spec7)
        let ra = do simulationRun(a0, 20)
        let rb = do simulationRun(b0, 20)
        let mut differ = false
        let mut i = 0
        loop i < 20:
            let fa = do simTickFull(ra.ticks[i])
            let fb = do simTickFull(rb.ticks[i])
            if fa != fb:
                differ = true
            i = i + 1
        let differText = do ctrlBoolText(differ)
        let t0 = do simTickLine(rb.ticks[0])
        let t19 = do simTickLine(rb.ticks[19])
        return differText + "|" + t0 + "|" + t19

    # D: a_hot_shard_shows_up_as_pressure_on_its_cell — 8x for 30s, the
    # cell's reported ops must exceed 4x its quiet baseline.
    proc demoHotShard() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let before = do simulationStep(sim0)
        let quiet = do simFindProfile(before.tick, target)
        let hot = do simFaultHotShard(target, 8.0, 30000)
        let injected = do simulationInject(before.simulation, hot)
        let after = do simulationStep(injected)
        let loud = do simFindProfile(after.tick, target)
        let q = do simR3(quiet.val.operationsPerSecond)
        let l = do simR3(loud.val.operationsPerSecond)
        let louder = do ctrlBoolText(loud.val.operationsPerSecond > quiet.val.operationsPerSecond * 4.0)
        return "" + q + "|" + l + "|" + louder

    # E: a_lost_node_goes_silent_rather_than_reporting_zeroes — plus the
    # fleet view, the message stream without it, and its recovery.
    proc demoLostNode() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let lost = DbmsId{value: "us-east-db-0"}
        let before = do simulationStep(sim0)
        let n = len(before.simulation.world.cells)
        let mut owned = 0
        let mut i = 0
        loop i < n:
            if before.simulation.world.cells[i].owner == lost.value:
                owned = owned + 1
            i = i + 1
        let loss = do simFaultNodeLoss(lost)
        let injected = do simulationInject(before.simulation, loss)
        let after = do simulationStep(injected)
        let fleet = do clusterStateFleetView(after.simulation.world)
        let status = do fleetViewGet(fleet, lost)
        let fleetLine = do simFleetLine(after.simulation)
        let msgs = do simMessagesLine(after.tick)
        let recovery = do simFaultNodeRecovery(lost)
        let recovering = do simulationInject(after.simulation, recovery)
        let recovered = do simulationStep(recovering)
        let recoveredFleet = do simFleetLine(recovered.simulation)
        return "" + len(before.tick.observations) + "|" + owned + "|" + len(after.tick.observations) + "|" + status.status.condition + "#" + fleetLine + "#" + msgs + "#" + len(recovered.tick.observations) + "|" + recoveredFleet

    # F: a_partitioned_region_keeps_serving_but_stops_reporting.
    proc demoPartition() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let before = do simulationStep(sim0)
        let partition = do simFaultPartitionRegion("us-west")
        let cut = do simulationInject(before.simulation, partition)
        let after = do simulationStep(cut)
        let cells = len(after.simulation.world.cells)
        let midFleet = do simFleetLine(after.simulation)
        let heal = do simFaultHealRegion("us-west")
        let healing = do simulationInject(after.simulation, heal)
        let healed = do simulationStep(healing)
        let healedFleet = do simFleetLine(healed.simulation)
        return "" + len(before.tick.observations) + "|" + len(after.tick.observations) + "|" + cells + "|" + midFleet + "#" + len(healed.tick.observations) + "|" + healedFleet

    # G: the_optimizer_runs_against_the_simulator_unchanged — 40x for 60s,
    # ten ticks into the analyzer, then the optimizer decides on the hot
    # cell's profile against the simulated topology; the decision's
    # coordinate must be the target's.
    proc demoOptimizer() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let hot = do simFaultHotShard(target, 40.0, 60000)
        let injected = do simulationInject(sim0, hot)
        let run = do simulationRun(injected, 10)
        let empty = do workloadAnalyzerNew()
        let mut analyzer = empty
        let mut t = 0
        loop t < 10:
            let m = len(run.ticks[t].observations)
            let mut o = 0
            loop o < m:
                let observed = do workloadAnalyzerObserve(analyzer, run.ticks[t].observations[o])
                analyzer = observed
                o = o + 1
            t = t + 1
        let topology = do simulationTopology(run.simulation)
        let optimizer = do workloadOptimizerDefault()
        let hotProfile = do workloadAnalyzerProfile(analyzer, target.shardId, target.coordinate)
        let profileLine = do simProfileLine(hotProfile.val)
        let decision = do workloadOptimizerOptimizeFromTopology(optimizer, hotProfile.val, topology)
        let label = do controllerPlanActionLabel(decision.action)
        let gain = do simR6(decision.expectedGain)
        let cost = do simR6(decision.estimatedCost)
        let confidence = do simR6(decision.confidence)
        let count = do workloadAnalyzerLen(analyzer)
        let sameCoordinate = do ctrlBoolText(decision.coordinate.x == target.coordinate.x && decision.coordinate.y == target.coordinate.y)
        return profileLine + "#" + decision.shardId + "|" + decision.coordinate.x + "|" + decision.coordinate.y + "|" + label + "|" + gain + "|" + cost + "|" + confidence + "#" + count + "#" + sameCoordinate

    # H: the_controller_executes_and_measures_against_the_simulation — the
    # full loop through the composition seam: observe, decide (Move to the
    # least-loaded node), validate, execute phase by phase against the
    # simulated world, then measure Improved after the hotspot passes.
    proc demoControllerExecutesAndMeasures() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let hot = do simFaultHotShard(target, 30.0, 400000)
        let injected = do simulationInject(sim0, hot)
        let warm = do simulationRun(injected, 5)
        let emptyProfile = do workloadProfileZero()
        let mut baseline = emptyProfile
        let mut t = 0
        loop t < 5:
            let found = do simFindProfile(warm.ticks[t], target)
            if found.has:
                baseline = found.val
            t = t + 1
        let mut sim = warm.simulation
        let baselineLine = do simProfileLine(baseline)
        let ownerCell = do clusterStateCell(sim.world, target)
        let owner = ownerCell.val.owner
        let destination = do clusterStateLeastLoadedNode(sim.world, [owner])
        let now5 = do simulationNowMs(sim)
        let fleet5 = do simFleetLine(sim)
        let base = do fabricControllerDefault()
        let registered = do simControllerRegister(base)
        let topology0 = do simulationTopology(sim)
        let seeded = do fabricControllerSeedReplicas(registered, topology0)
        let fleet0 = do simulationFleetView(sim)
        let move = do optimizationActionMove(destination.val.value)
        let decision = OptimizationDecision{shardId: target.shardId, coordinate: target.coordinate, action: move, expectedGain: 0.30, estimatedCost: 0.05, confidence: 0.95}
        let envelope = do decisionEnvelopeNew(decision, now5, fleet0.generation)
        let view0 = do controlPlaneViewNew(topology0, fleet0, now5)
        let ex0 = do simulationExecutor(sim)
        let submitted = do simControllerSubmit(seeded, ex0, sim.world, envelope, baseline, view0)
        let mut controller = submitted.controller
        let mut ex = submitted.executor
        let admitted = do fabricControllerRecord(controller, submitted.id)
        let idText = do actionIdDisplay(submitted.id)
        let planPhases = do ctrlJoinText(admitted.val.plan.phases, ",")
        let planAdds = do simDbmsIdsLine(admitted.val.plan.adds)
        let planRemoves = do simDbmsIdsLine(admitted.val.plan.removes)
        let submittedOk = do ctrlBoolText(submitted.ok)
        let planLine = idText + "|plan=" + planPhases + "|adds=" + planAdds + "|removes=" + planRemoves + "|bytes=" + admitted.val.plan.estimatedBytes + "|dur=" + admitted.val.plan.estimatedDurationMs + "|state=" + admitted.val.execState + "|ok=" + submittedOk
        let mut trace = ""
        let mut i = 0
        loop i < 20:
            let stepped = do simulationStep(sim)
            sim = stepped.simulation
            let topology = do simulationTopology(sim)
            let fleet = do simulationFleetView(sim)
            let now = do simulationNowMs(sim)
            let view = do controlPlaneViewNew(topology, fleet, now)
            let advanced = do simControllerAdvance(controller, ex, sim.world, submitted.id, view)
            controller = advanced.controller
            ex = advanced.executor
            let synced = do simulationWithState(sim, advanced.world)
            sim = synced
            let record = do fabricControllerRecord(controller, submitted.id)
            let mut extra = ""
            if advanced.execState == "running":
                let fraction = do simR6(record.val.runningFraction)
                extra = record.val.runningPhase + ":" + fraction
            let cellLine = do simCellLine(sim.world, target)
            trace = trace + now + "=" + advanced.execState + ":" + extra + ";[" + cellLine + "]"
            i = i + 1
        let record20 = do fabricControllerRecord(controller, submitted.id)
        let cell20 = do clusterStateCell(sim.world, target)
        let change = do executionRecordPlacementChange(record20.val)
        let mut changeText = ""
        if change.has:
            changeText = change.val.fromNode.value + ">" + change.val.toNode.value + ":" + change.val.toRegion
        let mut committed = 0
        if record20.val.hasCommittedAtMs:
            committed = record20.val.committedAtMs
        let after20 = record20.val.execState + "|" + cell20.val.owner + "|" + changeText + "|" + committed
        let fleet25 = do simFleetLine(sim)
        let topo25 = do simTopoLine(sim)
        let ledgerIds = do replicaLedgerReplicas(controller.ledger, target)
        let ledgerLine = do simDbmsIdsLine(ledgerIds)
        let cool = do simFaultHotShard(target, 1.0, 0)
        let cooled = do simulationInject(sim, cool)
        let settled = do simulationRun(cooled, 40)
        let tail = do simulationRun(settled.simulation, 2)
        sim = tail.simulation
        let mut after = emptyProfile
        let mut k = 0
        loop k < 2:
            let found = do simFindProfile(tail.ticks[k], target)
            if found.has:
                after = found.val
            k = k + 1
        let afterLine = do simProfileLine(after)
        let topologyEnd = do simulationTopology(sim)
        let fleetEnd = do simulationFleetView(sim)
        let nowEnd = do simulationNowMs(sim)
        let viewEnd = do controlPlaneViewNew(topologyEnd, fleetEnd, nowEnd)
        let measured = do fabricControllerMeasure(controller, submitted.id, after, viewEnd)
        controller = measured.controller
        let realized = do simR6(measured.outcome.realizedGain)
        let ratio = do simR6(measured.outcome.gainRatio)
        let latency = do simR3(measured.outcome.latencyDeltaUs)
        let throughput = do simR3(measured.outcome.throughputDelta)
        let expected = do simR6(measured.outcome.expectedGain)
        let measuredOk = do ctrlBoolText(measured.ok)
        let isMeasured = do outcomeVerdictIsMeasured(measured.outcome.verdict)
        let isMeasuredText = do ctrlBoolText(isMeasured)
        let outcomeLine = "" + nowEnd + "|" + measured.outcome.verdict + "|" + realized + "|" + ratio + "|" + latency + "|" + throughput + "|" + expected + "|" + measuredOk + "|" + isMeasuredText
        let reports = do fabricControllerReports(controller)
        let reportsLine = "" + len(reports) + "|" + reports[0].mechanism + "|" + reports[0].actionLabel + "|" + reports[0].admittedAtMs + "|" + reports[0].concludedAtMs + "|" + reports[0].verdict
        let fleetEndLine = do simFleetLine(sim)
        let cellEnd = do simCellLine(sim.world, target)
        return baselineLine + "#" + owner + "|" + destination.val.value + "|" + now5 + "#" + fleet5 + "#" + planLine + "#" + trace + "#" + after20 + "#" + fleet25 + "#" + topo25 + "#" + ledgerLine + "#" + afterLine + "#" + outcomeLine + "#" + reportsLine + "#" + fleetEndLine + "#" + cellEnd

    # I: a_split_is_declined_rather_than_faked — `supports` says no, the
    # controller refuses with NoMechanism.
    proc demoSplitDeclined() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let stepped = do simulationStep(sim0)
        let sim = stepped.simulation
        let base = do fabricControllerDefault()
        let registered = do simControllerRegister(base)
        let topology = do simulationTopology(sim)
        let seeded = do fabricControllerSeedReplicas(registered, topology)
        let fleet = do simulationFleetView(sim)
        let now = do simulationNowMs(sim)
        let view = do controlPlaneViewNew(topology, fleet, now)
        let split = do optimizationActionSplit()
        let decision = OptimizationDecision{shardId: target.shardId, coordinate: target.coordinate, action: split, expectedGain: 1.0, estimatedCost: 0.1, confidence: 0.99}
        let envelope = do decisionEnvelopeNew(decision, now, fleet.generation)
        let metrics = do workloadMetricsDefault()
        let profile = do workloadProfileFromMetrics(target.shardId, target.coordinate, metrics)
        let ex = do simulationExecutor(sim)
        let submitted = do simControllerSubmit(seeded, ex, sim.world, envelope, profile, view)
        let errText = do validationErrorDisplay(submitted.err)
        let mechanisms = do fabricControllerMechanisms(seeded)
        let mechanismsText = do ctrlJoinText(mechanisms, ",")
        let okText = do ctrlBoolText(submitted.ok)
        return errText + "#" + mechanismsText + "#" + okText + "|" + submitted.err.kind

    # simTestRequest: the harness's `request(sim, target, action, dest)` —
    # source = the cell's owner placement, replicas = [owner].
    private proc simTestRequest(sim: Simulation, target: ActionTarget, action: OptimizationAction, hasDestination: bool, destination: text) -> PlanRequest:
        let cell = do clusterStateCell(sim.world, target)
        let node = do clusterStateNode(sim.world, cell.val.owner)
        let source = do placementNew(node.val.id.value, target.shardId, target.coordinate, node.val.region)
        let now = do simulationNowMs(sim)
        let request = do planRequestNew(target, action, source, hasDestination, DbmsId{value: destination}, [node.val.id], now)
        return request

    private proc simProgressText(r: SimExecutorPollResult) -> text:
        if !r.ok:
            let faultText = do executionFaultDisplay(r.fault)
            return "err:" + faultText
        if r.progress.kind == "Running":
            let fraction = do simR6(r.progress.fraction)
            return "running:" + fraction
        return "complete"

    private proc simRollbackText(r: SimExecutorAbortResult) -> text:
        if !r.ok:
            let faultText = do executionFaultDisplay(r.fault)
            return "err:" + faultText
        if r.outcome.kind == "Irreversible":
            return "Irreversible:" + r.outcome.reason
        return "Restored"

    private proc simBeginText(r: SimExecutorBeginResult) -> text:
        if r.ok:
            return "Ok(())"
        let faultText = do executionFaultDisplay(r.fault)
        return "Err(\"" + faultText + "\")"

    # J: executor.rs hand-traced through the trait, in the harness's order:
    # name/supports; a Replicate, Isolate, Colocate plan; the four plan
    # refusals; a Move driven phase by phase with the exact poll instants
    # (running fractions, completions, the world after each); abort before
    # and after cutover; abort with no job; a Replicate that promotes; a
    # destination lost mid-flight; the tick after the loss; set_owner to the
    # same node and drop_copy of the owner as no-ops.
    proc demoExecutorTraces() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let t1 = targets[1]
        let t2 = targets[2]
        let stepped = do simulationStep(sim0)
        let mut sim = stepped.simulation
        let mut world = sim.world
        let ex0 = do simulationExecutor(sim)
        let mut ex = ex0
        let name = do simExecutorName(ex)
        let replicateX = do optimizationActionReplicate("x")
        let moveX = do optimizationActionMove("x")
        let isolate = do optimizationActionIsolate()
        let colocate = do optimizationActionColocate(Coordinate{x: 1, y: 1})
        let split = do optimizationActionSplit()
        let noAction = do optimizationActionNoAction()
        let s1 = do simExecutorSupports(ex, replicateX)
        let s2 = do simExecutorSupports(ex, moveX)
        let s3 = do simExecutorSupports(ex, isolate)
        let s4 = do simExecutorSupports(ex, colocate)
        let s5 = do simExecutorSupports(ex, split)
        let s6 = do simExecutorSupports(ex, noAction)
        let s1t = do ctrlBoolText(s1)
        let s2t = do ctrlBoolText(s2)
        let s3t = do ctrlBoolText(s3)
        let s4t = do ctrlBoolText(s4)
        let s5t = do ctrlBoolText(s5)
        let s6t = do ctrlBoolText(s6)
        let nameLine = name + "|supports=" + s1t + s2t + s3t + s4t + s5t + s6t
        let replicateW1 = do optimizationActionReplicate("us-west-db-1")
        let repReq = do simTestRequest(sim, target, replicateW1, true, "us-west-db-1")
        let rep = do simExecutorPlan(ex, world, repReq)
        let repPhases = do ctrlJoinText(rep.value.phases, ",")
        let repAdds = do simDbmsIdsLine(rep.value.adds)
        let repLine = repPhases + "|" + repAdds + "|" + len(rep.value.removes) + "|" + rep.value.estimatedBytes + "|" + rep.value.estimatedDurationMs + "|" + rep.value.scope
        let isoReq = do simTestRequest(sim, target, isolate, false, "")
        let iso = do simExecutorPlan(ex, world, isoReq)
        let isoPhases = do ctrlJoinText(iso.value.phases, ",")
        let isoAdds = do simDbmsIdsLine(iso.value.adds)
        let isoRemoves = do simDbmsIdsLine(iso.value.removes)
        let isoLine = isoPhases + "|" + isoAdds + "|" + isoRemoves + "|" + iso.value.estimatedBytes + "|" + iso.value.estimatedDurationMs
        let colocateE1 = do optimizationActionColocate(Coordinate{x: 1, y: 0})
        let colReq = do simTestRequest(sim, target, colocateE1, true, "us-east-db-1")
        let col = do simExecutorPlan(ex, world, colReq)
        let colLine = "" + len(col.value.phases) + "|" + col.value.adds[0].value + "|" + col.value.removes[0].value
        let splitReq = do simTestRequest(sim, target, split, false, "")
        let splitPlan = do simExecutorPlan(ex, world, splitReq)
        let splitLine = do planErrorDisplay(splitPlan.err)
        let noActionReq = do simTestRequest(sim, target, noAction, false, "")
        let noActionPlan = do simExecutorPlan(ex, world, noActionReq)
        let noActionLine = do planErrorDisplay(noActionPlan.err)
        let noDestReq = do simTestRequest(sim, target, moveX, false, "")
        let noDestPlan = do simExecutorPlan(ex, world, noDestReq)
        let noDestLine = do planErrorDisplay(noDestPlan.err)
        let bogusBase = do simTestRequest(sim, target, moveX, true, "x")
        let bogus = PlanRequest{target: ActionTarget{shardId: 99, coordinate: Coordinate{x: 0, y: 0}}, action: bogusBase.action, source: bogusBase.source, hasDestination: bogusBase.hasDestination, destination: bogusBase.destination, replicas: bogusBase.replicas, requestedAtMs: bogusBase.requestedAtMs}
        let bogusPlan = do simExecutorPlan(ex, world, bogus)
        let missingLine = do planErrorDisplay(bogusPlan.err)
        let moveW1 = do optimizationActionMove("us-west-db-1")
        let mvReq = do simTestRequest(sim, target, moveW1, true, "us-west-db-1")
        let mvPlan = do simExecutorPlan(ex, world, mvReq)
        let mv = mvPlan.value
        let t0 = do simulationNowMs(sim)
        let unstarted = do simExecutorPollPhase(ex, world, mv, "prepare", t0)
        let unstartedLine = do simProgressText(unstarted)
        let beganPrepare = do simExecutorBeginPhase(ex, world, mv, "prepare", t0)
        ex = beganPrepare.executor
        world = beganPrepare.world
        let beganPrepareLine = do simBeginText(beganPrepare)
        let afterStage = do simCellLine(world, target)
        let wrongPhase = do simExecutorPollPhase(ex, world, mv, "transfer", t0)
        let wrongPhaseLine = do simProgressText(wrongPhase)
        let prep0 = do simExecutorPollPhase(ex, world, mv, "prepare", t0)
        ex = prep0.executor
        world = prep0.world
        let prep0Line = do simProgressText(prep0)
        let prep1000 = do simExecutorPollPhase(ex, world, mv, "prepare", t0 + 1000)
        ex = prep1000.executor
        world = prep1000.world
        let prep1000Line = do simProgressText(prep1000)
        let prep2000 = do simExecutorPollPhase(ex, world, mv, "prepare", t0 + 2000)
        ex = prep2000.executor
        world = prep2000.world
        let prep2000Line = do simProgressText(prep2000)
        let beganTransfer = do simExecutorBeginPhase(ex, world, mv, "transfer", t0 + 2000)
        ex = beganTransfer.executor
        world = beganTransfer.world
        let xfer0 = do simExecutorPollPhase(ex, world, mv, "transfer", t0 + 2000)
        ex = xfer0.executor
        world = xfer0.world
        let xfer0Line = do simProgressText(xfer0)
        let xfer5 = do simExecutorPollPhase(ex, world, mv, "transfer", t0 + 2005)
        ex = xfer5.executor
        world = xfer5.world
        let xfer5Line = do simProgressText(xfer5)
        let xfer1000 = do simExecutorPollPhase(ex, world, mv, "transfer", t0 + 3000)
        ex = xfer1000.executor
        world = xfer1000.world
        let xfer1000Line = do simProgressText(xfer1000)
        let ex2a = do simExecutorNew()
        let began2 = do simExecutorBeginPhase(ex2a, world, mv, "prepare", t0)
        world = began2.world
        let abortPre = do simExecutorAbort(began2.executor, world, mv, ["prepare"], t0)
        world = abortPre.world
        let abortPreText = do simRollbackText(abortPre)
        let abortPreCell = do simCellLine(world, target)
        let abortUnknownCut = do simExecutorAbort(abortPre.executor, world, mv, ["prepare", "transfer", "cutover"], t0)
        world = abortUnknownCut.world
        let abortUnknownCutText = do simRollbackText(abortUnknownCut)
        let abortUnknownNoCut = do simExecutorAbort(abortUnknownCut.executor, world, mv, [], t0)
        world = abortUnknownNoCut.world
        let abortUnknownNoCutText = do simRollbackText(abortUnknownNoCut)
        let beganCutover = do simExecutorBeginPhase(ex, world, mv, "cutover", t0 + 3000)
        ex = beganCutover.executor
        world = beganCutover.world
        let cut = do simExecutorPollPhase(ex, world, mv, "cutover", t0 + 3000)
        ex = cut.executor
        world = cut.world
        let cutText = do simProgressText(cut)
        let cutCell = do simCellLine(world, target)
        let beganCleanup = do simExecutorBeginPhase(ex, world, mv, "cleanup", t0 + 3000)
        ex = beganCleanup.executor
        world = beganCleanup.world
        let clean0 = do simExecutorPollPhase(ex, world, mv, "cleanup", t0 + 3000)
        ex = clean0.executor
        world = clean0.world
        let clean0Text = do simProgressText(clean0)
        let clean1000 = do simExecutorPollPhase(ex, world, mv, "cleanup", t0 + 4000)
        ex = clean1000.executor
        world = clean1000.world
        let clean1000Text = do simProgressText(clean1000)
        let cleanCell = do simCellLine(world, target)
        let abortPost = do simExecutorAbort(ex, world, mv, ["prepare", "transfer", "cutover", "cleanup"], t0 + 4000)
        ex = abortPost.executor
        world = abortPost.world
        let abortPostText = do simRollbackText(abortPost)
        let abortPostCell = do simCellLine(world, target)
        let replicateW0 = do optimizationActionReplicate("us-west-db-0")
        let synced1 = do simulationWithState(sim, world)
        sim = synced1
        let rpReq = do simTestRequest(sim, t1, replicateW0, true, "us-west-db-0")
        let rpPlan = do simExecutorPlan(ex, world, rpReq)
        let rp = rpPlan.value
        let rpB1 = do simExecutorBeginPhase(ex, world, rp, "prepare", t0)
        ex = rpB1.executor
        world = rpB1.world
        let rpP1 = do simExecutorPollPhase(ex, world, rp, "prepare", t0 + 2000)
        ex = rpP1.executor
        world = rpP1.world
        let rpB2 = do simExecutorBeginPhase(ex, world, rp, "transfer", t0 + 2000)
        ex = rpB2.executor
        world = rpB2.world
        let rpP2 = do simExecutorPollPhase(ex, world, rp, "transfer", t0 + 3000)
        ex = rpP2.executor
        world = rpP2.world
        let rpB3 = do simExecutorBeginPhase(ex, world, rp, "cutover", t0 + 3000)
        ex = rpB3.executor
        world = rpB3.world
        let rpCut = do simExecutorPollPhase(ex, world, rp, "cutover", t0 + 3000)
        ex = rpCut.executor
        world = rpCut.world
        let rpCutText = do simProgressText(rpCut)
        let rpCutCell = do simCellLine(world, t1)
        let rpAbort = do simExecutorAbort(ex, world, rp, ["cutover"], t0 + 3000)
        ex = rpAbort.executor
        world = rpAbort.world
        let rpAbortText = do simRollbackText(rpAbort)
        let synced2 = do simulationWithState(sim, world)
        sim = synced2
        let mpReq = do simTestRequest(sim, t2, moveW1, true, "us-west-db-1")
        let mpPlan = do simExecutorPlan(ex, world, mpReq)
        let mp = mpPlan.value
        let mpB1 = do simExecutorBeginPhase(ex, world, mp, "prepare", t0)
        ex = mpB1.executor
        world = mpB1.world
        let synced3 = do simulationWithState(sim, world)
        let lossW1 = do simFaultNodeLoss(DbmsId{value: "us-west-db-1"})
        let lost = do simulationInject(synced3, lossW1)
        sim = lost
        world = lost.world
        let lostPoll = do simExecutorPollPhase(ex, world, mp, "prepare", t0 + 2000)
        ex = lostPoll.executor
        world = lostPoll.world
        let lostPollText = do simProgressText(lostPoll)
        let lostBegin = do simExecutorBeginPhase(ex, world, mp, "transfer", t0 + 2000)
        ex = lostBegin.executor
        world = lostBegin.world
        let lostBeginText = do simBeginText(lostBegin)
        let lostAbort = do simExecutorAbort(ex, world, mp, [], t0 + 2000)
        ex = lostAbort.executor
        world = lostAbort.world
        let lostAbortText = do simRollbackText(lostAbort)
        let lostAbortCell = do simCellLine(world, t2)
        let synced4 = do simulationWithState(sim, world)
        let afterLoss = do simulationStep(synced4)
        sim = afterLoss.simulation
        world = sim.world
        let tickAfterLoss = do simTickLine(afterLoss.tick)
        let fleetAfterLoss = do simFleetLine(sim)
        let t1Cell = do clusterStateCell(world, t1)
        let sameOwner = do clusterStateSetOwner(world, t1, t1Cell.val.owner)
        let droppedOwner = do clusterStateDropCopy(sameOwner.world, t1, t1Cell.val.owner)
        let t1After = do clusterStateCell(droppedOwner, t1)
        let sameText = do ctrlBoolText(sameOwner.changed)
        let t1Replicas = do ctrlJoinText(t1After.val.replicas, ",")
        let setOwnerLine = sameText + "|" + t1After.val.owner + "|" + t1Replicas + "|" + droppedOwner.generation
        return nameLine + "#" + repLine + "#" + isoLine + "#" + colLine + "#" + splitLine + "#" + noActionLine + "#" + noDestLine + "#" + missingLine + "#" + unstartedLine + "#" + beganPrepareLine + "#" + afterStage + "#" + wrongPhaseLine + "#" + prep0Line + "|" + prep1000Line + "|" + prep2000Line + "#" + xfer0Line + "|" + xfer5Line + "|" + xfer1000Line + "#" + abortPreText + "|" + abortPreCell + "#" + abortUnknownCutText + "#" + abortUnknownNoCutText + "#" + cutText + "|" + cutCell + "#" + clean0Text + "|" + clean1000Text + "|" + cleanCell + "#" + abortPostText + "|" + abortPostCell + "#" + rpCutText + "|" + rpCutCell + "#" + rpAbortText + "#" + lostPollText + "#" + lostBeginText + "#" + lostAbortText + "|" + lostAbortCell + "#" + tickAfterLoss + "#" + fleetAfterLoss + "#" + setOwnerLine

    # K: a staged copy of a hot cell takes the writes and shows as pressure
    # on the destination; a promoted copy then shares the reads; a hotspot
    # with a 1.5s duration expires on the second tick after it.
    proc demoStagedPressure() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let hot = do simFaultHotShard(target, 30.0, 400000)
        let injected = do simulationInject(sim0, hot)
        let first = do simulationStep(injected)
        let stagedWorld = do clusterStateStage(first.simulation.world, target, "us-west-db-1")
        let staged = do simulationWithState(first.simulation, stagedWorld)
        let tick = do simulationStep(staged)
        let tickLine = do simTickLine(tick.tick)
        let fleetLine = do simFleetLine(tick.simulation)
        let full = do simTickFull(tick.tick)
        let promotedWorld = do clusterStatePromote(tick.simulation.world, target, "us-west-db-1")
        let promoted = do simulationWithState(tick.simulation, promotedWorld)
        let tick2 = do simulationStep(promoted)
        let tick2Line = do simTickLine(tick2.tick)
        let fleet2 = do simFleetLine(tick2.simulation)
        let promotedCell = do simCellLine(tick2.simulation.world, target)
        let promotedFull = do simTickFull(tick2.tick)
        let brief = do simFaultHotShard(target, 2.0, 1500)
        let heated = do simulationInject(tick2.simulation, brief)
        let e1 = do simulationStep(heated)
        let e2 = do simulationStep(e1.simulation)
        let e3 = do simulationStep(e2.simulation)
        let e1Line = do simTickLine(e1.tick)
        let e2Line = do simTickLine(e2.tick)
        let e3Line = do simTickLine(e3.tick)
        let cell = do clusterStateCell(e3.simulation.world, target)
        let hotNow = do simR3(cell.val.hotMultiplier)
        return tickLine + "#" + fleetLine + "#" + full + "#" + tick2Line + "|" + fleet2 + "#" + promotedCell + "#" + promotedFull + "#" + e1Line + "|" + e2Line + "|" + e3Line + "#" + hotNow + "|" + cell.val.hotUntilMs

    state demoClusterBuildResult: text = ""
    state demoDefaultClusterResult: text = ""
    state demoClusterAccessorsResult: text = ""
    state demoSameSeedResult: text = ""
    state demoSameSeedFullResult: text = ""
    state demoSameSeedMessagesResult: text = ""
    state demoDifferentSeedResult: text = ""
    state demoHotShardResult: text = ""
    state demoLostNodeResult: text = ""
    state demoPartitionResult: text = ""
    state demoOptimizerResult: text = ""
    state demoControllerExecutesAndMeasuresResult: text = ""
    state demoSplitDeclinedResult: text = ""
    state demoExecutorTracesResult: text = ""
    state demoStagedPressureResult: text = ""

    action runFabricSimulatorDemo():
        let r1 = do demoClusterBuild()
        let r2 = do demoDefaultCluster()
        let r3 = do demoClusterAccessors()
        let r4 = do demoSameSeed()
        let r5 = do demoSameSeedFull()
        let r6 = do demoSameSeedMessages()
        let r7 = do demoDifferentSeed()
        let r8 = do demoHotShard()
        let r9 = do demoLostNode()
        let r10 = do demoPartition()
        let r11 = do demoOptimizer()
        let r12 = do demoControllerExecutesAndMeasures()
        let r13 = do demoSplitDeclined()
        let r14 = do demoExecutorTraces()
        let r15 = do demoStagedPressure()
        demoClusterBuildResult = r1
        demoDefaultClusterResult = r2
        demoClusterAccessorsResult = r3
        demoSameSeedResult = r4
        demoSameSeedFullResult = r5
        demoSameSeedMessagesResult = r6
        demoDifferentSeedResult = r7
        demoHotShardResult = r8
        demoLostNodeResult = r9
        demoPartitionResult = r10
        demoOptimizerResult = r11
        demoControllerExecutesAndMeasuresResult = r12
        demoSplitDeclinedResult = r13
        demoExecutorTracesResult = r14
        demoStagedPressureResult = r15
