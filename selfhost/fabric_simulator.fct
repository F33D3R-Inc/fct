import "fabric_simulator_base.fct"
import "fabric_simulator_cluster.fct"
import "fabric_protocol.fct"
import "fabric_controller_core.fct"

app FabricSimulatorSelfHost:
    # Self-hosting port of fabric/crates/fabric-simulator/src/simulation.rs
    # (Tick, CellLoad, Simulation) — the tick loop that observes the
    # synthetic fleet — composed with the rest of the crate, each piece
    # imported from the one file that ports it:
    #   clock.rs/fault.rs/rng.rs/workload.rs  fabric_simulator_base.fct
    #     (SimClock, Fault, Rng, ClassProfile/classProfile/diurnal)
    #   cluster.rs/executor.rs                fabric_simulator_cluster.fct
    #     (ClusterSpec, SimNode, SimCell, ClusterState, SimExecutor)
    #   the messages a tick renders to         fabric_protocol.fct
    #     (FabricMessage "RegisterNode"|"Heartbeat"|"Telemetry" carrying the
    #     real NodeRegistration/NodeHeartbeat/TelemetryBatch/TelemetrySample,
    #     so fabric_runtime.fct's `fabricRuntimeHandle` consumes ticks as is)
    #   the controller that drives SimExecutor fabric_controller_core.fct
    #     through fabric_executor.fct's "simulated-placement" Executor arm.
    # lib.rs is doc comment + `pub mod`/`pub use` only. No wall clock, no
    # entropy, no I/O anywhere.
    #
    # ============================================================
    # THE CONTROLLER SEAM
    # ============================================================
    # `controller.register_executor(Box::new(simulation.executor()))` hands
    # the controller a SimExecutor sharing the simulation's
    # `Rc<RefCell<ClusterState>>`. Here the SimExecutor OWNS a ClusterState
    # value (fabric_simulator_cluster.fct, convention 1), and the controller
    # owns the executor. The ordinary `fabricControllerSubmit/Advance/Tick/
    # Abort` drive it; around each such call a driver lends the simulation's
    # world to the controller's executor entry (`simulationLendWorld`) and
    # takes the edited world back (`simulationReclaimWorld`) — the two
    # halves of the shared cell, made explicit.
    #
    # ============================================================
    # DELIBERATE SIMPLIFICATIONS — every one named, none silent
    # ============================================================
    # 1. `&mut self` -> functional update returning the new value; procs
    #    whose Rust form mutates AND returns bundle both in a `*Result`.
    # 2. BTreeMap -> sorted arrays: `schedule` by at_ms; the telemetry batch
    #    map keyed `(node, shard_id)` is a sorted array of accumulators; the
    #    `demand: BTreeMap<String, f64>` is two parallel arrays (its order
    #    only assigns per-node totals, so insertion order is kept).
    # 3. `(f64).clamp(0,1)` -> fabric_telemetry.fct's `clampFloat`; `f64 as
    #    u64` (non-negative) -> `floor()`.
    # 4. `Shard` is carried as `ObservationShard{id, workloadDomain}`
    #    (fabric_simulator_cluster.fct, convention 5); a TelemetryBatch
    #    carries its wire form `ProtocolShard` with the same two fields.

    # ============================================================
    # simulation.rs — Tick, CellLoad, Simulation
    # ============================================================
    # SimTick: `Tick`, everything one step produced. Cells on an unreachable node
    # produce nothing — silence is the observation.
    struct SimTick:
        atMs: int
        faults: [Fault]
        observations: [Observation]
        messages: [FabricMessage]

    # SimCellLoad: per-cell demand for one tick, before it becomes an
    # observation.
    struct SimCellLoad:
        target: ActionTarget
        readsOnOwner: float
        writes: float

    # SimScheduledFaults: one `BTreeMap<u64, Vec<Fault>>` entry.
    struct SimScheduledFaults:
        atMs: int
        faults: [Fault]

    # Simulation: a synthetic FacetQL fleet under a synthetic workload.
    struct Simulation:
        spec: ClusterSpec
        world: ClusterState
        clock: SimClock
        rng: Rng
        schedule: [SimScheduledFaults]
        registered: bool

    private proc simulationRebuild(sim: Simulation, world: ClusterState, clock: SimClock, rng: Rng, schedule: [SimScheduledFaults], registered: bool) -> Simulation:
        return Simulation{spec: sim.spec, world: world, clock: clock, rng: rng, schedule: schedule, registered: registered}

    # simulationNew: `Simulation::new` — build the world from the spec, then
    # fork the seed stream twice: the first fork (`_construction`) is
    # discarded, the second is the workload's own stream, so adding a draw
    # elsewhere cannot shift it.
    proc simulationNew(spec: ClusterSpec) -> Simulation:
        let world = do clusterStateBuild(spec)
        let seedStream = do rngNew(spec.seed)
        let construction = do rngFork(seedStream)
        let workload = do rngFork(construction.rng)
        let clock = do simClockNew(spec.startMs, spec.tickMs)
        return Simulation{spec: spec, world: world, clock: clock, rng: workload.forked, schedule: [], registered: false}

    proc simulationSpec(sim: Simulation) -> ClusterSpec:
        return sim.spec

    proc simulationNowMs(sim: Simulation) -> int:
        let now = do simClockNowMs(sim.clock)
        return now

    proc simulationClock(sim: Simulation) -> SimClock:
        return sim.clock

    # simulationState: `state()` — the shared cluster (simplification 1).
    proc simulationState(sim: Simulation) -> ClusterState:
        return sim.world

    # simulationWithState: the other half of the `Rc<RefCell<_>>` — a
    # driver that let the executor edit the world hands it back here.
    proc simulationWithState(sim: Simulation, world: ClusterState) -> Simulation:
        let rebuilt = do simulationRebuild(sim, world, sim.clock, sim.rng, sim.schedule, sim.registered)
        return rebuilt

    # simulationExecutor: `executor()` — a mechanism over this simulation's
    # world (see "THE CONTROLLER SEAM").
    proc simulationExecutor(sim: Simulation) -> SimExecutor:
        let ex = do simExecutorNew(sim.world)
        return ex

    proc simulationTopology(sim: Simulation) -> TopologyRegistry:
        let topology = do clusterStateTopology(sim.world)
        return topology

    proc simulationFleetView(sim: Simulation) -> FleetView:
        let fleet = do clusterStateFleetView(sim.world)
        return fleet

    proc simulationGeneration(sim: Simulation) -> int:
        return sim.world.generation

    # simulationTargets: every placed cell, in target order.
    proc simulationTargets(sim: Simulation) -> [ActionTarget]:
        let n = len(sim.world.cells)
        let mut targets = []
        let mut i = 0
        loop i < n:
            targets = append(targets, sim.world.cells[i].target)
            i = i + 1
        return targets

    # simulationScheduleFault: `schedule.entry(at_ms).or_default().push(fault)`
    # on a by-at_ms sorted array.
    proc simulationScheduleFault(sim: Simulation, atMs: int, fault: Fault) -> Simulation:
        let n = len(sim.schedule)
        let mut schedule = []
        let mut inserted = false
        let mut i = 0
        loop i < n:
            let entry = sim.schedule[i]
            if !inserted && u64Cmp(atMs, entry.atMs) < 0:
                schedule = append(schedule, SimScheduledFaults{atMs: atMs, faults: [fault]})
                inserted = true
            if entry.atMs == atMs:
                let grown = append(entry.faults, fault)
                schedule = append(schedule, SimScheduledFaults{atMs: atMs, faults: grown})
                inserted = true
            else:
                schedule = append(schedule, entry)
            i = i + 1
        if !inserted:
            schedule = append(schedule, SimScheduledFaults{atMs: atMs, faults: [fault]})
        let rebuilt = do simulationRebuild(sim, sim.world, sim.clock, sim.rng, schedule, sim.registered)
        return rebuilt

    # simulationInject: apply a fault immediately, at the current instant.
    proc simulationInject(sim: Simulation, fault: Fault) -> Simulation:
        let now = do simClockNowMs(sim.clock)
        let world = do simulationApplyFault(sim.world, fault, now)
        let rebuilt = do simulationRebuild(sim, world, sim.clock, sim.rng, sim.schedule, sim.registered)
        return rebuilt

    struct SimulationDueResult:
        schedule: [SimScheduledFaults]
        faults: [Fault]

    # simulationDueFaults: every entry at or before `at_ms`, removed, in key
    # order.
    private proc simulationDueFaults(schedule: [SimScheduledFaults], atMs: int) -> SimulationDueResult:
        let n = len(schedule)
        let mut faults = []
        let mut remaining = []
        let mut i = 0
        loop i < n:
            let entry = schedule[i]
            if u64Cmp(entry.atMs, atMs) <= 0:
                let m = len(entry.faults)
                let mut j = 0
                loop j < m:
                    faults = append(faults, entry.faults[j])
                    j = j + 1
            else:
                remaining = append(remaining, entry)
            i = i + 1
        return SimulationDueResult{schedule: remaining, faults: faults}

    # simulationApplyFault: `apply_fault` — NodeLoss zeroes the node and takes
    # it offline; NodeRecovery brings it back; Partition/Heal flip
    # `reachable` for a region; HotShard sets the cell's multiplier until
    # `at_ms + duration_ms`.
    private proc simulationApplyFault(world: ClusterState, fault: Fault, atMs: int) -> ClusterState:
        if fault.kind == "NodeLoss" || fault.kind == "NodeRecovery":
            let idx = do clusterStateNodeIndexOf(world.nodes, fault.node.value)
            if idx == -1:
                return world
            let node = world.nodes[idx]
            let mut nodes = world.nodes
            if fault.kind == "NodeLoss":
                let lost = do simNodeRebuild(node, false, node.reachable, 0.0, 0.0, 0.0, 0)
                nodes[idx] = lost
            else:
                let back = do simNodeRebuild(node, true, node.reachable, node.servedOps, node.cpuUtilization, node.memoryUtilization, node.queueDepth)
                nodes[idx] = back
            let updated = do clusterStateWithNodes(world, nodes)
            return updated
        if fault.kind == "PartitionRegion" || fault.kind == "HealRegion":
            let reachable = fault.kind == "HealRegion"
            let n = len(world.nodes)
            let mut nodes = world.nodes
            let mut i = 0
            loop i < n:
                let node = world.nodes[i]
                if node.region == fault.region:
                    let flipped = do simNodeRebuild(node, node.online, reachable, node.servedOps, node.cpuUtilization, node.memoryUtilization, node.queueDepth)
                    nodes[i] = flipped
                i = i + 1
            let updated = do clusterStateWithNodes(world, nodes)
            return updated
        let cellIdx = do clusterStateCellIndexOf(world.cells, fault.target)
        if cellIdx == -1:
            return world
        let cell = world.cells[cellIdx]
        let heated = do simCellRebuild(cell, cell.owner, cell.replicas, cell.staging, fault.multiplier, atMs + fault.durationMs)
        let mut cells = world.cells
        cells[cellIdx] = heated
        let updated = do clusterStateWithCells(world, cells)
        return updated

    # simulationExpireHotspots: a cell whose multiplier is not 1.0 and whose
    # `hot_until_ms <= at_ms` is reset.
    private proc simulationExpireHotspots(world: ClusterState, atMs: int) -> ClusterState:
        let n = len(world.cells)
        let mut cells = world.cells
        let mut i = 0
        loop i < n:
            let cell = world.cells[i]
            if cell.hotMultiplier != 1.0 && u64Cmp(cell.hotUntilMs, atMs) <= 0:
                let cooled = do simCellRebuild(cell, cell.owner, cell.replicas, cell.staging, 1.0, 0)
                cells[i] = cooled
            i = i + 1
        let updated = do clusterStateWithCells(world, cells)
        return updated

    struct SimulationLoadResult:
        world: ClusterState
        rng: Rng
        loads: [SimCellLoad]

    private proc simDemandIndexOf(ids: [text], id: text) -> int:
        let n = len(ids)
        let mut i = 0
        loop i < n:
            if ids[i] == id:
                return i
            i = i + 1
        return -1

    # simulationRecomputeLoad: `recompute_load` — reads are shared across a
    # cell's ONLINE holders, writes go to all of them, and a staged copy
    # takes the writes while serving nothing. One jitter draw per cell in
    # target order, unconditionally. Then per node: offline -> all zero;
    # else cpu = clamp(served / max(cap, 1)), memory = clamp(0.10 +
    # placements/capacity * 0.35 + cpu * 0.45), queue = cpu > 0.75 ?
    # ((cpu - 0.75) / 0.25) * 25000 : cpu * 400, truncated.
    private proc simulationRecomputeLoad(sim: Simulation, atMs: int) -> SimulationLoadResult:
        let world = sim.world
        let cellCount = len(world.cells)
        let mut rng = sim.rng
        let mut loads = []
        let mut demandIds = []
        let mut demandVals = []
        let mut c = 0
        loop c < cellCount:
            let cell = world.cells[c]
            let profile = do classProfile(cell.workload.class)
            let mut hot = 1.0
            if u64Cmp(atMs, cell.hotUntilMs) < 0:
                hot = cell.hotMultiplier
            let wave = do diurnal(atMs, sim.spec.diurnalPeriodMs, cell.phaseOffsetMs)
            let jitterDraw = do rngRange(rng, 0.95, 1.05)
            rng = jitterDraw.rng
            let jitter = jitterDraw.value
            let ops = profile.baseOps * cell.scale * hot * wave * jitter
            let reads = ops * profile.readRatio
            let writes = ops - reads
            let holders = do simCellHolders(cell)
            let holderCount = len(holders)
            let mut onlineHolders = []
            let mut h = 0
            loop h < holderCount:
                let holder = do clusterStateNode(world, holders[h])
                if holder.has && holder.val.online:
                    onlineHolders = append(onlineHolders, holders[h])
                h = h + 1
            let onlineCount = len(onlineHolders)
            let mut share = 0.0
            if onlineCount > 0:
                share = reads / toFloat(onlineCount)
            let mut k = 0
            loop k < onlineCount:
                let idx = do simDemandIndexOf(demandIds, onlineHolders[k])
                let add = share + writes
                if idx == -1:
                    demandIds = append(demandIds, onlineHolders[k])
                    demandVals = append(demandVals, 0.0 + add)
                else:
                    demandVals[idx] = demandVals[idx] + add
                k = k + 1
            let stagedCount = len(cell.staging)
            let mut s = 0
            loop s < stagedCount:
                let stagedNode = do clusterStateNode(world, cell.staging[s])
                if stagedNode.has && stagedNode.val.online:
                    let idx2 = do simDemandIndexOf(demandIds, cell.staging[s])
                    if idx2 == -1:
                        demandIds = append(demandIds, cell.staging[s])
                        demandVals = append(demandVals, 0.0 + writes)
                    else:
                        demandVals[idx2] = demandVals[idx2] + writes
                s = s + 1
            loads = append(loads, SimCellLoad{target: cell.target, readsOnOwner: share, writes: writes})
            c = c + 1
        let nodeCount = len(world.nodes)
        let mut nodes = []
        let mut n = 0
        loop n < nodeCount:
            let node = world.nodes[n]
            let mut served = 0.0
            let demandIdx = do simDemandIndexOf(demandIds, node.id.value)
            if demandIdx != -1:
                served = demandVals[demandIdx]
            if !node.online:
                let dark = do simNodeRebuild(node, node.online, node.reachable, 0.0, 0.0, 0.0, 0)
                nodes = append(nodes, dark)
            else:
                let cpuRaw = served / max(node.capacityOps, 1.0)
                let cpu = do clampFloat(cpuRaw, 0.0, 1.0)
                let placements = do clusterStateHostedPlacements(world, node.id.value)
                let capacity = toFloat(max(node.placementCapacity, 1))
                let memRaw = 0.10 + (toFloat(placements) / capacity) * 0.35 + cpu * 0.45
                let memory = do clampFloat(memRaw, 0.0, 1.0)
                let mut queue = floor(cpu * 400.0)
                if cpu > 0.75:
                    queue = floor(((cpu - 0.75) / 0.25) * 25000.0)
                let loaded = do simNodeRebuild(node, node.online, node.reachable, served, cpu, memory, queue)
                nodes = append(nodes, loaded)
            n = n + 1
        let updated = do clusterStateWithNodes(world, nodes)
        return SimulationLoadResult{world: updated, rng: rng, loads: loads}

    # simulationBuildObservations: `build_observations` — an unreachable or
    # offline owner reports nothing; stress = 1 + 8 * max(cpu - 0.60, 0)
    # scales the class latencies; byte rates are bytes_per_op * the rate.
    private proc simulationBuildObservations(world: ClusterState, atMs: int, loads: [SimCellLoad]) -> [Observation]:
        let n = len(loads)
        let mut observations = []
        let mut i = 0
        loop i < n:
            let load = loads[i]
            let cell = do clusterStateCell(world, load.target)
            let mut emit = cell.has
            let noNode = do simNodeNew(DbmsId{value: ""}, "", 0, 0.0)
            let mut ownerNode = noNode
            if emit:
                let owner = do clusterStateNode(world, cell.val.owner)
                emit = owner.has && owner.val.online && owner.val.reachable
                ownerNode = owner.val
            let shard = do clusterStateShard(world, load.target.shardId)
            if emit && shard.has:
                let profile = do classProfile(cell.val.workload.class)
                let stress = 1.0 + 8.0 * max(ownerNode.cpuUtilization - 0.60, 0.0)
                let bytesPerOp = toFloat(profile.bytesPerOp)
                let metrics = WorkloadMetrics{operationsPerSecond: load.readsOnOwner + load.writes, readsPerSecond: load.readsOnOwner, writesPerSecond: load.writes, readLatencyUs: profile.readLatencyUs * stress, writeLatencyUs: profile.writeLatencyUs * stress, cpuUtilization: ownerNode.cpuUtilization, memoryUtilization: ownerNode.memoryUtilization, storageBytesPerSecond: floor(bytesPerOp * load.writes), networkInBytesPerSecond: floor(bytesPerOp * load.writes), networkOutBytesPerSecond: floor(bytesPerOp * load.readsOnOwner), queueDepth: ownerNode.queueDepth, cellBreakdown: [], cellBreakdownPartial: false}
                let observation = do observationNew(atMs, shard.val, load.target.coordinate, metrics)
                observations = append(observations, observation)
            i = i + 1
        return observations

    # SimBatchAccumulator: one `(node, shard_id) -> Vec<TelemetrySample>`
    # entry, kept in ascending (node, shard_id) order.
    struct SimBatchAccumulator:
        nodeId: text
        shardId: int
        samples: [TelemetrySample]

    private proc simBatchInsert(batches: [SimBatchAccumulator], nodeId: text, shardId: int, sample: TelemetrySample) -> [SimBatchAccumulator]:
        let n = len(batches)
        let mut result = []
        let mut inserted = false
        let mut i = 0
        loop i < n:
            let b = batches[i]
            let before = nodeId < b.nodeId || (nodeId == b.nodeId && u64Cmp(shardId, b.shardId) < 0)
            if !inserted && before:
                result = append(result, SimBatchAccumulator{nodeId: nodeId, shardId: shardId, samples: [sample]})
                inserted = true
            if b.nodeId == nodeId && b.shardId == shardId:
                let grown = append(b.samples, sample)
                result = append(result, SimBatchAccumulator{nodeId: nodeId, shardId: shardId, samples: grown})
                inserted = true
            else:
                result = append(result, b)
            i = i + 1
        if !inserted:
            result = append(result, SimBatchAccumulator{nodeId: nodeId, shardId: shardId, samples: [sample]})
        return result

    # simulationBuildMessages: `build_messages` — on the first tick every
    # node registers ("0.13.0"); every online, reachable node heartbeats
    # (healthy = condition Healthy); observations become TelemetrySamples
    # batched by (owner, shard) in that order.
    private proc simulationBuildMessages(world: ClusterState, registered: bool, atMs: int, observations: [Observation]) -> [FabricMessage]:
        let empty = do protoEmptyFabricMessage()
        let mut messages = []
        let nodeCount = len(world.nodes)
        if !registered:
            let mut r = 0
            loop r < nodeCount:
                let node = world.nodes[r]
                let registration = do nodeRegistrationNew(node.id, "0.13.0", node.region)
                messages = append(messages, FabricMessage{kind: "RegisterNode", registerNode: registration, heartbeat: empty.heartbeat, topology: empty.topology, telemetry: empty.telemetry, workload: empty.workload})
                r = r + 1
        let mut h = 0
        loop h < nodeCount:
            let node = world.nodes[h]
            if node.online && node.reachable:
                let condition = do simNodeCondition(node)
                let beat = NodeHeartbeat{nodeId: node.id, timestampMs: atMs, healthy: condition == "healthy"}
                messages = append(messages, FabricMessage{kind: "Heartbeat", registerNode: empty.registerNode, heartbeat: beat, topology: empty.topology, telemetry: empty.telemetry, workload: empty.workload})
            h = h + 1
        let mut batches = []
        let obsCount = len(observations)
        let mut o = 0
        loop o < obsCount:
            let observation = observations[o]
            let target = do actionTargetNew(observation.shard.id, observation.coordinate)
            let cell = do clusterStateCell(world, target)
            if cell.has:
                let metrics = observation.metrics
                let total = do workloadMetricsTotalOperations(metrics)
                let mut readRatio = 0.0
                let mut writeRatio = 0.0
                if total > 0.0:
                    readRatio = metrics.readsPerSecond / total
                    writeRatio = metrics.writesPerSecond / total
                let sample = TelemetrySample{coordinate: observation.coordinate, operationsPerSecond: total, readRatio: readRatio, writeRatio: writeRatio, readLatencyUs: metrics.readLatencyUs, writeLatencyUs: metrics.writeLatencyUs, cpuUtilization: metrics.cpuUtilization, memoryUtilization: metrics.memoryUtilization, queueDepth: metrics.queueDepth, cellBreakdown: metrics.cellBreakdown, cellBreakdownPartial: metrics.cellBreakdownPartial}
                let grown = do simBatchInsert(batches, cell.val.owner, observation.shard.id, sample)
                batches = grown
            o = o + 1
        let batchCount = len(batches)
        let mut b = 0
        loop b < batchCount:
            let batch = batches[b]
            let shard = do clusterStateShard(world, batch.shardId)
            if shard.has:
                let telemetry = TelemetryBatch{timestampMs: atMs, nodeId: DbmsId{value: batch.nodeId}, shard: ProtocolShard{id: shard.val.id, workloadDomain: shard.val.workloadDomain}, samples: batch.samples}
                messages = append(messages, FabricMessage{kind: "Telemetry", registerNode: empty.registerNode, heartbeat: empty.heartbeat, topology: empty.topology, telemetry: telemetry, workload: empty.workload})
            b = b + 1
        return messages

    struct SimulationStepResult:
        simulation: Simulation
        tick: SimTick

    # simulationStep: `step` — advance the clock one tick, fire the due
    # faults, expire hotspots, recompute load, observe, render messages.
    proc simulationStep(sim: Simulation) -> SimulationStepResult:
        let advanced = do simClockAdvance(sim.clock)
        let atMs = advanced.nowMs
        let due = do simulationDueFaults(sim.schedule, atMs)
        let faultCount = len(due.faults)
        let mut world = sim.world
        let mut f = 0
        loop f < faultCount:
            let applied = do simulationApplyFault(world, due.faults[f], atMs)
            world = applied
            f = f + 1
        let cooled = do simulationExpireHotspots(world, atMs)
        let staged = do simulationRebuild(sim, cooled, advanced.clock, sim.rng, due.schedule, sim.registered)
        let loaded = do simulationRecomputeLoad(staged, atMs)
        let observations = do simulationBuildObservations(loaded.world, atMs, loaded.loads)
        let messages = do simulationBuildMessages(loaded.world, sim.registered, atMs, observations)
        let next = do simulationRebuild(sim, loaded.world, advanced.clock, loaded.rng, due.schedule, true)
        return SimulationStepResult{simulation: next, tick: SimTick{atMs: atMs, faults: due.faults, observations: observations, messages: messages}}

    struct SimulationRunResult:
        simulation: Simulation
        ticks: [SimTick]

    proc simulationRun(sim: Simulation, ticks: int) -> SimulationRunResult:
        let mut current = sim
        let mut out = []
        let mut i = 0
        loop i < ticks:
            let stepped = do simulationStep(current)
            current = stepped.simulation
            out = append(out, stepped.tick)
            i = i + 1
        return SimulationRunResult{simulation: current, ticks: out}

    # ============================================================
    # THE CONTROLLER SEAM — see this file's header.
    # ============================================================

    # simulationRegisterExecutor: `controller.register_executor(Box::new(
    # simulation.executor()))`.
    proc simulationRegisterExecutor(sim: Simulation, c: FabricController) -> FabricController:
        let ex = do simulationExecutor(sim)
        let wrapped = do simulatedPlacementExecutor(ex)
        let registered = do fabricControllerRegisterExecutor(c, wrapped)
        return registered

    private proc simulationExecutorIndex(sim: Simulation, c: FabricController) -> int:
        let probe = do simulationExecutor(sim)
        let name = do simExecutorName(probe)
        let idx = do fabricControllerExecutorIndexByName(c.executors, name)
        return idx

    # simulationLendWorld: before a controller call — the controller's
    # simulated executor sees the simulation's current world.
    proc simulationLendWorld(sim: Simulation, c: FabricController) -> FabricController:
        let idx = do simulationExecutorIndex(sim, c)
        if idx == -1:
            return c
        let mut executors = c.executors
        let current = do executorSimulated(executors[idx])
        let lent = do simExecutorWithWorld(current, sim.world)
        let updated = do executorWithSimulated(executors[idx], lent)
        executors[idx] = updated
        return FabricController{policy: c.policy, executors: executors, actions: c.actions, ledger: c.ledger}

    # simulationReclaimWorld: after a controller call — the world the
    # executor edited becomes the simulation's.
    proc simulationReclaimWorld(sim: Simulation, c: FabricController) -> Simulation:
        let idx = do simulationExecutorIndex(sim, c)
        if idx == -1:
            return sim
        let current = do executorSimulated(c.executors[idx])
        let world = do simExecutorWorld(current)
        let reclaimed = do simulationWithState(sim, world)
        return reclaimed

    # ============================================================
    # DEMO / GROUND-TRUTH FIXTURES — `simulation::tests` (8 tests) translated
    # input for input, plus hand-traced executor and staged-copy scenarios.
    # Each returns one text summary; fabric_simulator_test.go compares each
    # against the value the real Rust crate printed for the same inputs.
    # Floats are compared as `round(v * 1000)` / `round(v * 1e6)` ints —
    # Rust's `f64::round` and this runtime's `round()` are both
    # half-away-from-zero, so the two sides agree on every value produced.
    # ============================================================
    private proc simR3(v: float) -> int:
        return round(v * 1000.0)

    private proc simR6(v: float) -> int:
        return round(v * 1000000.0)

    # simTestSpec: the tests' `spec()` — seed 20260904, 4 cells per shard,
    # 20 000 ops per node, ReadHeavy + Mixed only, everything else default.
    private proc simTestSpec() -> ClusterSpec:
        let base = do clusterSpecDefault()
        return ClusterSpec{seed: 20260904, tickMs: base.tickMs, startMs: base.startMs, regions: base.regions, nodesPerRegion: base.nodesPerRegion, shardsPerNode: base.shardsPerNode, cellsPerShard: 4, placementCapacity: base.placementCapacity, nodeCapacityOps: 20000.0, classes: ["ReadHeavy", "Mixed"], transferBytesPerMs: base.transferBytesPerMs, diurnalPeriodMs: base.diurnalPeriodMs}

    private proc simTickLine(t: SimTick) -> text:
        let n = len(t.observations)
        let mut sr = 0
        let mut sw = 0
        let mut sl = 0
        let mut i = 0
        loop i < n:
            let m = t.observations[i].metrics
            let r = do simR3(m.readsPerSecond)
            let w = do simR3(m.writesPerSecond)
            let l = do simR3(m.readLatencyUs)
            sr = sr + r
            sw = sw + w
            sl = sl + l
            i = i + 1
        return "" + t.atMs + "|" + len(t.faults) + "|" + n + "|" + sr + "|" + sw + "|" + sl

    private proc simTickFull(t: SimTick) -> text:
        let n = len(t.observations)
        let mut s = ""
        let mut i = 0
        loop i < n:
            let o = t.observations[i]
            let m = o.metrics
            let reads = do simR3(m.readsPerSecond)
            let writes = do simR3(m.writesPerSecond)
            let rl = do simR3(m.readLatencyUs)
            let wl = do simR3(m.writeLatencyUs)
            let cpu = do simR6(m.cpuUtilization)
            let mem = do simR6(m.memoryUtilization)
            s = s + o.shard.id + ":" + o.coordinate.x + ":" + o.coordinate.y + ":" + reads + ":" + writes + ":" + rl + ":" + wl + ":" + cpu + ":" + mem + ":" + m.storageBytesPerSecond + ":" + m.networkInBytesPerSecond + ":" + m.networkOutBytesPerSecond + ":" + m.queueDepth + ";"
            i = i + 1
        return s

    private proc simMessagesLine(t: SimTick) -> text:
        let n = len(t.messages)
        let mut s = ""
        let mut i = 0
        loop i < n:
            let msg = t.messages[i]
            if msg.kind == "RegisterNode":
                s = s + "reg:" + msg.registerNode.nodeId.value + ":" + msg.registerNode.softwareVersion + ":" + msg.registerNode.region + ";"
            if msg.kind == "Heartbeat":
                let healthy = do ctrlBoolText(msg.heartbeat.healthy)
                s = s + "hb:" + msg.heartbeat.nodeId.value + ":" + msg.heartbeat.timestampMs + ":" + healthy + ";"
            if msg.kind == "Telemetry":
                let b = msg.telemetry
                s = s + "tel:" + b.timestampMs + ":" + b.nodeId.value + ":" + b.shard.id + ":" + b.shard.workloadDomain + ":["
                let m = len(b.samples)
                let mut j = 0
                loop j < m:
                    let x = b.samples[j]
                    let ops = do simR3(x.operationsPerSecond)
                    let rr = do simR6(x.readRatio)
                    let wr = do simR6(x.writeRatio)
                    let rl = do simR3(x.readLatencyUs)
                    let wl = do simR3(x.writeLatencyUs)
                    let cpu = do simR6(x.cpuUtilization)
                    let mem = do simR6(x.memoryUtilization)
                    s = s + x.coordinate.x + "," + x.coordinate.y + ":" + ops + ":" + rr + ":" + wr + ":" + rl + ":" + wl + ":" + cpu + ":" + mem + ":" + x.queueDepth + ";"
                    j = j + 1
                s = s + "];"
            i = i + 1
        return s

    private proc simProfileLine(p: WorkloadProfile) -> text:
        let ops = do simR3(p.operationsPerSecond)
        let rr = do simR6(p.readRatio)
        let wr = do simR6(p.writeRatio)
        let rl = do simR3(p.readLatencyUs)
        let wl = do simR3(p.writeLatencyUs)
        let cpu = do simR6(p.cpuUtilization)
        let mem = do simR6(p.memoryUtilization)
        let score = do simR6(p.pressureScore)
        return "" + p.shardId + "|" + ops + "|" + rr + "|" + wr + "|" + rl + "|" + wl + "|" + cpu + "|" + mem + "|" + p.queueDepth + "|" + score

    # simFindProfile: the tests' "find the observation for `target`, turn it
    # into a WorkloadProfile" loop body.
    private proc simFindProfile(t: SimTick, target: ActionTarget) -> WorkloadProfileOption:
        let n = len(t.observations)
        let mut i = 0
        loop i < n:
            let o = t.observations[i]
            if o.shard.id == target.shardId && o.coordinate.x == target.coordinate.x && o.coordinate.y == target.coordinate.y:
                let profile = do workloadProfileFromMetrics(o.shard.id, o.coordinate, o.metrics)
                return WorkloadProfileOption{has: true, val: profile}
            i = i + 1
        let zero = do workloadProfileZero()
        return WorkloadProfileOption{has: false, val: zero}

    private proc simFleetLine(sim: Simulation) -> text:
        let fleet = do clusterStateFleetView(sim.world)
        let nodes = do fleetViewNodesSortedById(fleet)
        let n = len(nodes)
        let mut s = "gen=" + fleet.generation + "|"
        let mut i = 0
        loop i < n:
            let st = nodes[i]
            let cpu = do simR6(st.cpuUtilization)
            let mem = do simR6(st.memoryUtilization)
            s = s + st.id.value + ":" + st.region + ":" + st.condition + ":" + st.hostedPlacements + ":" + st.placementCapacity + ":" + cpu + ":" + mem + ";"
            i = i + 1
        return s

    private proc simTopoLine(sim: Simulation) -> text:
        let topology = do clusterStateTopology(sim.world)
        let n = len(topology.placements)
        let mut s = ""
        let mut i = 0
        loop i < n:
            let p = topology.placements[i]
            if i > 0:
                s = s + ";"
            s = s + p.shardId + ":" + p.coordinate.x + ":" + p.coordinate.y + ":" + p.dbmsId + ":" + p.region
            i = i + 1
        return s

    private proc simCellLine(world: ClusterState, target: ActionTarget) -> text:
        let cell = do clusterStateCell(world, target)
        let replicas = do ctrlJoinText(cell.val.replicas, ",")
        let staging = do ctrlJoinText(cell.val.staging, ",")
        let n = len(world.nodes)
        let mut hosted = ""
        let mut i = 0
        loop i < n:
            let count = do clusterStateHostedPlacements(world, world.nodes[i].id.value)
            if i > 0:
                hosted = hosted + ","
            hosted = hosted + world.nodes[i].id.value + "=" + count
            i = i + 1
        return cell.val.owner + "|" + replicas + "|" + staging + "|" + world.generation + "|" + hosted

    private proc simClusterDump(world: ClusterState) -> text:
        let mut s = ""
        let nodeCount = len(world.nodes)
        let mut i = 0
        loop i < nodeCount:
            let n = world.nodes[i]
            let online = do ctrlBoolText(n.online)
            let reachable = do ctrlBoolText(n.reachable)
            s = s + "N:" + n.id.value + ":" + n.region + ":" + online + ":" + reachable + ":" + n.placementCapacity + ":" + floor(n.capacityOps) + ";"
            i = i + 1
        let cellCount = len(world.cells)
        let mut c = 0
        loop c < cellCount:
            let cell = world.cells[c]
            let replicas = do ctrlJoinText(cell.replicas, ",")
            let staging = do ctrlJoinText(cell.staging, ",")
            let scale = do simR6(cell.scale)
            let hot = do simR3(cell.hotMultiplier)
            s = s + "C:" + cell.target.shardId + ":" + cell.target.coordinate.x + ":" + cell.target.coordinate.y + ":" + cell.workload.id + ":" + cell.workload.class + ":" + cell.owner + ":" + replicas + ":" + staging + ":" + scale + ":" + cell.bytes + ":" + hot + ":" + cell.phaseOffsetMs + ";"
            c = c + 1
        return s + "G:" + world.generation + ":" + world.transferBytesPerMs

    private proc simFaultsLine(faults: [Fault]) -> text:
        let n = len(faults)
        let mut s = ""
        let mut i = 0
        loop i < n:
            let d = do faultDisplay(faults[i])
            if i > 0:
                s = s + ";"
            s = s + d
            i = i + 1
        return s

    private proc simDbmsIdsLine(ids: [DbmsId]) -> text:
        let joined = do ctrlDbmsIdsText(ids)
        return joined

    # A: `ClusterState::build` for spec() — every node and cell, every RNG
    # draw's effect (class, scale, phase offset), bytes, owner.
    proc demoClusterBuild() -> text:
        let spec = do simTestSpec()
        let sim = do simulationNew(spec)
        let dump = do simClusterDump(sim.world)
        return dump

    proc demoDefaultCluster() -> text:
        let spec = do clusterSpecDefault()
        let sim = do simulationNew(spec)
        let dump = do simClusterDump(sim.world)
        return dump

    # A2: targets / fleet_view / topology / now_ms / least_loaded_node at
    # construction, plus node_count and with_seed.
    proc demoClusterAccessors() -> text:
        let spec = do simTestSpec()
        let sim = do simulationNew(spec)
        let targets = do simulationTargets(sim)
        let n = len(targets)
        let mut targetText = ""
        let mut i = 0
        loop i < n:
            let d = do actionTargetDisplay(targets[i])
            if i > 0:
                targetText = targetText + ";"
            targetText = targetText + d
            i = i + 1
        let fleet = do simFleetLine(sim)
        let topo = do simTopoLine(sim)
        let now = do simulationNowMs(sim)
        let none = do clusterStateLeastLoadedNode(sim.world, [])
        let excl = do clusterStateLeastLoadedNode(sim.world, ["us-east-db-0"])
        let count = do clusterSpecNodeCount(spec)
        let reseeded = do clusterSpecWithSeed(spec, 7)
        let generation = do simulationGeneration(sim)
        return targetText + "#" + fleet + "#" + topo + "#" + now + "#" + none.val.value + "#" + excl.val.value + "#" + count + "#" + reseeded.seed + "#" + reseeded.cellsPerShard + "#" + generation

    # B: the_same_seed_reproduces_the_run_exactly — two builds of the same
    # 40-tick run with a HotShard at +5s and a NodeLoss at +12s must agree
    # tick for tick; the per-tick digest is then compared with Rust's.
    private proc simTestOneBuild() -> SimulationRunResult:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let hot = do faultHotShard(targets[1], 6.0, 20000)
        let sim1 = do simulationScheduleFault(sim0, spec.startMs + 5000, hot)
        let loss = do faultNodeLoss(DbmsId{value: "us-west-db-0"})
        let sim2 = do simulationScheduleFault(sim1, spec.startMs + 12000, loss)
        let run = do simulationRun(sim2, 40)
        return run

    proc demoSameSeed() -> text:
        let a = do simTestOneBuild()
        let b = do simTestOneBuild()
        let n = len(a.ticks)
        let mut same = len(b.ticks) == n
        let mut lines = ""
        let mut i = 0
        loop i < n:
            let fa = do simTickFull(a.ticks[i])
            let fb = do simTickFull(b.ticks[i])
            if fa != fb:
                same = false
            let line = do simTickLine(a.ticks[i])
            if i > 0:
                lines = lines + "/"
            lines = lines + line
            i = i + 1
        let sameText = do ctrlBoolText(same)
        return sameText + "|" + lines

    proc demoSameSeedFull() -> text:
        let a = do simTestOneBuild()
        let f0 = do simTickFull(a.ticks[0])
        let f5 = do simTickFull(a.ticks[5])
        let f12 = do simTickFull(a.ticks[12])
        let f39 = do simTickFull(a.ticks[39])
        let faults5 = do simFaultsLine(a.ticks[4].faults)
        let faults12 = do simFaultsLine(a.ticks[11].faults)
        return f0 + "#" + f5 + "#" + f12 + "#" + f39 + "#" + faults5 + "#" + faults12

    proc demoSameSeedMessages() -> text:
        let a = do simTestOneBuild()
        let m0 = do simMessagesLine(a.ticks[0])
        let m1 = do simMessagesLine(a.ticks[1])
        let m12 = do simMessagesLine(a.ticks[11])
        return m0 + "#" + m1 + "#" + m12

    # C: a_different_seed_produces_a_different_run.
    proc demoDifferentSeed() -> text:
        let spec = do simTestSpec()
        let a0 = do simulationNew(spec)
        let spec7 = do clusterSpecWithSeed(spec, 7)
        let b0 = do simulationNew(spec7)
        let ra = do simulationRun(a0, 20)
        let rb = do simulationRun(b0, 20)
        let mut differ = false
        let mut i = 0
        loop i < 20:
            let fa = do simTickFull(ra.ticks[i])
            let fb = do simTickFull(rb.ticks[i])
            if fa != fb:
                differ = true
            i = i + 1
        let differText = do ctrlBoolText(differ)
        let t0 = do simTickLine(rb.ticks[0])
        let t19 = do simTickLine(rb.ticks[19])
        return differText + "|" + t0 + "|" + t19

    # D: a_hot_shard_shows_up_as_pressure_on_its_cell — 8x for 30s, the
    # cell's reported ops must exceed 4x its quiet baseline.
    proc demoHotShard() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let before = do simulationStep(sim0)
        let quiet = do simFindProfile(before.tick, target)
        let hot = do faultHotShard(target, 8.0, 30000)
        let injected = do simulationInject(before.simulation, hot)
        let after = do simulationStep(injected)
        let loud = do simFindProfile(after.tick, target)
        let q = do simR3(quiet.val.operationsPerSecond)
        let l = do simR3(loud.val.operationsPerSecond)
        let louder = do ctrlBoolText(loud.val.operationsPerSecond > quiet.val.operationsPerSecond * 4.0)
        return "" + q + "|" + l + "|" + louder

    # E: a_lost_node_goes_silent_rather_than_reporting_zeroes — plus the
    # fleet view, the message stream without it, and its recovery.
    proc demoLostNode() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let lost = DbmsId{value: "us-east-db-0"}
        let before = do simulationStep(sim0)
        let n = len(before.simulation.world.cells)
        let mut owned = 0
        let mut i = 0
        loop i < n:
            if before.simulation.world.cells[i].owner == lost.value:
                owned = owned + 1
            i = i + 1
        let loss = do faultNodeLoss(lost)
        let injected = do simulationInject(before.simulation, loss)
        let after = do simulationStep(injected)
        let fleet = do clusterStateFleetView(after.simulation.world)
        let status = do fleetViewGet(fleet, lost)
        let fleetLine = do simFleetLine(after.simulation)
        let msgs = do simMessagesLine(after.tick)
        let recovery = do faultNodeRecovery(lost)
        let recovering = do simulationInject(after.simulation, recovery)
        let recovered = do simulationStep(recovering)
        let recoveredFleet = do simFleetLine(recovered.simulation)
        return "" + len(before.tick.observations) + "|" + owned + "|" + len(after.tick.observations) + "|" + status.status.condition + "#" + fleetLine + "#" + msgs + "#" + len(recovered.tick.observations) + "|" + recoveredFleet

    # F: a_partitioned_region_keeps_serving_but_stops_reporting.
    proc demoPartition() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let before = do simulationStep(sim0)
        let partition = do faultPartitionRegion("us-west")
        let cut = do simulationInject(before.simulation, partition)
        let after = do simulationStep(cut)
        let cells = len(after.simulation.world.cells)
        let midFleet = do simFleetLine(after.simulation)
        let heal = do faultHealRegion("us-west")
        let healing = do simulationInject(after.simulation, heal)
        let healed = do simulationStep(healing)
        let healedFleet = do simFleetLine(healed.simulation)
        return "" + len(before.tick.observations) + "|" + len(after.tick.observations) + "|" + cells + "|" + midFleet + "#" + len(healed.tick.observations) + "|" + healedFleet

    # G: the_optimizer_runs_against_the_simulator_unchanged — 40x for 60s,
    # ten ticks into the analyzer, then the optimizer decides on the hot
    # cell's profile against the simulated topology; the decision's
    # coordinate must be the target's.
    proc demoOptimizer() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let hot = do faultHotShard(target, 40.0, 60000)
        let injected = do simulationInject(sim0, hot)
        let run = do simulationRun(injected, 10)
        let empty = do workloadAnalyzerNew()
        let mut analyzer = empty
        let mut t = 0
        loop t < 10:
            let m = len(run.ticks[t].observations)
            let mut o = 0
            loop o < m:
                let observed = do workloadAnalyzerObserve(analyzer, run.ticks[t].observations[o])
                analyzer = observed
                o = o + 1
            t = t + 1
        let topology = do simulationTopology(run.simulation)
        let optimizer = do workloadOptimizerDefault()
        let hotProfile = do workloadAnalyzerProfile(analyzer, target.shardId, target.coordinate)
        let profileLine = do simProfileLine(hotProfile.val)
        let decision = do workloadOptimizerOptimizeFromTopology(optimizer, hotProfile.val, topology)
        let label = do controllerPlanActionLabel(decision.action)
        let gain = do simR6(decision.expectedGain)
        let cost = do simR6(decision.estimatedCost)
        let confidence = do simR6(decision.confidence)
        let count = do workloadAnalyzerLen(analyzer)
        let sameCoordinate = do ctrlBoolText(decision.coordinate.x == target.coordinate.x && decision.coordinate.y == target.coordinate.y)
        return profileLine + "#" + decision.shardId + "|" + decision.coordinate.x + "|" + decision.coordinate.y + "|" + label + "|" + gain + "|" + cost + "|" + confidence + "#" + count + "#" + sameCoordinate

    # H: the_controller_executes_and_measures_against_the_simulation — the
    # full loop through the controller seam (fabricControllerSubmit/Advance over
    # the "simulated-placement" Executor): observe, decide (Move to the
    # least-loaded node), validate, execute phase by phase against the
    # simulated world, then measure Improved after the hotspot passes.
    proc demoControllerExecutesAndMeasures() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let hot = do faultHotShard(target, 30.0, 400000)
        let injected = do simulationInject(sim0, hot)
        let warm = do simulationRun(injected, 5)
        let emptyProfile = do workloadProfileZero()
        let mut baseline = emptyProfile
        let mut t = 0
        loop t < 5:
            let found = do simFindProfile(warm.ticks[t], target)
            if found.has:
                baseline = found.val
            t = t + 1
        let mut sim = warm.simulation
        let baselineLine = do simProfileLine(baseline)
        let ownerCell = do clusterStateCell(sim.world, target)
        let owner = ownerCell.val.owner
        let destination = do clusterStateLeastLoadedNode(sim.world, [owner])
        let now5 = do simulationNowMs(sim)
        let fleet5 = do simFleetLine(sim)
        let base = do fabricControllerDefault()
        let registered = do simulationRegisterExecutor(sim, base)
        let topology0 = do simulationTopology(sim)
        let seeded = do fabricControllerSeedReplicas(registered, topology0)
        let fleet0 = do simulationFleetView(sim)
        let move = do optimizationActionMove(destination.val.value)
        let decision = OptimizationDecision{shardId: target.shardId, coordinate: target.coordinate, action: move, expectedGain: 0.30, estimatedCost: 0.05, confidence: 0.95}
        let envelope = do decisionEnvelopeNew(decision, now5, fleet0.generation)
        let view0 = do controlPlaneViewNew(topology0, fleet0, now5)
        let lent0 = do simulationLendWorld(sim, seeded)
        let submitted = do fabricControllerSubmit(lent0, envelope, baseline, view0)
        let mut controller = submitted.controller
        let reclaimed0 = do simulationReclaimWorld(sim, controller)
        sim = reclaimed0
        let admitted = do fabricControllerRecord(controller, submitted.id)
        let idText = do actionIdDisplay(submitted.id)
        let planPhases = do ctrlJoinText(admitted.val.plan.phases, ",")
        let planAdds = do simDbmsIdsLine(admitted.val.plan.adds)
        let planRemoves = do simDbmsIdsLine(admitted.val.plan.removes)
        let submittedOk = do ctrlBoolText(submitted.ok)
        let planLine = idText + "|plan=" + planPhases + "|adds=" + planAdds + "|removes=" + planRemoves + "|bytes=" + admitted.val.plan.estimatedBytes + "|dur=" + admitted.val.plan.estimatedDurationMs + "|state=" + admitted.val.execState + "|ok=" + submittedOk
        let mut trace = ""
        let mut i = 0
        loop i < 20:
            let stepped = do simulationStep(sim)
            sim = stepped.simulation
            let topology = do simulationTopology(sim)
            let fleet = do simulationFleetView(sim)
            let now = do simulationNowMs(sim)
            let view = do controlPlaneViewNew(topology, fleet, now)
            let lent = do simulationLendWorld(sim, controller)
            let advanced = do fabricControllerAdvance(lent, submitted.id, view)
            controller = advanced.controller
            let synced = do simulationReclaimWorld(sim, controller)
            sim = synced
            let record = do fabricControllerRecord(controller, submitted.id)
            let mut extra = ""
            if advanced.execState == "running":
                let fraction = do simR6(record.val.runningFraction)
                extra = record.val.runningPhase + ":" + fraction
            let cellLine = do simCellLine(sim.world, target)
            trace = trace + now + "=" + advanced.execState + ":" + extra + ";[" + cellLine + "]"
            i = i + 1
        let record20 = do fabricControllerRecord(controller, submitted.id)
        let cell20 = do clusterStateCell(sim.world, target)
        let change = do executionRecordPlacementChange(record20.val)
        let mut changeText = ""
        if change.has:
            changeText = change.val.fromNode.value + ">" + change.val.toNode.value + ":" + change.val.toRegion
        let mut committed = 0
        if record20.val.hasCommittedAtMs:
            committed = record20.val.committedAtMs
        let after20 = record20.val.execState + "|" + cell20.val.owner + "|" + changeText + "|" + committed
        let fleet25 = do simFleetLine(sim)
        let topo25 = do simTopoLine(sim)
        let ledgerIds = do replicaLedgerReplicas(controller.ledger, target)
        let ledgerLine = do simDbmsIdsLine(ledgerIds)
        let cool = do faultHotShard(target, 1.0, 0)
        let cooled = do simulationInject(sim, cool)
        let settled = do simulationRun(cooled, 40)
        let tail = do simulationRun(settled.simulation, 2)
        sim = tail.simulation
        let mut after = emptyProfile
        let mut k = 0
        loop k < 2:
            let found = do simFindProfile(tail.ticks[k], target)
            if found.has:
                after = found.val
            k = k + 1
        let afterLine = do simProfileLine(after)
        let topologyEnd = do simulationTopology(sim)
        let fleetEnd = do simulationFleetView(sim)
        let nowEnd = do simulationNowMs(sim)
        let viewEnd = do controlPlaneViewNew(topologyEnd, fleetEnd, nowEnd)
        let measured = do fabricControllerMeasure(controller, submitted.id, after, viewEnd)
        controller = measured.controller
        let realized = do simR6(measured.outcome.realizedGain)
        let ratio = do simR6(measured.outcome.gainRatio)
        let latency = do simR3(measured.outcome.latencyDeltaUs)
        let throughput = do simR3(measured.outcome.throughputDelta)
        let expected = do simR6(measured.outcome.expectedGain)
        let measuredOk = do ctrlBoolText(measured.ok)
        let isMeasured = do outcomeVerdictIsMeasured(measured.outcome.verdict)
        let isMeasuredText = do ctrlBoolText(isMeasured)
        let outcomeLine = "" + nowEnd + "|" + measured.outcome.verdict + "|" + realized + "|" + ratio + "|" + latency + "|" + throughput + "|" + expected + "|" + measuredOk + "|" + isMeasuredText
        let reports = do fabricControllerReports(controller)
        let reportsLine = "" + len(reports) + "|" + reports[0].mechanism + "|" + reports[0].actionLabel + "|" + reports[0].admittedAtMs + "|" + reports[0].concludedAtMs + "|" + reports[0].verdict
        let fleetEndLine = do simFleetLine(sim)
        let cellEnd = do simCellLine(sim.world, target)
        return baselineLine + "#" + owner + "|" + destination.val.value + "|" + now5 + "#" + fleet5 + "#" + planLine + "#" + trace + "#" + after20 + "#" + fleet25 + "#" + topo25 + "#" + ledgerLine + "#" + afterLine + "#" + outcomeLine + "#" + reportsLine + "#" + fleetEndLine + "#" + cellEnd

    # I: a_split_is_declined_rather_than_faked — `supports` says no, the
    # controller refuses with NoMechanism.
    proc demoSplitDeclined() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let stepped = do simulationStep(sim0)
        let sim = stepped.simulation
        let base = do fabricControllerDefault()
        let registered = do simulationRegisterExecutor(sim, base)
        let topology = do simulationTopology(sim)
        let seeded = do fabricControllerSeedReplicas(registered, topology)
        let fleet = do simulationFleetView(sim)
        let now = do simulationNowMs(sim)
        let view = do controlPlaneViewNew(topology, fleet, now)
        let split = do optimizationActionSplit()
        let decision = OptimizationDecision{shardId: target.shardId, coordinate: target.coordinate, action: split, expectedGain: 1.0, estimatedCost: 0.1, confidence: 0.99}
        let envelope = do decisionEnvelopeNew(decision, now, fleet.generation)
        let metrics = do workloadMetricsDefault()
        let profile = do workloadProfileFromMetrics(target.shardId, target.coordinate, metrics)
        let lent = do simulationLendWorld(sim, seeded)
        let submitted = do fabricControllerSubmit(lent, envelope, profile, view)
        let errText = do validationErrorDisplay(submitted.err)
        let mechanisms = do fabricControllerMechanisms(seeded)
        let mechanismsText = do ctrlJoinText(mechanisms, ",")
        let okText = do ctrlBoolText(submitted.ok)
        return errText + "#" + mechanismsText + "#" + okText + "|" + submitted.err.kind

    # simTestRequest: the harness's `request(sim, target, action, dest)` —
    # source = the cell's owner placement, replicas = [owner].
    private proc simTestRequest(sim: Simulation, target: ActionTarget, action: OptimizationAction, hasDestination: bool, destination: text) -> PlanRequest:
        let cell = do clusterStateCell(sim.world, target)
        let node = do clusterStateNode(sim.world, cell.val.owner)
        let source = do placementNew(node.val.id.value, target.shardId, target.coordinate, node.val.region)
        let now = do simulationNowMs(sim)
        let request = do planRequestNew(target, action, source, hasDestination, DbmsId{value: destination}, [node.val.id], now)
        return request

    private proc simProgressText(r: SimExecutorPollResult) -> text:
        if !r.ok:
            let faultText = do executionFaultDisplay(r.fault)
            return "err:" + faultText
        if r.progress.kind == "Running":
            let fraction = do simR6(r.progress.fraction)
            return "running:" + fraction
        return "complete"

    private proc simRollbackText(r: SimExecutorAbortResult) -> text:
        if !r.ok:
            let faultText = do executionFaultDisplay(r.fault)
            return "err:" + faultText
        if r.outcome.kind == "Irreversible":
            return "Irreversible:" + r.outcome.reason
        return "Restored"

    private proc simBeginText(r: SimExecutorBeginResult) -> text:
        if r.ok:
            return "Ok(())"
        let faultText = do executionFaultDisplay(r.fault)
        return "Err(\"" + faultText + "\")"

    # J: executor.rs hand-traced through the trait, in the harness's order:
    # name/supports; a Replicate, Isolate, Colocate plan; the four plan
    # refusals; a Move driven phase by phase with the exact poll instants
    # (running fractions, completions, the world after each); abort before
    # and after cutover; abort with no job; a Replicate that promotes; a
    # destination lost mid-flight; the tick after the loss; set_owner to the
    # same node and drop_copy of the owner as no-ops.
    proc demoExecutorTraces() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let t1 = targets[1]
        let t2 = targets[2]
        let stepped = do simulationStep(sim0)
        let mut sim = stepped.simulation
        let mut world = sim.world
        let ex0 = do simulationExecutor(sim)
        let mut ex = ex0
        let name = do simExecutorName(ex)
        let replicateX = do optimizationActionReplicate("x")
        let moveX = do optimizationActionMove("x")
        let isolate = do optimizationActionIsolate()
        let colocate = do optimizationActionColocate(Coordinate{x: 1, y: 1})
        let split = do optimizationActionSplit()
        let noAction = do optimizationActionNoAction()
        let s1 = do simExecutorSupports(ex, replicateX)
        let s2 = do simExecutorSupports(ex, moveX)
        let s3 = do simExecutorSupports(ex, isolate)
        let s4 = do simExecutorSupports(ex, colocate)
        let s5 = do simExecutorSupports(ex, split)
        let s6 = do simExecutorSupports(ex, noAction)
        let s1t = do ctrlBoolText(s1)
        let s2t = do ctrlBoolText(s2)
        let s3t = do ctrlBoolText(s3)
        let s4t = do ctrlBoolText(s4)
        let s5t = do ctrlBoolText(s5)
        let s6t = do ctrlBoolText(s6)
        let nameLine = name + "|supports=" + s1t + s2t + s3t + s4t + s5t + s6t
        let replicateW1 = do optimizationActionReplicate("us-west-db-1")
        let repReq = do simTestRequest(sim, target, replicateW1, true, "us-west-db-1")
        let rep = do simExecutorPlan(ex, repReq)
        let repPhases = do ctrlJoinText(rep.value.phases, ",")
        let repAdds = do simDbmsIdsLine(rep.value.adds)
        let repLine = repPhases + "|" + repAdds + "|" + len(rep.value.removes) + "|" + rep.value.estimatedBytes + "|" + rep.value.estimatedDurationMs + "|" + rep.value.scope
        let isoReq = do simTestRequest(sim, target, isolate, false, "")
        let iso = do simExecutorPlan(ex, isoReq)
        let isoPhases = do ctrlJoinText(iso.value.phases, ",")
        let isoAdds = do simDbmsIdsLine(iso.value.adds)
        let isoRemoves = do simDbmsIdsLine(iso.value.removes)
        let isoLine = isoPhases + "|" + isoAdds + "|" + isoRemoves + "|" + iso.value.estimatedBytes + "|" + iso.value.estimatedDurationMs
        let colocateE1 = do optimizationActionColocate(Coordinate{x: 1, y: 0})
        let colReq = do simTestRequest(sim, target, colocateE1, true, "us-east-db-1")
        let col = do simExecutorPlan(ex, colReq)
        let colLine = "" + len(col.value.phases) + "|" + col.value.adds[0].value + "|" + col.value.removes[0].value
        let splitReq = do simTestRequest(sim, target, split, false, "")
        let splitPlan = do simExecutorPlan(ex, splitReq)
        let splitLine = do planErrorDisplay(splitPlan.err)
        let noActionReq = do simTestRequest(sim, target, noAction, false, "")
        let noActionPlan = do simExecutorPlan(ex, noActionReq)
        let noActionLine = do planErrorDisplay(noActionPlan.err)
        let noDestReq = do simTestRequest(sim, target, moveX, false, "")
        let noDestPlan = do simExecutorPlan(ex, noDestReq)
        let noDestLine = do planErrorDisplay(noDestPlan.err)
        let bogusBase = do simTestRequest(sim, target, moveX, true, "x")
        let bogus = PlanRequest{target: ActionTarget{shardId: 99, coordinate: Coordinate{x: 0, y: 0}}, action: bogusBase.action, source: bogusBase.source, hasDestination: bogusBase.hasDestination, destination: bogusBase.destination, replicas: bogusBase.replicas, requestedAtMs: bogusBase.requestedAtMs}
        let bogusPlan = do simExecutorPlan(ex, bogus)
        let missingLine = do planErrorDisplay(bogusPlan.err)
        let moveW1 = do optimizationActionMove("us-west-db-1")
        let mvReq = do simTestRequest(sim, target, moveW1, true, "us-west-db-1")
        let mvPlan = do simExecutorPlan(ex, mvReq)
        let mv = mvPlan.value
        let t0 = do simulationNowMs(sim)
        let unstarted = do simExecutorPollPhase(ex, mv, "prepare", t0)
        let unstartedLine = do simProgressText(unstarted)
        let beganPrepare = do simExecutorBeginPhase(ex, mv, "prepare", t0)
        ex = beganPrepare.executor
        world = beganPrepare.executor.world
        let beganPrepareLine = do simBeginText(beganPrepare)
        let afterStage = do simCellLine(world, target)
        let wrongPhase = do simExecutorPollPhase(ex, mv, "transfer", t0)
        let wrongPhaseLine = do simProgressText(wrongPhase)
        let prep0 = do simExecutorPollPhase(ex, mv, "prepare", t0)
        ex = prep0.executor
        world = prep0.executor.world
        let prep0Line = do simProgressText(prep0)
        let prep1000 = do simExecutorPollPhase(ex, mv, "prepare", t0 + 1000)
        ex = prep1000.executor
        world = prep1000.executor.world
        let prep1000Line = do simProgressText(prep1000)
        let prep2000 = do simExecutorPollPhase(ex, mv, "prepare", t0 + 2000)
        ex = prep2000.executor
        world = prep2000.executor.world
        let prep2000Line = do simProgressText(prep2000)
        let beganTransfer = do simExecutorBeginPhase(ex, mv, "transfer", t0 + 2000)
        ex = beganTransfer.executor
        world = beganTransfer.executor.world
        let xfer0 = do simExecutorPollPhase(ex, mv, "transfer", t0 + 2000)
        ex = xfer0.executor
        world = xfer0.executor.world
        let xfer0Line = do simProgressText(xfer0)
        let xfer5 = do simExecutorPollPhase(ex, mv, "transfer", t0 + 2005)
        ex = xfer5.executor
        world = xfer5.executor.world
        let xfer5Line = do simProgressText(xfer5)
        let xfer1000 = do simExecutorPollPhase(ex, mv, "transfer", t0 + 3000)
        ex = xfer1000.executor
        world = xfer1000.executor.world
        let xfer1000Line = do simProgressText(xfer1000)
        let ex2a = do simExecutorNew(world)
        let began2 = do simExecutorBeginPhase(ex2a, mv, "prepare", t0)
        world = began2.executor.world
        let abortPre = do simExecutorAbort(began2.executor, mv, ["prepare"], t0)
        world = abortPre.executor.world
        let abortPreText = do simRollbackText(abortPre)
        let abortPreCell = do simCellLine(world, target)
        let abortUnknownCut = do simExecutorAbort(abortPre.executor, mv, ["prepare", "transfer", "cutover"], t0)
        world = abortUnknownCut.executor.world
        let abortUnknownCutText = do simRollbackText(abortUnknownCut)
        let abortUnknownNoCut = do simExecutorAbort(abortUnknownCut.executor, mv, [], t0)
        world = abortUnknownNoCut.executor.world
        let abortUnknownNoCutText = do simRollbackText(abortUnknownNoCut)
        let rejoined = do simExecutorWithWorld(ex, world)
        ex = rejoined
        let beganCutover = do simExecutorBeginPhase(ex, mv, "cutover", t0 + 3000)
        ex = beganCutover.executor
        world = beganCutover.executor.world
        let cut = do simExecutorPollPhase(ex, mv, "cutover", t0 + 3000)
        ex = cut.executor
        world = cut.executor.world
        let cutText = do simProgressText(cut)
        let cutCell = do simCellLine(world, target)
        let beganCleanup = do simExecutorBeginPhase(ex, mv, "cleanup", t0 + 3000)
        ex = beganCleanup.executor
        world = beganCleanup.executor.world
        let clean0 = do simExecutorPollPhase(ex, mv, "cleanup", t0 + 3000)
        ex = clean0.executor
        world = clean0.executor.world
        let clean0Text = do simProgressText(clean0)
        let clean1000 = do simExecutorPollPhase(ex, mv, "cleanup", t0 + 4000)
        ex = clean1000.executor
        world = clean1000.executor.world
        let clean1000Text = do simProgressText(clean1000)
        let cleanCell = do simCellLine(world, target)
        let abortPost = do simExecutorAbort(ex, mv, ["prepare", "transfer", "cutover", "cleanup"], t0 + 4000)
        ex = abortPost.executor
        world = abortPost.executor.world
        let abortPostText = do simRollbackText(abortPost)
        let abortPostCell = do simCellLine(world, target)
        let replicateW0 = do optimizationActionReplicate("us-west-db-0")
        let synced1 = do simulationWithState(sim, world)
        sim = synced1
        let rpReq = do simTestRequest(sim, t1, replicateW0, true, "us-west-db-0")
        let rpPlan = do simExecutorPlan(ex, rpReq)
        let rp = rpPlan.value
        let rpB1 = do simExecutorBeginPhase(ex, rp, "prepare", t0)
        ex = rpB1.executor
        world = rpB1.executor.world
        let rpP1 = do simExecutorPollPhase(ex, rp, "prepare", t0 + 2000)
        ex = rpP1.executor
        world = rpP1.executor.world
        let rpB2 = do simExecutorBeginPhase(ex, rp, "transfer", t0 + 2000)
        ex = rpB2.executor
        world = rpB2.executor.world
        let rpP2 = do simExecutorPollPhase(ex, rp, "transfer", t0 + 3000)
        ex = rpP2.executor
        world = rpP2.executor.world
        let rpB3 = do simExecutorBeginPhase(ex, rp, "cutover", t0 + 3000)
        ex = rpB3.executor
        world = rpB3.executor.world
        let rpCut = do simExecutorPollPhase(ex, rp, "cutover", t0 + 3000)
        ex = rpCut.executor
        world = rpCut.executor.world
        let rpCutText = do simProgressText(rpCut)
        let rpCutCell = do simCellLine(world, t1)
        let rpAbort = do simExecutorAbort(ex, rp, ["cutover"], t0 + 3000)
        ex = rpAbort.executor
        world = rpAbort.executor.world
        let rpAbortText = do simRollbackText(rpAbort)
        let synced2 = do simulationWithState(sim, world)
        sim = synced2
        let mpReq = do simTestRequest(sim, t2, moveW1, true, "us-west-db-1")
        let mpPlan = do simExecutorPlan(ex, mpReq)
        let mp = mpPlan.value
        let mpB1 = do simExecutorBeginPhase(ex, mp, "prepare", t0)
        ex = mpB1.executor
        world = mpB1.executor.world
        let synced3 = do simulationWithState(sim, world)
        let lossW1 = do faultNodeLoss(DbmsId{value: "us-west-db-1"})
        let lost = do simulationInject(synced3, lossW1)
        sim = lost
        world = lost.world
        let lostShared = do simExecutorWithWorld(ex, world)
        ex = lostShared
        let lostPoll = do simExecutorPollPhase(ex, mp, "prepare", t0 + 2000)
        ex = lostPoll.executor
        world = lostPoll.executor.world
        let lostPollText = do simProgressText(lostPoll)
        let lostBegin = do simExecutorBeginPhase(ex, mp, "transfer", t0 + 2000)
        ex = lostBegin.executor
        world = lostBegin.executor.world
        let lostBeginText = do simBeginText(lostBegin)
        let lostAbort = do simExecutorAbort(ex, mp, [], t0 + 2000)
        ex = lostAbort.executor
        world = lostAbort.executor.world
        let lostAbortText = do simRollbackText(lostAbort)
        let lostAbortCell = do simCellLine(world, t2)
        let synced4 = do simulationWithState(sim, world)
        let afterLoss = do simulationStep(synced4)
        sim = afterLoss.simulation
        world = sim.world
        let tickAfterLoss = do simTickLine(afterLoss.tick)
        let fleetAfterLoss = do simFleetLine(sim)
        let t1Cell = do clusterStateCell(world, t1)
        let sameOwner = do clusterStateSetOwner(world, t1, t1Cell.val.owner)
        let droppedOwner = do clusterStateDropCopy(sameOwner.world, t1, t1Cell.val.owner)
        let t1After = do clusterStateCell(droppedOwner, t1)
        let sameText = do ctrlBoolText(sameOwner.changed)
        let t1Replicas = do ctrlJoinText(t1After.val.replicas, ",")
        let setOwnerLine = sameText + "|" + t1After.val.owner + "|" + t1Replicas + "|" + droppedOwner.generation
        return nameLine + "#" + repLine + "#" + isoLine + "#" + colLine + "#" + splitLine + "#" + noActionLine + "#" + noDestLine + "#" + missingLine + "#" + unstartedLine + "#" + beganPrepareLine + "#" + afterStage + "#" + wrongPhaseLine + "#" + prep0Line + "|" + prep1000Line + "|" + prep2000Line + "#" + xfer0Line + "|" + xfer5Line + "|" + xfer1000Line + "#" + abortPreText + "|" + abortPreCell + "#" + abortUnknownCutText + "#" + abortUnknownNoCutText + "#" + cutText + "|" + cutCell + "#" + clean0Text + "|" + clean1000Text + "|" + cleanCell + "#" + abortPostText + "|" + abortPostCell + "#" + rpCutText + "|" + rpCutCell + "#" + rpAbortText + "#" + lostPollText + "#" + lostBeginText + "#" + lostAbortText + "|" + lostAbortCell + "#" + tickAfterLoss + "#" + fleetAfterLoss + "#" + setOwnerLine

    # K: a staged copy of a hot cell takes the writes and shows as pressure
    # on the destination; a promoted copy then shares the reads; a hotspot
    # with a 1.5s duration expires on the second tick after it.
    proc demoStagedPressure() -> text:
        let spec = do simTestSpec()
        let sim0 = do simulationNew(spec)
        let targets = do simulationTargets(sim0)
        let target = targets[0]
        let hot = do faultHotShard(target, 30.0, 400000)
        let injected = do simulationInject(sim0, hot)
        let first = do simulationStep(injected)
        let stagedWorld = do clusterStateStage(first.simulation.world, target, "us-west-db-1")
        let staged = do simulationWithState(first.simulation, stagedWorld)
        let tick = do simulationStep(staged)
        let tickLine = do simTickLine(tick.tick)
        let fleetLine = do simFleetLine(tick.simulation)
        let full = do simTickFull(tick.tick)
        let promotedWorld = do clusterStatePromote(tick.simulation.world, target, "us-west-db-1")
        let promoted = do simulationWithState(tick.simulation, promotedWorld)
        let tick2 = do simulationStep(promoted)
        let tick2Line = do simTickLine(tick2.tick)
        let fleet2 = do simFleetLine(tick2.simulation)
        let promotedCell = do simCellLine(tick2.simulation.world, target)
        let promotedFull = do simTickFull(tick2.tick)
        let brief = do faultHotShard(target, 2.0, 1500)
        let heated = do simulationInject(tick2.simulation, brief)
        let e1 = do simulationStep(heated)
        let e2 = do simulationStep(e1.simulation)
        let e3 = do simulationStep(e2.simulation)
        let e1Line = do simTickLine(e1.tick)
        let e2Line = do simTickLine(e2.tick)
        let e3Line = do simTickLine(e3.tick)
        let cell = do clusterStateCell(e3.simulation.world, target)
        let hotNow = do simR3(cell.val.hotMultiplier)
        return tickLine + "#" + fleetLine + "#" + full + "#" + tick2Line + "|" + fleet2 + "#" + promotedCell + "#" + promotedFull + "#" + e1Line + "|" + e2Line + "|" + e3Line + "#" + hotNow + "|" + cell.val.hotUntilMs

    state demoClusterBuildResult: text = ""
    state demoDefaultClusterResult: text = ""
    state demoClusterAccessorsResult: text = ""
    state demoSameSeedResult: text = ""
    state demoSameSeedFullResult: text = ""
    state demoSameSeedMessagesResult: text = ""
    state demoDifferentSeedResult: text = ""
    state demoHotShardResult: text = ""
    state demoLostNodeResult: text = ""
    state demoPartitionResult: text = ""
    state demoOptimizerResult: text = ""
    state demoControllerExecutesAndMeasuresResult: text = ""
    state demoSplitDeclinedResult: text = ""
    state demoExecutorTracesResult: text = ""
    state demoStagedPressureResult: text = ""

    action runFabricSimulatorDemo():
        let r1 = do demoClusterBuild()
        let r2 = do demoDefaultCluster()
        let r3 = do demoClusterAccessors()
        let r4 = do demoSameSeed()
        let r5 = do demoSameSeedFull()
        let r6 = do demoSameSeedMessages()
        let r7 = do demoDifferentSeed()
        let r8 = do demoHotShard()
        let r9 = do demoLostNode()
        let r10 = do demoPartition()
        let r11 = do demoOptimizer()
        let r12 = do demoControllerExecutesAndMeasures()
        let r13 = do demoSplitDeclined()
        let r14 = do demoExecutorTraces()
        let r15 = do demoStagedPressure()
        demoClusterBuildResult = r1
        demoDefaultClusterResult = r2
        demoClusterAccessorsResult = r3
        demoSameSeedResult = r4
        demoSameSeedFullResult = r5
        demoSameSeedMessagesResult = r6
        demoDifferentSeedResult = r7
        demoHotShardResult = r8
        demoLostNodeResult = r9
        demoPartitionResult = r10
        demoOptimizerResult = r11
        demoControllerExecutesAndMeasuresResult = r12
        demoSplitDeclinedResult = r13
        demoExecutorTracesResult = r14
        demoStagedPressureResult = r15

