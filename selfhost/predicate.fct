app PredicateSelfHost:
    # Self-hosting port of facetql/src/core/predicate.rs — the predicate-
    # pushdown evaluator FacetQL runs against one decoded row, deciding
    # whether that row matches a query's `where` clause without the caller
    # having to filter client-side.
    #
    # ============================================================
    # REWRITE NOTE (struct milestone): this file used to represent the
    # expression tree as a flat postorder `[int]` "arena" — `arena[5*i]` was
    # a node's numeric kind, `arena[5*i+1..4]` were four more slots whose
    # MEANING depended silently on that kind, and a child was "the node at
    # THIS int index." Reading it meant holding the whole slot-numbering
    # scheme in your head; nothing in the shape of the data said what any
    # slot was, because a `proc` had no way to construct a genuine
    # named-field value — only scalars, arrays, and maps of scalars. Now that
    # a proc can declare a real `struct` (see LANGUAGE.md's `proc` section),
    # the tree is an actual tree: a `Node` value with named fields, one of
    # which — `children: [Node]` — is a real array of the struct itself, so
    # a node's children are just... its children, not `arena[5*i+3]`. The
    # row this evaluator reads a field from was the same problem in
    # miniature (five parallel arrays, aligned by hand-maintained index —
    # rowNames/rowKinds/rowNums/rowTexts/rowBools); it is now one `[Field]`
    # array of named-field rows. Every op code that used to be a bare int
    # (`9 = Bin`, `2 = "=="`) is now the actual operator text — `node.kind ==
    # "bin"`, `node.op == "=="` — so a diagnostic, a debugger, or a reader's
    # own eyes see the operator, not a number that means the operator.
    #
    # The semantics below are unchanged from the arena version (itself a
    # faithful port of predicate.rs's `eval_at`/`eval_bin_op`/`values_equal`/
    # `truthy`) — only the representation changed. See git history for the
    # arena version if a byte-for-byte comparison is ever needed.
    #
    # ============================================================
    # Node: one expression tree node. `kind` says which of the shapes below
    # it is; every other field is always present (a struct literal must set
    # every field — see ast.Struct's doc) but only the ones that kind
    # actually uses are meaningful:
    #   kind == "num" | "bool" | "text" | "null"
    #       a literal. Its own payload field (numVal/boolVal/textVal) holds
    #       the value; "null" needs none.
    #   kind == "set"
    #       an `in`/`not in` right-hand-side array literal. `children` holds
    #       one leaf Node (kind "num" or "text") per element — this is this
    #       port's one new node kind beyond a literal mirror of predicate.rs
    #       (which decodes it from a JSON array), needed because this arena-
    #       turned-struct tree has no generic "any JSON value" leaf.
    #   kind == "ref"
    #       a bare variable reference. `name` is the variable's name. Only
    #       ever meaningful as a "get" node's object (below); a bare "ref"
    #       reached any other way is exactly predicate.rs's own "ref" kind
    #       falling through `eval_at`'s `other` arm — not evaluable.
    #   kind == "get"
    #       a field read, `item.field`. `name` is the field name;
    #       `children[0]` is the object sub-expression, checked at eval time
    #       to be a "ref" naming the row's item variable (predicate.rs's own
    #       `is_item_ref`) — this evaluator has nothing to push a field read
    #       down to on any other object.
    #   kind == "un"
    #       a unary operator. `op` is "!" or "-"; `children[0]` is the
    #       operand.
    #   kind == "bin"
    #       a binary operator. `op` is one of "&& || == != < <= > >= + - * /
    #       % starts_with ends_with contains in `not in`"; `children[0]` and
    #       `children[1]` are the left and right operands.
    struct Node:
        kind: text
        name: text
        op: text
        numVal: float
        boolVal: bool
        textVal: text
        children: [Node]

    # Field: one named value in a decoded row (`item.field` reads one of
    # these by name). `kind` says which of num/text/bool/null this field
    # holds — deliberately the same vocabulary evalKind's own result uses
    # (see below), since "the kind of a value" is one concept whether the
    # value came from a row or from evaluating a sub-expression. `int` and
    # `float` collapse into one "num" kind here, same as the arena version
    # did and for the same reason: predicate.rs's own `eval_bin_op` runs
    # every numeric operator through `as_f64` on both sides regardless of
    # origin, so fct's own `int`/`float` distinction (which this HOST
    # language does not auto-promote across — see LANGUAGE.md's `float`
    # section) has nothing to attach to on this side; num is carried as
    # `float` throughout, matching predicate.rs's own `Number` handling.
    struct Field:
        name: text
        kind: text
        num: float
        text: text
        bool: bool

    proc rowFieldIndex(row: [Field], field: text) -> int:
        let n = len(row)
        let mut i = 0
        let mut found = -1
        loop i < n:
            if found == -1:
                if row[i].name == field:
                    found = i
            i = i + 1
        return found

    # isItemRef: predicate.rs's own `is_item_ref` check (`obj.kind == "ref"
    # && obj.name.as_deref() == Some(item_var)`) — true iff objNode is a
    # "ref" node naming the row's own item variable.
    proc isItemRef(objNode: Node, itemVar: text) -> bool:
        if objNode.kind == "ref":
            return objNode.name == itemVar
        return false

    # numInChildren / textInChildren: `in`/`not in` membership, scanning a
    # "set" node's `children` (each a leaf "num" or "text" Node — see
    # Node's own doc). Guarded by each element's OWN kind, not just the
    # first one's, so a stray wrong-kind element can never produce a false
    # match through its OTHER payload field's zero value (a "text" leaf's
    # `numVal` is always 0.0, so an unguarded numeric scan of a text set
    # would wrongly "contain" 0 — this is that guard).
    proc numInChildren(children: [Node], target: float) -> bool:
        let n = len(children)
        let mut i = 0
        let mut found = false
        loop i < n:
            if children[i].kind == "num":
                if children[i].numVal == target:
                    found = true
            i = i + 1
        return found

    proc textInChildren(children: [Node], target: text) -> bool:
        let n = len(children)
        let mut i = 0
        let mut found = false
        loop i < n:
            if children[i].kind == "text":
                if children[i].textVal == target:
                    found = true
            i = i + 1
        return found

    # ============================================================
    # NODE CONSTRUCTORS — a tiny "smart constructor" per leaf/branch shape,
    # so building a tree reads like `do binNode("==", left, right)` instead
    # of repeating all seven of Node's fields (most of them irrelevant to
    # that shape) at every call site. This is exactly the convenience a
    # Swift/Python codebase gets for free from a struct's memberwise
    # initializer; fct has no such sugar yet, so these procs are that
    # sugar, written once.
    # ============================================================
    proc numNode(v: float) -> Node:
        return Node{kind: "num", name: "", op: "", numVal: v, boolVal: false, textVal: "", children: []}

    proc boolNode(v: bool) -> Node:
        return Node{kind: "bool", name: "", op: "", numVal: 0.0, boolVal: v, textVal: "", children: []}

    proc textNode(v: text) -> Node:
        return Node{kind: "text", name: "", op: "", numVal: 0.0, boolVal: false, textVal: v, children: []}

    proc nullNode() -> Node:
        return Node{kind: "null", name: "", op: "", numVal: 0.0, boolVal: false, textVal: "", children: []}

    proc refNode(name: text) -> Node:
        return Node{kind: "ref", name: name, op: "", numVal: 0.0, boolVal: false, textVal: "", children: []}

    proc getNode(obj: Node, field: text) -> Node:
        return Node{kind: "get", name: field, op: "", numVal: 0.0, boolVal: false, textVal: "", children: [obj]}

    proc unNode(op: text, x: Node) -> Node:
        return Node{kind: "un", name: "", op: op, numVal: 0.0, boolVal: false, textVal: "", children: [x]}

    proc binNode(op: text, l: Node, r: Node) -> Node:
        return Node{kind: "bin", name: "", op: op, numVal: 0.0, boolVal: false, textVal: "", children: [l, r]}

    # ============================================================
    # THE GATEKEEPER FAMILY: evalKind / evalUnKind / evalBinKind.
    # ============================================================
    # evalKind(node) mirrors predicate.rs's `eval_at` dispatch, returning the
    # RESULT value-kind ("num" | "text" | "bool" | "null" | "set") or
    # "error" if this node — or anything it depends on — is not evaluable.
    # MAX_PREDICATE_DEPTH = 64 (predicate.rs's own bound) is checked here,
    # once per node, exactly where `eval_at` checks it.
    proc evalKind(row: [Field], itemVar: text, node: Node, depth: int) -> text:
        if depth >= 64:
            return "error"
        if node.kind == "num":
            return "num"
        if node.kind == "bool":
            return "bool"
        if node.kind == "text":
            return "text"
        if node.kind == "null":
            return "null"
        if node.kind == "set":
            return "set"
        if node.kind == "ref":
            return "error"
        if node.kind == "get":
            let objNode = node.children[0]
            let isRef = do isItemRef(objNode, itemVar)
            if isRef:
                let idx = do rowFieldIndex(row, node.name)
                if idx == -1:
                    return "null"
                return row[idx].kind
            return "error"
        if node.kind == "un":
            let unKind = do evalUnKind(row, itemVar, node, depth)
            return unKind
        if node.kind == "bin":
            let binKind = do evalBinKind(row, itemVar, node, depth)
            return binKind
        return "error"

    # evalUnKind: predicate.rs's "un" arm. `!` never fails (`truthy` accepts
    # any successfully-evaluated value); `-` requires a numeric operand.
    proc evalUnKind(row: [Field], itemVar: text, node: Node, depth: int) -> text:
        let child = node.children[0]
        let childKind = do evalKind(row, itemVar, child, depth + 1)
        if childKind == "error":
            return "error"
        if node.op == "!":
            return "bool"
        if node.op == "-":
            if childKind == "num":
                return "num"
            return "error"
        return "error"

    # evalBinKind: predicate.rs's "bin" arm plus `eval_bin_op`'s own type
    # checks, fused into one pass since a check here has nowhere else to
    # perform a runtime bound (string length, `in`-set size, division by
    # zero) except by fetching the payload it needs to check it.
    proc evalBinKind(row: [Field], itemVar: text, node: Node, depth: int) -> text:
        let op = node.op
        let l = node.children[0]
        let r = node.children[1]

        if op == "&&":
            let lk = do evalKind(row, itemVar, l, depth + 1)
            if lk == "error":
                return "error"
            let lt = do evalTruthy(row, itemVar, l, depth + 1)
            if lt == false:
                return "bool"
            let rk = do evalKind(row, itemVar, r, depth + 1)
            if rk == "error":
                return "error"
            return "bool"

        if op == "||":
            let lk2 = do evalKind(row, itemVar, l, depth + 1)
            if lk2 == "error":
                return "error"
            let lt2 = do evalTruthy(row, itemVar, l, depth + 1)
            if lt2 == true:
                return "bool"
            let rk2 = do evalKind(row, itemVar, r, depth + 1)
            if rk2 == "error":
                return "error"
            return "bool"

        let lk3 = do evalKind(row, itemVar, l, depth + 1)
        if lk3 == "error":
            return "error"
        let rk3 = do evalKind(row, itemVar, r, depth + 1)
        if rk3 == "error":
            return "error"

        if op == "==":
            return "bool"
        if op == "!=":
            return "bool"
        if op == "starts_with":
            return "bool"
        if op == "ends_with":
            return "bool"
        if op == "contains":
            return "bool"
        if op == "in":
            if rk3 == "set":
                if len(r.children) > 1000:
                    return "error"
                return "bool"
            return "error"
        if op == "not in":
            if rk3 == "set":
                if len(r.children) > 1000:
                    return "error"
                return "bool"
            return "error"
        if op == "<":
            if lk3 == "num":
                if rk3 == "num":
                    return "bool"
            return "error"
        if op == "<=":
            if lk3 == "num":
                if rk3 == "num":
                    return "bool"
            return "error"
        if op == ">":
            if lk3 == "num":
                if rk3 == "num":
                    return "bool"
            return "error"
        if op == ">=":
            if lk3 == "num":
                if rk3 == "num":
                    return "bool"
            return "error"
        if op == "+":
            if lk3 == "text":
                if rk3 == "text":
                    let lv = do evalText(row, itemVar, l)
                    let rv = do evalText(row, itemVar, r)
                    let totalLen = len(lv) + len(rv)
                    if totalLen > 65536:
                        return "error"
                    return "text"
            if lk3 == "num":
                if rk3 == "num":
                    return "num"
            return "error"
        if op == "-":
            if lk3 == "num":
                if rk3 == "num":
                    return "num"
            return "error"
        if op == "*":
            if lk3 == "num":
                if rk3 == "num":
                    return "num"
            return "error"
        if op == "/":
            if lk3 == "num":
                if rk3 == "num":
                    let rv2 = do evalNum(row, itemVar, r)
                    if rv2 == 0.0:
                        return "error"
                    return "num"
            return "error"
        if op == "%":
            if lk3 == "num":
                if rk3 == "num":
                    let rv3 = do evalNum(row, itemVar, r)
                    if rv3 == 0.0:
                        return "error"
                    return "num"
            return "error"
        return "error"

    # evalTruthy: predicate.rs's own `truthy()` — bool -> itself, null ->
    # false, everything else (num/text/set) -> true — restated to call
    # evalKind itself so every caller (the "&&"/"||" short-circuit above,
    # the "!" case in evalBool, and a predicate's own top-level result)
    # shares one definition.
    proc evalTruthy(row: [Field], itemVar: text, node: Node, depth: int) -> bool:
        let k = do evalKind(row, itemVar, node, depth)
        if k == "bool":
            let b = do evalBool(row, itemVar, node)
            return b
        if k == "null":
            return false
        if k == "error":
            return false
        return true

    # ============================================================
    # THE VALUE-GETTER FAMILY: evalNum / evalText / evalBool, plus the two
    # "combine two evaluated children" helpers (evalBinBool, and the
    # equality/in-set tests it delegates to). Each ASSUMES evalKind has
    # already vetted `node` — no depth parameter, no "error" handling of its
    # own (the same calling convention the arena version documented: a
    # value-getter is only ever invoked on a subtree evalKind already
    # walked successfully).
    # ============================================================
    proc evalNum(row: [Field], itemVar: text, node: Node) -> float:
        if node.kind == "num":
            return node.numVal
        if node.kind == "get":
            let idx = do rowFieldIndex(row, node.name)
            return row[idx].num
        if node.kind == "un":
            let child = node.children[0]
            let cv = do evalNum(row, itemVar, child)
            return 0.0 - cv
        if node.kind == "bin":
            let l = node.children[0]
            let r = node.children[1]
            let lv = do evalNum(row, itemVar, l)
            let rv = do evalNum(row, itemVar, r)
            if node.op == "+":
                return lv + rv
            if node.op == "-":
                return lv - rv
            if node.op == "*":
                return lv * rv
            if node.op == "/":
                return lv / rv
            if node.op == "%":
                # `%` is int-only in fct itself (LANGUAGE.md's `float`
                # section), so the native `%` operator isn't usable here
                # even though both operands are already `float`.
                # predicate.rs's own `%` is Rust's f64 `%` (a truncated
                # remainder, sign follows the dividend) — restated by hand
                # with the arithmetic this language DOES allow on floats
                # (`+ - * /`) plus `toInt`'s documented truncate-toward-zero
                # behavior, which is exactly what a truncated quotient needs.
                let q = toFloat(toInt(lv / rv))
                return lv - q * rv
            return 0.0
        return 0.0

    proc evalText(row: [Field], itemVar: text, node: Node) -> text:
        if node.kind == "text":
            return node.textVal
        if node.kind == "get":
            let idx = do rowFieldIndex(row, node.name)
            return row[idx].text
        if node.kind == "bin":
            let l = node.children[0]
            let r = node.children[1]
            let lv = do evalText(row, itemVar, l)
            let rv = do evalText(row, itemVar, r)
            return lv + rv
        return ""

    proc evalBool(row: [Field], itemVar: text, node: Node) -> bool:
        if node.kind == "bool":
            return node.boolVal
        if node.kind == "get":
            let idx = do rowFieldIndex(row, node.name)
            return row[idx].bool
        if node.kind == "un":
            let child = node.children[0]
            let ct = do evalTruthy(row, itemVar, child, 0)
            return !ct
        if node.kind == "bin":
            let bb = do evalBinBool(row, itemVar, node)
            return bb
        return false

    # valuesEqual: predicate.rs's own `values_equal` — numbers compare by
    # value regardless of int/float origin (this port's "num" kind already
    # IS that comparison), everything else compares within its own kind,
    # and a kind MISMATCH is always false. Two "set"-kind operands are a
    # documented simplification (matching the arena version): this port
    # always answers false rather than a real elementwise comparison, since
    # no real predicate compares two `in`-sets with `==`.
    proc valuesEqual(row: [Field], itemVar: text, l: Node, r: Node, depth: int) -> bool:
        let lk = do evalKind(row, itemVar, l, depth)
        let rk = do evalKind(row, itemVar, r, depth)
        if lk == "num":
            if rk == "num":
                let a = do evalNum(row, itemVar, l)
                let b = do evalNum(row, itemVar, r)
                return a == b
            return false
        if lk == "text":
            if rk == "text":
                let ta = do evalText(row, itemVar, l)
                let tb = do evalText(row, itemVar, r)
                return ta == tb
            return false
        if lk == "bool":
            if rk == "bool":
                let ba = do evalBool(row, itemVar, l)
                let bb = do evalBool(row, itemVar, r)
                return ba == bb
            return false
        if lk == "null":
            if rk == "null":
                return true
            return false
        return false

    # valueInSet: predicate.rs's "in"/"not in" membership test.
    proc valueInSet(row: [Field], itemVar: text, l: Node, setNode: Node, depth: int) -> bool:
        let lk = do evalKind(row, itemVar, l, depth)
        if lk == "num":
            let lv = do evalNum(row, itemVar, l)
            let hit = do numInChildren(setNode.children, lv)
            return hit
        if lk == "text":
            let tv = do evalText(row, itemVar, l)
            let hit2 = do textInChildren(setNode.children, tv)
            return hit2
        return false

    # evalBinBool: predicate.rs's `eval_bin_op`, restated for every op that
    # PRODUCES a bool (comparisons, string tests, membership, and the
    # already-short-circuited `&&`/`||`). Only reached once evalKind on this
    # same node has already returned "bool", so every branch below can
    # assume its operands are exactly the kind evalBinKind already checked.
    proc evalBinBool(row: [Field], itemVar: text, node: Node) -> bool:
        let op = node.op
        let l = node.children[0]
        let r = node.children[1]

        if op == "&&":
            let lt = do evalTruthy(row, itemVar, l, 0)
            if lt == false:
                return false
            let rt = do evalTruthy(row, itemVar, r, 0)
            return rt

        if op == "||":
            let lt2 = do evalTruthy(row, itemVar, l, 0)
            if lt2 == true:
                return true
            let rt2 = do evalTruthy(row, itemVar, r, 0)
            return rt2

        if op == "==":
            let eq = do valuesEqual(row, itemVar, l, r, 0)
            return eq

        if op == "!=":
            let eq2 = do valuesEqual(row, itemVar, l, r, 0)
            return !eq2

        if op == "starts_with":
            let lk = do evalKind(row, itemVar, l, 0)
            let rk = do evalKind(row, itemVar, r, 0)
            if lk == "text":
                if rk == "text":
                    let hv = do evalText(row, itemVar, l)
                    let nv = do evalText(row, itemVar, r)
                    let hlen = len(hv)
                    let nlen = len(nv)
                    if nlen > hlen:
                        return false
                    let prefix = slice(hv, 0, nlen)
                    return prefix == nv
            return false

        if op == "ends_with":
            let lk2 = do evalKind(row, itemVar, l, 0)
            let rk2 = do evalKind(row, itemVar, r, 0)
            if lk2 == "text":
                if rk2 == "text":
                    let hv2 = do evalText(row, itemVar, l)
                    let nv2 = do evalText(row, itemVar, r)
                    let hlen2 = len(hv2)
                    let nlen2 = len(nv2)
                    if nlen2 > hlen2:
                        return false
                    let suffix = slice(hv2, hlen2 - nlen2, hlen2)
                    return suffix == nv2
            return false

        if op == "contains":
            let lk3 = do evalKind(row, itemVar, l, 0)
            let rk3 = do evalKind(row, itemVar, r, 0)
            if lk3 == "text":
                if rk3 == "text":
                    let hv3 = do evalText(row, itemVar, l)
                    let nv3 = do evalText(row, itemVar, r)
                    let found = contains(hv3, nv3)
                    return found
            return false

        if op == "in":
            let inSet = do valueInSet(row, itemVar, l, r, 0)
            return inSet

        if op == "not in":
            let inSet2 = do valueInSet(row, itemVar, l, r, 0)
            return !inSet2

        if op == "<":
            let a = do evalNum(row, itemVar, l)
            let b = do evalNum(row, itemVar, r)
            return a < b
        if op == "<=":
            let a2 = do evalNum(row, itemVar, l)
            let b2 = do evalNum(row, itemVar, r)
            return a2 <= b2
        if op == ">":
            let a3 = do evalNum(row, itemVar, l)
            let b3 = do evalNum(row, itemVar, r)
            return a3 > b3
        if op == ">=":
            let a4 = do evalNum(row, itemVar, l)
            let b4 = do evalNum(row, itemVar, r)
            return a4 >= b4

        return false

    # ============================================================
    # THE TOP-LEVEL ENTRY POINTS a real caller (a future self-hosted
    # FacetQL scan loop) would actually call, mirroring predicate.rs's own
    # `pub fn eval(expr, item_var, data) -> Result<Value, String>` split
    # into its two halves, since a proc has no `Result` type to return:
    # evalPredicateOk answers "is this predicate evaluable at all"
    # (predicate.rs's `Ok(_)` vs. `Err(_)`), and evalPredicateResult answers
    # "does this row match" — this predicate's own truthy value, read
    # through the same `evalTruthy` every `&&`/`||`/`!` already uses.
    # evalPredicateResult's return is undefined (never a crash, just not
    # meaningful) when evalPredicateOk is false.
    proc evalPredicateOk(row: [Field], itemVar: text, root: Node) -> bool:
        let k = do evalKind(row, itemVar, root, 0)
        return k != "error"

    proc evalPredicateResult(row: [Field], itemVar: text, root: Node) -> bool:
        let t = do evalTruthy(row, itemVar, root, 0)
        return t

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURE — hand-verified predicate A from the task
    # report: `item.status == "open"`, evaluated against a row where
    # `status == "open"`, expected result `true`. Compare this to the old
    # arena encoding this file's git history holds
    # (`[6, 0, -1, -1, -1, 7, -1, 1, 0, -1, 3, 2, -1, -1, -1, 9, -1, 2, 1, 2]`,
    # meaningless without the slot-numbering scheme in your head) — the
    # struct-literal version below reads as what it computes.
    proc demoPredicateTree() -> Node:
        let itemRef = do refNode("item")
        let statusGet = do getNode(itemRef, "status")
        let openLit = do textNode("open")
        let root = do binNode("==", statusGet, openLit)
        return root

    proc demoRow() -> [Field]:
        let statusField = Field{name: "status", kind: "text", num: 0.0, text: "open", bool: false}
        let ageField = Field{name: "age", kind: "num", num: 30.0, text: "", bool: false}
        return [statusField, ageField]

    proc demoItemVar() -> text:
        return "item"

    proc demoPredicateAOk() -> bool:
        let row = do demoRow()
        let itemVar = do demoItemVar()
        let root = do demoPredicateTree()
        let ok = do evalPredicateOk(row, itemVar, root)
        return ok

    proc demoPredicateAMatch() -> bool:
        let row = do demoRow()
        let itemVar = do demoItemVar()
        let root = do demoPredicateTree()
        let matched = do evalPredicateResult(row, itemVar, root)
        return matched

    state demoOkResult: bool = false
    state demoMatchResult: bool = false

    action runDemoPredicateA():
        let ok = do demoPredicateAOk()
        let matched = do demoPredicateAMatch()
        demoOkResult = ok
        demoMatchResult = matched

    # ============================================================
    # GENERAL-PURPOSE SCENARIO SURFACE — one action, dispatching by name to
    # a battery of hand-built (tree, row) fixtures, each verifying one
    # specific real-predicate.rs behavior this port's own header claims to
    # match: type-mismatch equality, `truthy`'s real special-casing (only
    # Bool/Null, everything else — including 0 and "" — is true), missing-
    # field reads as null, &&/|| short-circuiting the SIDE EFFECT of never
    # surfacing an error the skipped branch would have raised, comparison's
    # both-sides-numeric requirement, recursive arithmetic/string-concat
    # evaluation (checked by wrapping the expression in `== <expected>` so
    # valuesEqual actually calls evalNum/evalText on it — evalPredicateResult
    # alone only reports TRUTHINESS, not a non-bool value, exactly like
    # predicate.rs's own `truthy` never inspects a Number/String's payload
    # either), division/modulo by zero, in/not-in set membership plus its
    # 1000-element bound, and starts_with/ends_with/contains. This is the
    # same "one action, dispatch by name" shape aggregate.fct would have
    # needed had its own inputs not fit a flat text encoding — Node's real
    # recursion makes a generic text format enough extra machinery (a whole
    # second small parser) that per-scenario builder procs, the same
    # convention demoPredicateTree/demoRow already established, are the
    # right amount of code for what this task needs.
    # ============================================================
    proc emptyRow() -> [Field]:
        return []

    proc setNode(children: [Node]) -> Node:
        return Node{kind: "set", name: "", op: "", numVal: 0.0, boolVal: false, textVal: "", children: children}

    # -- scenario tree builders --------------------------------------

    proc treeTypeMismatchNeverEqual() -> Node:
        let a = do numNode(1.0)
        let b = do textNode("1")
        let t = do binNode("==", a, b)
        return t

    proc treeZeroIsTruthy() -> Node:
        let t = do numNode(0.0)
        return t

    proc treeEmptyTextIsTruthy() -> Node:
        let t = do textNode("")
        return t

    proc treeNullIsFalsy() -> Node:
        let t = do nullNode()
        return t

    proc treeFieldAccessPresent() -> Node:
        let ref1 = do refNode("item")
        let g = do getNode(ref1, "status")
        let lit = do textNode("active")
        let t = do binNode("==", g, lit)
        return t

    proc rowFieldAccessPresent() -> [Field]:
        let f = Field{name: "status", kind: "text", num: 0.0, text: "active", bool: false}
        return [f]

    proc treeFieldAccessMissingIsNull() -> Node:
        let ref1 = do refNode("item")
        let g = do getNode(ref1, "missing")
        let n = do nullNode()
        let t = do binNode("==", g, n)
        return t

    proc treeAndShortCircuitsRight() -> Node:
        let f = do boolNode(false)
        let one = do numNode(1.0)
        let zero = do numNode(0.0)
        let divByZero = do binNode("/", one, zero)
        let t = do binNode("&&", f, divByZero)
        return t

    proc treeOrShortCircuitsRight() -> Node:
        let tr = do boolNode(true)
        let one = do numNode(1.0)
        let zero = do numNode(0.0)
        let divByZero = do binNode("/", one, zero)
        let t = do binNode("||", tr, divByZero)
        return t

    proc treeComparisonRequiresNumericBothSides() -> Node:
        let five = do textNode("5")
        let three = do numNode(3.0)
        let t = do binNode(">", five, three)
        return t

    proc treeGreaterThanNumeric() -> Node:
        let five = do numNode(5.0)
        let three = do numNode(3.0)
        let t = do binNode(">", five, three)
        return t

    proc treeArithmeticPrecedenceViaEquality() -> Node:
        let two = do numNode(2.0)
        let three = do numNode(3.0)
        let mul = do binNode("*", two, three)
        let one = do numNode(1.0)
        let add = do binNode("+", one, mul)
        let seven = do numNode(7.0)
        let t = do binNode("==", add, seven)
        return t

    proc treeStringConcatCorrectValue() -> Node:
        let foo = do textNode("foo")
        let bar = do textNode("bar")
        let cat = do binNode("+", foo, bar)
        let foobar = do textNode("foobar")
        let t = do binNode("==", cat, foobar)
        return t

    proc treeDivisionByZeroIsError() -> Node:
        let one = do numNode(1.0)
        let zero = do numNode(0.0)
        let div = do binNode("/", one, zero)
        let nines = do numNode(999.0)
        let t = do binNode("==", div, nines)
        return t

    proc treeModuloByZeroIsError() -> Node:
        let one = do numNode(1.0)
        let zero = do numNode(0.0)
        let m = do binNode("%", one, zero)
        let zero2 = do numNode(0.0)
        let t = do binNode("==", m, zero2)
        return t

    proc treeInSetMembership() -> Node:
        let n1 = do numNode(1.0)
        let n2 = do numNode(2.0)
        let n3 = do numNode(3.0)
        let set = do setNode([n1, n2, n3])
        let two = do numNode(2.0)
        let t = do binNode("in", two, set)
        return t

    proc treeNotInSetMembership() -> Node:
        let n1 = do numNode(1.0)
        let n2 = do numNode(2.0)
        let n3 = do numNode(3.0)
        let set = do setNode([n1, n2, n3])
        let five = do numNode(5.0)
        let t = do binNode("not in", five, set)
        return t

    # treeInSetSizeLimitExceeded: 1001 elements — one past evalBinKind's own
    # `if len(r.children) > 1000: return "error"` bound.
    proc treeInSetSizeLimitExceeded() -> Node:
        let mut children = []
        let mut i = 0
        loop i < 1001:
            let iFloat = toFloat(i)
            let n = do numNode(iFloat)
            children = append(children, n)
            i = i + 1
        let set = do setNode(children)
        let zero = do numNode(0.0)
        let t = do binNode("in", zero, set)
        return t

    proc treeStartsWith() -> Node:
        let hay = do textNode("hello world")
        let needle = do textNode("hello")
        let t = do binNode("starts_with", hay, needle)
        return t

    proc treeEndsWith() -> Node:
        let hay = do textNode("hello world")
        let needle = do textNode("world")
        let t = do binNode("ends_with", hay, needle)
        return t

    proc treeContains() -> Node:
        let hay = do textNode("hello world")
        let needle = do textNode("lo wo")
        let t = do binNode("contains", hay, needle)
        return t

    # -- dispatch ------------------------------------------------------

    proc scenarioOk(name: text) -> bool:
        let row = do emptyRow()
        if name == "fieldAccessPresent":
            let r2 = do rowFieldAccessPresent()
            let t2 = do treeFieldAccessPresent()
            let ok2 = do evalPredicateOk(r2, "item", t2)
            return ok2
        let tree = do scenarioTree(name)
        let ok = do evalPredicateOk(row, "item", tree)
        return ok

    proc scenarioResult(name: text) -> bool:
        let row = do emptyRow()
        if name == "fieldAccessPresent":
            let r2 = do rowFieldAccessPresent()
            let t2 = do treeFieldAccessPresent()
            let result2 = do evalPredicateResult(r2, "item", t2)
            return result2
        let tree = do scenarioTree(name)
        let result = do evalPredicateResult(row, "item", tree)
        return result

    # scenarioTree: every scenario whose row is empty — pulled into one
    # shared dispatch so scenarioOk/scenarioResult don't each repeat the
    # same 18-way name match twice.
    proc scenarioTree(name: text) -> Node:
        if name == "typeMismatchNeverEqual":
            let t = do treeTypeMismatchNeverEqual()
            return t
        if name == "zeroIsTruthy":
            let t = do treeZeroIsTruthy()
            return t
        if name == "emptyTextIsTruthy":
            let t = do treeEmptyTextIsTruthy()
            return t
        if name == "nullIsFalsy":
            let t = do treeNullIsFalsy()
            return t
        if name == "fieldAccessMissingIsNull":
            let t = do treeFieldAccessMissingIsNull()
            return t
        if name == "andShortCircuitsRight":
            let t = do treeAndShortCircuitsRight()
            return t
        if name == "orShortCircuitsRight":
            let t = do treeOrShortCircuitsRight()
            return t
        if name == "comparisonRequiresNumericBothSides":
            let t = do treeComparisonRequiresNumericBothSides()
            return t
        if name == "greaterThanNumeric":
            let t = do treeGreaterThanNumeric()
            return t
        if name == "arithmeticPrecedenceViaEquality":
            let t = do treeArithmeticPrecedenceViaEquality()
            return t
        if name == "stringConcatCorrectValue":
            let t = do treeStringConcatCorrectValue()
            return t
        if name == "divisionByZeroIsError":
            let t = do treeDivisionByZeroIsError()
            return t
        if name == "moduloByZeroIsError":
            let t = do treeModuloByZeroIsError()
            return t
        if name == "inSetMembership":
            let t = do treeInSetMembership()
            return t
        if name == "notInSetMembership":
            let t = do treeNotInSetMembership()
            return t
        if name == "inSetSizeLimitExceeded":
            let t = do treeInSetSizeLimitExceeded()
            return t
        if name == "startsWith":
            let t = do treeStartsWith()
            return t
        if name == "endsWith":
            let t = do treeEndsWith()
            return t
        if name == "contains":
            let t = do treeContains()
            return t
        let n = do nullNode()
        return n

    state scenarioOkResult: bool = false
    state scenarioResultResult: bool = false

    action runPredicateScenario(name: text):
        let ok = do scenarioOk(name)
        let result = do scenarioResult(name)
        scenarioOkResult = ok
        scenarioResultResult = result

    private view Home at "/":
        box:
            text "{demoOkResult} {demoMatchResult} {scenarioOkResult} {scenarioResultResult}"
