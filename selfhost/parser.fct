import "parser_proc.fct"
import "parser_entity.fct"
import "parser_service.fct"

app ParserSelfHost:
    # Partial, honest self-hosting port of a REAL, SELF-CONTAINED slice of
    # internal/parser/parser.go (the line-oriented statement/declaration
    # parser stage of fct's own compiler pipeline, 3800+ lines) into `.fct`
    # `proc`s.
    #
    # SCOPE, chosen after reading parser.go in full: parser.go is NOT one
    # recursive grammar the way expr.go is. It is ~90 independent
    # `parseXxx(n *source.Node)` functions, one per declaration/statement
    # keyword, each doing mostly MECHANICAL text surgery (TrimPrefix/
    # TrimSuffix/Index/split-on-a-separator) over a line's own trimmed text,
    # then calling parseExpr (expr.go) for the handful of sub-expressions a
    # line contains. The one true dispatcher, parseDecl (and parseProcBody/
    # parseAction for statement position), is a single big `switch` on
    # `strings.HasPrefix(text, keyword+" ")` — exactly the kind of prefix
    # dispatch this file's header question #3 asked about, confirmed live
    # below (declKeywordOf).
    #
    # This file ports, completely and mechanically, parseProc's own HEADER
    # line — `proc Name(a: T, b: [U]?) -> [V] uses cap1, cap2:` — the exact
    # self-referential piece the task suggested: parsing the declaration
    # that every proc in this whole self-hosting effort (this one included)
    # is written with. It reproduces parseProc's real algorithm exactly:
    #   1. strip the `proc` keyword and the trailing `:` (procHeadOf)
    #   2. pull off ` uses cap1, cap2` (the LAST clause before `:`) first
    #      (headBeforeUses/usesPartOf/headerUsesList/headerUsesValid)
    #   3. pull off `-> RetType` next, from what's left (headBeforeArrow/
    #      arrowPartOf/headerRet*)
    #   4. parse `Name(params)` from what's left of THAT (headerSigCore/
    #      headerName/headerParam*) — parseSignature's own real algorithm,
    #      with allowList=true, allowRef=false hard-coded, because that is
    #      exactly what parseProc always passes (a proc parameter may be
    #      list-typed; a proc has no `cell`/`action` reference parameters —
    #      those only exist for actions/components, a different call site
    #      of the same parseSignature this file does not port)
    # parseProcBody (the proc's STATEMENT block) is explicitly NOT attempted
    # here — see the SCOPE NOTE below this header for exactly why, and what
    # it would take.
    #
    # This file ALSO ports parseCheck's real, self-contained boundary-
    # finding algorithm (`check <cond> "<message>"` — a statement that
    # appears in actions/jobs, never inside a pure proc, per parseProcBody's
    # own explicit rejection of it): the BACKWARD scan from the line's end
    # to find the message's opening (unescaped) quote, splitting the line
    # into a condition span and a raw message span. This is a genuinely new
    # scanning DIRECTION not needed by source.fct or expr.fct (both scan
    # forward only), so it is a real, separate demonstration that the
    # established character-at-a-time idiom (charAt/slice/len, no direct
    # indexing) generalizes to "scan from the end", not just "scan from the
    # start".
    #
    # ============================================================
    # SCOPE NOTE: why parseProcBody itself (the proc's actual statement
    # block: let/if/loop/return/do/assign) is NOT attempted in this file,
    # and what porting it for real would need.
    # ============================================================
    # parseProcBody is, unlike parseProc's header, genuinely RECURSIVE over
    # the indentation tree: `if`/`loop` bodies are parsed by calling
    # parseProcBody again on `c.Children` (source.fct's own Node.Children).
    # That recursion is not a new capability gap by itself — source.fct's
    # own STAGE 3 (childrenOf/subtreeSum/subtreeDepth) already proved a
    # proc can recurse over a parents-array tree encoding. The real,
    # confirmed blocker is COMPOSING three already-separately-working
    # pieces that have never been wired together end to end:
    #   (a) source.fct's parents/children arrays for the node structure,
    #   (b) THIS file's line-prefix dispatch (declKeywordOf et al.) to
    #       classify each child line's statement kind, and
    #   (c) expr.fct's parseExprArena to parse the actual expression that
    #       trails a `let`/`if`/`loop`/`return`/assignment line.
    # Item (c) specifically was checked LIVE for this task (not assumed):
    # a NEW proc in a NEW file genuinely CAN call an imported file's proc
    # via ordinary `do otherProc(...)`, through the compiler's existing
    # multi-file `import "other.fct"` + compile.File merge path (internal/
    # compile/compile.go's mergeInto folds an imported module's Procs into
    # the importing app's own Procs, so `do` resolves it exactly like a
    # local proc) — verified in parser_test.go's
    # TestCrossFileDoCallComposition (a generic two-file proof) and
    # TestCrossFileDoCallsRealExprFct (the SAME mechanism, exercised
    # against the actual, current, unmodified selfhost/expr.fct, calling
    # its real parseExprArena from a brand-new proc in a second file). Both
    # passed live. So composition (a)+(b)+(c) is not blocked by any missing
    # language primitive — every piece already exists and already works in
    # isolation and pairwise.
    #
    # What's missing is genuinely a SCALE/DESIGN problem, not a capability
    # gap: parseProcBody's real switch has ~14 statement shapes (let/mut,
    # do, spawn, join, loop, if/else-with-lookahead-at-the-SIBLING-level,
    # return, break, continue, bare-call, indexed-assign, plain assign),
    # several of which (spawn/join/do's `let name = do ...` bind form) need
    # ast shapes this arena/parallel-array encoding has no representation
    # for yet (a "proc call" node is not an expression node — it's a
    # STATEMENT that names another proc and a list of argument expressions,
    # which is a new node shape, not a new case of expr.fct's existing
    # 5-int arena). Building that honestly — one new statement "kind" at a
    # time, each independently verified against real parseProcBody output —
    # is realistically the next SEPARATE round of work this file's own
    # header pattern (Round 1/2/3/4 in expr.fct) would use, not a single
    # pass alongside the header work above. See this file's own closing
    # report for the full assessment.
    #
    # ============================================================
    # DRIVER: this file no longer carries STAGE 1-17 itself — they now live
    # in parser_proc.fct (STAGE 1-8: proc/check parsing), parser_entity.fct
    # (STAGE 9-13: entity/state/derive parsing), and parser_service.fct
    # (STAGE 14-17: webhook/job/policy/service parsing), imported above.
    # What's left here is exactly the demo scaffolding every one of those
    # STAGEs feeds into: one `state` per STAGE result, one `action` per
    # entry point, and the single `view Home` that renders them all — the
    # only state/action/view this merged app is allowed to own (a second
    # file declaring its own `view`/duplicate `action` names would collide
    # at merge time; see internal/compile/compile.go's checkDuplicates).
    # ============================================================
    state headerNameResult: text = ""
    state headerValidResult: bool = false
    state paramNamesResult: [text] = []
    state paramTypesResult: [text] = []
    state paramListsResult: [bool] = []
    state paramOptionalsResult: [bool] = []
    state hasRetResult: bool = false
    state retCoreResult: text = ""
    state retIsListResult: bool = false
    state retIsOptionalResult: bool = false
    state usesResult: [text] = []
    state checkValidResult: bool = false
    state checkConditionResult: text = ""
    state checkMessageResult: text = ""
    state declKeywordResult: text = ""

    state entityHeaderNameResult: text = ""
    state entityHeaderValidResult: bool = false
    state entitySoftDeleteResult: bool = false
    state entityEphemeralResult: bool = false

    state entityFieldNameResult: text = ""
    state entityFieldCoreResult: text = ""
    state entityFieldIsListResult: bool = false
    state entityFieldIsOptionalResult: bool = false
    state entityFieldSecretResult: bool = false
    state entityFieldE2EResult: bool = false
    state entityFieldUniqueResult: bool = false
    state entityFieldRequiredResult: bool = false
    state entityFieldRestrictResult: bool = false
    state entityFieldSetNullResult: bool = false
    state entityFieldHasMinResult: bool = false
    state entityFieldMinValueResult: int = 0
    state entityFieldHasMaxResult: bool = false
    state entityFieldMaxValueResult: int = 0
    state entityFieldHasRequiresResult: bool = false
    state entityFieldRequiresPolicyResult: text = ""
    state entityFieldMatchesPatternResult: text = ""
    state entityFieldValidResult: bool = false

    state stateNameResult: text = ""
    state statePlacementResult: text = ""
    state stateCoreResult: text = ""
    state stateIsListResult: bool = false
    state stateIsOptionalResult: bool = false
    state stateHasDefaultResult: bool = false
    state stateDefaultRawResult: text = ""
    state stateValidResult: bool = false

    state deriveNameResult: text = ""
    state deriveCoreResult: text = ""
    state deriveExprRawResult: text = ""
    state deriveValidResult: bool = false

    state webhookPathResult: text = ""
    state webhookActionResult: text = ""
    state webhookSecretResult: text = ""
    state webhookValidResult: bool = false

    state jobNameResult: text = ""
    state jobActionResult: text = ""
    state jobEveryResult: int = 0
    state jobOnStartResult: bool = false
    state jobValidResult: bool = false

    state policyNameResult: text = ""
    state policyParamNamesResult: [text] = []
    state policyParamTypesResult: [text] = []
    state policyParamOptionalsResult: [bool] = []
    state policyValidResult: bool = false

    state serviceNameResult: text = ""
    state serviceUrlResult: text = ""
    state serviceHeaderValidResult: bool = false
    state serviceOpNameResult: text = ""
    state serviceOpParamNamesResult: [text] = []
    state serviceOpParamTypesResult: [text] = []
    state serviceOpHasRetResult: bool = false
    state serviceOpRetCoreResult: text = ""
    state serviceOpRetIsListResult: bool = false
    state serviceOpValidResult: bool = false

    action runParseProcHeader(lineText: text):
        let a1 = do parseProcHeaderName(lineText)
        let a2 = do parseProcHeaderValid(lineText)
        let a3 = do parseProcHeaderParamNames(lineText)
        let a4 = do parseProcHeaderParamTypes(lineText)
        let a5 = do parseProcHeaderParamLists(lineText)
        let a6 = do parseProcHeaderParamOptionals(lineText)
        let a7 = do parseProcHeaderHasRet(lineText)
        let a8 = do parseProcHeaderRetCore(lineText)
        let a9 = do parseProcHeaderRetIsList(lineText)
        let a10 = do parseProcHeaderRetIsOptional(lineText)
        let a11 = do parseProcHeaderUses(lineText)
        headerNameResult = a1
        headerValidResult = a2
        paramNamesResult = a3
        paramTypesResult = a4
        paramListsResult = a5
        paramOptionalsResult = a6
        hasRetResult = a7
        retCoreResult = a8
        retIsListResult = a9
        retIsOptionalResult = a10
        usesResult = a11

    action runCheckStatement(s: text):
        let b1 = do checkStatementValid(s)
        let b2 = do checkConditionText(s)
        let b3 = do checkMessageRaw(s)
        checkValidResult = b1
        checkConditionResult = b2
        checkMessageResult = b3

    action runDeclKeyword(lineText: text):
        let c1 = do declKeywordOf(lineText)
        declKeywordResult = c1

    action runParseEntityHeader(lineText: text):
        let head = do entityHeadOf(lineText)
        let name = do entityHeaderName(head)
        let valid = do entityHeaderValid(lineText)
        let soft = do entityHeaderHasSoftDelete(head)
        let eph = do entityHeaderHasEphemeral(head)
        entityHeaderNameResult = name
        entityHeaderValidResult = valid
        entitySoftDeleteResult = soft
        entityEphemeralResult = eph

    action runParseEntityField(lineText: text):
        let name = do entityFieldNameOf(lineText)
        let ft = do entityFieldTypeRawOf(lineText)
        let core = do entityFieldCore(ft)
        let isList = do entityFieldIsList(ft)
        let isOptional = do entityFieldIsOptional(ft)
        let secret = do entityFieldSecret(ft)
        let e2e = do entityFieldE2E(ft)
        let unique = do entityFieldUnique(ft)
        let required = do entityFieldRequired(ft)
        let restrict = do entityFieldRestrict(ft)
        let setNull = do entityFieldSetNull(ft)
        let hasMin = do entityFieldHasMin(ft)
        let minValue = do entityFieldMinValue(ft)
        let hasMax = do entityFieldHasMax(ft)
        let maxValue = do entityFieldMaxValue(ft)
        let hasRequires = do entityFieldHasRequires(ft)
        let requiresPolicy = do entityFieldRequiresPolicy(ft)
        let matchesPattern = do entityFieldMatchesPattern(ft)
        let valid = do entityFieldValid(lineText)
        entityFieldNameResult = name
        entityFieldCoreResult = core
        entityFieldIsListResult = isList
        entityFieldIsOptionalResult = isOptional
        entityFieldSecretResult = secret
        entityFieldE2EResult = e2e
        entityFieldUniqueResult = unique
        entityFieldRequiredResult = required
        entityFieldRestrictResult = restrict
        entityFieldSetNullResult = setNull
        entityFieldHasMinResult = hasMin
        entityFieldMinValueResult = minValue
        entityFieldHasMaxResult = hasMax
        entityFieldMaxValueResult = maxValue
        entityFieldHasRequiresResult = hasRequires
        entityFieldRequiresPolicyResult = requiresPolicy
        entityFieldMatchesPatternResult = matchesPattern
        entityFieldValidResult = valid

    action runParseState(lineText: text):
        let name = do stateNameOf(lineText)
        let placement = do statePlacement(lineText)
        let core = do stateCore(lineText)
        let isList = do stateIsList(lineText)
        let isOptional = do stateIsOptional(lineText)
        let hasDefault = do stateHasDefault(lineText)
        let defaultRaw = do stateDefaultRaw(lineText)
        let valid = do stateValid(lineText)
        stateNameResult = name
        statePlacementResult = placement
        stateCoreResult = core
        stateIsListResult = isList
        stateIsOptionalResult = isOptional
        stateHasDefaultResult = hasDefault
        stateDefaultRawResult = defaultRaw
        stateValidResult = valid

    action runParseDerive(lineText: text):
        let name = do deriveNameOf(lineText)
        let core = do deriveCore(lineText)
        let exprRaw = do deriveExprRaw(lineText)
        let valid = do deriveValid(lineText)
        deriveNameResult = name
        deriveCoreResult = core
        deriveExprRawResult = exprRaw
        deriveValidResult = valid

    action runParseWebhook(lineText: text):
        let p1 = do parseWebhookPath(lineText)
        let p2 = do parseWebhookAction(lineText)
        let p3 = do parseWebhookSecret(lineText)
        let p4 = do parseWebhookValid(lineText)
        webhookPathResult = p1
        webhookActionResult = p2
        webhookSecretResult = p3
        webhookValidResult = p4

    action runParseJob(lineText: text):
        let j1 = do parseJobName(lineText)
        let j2 = do parseJobAction(lineText)
        let j3 = do parseJobEverySeconds(lineText)
        let j4 = do parseJobOnStart(lineText)
        let j5 = do parseJobValid(lineText)
        jobNameResult = j1
        jobActionResult = j2
        jobEveryResult = j3
        jobOnStartResult = j4
        jobValidResult = j5

    action runParsePolicyHeader(lineText: text):
        let q1 = do parsePolicyName(lineText)
        let q2 = do parsePolicyParamNames(lineText)
        let q3 = do parsePolicyParamTypes(lineText)
        let q4 = do parsePolicyParamOptionals(lineText)
        let q5 = do parsePolicyValid(lineText)
        policyNameResult = q1
        policyParamNamesResult = q2
        policyParamTypesResult = q3
        policyParamOptionalsResult = q4
        policyValidResult = q5

    action runParseServiceHeader(lineText: text):
        let s1 = do parseServiceName(lineText)
        let s2 = do parseServiceUrl(lineText)
        let s3 = do parseServiceHeaderValid(lineText)
        serviceNameResult = s1
        serviceUrlResult = s2
        serviceHeaderValidResult = s3

    action runParseServiceOp(opLineText: text):
        let o1 = do parseServiceOpName(opLineText)
        let o2 = do parseServiceOpParamNames(opLineText)
        let o3 = do parseServiceOpParamTypes(opLineText)
        let o4 = do parseServiceOpHasRet(opLineText)
        let o5 = do parseServiceOpRetCore(opLineText)
        let o6 = do parseServiceOpRetIsList(opLineText)
        let o7 = do parseServiceOpValid(opLineText)
        serviceOpNameResult = o1
        serviceOpParamNamesResult = o2
        serviceOpParamTypesResult = o3
        serviceOpHasRetResult = o4
        serviceOpRetCoreResult = o5
        serviceOpRetIsListResult = o6
        serviceOpValidResult = o7

    view Home at "/":
        box:
            text "{headerNameResult} {headerValidResult} {paramNamesResult} {paramTypesResult} {paramListsResult} {paramOptionalsResult}"
            text "{hasRetResult} {retCoreResult} {retIsListResult} {retIsOptionalResult} {usesResult}"
            text "{checkValidResult} {checkConditionResult} {checkMessageResult} {declKeywordResult}"
            text "{entityHeaderNameResult} {entityHeaderValidResult} {entitySoftDeleteResult} {entityEphemeralResult}"
            text "{entityFieldNameResult} {entityFieldCoreResult} {entityFieldIsListResult} {entityFieldIsOptionalResult} {entityFieldValidResult}"
            text "{entityFieldSecretResult} {entityFieldE2EResult} {entityFieldUniqueResult} {entityFieldRequiredResult} {entityFieldRestrictResult} {entityFieldSetNullResult}"
            text "{entityFieldHasMinResult} {entityFieldMinValueResult} {entityFieldHasMaxResult} {entityFieldMaxValueResult} {entityFieldHasRequiresResult} {entityFieldRequiresPolicyResult} {entityFieldMatchesPatternResult}"
            text "{stateNameResult} {statePlacementResult} {stateCoreResult} {stateIsListResult} {stateIsOptionalResult} {stateHasDefaultResult} {stateDefaultRawResult} {stateValidResult}"
            text "{deriveNameResult} {deriveCoreResult} {deriveExprRawResult} {deriveValidResult}"
            text "{webhookPathResult} {webhookActionResult} {webhookSecretResult} {webhookValidResult}"
            text "{jobNameResult} {jobActionResult} {jobEveryResult} {jobOnStartResult} {jobValidResult}"
            text "{policyNameResult} {policyParamNamesResult} {policyParamTypesResult} {policyParamOptionalsResult} {policyValidResult}"
            text "{serviceNameResult} {serviceUrlResult} {serviceHeaderValidResult}"
            text "{serviceOpNameResult} {serviceOpParamNamesResult} {serviceOpParamTypesResult} {serviceOpHasRetResult} {serviceOpRetCoreResult} {serviceOpRetIsListResult} {serviceOpValidResult}"
