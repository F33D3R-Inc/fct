import "fabric_controller_plan.fct"

app FabricControllerCoreSelfHost:
    # Self-hosting port of the REST of fabric/crates/fabric-controller/src/
    # — the five files the two earlier slices (fabric_controller_target.fct:
    # target.rs/policy.rs/fleet.rs; fabric_controller_plan.fct: plan.rs/
    # outcome.rs) left unported, read in full before writing a line here:
    #   decision.rs   (139L)  DecisionEnvelope, ValidatedDecision
    #   validation.rs (402L)  ValidationError, MeasurementError, AbortReason
    #                         + all three Display impls
    #   replica.rs    (158L)  ReplicaLedger
    #   execution.rs  (533L)  ExecutionState, PlacementChange,
    #                         ExecutionRecord, ActionRegistry
    #   controller.rs (1422L, ~880L non-test) FabricController: validate /
    #                         check_node_load / resolve_destination /
    #                         validate_plan / submit / advance / tick /
    #                         abort / node_loss / abort_with / measure /
    #                         awaiting_measurement /
    #                         check_measurement_deadline, plus the
    #                         accessors (mechanisms/policy/actions/ledger/
    #                         seed_replicas/record/in_flight/reports/
    #                         placement_changes/register_executor)
    # lib.rs (121L) is doc comment + `pub mod`/`pub use` only — nothing to
    # port. Total: ~1 700 real Rust lines, the crate's actual state
    # machine: validate -> plan -> validate the plan -> admit -> execute ->
    # measure. No async, no tokio, no net, no fs, no clock of its own
    # (every timestamp is a `now_ms` argument on the ControlPlaneView),
    # confirmed by grepping all five files, not assumed from their doc
    # comments.
    #
    # ============================================================
    # WHY THIS MODULE — AND WHAT WAS REJECTED
    # ============================================================
    # Audit of every fabric/crates/**/*.rs against every selfhost/fabric_*
    # header, by line count, largest first:
    #   fabric-routing/table.rs 1598L      -> already fabric_table.fct
    #   fabric-runtime/mechanism.rs 1521L  -> rejected: a thin orchestration
    #      over fabric-runtime/placement.rs's `PlacementFabric` (805L),
    #      which composes RoutingTable + ReplicaSet + Migration +
    #      NodeRegistry across FOUR ports (fabric_table.fct,
    #      fabric_replication.fct, fabric.fct, and an unported registry.rs)
    #      that this directory has already documented cannot all be
    #      imported into one program (fabric_table.fct's own header:
    #      `import "fabric.fct"` was tried and is unfixable). Porting it
    #      "faithfully" would mean re-deriving PlacementFabric on top of
    #      restated copies of three other crates — the opposite of a port.
    #   fabric-daemon/control.rs 1516L     -> rejected: 42 async/await
    #      sites, HTTP clients, process plumbing. Not logic.
    #   fabric-controller/controller.rs 1422L (+ execution/validation/
    #      decision/replica) -> CHOSEN. Pure, self-contained, its every
    #      dependency is already ported and importable through ONE line
    #      (`import "fabric_controller_plan.fct"`, which chains to
    #      fabric_controller_target.fct -> fabric_core.fct +
    #      fabric_routing.fct, and fabric_optimizer.fct ->
    #      fabric_telemetry.fct + fabric_ml.fct), and it ships 9 real unit
    #      tests (`controller::tests`) plus a StubExecutor that make a
    #      genuine behavioural check possible.
    #   fabric-facetql/mover.rs 1367L, frontdoor.rs 991L, poller.rs,
    #      client.rs, proxy.rs -> rejected: socket/SSE/HTTP I/O (fabric.fct's
    #      own header already reached the same verdict).
    #   fabric-daemon/config.rs 1037L      -> rejected: serde/toml
    #      deserialisation + SocketAddr/Path parsing — validation of a
    #      config file format, mostly derive-driven, not an algorithm.
    #   fabric-simulator/simulation.rs 979L + cluster.rs + executor.rs
    #      -> rejected FOR NOW: they implement `PlacementExecutor` and
    #      drive `FabricController` — i.e. they depend on THIS port
    #      existing first. They are the natural next slice.
    #
    # ============================================================
    # WHAT IS PORTED, FUNCTION FOR FUNCTION
    # ============================================================
    # decision.rs: DecisionEnvelope::new/action/action_label/
    #   named_destination; ValidatedDecision::new + every accessor.
    # validation.rs: ValidationError (all 21 variants, every payload field
    #   kept under its own name), MeasurementError (3 variants),
    #   AbortReason (4 variants), and the three `impl Display` bodies
    #   restated arm for arm, format string for format string.
    # replica.rs: ReplicaLedger::new/seed_from_topology/ensure_seeded/add/
    #   remove/holds/count/replicas/projected/apply/targets/len/is_empty.
    # execution.rs: ExecutionState::is_active/is_terminal/label;
    #   PlacementChange::apply; ExecutionRecord::new + every accessor +
    #   has_cut_over/placement_change/report + the pub(crate) mutators
    #   begin_phase/set_fraction/complete_phase/phase_elapsed_ms/commit/
    #   conclude_measured/conclude_unmeasured/conclude_aborted;
    #   ActionRegistry::new/next_id/admit/retire/get/get_mut/records/
    #   active/active_ids/active_len/holder_of/shard_holder/shard_is_busy/
    #   node_load/len/is_empty.
    # controller.rs: everything listed at the top of this header, plus the
    #   test module's own `StubExecutor` (name "stub": supports every action
    #   but NoAction; plans Prepare/Transfer/Cutover/Cleanup at Coordinate
    #   scope with adds=[destination] and removes=[source] unless
    #   `dropping(...)` overrode them; completes a phase on the first poll
    #   whose at_ms is strictly after the phase began; rollback is
    #   Irreversible("authority already moved") once Cutover completed,
    #   Restored otherwise) — ported verbatim because it is the one
    #   `PlacementExecutor` this crate itself ships, and the thing its own
    #   tests drive the controller with.
    #
    # ============================================================
    # DELIBERATE SIMPLIFICATIONS — every one named, none silent
    # ============================================================
    # 1. `Vec<Box<dyn PlacementExecutor>>` — a trait object — has no
    #    analogue in a language with no dynamic dispatch. `Executor` below
    #    is a CLOSED struct dispatched on `kind`; the one kind implemented
    #    is "stub" (above). `executorPlan/BeginPhase/PollPhase/Abort` are
    #    the trait's four methods; an unknown `kind` degrades to an
    #    `Internal` fault / `UnsupportedAction` rather than crashing. The
    #    real production mechanism (fabric-runtime's PlacementMechanism) is
    #    NOT here — see "rejected" above. Adding a kind is adding one arm to
    #    each of those four procs; the controller never inspects `kind`.
    # 2. `&mut self` everywhere -> functional update. Every mutator returns
    #    the new value, and every controller entry point that mutates
    #    returns a result struct carrying the updated `controller` (this
    #    directory's universal convention: `nodeStatusWithLoad`,
    #    `topologyRegistryPlace`). A proc returning a struct cannot be
    #    bound from an action, so the demo procs at the bottom return
    #    scalar `text` summaries instead.
    # 3. `BTreeMap<u64, ExecutionRecord>` -> `[ExecutionRecord]` kept
    #    sorted by id on insert (`actionRegistryInsertRecord`);
    #    `BTreeMap<ActionTarget, u64>` / `BTreeMap<u64, BTreeSet<u64>>` /
    #    `BTreeMap<String, BTreeSet<u64>>` -> flat arrays of (key, id)
    #    pairs (`TargetHold`/`ShardHold`/`NodeHold`), which makes "the set
    #    became empty, drop the key" implicit. `shard_is_busy`'s
    #    `set.iter().next()` (the SMALLEST id) is restated as an explicit
    #    minimum scan. `BTreeSet<String>` (the ledger) -> a `[text]` kept
    #    sorted and unique by `replicaTextSetInsert` (real lexicographic
    #    `<` on text — confirmed in runtime/eval.go's applyBin).
    # 4. `Option<T>` -> `hasX: bool` + `x: T` pairs, or a two-field
    #    `{has, val}` struct for returns (this directory's convention).
    # 5. `ExecutionState::Running { phase, fraction }` carries payload; the
    #    other five variants do not. The record stores `execState: text`
    #    (tag values already equal `label()`'s six strings: "admitted" |
    #    "running" | "awaiting-measurement" | "completed" | "rolled-back" |
    #    "failed") plus `runningPhase`/`runningFraction`, meaningful only
    #    while `execState == "running"`.
    # 6. Field renames forced by the grammar, noted so a reader can map
    #    back: `state` -> `execState`, `from`/`to` -> `fromNode`/`toNode`,
    #    `abort` -> `abortReason`, and ValidationError's two differently
    #    typed `limit` payloads -> `limitUtilization: float` /
    #    `limitCount: int`.
    # 7. `{:.3}` float formatting -> `ctrlFloatFixed` (the same restatement
    #    fabric_cli_render.fct/fabric_simulator_base.fct already use):
    #    `round()` here is round-half-away-from-zero, Rust's is
    #    round-half-to-even; no value in any test below sits on a .0005
    #    boundary, so the outputs are identical for everything checked.
    # 8. `Debug`/`Serialize`/`Deserialize`/`Default` derives are trait
    #    machinery, not logic; `Default for FabricController` IS logic
    #    (`new(ControllerPolicy::default())`) and is `fabricControllerDefault`.
    # 9. `usize::saturating_sub` -> `max(a - b, 0)` (fabric_stats.fct's
    #    `statsSaturatingSub` precedent). Iterator-returning accessors
    #    (`records()`, `active()`, `in_flight()`, `targets()`) return
    #    arrays.
    # 10. `ActionRegistry::get_mut` (a mutable borrow) has no analogue; the
    #    controller reads a record with `actionRegistryGet`, rebuilds it,
    #    and writes it back with `actionRegistrySetRecord` (BTreeMap
    #    insert-by-id, i.e. `records.insert(id, record)`).
    #
    # Everything imported is used at its real shape: `Coordinate`/`DbmsId`
    # (fabric_core.fct), `Placement`/`TopologyRegistry` (fabric_routing.fct,
    # where `Placement.dbmsId` is a bare `text` — every `source.dbms_id`
    # read below wraps it as `DbmsId{value: ...}`), `WorkloadProfile`/
    # `WorkloadMetrics` (fabric_telemetry.fct), `OptimizationAction`/
    # `OptimizationDecision` (fabric_optimizer.fct), `ActionTarget`/
    # `ActionId`/`ControllerPolicy`/`NodeStatus`/`FleetView`/
    # `ControlPlaneView` (fabric_controller_target.fct), and
    # `PlacementPlan`/`PlanRequest`/`PlanError`/`PhaseProgress`/
    # `ExecutionFault`/`RollbackOutcome`/`MeasurementSnapshot`/
    # `ExecutionOutcome`/`OutcomeReport` + `controllerPlanActionLabel`
    # (fabric_controller_plan.fct). Nothing is redeclared.

    # ============================================================
    # small text helpers — `{:.N}` and its padding, local to this file
    # ============================================================
    proc ctrlPow10(n: int) -> int:
        let mut result = 1
        let mut i = 0
        loop i < n:
            result = result * 10
            i = i + 1
        return result

    proc ctrlPadLeftZero(s: text, width: int) -> text:
        let mut result = s
        loop len(result) < width:
            result = "0" + result
        return result

    # ctrlFloatFixed: `{:.N}` — see simplification 7 in this file's header.
    proc ctrlFloatFixed(v: float, decimals: int) -> text:
        let neg = v < 0.0
        let av = abs(v)
        let scale = do ctrlPow10(decimals)
        let scaleFloat = toFloat(scale)
        let scaled = round(av * scaleFloat)
        let intPart = scaled / scale
        let fracPart = scaled % scale
        let fracRaw = "" + fracPart
        let fracText = do ctrlPadLeftZero(fracRaw, decimals)
        let mut result = "" + intPart
        if decimals > 0:
            result = result + "." + fracText
        if neg:
            result = "-" + result
        return result

    proc ctrlJoinText(items: [text], sep: text) -> text:
        let n = len(items)
        let mut out = ""
        let mut i = 0
        loop i < n:
            if i > 0:
                out = out + sep
            out = out + items[i]
            i = i + 1
        return out

    # ============================================================
    # decision.rs — DecisionEnvelope: an optimizer decision bound to WHEN
    # it was true. `target` is built from the decision's own shard_id/
    # coordinate, never taken from the caller ("there is exactly one place
    # that says which cell a decision is about").
    # ============================================================
    struct DecisionEnvelope:
        decision: OptimizationDecision
        target: ActionTarget
        observedAtMs: int
        topologyGeneration: int

    proc decisionEnvelopeNew(decision: OptimizationDecision, observedAtMs: int, topologyGeneration: int) -> DecisionEnvelope:
        let target = do actionTargetNew(decision.shardId, decision.coordinate)
        return DecisionEnvelope{decision: decision, target: target, observedAtMs: observedAtMs, topologyGeneration: topologyGeneration}

    proc optimizationDecisionZero() -> OptimizationDecision:
        let noAction = do optimizationActionNoAction()
        return OptimizationDecision{shardId: 0, coordinate: Coordinate{x: 0, y: 0}, action: noAction, expectedGain: 0.0, estimatedCost: 0.0, confidence: 0.0}

    proc decisionEnvelopeZero() -> DecisionEnvelope:
        let decision = do optimizationDecisionZero()
        return DecisionEnvelope{decision: decision, target: ActionTarget{shardId: 0, coordinate: Coordinate{x: 0, y: 0}}, observedAtMs: 0, topologyGeneration: 0}

    proc decisionEnvelopeAction(e: DecisionEnvelope) -> OptimizationAction:
        return e.decision.action

    proc decisionEnvelopeActionLabel(e: DecisionEnvelope) -> text:
        let label = do controllerPlanActionLabel(e.decision.action)
        return label

    struct DbmsIdOption:
        has: bool
        val: DbmsId

    # decisionEnvelopeNamedDestination: Replicate/Move name a node; Split/
    # Isolate name none by construction; Colocate names a COORDINATE, so
    # its node is resolved from the topology during validation instead.
    proc decisionEnvelopeNamedDestination(e: DecisionEnvelope) -> DbmsIdOption:
        let kind = e.decision.action.kind
        if kind == "Replicate" || kind == "Move":
            return DbmsIdOption{has: true, val: DbmsId{value: e.decision.action.target}}
        return DbmsIdOption{has: false, val: DbmsId{value: ""}}

    # ValidatedDecision: "validated is a thing the compiler can see" —
    # only `fabricControllerValidate` below builds one, and only
    # `fabricControllerSubmit` consumes one. `destination`/
    # `destination_region` are `Option`s (simplification 4).
    struct ValidatedDecision:
        envelope: DecisionEnvelope
        source: Placement
        hasDestination: bool
        destination: DbmsId
        hasDestinationRegion: bool
        destinationRegion: text
        validatedAtMs: int

    proc validatedDecisionNew(envelope: DecisionEnvelope, source: Placement, hasDestination: bool, destination: DbmsId, hasDestinationRegion: bool, destinationRegion: text, validatedAtMs: int) -> ValidatedDecision:
        return ValidatedDecision{envelope: envelope, source: source, hasDestination: hasDestination, destination: destination, hasDestinationRegion: hasDestinationRegion, destinationRegion: destinationRegion, validatedAtMs: validatedAtMs}

    proc validatedDecisionZero() -> ValidatedDecision:
        let envelope = do decisionEnvelopeZero()
        return ValidatedDecision{envelope: envelope, source: Placement{dbmsId: "", shardId: 0, coordinate: Coordinate{x: 0, y: 0}, region: ""}, hasDestination: false, destination: DbmsId{value: ""}, hasDestinationRegion: false, destinationRegion: "", validatedAtMs: 0}

    proc validatedDecisionTarget(v: ValidatedDecision) -> ActionTarget:
        return v.envelope.target

    proc validatedDecisionDecision(v: ValidatedDecision) -> OptimizationDecision:
        return v.envelope.decision

    proc validatedDecisionSourceId(v: ValidatedDecision) -> DbmsId:
        return DbmsId{value: v.source.dbmsId}

    # ============================================================
    # validation.rs — ValidationError: every reason the controller will
    # refuse to act, typed and carrying its evidence. One struct, a `kind`
    # discriminant (the real variant name) plus every payload field any
    # variant carries, each under its own real name (simplification 6 for
    # the two renames). Unused fields sit at their zero.
    # ============================================================
    struct ValidationError:
        kind: text
        score: float
        confidence: float
        minConfidence: float
        coordinate: Coordinate
        observedAtMs: int
        nowMs: int
        ageMs: int
        maxAgeMs: int
        decisionGeneration: int
        currentGeneration: int
        target: ActionTarget
        node: DbmsId
        condition: text
        hosted: int
        capacity: int
        utilization: float
        limitUtilization: float
        shardId: int
        existing: ActionId
        existingAction: text
        inFlight: int
        limitCount: int
        remaining: int
        minimum: int
        action: text
        planError: PlanError

    proc validationErrorZero() -> ValidationError:
        let noErr = do planErrorEmptyPlan()
        return ValidationError{kind: "", score: 0.0, confidence: 0.0, minConfidence: 0.0, coordinate: Coordinate{x: 0, y: 0}, observedAtMs: 0, nowMs: 0, ageMs: 0, maxAgeMs: 0, decisionGeneration: 0, currentGeneration: 0, target: ActionTarget{shardId: 0, coordinate: Coordinate{x: 0, y: 0}}, node: DbmsId{value: ""}, condition: "", hosted: 0, capacity: 0, utilization: 0.0, limitUtilization: 0.0, shardId: 0, existing: ActionId{value: 0}, existingAction: "", inFlight: 0, limitCount: 0, remaining: 0, minimum: 0, action: "", planError: noErr}

    proc validationErrorNoActionRequested() -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "NoActionRequested", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: z.node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorBelowExecutionThreshold(score: float, confidence: float, minConfidence: float) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "BelowExecutionThreshold", score: score, confidence: confidence, minConfidence: minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: z.node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorInvalidCoordinate(coordinate: Coordinate) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "InvalidCoordinate", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: z.node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorStaleDecision(observedAtMs: int, nowMs: int, ageMs: int, maxAgeMs: int) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "StaleDecision", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: observedAtMs, nowMs: nowMs, ageMs: ageMs, maxAgeMs: maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: z.node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorDecisionFromTheFuture(observedAtMs: int, nowMs: int) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "DecisionFromTheFuture", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: observedAtMs, nowMs: nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: z.node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorTopologySuperseded(decisionGeneration: int, currentGeneration: int) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "TopologySuperseded", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: decisionGeneration, currentGeneration: currentGeneration, target: z.target, node: z.node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorUnknownPlacement(target: ActionTarget) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "UnknownPlacement", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: target, node: z.node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorUnknownDestination(node: DbmsId) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "UnknownDestination", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorDestinationUnhealthy(node: DbmsId, condition: text) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "DestinationUnhealthy", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: node, condition: condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorDestinationAtCapacity(node: DbmsId, hosted: int, capacity: int) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "DestinationAtCapacity", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: node, condition: z.condition, hosted: hosted, capacity: capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorDestinationSaturated(node: DbmsId, utilization: float, limitUtilization: float) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "DestinationSaturated", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: utilization, limitUtilization: limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorDestinationIsSource(node: DbmsId) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "DestinationIsSource", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

