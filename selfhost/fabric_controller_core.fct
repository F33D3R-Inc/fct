        return ValidationError{kind: "ShardBusy", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: z.node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: shardId, existing: existing, existingAction: z.existingAction, inFlight: z.inFlight, limitCount: z.limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

    proc validationErrorNodeBusy(node: DbmsId, inFlight: int, limitCount: int) -> ValidationError:
        let z = do validationErrorZero()
        return ValidationError{kind: "NodeBusy", score: z.score, confidence: z.confidence, minConfidence: z.minConfidence, coordinate: z.coordinate, observedAtMs: z.observedAtMs, nowMs: z.nowMs, ageMs: z.ageMs, maxAgeMs: z.maxAgeMs, decisionGeneration: z.decisionGeneration, currentGeneration: z.currentGeneration, target: z.target, node: node, condition: z.condition, hosted: z.hosted, capacity: z.capacity, utilization: z.utilization, limitUtilization: z.limitUtilization, shardId: z.shardId, existing: z.existing, existingAction: z.existingAction, inFlight: inFlight, limitCount: limitCount, remaining: z.remaining, minimum: z.minimum, action: z.action, planError: z.planError}

