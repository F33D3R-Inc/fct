import "runtime_eval_ir.fct"

app RuntimeJSON:
    # runtime_json.fct — encoding/json's Marshal over the runtime's values:
    # a record's keys sorted (Go sorts a map's keys on encode), strings
    # escaped the way ir_expr.fct's jsonQuote already spells them (Go's
    # HTML-safe escapes included), an integral float as an integer, none as
    # null — the shape every JSON the runtime answers with takes (a page's
    # state bootstrap, an action's deltas, an API row, an SSE frame).
    # The encoder itself (rtValJSON / rtObjectJSON / rtObjectJSONRaw /
    # rtJValToVal / rtSortedIndex) lives in runtime_eval_ir.fct, where the
    # evaluator's own canonicalJson builtin reaches it.
    proc rtJSONPlaceholder() -> bool:
        return true
