app FabricSelfHost:
    # Self-hosting port of fabric/crates/fabric-facetql/src/frontdoor/keyspace.rs
    # — the declared map from FacetQL's namespace (a `kind` name, or an
    # `address` string) to one Fabric `RoutingKey`. Read in full before writing
    # this file, alongside fabric-routing's `RoutingKey`/`Coordinate` (for the
    # value this port threads through) and frontdoor/plan.rs (the module that
    # actually calls `Keyspace::resolve` once per incoming request).
    #
    # ============================================================
    # WHY THIS PIECE, OUT OF ALL OF FABRIC:
    # ============================================================
    # `fabric/` was last characterized as an immature scaffold. Reading it
    # fresh (16 crates, ~31 000 lines of non-test Rust as of this port) shows
    # that characterization is now WRONG for the crate this task cares about:
    # `fabric-facetql` alone is ~7 250 lines across client/wire/poller/sample/
    # mover/placement/frontdoor, and most of it is genuine logic, not
    # boilerplate. But most of THAT logic is disqualified for a self-hosting
    # port for one of two reasons this file's header states plainly rather
    # than glossing over:
    #   - it is fundamentally I/O (client.rs's HTTP calls, poller.rs's stats
    #     polling loop, mover.rs's keyset-cursor walk + SSE catch-up — real
    #     protocol logic, but ABOUT talking to a socket, not a pure function
    #     of already-in-hand data);
    #   - or it is a thin CAS-over-HTTP wrapper (placement.rs's
    #     PlacementStore::create/update/remove — the interesting part, the
    #     compare-and-set contract, is FacetQL's `set_if`/`if_absent`, not
    #     anything fabric COMPUTES).
    # `frontdoor/keyspace.rs` is the exception: `Keyspace::resolve` and the
    # construction-time checks around it are a PURE decision procedure over
    # already-decoded strings and a small declared rule table — no socket, no
    # async, no serde — exactly the shape predicate.fct and storage.fct were
    # each chosen for. `frontdoor/plan.rs` (the module keyspace.rs feeds) is
    # ALSO pure and arguably more central, but it is ~980 lines dispatching
    # on axum's `Method`/HTTP path/route-specific body shapes for every one of
    # FacetQL's ~30 routes — real content, but glue-shaped (a giant match, not
    # an algorithm) and sized for a port of its own, not a shared file with
    # something else. keyspace.rs is the load-bearing ALGORITHM inside it: the
    # longest-prefix-match-plus-consistency-check that plan.rs calls once per
    # request and refuses to second-guess.
    #
    # ============================================================
    # WHAT keyspace.rs's REAL LOGIC ACTUALLY IS (verified by reading
    # frontdoor/keyspace.rs in full, not assumed from its module doc):
    # ============================================================
    # A `Keyspace` is a small table of rules — each rule states "kind K, AND
    # every address beginning prefix P, both route to routing key X" — plus an
    # optional fallback key for anything no rule covers. `resolve(kind,
    # address)` is called with EITHER or BOTH of a kind and an address (a
    # `POST /node` supplies both; a `GET /nodes?kind=` supplies only a kind;
    # a `GET /node/:address` supplies only an address) and must produce
    # exactly one of three outcomes:
    #   - Ok(key)          — every part of the request that named a rule
    #                        agrees, or only one part named a rule, or
    #                        neither did but a fallback exists.
    #   - Unmapped         — nothing covers this request and there is no
    #                        fallback: refuse rather than guess.
    #   - Inconsistent      — the request named BOTH a kind and an address,
    #                        and they resolve to DIFFERENT keys: the
    #                        operator's own declared table is being violated,
    #                        so the write is refused rather than filed
    #                        somewhere its own kind's queries will never
    #                        look.
    # `for_kind` is an exact-name lookup. `for_address` is LONGEST-PREFIX-WINS
    # (`__fabric_placement:` beats `__` on the same address) via Rust's
    # `.max_by_key(|rule| rule.address_prefix.len())` — and `max_by_key`'s own
    # documented tie-break is "the LAST equally-maximal element wins", which
    # matters here and is restated deliberately below, not glossed over as
    # "pick either": two rules of the SAME prefix length are already refused
    # at construction time (`DuplicateAddressPrefix`), but nothing stops two
    # DIFFERENT rules from having prefixes of the same length as each OTHER
    # (e.g. "Post:" and "User:" both length 5) — the tie only ever fires
    # between two rules that could not both match one address to begin with,
    # so it is unreachable in practice, but this port matches Rust's real
    # tie-break exactly rather than inventing a different one that happens to
    # agree today.
    #
    # A keyspace is also validated once, at CONSTRUCTION: `KeyspaceRule::new`
    # refuses an empty kind or an empty address prefix (an empty prefix would
    # match every address, which is what the fallback is for), and
    # `Keyspace::with_rule` refuses a second rule for a kind or a prefix
    # already declared — checked in that exact order (empty kind, then empty
    # prefix, then duplicate kind, then duplicate prefix) because that is the
    # order the two Rust functions run in when a caller builds a rule and
    # then adds it.
    #
    # `spanning_key` answers a different question: is there ONE key that
    # answers for the WHOLE namespace (every rule's key, and the fallback,
    # all the same)? True for a single-shard deployment (or one that has not
    # actually been split yet) and false the moment any rule points somewhere
    # the fallback does not.
    #
    # ============================================================
    # ROUTING-KEY REPRESENTATION — the design decision this port has to make
    # explicit, the same way predicate.fct's header states its row
    # representation and storage.fct's states its byte-buffer one:
    # ============================================================
    # `fabric_routing::RoutingKey` is `{ shard_id: u64, coordinate:
    # fabric_core::Coordinate }`, and `Coordinate` is `{ x: u8, y: u8 }` with
    # `x < 12 && y < 13` (`Coordinate::is_valid`) and `index() = y*12 + x`,
    # i.e. exactly 156 valid cells per shard (`fabric_core/src/coordinate.rs`,
    # read directly, not assumed). A proc returns one scalar (LANGUAGE.md's
    # `proc` section — no record/tuple return), and keyspace.rs itself never
    # does arithmetic ON a `RoutingKey` beyond equality — every real
    # operation this file ports is "are these two keys the SAME key", never
    # "what shard is this" or "what cell is this" — so a `RoutingKey` is
    # represented here as ONE `int`, packed as `shard_id * 156 +
    # coordinate.index()`. This is a lossless encoding of the real type for
    # every value keyspace.rs's own tests actually use (small shard ids,
    # `Coordinate::new(0, 0)` in every test fixture) and is never unpacked
    # back into shard/x/y anywhere below, exactly because nothing in
    # `Keyspace::resolve` needs to: it is an opaque comparable token from
    # `resolve`'s point of view, restated as an int instead of a struct
    # purely so it can live in an `[int]` array and flow through a proc
    # return the way LANGUAGE.md allows.
    #
    # ============================================================
    # OPTIONAL PARAMETERS — `resolve(kind: Option<&str>, address:
    # Option<&str>)`:
    # ============================================================
    # fct has no option/union type (checked against LANGUAGE.md's full type
    # list before assuming one — scalars, `[T]` of one scalar type, nothing
    # else). Exactly like predicate.fct's row design turns an absent field
    # into a defined "kind" tag rather than a null pointer, an absent kind or
    # address here is a separate `bool` flag (`hasKind`/`hasAddress`) plus a
    # text value that is simply ignored when the flag is false — mirroring
    # `KeyspaceMiss::Unmapped`'s own `Option<String>` fields, which likewise
    # exist only to be printed, never branched on beyond "was one supplied".
    #
    # ============================================================
    # WHY TWO FAMILIES OF PROC ("resolveStatus" vs "resolveKey") INSTEAD OF
    # ONE, restating predicate.fct's own header rationale for the identical
    # reason:
    # ============================================================
    # A proc cannot return "an outcome tag PLUS a payload that depends on the
    # tag" in one call. `keyspaceResolveStatus` is the gatekeeper — it runs
    # the WHOLE decision (kind lookup, address lookup, the consistency
    # check, the fallback) and reports one of three outcome codes (0=Ok,
    # 1=Unmapped, 2=Inconsistent), mirroring `Result<RoutingKey,
    # KeyspaceMiss>`'s two-variant-of-which-one-has-two-shapes shape flattened
    # into three plain codes. `keyspaceResolveKey` re-derives the identical
    # lookup and returns the actual key — defined (and only ever called)
    # when `keyspaceResolveStatus` already returned 0, exactly like
    # predicate.fct's `evalNum`/`evalText`/`evalBool` are only ever called
    # once `evalKind` has already vetted the node. Both procs are pure
    # re-derivations of the same two lookups, guaranteed to agree because
    # both are pure functions of the identical input — paid for by doing the
    # kind/address lookup twice on the `Ok` path rather than once.
    #
    # ============================================================
    # RULE-TABLE REPRESENTATION:
    # ============================================================
    # REWRITE NOTE (struct milestone): a routing rule's three declared
    # facts (its kind name, its address prefix, its routing key) used to
    # be threaded as three parallel arrays, aligned by hand-maintained
    # index — the same shape predicate.fct's own header describes
    # replacing. That is exactly "several named facts about one entity",
    # so it is now a real `RoutingRule` struct and the table is one
    # `[RoutingRule]` array:
    #   kind:   text  the rule's declared kind name
    #   prefix: text  the rule's declared address prefix
    #   key:    int   the rule's routing key (packed, see above)
    # plus `hasFallback: bool` / `fallbackKey: int` for the keyspace's single
    # optional fallback (there is at most one, so it needs no array).
    struct RoutingRule:
        kind: text
        prefix: text
        key: int

    # ============================================================
    # SMALL STRING HELPER — restates the exact `starts_with` idiom
    # predicate.fct's own `evalBinBool` (opCode 13) already uses for
    # FacetQL's `starts_with` operator: false whenever the needle is longer
    # than the haystack (never an out-of-bounds slice), true iff the
    # haystack's own leading slice of the needle's length equals it.
    # ============================================================
    proc textStartsWith(haystack: text, prefix: text) -> bool:
        let hlen = len(haystack)
        let plen = len(prefix)
        if plen > hlen:
            return false
        let lead = slice(haystack, 0, plen)
        return lead == prefix

    # ruleIndexForKind: `Keyspace::for_kind` — the first (and, in a validly
    # constructed keyspace, only) rule whose declared kind name matches
    # exactly. Mirrors predicate.fct's own `rowFieldIndex` shape precisely
    # (same "keep looping, but only latch the FIRST hit" pattern) since both
    # are "find this exact name in a table" over an already-validated-unique
    # key.
    proc ruleIndexForKind(rules: [RoutingRule], kind: text) -> int:
        let n = len(rules)
        let mut i = 0
        let mut found = -1
        loop i < n:
            if found == -1:
                if rules[i].kind == kind:
                    found = i
            i = i + 1
        return found

    # ruleIndexForAddress: `Keyspace::for_address` — every rule whose prefix
    # the address starts with, longest prefix wins; a LATER rule of EQUAL
    # length overtakes an earlier one, restating Rust's own `max_by_key`
    # tie-break ("the last equally-maximal element") exactly rather than the
    # more obvious "first longest wins", per the header note above. `>=`
    # (not `>`) on the length comparison is what encodes that tie-break.
    proc ruleIndexForAddress(rules: [RoutingRule], address: text) -> int:
        let n = len(rules)
        let mut i = 0
        let mut bestIdx = -1
        let mut bestLen = -1
        loop i < n:
            let matches = do textStartsWith(address, rules[i].prefix)
            if matches:
                let plen = len(rules[i].prefix)
                if plen >= bestLen:
                    bestIdx = i
                    bestLen = plen
            i = i + 1
        return bestIdx

    # ============================================================
    # THE GATEKEEPER: keyspaceResolveStatus.
    # ============================================================
    # Restates `Keyspace::resolve`'s full match exactly:
    #   (Some(by_kind), Some(by_address)) if by_kind != by_address -> Inconsistent
    #   (Some(key), _) | (None, Some(key))                         -> Ok(key)
    #   (None, None)                                                -> fallback, or Unmapped
    # over this port's two `has*` flags standing in for `Option<&str>`.
    proc keyspaceResolveStatus(rules: [RoutingRule], hasFallback: bool, hasKind: bool, kind: text, hasAddress: bool, address: text) -> int:
        let mut kindIdx = -1
        if hasKind:
            let ki = do ruleIndexForKind(rules, kind)
            kindIdx = ki
        let mut addrIdx = -1
        if hasAddress:
            let ai = do ruleIndexForAddress(rules, address)
            addrIdx = ai

        if kindIdx != -1:
            if addrIdx != -1:
                if rules[kindIdx].key != rules[addrIdx].key:
                    return 2
                return 0
            return 0
        if addrIdx != -1:
            return 0
        if hasFallback:
            return 0
        return 1

    # keyspaceResolveKey: only meaningful once `keyspaceResolveStatus` has
    # already returned 0 for the identical arguments (see header). When both
    # a kind and an address matched, `resolve` itself only reaches this
    # branch once they are already known equal (the `Inconsistent` case took
    # the other branch), so returning the kind-side key is exactly as
    # correct as returning the address-side one — matching Rust's own
    # `(Some(key), _)` pattern, which likewise prefers `by_kind` on a tie.
    proc keyspaceResolveKey(rules: [RoutingRule], fallbackKey: int, hasKind: bool, kind: text, hasAddress: bool, address: text) -> int:
        let mut kindIdx = -1
        if hasKind:
            let ki = do ruleIndexForKind(rules, kind)
            kindIdx = ki
        if kindIdx != -1:
            return rules[kindIdx].key
        let mut addrIdx = -1
        if hasAddress:
            let ai = do ruleIndexForAddress(rules, address)
            addrIdx = ai
        if addrIdx != -1:
            return rules[addrIdx].key
        return fallbackKey

    # ============================================================
    # CONSTRUCTION-TIME VALIDATION — `KeyspaceRule::new` (empty kind / empty
    # prefix) fused with `Keyspace::with_rule` (duplicate kind / duplicate
    # prefix against the rules already in the table), in the exact order the
    # two real functions run when a caller builds a rule and adds it: empty
    # kind, then empty prefix, then duplicate kind, then duplicate prefix.
    # Returns a status code rather than a `Result<_, KeyspaceError>` for the
    # same reason every gatekeeper in this file does (no proc-returnable
    # sum type): 0=ok, 1=EmptyKind, 2=EmptyAddressPrefix, 3=DuplicateKind,
    # 4=DuplicateAddressPrefix.
    # ============================================================
    proc ruleTableHasKind(rules: [RoutingRule], kind: text) -> bool:
        let idx = do ruleIndexForKind(rules, kind)
        return idx != -1

    proc ruleTableHasPrefixExact(rules: [RoutingRule], prefix: text) -> bool:
        let n = len(rules)
        let mut i = 0
        let mut found = false
        loop i < n:
            if rules[i].prefix == prefix:
                found = true
            i = i + 1
        return found

    proc keyspaceAddRuleStatus(rules: [RoutingRule], newKind: text, newPrefix: text) -> int:
        if len(newKind) == 0:
            return 1
        if len(newPrefix) == 0:
            return 2
        let dupKind = do ruleTableHasKind(rules, newKind)
        if dupKind:
            return 3
        let dupPrefix = do ruleTableHasPrefixExact(rules, newPrefix)
        if dupPrefix:
            return 4
        return 0

    # ============================================================
    # spanning_key — is there one key that answers for the WHOLE namespace:
    # a fallback must be declared (an address matching no rule would
    # otherwise have no home), and every rule's key must equal it.
    # `spanningKeyPresent` is this file's gatekeeper for the pair; an empty
    # rule table with a fallback is vacuously "every rule agrees" (the
    # single-shard `Keyspace::single` case), matching Rust's `.all(...)` on
    # an empty iterator returning `true`.
    # ============================================================
    proc allRuleKeysEqual(rules: [RoutingRule], target: int) -> bool:
        let n = len(rules)
        let mut i = 0
        let mut allEq = true
        loop i < n:
            if rules[i].key != target:
                allEq = false
            i = i + 1
        return allEq

    proc spanningKeyPresent(rules: [RoutingRule], hasFallback: bool, fallbackKey: int) -> bool:
        if !hasFallback:
            return false
        let allEq = do allRuleKeysEqual(rules, fallbackKey)
        return allEq

    # ============================================================
    # SECOND PORT, SAME FILE: fabric-replication's `failover.rs` —
    # `FailoverAssessment::evaluate` and its private `ineligibility` helper.
    # ============================================================
    # WHY THIS PIECE: a follow-up survey of fabric/'s other 15 crates (this
    # file originally ported only fabric-facetql/frontdoor/keyspace.rs) found
    # that most of the "placement/replication/scheduling"-shaped crates are
    # exactly what fabric-facetql's own header already warned this survey to
    # expect: fabric-routing's `RoutingTable` (table.rs, ~960 non-test lines)
    # IS a real, pure decision procedure — `resolve`/`candidates`/
    # `write_candidates`/`read_candidates` never touch a socket — but it is
    # also a mutable index over THREE other crates' types (`ReplicaSet`,
    # `Migration`, `TopologyRegistry`) with no self-contained algorithm
    # smaller than "port those three crates too", which is a port of its own,
    # not a shared file with something else — the identical reason
    # `frontdoor/plan.rs` was passed over the first time. fabric-controller
    # (3 757 lines) and fabric-runtime (3 744 lines) are almost entirely
    # orchestration over `dyn` trait objects and channels — real content, but
    # glue-shaped. fabric-optimizer and fabric-ml are explicitly, honestly
    # documented (both in their own doc comments and in the workspace
    # README's "ML predicts, the optimizer decides, the controller executes"
    # line quoted below) as depending on the ML crate's trained-model
    # predictions, which this survey did not verify are pure of RNG/model
    # state the way a hand-checkable decision table is.
    #
    # `fabric-replication/src/failover.rs` is the exception, and it says so
    # about ITSELF, in its own module doc, in almost the same words this
    # file's own header already uses for keyspace.rs: "This module
    # deliberately stops one step short of acting. It reports whether the
    # primary still looks like a primary, which copies could take over, what
    # each promotion would cost, and what is in the way... It does not apply
    # it, there is no timer here, and calling `evaluate` twice changes
    # nothing." `FailoverAssessment::evaluate(set: &ReplicaSet, now_ms: u64,
    # policy: &FailoverPolicy) -> Self` reads a replica set and a clock
    # reading already in hand and returns a verdict — no socket, no async, no
    # serde in the decision path (every `Serialize` derive here is for
    # shipping the VERDICT over the wire afterward, exactly like keyspace.rs's
    # own `RoutingKey`/`KeyspaceMiss`).
    #
    # ============================================================
    # WHAT THE LOGIC ACTUALLY IS (read in full from failover.rs, not assumed
    # from its own doc comment):
    # ============================================================
    # A replica set has at most one primary (this crate's own set.rs invariant
    # header) and zero or more secondaries. `evaluate` answers three questions
    # about it at one instant:
    #   1. `primary_needs_replacement` — is the primary no longer good for
    #      writes? True if there IS no primary, or its own state is not
    #      `InSync`, or it has gone silent for longer than
    #      `policy.primary_silence_ms`. A primary that has NEVER reported is
    #      deliberately NOT silence-flagged (a freshly bootstrapped primary
    #      has no reports yet, and failing over a healthy new shard on that
    #      basis would be exactly the "guess instead of refuse" keyspace.rs's
    #      own header already treats as the failure mode to avoid).
    #   2. For every SECONDARY (the primary is never its own candidate): is it
    #      promotable, and if not, the first reason it isn't
    #      (`ineligibility`, checked in this exact order — matching
    #      `fn ineligibility` read top to bottom): not `InSync` at all; never
    #      reported (no evidence to promote on); its own health report too
    #      stale (past `max_candidate_silence_ms`); promoting it would lose
    #      unapplied writes (`pending_writes > max_promotion_pending_writes`);
    #      or it is too far behind in time
    #      (`apply_lag_ms > max_promotion_apply_lag_ms`).
    #   3. Given 1 and 2: what, if anything, blocks a promotion right now, and
    #      what operation (if any) would resolve it — named, never applied
    #      (`promotion()` returns an `Option<ReplicaOperation>`; nothing in
    #      this crate calls `ReplicaSet::apply` on its own result).
    #
    # ============================================================
    # REWRITE NOTE (struct milestone): a replica's six facts (node id,
    # role, lifecycle state, pending-write count, apply lag, last-report
    # clock reading) used to be threaded as six parallel arrays, aligned
    # by hand-maintained index — this file's own keyspace port already
    # replaced the identical shape for a rule table with a `RoutingRule`
    # struct, above, and a replica record is exactly the same kind of
    # "several named facts about one entity". It is now a real
    # `ReplicaEntry` struct, and a replica set is one `[ReplicaEntry]`
    # array:
    #   node:          text  the replica's node id
    #   isPrimary:     bool  the replica's role (exactly one true in a
    #                        validly constructed non-empty set — set.rs's
    #                        own invariant, restated here, not re-checked)
    #   state:         int   the replica's `ReplicaState`, in the exact
    #                        order replica.rs's own lifecycle diagram
    #                        lists them: 0=Absent, 1=Seeding, 2=InSync,
    #                        3=Lagging, 4=Failed
    #   pendingWrites: int   the replica's `ReplicaLag::pending_writes`
    #   applyLagMs:    int   the replica's `ReplicaLag::apply_lag_ms`
    #   lastReportMs:  int   the replica's `last_report_ms`,
    #                        sentinel-encoded (see below) since fct has
    #                        no option type
    #
    # `ReplicaLag`'s two fields stay two separate struct fields rather
    # than one packed int (contrast keyspace.rs's `RoutingKey`, packed
    # into one scalar because nothing there ever compared its two fields
    # SEPARATELY): `ineligibility` branches on `pendingWrites` and
    # `applyLagMs` against two INDEPENDENT budgets, so packing them would
    # force unpacking right back out for every comparison this file
    # makes — a struct's whole point is that `entry.pendingWrites` and
    # `entry.applyLagMs` can each be read on their own without unpacking
    # anything.
    #
    # `last_report_ms: Option<u64>` is encoded as a plain `int` field with
    # `-1` meaning "never reported" — a sentinel, not a `has*` flag pair
    # like keyspace.rs's `hasKind`/`hasAddress` — because every real
    # timestamp `Replica::silence_ms`/`FailoverAssessment::evaluate` ever
    # compares it against is a non-negative millisecond clock reading
    # (this crate's own `ReplicaReport::timestamp_ms: u64`), so `-1` can
    # never collide with a genuine value, exactly the same reasoning
    # `ruleIndexForKind`'s `-1` "no match" already relies on a few hundred
    # lines up in this same file.
    #
    # The four `FailoverPolicy` knobs every gatekeeper below reads
    # (`primary_silence_ms`/`max_candidate_silence_ms`/
    # `max_promotion_pending_writes`/`max_promotion_apply_lag_ms`) are a
    # real Rust struct too (`failover.rs`'s own `FailoverPolicy`), so they
    # get the identical treatment: one `FailoverPolicy` struct instead of
    # four scalar parameters threaded through every proc in this section.
    struct ReplicaEntry:
        node: text
        isPrimary: bool
        state: int
        pendingWrites: int
        applyLagMs: int
        lastReportMs: int

    struct FailoverPolicy:
        primarySilenceBudgetMs: int
        maxCandidateSilenceMs: int
        maxPromotionPendingWrites: int
        maxPromotionApplyLagMs: int
    #
    # ============================================================
    # SATURATING SUBTRACTION — `Replica::silence_ms`'s `now_ms.saturating_sub(last)`
    # restated with the `max` builtin (`facet lang`'s own list) rather than an
    # `if`, since "clamp a subtraction at zero" is exactly what `max(a - b, 0)`
    # already says without a branch.
    # ============================================================
    proc failoverSaturatingSub(a: int, b: int) -> int:
        return max(a - b, 0)

    # ============================================================
    # INELIGIBILITY — restates `fn ineligibility` exactly, top to bottom, one
    # candidate at a time. Return codes (this file's own numbering; the real
    # `Ineligibility` enum declares them in a different order, which does not
    # matter because at most one branch of this ladder can ever fire):
    #   0 = eligible (Rust's `None`)
    #   1 = NotInSync         2 = NeverReported        3 = HealthTooStale
    #   4 = WouldLoseWrites   5 = TooFarBehind
    # ============================================================
    proc failoverIneligibility(entry: ReplicaEntry, nowMs: int, policy: FailoverPolicy) -> int:
        if entry.state != 2:
            return 1
        if entry.lastReportMs == -1:
            return 2
        let silenceMs = do failoverSaturatingSub(nowMs, entry.lastReportMs)
        if silenceMs > policy.maxCandidateSilenceMs:
            return 3
        if entry.pendingWrites > policy.maxPromotionPendingWrites:
            return 4
        if entry.applyLagMs > policy.maxPromotionApplyLagMs:
            return 5
        return 0

    # failoverPrimaryIndex: the one replica with isPrimary true. Mirrors
    # `ruleIndexForKind`'s exact "keep looping, only latch the FIRST hit"
    # shape — appropriate here for the identical reason: set.rs's own
    # invariant guarantees at most one, so which occurrence a duplicate would
    # latch never actually matters, but the loop is written to make the same
    # promise keyspace.rs's rule lookups already do rather than trust the
    # invariant silently.
    proc failoverPrimaryIndex(entries: [ReplicaEntry]) -> int:
        let n = len(entries)
        let mut i = 0
        let mut found = -1
        loop i < n:
            if found == -1:
                if entries[i].isPrimary:
                    found = i
            i = i + 1
        return found

    # failoverPrimaryNeedsReplacement: restates the `match primary { None =>
    # true, Some(replica) => ... }` exactly — no primary at all, a primary
    # whose own state is not `InSync`, or (only when it HAS reported at least
    # once) a primary silent past `policy.primarySilenceBudgetMs`.
    proc failoverPrimaryNeedsReplacement(entries: [ReplicaEntry], nowMs: int, policy: FailoverPolicy) -> bool:
        let primaryIdx = do failoverPrimaryIndex(entries)
        if primaryIdx == -1:
            return true
        let primary = entries[primaryIdx]
        if primary.state != 2:
            return true
        if primary.lastReportMs != -1:
            let silenceMs = do failoverSaturatingSub(nowMs, primary.lastReportMs)
            if silenceMs > policy.primarySilenceBudgetMs:
                return true
        return false

    proc failoverSetIsEmpty(entries: [ReplicaEntry]) -> bool:
        return len(entries) == 0

    # failoverBestCandidateIndex: `Rust`'s `candidates.sort_by(...)` followed
    # by `.find(is_eligible)`, restated as ONE linear scan rather than a sort
    # — the same "find the extreme by scanning instead of maintaining a
    # sorted structure" convention storage.fct's own
    # `pagerCacheLruVictimIndex` already documents for the identical reason
    # (no sort/map primitive in this language). The real comparator is
    # `eligible-first, then pending_writes ascending, then apply_lag_ms
    # ascending, then node id ascending` and Rust's `sort_by` is STABLE, so a
    # four-way tie falls through to whichever replica came first in the
    # array `sort_by` was called on. That array is `ReplicaSet::secondaries()`,
    # iterating the set's own `replicas: Vec<Replica>` — which `set.rs`'s
    # `ReplicaOperation::Add` handler keeps sorted by node id after every
    # insert (`self.replicas.sort_by(|l, r| l.node.0.cmp(&r.node.0))`, read
    # directly in `set.rs`). So the fourth tie-break this file's job would
    # otherwise be to restate — comparing node id TEXT — is already decided
    # BEFORE this proc ever runs: a caller that hands `nodes`/`isPrimary`/
    # etc. to this file in the same order a real `ReplicaSet` holds them
    # (node-id order) makes "first array index wins a full tie" and "lowest
    # node id wins a full tie" the same rule. This is restated here rather
    # than glossed over because this language genuinely has no lexicographic
    # `<`/`<=` on `text` (`facet lang`'s comparison operators all coerce
    # through `toInt`/`toFloat` — confirmed against this very selfhost
    # directory's own `expr.fct`, STAGE 0 header) — a real, confirmed
    # language gap this port works around by leaning on an invariant the
    # SOURCE crate already upholds, rather than one this port invents.
    proc failoverBestCandidateIndex(entries: [ReplicaEntry], nowMs: int, policy: FailoverPolicy) -> int:
        let n = len(entries)
        let mut i = 0
        let mut bestIdx = -1
        let mut bestPending = -1
        let mut bestLag = -1
        loop i < n:
            if !entries[i].isPrimary:
                let ineligible = do failoverIneligibility(entries[i], nowMs, policy)
                if ineligible == 0:
                    if bestIdx == -1:
                        bestIdx = i
                        bestPending = entries[i].pendingWrites
                        bestLag = entries[i].applyLagMs
                    else:
                        if entries[i].pendingWrites < bestPending:
                            bestIdx = i
                            bestPending = entries[i].pendingWrites
                            bestLag = entries[i].applyLagMs
                        else:
                            if entries[i].pendingWrites == bestPending && entries[i].applyLagMs < bestLag:
                                bestIdx = i
                                bestPending = entries[i].pendingWrites
                                bestLag = entries[i].applyLagMs
            i = i + 1
        return bestIdx

    # failoverAnyInSyncSecondary: distinguishes the two "nothing is eligible"
    # blockers exactly like `evaluate`'s own nested `if` does — an in-sync
    # secondary that failed the POLICY (`EveryCandidateIneligible`) is a
    # different, more fixable situation than no in-sync secondary EXISTING
    # at all (`NoInSyncSecondary`).
    proc failoverAnyInSyncSecondary(entries: [ReplicaEntry]) -> bool:
        let n = len(entries)
        let mut i = 0
        let mut found = false
        loop i < n:
            if !entries[i].isPrimary:
                if entries[i].state == 2:
                    found = true
            i = i + 1
        return found

    # ============================================================
    # THE GATEKEEPER FAMILY — restating `evaluate`'s own field-by-field
    # derivation as independent, pure re-derivations of the identical inputs,
    # the same "one proc, one fact, guaranteed to agree because both are pure
    # functions of the same arguments" shape this file's own
    # `keyspaceResolveStatus`/`keyspaceResolveKey` pair already uses, restated
    # here for the "evaluate() produces MANY facts from the same walk"
    # constraint that gave that pair its name. Blocker codes (there is at
    # most one, matching `evaluate`'s own `if / else if / else if` chain,
    # which can never push more than one `FailoverBlocker` — read directly,
    # not assumed): -1=none, 0=PrimaryStillServing, 1=SetIsEmpty,
    # 2=NoInSyncSecondary, 3=EveryCandidateIneligible.
    # ============================================================
    proc failoverBlockerCode(entries: [ReplicaEntry], nowMs: int, policy: FailoverPolicy) -> int:
        let needsReplacement = do failoverPrimaryNeedsReplacement(entries, nowMs, policy)
        if !needsReplacement:
            return 0
        let empty = do failoverSetIsEmpty(entries)
        if empty:
            return 1
        let bestIdx = do failoverBestCandidateIndex(entries, nowMs, policy)
        if bestIdx == -1:
            let anyInSync = do failoverAnyInSyncSecondary(entries)
            if anyInSync:
                return 3
            return 2
        return -1

    # failoverHasPromotion / failoverPromotionNode: restate `promotion()`
    # exactly — `None` outright when the primary does not need replacing,
    # otherwise the best ELIGIBLE candidate if one exists. `failoverPromotionNode`
    # is only meaningful once `failoverHasPromotion` has already returned
    # true for the identical arguments (the `keyspaceResolveKey` contract,
    # restated): calling it when no candidate is eligible reads `entries[-1]`,
    # a clean out-of-bounds error rather than a silently wrong node name.
    proc failoverHasPromotion(entries: [ReplicaEntry], nowMs: int, policy: FailoverPolicy) -> bool:
        let needsReplacement = do failoverPrimaryNeedsReplacement(entries, nowMs, policy)
        if !needsReplacement:
            return false
        let bestIdx = do failoverBestCandidateIndex(entries, nowMs, policy)
        return bestIdx != -1

    proc failoverPromotionNode(entries: [ReplicaEntry], nowMs: int, policy: FailoverPolicy) -> text:
        let bestIdx = do failoverBestCandidateIndex(entries, nowMs, policy)
        return entries[bestIdx].node

    # failoverIsStuck: restates `is_stuck()` — the write path has no primary
    # AND no safe promotion, the single most urgent fact a controller reading
    # this assessment can be told.
    proc failoverIsStuck(entries: [ReplicaEntry], nowMs: int, policy: FailoverPolicy) -> bool:
        let needsReplacement = do failoverPrimaryNeedsReplacement(entries, nowMs, policy)
        let hasPromo = do failoverHasPromotion(entries, nowMs, policy)
        return needsReplacement && !hasPromo

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES for failover.rs — hand-verified against
    # four real traced scenarios restated from failover.rs's own unit tests
    # (full trace in the task report). All four share one two-replica set,
    # `healthy_pair()`: db-a bootstrapped as primary (InSync, never reported
    # — bootstrap sets state directly, it is not seeded), db-b added,
    # seeded, marked in-sync, then observed at t=1 000 with zero lag — the
    # exact sequence `failover.rs`'s own `healthy_pair()` test helper runs.
    #   Default `FailoverPolicy`: primarySilenceBudgetMs=30 000,
    #   maxCandidateSilenceMs=30 000, maxPromotionPendingWrites=0,
    #   maxPromotionApplyLagMs=0 — restating `FailoverPolicy::default()`
    #   exactly.
    #   D1 `a_serving_primary_produces_no_promotion`: evaluate at t=1 000.
    #      db-a is still InSync and has never reported (so it cannot be
    #      silence-flagged) -> primary_needs_replacement=false ->
    #      blocker=PrimaryStillServing(0), no promotion.
    #   D2 `a_failed_primary_names_the_promotion_but_does_not_perform_it`:
    #      db-a MarkFailed'd (state=Failed=4, role untouched). Evaluate at
    #      t=1 000: needsReplacement=true (state check); db-b is eligible
    #      (InSync, reported at 1 000, zero lag) -> promotion=Some(db-b).
    #   D3 `a_lagging_candidate_is_refused_with_its_reason`: db-b observed
    #      again at t=2 000 with lag(12, 400) — under the LAG THRESHOLDS
    #      (1 000 writes / 5 000 ms) so it stays InSync, but the FAILOVER
    #      POLICY's stricter budget (0 pending writes) refuses it anyway;
    #      db-a MarkFailed'd. Evaluate at t=2 000 with the default policy:
    #      no eligible candidate (db-b: WouldLoseWrites) -> blocker=
    #      EveryCandidateIneligible(3), isStuck=true. The SAME set evaluated
    #      with a lenient policy (maxPromotionPendingWrites=100,
    #      maxPromotionApplyLagMs=1 000) makes db-b eligible again ->
    #      promotion=Some(db-b) — restating the test's own point that this
    #      crate computes the tradeoff, never decides it.
    #   D4 `a_silent_primary_needs_replacement_even_while_marked_in_sync`:
    #      db-a (the primary) itself observed at t=1 000 (state stays InSync
    #      — a report never changes a PRIMARY's state, only its
    #      last-report clock). Evaluate at t=31 001 (1 000 +
    #      primarySilenceBudgetMs(30 000) + 1): the primary is still
    #      InSync but has been silent for 30 001ms, over budget ->
    #      needsReplacement=true even though primary_state is still InSync;
    #      db-b's own last report (also t=1 000) is equally stale -> its
    #      ineligibility is HealthTooStale, not WouldLoseWrites — "promoting
    #      on stale health is refused rather than guessed at".
    proc demoDefaultPolicy() -> FailoverPolicy:
        return FailoverPolicy{primarySilenceBudgetMs: 30000, maxCandidateSilenceMs: 30000, maxPromotionPendingWrites: 0, maxPromotionApplyLagMs: 0}

    proc demoLenientPolicy() -> FailoverPolicy:
        return FailoverPolicy{primarySilenceBudgetMs: 30000, maxCandidateSilenceMs: 30000, maxPromotionPendingWrites: 100, maxPromotionApplyLagMs: 1000}

    proc demoEntriesD1() -> [ReplicaEntry]:
        return [ReplicaEntry{node: "db-a", isPrimary: true, state: 2, pendingWrites: 0, applyLagMs: 0, lastReportMs: -1}, ReplicaEntry{node: "db-b", isPrimary: false, state: 2, pendingWrites: 0, applyLagMs: 0, lastReportMs: 1000}]

    proc demoEntriesD2() -> [ReplicaEntry]:
        return [ReplicaEntry{node: "db-a", isPrimary: true, state: 4, pendingWrites: 0, applyLagMs: 0, lastReportMs: -1}, ReplicaEntry{node: "db-b", isPrimary: false, state: 2, pendingWrites: 0, applyLagMs: 0, lastReportMs: 1000}]

    proc demoEntriesD3() -> [ReplicaEntry]:
        return [ReplicaEntry{node: "db-a", isPrimary: true, state: 4, pendingWrites: 0, applyLagMs: 0, lastReportMs: -1}, ReplicaEntry{node: "db-b", isPrimary: false, state: 2, pendingWrites: 12, applyLagMs: 400, lastReportMs: 2000}]

    proc demoEntriesD4() -> [ReplicaEntry]:
        return [ReplicaEntry{node: "db-a", isPrimary: true, state: 2, pendingWrites: 0, applyLagMs: 0, lastReportMs: 1000}, ReplicaEntry{node: "db-b", isPrimary: false, state: 2, pendingWrites: 0, applyLagMs: 0, lastReportMs: 1000}]

    proc demoD1Blocker() -> int:
        let entries = do demoEntriesD1()
        let policy = do demoDefaultPolicy()
        let blocker = do failoverBlockerCode(entries, 1000, policy)
        return blocker

    proc demoD1HasPromotion() -> bool:
        let entries = do demoEntriesD1()
        let policy = do demoDefaultPolicy()
        let has = do failoverHasPromotion(entries, 1000, policy)
        return has

    proc demoD2HasPromotion() -> bool:
        let entries = do demoEntriesD2()
        let policy = do demoDefaultPolicy()
        let has = do failoverHasPromotion(entries, 1000, policy)
        return has

    proc demoD2PromotionNode() -> text:
        let entries = do demoEntriesD2()
        let policy = do demoDefaultPolicy()
        let node = do failoverPromotionNode(entries, 1000, policy)
        return node

    proc demoD3StrictBlocker() -> int:
        let entries = do demoEntriesD3()
        let policy = do demoDefaultPolicy()
        let blocker = do failoverBlockerCode(entries, 2000, policy)
        return blocker

    proc demoD3StrictIsStuck() -> bool:
        let entries = do demoEntriesD3()
        let policy = do demoDefaultPolicy()
        let stuck = do failoverIsStuck(entries, 2000, policy)
        return stuck

    proc demoD3LenientHasPromotion() -> bool:
        let entries = do demoEntriesD3()
        let policy = do demoLenientPolicy()
        let has = do failoverHasPromotion(entries, 2000, policy)
        return has

    proc demoD3LenientPromotionNode() -> text:
        let entries = do demoEntriesD3()
        let policy = do demoLenientPolicy()
        let node = do failoverPromotionNode(entries, 2000, policy)
        return node

    proc demoD4NeedsReplacement() -> bool:
        let entries = do demoEntriesD4()
        let policy = do demoDefaultPolicy()
        let needs = do failoverPrimaryNeedsReplacement(entries, 31001, policy)
        return needs

    proc demoD4CandidateIneligibility() -> int:
        let entries = do demoEntriesD4()
        let policy = do demoDefaultPolicy()
        let ineligible = do failoverIneligibility(entries[1], 31001, policy)
        return ineligible

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES — hand-verified against three real traced
    # scenarios restated from keyspace.rs's own unit tests (full trace in
    # the task report):
    #   A. `keyspace()` = {"Post"->"Post:", "__session"->"__session:"}, no
    #      fallback. `resolve(Some("Post"), Some("Post:17"))` -> Ok(key(1)),
    #      and the contradictory `resolve(Some("Post"),
    #      Some("__session:abc"))` -> Inconsistent.
    #   B. Longest-prefix: {"A"->"__" (key1), "B"->"__fabric_placement:"
    #      (key2)}. `resolve(None, Some("__fabric_placement:1:0:0"))` ->
    #      Ok(key2); `resolve(None, Some("__session:x"))` -> Ok(key1) (only
    #      the shorter "__" prefix matches that address at all).
    #   C. Fallback + spanning_key: `keyspace()` (no rule covers "Unknown")
    #      with `.with_fallback(key(9))` resolves Unknown -> Ok(key(9)), and
    #      is NOT a spanning keyspace (its two rules' keys, 1 and 2, do not
    #      equal the fallback, 9); `Keyspace::single(key(1))` (no rules) IS
    #      spanning, and equals key(1).
    # `key(n)` throughout mirrors keyspace.rs's own test helper exactly:
    # `RoutingKey::new(n, Coordinate::new(0, 0))`, packed per this file's
    # header as `n * 156 + 0`.
    proc demoRulesAB() -> [RoutingRule]:
        return [RoutingRule{kind: "Post", prefix: "Post:", key: 156}, RoutingRule{kind: "__session", prefix: "__session:", key: 312}]

    # Scenario A1: resolve(Some("Post"), Some("Post:17")) -> Ok, key(1)=156.
    # Traced: kindIdx=0 (rules[0].kind=="Post"); addrIdx: "Post:" (len 5) is a
    # prefix of "Post:17" (len 7, leading 5 = "Post:") -> bestIdx=0; "__session:"
    # (len 10) is not (10 > 7) -> addrIdx stays 0. rules[0].key==rules[0].key, so
    # status=0 (Ok), key=156.
    proc demoScenarioA1Status() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceResolveStatus(rules, false, true, "Post", true, "Post:17")
        return status

    proc demoScenarioA1Key() -> int:
        let rules = do demoRulesAB()
        let key = do keyspaceResolveKey(rules, -1, true, "Post", true, "Post:17")
        return key

    # Scenario A2: resolve(Some("Post"), Some("__session:abc")) -> Inconsistent.
    # Traced: kindIdx=0 (key 156). addrIdx: "Post:" (len5) is not a prefix of
    # "__session:abc" (leading 5 = "__ses" != "Post:"); "__session:" (len10) IS
    # a prefix (leading 10 = "__session:") -> addrIdx=1 (key 312). 156 != 312
    # -> status=2 (Inconsistent).
    proc demoScenarioA2Status() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceResolveStatus(rules, false, true, "Post", true, "__session:abc")
        return status

    proc demoRulesB() -> [RoutingRule]:
        return [RoutingRule{kind: "A", prefix: "__", key: 156}, RoutingRule{kind: "B", prefix: "__fabric_placement:", key: 312}]

    # Scenario B1: resolve(None, Some("__fabric_placement:1:0:0")) -> Ok, key2=312.
    # Traced: no kind. addrIdx: "__" (len2) matches (leading2="__") ->
    # bestIdx=0,bestLen=2; "__fabric_placement:" (len19) matches (leading19
    # equals it exactly) and 19 >= 2 -> bestIdx=1,bestLen=19. Final addrIdx=1,
    # key=rules[1].key=312.
    proc demoScenarioB1Status() -> int:
        let rules = do demoRulesB()
        let status = do keyspaceResolveStatus(rules, false, false, "", true, "__fabric_placement:1:0:0")
        return status

    proc demoScenarioB1Key() -> int:
        let rules = do demoRulesB()
        let key = do keyspaceResolveKey(rules, -1, false, "", true, "__fabric_placement:1:0:0")
        return key

    # Scenario B2: resolve(None, Some("__session:x")) -> Ok, key1=156.
    # Traced: "__" (len2) matches "__session:x" (leading2="__") ->
    # bestIdx=0,bestLen=2. "__fabric_placement:" (len19) does NOT match
    # (19 > len("__session:x")=11) -> addrIdx stays 0, key=156.
    proc demoScenarioB2Key() -> int:
        let rules = do demoRulesB()
        let key = do keyspaceResolveKey(rules, -1, false, "", true, "__session:x")
        return key

    # Scenario C1: keyspace() + with_fallback(key(9)=1404); resolve(Some("Unknown"), None) -> Ok, key(9).
    # Traced: kindIdx: "Unknown" not in ["Post","__session"] -> -1. No address
    # -> addrIdx=-1. hasFallback=true -> status=0; key=fallbackKey=1404.
    proc demoScenarioC1Status() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceResolveStatus(rules, true, true, "Unknown", false, "")
        return status

    proc demoScenarioC1Key() -> int:
        let rules = do demoRulesAB()
        let key = do keyspaceResolveKey(rules, 1404, true, "Unknown", false, "")
        return key

    # Scenario C1b: the SAME keyspace() with no fallback declared at all ->
    # resolve(Some("Unknown"), None) is Unmapped (status=1), matching
    # keyspace.rs's own `an_unmapped_request_is_refused_rather_than_guessed`.
    proc demoScenarioC1bStatus() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceResolveStatus(rules, false, true, "Unknown", false, "")
        return status

    # Scenario C2: keyspace() (rule keys [156,312]) + with_fallback(1404) is
    # NOT spanning (156 != 1404). Keyspace::single(key(1)=156) — an empty
    # rule table — IS spanning, and equals 156.
    proc demoEmptyRules() -> [RoutingRule]:
        return []

    proc demoScenarioC2NotSpanning() -> bool:
        let rules = do demoRulesAB()
        let present = do spanningKeyPresent(rules, true, 1404)
        return present

    proc demoScenarioC2SingleSpanning() -> bool:
        let empty = do demoEmptyRules()
        let present = do spanningKeyPresent(empty, true, 156)
        return present

    # Construction-time validation demo, mirroring
    # `an_ambiguous_keyspace_is_refused_at_construction` and
    # `a_half_declared_rule_is_refused`: adding ("", "Post:") to an empty
    # table is EmptyKind (1); adding ("Post", "") is EmptyAddressPrefix (2);
    # adding ("Post", "Other:") to a table that already has kind "Post" is
    # DuplicateKind (3); adding ("Other", "Post:") to a table that already
    # has prefix "Post:" is DuplicateAddressPrefix (4); adding ("Comment",
    # "Comment:") to that same table is fine (0).
    proc demoValidationEmptyKind() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceAddRuleStatus(rules, "", "Post:")
        return status

    proc demoValidationEmptyPrefix() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceAddRuleStatus(rules, "Post", "")
        return status

    proc demoValidationDuplicateKind() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceAddRuleStatus(rules, "Post", "Other:")
        return status

    proc demoValidationDuplicatePrefix() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceAddRuleStatus(rules, "Other", "Post:")
        return status

    proc demoValidationOk() -> int:
        let rules = do demoRulesAB()
        let status = do keyspaceAddRuleStatus(rules, "Comment", "Comment:")
        return status

    # ============================================================
    # THIRD PORT, SAME FILE: fabric-migration's `phase.rs` + `migration.rs`
    # (the shard-move state machine), plus `plan.rs`'s one construction-time
    # check.
    # ============================================================
    # WHY THIS PIECE: the survey that found fabric-replication's failover.rs
    # (above) checked the remaining unlisted crates too. fabric-topology
    # (112 lines) and fabric-workload (236 lines) turned out to be exactly
    # what their small size suggested: thin registries (`registry.rs`'s
    # `HashMap` CRUD, `placement.rs`'s trait-object dispatch) and a
    # profile-sampling accumulator (`analyzer.rs` folds observed read/write
    # counts into running rates — real arithmetic, but "average a stream of
    # samples", not a decision procedure with branches worth restating).
    # fabric-protocol and fabric-telemetry are, respectively, wire-message
    # framing and a metrics-collection trait — both genuinely I/O-shaped, not
    # disqualified by a shallow guess. fabric-cli and fabric-daemon are
    # command-line/process glue exactly like fabric-controller and
    # fabric-runtime already were. fabric-simulator deliberately owns its own
    # seeded PRNG (`rng.rs`) to drive fault injection — useful, but its
    # decisions are conditioned on randomness this survey did not verify is
    # reproducible the way a hand-checkable table is, the same reservation
    # that already excluded fabric-optimizer/fabric-ml.
    #
    # `fabric-migration` is the exception, and — like keyspace.rs and
    # failover.rs before it — it says so about itself, in its own crate doc,
    # word for word: "Everything here is pure logic. Copying bytes, streaming
    # the tail of the write stream, and deleting the source copy are the
    # runtime's work; this crate says what is allowed to happen next and
    # refuses what is not." No socket, no async; every `Serialize` derive is
    # for shipping a `MigrationStatus` snapshot afterward, never read back in
    # a decision (identical to `RoutingKey`/`KeyspaceMiss` and the failover
    # verdict types before it).
    #
    # ============================================================
    # WHAT THE LOGIC ACTUALLY IS (read in full from phase.rs and
    # migration.rs, not assumed from the crate doc):
    # ============================================================
    # A migration moves one shard through eight phases (`MigrationPhase`,
    # phase.rs): Planned -> Copying -> CatchingUp -> Cutover -> Cleanup ->
    # Completed, with CatchingUp able to fall back to Copying (a bad copy is
    # re-copied, not cut over to), and Aborted/Failed reachable as described
    # below. `can_advance_to` is the one true edge table; every state-machine
    # method in migration.rs either restates one of its edges directly or
    # calls the private `advance` helper, which is just "not already
    # terminal, AND the edge exists" — ported once, below, as
    # `migrationAdvanceStatus`, and reused exactly the way `advance` itself
    # is reused by every phase-changing method in the real crate.
    #
    # The crate doc names two invariants and this port's job is to make both
    # checkable by hand, not just asserted:
    #   1. A read always has an owner: the source until cutover COMPLETES
    #      (`complete_cutover`, which sets `cutover_completed_at_ms`), the
    #      destination after — tracked by that timestamp, deliberately NOT
    #      by the phase, so a migration that later fails during cleanup still
    #      correctly reports the destination as owner (ported as
    #      `migrationReadOwnerIsDestination`, restating `read_owner` exactly).
    #   2. A write is never lost or double-applied: `accept_write` routes a
    #      write to the source before cutover and the destination after,
    #      refusing anything not strictly past the accepting side's own
    #      high-water mark (`NonMonotonicWrite`) or already covered by the
    #      cutover fence or the destination's own applied mark
    #      (`WriteAlreadyApplied`); `record_applied` is the mirror check on
    #      the DESTINATION's report, refusing a sequence the source never
    #      took (`UnknownWrite`) or already recorded (`WriteAlreadyApplied`).
    #      Both are ported below exactly as `migrationAcceptWriteStatus` /
    #      `migrationRecordAppliedStatus`, restating each `if`/branch in the
    #      order `accept_write`/`record_applied` run them.
    # `begin_cutover` and `complete_cutover` are where the two invariants
    # actually meet: cutover may only START with the pending-write gap
    # already inside `plan.max_cutover_pending_writes` (a live shard's write
    # stream never fully stops, so the fence narrows the gap rather than
    # requiring it already be zero) and may only COMPLETE once that gap has
    # been driven to exactly zero — ported as `migrationBeginCutoverStatus` /
    # `migrationCompleteCutoverStatus`.
    #
    # ============================================================
    # REPRESENTATION — one struct for the whole machine, the same "several
    # named facts about one entity" reasoning `RoutingRule`/`ReplicaEntry`
    # already state above, extended for the reason `ReplicaEntry`'s own
    # header already gives for NOT packing `pendingWrites`/`applyLagMs`
    # together: every gatekeeper below reads `atomsCopied`, `sourceHighWater`,
    # `destinationApplied`, etc. on their own, so packing any of them would
    # only force unpacking back out.
    # ============================================================
    # `Option<WriteSeq>`/`Option<u64>` fields (`source_high_water`,
    # `destination_applied`, `fence.last_write`, `cutover_completed_at_ms`)
    # are each a sentinel `-1` int exactly like `ReplicaEntry.lastReportMs`
    # above, for the identical reason: every real value compared against
    # them is a non-negative sequence number or millisecond clock reading, so
    # `-1` can never collide with one. `fence` itself (there is at most one,
    # raised once per cutover attempt) gets a `hasFence` flag alongside its
    # own `-1`-sentinelled `fenceLastWrite`, mirroring `Keyspace`'s
    # `hasFallback`/`fallbackKey` pair above for the same "the sentinel
    # inside only means something once the flag says the fence exists"
    # reason — `fence.last_write` is ITSELF an `Option`, so this is a flag
    # guarding a sentinel, not a flag standing in for one.
    #
    # `MigrationPhase` is ported as a plain `int` in the exact order phase.rs
    # declares its variants (0=Planned .. 7=Failed), the same convention
    # `ReplicaState` already uses above. `MigrationPlan`'s only field this
    # file's procs need is `maxCutoverPendingWrites`, since `atoms`/`source`/
    # `destination`/`reason` are either folded into `MigrationState` directly
    # (`atomsTotal`) or never inspected by a decision procedure at all
    # (source/destination node identity only matters for EQUALITY at
    # planning time, ported separately as `migrationPlanStatus`, and is never
    # read again by anything in this section).
    struct MigrationState:
        phase: int
        atomsTotal: int
        atomsCopied: int
        sourceHighWater: int
        destinationApplied: int
        hasFence: bool
        fenceLastWrite: int
        cutoverCompletedAtMs: int
        maxCutoverPendingWrites: int

    # ============================================================
    # PHASE TABLE — restates `phase.rs` exactly, one proc per method, in
    # phase.rs's own declaration order.
    # ============================================================
    proc phaseIsTerminal(phase: int) -> bool:
        return phase == 5 || phase == 6 || phase == 7

    proc phaseIsPreCutover(phase: int) -> bool:
        return phase == 0 || phase == 1 || phase == 2 || phase == 3

    proc phaseAllowsAbort(phase: int) -> bool:
        let preCutover = do phaseIsPreCutover(phase)
        return preCutover

    proc phaseIsFenced(phase: int) -> bool:
        return phase == 3

    # phaseCanAdvanceTo: restates the match arm by arm, top to bottom,
    # exactly as `can_advance_to` orders them — the two `(_, Aborted)` /
    # `(_, Failed)` catch-alls MUST come after the specific pairs precisely
    # because Rust's own match does (a specific arm shadows a wildcard one
    # earlier in the same list; restating them in the other order would let
    # the wildcards fire first and never wrongly, since none of the specific
    # pairs target Aborted/Failed, but this keeps the port's reading order
    # identical to the source's, which is the point of a restatement).
    proc phaseCanAdvanceTo(from: int, to: int) -> bool:
        if from == 0 && to == 1:
            return true
        if from == 1 && to == 2:
            return true
        if from == 2 && to == 3:
            return true
        if from == 2 && to == 1:
            return true
        if from == 3 && to == 4:
            return true
        if from == 4 && to == 5:
            return true
        if to == 6:
            let allowed = do phaseAllowsAbort(from)
            return allowed
        if to == 7:
            let terminal = do phaseIsTerminal(from)
            return !terminal
        return false

    # ============================================================
    # THE `advance` HELPER — `Migration::advance`'s own gatekeeper, reused by
    # every phase-changing method below exactly as the real one is reused by
    # `begin_copy`/`begin_catch_up`/`restart_copy`/`begin_cutover`/
    # `complete_cutover`/`complete`. 0=Ok, 1=AlreadyTerminal,
    # 2=InvalidTransition.
    # ============================================================
    proc migrationAdvanceStatus(phase: int, to: int) -> int:
        let terminal = do phaseIsTerminal(phase)
        if terminal:
            return 1
        let canAdvance = do phaseCanAdvanceTo(phase, to)
        if !canAdvance:
            return 2
        return 0

    # migrationPendingWrites: `Migration::pending_writes` exactly — the
    # sequence-slot arithmetic invariant 2 is built on.
    proc migrationPendingWrites(state: MigrationState) -> int:
        if state.sourceHighWater == -1:
            return 0
        if state.destinationApplied == -1:
            return state.sourceHighWater + 1
        return max(state.sourceHighWater - state.destinationApplied, 0)

    proc migrationHasCutOver(state: MigrationState) -> bool:
        return state.cutoverCompletedAtMs != -1

    proc migrationIsWriteFenced(state: MigrationState) -> bool:
        let fenced = do phaseIsFenced(state.phase)
        return fenced

    # migrationReadOwnerIsDestination: `read_owner` restated as "is it the
    # destination" (true) or "is it the source" (false) — this port has no
    # `DbmsId` type to return, and nothing below ever needs one: every real
    # caller of `read_owner`/`write_owner` in the source only ever compares
    # the result against `plan.source`/`plan.destination`, i.e. asks WHICH of
    # the two, exactly the fact this bool already is.
    proc migrationReadOwnerIsDestination(state: MigrationState) -> bool:
        let cutOver = do migrationHasCutOver(state)
        return cutOver

    # migrationHasWriteOwner / migrationWriteOwnerIsDestination: `write_owner`
    # split the same way `keyspaceResolveStatus`/`keyspaceResolveKey` split
    # "does an answer exist" from "what is it" — `migrationWriteOwnerIsDestination`
    # is only meaningful once `migrationHasWriteOwner` has already returned
    # true for the identical state (mirroring `write_owner`'s own `None`
    # while fenced).
    proc migrationHasWriteOwner(state: MigrationState) -> bool:
        let fenced = do migrationIsWriteFenced(state)
        return !fenced

    proc migrationWriteOwnerIsDestination(state: MigrationState) -> bool:
        let isDestination = do migrationReadOwnerIsDestination(state)
        return isDestination

    # ============================================================
    # THE TWO INVARIANTS — `accept_write` and `record_applied`, restated
    # branch for branch in the order the real methods run them. Status codes
    # are this file's own numbering (there is no shared enum to match against
    # here, unlike phase.rs's phases, since `MigrationError` has far more
    # variants than either method can actually produce):
    #   accept_write: 0=Ok(Source) 1=Ok(Destination) 2=WriteFenced
    #                 3=WriteAlreadyApplied 4=NonMonotonicWrite
    #   record_applied: 0=Ok 1=UnknownWrite 2=WriteAlreadyApplied
    # ============================================================
    proc migrationAcceptWriteStatus(state: MigrationState, seq: int) -> int:
        let fenced = do migrationIsWriteFenced(state)
        if fenced:
            return 2
        let cutOver = do migrationHasCutOver(state)
        if cutOver:
            if state.hasFence:
                if state.fenceLastWrite != -1:
                    if seq <= state.fenceLastWrite:
                        return 3
            if state.destinationApplied != -1:
                if seq <= state.destinationApplied:
                    return 3
            return 1
        if state.sourceHighWater != -1:
            if seq <= state.sourceHighWater:
                return 4
        return 0

    proc migrationRecordAppliedStatus(state: MigrationState, seq: int) -> int:
        if state.sourceHighWater == -1:
            return 1
        if seq > state.sourceHighWater:
            return 1
        if state.destinationApplied != -1:
            if seq <= state.destinationApplied:
                return 2
        return 0

    # ============================================================
    # THE PHASE-CHANGING METHODS — each restates its real counterpart's
    # guard(s) then, on success, the exact `advance` call it makes.
    # ============================================================
    proc migrationBeginCopyStatus(state: MigrationState) -> int:
        let status = do migrationAdvanceStatus(state.phase, 1)
        return status

    # 0=Ok 1=WrongPhase 2=ProgressExceedsTotal 3=ProgressWentBackwards
    proc migrationRecordCopyStatus(state: MigrationState, newAtomsCopied: int) -> int:
        if state.phase != 1:
            return 1
        if newAtomsCopied > state.atomsTotal:
            return 2
        if newAtomsCopied < state.atomsCopied:
            return 3
        return 0

    # 0=Ok 1=WrongPhase 2=CopyIncomplete
    proc migrationBeginCatchUpStatus(state: MigrationState) -> int:
        if state.phase != 1:
            return 1
        if state.atomsCopied < state.atomsTotal:
            return 2
        let status = do migrationAdvanceStatus(state.phase, 2)
        return status

    proc migrationRestartCopyStatus(state: MigrationState) -> int:
        if state.phase != 2:
            return 1
        let status = do migrationAdvanceStatus(state.phase, 1)
        return status

    # 0=Ok 1=WrongPhase 2=CopyIncomplete 3=NotCaughtUp — the pending-write
    # budget check where invariant 2's fence is actually raised.
    proc migrationBeginCutoverStatus(state: MigrationState) -> int:
        if state.phase != 2:
            return 1
        if state.atomsCopied < state.atomsTotal:
            return 2
        let pending = do migrationPendingWrites(state)
        if pending > state.maxCutoverPendingWrites:
            return 3
        return 0

    # 0=Ok 1=WrongPhase 2=CutoverNotDrained — authority may move only once
    # the fence's own gap has been driven to exactly zero.
    proc migrationCompleteCutoverStatus(state: MigrationState) -> int:
        if state.phase != 3:
            return 1
        let pending = do migrationPendingWrites(state)
        if pending > 0:
            return 2
        return 0

    proc migrationCompleteStatus(state: MigrationState) -> int:
        if state.phase != 4:
            return 1
        let status = do migrationAdvanceStatus(state.phase, 5)
        return status

    # 0=Ok 1=AlreadyTerminal 2=AbortAfterCutover — abort is available exactly
    # through `allows_abort`'s pre-cutover window, restated here rather than
    # re-derived, matching `abort`'s own two guard checks in order.
    proc migrationAbortStatus(state: MigrationState) -> int:
        let terminal = do phaseIsTerminal(state.phase)
        if terminal:
            return 1
        let allowed = do phaseAllowsAbort(state.phase)
        if !allowed:
            return 2
        return 0

    proc migrationFailStatus(state: MigrationState) -> int:
        let terminal = do phaseIsTerminal(state.phase)
        if terminal:
            return 1
        return 0

    # migrationPlanStatus: `MigrationPlan::new`'s one guard — a move to the
    # node a shard is already on is not a migration. 0=Ok
    # 1=SameSourceAndDestination.
    proc migrationPlanStatus(source: text, destination: text) -> int:
        if source == destination:
            return 1
        return 0

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES — hand-verified against real traced
    # scenarios restated from migration.rs's own unit tests (full trace in
    # the task report). M1-M3 share one base fixture, `caught_up()`,
    # restating migration.rs's own test helper of the same name exactly:
    # begin_copy(2000); accept_write(0); accept_write(1); record_copy(156,
    # 4096, 3000); begin_catch_up(4000); record_applied(1, 4100) — leaving
    # phase=CatchingUp, sourceHighWater=1, destinationApplied=1,
    # atomsCopied=atomsTotal=156, no fence yet, cutover not completed.
    # `maxCutoverPendingWrites` is the plan default, 64.
    # ============================================================
    proc demoMigrationCaughtUp() -> MigrationState:
        return MigrationState{phase: 2, atomsTotal: 156, atomsCopied: 156, sourceHighWater: 1, destinationApplied: 1, hasFence: false, fenceLastWrite: -1, cutoverCompletedAtMs: -1, maxCutoverPendingWrites: 64}

    # M1 `catch_up_cannot_begin_with_atoms_missing`: phase=Copying,
    # atomsCopied=100 of 156 -> begin_catch_up is CopyIncomplete(2).
    proc demoM1BeginCatchUpStatus() -> int:
        let state = MigrationState{phase: 1, atomsTotal: 156, atomsCopied: 100, sourceHighWater: -1, destinationApplied: -1, hasFence: false, fenceLastWrite: -1, cutoverCompletedAtMs: -1, maxCutoverPendingWrites: 64}
        let status = do migrationBeginCatchUpStatus(state)
        return status

    # M2 `cutover_cannot_complete_while_a_write_is_undrained`: from
    # caught_up(), one more write lands (seq 2, source-side, since the fence
    # is not up yet) before begin_cutover. Traced: pending=max(2-1,0)=1 <= 64
    # -> begin_cutover Ok, fence.lastWrite=2. complete_cutover with
    # destinationApplied still 1 -> pending=1>0 -> CutoverNotDrained(2). Once
    # record_applied(2) lands (destinationApplied=2) -> pending=0 ->
    # complete_cutover Ok(0).
    proc demoM2AfterExtraWrite() -> MigrationState:
        let base = do demoMigrationCaughtUp()
        return MigrationState{phase: base.phase, atomsTotal: base.atomsTotal, atomsCopied: base.atomsCopied, sourceHighWater: 2, destinationApplied: base.destinationApplied, hasFence: base.hasFence, fenceLastWrite: base.fenceLastWrite, cutoverCompletedAtMs: base.cutoverCompletedAtMs, maxCutoverPendingWrites: base.maxCutoverPendingWrites}

    proc demoM2BeginCutoverStatus() -> int:
        let state = do demoM2AfterExtraWrite()
        let status = do migrationBeginCutoverStatus(state)
        return status

    proc demoM2Undrained() -> MigrationState:
        let state = do demoM2AfterExtraWrite()
        return MigrationState{phase: 3, atomsTotal: state.atomsTotal, atomsCopied: state.atomsCopied, sourceHighWater: state.sourceHighWater, destinationApplied: state.destinationApplied, hasFence: true, fenceLastWrite: 2, cutoverCompletedAtMs: -1, maxCutoverPendingWrites: state.maxCutoverPendingWrites}

    proc demoM2UndrainedPending() -> int:
        let state = do demoM2Undrained()
        let pending = do migrationPendingWrites(state)
        return pending

    proc demoM2CompleteCutoverUndrainedStatus() -> int:
        let state = do demoM2Undrained()
        let status = do migrationCompleteCutoverStatus(state)
        return status

    proc demoM2Drained() -> MigrationState:
        let state = do demoM2Undrained()
        return MigrationState{phase: state.phase, atomsTotal: state.atomsTotal, atomsCopied: state.atomsCopied, sourceHighWater: state.sourceHighWater, destinationApplied: 2, hasFence: state.hasFence, fenceLastWrite: state.fenceLastWrite, cutoverCompletedAtMs: state.cutoverCompletedAtMs, maxCutoverPendingWrites: state.maxCutoverPendingWrites}

    proc demoM2CompleteCutoverDrainedStatus() -> int:
        let state = do demoM2Drained()
        let status = do migrationCompleteCutoverStatus(state)
        return status

    # M3 `a_write_is_never_applied_twice_across_the_handover`: from
    # caught_up() DIRECTLY (no extra write this time) -> begin_cutover
    # (pending=max(1-1,0)=0, fence.lastWrite=1) -> complete_cutover
    # (pending=0, Ok) -> phase=Cleanup, cutoverCompletedAtMs set. A replay of
    # seq 1 is refused (WriteAlreadyApplied, matching the fence); seq 2 is
    # accepted, routed to the destination.
    proc demoM3AfterCutoverComplete() -> MigrationState:
        let base = do demoMigrationCaughtUp()
        return MigrationState{phase: 4, atomsTotal: base.atomsTotal, atomsCopied: base.atomsCopied, sourceHighWater: base.sourceHighWater, destinationApplied: base.destinationApplied, hasFence: true, fenceLastWrite: 1, cutoverCompletedAtMs: 5100, maxCutoverPendingWrites: base.maxCutoverPendingWrites}

    proc demoM3ReplayStatus() -> int:
        let state = do demoM3AfterCutoverComplete()
        let status = do migrationAcceptWriteStatus(state, 1)
        return status

    proc demoM3NewWriteStatus() -> int:
        let state = do demoM3AfterCutoverComplete()
        let status = do migrationAcceptWriteStatus(state, 2)
        return status

    # M4 `abort_is_available_up_to_cutover_and_never_after`: fenced but not
    # yet cut over (phase=Cutover) allows abort(0); once cutover has
    # completed (phase=Cleanup) it is refused (AbortAfterCutover=2) even
    # though Cleanup itself is not terminal.
    proc demoM4BeforeCutoverComplete() -> MigrationState:
        let base = do demoMigrationCaughtUp()
        return MigrationState{phase: 3, atomsTotal: base.atomsTotal, atomsCopied: base.atomsCopied, sourceHighWater: base.sourceHighWater, destinationApplied: base.destinationApplied, hasFence: true, fenceLastWrite: 1, cutoverCompletedAtMs: -1, maxCutoverPendingWrites: base.maxCutoverPendingWrites}

    proc demoM4AbortBeforeStatus() -> int:
        let state = do demoM4BeforeCutoverComplete()
        let status = do migrationAbortStatus(state)
        return status

    proc demoM4AbortAfterStatus() -> int:
        let state = do demoM3AfterCutoverComplete()
        let status = do migrationAbortStatus(state)
        return status

    # M5 `a_replayed_write_to_the_source_is_refused` /
    # `the_destination_cannot_claim_a_write_the_source_never_took`: two
    # smaller, independent traces exercising accept_write's
    # NonMonotonicWrite(4) and record_applied's UnknownWrite(1) branches,
    # neither reached by M1-M4.
    proc demoM5NonMonotonicStatus() -> int:
        let state = MigrationState{phase: 1, atomsTotal: 156, atomsCopied: 0, sourceHighWater: 7, destinationApplied: -1, hasFence: false, fenceLastWrite: -1, cutoverCompletedAtMs: -1, maxCutoverPendingWrites: 64}
        let status = do migrationAcceptWriteStatus(state, 7)
        return status

    proc demoM5UnknownWriteStatus() -> int:
        let state = MigrationState{phase: 1, atomsTotal: 156, atomsCopied: 0, sourceHighWater: 3, destinationApplied: -1, hasFence: false, fenceLastWrite: -1, cutoverCompletedAtMs: -1, maxCutoverPendingWrites: 64}
        let status = do migrationRecordAppliedStatus(state, 9)
        return status

    # M6 `a_plan_to_the_same_node_is_refused` / phase-table sanity restating
    # `cutover_cannot_be_skipped` and `abort_stops_being_available_once_authority_has_moved`.
    proc demoM6PlanSameNode() -> int:
        let status = do migrationPlanStatus("db-a", "db-a")
        return status

    proc demoM6PlanDifferentNodes() -> int:
        let status = do migrationPlanStatus("db-a", "db-b")
        return status

    proc demoM6CutoverCannotBeSkipped() -> bool:
        let a = do phaseCanAdvanceTo(1, 4)
        let b = do phaseCanAdvanceTo(2, 4)
        let c = do phaseCanAdvanceTo(0, 5)
        return !a && !b && !c

    proc demoM6AbortWindowNarrowsAfterCutover() -> bool:
        let cutoverToAborted = do phaseCanAdvanceTo(3, 6)
        let cleanupToAborted = do phaseCanAdvanceTo(4, 6)
        let completedToAborted = do phaseCanAdvanceTo(5, 6)
        return cutoverToAborted && !cleanupToAborted && !completedToAborted

    state demoM1BeginCatchUp: int = 0
    state demoM2BeginCutover: int = 0
    state demoM2UndrainedPending: int = 0
    state demoM2CompleteUndrained: int = 0
    state demoM2CompleteDrained: int = 0
    state demoM3Replay: int = 0
    state demoM3NewWrite: int = 0
    state demoM4AbortBefore: int = 0
    state demoM4AbortAfter: int = 0
    state demoM5NonMonotonic: int = 0
    state demoM5UnknownWrite: int = 0
    state demoM6PlanSameNode: int = 0
    state demoM6PlanDifferentNodes: int = 0
    state demoM6CutoverCannotBeSkipped: bool = false
    state demoM6AbortWindowNarrows: bool = false

    action runDemoMigration():
        let m1BeginCatchUp = do demoM1BeginCatchUpStatus()
        let m2BeginCutover = do demoM2BeginCutoverStatus()
        let m2UndrainedPending = do demoM2UndrainedPending()
        let m2CompleteUndrained = do demoM2CompleteCutoverUndrainedStatus()
        let m2CompleteDrained = do demoM2CompleteCutoverDrainedStatus()
        let m3Replay = do demoM3ReplayStatus()
        let m3NewWrite = do demoM3NewWriteStatus()
        let m4AbortBefore = do demoM4AbortBeforeStatus()
        let m4AbortAfter = do demoM4AbortAfterStatus()
        let m5NonMonotonic = do demoM5NonMonotonicStatus()
        let m5UnknownWrite = do demoM5UnknownWriteStatus()
        let m6PlanSameNode = do demoM6PlanSameNode()
        let m6PlanDifferentNodes = do demoM6PlanDifferentNodes()
        let m6CutoverCannotBeSkipped = do demoM6CutoverCannotBeSkipped()
        let m6AbortWindowNarrows = do demoM6AbortWindowNarrowsAfterCutover()
        demoM1BeginCatchUp = m1BeginCatchUp
        demoM2BeginCutover = m2BeginCutover
        demoM2UndrainedPending = m2UndrainedPending
        demoM2CompleteUndrained = m2CompleteUndrained
        demoM2CompleteDrained = m2CompleteDrained
        demoM3Replay = m3Replay
        demoM3NewWrite = m3NewWrite
        demoM4AbortBefore = m4AbortBefore
        demoM4AbortAfter = m4AbortAfter
        demoM5NonMonotonic = m5NonMonotonic
        demoM5UnknownWrite = m5UnknownWrite
        demoM6PlanSameNode = m6PlanSameNode
        demoM6PlanDifferentNodes = m6PlanDifferentNodes
        demoM6CutoverCannotBeSkipped = m6CutoverCannotBeSkipped
        demoM6AbortWindowNarrows = m6AbortWindowNarrows

    state demoD1Blocker: int = 0
    state demoD1HasPromotion: bool = true
    state demoD2HasPromotion: bool = false
    state demoD2PromotionNode: text = ""
    state demoD3StrictBlocker: int = 0
    state demoD3StrictIsStuck: bool = false
    state demoD3LenientHasPromotion: bool = false
    state demoD3LenientPromotionNode: text = ""
    state demoD4NeedsReplacement: bool = false
    state demoD4CandidateIneligibility: int = 0

    action runDemoFailover():
        let d1Blocker = do demoD1Blocker()
        let d1HasPromotion = do demoD1HasPromotion()
        let d2HasPromotion = do demoD2HasPromotion()
        let d2PromotionNode = do demoD2PromotionNode()
        let d3StrictBlocker = do demoD3StrictBlocker()
        let d3StrictIsStuck = do demoD3StrictIsStuck()
        let d3LenientHasPromotion = do demoD3LenientHasPromotion()
        let d3LenientPromotionNode = do demoD3LenientPromotionNode()
        let d4NeedsReplacement = do demoD4NeedsReplacement()
        let d4CandidateIneligibility = do demoD4CandidateIneligibility()
        demoD1Blocker = d1Blocker
        demoD1HasPromotion = d1HasPromotion
        demoD2HasPromotion = d2HasPromotion
        demoD2PromotionNode = d2PromotionNode
        demoD3StrictBlocker = d3StrictBlocker
        demoD3StrictIsStuck = d3StrictIsStuck
        demoD3LenientHasPromotion = d3LenientHasPromotion
        demoD3LenientPromotionNode = d3LenientPromotionNode
        demoD4NeedsReplacement = d4NeedsReplacement
        demoD4CandidateIneligibility = d4CandidateIneligibility

    state demoA1Status: int = 0
    state demoA1Key: int = 0
    state demoA2Status: int = 0
    state demoB1Status: int = 0
    state demoB1Key: int = 0
    state demoB2Key: int = 0
    state demoC1Status: int = 0
    state demoC1Key: int = 0
    state demoC1bStatus: int = 0
    state demoC2NotSpanning: bool = true
    state demoC2SingleSpanning: bool = false
    state demoValEmptyKind: int = 0
    state demoValEmptyPrefix: int = 0
    state demoValDupKind: int = 0
    state demoValDupPrefix: int = 0
    state demoValOk: int = 0

    action runDemoFabric():
        let a1Status = do demoScenarioA1Status()
        let a1Key = do demoScenarioA1Key()
        let a2Status = do demoScenarioA2Status()
        let b1Status = do demoScenarioB1Status()
        let b1Key = do demoScenarioB1Key()
        let b2Key = do demoScenarioB2Key()
        let c1Status = do demoScenarioC1Status()
        let c1Key = do demoScenarioC1Key()
        let c1bStatus = do demoScenarioC1bStatus()
        let c2NotSpanning = do demoScenarioC2NotSpanning()
        let c2SingleSpanning = do demoScenarioC2SingleSpanning()
        let valEmptyKind = do demoValidationEmptyKind()
        let valEmptyPrefix = do demoValidationEmptyPrefix()
        let valDupKind = do demoValidationDuplicateKind()
        let valDupPrefix = do demoValidationDuplicatePrefix()
        let valOk = do demoValidationOk()
        demoA1Status = a1Status
        demoA1Key = a1Key
        demoA2Status = a2Status
        demoB1Status = b1Status
        demoB1Key = b1Key
        demoB2Key = b2Key
        demoC1Status = c1Status
        demoC1Key = c1Key
        demoC1bStatus = c1bStatus
        demoC2NotSpanning = c2NotSpanning
        demoC2SingleSpanning = c2SingleSpanning
        demoValEmptyKind = valEmptyKind
        demoValEmptyPrefix = valEmptyPrefix
        demoValDupKind = valDupKind
        demoValDupPrefix = valDupPrefix
        demoValOk = valOk

    view Home at "/":
        box:
            text "{demoA1Status} {demoA1Key} {demoA2Status} {demoB1Status} {demoB1Key} {demoB2Key} {demoC1Status} {demoC1Key} {demoC1bStatus} {demoC2NotSpanning} {demoC2SingleSpanning} {demoValEmptyKind} {demoValEmptyPrefix} {demoValDupKind} {demoValDupPrefix} {demoValOk}"
            text "{demoD1Blocker} {demoD1HasPromotion} {demoD2HasPromotion} {demoD2PromotionNode} {demoD3StrictBlocker} {demoD3StrictIsStuck} {demoD3LenientHasPromotion} {demoD3LenientPromotionNode} {demoD4NeedsReplacement} {demoD4CandidateIneligibility}"
            text "{demoM1BeginCatchUp} {demoM2BeginCutover} {demoM2UndrainedPending} {demoM2CompleteUndrained} {demoM2CompleteDrained} {demoM3Replay} {demoM3NewWrite} {demoM4AbortBefore} {demoM4AbortAfter} {demoM5NonMonotonic} {demoM5UnknownWrite} {demoM6PlanSameNode} {demoM6PlanDifferentNodes} {demoM6CutoverCannotBeSkipped} {demoM6AbortWindowNarrows}"
