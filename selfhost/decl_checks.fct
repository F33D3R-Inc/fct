    private proc scenarioViewDupPathSummary() -> text:
        let src = do scenarioViewDupPathSrc()
        let d = do checkProgramSrcSummary(src)
        return d

    private proc scenarioViewDupPathValid() -> bool:
        let src = do scenarioViewDupPathSrc()
