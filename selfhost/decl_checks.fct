    # ============================================================
    # STAGE 20: source-to-verdict + describe — the same "struct work stays
    # in proc-land, only a scalar crosses into an action" shape
    # semantics.fct's own describeOutcome/scenario pairs already established
    # (a struct value can never be a `state` cell or an action-local `let`).
    # ============================================================
    private proc checkProgramSrc(src: text) -> DeclCheckResult:
        let prog = do parseProgramSrc(src)
        let r = do checkProgramDecls(prog)
        return r

    private proc describeDeclCheck(r: DeclCheckResult) -> text:
        let mut validText = "false"
        if r.valid:
            validText = "true"
        return "valid=" + validText + " message=" + r.message

    private proc checkProgramSrcSummary(src: text) -> text:
        let r = do checkProgramSrc(src)
        let d = do describeDeclCheck(r)
        return d

    private proc checkProgramSrcValid(src: text) -> bool:
        let r = do checkProgramSrc(src)
        return r.valid

    # ============================================================
    # HAND-TRACED VERIFICATION FIXTURES — each one a real branch of a real
