    # already known (from program.fct's own live driver) to parse cleanly —
    # so this file's very first check is "does a real, valid multi-kind
    # program still come back valid", the same "prove the happy path isn't
    # accidentally broken" step every earlier struct-milestone file's own
    # closing driver runs first.
    # ============================================================
    private proc scenarioValidSrc() -> text:
        let __ret78 = do demoProgramSrc()
        return __ret78

    # SCENARIO A — two entities named "Widget": expect invalid, "entity
    # \"Widget\" redeclared".
    private proc scenarioDupEntitySrc() -> text:
        return "app DupEntity:\n    entity Widget:\n        name: text\n    entity Widget:\n        price: int\n"

    # SCENARIO B — a state cell named the same as a declared entity: expect
    # invalid, "collides with an entity name".
    private proc scenarioStateEntityClashSrc() -> text:
        return "app StateClash:\n    entity Widget:\n        name: text\n    state Widget: int = 0\n"

    # SCENARIO C — a state cell named "route": expect invalid, the built-in
    # `route` message.
    private proc scenarioStateRouteSrc() -> text:
        return "app StateRoute:\n    state route: text = \"\"\n"

    # SCENARIO D — a job targeting an action that takes arguments: expect
    # invalid, "takes arguments" message.
    private proc scenarioJobArgsSrc() -> text:
        return "app JobArgs:\n    action bump(n: int):\n        check n >= 0 \"n must be nonnegative\"\n    job Sweep every 60s -> bump\n"

    # SCENARIO E — a webhook path that collides with a runtime-reserved
    # route ("/api"): expect invalid, the reserved-route message.
    private proc scenarioWebhookReservedSrc() -> text:
        return "app HookReserved:\n    action onHook():\n        check true \"always\"\n    webhook \"/api\" -> onHook\n"

    # SCENARIO F — two views that both resolve to the same explicit route:
    # expect invalid, "both map to route" message.
    private proc scenarioViewDupPathSrc() -> text:
        return "app ViewDup:\n    view Home at \"/same\":\n        text \"a\"\n    view Other at \"/same\":\n        text \"b\"\n"

    # SCENARIO G — a trigger reaction naming an action that doesn't exist:
    # expect invalid, "is not a defined action" message.
    private proc scenarioTriggerUnknownSrc() -> text:
        return "app TrigUnknown:\n    action seed():\n        check true \"always\"\n    on seed -> missingAction\n"

    # --- one summary/valid proc PAIR per scenario — a struct value
    # (`DeclCheckResult`) can never cross into an action or be bound by one
    # (confirmed live: `facet check` on an earlier draft of this file
    # rejected exactly that, naming the struct return type outright — the
    # same restriction semantics.fct's own STAGE 7 already documents for
    # `PlacementOutcome`), so each scenario is read apart entirely INSIDE
    # proc-land: one proc composes the checkProgramSrc verdict, a second
    # (independently, from scratch — a proc has one return value only)
    # reads its `.valid` field. Only these two scalars ever cross into an
    # action, the identical "do the struct work in a proc, expose only
    # scalars to state" shape semantics.fct's own scenario pairs already
    # established for a decision-result struct, restated here for this
    # file's own DeclCheckResult. ---
    private proc scenarioValidSummary() -> text:
        let src = do scenarioValidSrc()
        let d = do checkProgramSrcSummary(src)
        return d

    private proc scenarioValidValid() -> bool:
        let src = do scenarioValidSrc()
        let v = do checkProgramSrcValid(src)
        return v

    private proc scenarioDupEntitySummary() -> text:
        let src = do scenarioDupEntitySrc()
        let d = do checkProgramSrcSummary(src)
        return d

    private proc scenarioDupEntityValid() -> bool:
        let src = do scenarioDupEntitySrc()
        let v = do checkProgramSrcValid(src)
        return v

    private proc scenarioStateEntityClashSummary() -> text:
        let src = do scenarioStateEntityClashSrc()
        let d = do checkProgramSrcSummary(src)
        return d

    private proc scenarioStateEntityClashValid() -> bool:
        let src = do scenarioStateEntityClashSrc()
        let v = do checkProgramSrcValid(src)
        return v

    private proc scenarioStateRouteSummary() -> text:
        let src = do scenarioStateRouteSrc()
        let d = do checkProgramSrcSummary(src)
        return d

    private proc scenarioStateRouteValid() -> bool:
        let src = do scenarioStateRouteSrc()
        let v = do checkProgramSrcValid(src)
        return v

    private proc scenarioJobArgsSummary() -> text:
        let src = do scenarioJobArgsSrc()
        let d = do checkProgramSrcSummary(src)
        return d

    private proc scenarioJobArgsValid() -> bool:
        let src = do scenarioJobArgsSrc()
        let v = do checkProgramSrcValid(src)
        return v

    private proc scenarioWebhookReservedSummary() -> text:
