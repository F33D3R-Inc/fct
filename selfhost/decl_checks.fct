        let d = do checkProgramSrcSummary(src)
        return d

    private proc scenarioTriggerUnknownValid() -> bool:
        let src = do scenarioTriggerUnknownSrc()
        let v = do checkProgramSrcValid(src)
        return v

    state summaryResult: text = ""
    state validResult: bool = false

    action runScenarioValid():
        let s = do scenarioValidSummary()
        let v = do scenarioValidValid()
        summaryResult = s
        validResult = v

    action runScenarioDupEntity():
        let s = do scenarioDupEntitySummary()
        let v = do scenarioDupEntityValid()
        summaryResult = s
        validResult = v

    action runScenarioStateEntityClash():
        let s = do scenarioStateEntityClashSummary()
        let v = do scenarioStateEntityClashValid()
        summaryResult = s
        validResult = v

    action runScenarioStateRoute():
        let s = do scenarioStateRouteSummary()
        let v = do scenarioStateRouteValid()
        summaryResult = s
        validResult = v

    action runScenarioJobArgs():
        let s = do scenarioJobArgsSummary()
        let v = do scenarioJobArgsValid()
        summaryResult = s
        validResult = v

    action runScenarioWebhookReserved():
        let s = do scenarioWebhookReservedSummary()
        let v = do scenarioWebhookReservedValid()
        summaryResult = s
        validResult = v

    action runScenarioViewDupPath():
        let s = do scenarioViewDupPathSummary()
        let v = do scenarioViewDupPathValid()
        summaryResult = s
        validResult = v

    action runScenarioTriggerUnknown():
        let s = do scenarioTriggerUnknownSummary()
        let v = do scenarioTriggerUnknownValid()
        summaryResult = s
        validResult = v

    # runCheckProgramSrc: the general-purpose, HTTP-exercisable driver —
    # arbitrary source text in, this file's full checkProgramDecls verdict
    # out.
    action runCheckProgramSrc(src: text):
        let s = do checkProgramSrcSummary(src)
        let v = do checkProgramSrcValid(src)
        summaryResult = s
        validResult = v

    private view Home at "/decl_checks":
        box:
            text "{summaryResult}"
            text "{validResult}"
