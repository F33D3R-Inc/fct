import "fabric_core.fct"
import "fabric_telemetry.fct"
import "fabric_json.fct"

app FabricProtocolSelfHost:
    # Port of fabric/crates/fabric-protocol/src: message.rs (ProtocolVersion,
    # FabricMessage, FabricResponse), node.rs (NodeRegistration,
    # NodeHeartbeat), topology.rs (TopologyReport, Placement ->
    # ProtocolPlacement), observation.rs (TelemetryBatch, TelemetrySample and
    # its metrics(), WorkloadObservation) and transport.rs (ProtocolError and
    # its Display, ProtocolServer::decode/encode/handle, authorized,
    # PROTOCOL_TOKEN_ENV). The axum router/listener and the facet-protocol
    # binary are socket wiring and are not ported.
    #
    # The wire format is serde_json with serde's default, externally tagged
    # enums: {"Heartbeat":{...}} for a newtype/struct variant, the bare
    # string "Acknowledged" for the unit variant, DbmsId as its bare string,
    # Shard as {id, workload_domain}. Decoding and encoding go through
    # fabric_json.fct, which follows serde_json's own number, string and
    # float rules; fabric_leaf_a_test.go checks both directions against the
    # real crate (testdata/fabric_check).
    #
    # Enums are text-tagged structs (`kind` names the variant; only that
    # variant's fields are meaningful).

    # ============================================================
    # WIRE DATA MODEL
    # ============================================================
    # ProtocolShard: the WIRE subset only (`grid`/`storage` are
    # `#[serde(skip)]` in the real source — see header). Renamed from the
    # real Rust type's own name, `Shard`, only to avoid a struct-name
    # collision with fabric_core.fct's own, differently-shaped `Shard`.
    struct ProtocolShard:
        id: int
        workloadDomain: text

    struct ProtocolVersion:
        major: int
        minor: int

    proc protocolVersionV1() -> ProtocolVersion:
        return ProtocolVersion{major: 1, minor: 0}

    struct NodeRegistration:
        protocol: text
        nodeId: DbmsId
        softwareVersion: text
        region: text

    # node.rs NodeRegistration::new: the protocol tag is always "facet/1".
    proc nodeRegistrationNew(nodeId: DbmsId, softwareVersion: text, region: text) -> NodeRegistration:
        return NodeRegistration{protocol: "facet/1", nodeId: nodeId, softwareVersion: softwareVersion, region: region}

    struct NodeHeartbeat:
        nodeId: DbmsId
        timestampMs: int
        healthy: bool

    struct ProtocolPlacement:
        coordinate: Coordinate
        dbmsId: DbmsId
        region: text

    struct TopologyReport:
        nodeId: DbmsId
        timestampMs: int
        placements: [ProtocolPlacement]

    struct TelemetrySample:
        coordinate: Coordinate
        operationsPerSecond: float
        readRatio: float
        writeRatio: float
        readLatencyUs: float
        writeLatencyUs: float
        cpuUtilization: float
        memoryUtilization: float
        queueDepth: int
        # `#[serde(default)]` in the real source: absent on the wire decodes
        # as empty, not a decode failure.
        cellBreakdown: [CellWorkloadMetrics]
        # `#[serde(default)]` in the real source: absent on the wire decodes
        # as false, not a decode failure.
        cellBreakdownPartial: bool

    # observation.rs TelemetrySample::metrics: reads/writes are the total
    # scaled by the ratios; the three byte rates are always 0.
    proc telemetrySampleMetrics(s: TelemetrySample) -> WorkloadMetrics:
        let total = s.operationsPerSecond
        return WorkloadMetrics{operationsPerSecond: total, readsPerSecond: total * s.readRatio, writesPerSecond: total * s.writeRatio, readLatencyUs: s.readLatencyUs, writeLatencyUs: s.writeLatencyUs, cpuUtilization: s.cpuUtilization, memoryUtilization: s.memoryUtilization, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: s.queueDepth, cellBreakdown: s.cellBreakdown, cellBreakdownPartial: s.cellBreakdownPartial}

    struct TelemetryBatch:
        timestampMs: int
        nodeId: DbmsId
        shard: ProtocolShard
        samples: [TelemetrySample]

    struct WorkloadObservation:
        # Real field type is a plain `String` here, NOT `DbmsId` — confirmed
        # by reading observation.rs directly (unlike every other `node_id`
        # in this crate).
        nodeId: text
        coordinate: Coordinate
        timestampMs: int
        operationsPerSecond: float
        readRatio: float
        writeRatio: float

    # FabricMessage: text-tagged restatement of the 5-variant enum. `kind`
    # is one of "RegisterNode"/"Heartbeat"/"Topology"/"Telemetry"/"Workload".
    struct FabricMessage:
        kind: text
        registerNode: NodeRegistration
        heartbeat: NodeHeartbeat
        topology: TopologyReport
        telemetry: TelemetryBatch
        workload: WorkloadObservation

    # FabricResponse: text-tagged restatement of the 4-variant enum. `kind`
    # is one of "Acknowledged"/"Registered"/"OptimizationProposal"/
    # "Rejected".
    struct FabricResponse:
        kind: text
        registeredNodeId: text
        proposalCoordinate: text
        proposalAction: text
        proposalExpectedGain: float
        proposalEstimatedCost: float
        proposalConfidence: float
        rejectedReason: text

    proc protoEmptyFabricMessage() -> FabricMessage:
        let emptyId = DbmsId{value: ""}
        let emptyCoord = Coordinate{x: 0, y: 0}
        let emptyReg = NodeRegistration{protocol: "", nodeId: emptyId, softwareVersion: "", region: ""}
        let emptyHb = NodeHeartbeat{nodeId: emptyId, timestampMs: 0, healthy: false}
        let emptyTopo = TopologyReport{nodeId: emptyId, timestampMs: 0, placements: []}
        let emptyShard = ProtocolShard{id: 0, workloadDomain: ""}
        let emptyTelemetry = TelemetryBatch{timestampMs: 0, nodeId: emptyId, shard: emptyShard, samples: []}
        let emptyWorkload = WorkloadObservation{nodeId: "", coordinate: emptyCoord, timestampMs: 0, operationsPerSecond: 0.0, readRatio: 0.0, writeRatio: 0.0}
        return FabricMessage{kind: "", registerNode: emptyReg, heartbeat: emptyHb, topology: emptyTopo, telemetry: emptyTelemetry, workload: emptyWorkload}

    proc protoEmptyFabricResponse() -> FabricResponse:
        return FabricResponse{kind: "", registeredNodeId: "", proposalCoordinate: "", proposalAction: "", proposalExpectedGain: 0.0, proposalEstimatedCost: 0.0, proposalConfidence: 0.0, rejectedReason: ""}

    # ============================================================
    # DECODE — serde's derived Deserialize over serde_json (fabric_json.fct)
    # ============================================================
    # The schema of every wire type, as the derives declare them: field
    # names and order, #[serde(default)] on TelemetrySample's two breakdown
    # fields, Shard without its #[serde(skip)] grid/storage, DbmsId (a
    # newtype around String) as "string", the externally tagged enums.
    proc protoSchema() -> [SjType]:
        let coordinate = sjStructType("Coordinate", "struct Coordinate", ["x", "y"], ["u8", "u8"], [false, false])
        let cell = sjStructType("CellWorkloadMetrics", "struct CellWorkloadMetrics", ["x", "y", "z", "q", "reads_per_second", "writes_per_second", "bytes_read_per_second", "bytes_written_per_second"], ["u8", "u8", "u8", "u8", "f64", "f64", "f64", "f64"], [false, false, false, false, false, false, false, false])
        let shard = sjStructType("Shard", "struct Shard", ["id", "workload_domain"], ["u64", "string"], [false, false])
        let reg = sjStructType("NodeRegistration", "struct NodeRegistration", ["protocol", "node_id", "software_version", "region"], ["string", "string", "string", "string"], [false, false, false, false])
        let hb = sjStructType("NodeHeartbeat", "struct NodeHeartbeat", ["node_id", "timestamp_ms", "healthy"], ["string", "u64", "bool"], [false, false, false])
        let placement = sjStructType("Placement", "struct Placement", ["coordinate", "dbms_id", "region"], ["Coordinate", "string", "string"], [false, false, false])
        let topo = sjStructType("TopologyReport", "struct TopologyReport", ["node_id", "timestamp_ms", "placements"], ["string", "u64", "Vec<Placement>"], [false, false, false])
        let sample = sjStructType("TelemetrySample", "struct TelemetrySample", ["coordinate", "operations_per_second", "read_ratio", "write_ratio", "read_latency_us", "write_latency_us", "cpu_utilization", "memory_utilization", "queue_depth", "cell_breakdown", "cell_breakdown_partial"], ["Coordinate", "f64", "f64", "f64", "f64", "f64", "f64", "f64", "u64", "Vec<CellWorkloadMetrics>", "bool"], [false, false, false, false, false, false, false, false, false, true, true])
        let batch = sjStructType("TelemetryBatch", "struct TelemetryBatch", ["timestamp_ms", "node_id", "shard", "samples"], ["u64", "string", "Shard", "Vec<TelemetrySample>"], [false, false, false, false])
        let obs = sjStructType("WorkloadObservation", "struct WorkloadObservation", ["node_id", "coordinate", "timestamp_ms", "operations_per_second", "read_ratio", "write_ratio"], ["string", "Coordinate", "u64", "f64", "f64", "f64"], [false, false, false, false, false, false])
        let message = sjEnumType("FabricMessage", "enum FabricMessage", ["RegisterNode", "Heartbeat", "Topology", "Telemetry", "Workload"], ["NodeRegistration", "NodeHeartbeat", "TopologyReport", "TelemetryBatch", "WorkloadObservation"], ["newtype", "newtype", "newtype", "newtype", "newtype"])
        let registered = sjStructType("FabricResponse::Registered", "struct variant FabricResponse::Registered", ["node_id"], ["string"], [false])
        let proposal = sjStructType("FabricResponse::OptimizationProposal", "struct variant FabricResponse::OptimizationProposal", ["coordinate", "action", "expected_gain", "estimated_cost", "confidence"], ["string", "string", "f64", "f64", "f64"], [false, false, false, false, false])
        let rejected = sjStructType("FabricResponse::Rejected", "struct variant FabricResponse::Rejected", ["reason"], ["string"], [false])
        let response = sjEnumType("FabricResponse", "enum FabricResponse", ["Acknowledged", "Registered", "OptimizationProposal", "Rejected"], ["", "FabricResponse::Registered", "FabricResponse::OptimizationProposal", "FabricResponse::Rejected"], ["unit", "struct", "struct", "struct"])
        return [coordinate, cell, shard, reg, hb, placement, sjVecType("Vec<Placement>", "Placement"), topo, sjVecType("Vec<CellWorkloadMetrics>", "CellWorkloadMetrics"), sample, sjVecType("Vec<TelemetrySample>", "TelemetrySample"), batch, obs, message, sjVecType("Vec<FabricMessage>", "FabricMessage"), registered, proposal, rejected, response]

    # From a decoded (already type-checked) value to the port's structs.
    proc protoCoordinateOf(v: SjV) -> Coordinate:
        return Coordinate{x: v.items[0].u, y: v.items[1].u}

    proc protoCellOf(v: SjV) -> CellWorkloadMetrics:
        return CellWorkloadMetrics{x: v.items[0].u, y: v.items[1].u, z: v.items[2].u, q: v.items[3].u, readsPerSecond: v.items[4].f, writesPerSecond: v.items[5].f, bytesReadPerSecond: v.items[6].f, bytesWrittenPerSecond: v.items[7].f}

    proc protoSampleOf(v: SjV) -> TelemetrySample:
        let mut cells = []
        let cv = v.items[9]
        let mut i = 0
        loop i < len(cv.items):
            cells = append(cells, protoCellOf(cv.items[i]))
            i = i + 1
        let partial = v.items[10].kind == "bool" && v.items[10].b
        return TelemetrySample{coordinate: protoCoordinateOf(v.items[0]), operationsPerSecond: v.items[1].f, readRatio: v.items[2].f, writeRatio: v.items[3].f, readLatencyUs: v.items[4].f, writeLatencyUs: v.items[5].f, cpuUtilization: v.items[6].f, memoryUtilization: v.items[7].f, queueDepth: v.items[8].u, cellBreakdown: cells, cellBreakdownPartial: partial}

    proc protoMessageOf(v: SjV) -> FabricMessage:
        let empty = protoEmptyFabricMessage()
        let p = v.items[0]
        if v.s == "RegisterNode":
            let r = NodeRegistration{protocol: p.items[0].s, nodeId: DbmsId{value: p.items[1].s}, softwareVersion: p.items[2].s, region: p.items[3].s}
            return FabricMessage{kind: "RegisterNode", registerNode: r, heartbeat: empty.heartbeat, topology: empty.topology, telemetry: empty.telemetry, workload: empty.workload}
        if v.s == "Heartbeat":
            let h = NodeHeartbeat{nodeId: DbmsId{value: p.items[0].s}, timestampMs: p.items[1].u, healthy: p.items[2].b}
            return FabricMessage{kind: "Heartbeat", registerNode: empty.registerNode, heartbeat: h, topology: empty.topology, telemetry: empty.telemetry, workload: empty.workload}
        if v.s == "Topology":
            let mut placements = []
            let pv = p.items[2]
            let mut i = 0
            loop i < len(pv.items):
                let e = pv.items[i]
                placements = append(placements, ProtocolPlacement{coordinate: protoCoordinateOf(e.items[0]), dbmsId: DbmsId{value: e.items[1].s}, region: e.items[2].s})
                i = i + 1
            let t = TopologyReport{nodeId: DbmsId{value: p.items[0].s}, timestampMs: p.items[1].u, placements: placements}
            return FabricMessage{kind: "Topology", registerNode: empty.registerNode, heartbeat: empty.heartbeat, topology: t, telemetry: empty.telemetry, workload: empty.workload}
        if v.s == "Telemetry":
            let mut samples = []
            let sv = p.items[3]
            let mut j = 0
            loop j < len(sv.items):
                samples = append(samples, protoSampleOf(sv.items[j]))
                j = j + 1
            let sh = p.items[2]
            let b = TelemetryBatch{timestampMs: p.items[0].u, nodeId: DbmsId{value: p.items[1].s}, shard: ProtocolShard{id: sh.items[0].u, workloadDomain: sh.items[1].s}, samples: samples}
            return FabricMessage{kind: "Telemetry", registerNode: empty.registerNode, heartbeat: empty.heartbeat, topology: empty.topology, telemetry: b, workload: empty.workload}
        let w = WorkloadObservation{nodeId: p.items[0].s, coordinate: protoCoordinateOf(p.items[1]), timestampMs: p.items[2].u, operationsPerSecond: p.items[3].f, readRatio: p.items[4].f, writeRatio: p.items[5].f}
        return FabricMessage{kind: "Workload", registerNode: empty.registerNode, heartbeat: empty.heartbeat, topology: empty.topology, telemetry: empty.telemetry, workload: w}

    proc protoResponseOf(v: SjV) -> FabricResponse:
        let e = protoEmptyFabricResponse()
        if v.s == "Registered":
            return FabricResponse{kind: "Registered", registeredNodeId: v.items[0].items[0].s, proposalCoordinate: "", proposalAction: "", proposalExpectedGain: 0.0, proposalEstimatedCost: 0.0, proposalConfidence: 0.0, rejectedReason: ""}
        if v.s == "OptimizationProposal":
            let p = v.items[0]
            return FabricResponse{kind: "OptimizationProposal", registeredNodeId: "", proposalCoordinate: p.items[0].s, proposalAction: p.items[1].s, proposalExpectedGain: p.items[2].f, proposalEstimatedCost: p.items[3].f, proposalConfidence: p.items[4].f, rejectedReason: ""}
        if v.s == "Rejected":
            return FabricResponse{kind: "Rejected", registeredNodeId: "", proposalCoordinate: "", proposalAction: "", proposalExpectedGain: 0.0, proposalEstimatedCost: 0.0, proposalConfidence: 0.0, rejectedReason: v.items[0].items[0].s}
        return FabricResponse{kind: "Acknowledged", registeredNodeId: e.registeredNodeId, proposalCoordinate: e.proposalCoordinate, proposalAction: e.proposalAction, proposalExpectedGain: e.proposalExpectedGain, proposalEstimatedCost: e.proposalEstimatedCost, proposalConfidence: e.proposalConfidence, rejectedReason: e.rejectedReason}

    # transport.rs ProtocolError and its Display.
    struct ProtocolError:
        kind: text
        message: text

    proc protocolErrorDisplay(e: ProtocolError) -> text:
        if e.kind == "InvalidMessage":
            return "invalid message: " + e.message
        if e.kind == "Serialization":
            return "serialization error: " + e.message
        return "I/O error: " + e.message

    struct ProtoDecodeResult:
        ok: bool
        message: FabricMessage
        error: text

    # ProtocolServer::decode: serde_json::from_slice::<FabricMessage>, a
    # failure mapped to ProtocolError::Serialization(serde error Display);
    # `error` is that ProtocolError's Display. The payload is the UTF-8
    # body as text.
    proc protocolDecode(payload: text) -> ProtoDecodeResult:
        let d = sjDecode(protoSchema(), payload, "FabricMessage")
        if !d.ok:
            return ProtoDecodeResult{ok: false, message: protoEmptyFabricMessage(), error: protocolErrorDisplay(ProtocolError{kind: "Serialization", message: d.err})}
        return ProtoDecodeResult{ok: true, message: protoMessageOf(d.v), error: ""}

    struct ProtoDecodeMessagesResult:
        ok: bool
        messages: [FabricMessage]
        error: text

    # serde_json::from_slice::<Vec<FabricMessage>> (fabric-cli's session
    # file): `error` is serde_json::Error's Display exactly.
    proc protocolDecodeMessages(payload: text) -> ProtoDecodeMessagesResult:
        let d = sjDecode(protoSchema(), payload, "Vec<FabricMessage>")
        if !d.ok:
            return ProtoDecodeMessagesResult{ok: false, messages: [], error: d.err}
        let mut out = []
        let mut i = 0
        loop i < len(d.v.items):
            out = append(out, protoMessageOf(d.v.items[i]))
            i = i + 1
        return ProtoDecodeMessagesResult{ok: true, messages: out, error: ""}

    struct ProtoResponseResult:
        ok: bool
        response: FabricResponse
        error: text

    # serde_json::from_slice::<FabricResponse>: what a node reads back;
    # `error` is serde_json::Error's Display.
    proc protocolDecodeResponse(payload: text) -> ProtoResponseResult:
        let d = sjDecode(protoSchema(), payload, "FabricResponse")
        if !d.ok:
            return ProtoResponseResult{ok: false, response: protoEmptyFabricResponse(), error: d.err}
        return ProtoResponseResult{ok: true, response: protoResponseOf(d.v), error: ""}

    # transport.rs `ProtocolServer::handle`: RegisterNode is answered
    # Registered with its node id, every other message Acknowledged.
    proc protocolHandle(message: FabricMessage) -> FabricResponse:
        if message.kind == "RegisterNode":
            return FabricResponse{kind: "Registered", registeredNodeId: message.registerNode.nodeId.value, proposalCoordinate: "", proposalAction: "", proposalExpectedGain: 0.0, proposalEstimatedCost: 0.0, proposalConfidence: 0.0, rejectedReason: ""}
        return FabricResponse{kind: "Acknowledged", registeredNodeId: "", proposalCoordinate: "", proposalAction: "", proposalExpectedGain: 0.0, proposalEstimatedCost: 0.0, proposalConfidence: 0.0, rejectedReason: ""}

    # ============================================================
    # ENCODE — serde_json::to_string / to_vec
    # ============================================================
    # ProtocolServer::encode: the response as serde_json writes it (the unit
    # variant as the bare string "Acknowledged").
    proc protocolEncode(response: FabricResponse) -> text:
        if response.kind == "Registered":
            return "{\"Registered\":{\"node_id\":" + sjQuote(response.registeredNodeId) + "}}"
        if response.kind == "OptimizationProposal":
            return "{\"OptimizationProposal\":{\"coordinate\":" + sjQuote(response.proposalCoordinate) + ",\"action\":" + sjQuote(response.proposalAction) + ",\"expected_gain\":" + sjF64Text(response.proposalExpectedGain) + ",\"estimated_cost\":" + sjF64Text(response.proposalEstimatedCost) + ",\"confidence\":" + sjF64Text(response.proposalConfidence) + "}}"
        if response.kind == "Rejected":
            return "{\"Rejected\":{\"reason\":" + sjQuote(response.rejectedReason) + "}}"
        return "\"Acknowledged\""

    proc protocolVersionJson(v: ProtocolVersion) -> text:
        return "{\"major\":" + v.major + ",\"minor\":" + v.minor + "}"

    proc nodeRegistrationJson(r: NodeRegistration) -> text:
        return "{\"protocol\":" + sjQuote(r.protocol) + ",\"node_id\":" + dbmsIdJson(r.nodeId) + ",\"software_version\":" + sjQuote(r.softwareVersion) + ",\"region\":" + sjQuote(r.region) + "}"

    proc nodeHeartbeatJson(h: NodeHeartbeat) -> text:
        return "{\"node_id\":" + dbmsIdJson(h.nodeId) + ",\"timestamp_ms\":" + sjU64Text(h.timestampMs) + ",\"healthy\":" + sjBoolText(h.healthy) + "}"

    proc protocolPlacementJson(p: ProtocolPlacement) -> text:
        return "{\"coordinate\":" + coordinateJson(p.coordinate) + ",\"dbms_id\":" + dbmsIdJson(p.dbmsId) + ",\"region\":" + sjQuote(p.region) + "}"

    proc topologyReportJson(t: TopologyReport) -> text:
        let mut parts = []
        let mut i = 0
        loop i < len(t.placements):
            parts = append(parts, protocolPlacementJson(t.placements[i]))
            i = i + 1
        return "{\"node_id\":" + dbmsIdJson(t.nodeId) + ",\"timestamp_ms\":" + sjU64Text(t.timestampMs) + ",\"placements\":[" + join(parts, ",") + "]}"

    proc protocolShardJson(s: ProtocolShard) -> text:
        return "{\"id\":" + sjU64Text(s.id) + ",\"workload_domain\":" + sjQuote(s.workloadDomain) + "}"

    proc telemetrySampleJson(s: TelemetrySample) -> text:
        return "{\"coordinate\":" + coordinateJson(s.coordinate) + ",\"operations_per_second\":" + sjF64Text(s.operationsPerSecond) + ",\"read_ratio\":" + sjF64Text(s.readRatio) + ",\"write_ratio\":" + sjF64Text(s.writeRatio) + ",\"read_latency_us\":" + sjF64Text(s.readLatencyUs) + ",\"write_latency_us\":" + sjF64Text(s.writeLatencyUs) + ",\"cpu_utilization\":" + sjF64Text(s.cpuUtilization) + ",\"memory_utilization\":" + sjF64Text(s.memoryUtilization) + ",\"queue_depth\":" + sjU64Text(s.queueDepth) + ",\"cell_breakdown\":" + cellWorkloadMetricsArrayJson(s.cellBreakdown) + ",\"cell_breakdown_partial\":" + sjBoolText(s.cellBreakdownPartial) + "}"

    proc telemetryBatchJson(b: TelemetryBatch) -> text:
        let mut parts = []
        let mut i = 0
        loop i < len(b.samples):
            parts = append(parts, telemetrySampleJson(b.samples[i]))
            i = i + 1
        return "{\"timestamp_ms\":" + sjU64Text(b.timestampMs) + ",\"node_id\":" + dbmsIdJson(b.nodeId) + ",\"shard\":" + protocolShardJson(b.shard) + ",\"samples\":[" + join(parts, ",") + "]}"

    proc workloadObservationJson(w: WorkloadObservation) -> text:
        return "{\"node_id\":" + sjQuote(w.nodeId) + ",\"coordinate\":" + coordinateJson(w.coordinate) + ",\"timestamp_ms\":" + sjU64Text(w.timestampMs) + ",\"operations_per_second\":" + sjF64Text(w.operationsPerSecond) + ",\"read_ratio\":" + sjF64Text(w.readRatio) + ",\"write_ratio\":" + sjF64Text(w.writeRatio) + "}"

    # serde_json::to_string(&FabricMessage): what a node sends.
    proc protocolEncodeMessage(m: FabricMessage) -> text:
        if m.kind == "RegisterNode":
            return "{\"RegisterNode\":" + nodeRegistrationJson(m.registerNode) + "}"
        if m.kind == "Heartbeat":
            return "{\"Heartbeat\":" + nodeHeartbeatJson(m.heartbeat) + "}"
        if m.kind == "Topology":
            return "{\"Topology\":" + topologyReportJson(m.topology) + "}"
        if m.kind == "Telemetry":
            return "{\"Telemetry\":" + telemetryBatchJson(m.telemetry) + "}"
        return "{\"Workload\":" + workloadObservationJson(m.workload) + "}"

    # transport.rs `authorized`: constant-time comparison over the bytes, the
    # length difference folded in as its low byte.
    proc protocolAuthorized(presented: text, expected: text) -> bool:
        let p = textToBytes(presented)
        let e = textToBytes(expected)
        let np = len(p)
        let ne = len(e)
        let mut difference = (np ^ ne) & 255
        let mut n = np
        if ne > n:
            n = ne
        let mut i = 0
        loop i < n:
            let mut left = 0
            if i < np:
                left = p[i]
            let mut right = 0
            if i < ne:
                right = e[i]
            difference = difference | (left ^ right)
            i = i + 1
        return difference == 0

    proc protocolTokenEnv() -> text:
        return "FABRIC_PROTOCOL_TOKEN"

    # ============================================================
    # DEMOS — round-trip and corrupt/truncated-frame rejection, mirroring
    # heap.fct's own torn/corrupt-frame demo convention.
    # ============================================================
    proc protoDemoHeartbeatPayload() -> text:
        return "{\"Heartbeat\":{\"node_id\":\"db-7\",\"timestamp_ms\":1000,\"healthy\":true}}"

    proc protoDemoHeartbeatRoundTripOk() -> bool:
        let payload = do protoDemoHeartbeatPayload()
        let decoded = do protocolDecode(payload)
        if !decoded.ok:
            return false
        if decoded.message.kind != "Heartbeat":
            return false
        if decoded.message.heartbeat.nodeId.value != "db-7":
            return false
        if decoded.message.heartbeat.timestampMs != 1000:
            return false
        if !decoded.message.heartbeat.healthy:
            return false
        let response = do protocolHandle(decoded.message)
        if response.kind != "Acknowledged":
            return false
        let encoded = do protocolEncode(response)
        return encoded == "\"Acknowledged\""

    proc protoDemoRegisterPayload() -> text:
        return "{\"RegisterNode\":{\"protocol\":\"facet/1\",\"node_id\":\"db-9\",\"software_version\":\"1.2.3\",\"region\":\"us-east\"}}"

    proc protoDemoRegisterRoundTripOk() -> bool:
        let payload = do protoDemoRegisterPayload()
        let decoded = do protocolDecode(payload)
        if !decoded.ok:
            return false
        if decoded.message.kind != "RegisterNode":
            return false
        let response = do protocolHandle(decoded.message)
        if response.kind != "Registered":
            return false
        if response.registeredNodeId != "db-9":
            return false
        let encoded = do protocolEncode(response)
        return encoded == "{\"Registered\":{\"node_id\":\"db-9\"}}"

    proc protoDemoTopologyPayload() -> text:
        return "{\"Topology\":{\"node_id\":\"db-1\",\"timestamp_ms\":42,\"placements\":[{\"coordinate\":{\"x\":1,\"y\":2},\"dbms_id\":\"db-2\",\"region\":\"eu-west\"},{\"coordinate\":{\"x\":3,\"y\":4},\"dbms_id\":\"db-3\",\"region\":\"eu-west\"}]}}"

    proc protoDemoTopologyRoundTripOk() -> bool:
        let payload = do protoDemoTopologyPayload()
        let decoded = do protocolDecode(payload)
        if !decoded.ok:
            return false
        if decoded.message.kind != "Topology":
            return false
        if len(decoded.message.topology.placements) != 2:
            return false
        let first = decoded.message.topology.placements[0]
        if first.coordinate.x != 1 || first.coordinate.y != 2:
            return false
        if first.dbmsId.value != "db-2":
            return false
        let response = do protocolHandle(decoded.message)
        return response.kind == "Acknowledged"

    proc protoDemoTelemetryPayload() -> text:
        return "{\"Telemetry\":{\"timestamp_ms\":500,\"node_id\":\"db-5\",\"shard\":{\"id\":7,\"workload_domain\":\"orders\"},\"samples\":[{\"coordinate\":{\"x\":0,\"y\":0},\"operations_per_second\":12.5,\"read_ratio\":0.8,\"write_ratio\":0.2,\"read_latency_us\":100.0,\"write_latency_us\":200.0,\"cpu_utilization\":0.5,\"memory_utilization\":0.6,\"queue_depth\":3,\"cell_breakdown\":[{\"x\":0,\"y\":0,\"z\":0,\"q\":0,\"reads_per_second\":1.0,\"writes_per_second\":2.0,\"bytes_read_per_second\":3.0,\"bytes_written_per_second\":4.0}],\"cell_breakdown_partial\":true}]}}"

    proc protoDemoTelemetryRoundTripOk() -> bool:
        let payload = do protoDemoTelemetryPayload()
        let decoded = do protocolDecode(payload)
        if !decoded.ok:
            return false
        if decoded.message.kind != "Telemetry":
            return false
        if decoded.message.telemetry.shard.id != 7:
            return false
        if decoded.message.telemetry.shard.workloadDomain != "orders":
            return false
        if len(decoded.message.telemetry.samples) != 1:
            return false
        let sample = decoded.message.telemetry.samples[0]
        if sample.operationsPerSecond != 12.5:
            return false
        if len(sample.cellBreakdown) != 1:
            return false
        if !sample.cellBreakdownPartial:
            return false
        let response = do protocolHandle(decoded.message)
        return response.kind == "Acknowledged"

    # protoDemoTelemetryDefaultsOk: `cell_breakdown`/`cell_breakdown_partial`
    # both carry `#[serde(default)]` in the real source — an OLDER sender's
    # message (predating both fields) must still decode, with `[]`/`false`
    # filled in rather than a decode failure.
    proc protoDemoTelemetryDefaultsPayload() -> text:
        return "{\"Telemetry\":{\"timestamp_ms\":9,\"node_id\":\"db-6\",\"shard\":{\"id\":1,\"workload_domain\":\"legacy\"},\"samples\":[{\"coordinate\":{\"x\":1,\"y\":1},\"operations_per_second\":1.0,\"read_ratio\":1.0,\"write_ratio\":0.0,\"read_latency_us\":1.0,\"write_latency_us\":1.0,\"cpu_utilization\":0.1,\"memory_utilization\":0.1,\"queue_depth\":0}]}}"

    proc protoDemoTelemetryDefaultsOk() -> bool:
        let payload = do protoDemoTelemetryDefaultsPayload()
        let decoded = do protocolDecode(payload)
        if !decoded.ok:
            return false
        let sample = decoded.message.telemetry.samples[0]
        if len(sample.cellBreakdown) != 0:
            return false
        return !sample.cellBreakdownPartial

    proc protoDemoWorkloadPayload() -> text:
        return "{\"Workload\":{\"node_id\":\"db-4\",\"coordinate\":{\"x\":5,\"y\":6},\"timestamp_ms\":77,\"operations_per_second\":9.5,\"read_ratio\":0.5,\"write_ratio\":0.5}}"

    proc protoDemoWorkloadRoundTripOk() -> bool:
        let payload = do protoDemoWorkloadPayload()
        let decoded = do protocolDecode(payload)
        if !decoded.ok:
            return false
        if decoded.message.workload.nodeId != "db-4":
            return false
        let response = do protocolHandle(decoded.message)
        return response.kind == "Acknowledged"

    proc protoDemoOptimizationProposalEncode() -> text:
        let response = FabricResponse{kind: "OptimizationProposal", registeredNodeId: "", proposalCoordinate: "3,4", proposalAction: "rebalance", proposalExpectedGain: 12.5, proposalEstimatedCost: 3.25, proposalConfidence: 0.9, rejectedReason: ""}
        let encoded = do protocolEncode(response)
        return encoded

    proc protoDemoRejectedEncode() -> text:
        let response = FabricResponse{kind: "Rejected", registeredNodeId: "", proposalCoordinate: "", proposalAction: "", proposalExpectedGain: 0.0, proposalEstimatedCost: 0.0, proposalConfidence: 0.0, rejectedReason: "unknown backend"}
        let encoded = do protocolEncode(response)
        return encoded

    # protoDemoTruncatedRejected: a Heartbeat payload cut off mid-object —
    # the "torn frame" analogue for a text wire format. Must decode as a
    # clean failure (ok:false), never a partial/garbage success — mirroring
    # heap.fct's own torn-frame demo intent (`heapDemoTornOutcome`) for this
    # crate's own framing layer.
    proc protoDemoTruncatedPayload() -> text:
        return "{\"Heartbeat\":{\"node_id\":\"db-7\",\"timestamp_ms\":1000,\"healthy\":tr"

    proc protoDemoTruncatedRejected() -> bool:
        let payload = do protoDemoTruncatedPayload()
        let decoded = do protocolDecode(payload)
        return !decoded.ok

    # protoDemoCorruptRejected: syntactically-broken JSON (an unterminated
    # string) — the "corrupt frame" analogue.
    proc protoDemoCorruptPayload() -> text:
        return "{\"Heartbeat\":{\"node_id\":\"db-7,\"timestamp_ms\":1000,\"healthy\":true}}"

    proc protoDemoCorruptRejected() -> bool:
        let payload = do protoDemoCorruptPayload()
        let decoded = do protocolDecode(payload)
        return !decoded.ok

    # protoDemoUnknownVariantRejected: a well-formed JSON object naming a
    # variant that does not exist on `FabricMessage` — `serde`'s own
    # externally-tagged enum deserializer refuses this ("unknown variant"),
    # restated here as a clean ok:false.
    proc protoDemoUnknownVariantPayload() -> text:
        return "{\"Explode\":{}}"

    proc protoDemoUnknownVariantRejected() -> bool:
        let payload = do protoDemoUnknownVariantPayload()
        let decoded = do protocolDecode(payload)
        return !decoded.ok

    state demoHeartbeatOk: bool = false
    state demoRegisterOk: bool = false
    state demoTopologyOk: bool = false
    state demoTelemetryOk: bool = false
    state demoTelemetryDefaultsOk: bool = false
    state demoWorkloadOk: bool = false
    state demoOptimizationProposalJson: text = ""
    state demoRejectedJson: text = ""
    state demoTruncatedRejected: bool = false
    state demoCorruptRejected: bool = false
    state demoUnknownVariantRejected: bool = false

    action runDemoFabricProtocol():
        let heartbeatOk = do protoDemoHeartbeatRoundTripOk()
        let registerOk = do protoDemoRegisterRoundTripOk()
        let topologyOk = do protoDemoTopologyRoundTripOk()
        let telemetryOk = do protoDemoTelemetryRoundTripOk()
        let telemetryDefaultsOk = do protoDemoTelemetryDefaultsOk()
        let workloadOk = do protoDemoWorkloadRoundTripOk()
        let optimizationJson = do protoDemoOptimizationProposalEncode()
        let rejectedJson = do protoDemoRejectedEncode()
        let truncatedRejected = do protoDemoTruncatedRejected()
        let corruptRejected = do protoDemoCorruptRejected()
        let unknownVariantRejected = do protoDemoUnknownVariantRejected()

        demoHeartbeatOk = heartbeatOk
        demoRegisterOk = registerOk
        demoTopologyOk = topologyOk
        demoTelemetryOk = telemetryOk
        demoTelemetryDefaultsOk = telemetryDefaultsOk
        demoWorkloadOk = workloadOk
        demoOptimizationProposalJson = optimizationJson
        demoRejectedJson = rejectedJson
        demoTruncatedRejected = truncatedRejected
        demoCorruptRejected = corruptRejected
        demoUnknownVariantRejected = unknownVariantRejected

    private view Home at "/fabric-protocol":
        box:
            text "round-trip: heartbeat={demoHeartbeatOk} register={demoRegisterOk} topology={demoTopologyOk} telemetry={demoTelemetryOk} telemetryDefaults={demoTelemetryDefaultsOk} workload={demoWorkloadOk}"
            text "encode: optimizationProposal={demoOptimizationProposalJson} rejected={demoRejectedJson}"
            text "rejection: truncated={demoTruncatedRejected} corrupt={demoCorruptRejected} unknownVariant={demoUnknownVariantRejected}"
