import "api_decl.fct"

app UploadMedia:
    # upload_media.fct — runtime/upload.go and media.go's endpoints: POST
    # /upload (one multipart file, stored under a random name with the
    # file's own safe extension, answered as its /uploads/ reference),
    # the resumable /upload/init, /upload/chunk?id=, /upload/finish?id=,
    # /upload/abort?id= (a temporary .part assembled chunk by chunk, then
    # renamed), and GET /uploads/<name> as net/http's ServeFile answers it
    # (Content-Type by extension, Last-Modified, Accept-Ranges), refused
    # for a path that leaves the directory and — when FACET_MEDIA_TTL signs
    # media — for a link whose exp/sig do not hold. The upload directory is
    # FACET_UPLOAD_DIR (an absolute path inside the sandbox, or a path
    # relative to it), else facet-uploads.
    #
    # A request's body reaches these handlers as bytes: the connection task
    # carries them beside the text body (x-facet-body-b64), and a stored
    # file leaves the same way (x-facet-body-b64 on the response), so a
    # binary payload never passes through a text conversion.
    # ── POST /upload ────────────────────────────────────────────────────
    # rtUploadedJSON: writeUploaded — the stored file's reference, and with
    # signing on the URL to render it by.
    proc rtUploadedJSON(w: RtWorld, name: text) -> HttpServerResponse:
        let ref = "/uploads/" + name
        let mut keys = ["url"]
        let mut raws = [jsonQuote(ref)]
        let grants = do rtMediaGrants(w.mediaTTL, w.signKey, textVal(ref))
        if len(grants.keys) > 0:
            keys = append(keys, "media")
            raws = append(raws, rtValJSON(grants))
        let r = do rtJSONResponse(200, rtObjectJSONRaw(keys, raws) + "\n")
        return r

    proc rtHandleUpload(w0: RtWorld, req: HttpServerRequest) -> RtHandled uses io.file:
        let mut w = w0
        if req.method != "POST":
            let m = do rtTextError(405, "POST only")
            return RtHandled{resp: m, w: w}
        let csrf = do rtCheckCSRF(w, req)
        if !csrf:
            let f = do rtTextError(403, "missing or invalid CSRF token")
            return RtHandled{resp: f, w: w}
        let body = do rtBodyBytes(req)
        let ct = do rtHeaderValue(req.headers, "content-type")
        let parts = do rtParseMultipart(ct, body)
        if len(parts) == 0 || len(body) > w.uploadCap:
            let bad = do rtTextError(400, "upload too large or malformed")
            return RtHandled{resp: bad, w: w}
        let mut at = -1
        let mut i = 0
        loop i < len(parts):
            if parts[i].name == "file" && parts[i].filename != "" && at < 0:
                at = i
            i = i + 1
        if at < 0:
            let nf = do rtTextError(400, "missing file field")
            return RtHandled{resp: nf, w: w}
        let name = rtRandomName() + rtSafeExt(parts[at].filename)
        let path = rtUploadDir(w) + "/" + name
        let wrote = writeFileAt(path, 0, parts[at].data)
        let ok = do rtUploadedJSON(w, name)
        return RtHandled{resp: ok, w: w}

    # ── the resumable endpoints ─────────────────────────────────────────
    proc rtUploadSessionIndex(w: RtWorld, id: text) -> int:
        let mut i = 0
        loop i < len(w.upIds):
            if w.upIds[i] == id:
                return i
            i = i + 1
        return -1

    proc rtDropUploadSession(w0: RtWorld, at: int) -> RtWorld:
        let mut w = w0
        w.upIds = slice(w.upIds, 0, at) + slice(w.upIds, at + 1, len(w.upIds))
        w.upNames = slice(w.upNames, 0, at) + slice(w.upNames, at + 1, len(w.upNames))
        w.upSizes = slice(w.upSizes, 0, at) + slice(w.upSizes, at + 1, len(w.upSizes))
        return w

    proc rtHandleUploadChunked(w0: RtWorld, req: HttpServerRequest) -> RtHandled uses io.file:
        let mut w = w0
        if req.method != "POST":
            let m = do rtTextError(405, "POST only")
            return RtHandled{resp: m, w: w}
        let csrf = do rtCheckCSRF(w, req)
        if !csrf:
            let f = do rtTextError(403, "missing or invalid CSRF token")
            return RtHandled{resp: f, w: w}
        let op = slice(req.path, 8, len(req.path))
        let dir = do rtUploadDir(w)
        if op == "init":
            let j = do jsonParse(req.body)
            let filename = do jStr(j, "filename")
            let id = do rtRandomName()
            let name = rtRandomName() + rtSafeExt(filename)
            let created = writeFileAt(dir + "/" + id + ".part", 0, [])
            w.upIds = append(w.upIds, id)
            w.upNames = append(w.upNames, name)
            w.upSizes = append(w.upSizes, 0)
            let r = do rtJSONResponse(200, rtObjectJSONRaw(["id"], [jsonQuote(id)]) + "\n")
            return RtHandled{resp: r, w: w}
        let id2 = do rtQueryValue(req.query, "id")
        let at = do rtUploadSessionIndex(w, id2)
        if op == "chunk":
            if at < 0:
                let u = do rtTextError(404, "unknown upload session")
                return RtHandled{resp: u, w: w}
            let body = do rtBodyBytes(req)
            let n = w.upSizes[at] + len(body)
            if len(body) > w.uploadCap || n > w.uploadTotalCap:
                w.upSizes[at] = n
                let big = do rtTextError(413, "upload too large or write failed")
                return RtHandled{resp: big, w: w}
            let wrote = writeFileAt(dir + "/" + w.upIds[at] + ".part", w.upSizes[at], body)
            w.upSizes[at] = n
            let r2 = do rtJSONResponse(200, "{\"received\":" + n + "}\n")
            return RtHandled{resp: r2, w: w}
        if op == "finish":
            if at < 0:
                let u2 = do rtTextError(404, "unknown upload session")
                return RtHandled{resp: u2, w: w}
            let name2 = w.upNames[at]
            let moved = renameFile(dir + "/" + w.upIds[at] + ".part", dir + "/" + name2)
            w = do rtDropUploadSession(w, at)
            let done = do rtUploadedJSON(w, name2)
            return RtHandled{resp: done, w: w}
        if op == "abort":
            if at >= 0:
                let gone = removeFile(dir + "/" + w.upIds[at] + ".part")
                w = do rtDropUploadSession(w, at)
            let r3 = do rtJSONResponse(200, "{\"ok\":true}\n")
            return RtHandled{resp: r3, w: w}
        let nf = do rtNotFound()
        return RtHandled{resp: nf, w: w}

    # ── GET /uploads/<name> ─────────────────────────────────────────────
    # rtMimeType: mime.TypeByExtension for the extensions a stored upload
    # has (net/http's ServeFile sniffs the rest; a text file is served as
    # text/plain; charset=utf-8).
    proc rtMimeType(ext: text) -> text:
        let hls = do rtHlsContentType(ext)
        if hls != "":
            return hls
        if ext == ".txt":
            return "text/plain; charset=utf-8"
        if ext == ".html" || ext == ".htm":
            return "text/html; charset=utf-8"
        if ext == ".css":
            return "text/css; charset=utf-8"
        if ext == ".js" || ext == ".mjs":
            return "text/javascript; charset=utf-8"
        if ext == ".json":
            return "application/json"
        if ext == ".png":
            return "image/png"
        if ext == ".jpg" || ext == ".jpeg":
            return "image/jpeg"
        if ext == ".gif":
            return "image/gif"
        if ext == ".webp":
            return "image/webp"
        if ext == ".svg":
            return "image/svg+xml"
        if ext == ".avif":
            return "image/avif"
        if ext == ".mp4":
            return "video/mp4"
        if ext == ".webm":
            return "video/webm"
        if ext == ".mp3":
            return "audio/mpeg"
        if ext == ".pdf":
            return "application/pdf"
        if ext == ".xml":
            return "text/xml; charset=utf-8"
        if ext == ".wasm":
            return "application/wasm"
        return "application/octet-stream"

    proc rtHlsContentType(ext: text) -> text:
        if ext == ".m3u8":
            return "application/vnd.apple.mpegurl"
        if ext == ".ts":
            return "video/mp2t"
        if ext == ".m4s":
            return "video/iso.segment"
        if ext == ".mpd":
            return "application/dash+xml"
        return ""

    proc rtExtOf(name: text) -> text:
        let mut i = len(name) - 1
        loop i >= 0:
            if charAt(name, i) == ".":
                return lower(slice(name, i, len(name)))
            i = i - 1
        return ""

    # rtIsIntText: strconv.ParseInt's accepted spelling — an optional sign,
    # then one or more digits.
    proc rtIsIntText(s: text) -> bool:
        let mut i = 0
        if len(s) > 0 && (charAt(s, 0) == "-" || charAt(s, 0) == "+"):
            i = 1
        if i >= len(s):
            return false
        loop i < len(s):
            let c = charAt(s, i)
            if !(c >= "0" && c <= "9"):
                return false
            i = i + 1
        return true

    # rtMediaAccessOK: mediaAccessOK — with signing on, a link must carry
    # an integer `exp` not yet passed and the signature of name:exp.
    proc rtMediaAccessOK(w: RtWorld, name: text, query: text) -> bool:
        if w.mediaTTL <= 0:
            return true
        let expT = do rtQueryValue(query, "exp")
        let num = do rtIsIntText(expT)
        if !num:
            return false
        let exp = toInt(expT)
        if nowMs() / 1000 > exp:
            return false
        let sig = do rtQueryValue(query, "sig")
        let want = do rtMediaSig(w.signKey, name, exp)
        return sig == want

    # ── ServeFile ───────────────────────────────────────────────────────
    struct RtRange:
        start: int
        length: int

    struct RtRanges:
        ok: bool
        noOverlap: bool
        ranges: [RtRange]

    # rtParseRange: net/http's parseRange — "bytes=" then comma-separated
    # ranges, each start-end, start- or -suffix; ok false is "invalid range",
    # noOverlap with no range left is "invalid range: failed to overlap".
    proc rtParseRange(s: text, size: int) -> RtRanges:
        let pre = do rtHasPrefix(s, "bytes=")
        if !pre:
            return RtRanges{ok: false, noOverlap: false, ranges: []}
        let items = split(slice(s, 6, len(s)), ",")
        let mut out = []
        let mut noOverlap = false
        let mut i = 0
        loop i < len(items):
            let ra = trim(items[i])
            if ra != "":
                let dash = do rtIndexOfText(ra, "-")
                if dash < 0:
                    return RtRanges{ok: false, noOverlap: false, ranges: []}
                let st = trim(slice(ra, 0, dash))
                let en = trim(slice(ra, dash + 1, len(ra)))
                if st == "":
                    let enOK = do rtIsDigitsOnly(en)
                    if !enOK:
                        return RtRanges{ok: false, noOverlap: false, ranges: []}
                    let mut n = toInt(en)
                    if n > size:
                        n = size
                    out = append(out, RtRange{start: size - n, length: n})
                else:
                    let stOK = do rtIsDigitsOnly(st)
                    if !stOK:
                        return RtRanges{ok: false, noOverlap: false, ranges: []}
                    let start = toInt(st)
                    if start >= size:
                        noOverlap = true
                    else:
                        if en == "":
                            out = append(out, RtRange{start: start, length: size - start})
                        else:
                            let enOK2 = do rtIsDigitsOnly(en)
                            if !enOK2 || start > toInt(en):
                                return RtRanges{ok: false, noOverlap: false, ranges: []}
                            let mut e = toInt(en)
                            if e >= size:
                                e = size - 1
                            out = append(out, RtRange{start: start, length: e - start + 1})
            i = i + 1
        if noOverlap && len(out) == 0:
            return RtRanges{ok: false, noOverlap: true, ranges: []}
        return RtRanges{ok: true, noOverlap: false, ranges: out}

    proc rtIsDigitsOnly(s: text) -> bool:
        if s == "":
            return false
        let mut i = 0
        loop i < len(s):
            let c = charAt(s, i)
            if !(c >= "0" && c <= "9"):
                return false
            i = i + 1
        return true

    # rtParseHTTPDate: http.ParseTime for the IMF-fixdate form
    # ("Mon, 02 Jan 2006 15:04:05 GMT"), -1 when it is not one.
    proc rtParseHTTPDate(s: text) -> int:
        let parts = split(trim(s), " ")
        if len(parts) != 6 || parts[5] != "GMT":
            return -1
        let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
        let mut mo = -1
        let mut i = 0
        loop i < 12:
            if months[i] == parts[2]:
                mo = i + 1
            i = i + 1
        let hms = split(parts[4], ":")
        if mo < 0 || len(hms) != 3:
            return -1
        let ok = rtIsDigitsOnly(parts[1]) && rtIsDigitsOnly(parts[3]) && rtIsDigitsOnly(hms[0]) && rtIsDigitsOnly(hms[1]) && rtIsDigitsOnly(hms[2])
        if !ok:
            return -1
        let pad = do rtPad2(toInt(parts[1]))
        let t = fromIso(parts[3] + "-" + rtPad2(mo) + "-" + pad + "T" + hms[0] + ":" + hms[1] + ":" + hms[2] + "Z")
        return t

    proc rtPad2(n: int) -> text:
        if n < 10:
            return "0" + n
        return "" + n

    proc rtHasHeader(hs: [HttpHeader], name: text) -> bool:
        let mut i = 0
        loop i < len(hs):
            if hs[i].name == name:
                return true
            i = i + 1
        return false

    # rtServeFile: http.ServeFile for a stored upload — Last-Modified,
    # If-Modified-Since (304), Range (206 / multipart/byteranges / 416),
    # Accept-Ranges and Content-Length; the body travels as bytes.
    proc rtServeFile(req: HttpServerRequest, path: text, ctype: text, extra: [HttpHeader]) -> HttpServerResponse uses io.file:
        let size = fileSize(path)
        let mtime = fileModTime(path)
        let lm = do httpServerDate(mtime)
        let mut headers = extra + [HttpHeader{name: "last-modified", value: lm}]
        # If-Modified-Since is consulted only when no If-None-Match came
        # (checkPreconditions); an upload has no ETag, so one never matches.
        let ims = do rtHeaderValue(req.headers, "if-modified-since")
        let inmHas = do rtHasHeader(req.headers, "if-none-match")
        if (req.method == "GET" || req.method == "HEAD") && ims != "" && mtime > 0 && !inmHas:
            let t = do rtParseHTTPDate(ims)
            if t >= 0 && mtime <= t:
                return HttpServerResponse{status: 304, reason: "", headers: headers, body: ""}
        headers = append(headers, HttpHeader{name: "content-type", value: ctype})
        let rangeReq = do rtHeaderValue(req.headers, "range")
        let mut ranges = []
        if rangeReq != "":
            let pr = do rtParseRange(rangeReq, size)
            if !pr.ok:
                if pr.noOverlap && size == 0:
                    ranges = []
                else:
                    let mut refused = do rtTextError(416, "invalid range")
                    if pr.noOverlap:
                        refused = do rtTextError(416, "invalid range: failed to overlap")
                        refused.headers = append(refused.headers, HttpHeader{name: "content-range", value: "bytes */" + size})
                    return refused
            else:
                ranges = pr.ranges
        let mut sum = 0
        let mut k = 0
        loop k < len(ranges):
            sum = sum + ranges[k].length
            k = k + 1
        if sum > size:
            ranges = []
        let data = readFileAt(path, 0, size)
        let mut status = 200
        let mut body = data
        if len(ranges) == 1:
            status = 206
            let ra = ranges[0]
            body = slice(data, ra.start, ra.start + ra.length)
            headers = append(headers, HttpHeader{name: "content-range", value: "bytes " + ra.start + "-" + (ra.start + ra.length - 1) + "/" + size})
        if len(ranges) > 1:
            status = 206
            let boundary = do rtHex(randomBytes(30))
            let mut out = []
            let mut r = 0
            loop r < len(ranges):
                let ra2 = ranges[r]
                let mut head = "--" + boundary + "\r\n"
                if r > 0:
                    head = "\r\n" + head
                head = head + "Content-Range: bytes " + ra2.start + "-" + (ra2.start + ra2.length - 1) + "/" + size + "\r\nContent-Type: " + ctype + "\r\n\r\n"
                out = out + textToBytes(head) + slice(data, ra2.start, ra2.start + ra2.length)
                r = r + 1
            out = out + textToBytes("\r\n--" + boundary + "--\r\n")
            body = out
            headers = do rtWithoutHeader(headers, "content-type")
            headers = append(headers, HttpHeader{name: "content-type", value: "multipart/byteranges; boundary=" + boundary})
        headers = append(headers, HttpHeader{name: "accept-ranges", value: "bytes"})
        headers = append(headers, HttpHeader{name: "x-facet-body-b64", value: base64UrlRaw(body)})
        return HttpServerResponse{status: status, reason: "", headers: headers, body: ""}

    proc rtWithoutHeader(hs: [HttpHeader], name: text) -> [HttpHeader]:
        let mut out = []
        let mut i = 0
        loop i < len(hs):
            if hs[i].name != name:
                out = append(out, hs[i])
            i = i + 1
        return out

    # rtServeHLSPlaylist: serveHLSPlaylist — with signing on, every URI line
    # of the playlist signed (one expiry for the whole answer).
    proc rtServeHLSPlaylist(w: RtWorld, path: text) -> HttpServerResponse uses io.file:
        let exists = fileExists(path)
        if !exists:
            let nf = do rtNotFound()
            return nf
        let src = readFile(path)
        let headers = [HttpHeader{name: "content-type", value: "application/vnd.apple.mpegurl"}]
        if w.mediaTTL <= 0:
            return HttpServerResponse{status: 200, reason: "", headers: headers, body: src}
        let exp = nowMs() / 1000 + w.mediaTTL
        let lines = split(src, "\n")
        let mut out = []
        let mut i = 0
        loop i < len(lines):
            let t = trim(lines[i])
            let tag = do rtHasPrefix(t, "#")
            if t == "" || tag:
                out = append(out, lines[i])
            else:
                let sig = do rtMediaSig(w.signKey, t, exp)
                out = append(out, t + "?exp=" + exp + "&sig=" + sig)
            i = i + 1
        return HttpServerResponse{status: 200, reason: "", headers: headers, body: rtJoinTexts(out, "\n")}

    proc rtHandleUploads(w0: RtWorld, req: HttpServerRequest) -> RtHandled uses io.file:
        let mut w = w0
        let name = slice(req.path, 9, len(req.path))
        let sl = do rtIndexOfText(name, "/")
        let bsl = do rtIndexOfText(name, "\\")
        let dd = do rtIndexOfText(name, "..")
        if name == "" || sl >= 0 || bsl >= 0 || dd >= 0:
            let nf = do rtNotFound()
            return RtHandled{resp: nf, w: w}
        let ok = do rtMediaAccessOK(w, name, req.query)
        if !ok:
            let fb = do rtTextError(403, "expired or invalid media link")
            return RtHandled{resp: fb, w: w}
        let path = rtUploadDir(w) + "/" + name
        let ext = do rtExtOf(name)
        if ext == ".m3u8":
            let pl = do rtServeHLSPlaylist(w, path)
            return RtHandled{resp: pl, w: w}
        let exists = fileExists(path)
        if !exists:
            let nf2 = do rtNotFound()
            return RtHandled{resp: nf2, w: w}
        let served = do rtServeFile(req, path, rtMimeType(ext), [])
        return RtHandled{resp: served, w: w}
