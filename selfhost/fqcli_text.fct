app FqCliText:
    # fqcli_text.fct — generated from the Rust facetql binary's own output
    # (`facetql <command> --help` / `-h`, and `facetql routes --json`), the
    # clap-rendered help screens and the api::routes::ROUTES matrix that
    # fqcli.fct prints. `[env: NAME={NAME}]` marks where clap shows a
    # variable's current value. Regenerate rather than edit.

    # fqcHelpText: the long help (`--help`, `help <command>`) of a command
    # path ("" is the top level), or its short help (`-h`) when short.
    proc fqcHelpText(path: text, short: bool) -> text:
        if path == "":
            return "FacetQL — a standalone, coordinate-native database server\n\nUsage: facetql [OPTIONS] [COMMAND]\n\nCommands:\n  init       Create the data directory and exit\n  start      Start the server. Also what running `facetql` with no subcommand does, for backward compatibility\n  backup     Copy every data file to `output_dir`, for offline backup — the same underlying idea as `pg_basebackup`: copy the files, don't touch a running server's writes. Run this against a data directory that ISN'T currently being written to by a live `facetql start` — this does a plain file copy, not a consistent-snapshot-of-a-live-server backup (that's a real, harder feature — see SECURITY_NOTES.md)\n  restore    Restore data files from a directory created by `backup` into the configured data directory. Refuses to run if the target data directory already has data in it, to avoid silently clobbering something — move/rename the existing directory first if that's really what you want\n  user       Manage identities (admin only). Talks to a *running* server over its API — start the server first\n  index      Manage secondary indexes over node `data` fields (admin only). Talks to a *running* server over its API — start the server first\n  reference  Manage references between kinds — cascade, restrict and set-null on delete (admin only). Talks to a *running* server over its API — start the server first\n  get        Fetch a single node by address\n  put        Write a node at a client-supplied address\n  delete     Delete a node by address. Destructive — asks to confirm\n  query      Query nodes of a kind (native predicate query — no SQL)\n  stats      Show node counts per kind, for the supplied token's view\n  routes     Print the per-endpoint authorization matrix this build enforces: every route, who may call it, what it costs, and the per-object rule its handler applies. Offline — no server, no token\n  help       Print this message or the help of the given subcommand(s)\n\nOptions:\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n  -V, --version              Print version\n"
        if path == "init":
            return "Create the data directory and exit\n\nUsage: facetql init [OPTIONS]\n\nOptions:\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "start":
            return "Start the server. Also what running `facetql` with no subcommand does, for backward compatibility\n\nUsage: facetql start [OPTIONS]\n\nOptions:\n      --port <PORT>\n          [env: FACETQL_PORT={FACETQL_PORT}] [default: 8080]\n      --tls-identity <TLS_IDENTITY>\n          Path to a PKCS#12 (.p12/.pfx) file containing both the TLS certificate and private key. If set (along with --tls-cert-password), the server speaks HTTPS instead of HTTP. Generate a dev one with: `openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes -subj \"/CN=localhost\"` `openssl pkcs12 -export -out identity.p12 -inkey key.pem -in cert.pem -passout pass:<password>` [env: FACETQL_TLS_IDENTITY={FACETQL_TLS_IDENTITY}]\n      --tls-identity-password <TLS_IDENTITY_PASSWORD>\n          Password for the PKCS#12 file above [env: FACETQL_TLS_IDENTITY_PASSWORD={FACETQL_TLS_IDENTITY_PASSWORD}]\n      --data-dir <DATA_DIR>\n          Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help\n          Print help\n"
        if path == "backup":
            return "Copy every data file to `output_dir`, for offline backup — the same underlying idea as `pg_basebackup`: copy the files, don't touch a running server's writes. Run this against a data directory that ISN'T currently being written to by a live `facetql start` — this does a plain file copy, not a consistent-snapshot-of-a-live-server backup (that's a real, harder feature — see SECURITY_NOTES.md)\n\nUsage: facetql backup [OPTIONS] <OUTPUT_DIR>\n\nArguments:\n  <OUTPUT_DIR>  \n\nOptions:\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "restore":
            return "Restore data files from a directory created by `backup` into the configured data directory. Refuses to run if the target data directory already has data in it, to avoid silently clobbering something — move/rename the existing directory first if that's really what you want\n\nUsage: facetql restore [OPTIONS] <INPUT_DIR>\n\nArguments:\n  <INPUT_DIR>  \n\nOptions:\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "user":
            return "Manage identities (admin only). Talks to a *running* server over its API — start the server first\n\nUsage: facetql user [OPTIONS] <COMMAND>\n\nCommands:\n  create  Create an identity and print its generated token exactly once\n  list    List persistent identities\n  delete  Revoke every persistent record for an owner. Destructive\n  help    Print this message or the help of the given subcommand(s)\n\nOptions:\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "user create":
            return "Create an identity and print its generated token exactly once\n\nUsage: facetql user create [OPTIONS] <OWNER>\n\nArguments:\n  <OWNER>  Owner name the new token authenticates as\n\nOptions:\n      --admin                Grant the Admin role (bypasses ownership like a superuser)\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "user list":
            return "List persistent identities\n\nUsage: facetql user list [OPTIONS]\n\nOptions:\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "user delete":
            return "Revoke every persistent record for an owner. Destructive\n\nUsage: facetql user delete [OPTIONS] <OWNER>\n\nArguments:\n  <OWNER>  Owner whose token(s) to revoke\n\nOptions:\n      --yes                  Skip the interactive confirmation prompt\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "index":
            return "Manage secondary indexes over node `data` fields (admin only). Talks to a *running* server over its API — start the server first\n\nUsage: facetql index [OPTIONS] <COMMAND>\n\nCommands:\n  create  Declare an index over one `data` field of one kind\n  list    List every declared index\n  drop    Drop a declared index, of either kind\n  help    Print this message or the help of the given subcommand(s)\n\nOptions:\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "index create" && short:
            return "Declare an index over one `data` field of one kind\n\nUsage: facetql index create [OPTIONS] --kind <KIND> --field <FIELD> <NAME>\n\nArguments:\n  <NAME>  Index name. Letters, digits, '_' and '-' only (max 64 bytes) — it becomes a filename\n\nOptions:\n      --kind <KIND>          Node kind the index covers. An index is per-kind because `data` has no schema across kinds\n      --field <FIELD>        Top-level `data` field to keep ordered — the same name you would pass to `query --order`\n      --unique               Refuse any write that would give two nodes of this kind the same value for this field\n      --text                 Build an inverted index over the field's *text* instead of an ordered index over its value\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help (see more with '--help')\n"
        if path == "index create":
            return "Declare an index over one `data` field of one kind.\n\nBackfilling reads every existing node of the kind once, so this costs the size of the kind — run it when that's affordable, not blindly in a hot path. Re-declaring the identical index is a successful no-op, so a setup script may run twice.\n\nUsage: facetql index create [OPTIONS] --kind <KIND> --field <FIELD> <NAME>\n\nArguments:\n  <NAME>\n          Index name. Letters, digits, '_' and '-' only (max 64 bytes) — it becomes a filename\n\nOptions:\n      --kind <KIND>\n          Node kind the index covers. An index is per-kind because `data` has no schema across kinds\n\n      --field <FIELD>\n          Top-level `data` field to keep ordered — the same name you would pass to `query --order`\n\n      --unique\n          Refuse any write that would give two nodes of this kind the same value for this field.\n          \n          A constraint, not a hint: it is checked inside the writer lock ahead of the WAL, so two callers racing for one value cannot both win. Declaring it over data that already holds a duplicate is refused rather than silently created false — and it is also what a reference by `--parent-field` resolves through, since a value two nodes can hold names neither.\n\n      --text\n          Build an inverted index over the field's *text* instead of an ordered index over its value.\n          \n          This is the index a search box needs. Without it, `contains(field, q)` reads every node of the kind, decodes its JSON and tests it; with it, the server reads only the rows whose text holds every three-byte window of `q` and tests those. The answer is identical either way — the index narrows which rows are read, it never decides which ones match — so declaring or dropping it changes only the cost.\n          \n          It serves `contains`, `starts_with` and `ends_with`, since all three are substring tests. It cannot be `--unique`: it stores windows of a value, not the value.\n\n      --url <URL>\n          FacetQL server URL. Falls back to FACETQL_URL, then localhost\n          \n          [env: FACETQL_URL={FACETQL_URL}]\n          [default: http://localhost:8080]\n\n      --token <TOKEN>\n          Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history\n          \n          [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n\n      --json\n          Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n\n      --data-dir <DATA_DIR>\n          Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR\n          \n          [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n\n  -h, --help\n          Print help (see a summary with '-h')\n"
        if path == "index list":
            return "List every declared index\n\nUsage: facetql index list [OPTIONS]\n\nOptions:\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "index drop" && short:
            return "Drop a declared index, of either kind\n\nUsage: facetql index drop [OPTIONS] <NAME>\n\nArguments:\n  <NAME>  Name of the index to drop\n\nOptions:\n      --yes                  Skip the interactive confirmation prompt\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help (see more with '--help')\n"
        if path == "index drop":
            return "Drop a declared index, of either kind.\n\nNever breaks a query: one that was being served by this index falls back to the scan it used before the index existed — the materialize-and-sort path for an ordered index, the row-by-row substring test for a text one. It is still gated behind a confirmation like the other removals, because rebuilding costs another full read of the kind.\n\nUsage: facetql index drop [OPTIONS] <NAME>\n\nArguments:\n  <NAME>\n          Name of the index to drop\n\nOptions:\n      --yes\n          Skip the interactive confirmation prompt\n\n      --url <URL>\n          FacetQL server URL. Falls back to FACETQL_URL, then localhost\n          \n          [env: FACETQL_URL={FACETQL_URL}]\n          [default: http://localhost:8080]\n\n      --token <TOKEN>\n          Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history\n          \n          [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n\n      --json\n          Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n\n      --data-dir <DATA_DIR>\n          Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR\n          \n          [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n\n  -h, --help\n          Print help (see a summary with '-h')\n"
        if path == "reference":
            return "Manage references between kinds — cascade, restrict and set-null on delete (admin only). Talks to a *running* server over its API — start the server first\n\nUsage: facetql reference [OPTIONS] <COMMAND>\n\nCommands:\n  create  Declare a reference between two kinds\n  list    List every declared reference\n  drop    Drop a declared reference\n  help    Print this message or the help of the given subcommand(s)\n\nOptions:\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "reference create" && short:
            return "Declare a reference between two kinds\n\nUsage: facetql reference create [OPTIONS] --kind <KIND> --field <FIELD> --parent-kind <PARENT_KIND> --on-delete <ON_DELETE> <NAME>\n\nArguments:\n  <NAME>  Reference name. Letters, digits, '_' and '-' only (max 64 bytes) — it becomes a URL path segment\n\nOptions:\n      --kind <KIND>                  The kind that holds the reference — the child\n      --field <FIELD>                The `data` field on that kind carrying the referenced node's key. Null or absent in a row means it references nothing, which is always allowed\n      --parent-kind <PARENT_KIND>    The kind being referenced — the parent\n      --parent-field <PARENT_FIELD>  The parent's `data` field the value matches. Omit — the usual case — to reference the parent's address\n      --on-delete <ON_DELETE>        What deleting the parent does: `cascade` removes the referencing nodes too, `restrict` refuses the delete while any remain, `set-null` clears the field and keeps them [possible values: cascade, restrict, set-null]\n      --url <URL>                    FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>                Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                         Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>          Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                         Print help (see more with '--help')\n"
        if path == "reference create":
            return "Declare a reference between two kinds.\n\nRefused unless the access paths that make it cheap already exist: an index over `<kind>.<field>`, and — when `--parent-field` is given — a *unique* index over `<parent-kind>.<parent-field>`. Also refused when the data already breaks the rule, because a constraint that is false the moment it is created is worse than no constraint.\n\nUsage: facetql reference create [OPTIONS] --kind <KIND> --field <FIELD> --parent-kind <PARENT_KIND> --on-delete <ON_DELETE> <NAME>\n\nArguments:\n  <NAME>\n          Reference name. Letters, digits, '_' and '-' only (max 64 bytes) — it becomes a URL path segment\n\nOptions:\n      --kind <KIND>\n          The kind that holds the reference — the child\n\n      --field <FIELD>\n          The `data` field on that kind carrying the referenced node's key. Null or absent in a row means it references nothing, which is always allowed\n\n      --parent-kind <PARENT_KIND>\n          The kind being referenced — the parent\n\n      --parent-field <PARENT_FIELD>\n          The parent's `data` field the value matches. Omit — the usual case — to reference the parent's address\n\n      --on-delete <ON_DELETE>\n          What deleting the parent does: `cascade` removes the referencing nodes too, `restrict` refuses the delete while any remain, `set-null` clears the field and keeps them\n          \n          [possible values: cascade, restrict, set-null]\n\n      --url <URL>\n          FacetQL server URL. Falls back to FACETQL_URL, then localhost\n          \n          [env: FACETQL_URL={FACETQL_URL}]\n          [default: http://localhost:8080]\n\n      --token <TOKEN>\n          Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history\n          \n          [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n\n      --json\n          Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n\n      --data-dir <DATA_DIR>\n          Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR\n          \n          [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n\n  -h, --help\n          Print help (see a summary with '-h')\n"
        if path == "reference list":
            return "List every declared reference\n\nUsage: facetql reference list [OPTIONS]\n\nOptions:\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "reference drop" && short:
            return "Drop a declared reference\n\nUsage: facetql reference drop [OPTIONS] <NAME>\n\nArguments:\n  <NAME>  Name of the reference to drop\n\nOptions:\n      --yes                  Skip the interactive confirmation prompt\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help (see more with '--help')\n"
        if path == "reference drop":
            return "Drop a declared reference.\n\nThe rows it governed are untouched; what stops is the enforcement, so a later delete of a referenced node leaves whatever pointed at it behind. Confirmed like the other removals because that consequence is silent.\n\nUsage: facetql reference drop [OPTIONS] <NAME>\n\nArguments:\n  <NAME>\n          Name of the reference to drop\n\nOptions:\n      --yes\n          Skip the interactive confirmation prompt\n\n      --url <URL>\n          FacetQL server URL. Falls back to FACETQL_URL, then localhost\n          \n          [env: FACETQL_URL={FACETQL_URL}]\n          [default: http://localhost:8080]\n\n      --token <TOKEN>\n          Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history\n          \n          [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n\n      --json\n          Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n\n      --data-dir <DATA_DIR>\n          Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR\n          \n          [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n\n  -h, --help\n          Print help (see a summary with '-h')\n"
        if path == "get":
            return "Fetch a single node by address\n\nUsage: facetql get [OPTIONS] <ADDRESS>\n\nArguments:\n  <ADDRESS>  Node address to fetch\n\nOptions:\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "put":
            return "Write a node at a client-supplied address\n\nUsage: facetql put [OPTIONS] --kind <KIND> --data <DATA> <ADDRESS>\n\nArguments:\n  <ADDRESS>  Node address to write (client-supplied; coordinate defaults to 0)\n\nOptions:\n      --kind <KIND>          Entity kind, e.g. \"Client\", \"Goal\"\n      --data <DATA>          Node payload as a JSON document. Stored opaquely by the server\n      --public               Make the node readable by any authenticated identity\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "delete":
            return "Delete a node by address. Destructive — asks to confirm\n\nUsage: facetql delete [OPTIONS] <ADDRESS>\n\nArguments:\n  <ADDRESS>  Node address to delete\n\nOptions:\n      --yes                  Skip the interactive confirmation prompt\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "query":
            return "Query nodes of a kind (native predicate query — no SQL)\n\nUsage: facetql query [OPTIONS] --kind <KIND>\n\nOptions:\n      --kind <KIND>          Entity kind to query (native predicate query; no SQL)\n      --limit <LIMIT>        Maximum rows to return (server caps at 500)\n      --order <ORDER>        Field within each node's `data` to order by\n      --desc                 Order descending instead of ascending\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "stats":
            return "Show node counts per kind, for the supplied token's view\n\nUsage: facetql stats [OPTIONS]\n\nOptions:\n      --url <URL>            FacetQL server URL. Falls back to FACETQL_URL, then localhost [env: FACETQL_URL={FACETQL_URL}] [default: http://localhost:8080]\n      --token <TOKEN>        Admin API token (x-api-key). Falls back to FACETQL_TOKEN. Prefer the env var so the token never lands in shell history [env: FACETQL_TOKEN={FACETQL_TOKEN}]\n      --json                 Emit raw JSON (as the server returned it) instead of the human-readable default. Applies to read commands\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        if path == "routes":
            return "Print the per-endpoint authorization matrix this build enforces: every route, who may call it, what it costs, and the per-object rule its handler applies. Offline — no server, no token\n\nUsage: facetql routes [OPTIONS]\n\nOptions:\n      --json                 Emit JSON instead of the aligned table\n      --data-dir <DATA_DIR>  Where data files live. Defaults to ~/.facetql if unset. Also settable via FACETQL_DATA_DIR [env: FACETQL_DATA_DIR={FACETQL_DATA_DIR}]\n  -h, --help                 Print help\n"
        return ""

    # FqcRoute: one api::routes::RouteSpec as `facetql routes` reports it —
    # the caller class, the cost class, and the per-object rule with its
    # whitespace collapsed.
    struct FqcRoute:
        method: text
        path: text
        caller: text
        cost: text
        rule: text

    proc fqcRoutes() -> [FqcRoute]:
        let mut rs = []
        rs = append(rs, FqcRoute{method: "GET", path: "/", caller: "anonymous", cost: "read", rule: "none — a constant liveness string, no state read"})
        rs = append(rs, FqcRoute{method: "POST", path: "/node", caller: "authenticated", cost: "write", rule: "can_write on the node being replaced, if one exists; a fresh address is unrestricted; admin bypasses"})
        rs = append(rs, FqcRoute{method: "GET", path: "/node/:address", caller: "authenticated", cost: "read", rule: "can_read on the node; admin bypasses"})
        rs = append(rs, FqcRoute{method: "GET", path: "/node/:address/history", caller: "authenticated", cost: "read", rule: "can_read on the node's CURRENT value; admin bypasses"})
        rs = append(rs, FqcRoute{method: "PUT", path: "/node/:address", caller: "authenticated", cost: "write", rule: "can_write on the node; admin bypasses"})
        rs = append(rs, FqcRoute{method: "DELETE", path: "/node/:address", caller: "authenticated", cost: "write", rule: "can_write on the node; admin bypasses"})
        rs = append(rs, FqcRoute{method: "GET", path: "/node/:address/owned", caller: "authenticated", cost: "read", rule: "can_read on the subject node, and the listing is filtered to what the caller may read; admin bypasses"})
        rs = append(rs, FqcRoute{method: "POST", path: "/node/:address/claim", caller: "authenticated", cost: "write", rule: "can_write on the node — a claim writes claimed_by and archives the previous value; admin bypasses"})
        rs = append(rs, FqcRoute{method: "GET", path: "/nodes", caller: "authenticated", cost: "read", rule: "results filtered by can_read; admin sees every match"})
        rs = append(rs, FqcRoute{method: "POST", path: "/sequence/:name/next", caller: "authenticated", cost: "write", rule: "can_write on the sequence node; admin bypasses"})
        rs = append(rs, FqcRoute{method: "POST", path: "/nodes/multiget", caller: "authenticated", cost: "bulk", rule: "results filtered by can_read; admin sees every named node"})
        rs = append(rs, FqcRoute{method: "POST", path: "/nodes/query", caller: "authenticated", cost: "bulk", rule: "results filtered by can_read; admin sees every match"})
        rs = append(rs, FqcRoute{method: "POST", path: "/nodes/count", caller: "authenticated", cost: "bulk", rule: "counts only rows can_read admits; admin counts every match"})
        rs = append(rs, FqcRoute{method: "POST", path: "/nodes/count_by", caller: "authenticated", cost: "bulk", rule: "counts only rows can_read admits; admin counts every match"})
        rs = append(rs, FqcRoute{method: "POST", path: "/nodes/aggregate", caller: "authenticated", cost: "bulk", rule: "aggregates only rows can_read admits; admin sees every match"})
        rs = append(rs, FqcRoute{method: "POST", path: "/nodes/aggregate_by", caller: "authenticated", cost: "bulk", rule: "aggregates only rows can_read admits; admin sees every match"})
        rs = append(rs, FqcRoute{method: "POST", path: "/edge", caller: "authenticated", cost: "write", rule: "can_write on `from` and can_read on `to`; admin bypasses"})
        rs = append(rs, FqcRoute{method: "DELETE", path: "/edge", caller: "authenticated", cost: "write", rule: "Edge::can_write on the stored edge; admin bypasses"})
        rs = append(rs, FqcRoute{method: "POST", path: "/transaction", caller: "authenticated", cost: "bulk", rule: "per op: insert_node/set_if need can_write on what they replace and insert_node's owner/claimed_by are admin-only (403 for anyone else, whole batch refused), delete_node needs can_write, delete_edge needs Edge::can_write, insert_edge needs can_write on `from` and can_read on `to`, clear_kind/delete_where select only writable nodes; admin bypasses each"})
        rs = append(rs, FqcRoute{method: "GET", path: "/node/:address/edges/out", caller: "authenticated", cost: "read", rule: "can_read on the node; admin bypasses"})
        rs = append(rs, FqcRoute{method: "GET", path: "/node/:address/edges/in", caller: "authenticated", cost: "read", rule: "can_read on the node; admin bypasses"})
        rs = append(rs, FqcRoute{method: "GET", path: "/events", caller: "authenticated", cost: "subscribe", rule: "the stream is filtered by Audience::admits, so a subscriber sees only its own owner's events; admin sees every event. `?after=` replays under the same filter — a resume is never a way to read events a live subscription would have withheld"})
        rs = append(rs, FqcRoute{method: "GET", path: "/changes", caller: "authenticated", cost: "bulk", rule: "every change is filtered by Audience::admits — derived from the inserted node, or for a delete from the archived state it removed — so a caller sees only changes to nodes can_read would have shown it; a delete with no archive to attribute it is withheld from everyone; admin sees every change"})
        rs = append(rs, FqcRoute{method: "POST", path: "/publish", caller: "authenticated", cost: "write", rule: "audience is the caller's own owner; admin publishes to everyone"})
        rs = append(rs, FqcRoute{method: "POST", path: "/admin/users", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "GET", path: "/admin/users", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "DELETE", path: "/admin/users/:owner", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "POST", path: "/admin/indexes", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "GET", path: "/admin/indexes", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "DELETE", path: "/admin/indexes/:name", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "POST", path: "/admin/references", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "GET", path: "/admin/references", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "DELETE", path: "/admin/references/:name", caller: "admin", cost: "admin", rule: "none beyond the role"})
        rs = append(rs, FqcRoute{method: "GET", path: "/stats", caller: "admin", cost: "admin", rule: "none beyond the role — the counts are fleet-wide"})
        return rs
