import "fabricd_lib.fct"

app Fabricd:
    # fabricd — main.rs: `facet exec fabricd.fct --config fabric.json`. The
    # process is fabricd_lib.fct's; this is the command: the arguments and
    # the configuration (fabricdArguments, a read grant for the named configuration, fabricdConfigure), then Daemon::start with the live
    # telemetry source — FacetQL's own `/stats` (lib.rs facetql_telemetry)
    # — and the exit status that run ends with.
    proc main(args: [text]) -> int uses io.net, io.net.listen, io.file, io.env, io.console:
        let named = do fabricdArguments(args)
        if named.kind == "exit":
            return named.code
        let granted = grantRead(named.path)
        let start = do fabricdConfigure(named.path)
        if start.kind == "exit":
            return start.code
        let exit = channel()
        detach fabricdRun(start.settings, daemonFacetqlTelemetry(start.settings), exit)
        let code = recv(exit)
        return toInt(code)
