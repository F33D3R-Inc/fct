import "fabric_daemon_control.fct"
import "fabric_daemon_admin.fct"
import "fabric_frontdoor.fct"
import "http_server.fct"

app Fabricd:
    # fabricd — the Fabric control plane as a running process: a port of
    # fabric/crates/fabric-daemon/src/main.rs and daemon.rs, run as a
    # command (`facet exec fabricd.fct --config fabric.json`).
    #
    # main.rs: the arguments (--config / -c, FABRIC_CONFIG, --help,
    # --version, the usage text), the configuration loaded and resolved,
    # exit 78 (EX_CONFIG) for anything refused before serving, 0 for a clean
    # shutdown and 75 (EX_TEMPFAIL) when the drain left an action past its
    # cutover — the same stdout, stderr and exit status as the crate's
    # binary (fabric_daemon_test.go runs both).
    #
    # daemon.rs, in its order: both listeners bound first; the control plane
    # boots (placement map bootstrapped — the durable store read or seeded —
    # every backend registered) and runs one full cycle, so liveness is
    # established before the data port accepts anything; the front door is
    # installed with the routing table that cycle published; only then is
    # anything served. SIGTERM or SIGINT starts the shutdown: the data port
    # stops taking connections, the control loop drains (rollbacks, cycles
    # on the drain's cadence until nothing runs or the budget is spent), and
    # the report is printed as main.rs prints it.
    #
    # The concurrency: main is the one place a task is started from. It
    # starts the control loop (the only thing that touches the runtime,
    # taking cadence ticks, operator questions and mover reports from ONE
    # channel, as the Rust loop's `select!` does), the ticker, one accept
    # loop per port and the signal watcher; everything else arrives on
    # main's dispatch channel — an accepted connection (served on its own
    # detached handler), a copy the loop wants started (mover.rs `copy`), a
    # signal, the drain's report.
    #
    # What the two planes share, as in the crate: the front door's fleet
    # (fdPublishRouting) and the status snapshot (fabricdSnapshot, swapped
    # whole once per cycle). Nothing else.
    #
    # Named differences, each the runtime's:
    #   * a listener cannot be closed, so after the signal the data port
    #     still accepts and closes each new connection at once rather than
    #     refusing it; a copy the loop stops ends at its next report.
    #   * readFile is sandboxed to the data directory (the directory
    #     fabricd is run from, or FACET_DATA_DIR), so --config names a file
    #     inside it; and a failed bind aborts rather than answering 78.

    shared fabricdSettings: DaemonSettings
    shared fabricdSnapshot: DaemonStatus
    shared fabricdRequests: int
    shared fabricdDispatch: int
    shared fabricdStopping: bool

    proc fabricdSep() -> text:
        return bytesToText([31])

    # lib.rs now_ms(): wall-clock epoch milliseconds.
    proc fabricdNowMs() -> int:
        return nowMs()

    proc fabricdUsage() -> text:
        return "fabricd -- the Fabric control plane, with FacetQL's front door on its data port\n\nUSAGE:\n    fabricd --config <file>\n\nOPTIONS:\n    -c, --config <file>  Configuration (JSON). Also FABRIC_CONFIG.\n    -h, --help           Show help\n    -V, --version        Show version\n\nThe configuration names every secret by environment variable and holds none of\nthem. The admin token (FABRIC_ADMIN_TOKEN unless the file says otherwise) is\nrequired: the operator port is stateful and is never served unauthenticated.\n"

    # main.rs `parse`: kind "help" / "version" (answered, exit 0), "error"
    # (message), or "path".
    struct FabricdArgs:
        kind: text
        value: text

    proc fabricdParseArgs(args: [text], envSet: bool, envPath: text) -> FabricdArgs:
        let mut has = envSet
        let mut path = envPath
        let n = len(args)
        let mut i = 0
        loop i < n:
            let a = args[i]
            if a == "-h" || a == "--help":
                return FabricdArgs{kind: "help", value: ""}
            if a == "-V" || a == "--version":
                return FabricdArgs{kind: "version", value: ""}
            if a == "-c" || a == "--config":
                i = i + 1
                if i >= n:
                    return FabricdArgs{kind: "error", value: "--config expects a file"}
                has = true
                path = args[i]
            else:
                return FabricdArgs{kind: "error", value: "unexpected argument '" + a + "'"}
            i = i + 1
        if !has:
            return FabricdArgs{kind: "error", value: "no configuration: pass --config <file> or set FABRIC_CONFIG"}
        return FabricdArgs{kind: "path", value: path}

    # ------------------------------------------------------------ boot

    proc fabricdFrontDoorConfig(s: DaemonSettings) -> FdConfig:
        let base = do fdConfigDefault(s.dataListen.port)
        let mut code = 0
        if s.readPreference.kind == "AnyFresh":
            code = 1
        if s.readPreference.kind == "PreferRegion":
            code = 2
        if s.readPreference.kind == "AnyCopy":
            code = 3
        return FdConfig{readPref: PlanReadPreference{code: code, region: s.readPreference.region}, fenceRetryBudgetMs: base.fenceRetryBudgetMs, fenceRetryIntervalMs: base.fenceRetryIntervalMs, upstreamTimeoutMs: base.upstreamTimeoutMs, maxBodyBytes: base.maxBodyBytes, port: base.port}

    proc fabricdFleet(s: DaemonSettings, routing: TableRoutingTable) -> FdFleetResult:
        let mut backends = []
        let n = len(s.backends)
        let mut k = 0
        loop k < n:
            let b = do fdBackendNew(s.backends[k].id, s.backends[k].url)
            backends = append(backends, b.backend)
            k = k + 1
        let ks = s.keyspace.packed
        let fleet = do fdFleetNew(PlanKeyspace{rules: ks.rules, hasFallback: ks.hasFallback, fallbackKey: ks.fallbackKey}, backends, routing)
        return fleet

    # Settings::load: the file read and resolved against the process
    # environment, or ConfigError's Display.
    proc fabricdLoad(path: text) -> DaemonSettingsResult uses io.file, io.env:
        let mut exists = false
        if path != "":
            exists = fileExists(path)
        if !exists:
            return DaemonSettingsResult{ok: false, err: daemonReadErrorText(path, "No such file or directory (os error 2)"), settings: dcEmptySettings()}
        let src = readFile(path)
        let parsed = do daemonParseConfig(src)
        if !parsed.ok:
            return DaemonSettingsResult{ok: false, err: daemonParseErrorText(path, parsed.err), settings: dcEmptySettings()}
        let file = parsed.file
        let mut names = []
        let mut values = []
        if envSet(file.adminTokenEnv):
            names = append(names, file.adminTokenEnv)
            values = append(values, envVar(file.adminTokenEnv))
        let nb = len(file.backends)
        let mut k = 0
        loop k < nb:
            if file.backends[k].hasTokenEnv && envSet(file.backends[k].tokenEnv):
                names = append(names, file.backends[k].tokenEnv)
                values = append(values, envVar(file.backends[k].tokenEnv))
            k = k + 1
        let resolved = do daemonResolveSettings(file, daemonEnvOf(names, values))
        return resolved

    struct FabricdBooted:
        err: text
        control: DaemonControl
        telemetry: DaemonTelemetry

    # ControlPlane::boot and the rest of Daemon::start before serving: the
    # placement map bootstrapped, the first cycle run, the front door
    # installed with that cycle's routing.
    proc fabricdBoot(settings: DaemonSettings) -> FabricdBooted uses io.net:
        let telemetry = do daemonFacetqlTelemetry(settings)
        let boot = do daemonBootstrapPlacement(settings)
        let blank = do daemonControlNew(settings, "", 0, daemonBootstrapDeclared(settings))
        if !boot.ok:
            return FabricdBooted{err: boot.err, control: blank, telemetry: telemetry}
        let started = do fabricdNowMs()
        let control = do daemonControlNew(settings, daemonTelemetryDescribe(telemetry), started, boot)
        let cycled = do fabricdCycle(control, telemetry)
        let fleet = do fabricdFleet(settings, cycled.control.doorRouting)
        if !fleet.ok:
            return FabricdBooted{err: fleet.err, control: blank, telemetry: telemetry}
        do fdInstall(fabricdFrontDoorConfig(settings), fleet.fleet)
        fabricdSnapshot = cycled.control.status
        return FabricdBooted{err: "", control: cycled.control, telemetry: cycled.telemetry}

    # ------------------------------------------------------------ the cycle

    # A cycle's outcome; `published` says the front door must be handed
    # `routing` (the caller does, once the door is installed).
    struct FabricdCycled:
        control: DaemonControl
        telemetry: DaemonTelemetry
        published: bool
        routing: TableRoutingTable

    # ControlPlane::cycle with its I/O: probe and poll when due, publish the
    # routing table to the front door when it moved, persist, copies started
    # by the mover daemon.
    proc fabricdCycle(c0: DaemonControl, t0: DaemonTelemetry) -> FabricdCycled uses io.net:
        let now = do fabricdNowMs()
        let mut c = do daemonControlTickClock(c0, now)
        let mut t = t0
        let probeDue = do daemonControlProbeDue(c, now)
        if probeDue:
            let targets = do daemonControlProbeTargets(c)
            let probes = do daemonSweep(targets, c.settings.probeTimeoutMs)
            let mut ids = []
            let mut k = 0
            loop k < len(targets):
                ids = append(ids, targets[k].id)
                k = k + 1
            c = daemonControlApplyProbes(c, now, ids, probes)
        let pollDue = do daemonControlPollDue(c, now)
        if pollDue:
            let sampled = do daemonTelemetrySample(t)
            t = sampled.telemetry
            c = daemonControlApplySample(c, now, sampled.sample)
        let middle = do daemonControlCycleMiddle(c, fabricdNowMs())
        c = middle.control
        do fabricdStartCopies(middle.starts)
        c = daemonControlPersist(c)
        c = daemonControlFinishCycle(c, now)
        return FabricdCycled{control: c, telemetry: t, published: middle.published, routing: middle.routing}

    # Hand each copy the loop decided on to the mover daemon.
    proc fabricdStartCopies(starts: [DaemonCopyStart]):
        let sep = do fabricdSep()
        let copies = fabricdDispatch
        let n = len(starts)
        let mut k = 0
        loop k < n:
            let s = starts[k]
            let sent = send(copies, "copy" + sep + s.id + sep + s.source.dbmsId + sep + s.destination.dbmsId + sep + s.target.shardId + sep + s.target.coordinate.x + sep + s.target.coordinate.y)
            k = k + 1

    # ------------------------------------------------------------ the loop

    # One operator question or mover report, answered on its reply channel
    # (none for a progress ping), and applied as control.rs `serve` does.
    proc fabricdServe(c0: DaemonControl, fields: [text]) -> DaemonControl uses io.net:
        let now = do fabricdNowMs()
        let mut c = c0
        let kind = fields[0]
        if kind == "abort":
            let answered = do daemonControlAbort(c, toInt(fields[1]))
            let published = do daemonControlPublishRouting(answered.control)
            if published.published:
                do fdPublishRouting(published.routing)
            c = daemonControlPublishStatus(published.control, now)
            do fabricdReply(toInt(fields[2]), answered.ok, answered.message)
            return c
        let mut answer = DaemonAnswer{control: c, ok: false, message: ""}
        let mut reply = 0
        let mut id = 0
        if kind == "transfer":
            id = toInt(fields[1])
            answer = daemonControlRecordTransfer(c, id, toInt(fields[2]), toInt(fields[3]), fields[4] == "1", toInt(fields[5]), now)
            reply = toInt(fields[6])
        if kind == "copy":
            id = toInt(fields[1])
            let report = do fabricdDecodeReport(fields)
            reply = toInt(fields[13])
            let running = do daemonMoversIsRunning(c.movers, id)
            if running:
                answer = daemonControlRecordCopy(c, id, report, now)
            else:
                answer = DaemonAnswer{control: c, ok: false, message: "the copy for " + actionIdDisplay(ActionId{value: id}) + " was stopped"}
        c = answer.control
        if answer.ok:
            let applied = do daemonControlApplyAccepted(c, id)
            if applied.published:
                do fdPublishRouting(applied.routing)
            c = daemonControlPersist(applied.control)
            c = daemonControlPublishStatus(c, now)
        if reply > 0:
            do fabricdReply(reply, answer.ok, answer.message)
        return c

    proc fabricdReply(reply: int, ok: bool, message: text):
        let mut kind = "err"
        if ok:
            kind = "ok"
        let sent = send(reply, kind + fabricdSep() + message)

    # The drain: rollbacks, then cycles on the drain's own tighter cadence
    # until nothing is left running or the budget is spent, then the report
    # main.rs prints.
    proc fabricdDrain(c0: DaemonControl, t0: DaemonTelemetry) -> DaemonShutdownReport uses io.net:
        let now = do fabricdNowMs()
        let begun = do daemonControlDrainBegin(c0, now)
        let mut c = begun.control
        let mut t = t0
        if begun.published:
            do fdPublishRouting(begun.routing)
        let step = do daemonDrainStepMs(c)
        let mut going = true
        loop going:
            let unfinished = do daemonControlDrainUnfinished(c)
            if !unfinished || !sjU64Gt(begun.deadlineMs, fabricdNowMs()):
                going = false
            else:
                let slept = sleepMs(step)
                let cycled = do fabricdCycle(c, t)
                c = cycled.control
                t = cycled.telemetry
                if cycled.published:
                    do fdPublishRouting(cycled.routing)
                fabricdSnapshot = c.status
        let reported = do daemonControlDrainReport(c, begun.report)
        c = daemonControlPersist(c)
        let report = do daemonDrainFinishStore(c, reported)
        let published = do daemonControlPublishRouting(c)
        if published.published:
            do fdPublishRouting(published.routing)
        c = daemonControlPublishStatus(published.control, fabricdNowMs())
        fabricdSnapshot = c.status
        return report

    # The control loop: cadence ticks, operator questions and mover reports
    # from one queue; `stop` drains and hands the report to main.
    proc fabricdControlLoop(c0: DaemonControl, t0: DaemonTelemetry) -> bool uses io.net:
        let mut c = c0
        let mut t = t0
        let requests = fabricdRequests
        let sep = do fabricdSep()
        loop true:
            let msg = recv(requests)
            let fields = split(msg, sep)
            if fields[0] == "tick":
                let cycled = do fabricdCycle(c, t)
                c = cycled.control
                t = cycled.telemetry
                if cycled.published:
                    do fdPublishRouting(cycled.routing)
                fabricdSnapshot = c.status
            else:
                if fields[0] == "stop":
                    let report = do fabricdDrain(c, t)
                    let lines = do daemonShutdownLines(report)
                    let mut out = "report" + sep + daemonShutdownExitCode(report)
                    let mut k = 0
                    loop k < len(lines):
                        out = out + sep + lines[k]
                        k = k + 1
                    let sent = send(fabricdDispatch, out)
                    return true
                let served = do fabricdServe(c, fields)
                c = served
                fabricdSnapshot = c.status
        return true

    proc fabricdTicker(cycleMs: int) -> bool:
        let requests = fabricdRequests
        loop true:
            let slept = sleepMs(cycleMs)
            let stopping = fabricdStopping
            if !stopping:
                let sent = send(requests, "tick")
        return true

    proc fabricdRequestStop() -> bool:
        let sent = send(fabricdRequests, "stop")
        return true

    # One port's accept loop: every connection to main, which serves it.
    proc fabricdAcceptLoop(l: int, kind: text) -> bool uses io.net.listen:
        let sep = do fabricdSep()
        let dispatch = fabricdDispatch
        loop true:
            let c = accept(l)
            let sent = send(dispatch, kind + sep + c)
        return true

    proc fabricdSignalWatch(sig: int) -> bool:
        let sep = do fabricdSep()
        let dispatch = fabricdDispatch
        loop true:
            let got = recv(sig)
            let sent = send(dispatch, "signal" + sep + got)
        return true

    # A data connection after the shutdown began: closed unserved.
    proc fabricdRefuseConn(c: int) -> bool uses io.net.listen:
        let closed = closeConn(c)
        return closed

    proc main(args: [text]) -> int uses io.net, io.net.listen, io.file, io.env, io.console:
        let parsed = do fabricdParseArgs(args, envSet("FABRIC_CONFIG"), envVar("FABRIC_CONFIG"))
        if parsed.kind == "help":
            writeStdout(fabricdUsage())
            return 0
        if parsed.kind == "version":
            writeStdout("fabricd " + daemonVersion() + "\n")
            return 0
        if parsed.kind == "error":
            writeStderr("fabricd: " + parsed.value + "\n")
            writeStderr(fabricdUsage())
            return 78
        let loaded = do fabricdLoad(parsed.value)
        if !loaded.ok:
            writeStderr("fabricd: " + loaded.err + "\n")
            return 78
        let settings = loaded.settings
        fabricdSettings = settings
        fabricdRequests = channel()
        fabricdDispatch = channel()
        fabricdStopping = false
        let dataListener = listenOn(daemonAddrHost(settings.dataListen), settings.dataListen.port)
        let adminListener = listenOn(daemonAddrHost(settings.adminListen), settings.adminListen.port)
        fabricdSnapshot = daemonStartingStatus(settings, daemonAddrText(settings.dataListen), daemonAddrText(settings.adminListen), fabricdNowMs())
        let booted = do fabricdBoot(settings)
        if booted.err != "":
            writeStderr("fabricd: " + booted.err + "\n")
            return 78
        let sig = signals()
        detach fabricdControlLoop(booted.control, booted.telemetry)
        detach fabricdTicker(settings.cadence.controlCycleMs)
        detach fabricdAcceptLoop(dataListener, "data")
        detach fabricdAcceptLoop(adminListener, "admin")
        detach fabricdSignalWatch(sig)
        writeStderr("fabricd: serving FacetQL's wire on " + daemonAddrText(settings.dataListen) + " and the operator surface on " + daemonAddrText(settings.adminListen) + "\n")
        let sep = do fabricdSep()
        let dispatch = fabricdDispatch
        let mut stopping = false
        loop true:
            let msg = recv(dispatch)
            let fields = split(msg, sep)
            let kind = fields[0]
            if kind == "data":
                if stopping:
                    detach fabricdRefuseConn(toInt(fields[1]))
                else:
                    detach fdServeConn(toInt(fields[1]))
            if kind == "admin":
                detach fabricdServeAdmin(toInt(fields[1]))
            if kind == "copy":
                detach fabricdCopy(toInt(fields[1]), fields[2], fields[3], ActionTarget{shardId: toInt(fields[4]), coordinate: Coordinate{x: toInt(fields[5]), y: toInt(fields[6])}})
            if kind == "signal" && !stopping:
                stopping = true
                writeStderr("fabricd: draining\n")
                fabricdStopping = true
                detach fabricdRequestStop()
            if kind == "report":
                let mut k = 2
                loop k < len(fields):
                    writeStderr(fields[k] + "\n")
                    k = k + 1
                return toInt(fields[1])
        return 0

    # ------------------------------------------------------------ the operator port

    proc fabricdAsk(a: DaemonControlAsk) -> DaemonAdminResponse uses io.net:
        let stopping = fabricdStopping
        if stopping:
            return daemonAdminAnswer("stopped", "")
        let sep = do fabricdSep()
        let reply = channel()
        let mut msg = "abort" + sep + a.id + sep + reply
        if a.kind == "Transfer":
            let mut has = "0"
            if a.hasResident:
                has = "1"
            msg = "transfer" + sep + a.id + sep + a.atomsCopied + sep + a.bytesCopied + sep + has + sep + a.residentBytes + sep + reply
        let sent = send(fabricdRequests, msg)
        let answer = recv(reply)
        let parts = split(answer, sep)
        let mut message = parts[1]
        let mut k = 2
        loop k < len(parts):
            message = message + sep + parts[k]
            k = k + 1
        return daemonAdminAnswer(parts[0], message)

    proc fabricdAdminResponse(r: DaemonAdminResponse) -> HttpServerResponse:
        let mut headers = []
        if r.contentType != "-":
            headers = append(headers, HttpHeader{name: "content-type", value: r.contentType})
        if r.allow != "-":
            headers = append(headers, HttpHeader{name: "allow", value: r.allow})
        return HttpServerResponse{status: r.status, reason: "", headers: headers, body: r.body}

    proc fabricdServeAdmin(c: int) uses io.net, io.net.listen:
        let mut pending = []
        let mut open = true
        loop open:
            let req = do httpServerReadRequest(c, pending, 2097152)
            if req.state != 1:
                if req.state == -1:
                    let refused = do httpServerRefuse(c, 400, req.err)
                if req.state == -2:
                    let refused2 = do httpServerRefuse(c, 413, "Failed to buffer the request body: length limit exceeded")
                open = false
            else:
                pending = req.rest
                let keep = do httpServerKeepAlive(req)
                let settings = fabricdSettings
                let token = settings.adminToken
                let routed = do daemonAdminRoute(DaemonAdminRequest{method: req.method, target: req.target, headers: req.headers, body: req.body}, fabricdSnapshot, token)
                let mut response = routed.response
                if routed.ask:
                    response = fabricdAsk(routed.request)
                let wrote = do httpServerWriteResponse(c, req.method, fabricdAdminResponse(response), keep)
                open = wrote && keep
        let closed = closeConn(c)

    # ------------------------------------------------------------ the movers

    proc fabricdDecodeReport(fields: [text]) -> MoverReport:
        let mut verdict = copyVerdictPending()
        if fields[9] == "Verified":
            verdict = copyVerdictVerified(toInt(fields[10]), toInt(fields[11]))
        if fields[9] == "Failed":
            let mut reason = fields[14]
            let mut k = 15
            loop k < len(fields):
                reason = reason + fabricdSep() + fields[k]
                k = k + 1
            verdict = copyVerdictFailed(reason, toInt(fields[11]))
        return MoverReport{rowsCopied: toInt(fields[2]), bytesCopied: toInt(fields[3]), hasResidentBytes: fields[4] == "1", residentBytes: toInt(fields[5]), snapshotComplete: fields[6] == "1", observedWrites: toInt(fields[7]), appliedWrites: toInt(fields[8]), verdict: verdict}

    proc fabricdBit(b: bool) -> text:
        if b:
            return "1"
        return "0"

    # A mover's report into the loop's queue — the seam an out-of-band
    # mover's transfer report also comes through. `reply` 0 is a ping with
    # nothing to wait for; otherwise the loop's answer is the stop signal.
    proc fabricdSendReport(id: int, r: MoverReport, reply: int):
        let sep = do fabricdSep()
        let v = r.verdict
        let msg = "copy" + sep + id + sep + r.rowsCopied + sep + r.bytesCopied + sep + fabricdBit(r.hasResidentBytes) + sep + r.residentBytes + sep + fabricdBit(r.snapshotComplete) + sep + r.observedWrites + sep + r.appliedWrites + sep + v.kind + sep + v.rows + sep + v.atMs + sep + "" + sep + reply + sep + v.reason
        let sent = send(fabricdRequests, msg)

    proc fabricdFailedReport(reason: text) -> MoverReport:
        return MoverReport{rowsCopied: 0, bytesCopied: 0, hasResidentBytes: false, residentBytes: 0, snapshotComplete: false, observedWrites: 0, appliedWrites: 0, verdict: copyVerdictFailed(reason, fabricdNowMs())}

    # mover.rs `copy`: subscribe first, snapshot, then catch up and check
    # until the loop says the action is over; every failure ends as a Failed
    # verdict on the wire.
    proc fabricdCopy(id: int, sourceId: text, destinationId: text, record: ActionTarget) uses io.net:
        let s = fabricdSettings
        let source = do daemonMoverEndpoint(s, sourceId)
        let destination = do daemonMoverEndpoint(s, destinationId)
        let scope = do cellScopeForKey(s.keyspace.packed, routingKeyPack(record.shardId, record.coordinate.x, record.coordinate.y))
        let m = do cellMoverNew(fqlClientNew(source.endpoint), fqlClientNew(destination.endpoint), scope, moverConfigDefault())
        let sub = do moverSubscribe(m)
        if !sub.ok:
            do fabricdSendReport(id, fabricdFailedReport("could not subscribe to the source's change feed: " + moverErrorDisplay(sub.err)), 0)
            return
        let snap = do moverSnapshot(m, sub.feed)
        if snap.err.kind != "":
            do fabricdSendReport(id, fabricdFailedReport("the bulk copy did not finish: " + moverErrorDisplay(snap.err)), 0)
            return
        let mut mover = snap.mover
        let mut feed = snap.feed
        let mut going = true
        loop going:
            let caught = do moverCatchUp(mover, feed)
            feed = caught.feed
            let mut verdict = copyVerdictFailed("catch-up could not be applied: " + moverErrorDisplay(caught.err), fabricdNowMs())
            if caught.err.kind == "":
                let checked = do moverVerify(mover, feed, fabricdNowMs())
                feed = checked.feed
                verdict = checked.verdict
            let fatal = verdict.kind == "Failed"
            let reply = channel()
            do fabricdSendReport(id, moverReport(mover, feed, verdict), reply)
            let answer = recv(reply)
            let ok = slice(answer, 0, 2) == "ok"
            if !ok || fatal:
                going = false
            else:
                let slept = sleepMs(50)
        let closed = do changeFeedClose(feed)
