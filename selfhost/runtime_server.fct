import "runtime_page.fct"
import "streams_webhooks.fct"
import "runtime_ops.fct"
import "runtime_admin.fct"
import "runtime_compliance.fct"
import "runtime_cluster.fct"

app RuntimeServer:
    # runtime_server.fct — the facet web runtime as a service written in
    # fct: runtime/server.go's Handler over http_server.fct. It loads a
    # compiled app (the JSON `facet ir` emits, through ir_graph.fct), and
    # serves it exactly as the Go runtime does: the built-in endpoints ahead
    # of the app's view router (Handler's `builtins` table, in ServeMux's
    # longest-pattern order), then the pages.
    #
    #   The test driver (runtime_parity_test.go) posts /api/rtConfigure
    #   with the port and the IR file (inside the data directory), then
    #   starts the daemons; `facet exec` would read RT_PORT / RT_IR from the
    #   environment instead (rtConfigFromEnv).
    #
    # The shape is fqserver.fct's: one loop task (rtLoop) owns the world —
    # entities, sessions, subscribers — and answers one request at a time,
    # which is Server.mu; every connection is its own task (rtServeConn)
    # that parses the request, hands it to the loop as a packed message
    # with its reply channel, and writes what comes back. A live stream
    # stays on its connection task and receives frames from the loop.
    shared rtPort: int
    shared rtIRPath: text

    proc rtSetConfig(port: int, irPath: text):
        rtPort = port
        rtIRPath = irPath

    action rtConfigure(port: int, irPath: text):
        do rtSetConfig(port, irPath)

    # ── messages between a connection and the loop ──────────────────────
    proc rtPack(fields: [text]) -> text:
        let mut out = ""
        let mut i = 0
        loop i < len(fields):
            out = out + len(fields[i]) + ":" + fields[i]
            i = i + 1
        return out

    proc rtUnpack(s: text) -> [text]:
        let mut out = []
        let n = len(s)
        let mut p = 0
        loop p < n:
            let mut q = p
            loop charAt(s, q) != ":":
                q = q + 1
            let k = toInt(slice(s, p, q))
            out = append(out, slice(s, q + 1, q + 1 + k))
            p = q + 1 + k
        return out

    proc rtBoolText(b: bool) -> text:
        if b:
            return "1"
        return "0"

    # A request: ["Q", reply, method, path, query, hasQuery, body, h1name, h1value, …].
    proc rtReqFields(reply: int, req: HttpServerRequest) -> [text]:
        let mut f = ["Q", "" + reply, req.method, req.path, req.query, rtBoolText(req.hasQuery), req.body]
        let mut i = 0
        loop i < len(req.headers):
            f = append(f, req.headers[i].name)
            f = append(f, req.headers[i].value)
            i = i + 1
        return f

    proc rtReqAt(f: [text]) -> HttpServerRequest:
        let mut headers = []
        let mut i = 7
        loop i + 1 < len(f):
            headers = append(headers, HttpHeader{name: f[i], value: f[i + 1]})
            i = i + 2
        return HttpServerRequest{state: 1, err: "", method: f[2], target: f[3], path: f[3], query: f[4], hasQuery: f[5] == "1", version: "HTTP/1.1", headers: headers, body: f[6], rest: []}

    # A response: ["R", status, body, h1name, h1value, …]; a stream:
    # ["S", chan, status, h1name, h1value, …] followed by frames on chan.
    # rtRespFields: a whole response's head — its body follows as a message
    # of its own, never framed (a page is megabytes; framing it cost a rune
    # count and a rune-indexed slice of the whole body on each side).
    proc rtRespFields(r: HttpServerResponse) -> [text]:
        let mut f = ["R", "" + r.status]
        let mut i = 0
        loop i < len(r.headers):
            f = append(f, r.headers[i].name)
            f = append(f, r.headers[i].value)
            i = i + 1
        return f

    proc rtHeadersAt(f: [text], from: int) -> [HttpHeader]:
        let mut headers = []
        let mut i = from
        loop i + 1 < len(f):
            headers = append(headers, HttpHeader{name: f[i], value: f[i + 1]})
            i = i + 2
        return headers

    # ── the loop ────────────────────────────────────────────────────────
    proc rtLoop(ch: int, w0: RtWorld, js: text) uses io.net.listen, io.console, io.file, io.net:
        let mut w = w0
        loop true:
            let msg = recv(ch)
            let f = do rtUnpack(msg)
            if f[0] == "Q":
                let reply = toInt(f[1])
                let req = do rtReqAt(f)
                let t0 = monoMs()
                let before = w
                let mut out = do rtRoute(w, req, js, reply)
                w = out.w
                # The request's writes commit as one transaction before the
                # reply; a refused commit fails the request and leaves the
                # world as it was (runActionLocked's rollback).
                let committed = do rtStoreCommit(w)
                if !committed.ok:
                    let e = writeStderr("facet: action rolled back: the store refused the write: " + committed.err + "\n")
                    # runActionLocked's rollback undoes what the action wrote —
                    # entity rows and the session state it changed — but not the
                    # session the request was given before the action ran (a
                    # guest minted by `session`): that one stays, at its
                    # defaults, and its cookie rides the 500.
                    let failedW = out.w
                    w = before
                    # the actions it ran are metered as refused writes
                    # ("error"), not the "ok" they reported
                    w.met = do rtMetRefused(before.met, failedW.met)
                    w.audit = do rtAuditRefused(before.audit, failedW.audit, committed.err)
                    w.pendingOps = []
                    w.pendingChanged = []
                    w.pendingEvents = []
                    out.stream = false
                    let mut si = 0
                    loop si < len(failedW.sessions):
                        let ses = failedW.sessions[si]
                        let known = do rtSessionIndex(before, ses.sid)
                        if known < 0:
                            let mut fresh = do rtNewSession(before, ses.sid, "guest", "guest")
                            fresh.visitor = ses.visitor
                            fresh.expires = ses.expires
                            w = do rtPutSession(w, fresh)
                        si = si + 1
                    let mut refused = do rtTextError(500, "the write could not be stored and was rolled back")
                    let mut hi = 0
                    loop hi < len(out.resp.headers):
                        if out.resp.headers[hi].name == "set-cookie":
                            refused.headers = append(refused.headers, out.resp.headers[hi])
                        hi = hi + 1
                    out = do rtWhole(w, refused)
                else:
                    w = committed.w
                    let changed = w.pendingChanged
                    w.pendingChanged = []
                    if len(changed) > 0:
                        w = do rtBroadcast(w, changed)
                    w = do rtFanoutEvents(w)
                    w = do rtClusterSync(w)
                # observeRequest: a whole answer now; a stream when it ends,
                # as Go's handler returns only then.
                if out.stream:
                    w.met.openChans = append(w.met.openChans, out.chan)
                    w.met.openMethods = append(w.met.openMethods, req.method)
                    w.met.openPaths = append(w.met.openPaths, rtPathUnescape(req.path))
                    w.met.openStatus = append(w.met.openStatus, out.resp.status)
                    w.met.openStart = append(w.met.openStart, t0)
                else:
                    # the route label reads the decoded path (r.URL.Path)
                    w.met = do rtMetRequest(w.met, req.method, rtPathUnescape(req.path), out.resp.status, monoMs() - t0)
                if out.stream:
                    let sent = send(reply, rtPack(["S", "" + out.chan, "" + out.resp.status] + rtHeaderPairs(out.resp.headers)))
                    let sent2 = send(out.chan, out.resp.body)
                else:
                    let sent3 = send(reply, rtPack(rtRespFields(out.resp)))
                    let sentBody = send(reply, out.resp.body)
            # a peer's announcement, a lost feed position, the hourly purge
            if f[0] == "C":
                w = do rtClusterApply(w, f[1])
            if f[0] == "E":
                w = do rtEvictWhere(w, ["*"], [], [])
            if f[0] == "P":
                let purged = do rtPurgeSessions(w)
            if f[0] == "T":
                w = do rtRunPeriodicJob(w, toInt(f[1]))
            if f[0] == "U":
                let gone = toInt(f[1])
                w.met = do rtMetStreamEnded(w.met, gone)
                let isStream = do rtIsStreamSub(w, gone)
                if isStream:
                    w = do rtStreamGone(w, gone)
                    let done = do rtStoreCommit(w)
                    if done.ok:
                        w = done.w
                        let ch2 = w.pendingChanged
                        w.pendingChanged = []
                        if len(ch2) > 0:
                            w = do rtBroadcast(w, ch2)
                        w = do rtFanoutEvents(w)
                        w = do rtClusterSync(w)
                    else:
                        w.pendingOps = []
                        w.pendingChanged = []
                        w.pendingEvents = []
                else:
                    w = do rtUnsubscribe(w, gone)

    proc rtHeaderPairs(hs: [HttpHeader]) -> [text]:
        let mut out = []
        let mut i = 0
        loop i < len(hs):
            out = append(out, hs[i].name)
            out = append(out, hs[i].value)
            i = i + 1
        return out

    # RtRouted: one request's answer — a whole response, or the head of a
    # stream whose frames arrive on `chan`.
    struct RtRouted:
        resp: HttpServerResponse
        w: RtWorld
        stream: bool
        chan: int

    proc rtWhole(w: RtWorld, r: HttpServerResponse) -> RtRouted:
        return RtRouted{resp: r, w: w, stream: false, chan: 0}

    # rtRoute: Handler — the built-ins first, then the view router.
    proc rtRoute(w0: RtWorld, req: HttpServerRequest, js: text, reply: int) -> RtRouted uses io.file, io.net:
        let mut w = w0
        let path = req.path
        # Declared `api` endpoints first (serveDeclaredAPI): the app's own
        # contract takes precedence over the generic projection and the views.
        let peer = do rtHeaderValue(req.headers, "x-facet-peer")
        let decl = do rtServeDeclaredAPI(w, req, peer)
        w = decl.w
        if decl.handled:
            let dr = do rtWhole(w, decl.resp)
            return dr
        if path == "/facet.css":
            let mut headers = [HttpHeader{name: "content-type", value: "text/css; charset=utf-8"}, HttpHeader{name: "cache-control", value: "public, max-age=31536000, immutable"}, HttpHeader{name: "etag", value: "\"" + w.cssVer + "\""}]
            let inm = do rtHeaderValue(req.headers, "if-none-match")
            if inm == "\"" + w.cssVer + "\"":
                let nm = do rtWhole(w, HttpServerResponse{status: 304, reason: "", headers: headers, body: ""})
                return nm
            let css = do rtWhole(w, HttpServerResponse{status: 200, reason: "", headers: headers, body: w.cssBody})
            return css
        if path == "/facet.js":
            let jr = do rtWhole(w, HttpServerResponse{status: 200, reason: "", headers: [HttpHeader{name: "content-type", value: "application/javascript"}], body: js})
            return jr
        if path == "/event":
            let ev = do rtHandleEvent(w, req)
            let evr = do rtWhole(ev.w, ev.resp)
            return evr
        # The change stream lives in the runtime's own namespace, /api/_live;
        # /live is an ordinary path an app's page may take.
        if path == "/api/_live":
            let lv = do rtHandleLive(w, req)
            return RtRouted{resp: lv.resp, w: lv.w, stream: lv.ok, chan: lv.chan}
        # ServeMux's most specific pattern wins: a declared stream or webhook
        # path beats the /api/ subtree and the view router.
        let sm = do rtStreamFor(w.g, path)
        if sm.found:
            let so = do rtHandleStream(w, req, sm, peer)
            return RtRouted{resp: so.resp, w: so.w, stream: so.stream, chan: so.chan}
        let wi = do rtWebhookIndex(w.g, path)
        if wi >= 0:
            let wr = do rtHandleWebhook(w, req, wi)
            let wrr = do rtWhole(wr.w, wr.resp)
            return wrr
        let isContract = do cIsContractPath(w, path)
        if isContract:
            let cr = do cHandleContract(w, req, peer)
            let crr = do rtWhole(cr.w, cr.resp)
            return crr
        if path == "/upload":
            let up = do rtHandleUpload(w, req)
            let upr = do rtWhole(up.w, up.resp)
            return upr
        let upSub = do rtHasPrefix(path, "/upload/")
        if upSub:
            let uc = do rtHandleUploadChunked(w, req)
            let ucr = do rtWhole(uc.w, uc.resp)
            return ucr
        let upsSub = do rtHasPrefix(path, "/uploads/")
        if upsSub:
            let us = do rtHandleUploads(w, req)
            let usr = do rtWhole(us.w, us.resp)
            return usr
        if path == "/region":
            let rg = do rtHandleRegion(w, req)
            let rgr = do rtWhole(rg.w, rg.resp)
            return rgr
        if path == "/api":
            let sch = do rtHandleAPISchema(w, req)
            let schr = do rtWhole(w, sch)
            return schr
        # handleAPI's own names, ahead of every entity and action
        if path == "/api/_i18n":
            let i18 = do rtWhole(w, rtHandleI18n(w, req))
            return i18
        if path == "/api/_audit":
            let au = do rtHandleAudit(w, req)
            let aur = do rtWhole(au.w, au.resp)
            return aur
        if path == "/api/_export":
            let ex = do rtHandleGDPRExport(w, req)
            let exr = do rtWhole(ex.w, ex.resp)
            return exr
        if path == "/api/_erase":
            let er = do rtHandleGDPRErase(w, req)
            let err = do rtWhole(er.w, er.resp)
            return err
        if path == "/api/_contract":
            let ct = do rtHandleContractAPI(w, req)
            let ctr = do rtWhole(ct.w, ct.resp)
            return ctr
        if path == "/api/_billing":
            let bl = do rtHandleBillingAPI(w, req)
            let blr = do rtWhole(bl.w, bl.resp)
            return blr
        let apiSub = do rtHasPrefix(path, "/api/")
        if apiSub:
            let ap = do rtHandleAPI(w, req)
            let apr = do rtWhole(ap.w, ap.resp)
            return apr
        if path == "/healthz":
            let hz = do rtWhole(w, rtJSONResponse(200, "{\"app\":" + jsonQuote(w.g.app) + ",\"status\":\"ok\"}\n"))
            return hz
        let adminSub = do rtHasPrefix(path, "/admin/")
        if path == "/admin" || adminSub:
            let ad = do rtHandleAdmin(w, req)
            let adr = do rtWhole(ad.w, ad.resp)
            return adr
        let assetSub = do rtHasPrefix(path, "/assets/")
        if assetSub:
            let asr = do rtWhole(w, rtHandleAssets(w, req))
            return asr
        if path == "/metrics":
            let mr = do rtWhole(w, rtHandleMetrics(w))
            return mr
        if path == "/readyz":
            let rz = do rtWhole(w, rtJSONResponse(200, "{\"status\":\"ready\"}\n"))
            return rz
        let pg = do rtHandlePage(w, req)
        let pr = do rtWhole(pg.w, pg.resp)
        return pr

    proc rtEnvOn(key: text) -> bool uses io.env:
        let v = lower(envVar(key))
        return v == "1" || v == "true" || v == "on" || v == "yes"

    proc rtIsStreamSub(w: RtWorld, ch: int) -> bool:
        let mut i = 0
        loop i < len(w.streamSubs):
            if w.streamSubs[i].ch == ch:
                return true
            i = i + 1
        return false

    # rtInjectContractEntity: injectContractEntities — a declared `contract`
    # records the document this process serves in a reserved table, which
    # the graph therefore carries (and every page's IR ships).
    proc rtInjectContractEntity(g0: IRGraph) -> IRGraph:
        let mut g = g0
        if len(g.contract) == 0:
            return g
        let have = do rtEntityIndex(g, "FacetContractVersion")
        if have >= 0:
            return g
        let fields = [rtPlainField("id", "int", false), rtPlainField("version", "text", true), rtPlainField("schema_version", "int", false), rtPlainField("schema_hash", "text", false), rtPlainField("first_seen", "int", false), rtPlainField("document", "text", false)]
        g.entities = append(g.entities, IREntity{name: "FacetContractVersion", softDelete: false, ephemeral: false, fields: fields, read: [], derives: []})
        return g

    proc rtPlainField(name: text, typ: text, index: bool) -> IRField:
        return IRField{name: name, type: typ, ref: "", enumName: "", index: index, secret: false, e2e: false, password: false, readPolicy: "", optional: false, unique: false, required: false, hasMin: false, min: 0, hasMax: false, max: 0, matches: "", onDelete: ""}

    # rtPeerHost: the host of "host:port" (net.SplitHostPort).
    proc rtPeerHost(addr: text) -> text:
        let mut i = len(addr) - 1
        loop i >= 0:
            if charAt(addr, i) == ":":
                return slice(addr, 0, i)
            i = i - 1
        return addr

    # ── connections ─────────────────────────────────────────────────────
    proc rtServeConn(c: int, ch: int) uses io.net.listen:
        let reply = channel()
        let mut pending = []
        let mut open = true
        loop open:
            let raw = do httpServerReadRequestRaw(c, pending, 16 * 1024 * 1024)
            let req = raw.req
            if req.state == 0:
                open = false
            if req.state == -1:
                let r = do httpServerRefuse(c, 400, "bad request: " + req.err)
                open = false
            if req.state == -2:
                let r2 = do httpServerRefuse(c, 413, "too large")
                open = false
            if req.state == 1:
                pending = req.rest
                let keep = do httpServerKeepAlive(req)
                let mut withPeer = req
                withPeer.headers = append(req.headers, HttpHeader{name: "x-facet-peer", value: rtPeerHost(connPeer(c))})
                # a body that is not UTF-8 text (an upload) travels as bytes too
                if len(raw.bodyBytes) > 0 && bytesToText(raw.bodyBytes) != req.body:
                    withPeer.headers = append(withPeer.headers, HttpHeader{name: "x-facet-body-b64", value: base64UrlRaw(raw.bodyBytes)})
                else:
                    if len(raw.bodyBytes) > 0:
                        withPeer.headers = append(withPeer.headers, HttpHeader{name: "x-facet-body-b64", value: base64UrlRaw(raw.bodyBytes)})
                let sent = send(ch, rtPack(rtReqFields(reply, withPeer)))
                let f = do rtUnpack(recv(reply))
                if f[0] == "S":
                    let frames = toInt(f[1])
                    let headers = do rtHeadersAt(f, 3)
                    let started = do httpServerStartStream(c, toInt(f[2]), headers)
                    let mut ok = started
                    # Go writes nothing while a stream is idle; it learns the
                    # client left from the request context. Here the socket
                    # is read for a moment each quarter second: a read that
                    # finds the end marks the connection closed.
                    loop ok:
                        let which = awaitAny([frames], 250)
                        if which < 0:
                            let probe = pollBytes(c, 1, 1)
                            ok = connOpen(c)
                        else:
                            let frame = recv(frames)
                            ok = do httpServerWriteChunk(c, textToBytes(frame))
                    # The client is gone: close its frame channel first, so a
                    # frame the loop sends before it hears "U" is refused at
                    # once instead of waiting forever for a reader that has
                    # left — the loop serves every connection, and must never
                    # block on one.
                    let dropped = closeChannel(frames)
                    let un = send(ch, rtPack(["U", "" + frames]))
                    open = false
                else:
                    let body = recv(reply)
                    let mut resp = HttpServerResponse{status: toInt(f[1]), reason: "", headers: rtHeadersAt(f, 2), body: body}
                    if resp.status == 304:
                        # net/http's own rule for 304: no body, and the
                        # Content-Type/Content-Length a handler set are dropped.
                        resp.headers = do rtWithoutHeader(resp.headers, "content-type")
                        resp.body = ""
                    let b64 = do rtHeaderValue(resp.headers, "x-facet-body-b64")
                    if b64 != "":
                        # a stored file: bytes, not text
                        let bytes = do rtBase64UrlDecode(b64)
                        let plain = do rtWithoutHeader(resp.headers, "x-facet-body-b64")
                        let wroteB = do httpServerWriteResponseBytes(c, req.method, resp.status, resp.reason, plain, bytes, keep)
                        open = wroteB && keep
                    else:
                        let wrote = do httpServerWriteResponse(c, req.method, resp, keep)
                        open = wrote && keep
        let closed = closeConn(c)
        let freed = closeChannel(reply)

    # rtConfigFromEnv: `facet exec selfhost/runtime_server.fct` is configured
    # by RT_PORT and RT_IR (the compiled app's JSON, inside the data
    # directory); the parity harness configures the cells through
    # /api/rtConfigure instead. The environment is read first: a shared
    # cell nothing assigned may not be read.
    struct RtConfig:
        fromEnv: bool
        port: int
        irPath: text

    # RT_PORT=0 is a real setting (any free port), so "configured by the
    # environment" is whether RT_PORT is set at all, not whether it is 0.
    proc rtConfigFromEnv() -> RtConfig uses io.env:
        let envPort = envSet("RT_PORT")
        if envPort:
            return RtConfig{fromEnv: true, port: toInt(envVar("RT_PORT")), irPath: envVar("RT_IR")}
        return RtConfig{fromEnv: false, port: 0, irPath: ""}

    daemon RuntimeServe uses io.file, io.net.listen, io.env, io.console, io.net:
        let cfg = do rtConfigFromEnv()
        let mut port = cfg.port
        let mut irPath = cfg.irPath
        if !cfg.fromEnv:
            port = rtPort
            irPath = rtIRPath
        let src = readFile(irPath)
        let jv = do jsonParse(src)
        let g0 = do irGraphFromJVal(jv)
        # the name tables exist before anything looks a name up
        let preIndexed = do rtIndexNames(g0, [])
        rtCollsCache = RtCollsCache{ok: false, pages: 0, colls: RtColls{names: [], all: [], fields: [], logOps: false, ops: []}}
        rtAppColls = RtAppColls{ok: false, comps: 0, acts: 0, ops: []}
        let g = do rtInjectContractEntity(g0)
        let mut master = envVar("FACET_SECRET")
        if master == "":
            master = base64UrlRaw(randomBytes(32))
            let warn = writeStderr("facet: FACET_SECRET is not set — using a random ephemeral key; sessions, CSRF tokens, and @secret columns will not survive a restart. Set FACET_SECRET in production.\n")
        do rtSetProcTable(g.procs)
        do rtSetStoreEntities(g)
        do rtSetReadRules(g)
        # the base stylesheet the host handed over (facet-base.css, beside
        # facet.js in the data directory): the Go build's own copy
        let baseCSS = readFile("facet-base.css")
        let mut w = do rtWorldNew(g, master, envVar("FACET_API_READ"), baseCSS)
        let indexed = do rtIndexNames(g, w.entNames)
        let appCollsIndexed = do rtIndexAppColls(g)
        let streamIndexed = do rtIndexStream(g)
        w.secure = envVar("FACET_SECURE_COOKIES") == "1"
        let rc = do rtRateConfig()
        let hasUp = envSet("FACET_UPLOAD_DIR")
        if hasUp:
            w.uploadDir = envVar("FACET_UPLOAD_DIR")
        let hasCap = envSet("FACET_MAX_UPLOAD_MB")
        if hasCap && toInt(envVar("FACET_MAX_UPLOAD_MB")) > 0:
            w.uploadCap = toInt(envVar("FACET_MAX_UPLOAD_MB")) * 1024 * 1024
        let hasTotal = envSet("FACET_MAX_MEDIA_MB")
        if hasTotal && toInt(envVar("FACET_MAX_MEDIA_MB")) > 0:
            w.uploadTotalCap = toInt(envVar("FACET_MAX_MEDIA_MB")) * 1024 * 1024
        w.multiTenant = do rtEnvOn("FACET_MULTI_TENANT")
        w.billing = do rtEnvOn("FACET_BILLING")
        w = do rtLoadI18n(w)
        # adminEnabled: the console is on unless FACET_ADMIN is exactly "0"
        w.adminOn = envVar("FACET_ADMIN") != "0"
        let hasIdem = envSet("FACET_WEBHOOK_IDEM_TTL")
        if hasIdem && toInt(envVar("FACET_WEBHOOK_IDEM_TTL")) > 0:
            w.idemTTL = toInt(envVar("FACET_WEBHOOK_IDEM_TTL"))
        let mut whi = 0
        loop whi < len(w.g.webhooks):
            w.whPaths = append(w.whPaths, w.g.webhooks[whi].path)
            let mut secret = ""
            if w.g.webhooks[whi].secret != "":
                secret = envVar(w.g.webhooks[whi].secret)
            w.whKeys = append(w.whKeys, secret)
            whi = whi + 1
        let hasTTL = envSet("FACET_MEDIA_TTL")
        if hasTTL:
            w.mediaTTL = toInt(envVar("FACET_MEDIA_TTL"))
        w.rateClassNames = rc.names
        w.rateClassLimits = rc.limits
        w.rateDefault = rc.fallback
        let hasDSN = envSet("FACET_DATABASE_URL")
        if hasDSN && envVar("FACET_DATABASE_URL") != "":
            let opened = do rtStoreOpen(w, envVar("FACET_DATABASE_URL"))
            if !opened.ok:
                let e0 = writeStderr("facet: " + opened.err + "\n")
                let x0 = exitProcess(1)
            w = opened.w
        # startCluster: FACET_CLUSTER=1 joins the instances sharing this
        # store — which must be a shared one — and subscribes to the feed
        # before serving anything, so no peer's announcement is missed.
        let noFeed = do httpStreamFailed("")
        let mut feed = RtFeed{ok: false, gone: false, err: "", stream: noFeed}
        if envVar("FACET_CLUSTER") == "1":
            if !w.storeOn:
                let ce = writeStderr("facet: FACET_CLUSTER=1 requires the facetql:// store — clustering has no shared bus over the in-memory store, since each process would only ever hear its own publishes\n")
                let cx = exitProcess(1)
            feed = do rtOpenFeed(w.fqlBase, w.fqlToken, 0, 15000)
            if !feed.ok:
                let fe = writeStderr("facet: subscribe to the FacetQL event feed: " + feed.err + "\n")
                let fx = exitProcess(1)
            w.clusterOn = true
            w.instanceID = toHex(randomBytes(8))
        w = do cRecordContractVersion(w)
        w = do rtRunOnStartJobs(w)
        let booted = do rtStoreCommit(w)
        if !booted.ok:
            let e1 = writeStderr("facet: " + booted.err + "\n")
            let x1 = exitProcess(1)
        w = booted.w
        # an `on start` job's changes fan out as any action's do (no
        # subscriber yet, but the write sequence advances)
        let bootChanged = w.pendingChanged
        w.pendingChanged = []
        if len(bootChanged) > 0:
            w = do rtBroadcast(w, bootChanged)
        w = do rtFanoutEvents(w)
        let js = readFile("facet.js")
        let ch = channel()
        if w.clusterOn:
            detach rtClusterReceiver(ch, w.fqlBase, w.fqlToken, feed.stream)
            detach rtClusterPurger(ch)
        # schedule: each `every Ns` job ticks on its own interval (the first
        # tick one interval out), and the loop runs it
        let mut ji = 0
        loop ji < len(w.g.jobs):
            if w.g.jobs[ji].every > 0:
                detach rtJobTicker(ch, ji, w.g.jobs[ji].every)
            ji = ji + 1
        detach rtLoop(ch, w, js)
        let l = listen(port)
        # The port actually bound — RT_PORT=0 asks the kernel for one — is
        # announced, so whoever started this process can reach it without
        # choosing a port for it first (and racing another process for it).
        let bound = listenerPort(l)
        let banner = writeStdout("Facet runtime serving " + w.g.app + " on port " + bound + "\n")
        loop true:
            let c = accept(l)
            detach rtServeConn(c, ch)

    # rtJobTicker: schedule's ticker — a "T" to the loop every interval
    # (in the ten-minute steps sleepMs allows).
    proc rtJobTicker(ch: int, at: int, everySecs: int):
        loop true:
            let mut left = everySecs * 1000
            loop left > 0:
                let mut step = left
                if step > 600000:
                    step = 600000
                let slept = sleepMs(step)
                left = left - step
            let sent = send(ch, rtPack(["T", "" + at]))

    # rtRunPeriodicJob: one tick of an `every Ns` job — clustered, only the
    # instance that wins the tick's cron reservation runs it (ReserveCron);
    # the action runs under the system session and commits like any other
    # (work: done, or — a cron job carries no retries — dead-lettered).
    proc rtRunPeriodicJob(w0: RtWorld, at: int) -> RtWorld uses io.net, io.console:
        let mut w = w0
        let j = w.g.jobs[at]
        if w.clusterOn:
            let won = do rtReserveCron(w, j.name, j.every)
            if !won:
                return w
        let ai = do rtActionIndex(w.g, j.action)
        if ai < 0:
            w.met = do rtMetJob(w.met, "dead")
            return w
        let si = do rtSessionIndex(w, "__system")
        if si < 0:
            let mut sys = do rtNewSession(w, "__system", "system", "admin")
            sys.verified = true
            w = do rtPutSession(w, sys)
        let before = w
        let run = do rtRunActionValue(w, "__system", w.g.actions[ai], [])
        w = run.w
        if run.status != 200:
            let e = writeStderr("facet: job dead-lettered: " + j.action + ": " + run.msg + "\n")
            w.met = do rtMetJob(w.met, "dead")
            let failedDone = do rtStoreCommit(w)
            if failedDone.ok:
                w = failedDone.w
            return w
        let done = do rtStoreCommit(w)
        if !done.ok:
            let e2 = writeStderr("facet: job " + j.action + ": the store refused the write: " + done.err + "\n")
            let mut back = before
            back.met = do rtMetJob(before.met, "dead")
            return back
        w = done.w
        let changed = w.pendingChanged
        w.pendingChanged = []
        if len(changed) > 0:
            w = do rtBroadcast(w, changed)
        w = do rtFanoutEvents(w)
        w = do rtClusterSync(w)
        w.met = do rtMetJob(w.met, "done")
        return w

    # rtRunOnStartJobs: runOnStartJobs — the system session exists, then
    # every `on start` job's action runs under it, in order, before the
    # daemons start.
    proc rtRunOnStartJobs(w0: RtWorld) -> RtWorld uses io.console:
        let mut w = w0
        let si = do rtSessionIndex(w, "__system")
        if si < 0:
            let mut sys = do rtNewSession(w, "__system", "system", "admin")
            sys.verified = true
            w = do rtPutSession(w, sys)
        let mut i = 0
        loop i < len(w.g.jobs):
            let j = w.g.jobs[i]
            if j.onStart:
                let ai = do rtActionIndex(w.g, j.action)
                if ai >= 0:
                    let run = do rtRunActionValue(w, "__system", w.g.actions[ai], [])
                    w = run.w
                    if run.status != 200:
                        let e = writeStderr("on start job failed: " + j.name + " (" + run.status + ") " + run.msg + "\n")
            i = i + 1
        return w
