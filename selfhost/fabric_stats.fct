import "fabric_telemetry.fct"
import "fabric_json.fct"

app FabricStatsSelfHost:
    # Self-hosting port of fabric/crates/fabric-facetql/src/sample.rs (606L)
    # — turning two `GET /stats` reads into the rates Fabric's model runs
    # on — plus the subset of fabric/crates/fabric-facetql/src/wire.rs
    # (665L) that sample.rs's own types actually depend on. Both files read
    # in full before writing a line here.
    #
    # ============================================================
    # WHICH PART OF wire.rs (665L) IS PORTED, AND WHY
    # ============================================================
    # sample.rs's own `use` statement is exactly `use crate::wire::{CellStats,
    # EngineStats};` — but `EngineStats` is not a leaf type: it is the WHOLE
    # `GET /stats` wire response, and its fields (`kinds: Vec<KindCount>`,
    # `storage: StorageStats`, `runtime: RuntimeStats` -> `requests:
    # RequestStats` / `window: WindowStats` -> `read_latency`/`write_latency:
    # LatencyStats` / `process: ProcessStats`, `cells: CellAttribution` ->
    # `cells: Vec<CellStats>`) are ALL part of that one response shape —
    # there is no smaller "just what sample.rs reads" struct to carve out
    # without literally renaming fields out of the real wire contract, which
    # this task's own root-solutions rule forbids (that would misrepresent
    # what `GET /stats` actually returns). So the full stats-DTO subtree is
    # ported below: KindCount, StorageStats, LatencyStats, WindowStats,
    # RequestStats, ProcessStats, RuntimeStats, CellStats, CellAttribution,
    # EngineStats — ten structs, all reachable from `EngineStats` alone.
    #
    # Deliberately EXCLUDED, as genuinely unrelated to `/stats`: `Coordinate`
    # (FacetQL's 4-axis per-node tag — note `CellStats` does NOT nest this
    # type, it carries its own flat `x`/`y`/`z`/`q`, so this exclusion costs
    # nothing), `Visibility`, `Node`, `QueryPage`, `QueryRequest`,
    # `CreateNodeRequest`, `Expect`, `TxOperation`, `TransactionRequest` —
    # the node-CRUD/transaction wire contract for entirely different
    # endpoints (`/nodes`, `/node`, `/transaction`), never referenced by
    # `EngineStats` or by anything in sample.rs.
    #
    # ============================================================
    # WHY `WorkloadMetrics`/`CellWorkloadMetrics` ARE IMPORTED, NOT REDECLARED
    # ============================================================
    # `sample.rs` also depends on `fabric_telemetry::{CellWorkloadMetrics,
    # WorkloadMetrics}` — already ported field-for-field in
    # fabric_telemetry.fct. That file's own header (read in full first)
    # states this directory has "no cross-file `import`" — true when it was
    # written, but superseded since: fabric_table.fct (read in full too)
    # later confirmed a working `import "<file>.fct"` mechanism, real enough
    # that it reuses fabric_replication.fct's `ReplGroup` and
    # fabric_routing.fct's whole routing surface directly, and documents
    # exactly when it fails (two imported files whose `private view Home at
    # "/"` collide). Re-verified empirically in this round with a disposable
    # scratch file before writing this one: `import "fabric_telemetry.fct"`
    # plus calling its exported procs (`workloadKeyNew`, `replGroupNew`-style
    # calls in general) compiles and runs cleanly, and fabric_telemetry.fct
    # declares no view at all, so there is no `Home` collision to hit here.
    # Given that, redeclaring `WorkloadMetrics`/`CellWorkloadMetrics` a
    # second time in this file would be exactly the "duplicate a shape that
    # is not actually independent" mistake fabric_telemetry.fct's own header
    # warns against for its own two crates — so this file imports them
    # instead, and reuses `workloadMetricsDefault`, `workloadMetricsIsHot`,
    # `workloadMetricsIsQueueHot`, `workloadMetricsTotalOperations`, and
    # `clampFloat` directly rather than re-deriving any of them.
    #
    # ============================================================
    # CLOCKS
    # ============================================================
    # StatsSample::take reads two clocks: now_ms() (epoch milliseconds, a
    # label) and Instant::now() (monotonic, for elapsed time). The clock-free
    # statsSampleTakeAt takes both readings from the caller, and
    # `difference` measures elapsed time exactly as Duration::as_secs_f64
    # over the monotonic nanosecond readings (saturating at zero).
    # statsSampleTake reads monoMs() (millisecond resolution) for elapsed
    # time and now() for the label.

    # ============================================================
    # wire.rs — the stats-DTO subtree, transcribed field-for-field.
    # Every `Option<T>` becomes a `hasX: bool` + `x: T` pair (the
    # `hasClaimedBy`/`claimedBy` convention core_types.fct's own `Node`
    # already establishes for the identical reason: `x` is meaningless
    # whenever `hasX` is false, exactly like `Option::None`'s absent
    # payload) rather than a special sentinel value, so "absent" is never
    # confused with a real zero.
    # ============================================================
    struct KindCount:
        kind: text
        count: int

    struct StorageStats:
        pageSize: int
        segments: int
        pages: int
        obsoleteBytes: int

    struct LatencyStats:
        count: int
        hasP50Us: bool
        p50Us: int
        hasP99Us: bool
        p99Us: int
        hasMaxUs: bool
        maxUs: int

    struct WindowStats:
        durationMs: int
        ageMs: int
        hasCpuUtilization: bool
        cpuUtilization: float
        readLatency: LatencyStats
        writeLatency: LatencyStats

    struct RequestStats:
        total: int
        read: int
        write: int
        excluded: int
        unclassified: int
        inFlight: int
        maxConcurrent: int
        writeQueueDepth: int
        writeQueueContendedTotal: int

    struct ProcessStats:
        hasCpuSecondsTotal: bool
        cpuSecondsTotal: float
        hasCpuCores: bool
        cpuCores: int
        hasResidentBytes: bool
        residentBytes: int
        hasMemoryLimitBytes: bool
        memoryLimitBytes: int
        hasMemoryLimitSource: bool
        memoryLimitSource: text
        hasMemoryUtilization: bool
        memoryUtilization: float

    struct RuntimeStats:
        uptimeSeconds: int
        requests: RequestStats
        window: WindowStats
        process: ProcessStats

    struct CellStats:
        x: int
        y: int
        z: int
        q: int
        reads: int
        writes: int
        bytesRead: int
        bytesWritten: int

    struct CellAttribution:
        capacity: int
        tracked: int
        overflowReads: int
        overflowWrites: int
        unattributedWrites: int
        cells: [CellStats]

    struct EngineStats:
        nodeCount: int
        edgeCount: int
        userCount: int
        historyEntries: int
        kinds: [KindCount]
        readsTotal: int
        writesTotal: int
        storage: StorageStats
        hasVersion: bool
        version: text
        runtime: RuntimeStats
        cells: CellAttribution

    # ============================================================
    # sample.rs — StatsSample and its real derivation logic.
    # `takenAt`/`takenAtMs` restate `Instant`/epoch-ms — see this file's
    # header for the exact, named approximation both carry.
    # ============================================================
    # ============================================================
    # wire.rs EngineStats: its serde schema for fabric_json.fct's sjDecode
    # (serde_json::from_slice::<EngineStats> exactly, error text and
    # position included), the decoded tree read into the structs, and the
    # JSON text FacetQL sends. Generated from wire.rs's field table.
    # ============================================================

    proc statsSchema() -> [SjType]:
        let mut ts = []
        ts = append(ts, sjOptionType("opt_u64", "u64"))
        ts = append(ts, sjOptionType("opt_f64", "f64"))
        ts = append(ts, sjOptionType("opt_string", "string"))
        ts = append(ts, sjVecType("vec_KindCount", "KindCount"))
        ts = append(ts, sjVecType("vec_CellStats", "CellStats"))
        ts = append(ts, sjStructType("KindCount", "struct KindCount", ["kind", "count"], ["string", "u64"], [false, false]))
        ts = append(ts, sjStructType("StorageStats", "struct StorageStats", ["page_size", "segments", "pages", "obsolete_bytes"], ["u32", "u64", "u64", "u64"], [false, false, false, false]))
        ts = append(ts, sjStructType("LatencyStats", "struct LatencyStats", ["count", "p50_us", "p99_us", "max_us"], ["u64", "opt_u64", "opt_u64", "opt_u64"], [true, true, true, true]))
        ts = append(ts, sjStructType("WindowStats", "struct WindowStats", ["duration_ms", "age_ms", "cpu_utilization", "read_latency", "write_latency"], ["u64", "u64", "opt_f64", "LatencyStats", "LatencyStats"], [true, true, true, true, true]))
        ts = append(ts, sjStructType("RequestStats", "struct RequestStats", ["total", "read", "write", "excluded", "unclassified", "in_flight", "max_concurrent", "write_queue_depth", "write_queue_contended_total"], ["u64", "u64", "u64", "u64", "u64", "u64", "u64", "u64", "u64"], [true, true, true, true, true, true, true, true, true]))
        ts = append(ts, sjStructType("ProcessStats", "struct ProcessStats", ["cpu_seconds_total", "cpu_cores", "resident_bytes", "memory_limit_bytes", "memory_limit_source", "memory_utilization"], ["opt_f64", "opt_u64", "opt_u64", "opt_u64", "opt_string", "opt_f64"], [true, true, true, true, true, true]))
        ts = append(ts, sjStructType("RuntimeStats", "struct RuntimeStats", ["uptime_seconds", "requests", "window", "process"], ["u64", "RequestStats", "WindowStats", "ProcessStats"], [true, true, true, true]))
        ts = append(ts, sjStructType("CellStats", "struct CellStats", ["x", "y", "z", "q", "reads", "writes", "bytes_read", "bytes_written"], ["u8", "u8", "u8", "u8", "u64", "u64", "u64", "u64"], [true, true, true, true, true, true, true, true]))
        ts = append(ts, sjStructType("CellAttribution", "struct CellAttribution", ["capacity", "tracked", "overflow_reads", "overflow_writes", "unattributed_writes", "cells"], ["u64", "u64", "u64", "u64", "u64", "vec_CellStats"], [true, true, true, true, true, true]))
        ts = append(ts, sjStructType("EngineStats", "struct EngineStats", ["node_count", "edge_count", "user_count", "history_entries", "kinds", "reads_total", "writes_total", "storage", "version", "runtime", "cells"], ["u64", "u64", "u64", "u64", "vec_KindCount", "u64", "u64", "StorageStats", "opt_string", "RuntimeStats", "CellAttribution"], [false, false, false, false, false, false, false, false, true, true, true]))
        return ts

    proc statsReadKindCount(v: SjV) -> KindCount:
        let mut out = do statsZeroKindCount()
        out.kind = v.items[0].s
        out.count = v.items[1].u
        return out

    proc statsReadStorageStats(v: SjV) -> StorageStats:
        let mut out = do statsZeroStorageStats()
        out.pageSize = v.items[0].u
        out.segments = v.items[1].u
        out.pages = v.items[2].u
        out.obsoleteBytes = v.items[3].u
        return out

    proc statsReadLatencyStats(v: SjV) -> LatencyStats:
        let mut out = do statsZeroLatencyStats()
        out.count = v.items[0].u
        out.hasP50Us = v.items[1].kind != "absent"
        if out.hasP50Us:
            out.p50Us = v.items[1].u
        out.hasP99Us = v.items[2].kind != "absent"
        if out.hasP99Us:
            out.p99Us = v.items[2].u
        out.hasMaxUs = v.items[3].kind != "absent"
        if out.hasMaxUs:
            out.maxUs = v.items[3].u
        return out

    proc statsReadWindowStats(v: SjV) -> WindowStats:
        let mut out = do statsZeroWindowStats()
        out.durationMs = v.items[0].u
        out.ageMs = v.items[1].u
        out.hasCpuUtilization = v.items[2].kind != "absent"
        if out.hasCpuUtilization:
            out.cpuUtilization = v.items[2].f
        let mut rReadLatency = do statsDefaultLatencyStats()
        if v.items[3].kind != "absent":
            rReadLatency = do statsReadLatencyStats(v.items[3])
        out.readLatency = rReadLatency
        let mut rWriteLatency = do statsDefaultLatencyStats()
        if v.items[4].kind != "absent":
            rWriteLatency = do statsReadLatencyStats(v.items[4])
        out.writeLatency = rWriteLatency
        return out

    proc statsReadRequestStats(v: SjV) -> RequestStats:
        let mut out = do statsZeroRequestStats()
        out.total = v.items[0].u
        out.read = v.items[1].u
        out.write = v.items[2].u
        out.excluded = v.items[3].u
        out.unclassified = v.items[4].u
        out.inFlight = v.items[5].u
        out.maxConcurrent = v.items[6].u
        out.writeQueueDepth = v.items[7].u
        out.writeQueueContendedTotal = v.items[8].u
        return out

    proc statsReadProcessStats(v: SjV) -> ProcessStats:
        let mut out = do statsZeroProcessStats()
        out.hasCpuSecondsTotal = v.items[0].kind != "absent"
        if out.hasCpuSecondsTotal:
            out.cpuSecondsTotal = v.items[0].f
        out.hasCpuCores = v.items[1].kind != "absent"
        if out.hasCpuCores:
            out.cpuCores = v.items[1].u
        out.hasResidentBytes = v.items[2].kind != "absent"
        if out.hasResidentBytes:
            out.residentBytes = v.items[2].u
        out.hasMemoryLimitBytes = v.items[3].kind != "absent"
        if out.hasMemoryLimitBytes:
            out.memoryLimitBytes = v.items[3].u
        out.hasMemoryLimitSource = v.items[4].kind != "absent"
        if out.hasMemoryLimitSource:
            out.memoryLimitSource = v.items[4].s
        out.hasMemoryUtilization = v.items[5].kind != "absent"
        if out.hasMemoryUtilization:
            out.memoryUtilization = v.items[5].f
        return out

    proc statsReadRuntimeStats(v: SjV) -> RuntimeStats:
        let mut out = do statsZeroRuntimeStats()
        out.uptimeSeconds = v.items[0].u
        let mut rRequests = do statsDefaultRequestStats()
        if v.items[1].kind != "absent":
            rRequests = do statsReadRequestStats(v.items[1])
        out.requests = rRequests
        let mut rWindow = do statsDefaultWindowStats()
        if v.items[2].kind != "absent":
            rWindow = do statsReadWindowStats(v.items[2])
        out.window = rWindow
        let mut rProcess = do statsDefaultProcessStats()
        if v.items[3].kind != "absent":
            rProcess = do statsReadProcessStats(v.items[3])
        out.process = rProcess
        return out

    proc statsReadCellStats(v: SjV) -> CellStats:
        let mut out = do statsZeroCellStats()
        out.x = v.items[0].u
        out.y = v.items[1].u
        out.z = v.items[2].u
        out.q = v.items[3].u
        out.reads = v.items[4].u
        out.writes = v.items[5].u
        out.bytesRead = v.items[6].u
        out.bytesWritten = v.items[7].u
        return out

    proc statsReadCellAttribution(v: SjV) -> CellAttribution:
        let mut out = do statsZeroCellAttribution()
        out.capacity = v.items[0].u
        out.tracked = v.items[1].u
        out.overflowReads = v.items[2].u
        out.overflowWrites = v.items[3].u
        out.unattributedWrites = v.items[4].u
        let mut xsCells = []
        let mut kCells = 0
        loop kCells < len(v.items[5].items):
            let eCells = do statsReadCellStats(v.items[5].items[kCells])
            xsCells = append(xsCells, eCells)
            kCells = kCells + 1
        out.cells = xsCells
        return out

    proc statsReadEngineStats(v: SjV) -> EngineStats:
        let mut out = do statsZeroEngineStats()
        out.nodeCount = v.items[0].u
        out.edgeCount = v.items[1].u
        out.userCount = v.items[2].u
        out.historyEntries = v.items[3].u
        let mut xsKinds = []
        let mut kKinds = 0
        loop kKinds < len(v.items[4].items):
            let eKinds = do statsReadKindCount(v.items[4].items[kKinds])
            xsKinds = append(xsKinds, eKinds)
            kKinds = kKinds + 1
        out.kinds = xsKinds
        out.readsTotal = v.items[5].u
        out.writesTotal = v.items[6].u
        let rStorage = do statsReadStorageStats(v.items[7])
        out.storage = rStorage
        out.hasVersion = v.items[8].kind != "absent"
        if out.hasVersion:
            out.version = v.items[8].s
        let mut rRuntime = do statsDefaultRuntimeStats()
        if v.items[9].kind != "absent":
            rRuntime = do statsReadRuntimeStats(v.items[9])
        out.runtime = rRuntime
        let mut rCells = do statsDefaultCellAttribution()
        if v.items[10].kind != "absent":
            rCells = do statsReadCellAttribution(v.items[10])
        out.cells = rCells
        return out

    struct StatsDecodeResult:
        ok: bool
        err: text
        stats: EngineStats

    # serde_json::from_slice::<EngineStats>; `err` is the error's Display.
    proc statsDecodeEngineStats(body: text) -> StatsDecodeResult:
        let schema = do statsSchema()
        let r = do sjDecode(schema, body, "EngineStats")
        if !r.ok:
            let z = do statsZeroEngineStats()
            return StatsDecodeResult{ok: false, err: r.err, stats: z}
        let s = do statsReadEngineStats(r.v)
        return StatsDecodeResult{ok: true, err: "", stats: s}

    proc statsDefaultLatencyStats() -> LatencyStats:
        return LatencyStats{count: 0, hasP50Us: false, p50Us: 0, hasP99Us: false, p99Us: 0, hasMaxUs: false, maxUs: 0}

    proc statsDefaultWindowStats() -> WindowStats:
        let dReadLatency = do statsDefaultLatencyStats()
        let dWriteLatency = do statsDefaultLatencyStats()
        return WindowStats{durationMs: 0, ageMs: 0, hasCpuUtilization: false, cpuUtilization: 0.0, readLatency: dReadLatency, writeLatency: dWriteLatency}

    proc statsDefaultRequestStats() -> RequestStats:
        return RequestStats{total: 0, read: 0, write: 0, excluded: 0, unclassified: 0, inFlight: 0, maxConcurrent: 0, writeQueueDepth: 0, writeQueueContendedTotal: 0}

    proc statsDefaultProcessStats() -> ProcessStats:
        return ProcessStats{hasCpuSecondsTotal: false, cpuSecondsTotal: 0.0, hasCpuCores: false, cpuCores: 0, hasResidentBytes: false, residentBytes: 0, hasMemoryLimitBytes: false, memoryLimitBytes: 0, hasMemoryLimitSource: false, memoryLimitSource: "", hasMemoryUtilization: false, memoryUtilization: 0.0}

    proc statsDefaultRuntimeStats() -> RuntimeStats:
        let dRequests = do statsDefaultRequestStats()
        let dWindow = do statsDefaultWindowStats()
        let dProcess = do statsDefaultProcessStats()
        return RuntimeStats{uptimeSeconds: 0, requests: dRequests, window: dWindow, process: dProcess}

    proc statsDefaultCellStats() -> CellStats:
        return CellStats{x: 0, y: 0, z: 0, q: 0, reads: 0, writes: 0, bytesRead: 0, bytesWritten: 0}

    proc statsDefaultCellAttribution() -> CellAttribution:
        return CellAttribution{capacity: 0, tracked: 0, overflowReads: 0, overflowWrites: 0, unattributedWrites: 0, cells: []}

    proc statsZeroKindCount() -> KindCount:
        return KindCount{kind: "", count: 0}

    proc statsZeroStorageStats() -> StorageStats:
        return StorageStats{pageSize: 0, segments: 0, pages: 0, obsoleteBytes: 0}

    proc statsZeroLatencyStats() -> LatencyStats:
        return LatencyStats{count: 0, hasP50Us: false, p50Us: 0, hasP99Us: false, p99Us: 0, hasMaxUs: false, maxUs: 0}

    proc statsZeroWindowStats() -> WindowStats:
        let zReadLatency = do statsZeroLatencyStats()
        let zWriteLatency = do statsZeroLatencyStats()
        return WindowStats{durationMs: 0, ageMs: 0, hasCpuUtilization: false, cpuUtilization: 0.0, readLatency: zReadLatency, writeLatency: zWriteLatency}

    proc statsZeroRequestStats() -> RequestStats:
        return RequestStats{total: 0, read: 0, write: 0, excluded: 0, unclassified: 0, inFlight: 0, maxConcurrent: 0, writeQueueDepth: 0, writeQueueContendedTotal: 0}

    proc statsZeroProcessStats() -> ProcessStats:
        return ProcessStats{hasCpuSecondsTotal: false, cpuSecondsTotal: 0.0, hasCpuCores: false, cpuCores: 0, hasResidentBytes: false, residentBytes: 0, hasMemoryLimitBytes: false, memoryLimitBytes: 0, hasMemoryLimitSource: false, memoryLimitSource: "", hasMemoryUtilization: false, memoryUtilization: 0.0}

    proc statsZeroRuntimeStats() -> RuntimeStats:
        let zRequests = do statsZeroRequestStats()
        let zWindow = do statsZeroWindowStats()
        let zProcess = do statsZeroProcessStats()
        return RuntimeStats{uptimeSeconds: 0, requests: zRequests, window: zWindow, process: zProcess}

    proc statsZeroCellStats() -> CellStats:
        return CellStats{x: 0, y: 0, z: 0, q: 0, reads: 0, writes: 0, bytesRead: 0, bytesWritten: 0}

    proc statsZeroCellAttribution() -> CellAttribution:
        return CellAttribution{capacity: 0, tracked: 0, overflowReads: 0, overflowWrites: 0, unattributedWrites: 0, cells: []}

    proc statsZeroEngineStats() -> EngineStats:
        let zStorage = do statsZeroStorageStats()
        let zRuntime = do statsZeroRuntimeStats()
        let zCells = do statsZeroCellAttribution()
        return EngineStats{nodeCount: 0, edgeCount: 0, userCount: 0, historyEntries: 0, kinds: [], readsTotal: 0, writesTotal: 0, storage: zStorage, hasVersion: false, version: "", runtime: zRuntime, cells: zCells}

    # KindCount: deserialize_struct, then visit_seq or visit_map as derived.

    proc statsJsonKindCount(v: KindCount) -> text:
        let jKind = do sjQuote(v.kind)
        let jCount = do sjU64Text(v.count)
        return "{" + "\"kind\":" + jKind + "," + "\"count\":" + jCount + "}"

    # StorageStats as JSON text, fields in wire.rs order (None as null).

    proc statsJsonStorageStats(v: StorageStats) -> text:
        let jPageSize = do sjU64Text(v.pageSize)
        let jSegments = do sjU64Text(v.segments)
        let jPages = do sjU64Text(v.pages)
        let jObsoleteBytes = do sjU64Text(v.obsoleteBytes)
        return "{" + "\"page_size\":" + jPageSize + "," + "\"segments\":" + jSegments + "," + "\"pages\":" + jPages + "," + "\"obsolete_bytes\":" + jObsoleteBytes + "}"

    # LatencyStats as JSON text, fields in wire.rs order (None as null).

    proc statsJsonLatencyStats(v: LatencyStats) -> text:
        let jCount = do sjU64Text(v.count)
        let mut jP50Us = "null"
        if v.hasP50Us:
            jP50Us = do sjU64Text(v.p50Us)
        let mut jP99Us = "null"
        if v.hasP99Us:
            jP99Us = do sjU64Text(v.p99Us)
        let mut jMaxUs = "null"
        if v.hasMaxUs:
            jMaxUs = do sjU64Text(v.maxUs)
        return "{" + "\"count\":" + jCount + "," + "\"p50_us\":" + jP50Us + "," + "\"p99_us\":" + jP99Us + "," + "\"max_us\":" + jMaxUs + "}"

    # WindowStats as JSON text, fields in wire.rs order (None as null).

    proc statsJsonWindowStats(v: WindowStats) -> text:
        let jDurationMs = do sjU64Text(v.durationMs)
        let jAgeMs = do sjU64Text(v.ageMs)
        let mut jCpuUtilization = "null"
        if v.hasCpuUtilization:
            jCpuUtilization = do sjF64Text(v.cpuUtilization)
        let jReadLatency = do statsJsonLatencyStats(v.readLatency)
        let jWriteLatency = do statsJsonLatencyStats(v.writeLatency)
        return "{" + "\"duration_ms\":" + jDurationMs + "," + "\"age_ms\":" + jAgeMs + "," + "\"cpu_utilization\":" + jCpuUtilization + "," + "\"read_latency\":" + jReadLatency + "," + "\"write_latency\":" + jWriteLatency + "}"

    # RequestStats as JSON text, fields in wire.rs order (None as null).

    proc statsJsonRequestStats(v: RequestStats) -> text:
        let jTotal = do sjU64Text(v.total)
        let jRead = do sjU64Text(v.read)
        let jWrite = do sjU64Text(v.write)
        let jExcluded = do sjU64Text(v.excluded)
        let jUnclassified = do sjU64Text(v.unclassified)
        let jInFlight = do sjU64Text(v.inFlight)
        let jMaxConcurrent = do sjU64Text(v.maxConcurrent)
        let jWriteQueueDepth = do sjU64Text(v.writeQueueDepth)
        let jWriteQueueContendedTotal = do sjU64Text(v.writeQueueContendedTotal)
        return "{" + "\"total\":" + jTotal + "," + "\"read\":" + jRead + "," + "\"write\":" + jWrite + "," + "\"excluded\":" + jExcluded + "," + "\"unclassified\":" + jUnclassified + "," + "\"in_flight\":" + jInFlight + "," + "\"max_concurrent\":" + jMaxConcurrent + "," + "\"write_queue_depth\":" + jWriteQueueDepth + "," + "\"write_queue_contended_total\":" + jWriteQueueContendedTotal + "}"

    # ProcessStats as JSON text, fields in wire.rs order (None as null).

    proc statsJsonProcessStats(v: ProcessStats) -> text:
        let mut jCpuSecondsTotal = "null"
        if v.hasCpuSecondsTotal:
            jCpuSecondsTotal = do sjF64Text(v.cpuSecondsTotal)
        let mut jCpuCores = "null"
        if v.hasCpuCores:
            jCpuCores = do sjU64Text(v.cpuCores)
        let mut jResidentBytes = "null"
        if v.hasResidentBytes:
            jResidentBytes = do sjU64Text(v.residentBytes)
        let mut jMemoryLimitBytes = "null"
        if v.hasMemoryLimitBytes:
            jMemoryLimitBytes = do sjU64Text(v.memoryLimitBytes)
        let mut jMemoryLimitSource = "null"
        if v.hasMemoryLimitSource:
            jMemoryLimitSource = do sjQuote(v.memoryLimitSource)
        let mut jMemoryUtilization = "null"
        if v.hasMemoryUtilization:
            jMemoryUtilization = do sjF64Text(v.memoryUtilization)
        return "{" + "\"cpu_seconds_total\":" + jCpuSecondsTotal + "," + "\"cpu_cores\":" + jCpuCores + "," + "\"resident_bytes\":" + jResidentBytes + "," + "\"memory_limit_bytes\":" + jMemoryLimitBytes + "," + "\"memory_limit_source\":" + jMemoryLimitSource + "," + "\"memory_utilization\":" + jMemoryUtilization + "}"

    # RuntimeStats as JSON text, fields in wire.rs order (None as null).

    proc statsJsonRuntimeStats(v: RuntimeStats) -> text:
        let jUptimeSeconds = do sjU64Text(v.uptimeSeconds)
        let jRequests = do statsJsonRequestStats(v.requests)
        let jWindow = do statsJsonWindowStats(v.window)
        let jProcess = do statsJsonProcessStats(v.process)
        return "{" + "\"uptime_seconds\":" + jUptimeSeconds + "," + "\"requests\":" + jRequests + "," + "\"window\":" + jWindow + "," + "\"process\":" + jProcess + "}"

    # CellStats as JSON text, fields in wire.rs order (None as null).

    proc statsJsonCellStats(v: CellStats) -> text:
        let jX = do sjU64Text(v.x)
        let jY = do sjU64Text(v.y)
        let jZ = do sjU64Text(v.z)
        let jQ = do sjU64Text(v.q)
        let jReads = do sjU64Text(v.reads)
        let jWrites = do sjU64Text(v.writes)
        let jBytesRead = do sjU64Text(v.bytesRead)
        let jBytesWritten = do sjU64Text(v.bytesWritten)
        return "{" + "\"x\":" + jX + "," + "\"y\":" + jY + "," + "\"z\":" + jZ + "," + "\"q\":" + jQ + "," + "\"reads\":" + jReads + "," + "\"writes\":" + jWrites + "," + "\"bytes_read\":" + jBytesRead + "," + "\"bytes_written\":" + jBytesWritten + "}"

    # CellAttribution as JSON text, fields in wire.rs order (None as null).

    proc statsJsonCellAttribution(v: CellAttribution) -> text:
        let jCapacity = do sjU64Text(v.capacity)
        let jTracked = do sjU64Text(v.tracked)
        let jOverflowReads = do sjU64Text(v.overflowReads)
        let jOverflowWrites = do sjU64Text(v.overflowWrites)
        let jUnattributedWrites = do sjU64Text(v.unattributedWrites)
        let jCells = do statsJsonVecCellStats(v.cells)
        return "{" + "\"capacity\":" + jCapacity + "," + "\"tracked\":" + jTracked + "," + "\"overflow_reads\":" + jOverflowReads + "," + "\"overflow_writes\":" + jOverflowWrites + "," + "\"unattributed_writes\":" + jUnattributedWrites + "," + "\"cells\":" + jCells + "}"

    # EngineStats as JSON text, fields in wire.rs order (None as null).

    proc statsJsonEngineStats(v: EngineStats) -> text:
        let jNodeCount = do sjU64Text(v.nodeCount)
        let jEdgeCount = do sjU64Text(v.edgeCount)
        let jUserCount = do sjU64Text(v.userCount)
        let jHistoryEntries = do sjU64Text(v.historyEntries)
        let jKinds = do statsJsonVecKindCount(v.kinds)
        let jReadsTotal = do sjU64Text(v.readsTotal)
        let jWritesTotal = do sjU64Text(v.writesTotal)
        let jStorage = do statsJsonStorageStats(v.storage)
        let mut jVersion = "null"
        if v.hasVersion:
            jVersion = do sjQuote(v.version)
        let jRuntime = do statsJsonRuntimeStats(v.runtime)
        let jCells = do statsJsonCellAttribution(v.cells)
        return "{" + "\"node_count\":" + jNodeCount + "," + "\"edge_count\":" + jEdgeCount + "," + "\"user_count\":" + jUserCount + "," + "\"history_entries\":" + jHistoryEntries + "," + "\"kinds\":" + jKinds + "," + "\"reads_total\":" + jReadsTotal + "," + "\"writes_total\":" + jWritesTotal + "," + "\"storage\":" + jStorage + "," + "\"version\":" + jVersion + "," + "\"runtime\":" + jRuntime + "," + "\"cells\":" + jCells + "}"

    proc statsJsonVecKindCount(xs: [KindCount]) -> text:
        let mut out = []
        let mut i = 0
        loop i < len(xs):
            let s = do statsJsonKindCount(xs[i])
            out = append(out, s)
            i = i + 1
        return "[" + join(out, ",") + "]"

    proc statsJsonVecCellStats(xs: [CellStats]) -> text:
        let mut out = []
        let mut i = 0
        loop i < len(xs):
            let s = do statsJsonCellStats(xs[i])
            out = append(out, s)
            i = i + 1
        return "[" + join(out, ",") + "]"

    proc statsDigestKindCount(v: KindCount) -> text:
        let gKind = do sjQuote(v.kind)
        let gCount = do sjU64Text(v.count)
        return "(" + gKind + "," + gCount + ")"

    proc statsDigestStorageStats(v: StorageStats) -> text:
        let gPageSize = do sjU64Text(v.pageSize)
        let gSegments = do sjU64Text(v.segments)
        let gPages = do sjU64Text(v.pages)
        let gObsoleteBytes = do sjU64Text(v.obsoleteBytes)
        return "(" + gPageSize + "," + gSegments + "," + gPages + "," + gObsoleteBytes + ")"

    proc statsDigestLatencyStats(v: LatencyStats) -> text:
        let gCount = do sjU64Text(v.count)
        let mut gP50Us = "-"
        if v.hasP50Us:
            gP50Us = do sjU64Text(v.p50Us)
        let mut gP99Us = "-"
        if v.hasP99Us:
            gP99Us = do sjU64Text(v.p99Us)
        let mut gMaxUs = "-"
        if v.hasMaxUs:
            gMaxUs = do sjU64Text(v.maxUs)
        return "(" + gCount + "," + gP50Us + "," + gP99Us + "," + gMaxUs + ")"

    proc statsDigestWindowStats(v: WindowStats) -> text:
        let gDurationMs = do sjU64Text(v.durationMs)
        let gAgeMs = do sjU64Text(v.ageMs)
        let mut gCpuUtilization = "-"
        if v.hasCpuUtilization:
            gCpuUtilization = "" + floatBits(v.cpuUtilization)
        let gReadLatency = do statsDigestLatencyStats(v.readLatency)
        let gWriteLatency = do statsDigestLatencyStats(v.writeLatency)
        return "(" + gDurationMs + "," + gAgeMs + "," + gCpuUtilization + "," + gReadLatency + "," + gWriteLatency + ")"

    proc statsDigestRequestStats(v: RequestStats) -> text:
        let gTotal = do sjU64Text(v.total)
        let gRead = do sjU64Text(v.read)
        let gWrite = do sjU64Text(v.write)
        let gExcluded = do sjU64Text(v.excluded)
        let gUnclassified = do sjU64Text(v.unclassified)
        let gInFlight = do sjU64Text(v.inFlight)
        let gMaxConcurrent = do sjU64Text(v.maxConcurrent)
        let gWriteQueueDepth = do sjU64Text(v.writeQueueDepth)
        let gWriteQueueContendedTotal = do sjU64Text(v.writeQueueContendedTotal)
        return "(" + gTotal + "," + gRead + "," + gWrite + "," + gExcluded + "," + gUnclassified + "," + gInFlight + "," + gMaxConcurrent + "," + gWriteQueueDepth + "," + gWriteQueueContendedTotal + ")"

    proc statsDigestProcessStats(v: ProcessStats) -> text:
        let mut gCpuSecondsTotal = "-"
        if v.hasCpuSecondsTotal:
            gCpuSecondsTotal = "" + floatBits(v.cpuSecondsTotal)
        let mut gCpuCores = "-"
        if v.hasCpuCores:
            gCpuCores = do sjU64Text(v.cpuCores)
        let mut gResidentBytes = "-"
        if v.hasResidentBytes:
            gResidentBytes = do sjU64Text(v.residentBytes)
        let mut gMemoryLimitBytes = "-"
        if v.hasMemoryLimitBytes:
            gMemoryLimitBytes = do sjU64Text(v.memoryLimitBytes)
        let mut gMemoryLimitSource = "-"
        if v.hasMemoryLimitSource:
            gMemoryLimitSource = do sjQuote(v.memoryLimitSource)
        let mut gMemoryUtilization = "-"
        if v.hasMemoryUtilization:
            gMemoryUtilization = "" + floatBits(v.memoryUtilization)
        return "(" + gCpuSecondsTotal + "," + gCpuCores + "," + gResidentBytes + "," + gMemoryLimitBytes + "," + gMemoryLimitSource + "," + gMemoryUtilization + ")"

    proc statsDigestRuntimeStats(v: RuntimeStats) -> text:
        let gUptimeSeconds = do sjU64Text(v.uptimeSeconds)
        let gRequests = do statsDigestRequestStats(v.requests)
        let gWindow = do statsDigestWindowStats(v.window)
        let gProcess = do statsDigestProcessStats(v.process)
        return "(" + gUptimeSeconds + "," + gRequests + "," + gWindow + "," + gProcess + ")"

    proc statsDigestCellStats(v: CellStats) -> text:
        let gX = do sjU64Text(v.x)
        let gY = do sjU64Text(v.y)
        let gZ = do sjU64Text(v.z)
        let gQ = do sjU64Text(v.q)
        let gReads = do sjU64Text(v.reads)
        let gWrites = do sjU64Text(v.writes)
        let gBytesRead = do sjU64Text(v.bytesRead)
        let gBytesWritten = do sjU64Text(v.bytesWritten)
        return "(" + gX + "," + gY + "," + gZ + "," + gQ + "," + gReads + "," + gWrites + "," + gBytesRead + "," + gBytesWritten + ")"

    proc statsDigestCellAttribution(v: CellAttribution) -> text:
        let gCapacity = do sjU64Text(v.capacity)
        let gTracked = do sjU64Text(v.tracked)
        let gOverflowReads = do sjU64Text(v.overflowReads)
        let gOverflowWrites = do sjU64Text(v.overflowWrites)
        let gUnattributedWrites = do sjU64Text(v.unattributedWrites)
        let gCells = do statsDigestVecCellStats(v.cells)
        return "(" + gCapacity + "," + gTracked + "," + gOverflowReads + "," + gOverflowWrites + "," + gUnattributedWrites + "," + gCells + ")"

    proc statsDigestEngineStats(v: EngineStats) -> text:
        let gNodeCount = do sjU64Text(v.nodeCount)
        let gEdgeCount = do sjU64Text(v.edgeCount)
        let gUserCount = do sjU64Text(v.userCount)
        let gHistoryEntries = do sjU64Text(v.historyEntries)
        let gKinds = do statsDigestVecKindCount(v.kinds)
        let gReadsTotal = do sjU64Text(v.readsTotal)
        let gWritesTotal = do sjU64Text(v.writesTotal)
        let gStorage = do statsDigestStorageStats(v.storage)
        let mut gVersion = "-"
        if v.hasVersion:
            gVersion = do sjQuote(v.version)
        let gRuntime = do statsDigestRuntimeStats(v.runtime)
        let gCells = do statsDigestCellAttribution(v.cells)
        return "(" + gNodeCount + "," + gEdgeCount + "," + gUserCount + "," + gHistoryEntries + "," + gKinds + "," + gReadsTotal + "," + gWritesTotal + "," + gStorage + "," + gVersion + "," + gRuntime + "," + gCells + ")"

    proc statsDigestVecKindCount(xs: [KindCount]) -> text:
        let mut out = []
        let mut i = 0
        loop i < len(xs):
            let s = do statsDigestKindCount(xs[i])
            out = append(out, s)
            i = i + 1
        return "[" + join(out, ";") + "]"

    proc statsDigestVecCellStats(xs: [CellStats]) -> text:
        let mut out = []
        let mut i = 0
        loop i < len(xs):
            let s = do statsDigestCellStats(xs[i])
            out = append(out, s)
            i = i + 1
        return "[" + join(out, ";") + "]"


    # `taken_at` (an Instant) is `takenAtNanos`, a monotonic nanosecond
    # reading; `takenAt` is the same reading in whole seconds.
    struct StatsSample:
        takenAtMs: int
        takenAt: int
        takenAtNanos: int
        readsTotal: int
        writesTotal: int
        nodeCount: int
        edgeCount: int
        hasCpuSecondsTotal: bool
        cpuSecondsTotal: float
        hasCpuCores: bool
        cpuCores: int
        hasMemoryUtilization: bool
        memoryUtilization: float
        hasReadLatencyP99Us: bool
        readLatencyP99Us: int
        hasWriteLatencyP99Us: bool
        writeLatencyP99Us: int
        inFlight: int
        maxConcurrent: int
        cells: [CellStats]
        overflowReads: int
        overflowWrites: int

    # statsSampleTake: `StatsSample::take` — every field a straight
    # projection off the wire response, except the two clock stamps (see
    # this file's header).
    # StatsSample::take with the two clock readings passed in: `takenAtMs`
    # epoch milliseconds (labelling), `takenAtNanos` a monotonic reading
    # (measuring); statsSampleTake below stamps them from now() and
    # monoMs().
    proc statsSampleTakeAt(stats: EngineStats, takenAtMs: int, takenAtNanos: int) -> StatsSample:
        return StatsSample{takenAtMs: takenAtMs, takenAt: takenAtNanos / 1000000000, takenAtNanos: takenAtNanos, readsTotal: stats.readsTotal, writesTotal: stats.writesTotal, nodeCount: stats.nodeCount, edgeCount: stats.edgeCount, hasCpuSecondsTotal: stats.runtime.process.hasCpuSecondsTotal, cpuSecondsTotal: stats.runtime.process.cpuSecondsTotal, hasCpuCores: stats.runtime.process.hasCpuCores, cpuCores: stats.runtime.process.cpuCores, hasMemoryUtilization: stats.runtime.process.hasMemoryUtilization, memoryUtilization: stats.runtime.process.memoryUtilization, hasReadLatencyP99Us: stats.runtime.window.readLatency.hasP99Us, readLatencyP99Us: stats.runtime.window.readLatency.p99Us, hasWriteLatencyP99Us: stats.runtime.window.writeLatency.hasP99Us, writeLatencyP99Us: stats.runtime.window.writeLatency.p99Us, inFlight: stats.runtime.requests.inFlight, maxConcurrent: stats.runtime.requests.maxConcurrent, cells: stats.cells.cells, overflowReads: stats.cells.overflowReads, overflowWrites: stats.cells.overflowWrites}

    # StatsSample::take: the label from the wall clock (now(), whole
    # seconds, in ms), elapsed time from the monotonic millisecond clock.
    proc statsSampleTake(stats: EngineStats) -> StatsSample:
        let mono = monoMs()
        let s = do statsSampleTakeAt(stats, now() * 1000, mono * 1000000)
        return s

    proc statsSaturatingSub(a: int, b: int) -> int:
        return max(a - b, 0)

    # statsCellIndexOf: linear search for the coordinate key `cell_breakdown`
    # keys its `HashMap` by (`x`,`y`,`z`,`q`) — this directory's established
    # no-native-map substitute (fabric_core.fct's `ShardStorage`,
    # fabric_telemetry.fct's `WorkloadAnalyzer`), returning -1 for "not
    # found" as those files' own index-of helpers do.
    private proc statsCellIndexOf(cells: [CellStats], x: int, y: int, z: int, q: int) -> int:
        let n = len(cells)
        let mut i = 0
        let mut found = -1
        loop i < n:
            if found == -1:
                if cells[i].x == x && cells[i].y == y && cells[i].z == z && cells[i].q == q:
                    found = i
            i = i + 1
        return found

    # statsCellBusyness / statsSortCellBreakdownBusiestFirst: `cell_breakdown`'s
    # `sort_by(|a,b| busy_b.partial_cmp(&busy_a))` — busiest first. No sort
    # builtin exists in this language (`facet lang`'s own list), so this is
    # the same hand-written STABLE insertion sort idiom query.fct's
    # `sortRowsAscending` and fabric_replication.fct's
    # `replRecordArraySortByNodeAscending` already establish: only swap
    # strictly-out-of-order neighbors, which preserves relative order of
    # ties exactly like Rust's own stable `sort_by`.
    private proc statsCellBusyness(c: CellWorkloadMetrics) -> float:
        return c.readsPerSecond + c.writesPerSecond

    private proc statsSortCellBreakdownBusiestFirst(cells: [CellWorkloadMetrics]) -> [CellWorkloadMetrics]:
        let mut xs = cells
        let n = len(xs)
        let mut i = 1
        loop i < n:
            let mut j = i
            loop j > 0:
                let busyPrev = do statsCellBusyness(xs[j - 1])
                let busyCur = do statsCellBusyness(xs[j])
                if busyPrev < busyCur:
                    let tmp = xs[j - 1]
                    xs[j - 1] = xs[j]
                    xs[j] = tmp
                    j = j - 1
                else:
                    break
            i = i + 1
        return xs

    struct CellBreakdownResult:
        cells: [CellWorkloadMetrics]
        partial: bool

    # statsCellBreakdown: `cell_breakdown` verbatim — a coordinate present in
    # `after` but not `before` deltas its WHOLE count (the table starts every
    # coordinate at zero); `saturating_sub` throughout defends against a
    # delta ever going backward, even though only the whole-process restart
    # the caller already checks could cause that; overflow non-zero on
    # `after` alone marks the whole breakdown partial, per the wire type's
    # own "current state of completeness" docs.
    private proc statsCellBreakdown(before: StatsSample, after: StatsSample, seconds: float) -> CellBreakdownResult:
        let n = len(after.cells)
        let mut i = 0
        let mut cells = []
        loop i < n:
            let cell = after.cells[i]
            let idx = do statsCellIndexOf(before.cells, cell.x, cell.y, cell.z, cell.q)
            let mut prevReads = 0
            let mut prevWrites = 0
            let mut prevBytesRead = 0
            let mut prevBytesWritten = 0
            if idx != -1:
                prevReads = before.cells[idx].reads
                prevWrites = before.cells[idx].writes
                prevBytesRead = before.cells[idx].bytesRead
                prevBytesWritten = before.cells[idx].bytesWritten
            let reads = do statsSaturatingSub(cell.reads, prevReads)
            let writes = do statsSaturatingSub(cell.writes, prevWrites)
            let bytesRead = do statsSaturatingSub(cell.bytesRead, prevBytesRead)
            let bytesWritten = do statsSaturatingSub(cell.bytesWritten, prevBytesWritten)
            let metrics = CellWorkloadMetrics{x: cell.x, y: cell.y, z: cell.z, q: cell.q, readsPerSecond: toFloat(reads) / seconds, writesPerSecond: toFloat(writes) / seconds, bytesReadPerSecond: toFloat(bytesRead) / seconds, bytesWrittenPerSecond: toFloat(bytesWritten) / seconds}
            cells = append(cells, metrics)
            i = i + 1
        let sorted = do statsSortCellBreakdownBusiestFirst(cells)
        let partial = after.overflowReads > 0 || after.overflowWrites > 0
        return CellBreakdownResult{cells: sorted, partial: partial}

    # statsCpuUtilization: `cpu_utilization` verbatim — absent inputs or a
    # backwards counter (a restart the top-level check did not happen to
    # catch) both read as 0.0, the module's own "absent reads as low
    # pressure" convention; `clampFloat` is reused from the
    # fabric_telemetry.fct import rather than redeclared.
    private proc statsCpuUtilization(before: StatsSample, after: StatsSample, seconds: float) -> float:
        if !before.hasCpuSecondsTotal || !after.hasCpuSecondsTotal || !after.hasCpuCores:
            return 0.0
        if after.cpuCores == 0:
            return 0.0
        let cpuSeconds = after.cpuSecondsTotal - before.cpuSecondsTotal
        if cpuSeconds < 0.0:
            return 0.0
        let raw = cpuSeconds / (seconds * toFloat(after.cpuCores))
        let clamped = do clampFloat(raw, 0.0, 1.0)
        return clamped

    # statsQueuePressureUnits: `queue_pressure_units` verbatim — projects
    # `in_flight / max_concurrent` onto the 0..10_000 scale
    # `calculate_pressure` already treats as queue pressure's abstract unit.
    private proc statsQueuePressureUnits(inFlight: int, maxConcurrent: int) -> int:
        if maxConcurrent == 0:
            return 0
        let raw = toFloat(inFlight) / toFloat(maxConcurrent)
        let saturation = do clampFloat(raw, 0.0, 1.0)
        let scaled = saturation * 10000.0
        let rounded = round(scaled)
        return rounded

    struct WorkloadMetricsOption:
        has: bool
        metrics: WorkloadMetrics

    # statsSampleDifference: `StatsSample::difference` verbatim — `has:
    # false` covers both real "no interval" cases the real doc comment
    # names: a counter gone backwards (a restart) and a non-positive elapsed
    # time (a same-instant pair). `readLatencyUs`/`writeLatencyUs`/`memoryUtilization` fall back
    # to 0.0 on an absent optional, the same "absent reads as low pressure"
    # convention `statsCpuUtilization` already uses.
    proc statsSampleDifference(current: StatsSample, next: StatsSample) -> WorkloadMetricsOption:
        let zero = do workloadMetricsDefault()
        let none = WorkloadMetricsOption{has: false, metrics: zero}
        if next.readsTotal < current.readsTotal || next.writesTotal < current.writesTotal:
            return none
        let elapsed = max(next.takenAtNanos - current.takenAtNanos, 0)
        let seconds = toFloat(elapsed / 1000000000) + toFloat(elapsed % 1000000000) / 1000000000.0
        if seconds <= 0.0:
            return none
        let readsPerSecond = toFloat(next.readsTotal - current.readsTotal) / seconds
        let writesPerSecond = toFloat(next.writesTotal - current.writesTotal) / seconds
        let breakdown = do statsCellBreakdown(current, next, seconds)
        let mut readLatencyUs = 0.0
        if next.hasReadLatencyP99Us:
            readLatencyUs = toFloat(next.readLatencyP99Us)
        let mut writeLatencyUs = 0.0
        if next.hasWriteLatencyP99Us:
            writeLatencyUs = toFloat(next.writeLatencyP99Us)
        let cpu = do statsCpuUtilization(current, next, seconds)
        let mut memoryUtilization = 0.0
        if next.hasMemoryUtilization:
            memoryUtilization = next.memoryUtilization
        let queueDepth = do statsQueuePressureUnits(next.inFlight, next.maxConcurrent)
        let metrics = WorkloadMetrics{operationsPerSecond: readsPerSecond + writesPerSecond, readsPerSecond: readsPerSecond, writesPerSecond: writesPerSecond, readLatencyUs: readLatencyUs, writeLatencyUs: writeLatencyUs, cpuUtilization: cpu, memoryUtilization: memoryUtilization, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: queueDepth, cellBreakdown: breakdown.cells, cellBreakdownPartial: breakdown.partial}
        return WorkloadMetricsOption{has: true, metrics: metrics}

    struct RatioPair:
        read: float
        write: float

    # statsRatios: `ratios` verbatim — reuses the imported
    # `workloadMetricsTotalOperations` rather than re-deriving
    # `reads_per_second + writes_per_second` a second time.
    proc statsRatios(metrics: WorkloadMetrics) -> RatioPair:
        let total = do workloadMetricsTotalOperations(metrics)
        if total > 0.0:
            let readRatio = metrics.readsPerSecond / total
            let writeRatio = metrics.writesPerSecond / total
            return RatioPair{read: readRatio, write: writeRatio}
        return RatioPair{read: 0.0, write: 0.0}

    # ============================================================
    # TEST FIXTURES restated as plain constructors — sample.rs's own
    # `#[cfg(test)]` helpers `sample()`/`cell()`, verbatim.
    # ============================================================
    # sample.rs's test fixture `sample(taken_at, reads, writes)`, taken_at in
    # whole seconds.
    proc statsSampleFixture(takenAt: int, reads: int, writes: int) -> StatsSample:
        return StatsSample{takenAtMs: 0, takenAt: takenAt, takenAtNanos: takenAt * 1000000000, readsTotal: reads, writesTotal: writes, nodeCount: 0, edgeCount: 0, hasCpuSecondsTotal: false, cpuSecondsTotal: 0.0, hasCpuCores: false, cpuCores: 0, hasMemoryUtilization: false, memoryUtilization: 0.0, hasReadLatencyP99Us: false, readLatencyP99Us: 0, hasWriteLatencyP99Us: false, writeLatencyP99Us: 0, inFlight: 0, maxConcurrent: 0, cells: [], overflowReads: 0, overflowWrites: 0}

    # The same fixture at a monotonic nanosecond reading.
    proc statsSampleFixtureAt(takenAtNanos: int, reads: int, writes: int) -> StatsSample:
        let mut s = do statsSampleFixture(0, reads, writes)
        s.takenAtNanos = takenAtNanos
        s.takenAt = takenAtNanos / 1000000000
        return s

    proc statsCellFixture(x: int, reads: int, writes: int, bytesRead: int, bytesWritten: int) -> CellStats:
        return CellStats{x: x, y: 0, z: 0, q: 0, reads: reads, writes: writes, bytesRead: bytesRead, bytesWritten: bytesWritten}
