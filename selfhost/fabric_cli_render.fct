import "fabric_core.fct"
import "fabric_optimizer.fct"
import "fabric_telemetry.fct"
import "fabric_routing.fct"
import "fabric_json.fct"
import "fabric_fmt.fct"

app FabricCliRenderSelfHost:
    # Port of fabric/crates/fabric-cli/src/render.rs: the four row/summary
    # types, pressure_label, action_label, and every render_* function in
    # both modes — the human table (Rust's format! width/precision
    # directives, reproduced exactly: `{:<N}`/`{:>N}` pad by characters,
    # `{:.N}` is the exact decimal value of the f64 rounded half-to-even,
    # see fabric_fmt.fct's fmtFixed) and `--json` (serde_json::to_string_pretty of the
    # underlying derived types, via fabric_json's encoders and sjPretty).
    # args.rs/main.rs/session.rs are process I/O and are not ported here.
    #
    # `Option<u64>` fields use the has*/value convention; PressureLevel is
    # the lower-case tag fabric_telemetry.fct carries.

    struct StatusSummary:
        placements: int
        profiles: int
        observations: int
        hotCoordinates: int
        gridWidth: int
        gridHeight: int
        gridAtoms: int
        protocolMajor: int
        protocolMinor: int

    struct PredictionRow:
        coordinate: Coordinate
        hotspotProbability: float
        likelyHot: bool
        anomalyScore: float
        anomalous: bool

    struct NodeRow:
        dbmsId: text
        region: text
        softwareVersion: text
        registeredAtMs: int
        hasLastHeartbeatMs: bool
        lastHeartbeatMs: int
        hasSilenceMs: bool
        silenceMs: int
        heartbeats: int
        health: text

    struct ValidationIssue:
        coordinate: Coordinate
        reason: text

    # render.rs `coord`: "(x,y)".
    proc coordText(c: Coordinate) -> text:
        return "(" + c.x + "," + c.y + ")"

    proc yesNo(b: bool) -> text:
        if b:
            return "yes"
        return "no"

    # ============================================================
    # labels
    # ============================================================
    proc pressureLabel(level: text) -> text:
        if level == "critical":
            return "critical"
        if level == "high":
            return "high"
        if level == "elevated":
            return "elevated"
        return "normal"

    proc actionLabel(action: OptimizationAction) -> text:
        if action.kind == "Replicate":
            return "replicate -> " + action.target
        if action.kind == "Move":
            return "move -> " + action.target
        if action.kind == "Split":
            return "split"
        if action.kind == "Isolate":
            return "isolate"
        if action.kind == "Colocate":
            return "colocate -> " + coordText(action.coordinate)
        return "no-action"

    # ============================================================
    # serde shapes of the render-only types
    # ============================================================
    proc statusSummaryJson(s: StatusSummary) -> text:
        return "{\"placements\":" + s.placements + ",\"profiles\":" + s.profiles + ",\"observations\":" + s.observations + ",\"hot_coordinates\":" + s.hotCoordinates + ",\"grid_width\":" + s.gridWidth + ",\"grid_height\":" + s.gridHeight + ",\"grid_atoms\":" + s.gridAtoms + ",\"protocol_major\":" + s.protocolMajor + ",\"protocol_minor\":" + s.protocolMinor + "}"

    proc predictionRowJson(r: PredictionRow) -> text:
        return "{\"coordinate\":" + coordinateJson(r.coordinate) + ",\"hotspot_probability\":" + sjF64Text(r.hotspotProbability) + ",\"likely_hot\":" + sjBoolText(r.likelyHot) + ",\"anomaly_score\":" + sjF64Text(r.anomalyScore) + ",\"anomalous\":" + sjBoolText(r.anomalous) + "}"

    proc nodeRowJson(r: NodeRow) -> text:
        let mut last = "null"
        if r.hasLastHeartbeatMs:
            last = sjU64Text(r.lastHeartbeatMs)
        let mut silence = "null"
        if r.hasSilenceMs:
            silence = sjU64Text(r.silenceMs)
        return "{\"dbms_id\":" + sjQuote(r.dbmsId) + ",\"region\":" + sjQuote(r.region) + ",\"software_version\":" + sjQuote(r.softwareVersion) + ",\"registered_at_ms\":" + sjU64Text(r.registeredAtMs) + ",\"last_heartbeat_ms\":" + last + ",\"silence_ms\":" + silence + ",\"heartbeats\":" + sjU64Text(r.heartbeats) + ",\"health\":" + sjQuote(r.health) + "}"

    proc validationIssueJson(i: ValidationIssue) -> text:
        return "{\"coordinate\":" + coordinateJson(i.coordinate) + ",\"reason\":" + sjQuote(i.reason) + "}"

    # ============================================================
    # render_*
    # ============================================================
    proc renderStatus(summary: StatusSummary, json: bool) -> text:
        if json:
            return sjPretty(statusSummaryJson(summary))
        let mut out = "Facet Fabric runtime status\n"
        out = out + "  protocol version   " + summary.protocolMajor + "." + summary.protocolMinor + "\n"
        out = out + "  grid geometry      " + summary.gridWidth + "x" + summary.gridHeight + " (" + summary.gridAtoms + " atoms)\n"
        out = out + "  placements         " + summary.placements + "\n"
        out = out + "  workload profiles  " + summary.profiles + "\n"
        out = out + "  observations       " + summary.observations + "\n"
        out = out + "  hot coordinates    " + summary.hotCoordinates + "\n"
        return out

    proc renderTopology(placements: [Placement], json: bool) -> text:
        let n = len(placements)
        if json:
            let mut parts = []
            let mut j = 0
            loop j < n:
                parts = append(parts, placementJson(placements[j]))
                j = j + 1
            return sjPretty("[" + join(parts, ",") + "]")
        if n == 0:
            return "No placements. Topology registry is empty."
        let mut out = "Topology: " + n + " placement(s)\n"
        out = out + "  COORD    SHARD  REGION            DBMS\n"
        let mut i = 0
        loop i < n:
            let p = placements[i]
            out = out + "  " + fmtPadRight(coordText(p.coordinate), 7) + "  " + fmtPadRight(sjU64Text(p.shardId), 5) + "  " + fmtPadRight(p.region, 16) + "  " + p.dbmsId + "\n"
            i = i + 1
        return out

    proc renderWorkload(profiles: [WorkloadProfile], json: bool) -> text:
        let n = len(profiles)
        if json:
            let mut parts = []
            let mut j = 0
            loop j < n:
                parts = append(parts, workloadProfileJson(profiles[j]))
                j = j + 1
            return sjPretty("[" + join(parts, ",") + "]")
        if n == 0:
            return "No workload profiles. No telemetry has been ingested."
        let mut out = "Workload: " + n + " profile(s)\n"
        out = out + "  COORD    OPS/S       READ%  WRITE%  PRESSURE   HOT\n"
        let mut i = 0
        loop i < n:
            let p = profiles[i]
            let hot = workloadProfileIsHot(p)
            out = out + "  " + fmtPadRight(coordText(p.coordinate), 7) + "  " + fmtPadLeft(fmtFixed(p.operationsPerSecond, 1), 10) + "  " + fmtPadLeft(fmtFixed(p.readRatio * 100.0, 0), 5) + "  " + fmtPadLeft(fmtFixed(p.writeRatio * 100.0, 0), 6) + "  " + fmtPadRight(pressureLabel(p.pressure), 9) + "  " + yesNo(hot) + "\n"
            i = i + 1
        return out

    proc renderMetrics(observations: [Observation], json: bool) -> text:
        let n = len(observations)
        if json:
            let mut parts = []
            let mut j = 0
            loop j < n:
                parts = append(parts, observationJson(observations[j]))
                j = j + 1
            return sjPretty("[" + join(parts, ",") + "]")
        if n == 0:
            return "No metrics. No observations recorded."
        let mut out = "Metrics: " + n + " observation(s)\n"
        out = out + "  COORD    SHARD  OPS/S       CPU    MEM    QUEUE\n"
        let mut i = 0
        loop i < n:
            let o = observations[i]
            let m = o.metrics
            out = out + "  " + fmtPadRight(coordText(o.coordinate), 7) + "  " + fmtPadRight(sjU64Text(o.shard.id), 5) + "  " + fmtPadLeft(fmtFixed(workloadMetricsTotalOperations(m), 1), 10) + "  " + fmtPadLeft(fmtFixed(m.cpuUtilization * 100.0, 0), 4) + "%  " + fmtPadLeft(fmtFixed(m.memoryUtilization * 100.0, 0), 4) + "%  " + fmtPadLeft(sjU64Text(m.queueDepth), 6) + "\n"
            i = i + 1
        return out

    proc renderPlacement(decisions: [OptimizationDecision], json: bool) -> text:
        let n = len(decisions)
        if json:
            let mut parts = []
            let mut j = 0
            loop j < n:
                parts = append(parts, optimizationDecisionJson(decisions[j]))
                j = j + 1
            return sjPretty("[" + join(parts, ",") + "]")
        if n == 0:
            return "No placement decisions. No workload profiles to optimize."
        let mut out = "Placement: " + n + " decision(s)\n"
        out = out + "  COORD    ACTION                 GAIN   COST   SCORE   CONF   EXECUTE\n"
        let mut i = 0
        loop i < n:
            let d = decisions[i]
            let exec = optimizationDecisionShouldExecute(d)
            out = out + "  " + fmtPadRight(coordText(d.coordinate), 7) + "  " + fmtPadRight(actionLabel(d.action), 21) + "  " + fmtPadLeft(fmtFixed(d.expectedGain, 2), 4) + "   " + fmtPadLeft(fmtFixed(d.estimatedCost, 2), 4) + "   " + fmtPadLeft(fmtFixed(optimizationDecisionScore(d), 2), 5) + "   " + fmtPadLeft(fmtFixed(d.confidence, 2), 4) + "   " + yesNo(exec) + "\n"
            i = i + 1
        return out

    proc renderPredict(rows: [PredictionRow], json: bool) -> text:
        let n = len(rows)
        if json:
            let mut parts = []
            let mut j = 0
            loop j < n:
                parts = append(parts, predictionRowJson(rows[j]))
                j = j + 1
            return sjPretty("[" + join(parts, ",") + "]")
        if n == 0:
            return "No predictions. No workload profiles to score."
        let mut out = "Predict: " + n + " profile(s)\n"
        out = out + "  COORD    HOTSPOT  LIKELY-HOT  ANOMALY  ANOMALOUS\n"
        let mut i = 0
        loop i < n:
            let r = rows[i]
            out = out + "  " + fmtPadRight(coordText(r.coordinate), 7) + "  " + fmtPadLeft(fmtFixed(r.hotspotProbability, 2), 7) + "  " + fmtPadRight(yesNo(r.likelyHot), 10) + "  " + fmtPadLeft(fmtFixed(r.anomalyScore, 2), 7) + "  " + yesNo(r.anomalous) + "\n"
            i = i + 1
        return out

    proc renderNodes(rows: [NodeRow], nowMs: int, deadlineMs: int, json: bool) -> text:
        let n = len(rows)
        if json:
            let mut parts = []
            let mut j = 0
            loop j < n:
                parts = append(parts, nodeRowJson(rows[j]))
                j = j + 1
            return sjPretty("[" + join(parts, ",") + "]")
        if n == 0:
            return "No nodes. Nothing has registered with the runtime."
        let mut out = "Nodes: " + n + " registered (as of t=" + sjU64Text(nowMs) + "ms, deadline " + sjU64Text(deadlineMs) + "ms)\n"
        out = out + "  DBMS              REGION            VERSION   BEATS  SILENT       HEALTH\n"
        let mut i = 0
        loop i < n:
            let row = rows[i]
            let mut silent = "never"
            if row.hasSilenceMs:
                silent = sjU64Text(row.silenceMs) + "ms"
            out = out + "  " + fmtPadRight(row.dbmsId, 16) + "  " + fmtPadRight(row.region, 16) + "  " + fmtPadRight(row.softwareVersion, 8) + "  " + fmtPadLeft(sjU64Text(row.heartbeats), 5) + "  " + fmtPadRight(silent, 11) + "  " + row.health + "\n"
            i = i + 1
        return out

    proc renderValidation(issues: [ValidationIssue], json: bool) -> text:
        let n = len(issues)
        if json:
            let mut parts = []
            let mut j = 0
            loop j < n:
                parts = append(parts, validationIssueJson(issues[j]))
                j = j + 1
            return sjPretty("[" + join(parts, ",") + "]")
        if n == 0:
            return "Valid. Every ingested coordinate is within the grid."
        let mut out = "Invalid: " + n + " out-of-grid coordinate(s)\n"
        let mut i = 0
        loop i < n:
            out = out + "  " + issues[i].reason + "\n"
            i = i + 1
        return out
