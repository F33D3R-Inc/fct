import "fabric_core.fct"
import "fabric.fct"

app FabricMigrationPlanSelfHost:
    # Self-hosting port of fabric/crates/fabric-migration: plan.rs
    # (MigrationId, MigrationReason, MigrationPlan::new /
    # with_max_cutover_pending_writes, DEFAULT_MAX_CUTOVER_PENDING_WRITES),
    # progress.rs (MigrationProgress), phase.rs's label / PhaseTransition,
    # and migration.rs's stateful Migration with MigrationError's Display
    # and MigrationStatus. Phases are fabric.fct's ints (0=Planned 1=Copying
    # 2=CatchingUp 3=Cutover 4=Cleanup 5=Completed 6=Aborted 7=Failed) and
    # its phase table procs are reused. Conformance:
    # fabric_leaf_b_test.go's TestFabricLeafBMigration.

    # ------------------------------------------------------------
    # plan.rs
    # ------------------------------------------------------------
    proc migrationDefaultMaxCutoverPendingWrites() -> int:
        return 64

    struct MigrationId:
        value: int

    # migrationIdLabel: MigrationId's Display impl, `"migration-{}"`.
    proc migrationIdLabel(id: MigrationId) -> text:
        return "migration-" + u64Text(id.value)

    # MigrationReason: recorded, never acted on by this crate (the crate doc
    # says so directly), so — like MigrationPlan — only the one real method
    # (`label`) is decision-shaped; the rest is inert data along for the
    # ride. tag: 0=Hotspot 1=Rebalance 2=DrainNode 3=RegionLocality
    # 4=CapacityPressure 5=Operator, mirroring fabric.fct's own phase-as-int
    # convention. Only the field matching the active tag is meaningful on
    # any given value; pressureScore is 0.0 and targetRegion/note are ""
    # on every variant that does not carry them.
    struct MigrationReason:
        tag: int
        pressureScore: float
        targetRegion: text
        note: text

    proc migrationReasonHotspot(pressureScore: float) -> MigrationReason:
        return MigrationReason{tag: 0, pressureScore: pressureScore, targetRegion: "", note: ""}

    proc migrationReasonRebalance() -> MigrationReason:
        return MigrationReason{tag: 1, pressureScore: 0.0, targetRegion: "", note: ""}

    proc migrationReasonDrainNode() -> MigrationReason:
        return MigrationReason{tag: 2, pressureScore: 0.0, targetRegion: "", note: ""}

    proc migrationReasonRegionLocality(targetRegion: text) -> MigrationReason:
        return MigrationReason{tag: 3, pressureScore: 0.0, targetRegion: targetRegion, note: ""}

    proc migrationReasonCapacityPressure() -> MigrationReason:
        return MigrationReason{tag: 4, pressureScore: 0.0, targetRegion: "", note: ""}

    proc migrationReasonOperator(note: text) -> MigrationReason:
        return MigrationReason{tag: 5, pressureScore: 0.0, targetRegion: "", note: note}

    # migrationReasonLabel: `MigrationReason::label`, restated arm for arm in
    # the same order.
    proc migrationReasonLabel(reason: MigrationReason) -> text:
        if reason.tag == 0:
            return "hotspot"
        if reason.tag == 1:
            return "rebalance"
        if reason.tag == 2:
            return "drain-node"
        if reason.tag == 3:
            return "region-locality"
        if reason.tag == 4:
            return "capacity-pressure"
        return "operator"

    # ------------------------------------------------------------
    # progress.rs
    # ------------------------------------------------------------
    struct MigrationProgress:
        atomsTotal: int
        atomsCopied: int
        bytesCopied: int
        pendingWrites: int
        phaseStartedAtMs: int
        updatedAtMs: int

    proc migrationProgressNew(atomsTotal: int, startedAtMs: int) -> MigrationProgress:
        return MigrationProgress{atomsTotal: atomsTotal, atomsCopied: 0, bytesCopied: 0, pendingWrites: 0, phaseStartedAtMs: startedAtMs, updatedAtMs: startedAtMs}

    proc migrationProgressCopyFraction(progress: MigrationProgress) -> float:
        if progress.atomsTotal == 0:
            return 1.0
        return u64ToFloat(progress.atomsCopied) / u64ToFloat(progress.atomsTotal)

    proc migrationProgressIsCopyComplete(progress: MigrationProgress) -> bool:
        return u64Cmp(progress.atomsCopied, progress.atomsTotal) >= 0

    # migrationProgressOverallFraction: `overall_fraction` restated arm for
    # arm — `phase` is the 0..7 int convention documented above, NOT a type
    # of this file's own (there is none; see header).
    proc migrationProgressOverallFraction(progress: MigrationProgress, phase: int) -> float:
        let copyFraction = do migrationProgressCopyFraction(progress)
        if phase == 0:
            return 0.0
        if phase == 1:
            return copyFraction * 0.80
        if phase == 2:
            return 0.85
        if phase == 3:
            return 0.95
        if phase == 4:
            return 0.98
        if phase == 5:
            return 1.0
        return copyFraction * 0.80

    # migrationProgressPhaseAgeMs: `phase_age_ms`'s `saturating_sub` — never
    # negative even if `now_ms` is (wrongly) earlier than the phase start.
    proc migrationProgressPhaseAgeMs(progress: MigrationProgress, nowMs: int) -> int:
        return u64SatSub(nowMs, progress.phaseStartedAtMs)

    # ============================================================
    # migration.rs — the stateful `Migration` (plan + phase + progress +
    # write-sequence marks + fence + outcome + history), phase.rs's
    # `label`/`PhaseTransition`, plan.rs's `MigrationPlan::new` /
    # `with_max_cutover_pending_writes`, and `MigrationError` with its
    # Display text. Functional-update API: every Rust `&mut self` method
    # returns a result struct {ok, err, value} whose `value` is the
    # migration after the call (the unchanged input on an error, exactly
    # like Rust, whose methods check before they mutate).
    #
    # Phases are fabric.fct's ints (0=Planned 1=Copying 2=CatchingUp
    # 3=Cutover 4=Cleanup 5=Completed 6=Aborted 7=Failed) and its
    # phaseCanAdvanceTo / phaseIsTerminal / phaseAllowsAbort / phaseIsFenced
    # are reused, not restated. A Rust u64 (ids, write sequences, counts,
    # clocks) is an int's 64-bit pattern, compared, maxed, subtracted and
    # displayed with the u64 builtins (runtime/u64.go); so every u64 value
    # is a legal int, and an `Option<u64>` is a `hasX` flag beside its value
    # (the value's content is meaningless when the flag is false).
    # ============================================================

    proc migrationPhaseLabel(phase: int) -> text:
        if phase == 0:
            return "planned"
        if phase == 1:
            return "copying"
        if phase == 2:
            return "catching-up"
        if phase == 3:
            return "cutover"
        if phase == 4:
            return "cleanup"
        if phase == 5:
            return "completed"
        if phase == 6:
            return "aborted"
        return "failed"

    # `impl Display for WriteSeq`: "#{n}".
    proc migrationWriteSeqLabel(seq: int) -> text:
        return "#" + u64Text(seq)

    struct PhaseTransition:
        fromPhase: int
        toPhase: int
        atMs: int
        hasNote: bool
        note: text

    struct CutoverFence:
        atMs: int
        hasLastWrite: bool
        lastWrite: int

    # MigrationOutcome: kind "completed" | "aborted" | "failed"; `detail` is
    # the Aborted `reason` / Failed `error` ("" for Completed).
    struct MigrationOutcome:
        kind: text
        atMs: int
        detail: text

    struct MigrationPlan:
        id: MigrationId
        shardId: int
        source: text
        destination: text
        reason: MigrationReason
        createdAtMs: int
        atoms: int
        maxCutoverPendingWrites: int

    # MigrationError: `kind` is the Rust variant name. Only the fields the
    # variant carries are meaningful; the rest stay 0/"" (highWater -1 is
    # UnknownWrite's `None`).
    struct MigrationError:
        kind: text
        node: text
        fromPhase: int
        toPhase: int
        expected: int
        actual: int
        copied: int
        total: int
        pending: int
        allowed: int
        shardId: int
        source: text
        destination: text
        seq: int
        hasHighWater: bool
        highWater: int
        applied: int
        phase: int

    proc migrationErrorNone() -> MigrationError:
        return MigrationError{kind: "", node: "", fromPhase: 0, toPhase: 0, expected: 0, actual: 0, copied: 0, total: 0, pending: 0, allowed: 0, shardId: 0, source: "", destination: "", seq: 0, hasHighWater: false, highWater: 0, applied: 0, phase: 0}

    private proc migrationErrorOf(kind: text) -> MigrationError:
        let mut e = do migrationErrorNone()
        e.kind = kind
        return e

    # `impl Display for MigrationError`, arm for arm.
    proc migrationErrorDisplay(e: MigrationError) -> text:
        if e.kind == "SameSourceAndDestination":
            return "source and destination are both '" + e.node + "'"
        if e.kind == "InvalidTransition":
            let f = do migrationPhaseLabel(e.fromPhase)
            let t = do migrationPhaseLabel(e.toPhase)
            return "a migration cannot go from " + f + " to " + t
        if e.kind == "WrongPhase":
            let x = do migrationPhaseLabel(e.expected)
            let a = do migrationPhaseLabel(e.actual)
            return "operation requires phase " + x + ", migration is " + a
        if e.kind == "CopyIncomplete":
            return "only " + u64Text(e.copied) + " of " + u64Text(e.total) + " atoms have been copied"
        if e.kind == "ProgressExceedsTotal":
            return "reported " + u64Text(e.copied) + " atoms copied, the shard has " + u64Text(e.total)
        if e.kind == "ProgressWentBackwards":
            return "reported " + u64Text(e.copied) + " atoms copied, " + u64Text(e.total) + " were already recorded"
        if e.kind == "NotCaughtUp":
            return u64Text(e.pending) + " writes still unapplied, cutover allows at most " + u64Text(e.allowed)
        if e.kind == "WriteFenced":
            return "shard " + u64Text(e.shardId) + " is fenced for cutover from '" + e.source + "' to '" + e.destination + "'; retry"
        if e.kind == "NonMonotonicWrite":
            let s = do migrationWriteSeqLabel(e.seq)
            let h = do migrationWriteSeqLabel(e.highWater)
            return "write " + s + " is not past the high-water mark " + h
        if e.kind == "WriteAlreadyApplied":
            let s = do migrationWriteSeqLabel(e.seq)
            let a = do migrationWriteSeqLabel(e.applied)
            return "write " + s + " was already applied (destination is at " + a + ")"
        if e.kind == "UnknownWrite":
            let s = do migrationWriteSeqLabel(e.seq)
            if !e.hasHighWater:
                return "write " + s + " was never accepted by the source"
            let h = do migrationWriteSeqLabel(e.highWater)
            return "write " + s + " was never accepted by the source (high-water " + h + ")"
        if e.kind == "CutoverNotDrained":
            return "cutover cannot complete with " + u64Text(e.pending) + " writes still unapplied"
        if e.kind == "AbortAfterCutover":
            let p = do migrationPhaseLabel(e.phase)
            return "cannot abort in phase " + p + ": authority has already moved"
        let p = do migrationPhaseLabel(e.phase)
        return "migration has already " + p

    struct MigrationPlanResult:
        ok: bool
        err: MigrationError
        plan: MigrationPlan

    # `MigrationPlan::new`: refuses a move onto the node the shard is on;
    # the atom count comes from the core model (`shard.atom_count()`).
    proc migrationPlanNew(id: MigrationId, shard: Shard, source: text, destination: text, reason: MigrationReason, createdAtMs: int) -> MigrationPlanResult:
        let atoms = do shardAtomCount(shard)
        let maxPending = do migrationDefaultMaxCutoverPendingWrites()
        let plan = MigrationPlan{id: id, shardId: shard.id, source: source, destination: destination, reason: reason, createdAtMs: createdAtMs, atoms: atoms, maxCutoverPendingWrites: maxPending}
        if source == destination:
            let mut e = do migrationErrorOf("SameSourceAndDestination")
            e.node = source
            return MigrationPlanResult{ok: false, err: e, plan: plan}
        let none = do migrationErrorNone()
        return MigrationPlanResult{ok: true, err: none, plan: plan}

    proc migrationPlanWithMaxCutoverPendingWrites(plan: MigrationPlan, writes: int) -> MigrationPlan:
        let mut p = plan
        p.maxCutoverPendingWrites = writes
        return p

    struct Migration:
        plan: MigrationPlan
        phase: int
        progress: MigrationProgress
        hasSourceHighWater: bool
        sourceHighWater: int
        hasDestinationApplied: bool
        destinationApplied: int
        hasFence: bool
        fence: CutoverFence
        hasCutOver: bool
        cutoverCompletedAtMs: int
        hasOutcome: bool
        outcome: MigrationOutcome
        history: [PhaseTransition]

    struct MigrationResult:
        ok: bool
        err: MigrationError
        value: Migration

    # route: "source" | "destination" (`WriteRoute`), "" on an error.
    struct MigrationWriteResult:
        ok: bool
        err: MigrationError
        value: Migration
        route: text

    proc migrationNew(plan: MigrationPlan) -> Migration:
        let progress = do migrationProgressNew(plan.atoms, plan.createdAtMs)
        return Migration{plan: plan, phase: 0, progress: progress, hasSourceHighWater: false, sourceHighWater: 0, hasDestinationApplied: false, destinationApplied: 0, hasFence: false, fence: CutoverFence{atMs: 0, hasLastWrite: false, lastWrite: 0}, hasCutOver: false, cutoverCompletedAtMs: 0, hasOutcome: false, outcome: MigrationOutcome{kind: "", atMs: 0, detail: ""}, history: []}

    proc migrationIsTerminal(m: Migration) -> bool:
        let t = do phaseIsTerminal(m.phase)
        return t

    # `pending_writes`: slots the source accepted that the destination has
    # not applied.
    proc migrationPendingWritesOf(m: Migration) -> int:
        if !m.hasSourceHighWater:
            return 0
        if !m.hasDestinationApplied:
            return m.sourceHighWater + 1
        return u64SatSub(m.sourceHighWater, m.destinationApplied)

    proc migrationHasCutOverOf(m: Migration) -> bool:
        return m.hasCutOver

    proc migrationIsWriteFencedOf(m: Migration) -> bool:
        let f = do phaseIsFenced(m.phase)
        return f

    # `read_owner`: never absent (invariant 1).
    proc migrationReadOwner(m: Migration) -> text:
        if m.hasCutOver:
            return m.plan.destination
        return m.plan.source

    struct MigrationOwner:
        has: bool
        node: text

    # `write_owner`: None while the fence is up.
    proc migrationWriteOwner(m: Migration) -> MigrationOwner:
        let fenced = do migrationIsWriteFencedOf(m)
        if fenced:
            return MigrationOwner{has: false, node: ""}
        let owner = do migrationReadOwner(m)
        return MigrationOwner{has: true, node: owner}

    private proc migrationOk(m: Migration) -> MigrationResult:
        let none = do migrationErrorNone()
        return MigrationResult{ok: true, err: none, value: m}

    private proc migrationFailWith(m: Migration, e: MigrationError) -> MigrationResult:
        return MigrationResult{ok: false, err: e, value: m}

    private proc migrationRequirePhase(m: Migration, expected: int) -> MigrationResult:
        if m.phase != expected:
            let mut e = do migrationErrorOf("WrongPhase")
            e.expected = expected
            e.actual = m.phase
            let r = do migrationFailWith(m, e)
            return r
        let r = do migrationOk(m)
        return r

    # `fn advance`: not terminal, the edge exists, then record the
    # transition and restart the phase clock.
    private proc migrationAdvance(m: Migration, to: int, atMs: int, hasNote: bool, note: text) -> MigrationResult:
        let terminal = do phaseIsTerminal(m.phase)
        if terminal:
            let mut e = do migrationErrorOf("AlreadyTerminal")
            e.phase = m.phase
            let r = do migrationFailWith(m, e)
            return r
        let can = do phaseCanAdvanceTo(m.phase, to)
        if !can:
            let mut e = do migrationErrorOf("InvalidTransition")
            e.fromPhase = m.phase
            e.toPhase = to
            let r = do migrationFailWith(m, e)
            return r
        let mut next = m
        next.history = append(m.history, PhaseTransition{fromPhase: m.phase, toPhase: to, atMs: atMs, hasNote: hasNote, note: note})
        next.phase = to
        let mut progress = m.progress
        progress.phaseStartedAtMs = atMs
        progress.updatedAtMs = u64Max(progress.updatedAtMs, atMs)
        next.progress = progress
        let r = do migrationOk(next)
        return r

    # `accept_write`: route one write, refusing a replay on either side of
    # the handover.
    proc migrationAcceptWrite(m: Migration, seq: int) -> MigrationWriteResult:
        let fenced = do migrationIsWriteFencedOf(m)
        if fenced:
            let mut e = do migrationErrorOf("WriteFenced")
            e.shardId = m.plan.shardId
            e.source = m.plan.source
            e.destination = m.plan.destination
            return MigrationWriteResult{ok: false, err: e, value: m, route: ""}
        if m.hasCutOver:
            if m.hasFence && m.fence.hasLastWrite && u64Cmp(seq, m.fence.lastWrite) <= 0:
                let mut e = do migrationErrorOf("WriteAlreadyApplied")
                e.seq = seq
                e.applied = m.fence.lastWrite
                return MigrationWriteResult{ok: false, err: e, value: m, route: ""}
            if m.hasDestinationApplied && u64Cmp(seq, m.destinationApplied) <= 0:
                let mut e = do migrationErrorOf("WriteAlreadyApplied")
                e.seq = seq
                e.applied = m.destinationApplied
                return MigrationWriteResult{ok: false, err: e, value: m, route: ""}
            let mut next = m
            next.hasDestinationApplied = true
            next.destinationApplied = seq
            let none = do migrationErrorNone()
            return MigrationWriteResult{ok: true, err: none, value: next, route: "destination"}
        if m.hasSourceHighWater && u64Cmp(seq, m.sourceHighWater) <= 0:
            let mut e = do migrationErrorOf("NonMonotonicWrite")
            e.seq = seq
            e.hasHighWater = true
            e.highWater = m.sourceHighWater
            return MigrationWriteResult{ok: false, err: e, value: m, route: ""}
        let mut next = m
        next.hasSourceHighWater = true
        next.sourceHighWater = seq
        let pending = do migrationPendingWritesOf(next)
        let mut progress = m.progress
        progress.pendingWrites = pending
        next.progress = progress
        let none = do migrationErrorNone()
        return MigrationWriteResult{ok: true, err: none, value: next, route: "source"}

    # `record_applied`: the destination applied the stream up to `seq`.
    proc migrationRecordApplied(m: Migration, seq: int, atMs: int) -> MigrationResult:
        if !m.hasSourceHighWater || u64Cmp(seq, m.sourceHighWater) > 0:
            let mut e = do migrationErrorOf("UnknownWrite")
            e.seq = seq
            e.hasHighWater = m.hasSourceHighWater
            e.highWater = m.sourceHighWater
            let r = do migrationFailWith(m, e)
            return r
        if m.hasDestinationApplied && u64Cmp(seq, m.destinationApplied) <= 0:
            let mut e = do migrationErrorOf("WriteAlreadyApplied")
            e.seq = seq
            e.applied = m.destinationApplied
            let r = do migrationFailWith(m, e)
            return r
        let mut next = m
        next.hasDestinationApplied = true
        next.destinationApplied = seq
        let pending = do migrationPendingWritesOf(next)
        let mut progress = m.progress
        progress.pendingWrites = pending
        progress.updatedAtMs = u64Max(progress.updatedAtMs, atMs)
        next.progress = progress
        let r = do migrationOk(next)
        return r

    proc migrationBeginCopy(m: Migration, atMs: int) -> MigrationResult:
        let r = do migrationAdvance(m, 1, atMs, false, "")
        return r

    # `record_copy`: cumulative, never decreasing.
    proc migrationRecordCopy(m: Migration, atomsCopied: int, bytesCopied: int, atMs: int) -> MigrationResult:
        let req = do migrationRequirePhase(m, 1)
        if !req.ok:
            return req
        if u64Cmp(atomsCopied, m.progress.atomsTotal) > 0:
            let mut e = do migrationErrorOf("ProgressExceedsTotal")
            e.copied = atomsCopied
            e.total = m.progress.atomsTotal
            let r = do migrationFailWith(m, e)
            return r
        if u64Cmp(atomsCopied, m.progress.atomsCopied) < 0:
            let mut e = do migrationErrorOf("ProgressWentBackwards")
            e.copied = atomsCopied
            e.total = m.progress.atomsCopied
            let r = do migrationFailWith(m, e)
            return r
        let mut next = m
        let mut progress = m.progress
        progress.atomsCopied = atomsCopied
        progress.bytesCopied = u64Max(progress.bytesCopied, bytesCopied)
        progress.updatedAtMs = u64Max(progress.updatedAtMs, atMs)
        next.progress = progress
        let r = do migrationOk(next)
        return r

    private proc migrationCopyIncomplete(m: Migration) -> MigrationResult:
        let mut e = do migrationErrorOf("CopyIncomplete")
        e.copied = m.progress.atomsCopied
        e.total = m.progress.atomsTotal
        let r = do migrationFailWith(m, e)
        return r

    proc migrationBeginCatchUp(m: Migration, atMs: int) -> MigrationResult:
        let req = do migrationRequirePhase(m, 1)
        if !req.ok:
            return req
        let complete = do migrationProgressIsCopyComplete(m.progress)
        if !complete:
            let r = do migrationCopyIncomplete(m)
            return r
        let r = do migrationAdvance(m, 2, atMs, false, "")
        return r

    # `restart_copy`: discard the destination copy and copy again.
    proc migrationRestartCopy(m: Migration, atMs: int, note: text) -> MigrationResult:
        let req = do migrationRequirePhase(m, 2)
        if !req.ok:
            return req
        let adv = do migrationAdvance(m, 1, atMs, true, note)
        if !adv.ok:
            return adv
        let mut next = adv.value
        let mut progress = next.progress
        progress.atomsCopied = 0
        progress.bytesCopied = 0
        next.hasDestinationApplied = false
        next.destinationApplied = 0
        let pending = do migrationPendingWritesOf(next)
        progress.pendingWrites = pending
        next.progress = progress
        let r = do migrationOk(next)
        return r

    # `begin_cutover`: fence the source, only with the gap inside budget.
    proc migrationBeginCutover(m: Migration, atMs: int) -> MigrationResult:
        let req = do migrationRequirePhase(m, 2)
        if !req.ok:
            return req
        let complete = do migrationProgressIsCopyComplete(m.progress)
        if !complete:
            let r = do migrationCopyIncomplete(m)
            return r
        let pending = do migrationPendingWritesOf(m)
        if u64Cmp(pending, m.plan.maxCutoverPendingWrites) > 0:
            let mut e = do migrationErrorOf("NotCaughtUp")
            e.pending = pending
            e.allowed = m.plan.maxCutoverPendingWrites
            let r = do migrationFailWith(m, e)
            return r
        let adv = do migrationAdvance(m, 3, atMs, false, "")
        if !adv.ok:
            return adv
        let mut next = adv.value
        next.hasFence = true
        next.fence = CutoverFence{atMs: atMs, hasLastWrite: m.hasSourceHighWater, lastWrite: m.sourceHighWater}
        let r = do migrationOk(next)
        return r

    # `complete_cutover`: authority moves only with the gap drained to zero.
    proc migrationCompleteCutover(m: Migration, atMs: int) -> MigrationResult:
        let req = do migrationRequirePhase(m, 3)
        if !req.ok:
            return req
        let pending = do migrationPendingWritesOf(m)
        if pending != 0:
            let mut e = do migrationErrorOf("CutoverNotDrained")
            e.pending = pending
            let r = do migrationFailWith(m, e)
            return r
        let adv = do migrationAdvance(m, 4, atMs, false, "")
        if !adv.ok:
            return adv
        let mut next = adv.value
        next.hasCutOver = true
        next.cutoverCompletedAtMs = atMs
        let r = do migrationOk(next)
        return r

    proc migrationComplete(m: Migration, atMs: int) -> MigrationResult:
        let req = do migrationRequirePhase(m, 4)
        if !req.ok:
            return req
        let adv = do migrationAdvance(m, 5, atMs, false, "")
        if !adv.ok:
            return adv
        let mut next = adv.value
        next.hasOutcome = true
        next.outcome = MigrationOutcome{kind: "completed", atMs: atMs, detail: ""}
        let r = do migrationOk(next)
        return r

    # `abort`: legal up to an uncompleted cutover; the fence comes down.
    proc migrationAbort(m: Migration, atMs: int, reason: text) -> MigrationResult:
        let terminal = do phaseIsTerminal(m.phase)
        if terminal:
            let mut e = do migrationErrorOf("AlreadyTerminal")
            e.phase = m.phase
            let r = do migrationFailWith(m, e)
            return r
        let allows = do phaseAllowsAbort(m.phase)
        if !allows:
            let mut e = do migrationErrorOf("AbortAfterCutover")
            e.phase = m.phase
            let r = do migrationFailWith(m, e)
            return r
        let adv = do migrationAdvance(m, 6, atMs, true, reason)
        if !adv.ok:
            return adv
        let mut next = adv.value
        next.hasFence = false
        next.fence = CutoverFence{atMs: 0, hasLastWrite: false, lastWrite: 0}
        next.hasDestinationApplied = false
        next.destinationApplied = 0
        let mut progress = next.progress
        progress.pendingWrites = 0
        next.progress = progress
        next.hasOutcome = true
        next.outcome = MigrationOutcome{kind: "aborted", atMs: atMs, detail: reason}
        let r = do migrationOk(next)
        return r

    # `fail`: ownership stays wherever the cutover left it.
    proc migrationFail(m: Migration, atMs: int, error: text) -> MigrationResult:
        let terminal = do phaseIsTerminal(m.phase)
        if terminal:
            let mut e = do migrationErrorOf("AlreadyTerminal")
            e.phase = m.phase
            let r = do migrationFailWith(m, e)
            return r
        let adv = do migrationAdvance(m, 7, atMs, true, error)
        if !adv.ok:
            return adv
        let mut next = adv.value
        next.hasOutcome = true
        next.outcome = MigrationOutcome{kind: "failed", atMs: atMs, detail: error}
        let r = do migrationOk(next)
        return r

    struct MigrationStatus:
        id: MigrationId
        shardId: int
        source: text
        destination: text
        phase: int
        atomsCopied: int
        atomsTotal: int
        bytesCopied: int
        pendingWrites: int
        fraction: float
        phaseAgeMs: int
        readOwner: text
        hasWriteOwner: bool
        writeOwner: text
        hasOutcome: bool
        outcome: MigrationOutcome

    # `status`: a flat snapshot; advances nothing.
    proc migrationStatus(m: Migration, nowMs: int) -> MigrationStatus:
        let pending = do migrationPendingWritesOf(m)
        let fraction = do migrationProgressOverallFraction(m.progress, m.phase)
        let age = do migrationProgressPhaseAgeMs(m.progress, nowMs)
        let readOwner = do migrationReadOwner(m)
        let writeOwner = do migrationWriteOwner(m)
        return MigrationStatus{id: m.plan.id, shardId: m.plan.shardId, source: m.plan.source, destination: m.plan.destination, phase: m.phase, atomsCopied: m.progress.atomsCopied, atomsTotal: m.progress.atomsTotal, bytesCopied: m.progress.bytesCopied, pendingWrites: pending, fraction: fraction, phaseAgeMs: age, readOwner: readOwner, hasWriteOwner: writeOwner.has, writeOwner: writeOwner.node, hasOutcome: m.hasOutcome, outcome: m.outcome}

    # ------------------------------------------------------------
    # DEMOS — hand-traced directly against plan.rs/progress.rs (neither has
    # its own crate unit tests; `cargo test -p fabric-migration --lib`
    # confirmed all 14 existing tests live in phase.rs/migration.rs, none
    # touching plan.rs's label() or any of progress.rs).
    # ------------------------------------------------------------
    proc demoReasonLabels() -> bool:
        let hotspot = do migrationReasonHotspot(0.92)
        let rebalance = do migrationReasonRebalance()
        let drainNode = do migrationReasonDrainNode()
        let regionLocality = do migrationReasonRegionLocality("us-east")
        let capacityPressure = do migrationReasonCapacityPressure()
        let operator = do migrationReasonOperator("scheduled maintenance")
        let l1 = do migrationReasonLabel(hotspot)
        let l2 = do migrationReasonLabel(rebalance)
        let l3 = do migrationReasonLabel(drainNode)
        let l4 = do migrationReasonLabel(regionLocality)
        let l5 = do migrationReasonLabel(capacityPressure)
        let l6 = do migrationReasonLabel(operator)
        return l1 == "hotspot" && l2 == "rebalance" && l3 == "drain-node" && l4 == "region-locality" && l5 == "capacity-pressure" && l6 == "operator" && regionLocality.targetRegion == "us-east" && operator.note == "scheduled maintenance" && hotspot.pressureScore > 0.9

    proc demoMigrationIdLabel() -> text:
        let id = MigrationId{value: 42}
        let label = do migrationIdLabel(id)
        return label

    proc demoDefaultMaxCutoverPendingWrites() -> int:
        let writes = do migrationDefaultMaxCutoverPendingWrites()
        return writes

    # Traced against progress.rs directly: atomsTotal=156 (a shard's full
    # 12x13 grid, matching plan.rs's own `atoms` field / Shard::atom_count),
    # atomsCopied=100 -> copy_fraction = 100/156 ~= 0.641, not complete;
    # Copying's overall_fraction = 0.641*0.80 ~= 0.513.
    proc demoProgressPartialCopy() -> MigrationProgress:
        let progress = do migrationProgressNew(156, 1000)
        return MigrationProgress{atomsTotal: progress.atomsTotal, atomsCopied: 100, bytesCopied: progress.bytesCopied, pendingWrites: progress.pendingWrites, phaseStartedAtMs: progress.phaseStartedAtMs, updatedAtMs: progress.updatedAtMs}

    # 100/156 = 0.641025... — a bounded check, not an exact-literal one,
    # since this fraction (unlike the phase table's own fixed shares below)
    # is not a clean binary fraction; the bound pins it to the same value
    # hand-computed from the trace in this proc's own header comment above.
    proc demoProgressPartialCopyFractionOk() -> bool:
        let progress = do demoProgressPartialCopy()
        let fraction = do migrationProgressCopyFraction(progress)
        return fraction > 0.64 && fraction < 0.65

    proc demoProgressPartialIsComplete() -> bool:
        let progress = do demoProgressPartialCopy()
        let complete = do migrationProgressIsCopyComplete(progress)
        return complete

    # Copying's overall_fraction = copyFraction*0.80 ~= 0.641*0.80 ~= 0.513.
    proc demoProgressPartialOverallFractionOk() -> bool:
        let progress = do demoProgressPartialCopy()
        let fraction = do migrationProgressOverallFraction(progress, 1)
        return fraction > 0.51 && fraction < 0.52

    # Zero-atom edge case: copy_fraction defined as 1.0 (avoids a divide by
    # zero), matching the Rust guard exactly — this one IS a clean literal,
    # so it is checked for exact equality.
    proc demoProgressZeroAtomsCopyFractionOk() -> bool:
        let progress = do migrationProgressNew(0, 0)
        let fraction = do migrationProgressCopyFraction(progress)
        return fraction == 1.0

    # Each phase's fixed share, traced directly against the match:
    # Planned=0.0, CatchingUp=0.85, Cutover=0.95, Cleanup=0.98,
    # Completed=1.0, and Aborted/Failed fall back to the same
    # copy-fraction-based estimate Copying uses.
    proc demoProgressPhaseFractions() -> bool:
        let progress = do demoProgressPartialCopy()
        let planned = do migrationProgressOverallFraction(progress, 0)
        let copying = do migrationProgressOverallFraction(progress, 1)
        let catchingUp = do migrationProgressOverallFraction(progress, 2)
        let cutover = do migrationProgressOverallFraction(progress, 3)
        let cleanup = do migrationProgressOverallFraction(progress, 4)
        let completed = do migrationProgressOverallFraction(progress, 5)
        let aborted = do migrationProgressOverallFraction(progress, 6)
        let failed = do migrationProgressOverallFraction(progress, 7)
        return planned == 0.0 && catchingUp == 0.85 && cutover == 0.95 && cleanup == 0.98 && completed == 1.0 && aborted == copying && failed == copying

    proc demoProgressPhaseAge() -> int:
        let progress = do migrationProgressNew(156, 5000)
        let age = do migrationProgressPhaseAgeMs(progress, 8000)
        return age

    # saturating_sub floor: now_ms earlier than the phase start never goes
    # negative.
    proc demoProgressPhaseAgeSaturates() -> int:
        let progress = do migrationProgressNew(156, 5000)
        let age = do migrationProgressPhaseAgeMs(progress, 1000)
        return age

    state demoReasonLabelsOk: bool = false
    state demoIdLabel: text = ""
    state demoDefaultMaxCutover: int = 0
    state demoPartialCopyFractionOk: bool = false
    state demoPartialIsComplete: bool = false
    state demoPartialOverallFractionOk: bool = false
    state demoZeroAtomsCopyFractionOk: bool = false
    state demoPhaseFractionsOk: bool = false
    state demoPhaseAge: int = 0
    state demoPhaseAgeSaturates: int = 0

    action runDemoMigrationPlan():
        let reasonLabelsOk = do demoReasonLabels()
        let idLabel = do demoMigrationIdLabel()
        let defaultMaxCutover = do demoDefaultMaxCutoverPendingWrites()
        let partialCopyFractionOk = do demoProgressPartialCopyFractionOk()
        let partialIsComplete = do demoProgressPartialIsComplete()
        let partialOverallFractionOk = do demoProgressPartialOverallFractionOk()
        let zeroAtomsCopyFractionOk = do demoProgressZeroAtomsCopyFractionOk()
        let phaseFractionsOk = do demoProgressPhaseFractions()
        let phaseAge = do demoProgressPhaseAge()
        let phaseAgeSaturates = do demoProgressPhaseAgeSaturates()
        demoReasonLabelsOk = reasonLabelsOk
        demoIdLabel = idLabel
        demoDefaultMaxCutover = defaultMaxCutover
        demoPartialCopyFractionOk = partialCopyFractionOk
        demoPartialIsComplete = partialIsComplete
        demoPartialOverallFractionOk = partialOverallFractionOk
        demoZeroAtomsCopyFractionOk = zeroAtomsCopyFractionOk
        demoPhaseFractionsOk = phaseFractionsOk
        demoPhaseAge = phaseAge
        demoPhaseAgeSaturates = phaseAgeSaturates
