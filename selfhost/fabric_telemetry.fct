import "fabric_core.fct"

app FabricTelemetrySelfHost:
    # Self-hosting port of fabric/crates/fabric-telemetry/src/ in full —
    # observation.rs (30L: Observation + its one constructor) and metrics.rs
    # (105L: CellWorkloadMetrics, WorkloadMetrics + its five real methods:
    # total_operations, is_cpu_hot, is_memory_hot, is_queue_hot, is_hot) —
    # PLUS fabric/crates/fabric-workload/src/ in full — analyzer.rs (81L:
    # WorkloadKey, WorkloadAnalyzer) and profile.rs (146L: PressureLevel,
    # WorkloadProfile, WorkloadProfile::from_metrics + its private
    # calculate_pressure). Both crates read in full before writing a line
    # here; no method or struct field of either was skipped.
    #
    # ============================================================
    # WHY BOTH CRATES ARE ONE FILE, NOT TWO
    # ============================================================
    # This task's own brief left the split/combine choice to judgment, after
    # reading both. fabric-workload's ENTIRE input surface is fabric-
    # telemetry's own types, consumed at their exact real shape with zero
    # narrowing or divergence: `WorkloadAnalyzer::observe` takes an
    # `&Observation` and reads `observation.shard.id`, `observation.
    # coordinate`, and `observation.metrics` (cloned) verbatim;
    # `WorkloadProfile::from_metrics` takes an owned `WorkloadMetrics` and
    # copies `cell_breakdown`/`cell_breakdown_partial` straight through
    # unchanged. There is no case here — unlike fabric_routing.fct's
    # deliberately NARROWER redeclaration of `Coordinate` for a packed-int
    # RoutingKey, or fabric_replication.fct's deliberately DIFFERENT-shaped
    # `ReplGroup` vs. fabric.fct's `ReplicaEntry` — where two files reading
    # the same real-world thing at different fidelity justifies two
    # separate, independently named types. Here it is the SAME shape read
    # by two crates. This selfhost directory has no cross-file `import`
    # (confirmed directly: fabric_routing.fct's own header states plainly
    # "this file does not `import` fabric.fct", and every existing file's
    # `facet check` runs and passes as a fully standalone app — verified by
    # running it on fabric_core.fct, fabric_routing.fct, and
    # fabric_replication.fct individually before writing this file). Given
    # no import mechanism, splitting `Observation`/`WorkloadMetrics`/
    # `CellWorkloadMetrics` into a separate `fabric_workload.fct` would force
    # a SECOND, independently-maintained copy of an IDENTICAL shape — a real
    # drift risk with no offsetting benefit, since nothing about the two
    # crates' concerns is actually independent the way replication's
    # placement/replica/set trio is from failover. One file is the root
    # solution; two would be needless duplication dressed up as modularity.
    #
    # ============================================================
    # REPRESENTATION CHOICES
    # ============================================================
    # `Coordinate` (`fabric_core::Coordinate`, `{x: u8, y: u8}`) is
    # redeclared locally below, field-for-field, for the exact same reason
    # fabric_routing.fct's header already gives for redeclaring it there:
    # no cross-file import exists in this language, so every file that
    # needs it owns its own copy.
    #
    # `Observation.shard`: the real Rust field is `shard: Shard`
    # (`fabric_core::Shard`) — a FULL struct that also carries a 156-atom
    # `Grid` and a `ShardStorage` map, both already ported in fabric_core.fct
    # at real cost (`gridNew` alone builds 156 `Atom`s). Before assuming that
    # full shape was needed here, every real read of `observation.shard`
    # anywhere in the fabric/ tree was grepped, not guessed: fabric-
    # telemetry itself never reads it; fabric-workload's analyzer.rs reads
    # only `.id` (twice); fabric-replication's replica.rs
    # (`ReplicaReport::from_observation`) reads only `.id`; fabric-
    # simulator's simulation.rs (the one other real caller in the whole
    # workspace) reads only `.id`, in every one of its eight call sites.
    # Nothing, anywhere, ever reads an Observation's shard's grid or
    # storage. So `Observation.shard` here is `ObservationShard{id,
    # workloadDomain}` — the two plain identity fields `Shard` itself
    # carries at its own top level (`pub id: u64`, `pub workload_domain:
    # String`), never its two internal, `#[serde(skip)]`-marked fields
    # (`grid`, `storage`) that no consumer of an Observation's shard ever
    # touches. This is a deliberate, narrower, HONEST representation — the
    # same kind of call fabric_replication.fct's own header already makes
    # for `ReplRecord` vs. fabric.fct's `ReplicaEntry` — not a shortcut, and
    # it is named `ObservationShard`, never `Shard`, so nobody mistakes it
    # for fabric_core.fct's real, full type.
    #
    # `PressureLevel`'s four variants (`Normal`/`Elevated`/`High`/
    # `Critical`) become a `text` tag — "normal"/"elevated"/"high"/
    # "critical" — matching fabric_replication.fct's `ReplicaState`
    # convention (a descriptive level, compared everywhere by name), not
    # fabric_routing.fct's `RoutingError.kind` convention (Rust-variant-
    # named error tags like "NoWritableReplica"): this is a level, not an
    # error taxonomy.
    #
    # `WorkloadAnalyzer`'s `HashMap<WorkloadKey, WorkloadProfile>` is
    # restated as a linearly-searched `[WorkloadProfileEntry]`, the SAME
    # array-instead-of-map convention fabric_core.fct's `ShardStorage` and
    # fabric_routing.fct's `TopologyRegistry` already establish, for the
    # identical reason (no native map type in this language).
    #
    # ============================================================
    # CLOSING fabric_replication.fct's DEFERRED `ReplicaReport::from_observation`
    # ============================================================
    # fabric_replication.fct's own header (read in full before writing this
    # file, per this task's instruction) explains why it stopped short:
    # `ReplicaReport::from_observation(node, observation, lag)` needed a
    # `fabric_telemetry::Observation` type that did not exist yet on this
    # side. It now does (below). The real Rust method is:
    #
    #   shard_id: observation.shard.id, node, timestamp_ms:
    #   observation.timestamp_ms, lag, reachable: true
    #
    # fabric_replication.fct's ALREADY-PORTED `replReportNew(shardId: int,
    # node: text, timestampMs: int, pendingWrites: int, applyLagMs: int) ->
    # ReplReport` (that file's `ReplRecord`/`ReplReport` flatten Rust's
    # `ReplicaLag{pending_writes, apply_lag_ms}` into two plain fields
    # directly on the report, per that file's own header) already has
    # EXACTLY this signature — it sets `reachable: true` unconditionally,
    # the same as `from_observation` does. So the entire composition, once
    # a future round is allowed to touch fabric_replication.fct, is
    # reusing that constructor unmodified, with the two fields an
    # Observation supplies pulled off of it, and the two fields telemetry
    # does not carry (lag is a replication-specific quantity, per the real
    # method's own doc comment) supplied by the caller exactly as today:
    #
    #   do replReportNew(observation.shard.id, node, observation.timestampMs,
    #                     pendingWrites, applyLagMs)
    #
    # No new function is added here for this: writing one would either
    # duplicate `replReportNew`'s own body under a second name (real rework
    # of an already-correct proc, for no behavioral gain) or reach into
    # fabric_replication.fct to add it there — out of scope this round, per
    # this task's own instruction not to touch that file's content. This
    # comment is the complete, exact wiring a future task needs; nothing
    # about it is hypothetical or approximate.

    # ============================================================
    # observation.rs / metrics.rs — fabric-telemetry, ported in full.
    # Coordinate is fabric_core.fct's own — imported above, not restated
    # (byte-identical x/int, y/int shape confirmed before this dedup).
    # ============================================================
    struct ObservationShard:
        id: int
        workloadDomain: text

    struct CellWorkloadMetrics:
        x: int
        y: int
        z: int
        q: int
        readsPerSecond: float
        writesPerSecond: float
        bytesReadPerSecond: float
        bytesWrittenPerSecond: float

    # cellWorkloadMetricsDefault: `#[derive(Default)]` — every numeric field
    # zero, matching `u8`/`f64` defaults exactly.
    proc cellWorkloadMetricsDefault() -> CellWorkloadMetrics:
        return CellWorkloadMetrics{x: 0, y: 0, z: 0, q: 0, readsPerSecond: 0.0, writesPerSecond: 0.0, bytesReadPerSecond: 0.0, bytesWrittenPerSecond: 0.0}

    struct WorkloadMetrics:
        operationsPerSecond: float
        readsPerSecond: float
        writesPerSecond: float
        readLatencyUs: float
        writeLatencyUs: float
        cpuUtilization: float
        memoryUtilization: float
        storageBytesPerSecond: int
        networkInBytesPerSecond: int
        networkOutBytesPerSecond: int
        queueDepth: int
        cellBreakdown: [CellWorkloadMetrics]
        cellBreakdownPartial: bool

    # workloadMetricsDefault: `#[derive(Default)]` — every numeric field
    # zero, `cell_breakdown` empty, `cell_breakdown_partial` false.
    proc workloadMetricsDefault() -> WorkloadMetrics:
        return WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 0.0, writesPerSecond: 0.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.0, memoryUtilization: 0.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 0, cellBreakdown: [], cellBreakdownPartial: false}

    proc workloadMetricsTotalOperations(m: WorkloadMetrics) -> float:
        return m.readsPerSecond + m.writesPerSecond

    proc workloadMetricsIsCpuHot(m: WorkloadMetrics) -> bool:
        return m.cpuUtilization >= 0.80

    proc workloadMetricsIsMemoryHot(m: WorkloadMetrics) -> bool:
        return m.memoryUtilization >= 0.80

    proc workloadMetricsIsQueueHot(m: WorkloadMetrics) -> bool:
        return m.queueDepth >= 10000

    proc workloadMetricsIsHot(m: WorkloadMetrics) -> bool:
        let cpuHot = do workloadMetricsIsCpuHot(m)
        if cpuHot:
            return true
        let memHot = do workloadMetricsIsMemoryHot(m)
        if memHot:
            return true
        let queueHot = do workloadMetricsIsQueueHot(m)
        return queueHot

    struct Observation:
        timestampMs: int
        shard: ObservationShard
        coordinate: Coordinate
        metrics: WorkloadMetrics

    proc observationNew(timestampMs: int, shard: ObservationShard, coordinate: Coordinate, metrics: WorkloadMetrics) -> Observation:
        return Observation{timestampMs: timestampMs, shard: shard, coordinate: coordinate, metrics: metrics}

    # ============================================================
    # profile.rs — PressureLevel, WorkloadProfile.
    # ============================================================
    struct WorkloadKey:
        shardId: int
        coordinate: Coordinate

    proc workloadKeyNew(shardId: int, coordinate: Coordinate) -> WorkloadKey:
        return WorkloadKey{shardId: shardId, coordinate: coordinate}

    proc workloadKeyEquals(a: WorkloadKey, b: WorkloadKey) -> bool:
        return a.shardId == b.shardId && a.coordinate.x == b.coordinate.x && a.coordinate.y == b.coordinate.y

    # pressureLevelFromScore: `PressureLevel::from_score` — checked in the
    # SAME top-to-bottom order as the real `match` arms (`>= 0.90` before
    # `>= 0.75` before `>= 0.50`), so the boundaries stay mutually exclusive
    # exactly like the real guard-arm match does.
    proc pressureLevelFromScore(score: float) -> text:
        if score >= 0.90:
            return "critical"
        if score >= 0.75:
            return "high"
        if score >= 0.50:
            return "elevated"
        return "normal"

    struct WorkloadProfile:
        shardId: int
        coordinate: Coordinate
        operationsPerSecond: float
        readRatio: float
        writeRatio: float
        readLatencyUs: float
        writeLatencyUs: float
        cpuUtilization: float
        memoryUtilization: float
        storageBytesPerSecond: int
        networkInBytesPerSecond: int
        networkOutBytesPerSecond: int
        queueDepth: int
        cellBreakdown: [CellWorkloadMetrics]
        cellBreakdownPartial: bool
        pressureScore: float
        pressure: text

    # clampFloat: `f64::clamp` — this language has no clamp builtin (only
    # `min`/`max`, same-numeric-type, per `facet lang`), so it is `max(lo,
    # min(v, hi))`, the textbook expansion `clamp` itself compiles to.
    proc clampFloat(v: float, lo: float, hi: float) -> float:
        let capped = min(v, hi)
        return max(lo, capped)

    # workloadPressureScore: profile.rs's private `calculate_pressure`,
    # restated verbatim — same four weighted, clamped terms (cpu 0.35,
    # memory 0.20, queue 0.25 of queueDepth/10_000, latency 0.20 of
    # worst(read,write)/100_000).
    proc workloadPressureScore(m: WorkloadMetrics) -> float:
        let cpu = do clampFloat(m.cpuUtilization, 0.0, 1.0)
        let memory = do clampFloat(m.memoryUtilization, 0.0, 1.0)
        let queueRaw = toFloat(m.queueDepth) / 10000.0
        let queue = do clampFloat(queueRaw, 0.0, 1.0)
        let worstLatency = max(m.readLatencyUs, m.writeLatencyUs)
        let latencyRaw = worstLatency / 100000.0
        let latency = do clampFloat(latencyRaw, 0.0, 1.0)
        return (cpu * 0.35) + (memory * 0.20) + (queue * 0.25) + (latency * 0.20)

    # workloadProfileFromMetrics: `WorkloadProfile::from_metrics` — total is
    # `total_operations()`; ratios are 0.0 (not NaN) whenever total is 0,
    # exactly like the real `if total > 0.0 { .. } else { 0.0 }`;
    # `cell_breakdown`/`cell_breakdown_partial` pass straight through
    # unchanged, same as the real struct literal.
    proc workloadProfileFromMetrics(shardId: int, coordinate: Coordinate, metrics: WorkloadMetrics) -> WorkloadProfile:
        let total = do workloadMetricsTotalOperations(metrics)
        let mut readRatio = 0.0
        let mut writeRatio = 0.0
        if total > 0.0:
            readRatio = metrics.readsPerSecond / total
            writeRatio = metrics.writesPerSecond / total
        let score = do workloadPressureScore(metrics)
        let level = do pressureLevelFromScore(score)
        return WorkloadProfile{shardId: shardId, coordinate: coordinate, operationsPerSecond: total, readRatio: readRatio, writeRatio: writeRatio, readLatencyUs: metrics.readLatencyUs, writeLatencyUs: metrics.writeLatencyUs, cpuUtilization: metrics.cpuUtilization, memoryUtilization: metrics.memoryUtilization, storageBytesPerSecond: metrics.storageBytesPerSecond, networkInBytesPerSecond: metrics.networkInBytesPerSecond, networkOutBytesPerSecond: metrics.networkOutBytesPerSecond, queueDepth: metrics.queueDepth, cellBreakdown: metrics.cellBreakdown, cellBreakdownPartial: metrics.cellBreakdownPartial, pressureScore: score, pressure: level}

    proc workloadProfileIsHot(p: WorkloadProfile) -> bool:
        return p.pressure == "high" || p.pressure == "critical"

    proc workloadProfileZero() -> WorkloadProfile:
        return WorkloadProfile{shardId: 0, coordinate: Coordinate{x: 0, y: 0}, operationsPerSecond: 0.0, readRatio: 0.0, writeRatio: 0.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.0, memoryUtilization: 0.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 0, cellBreakdown: [], cellBreakdownPartial: false, pressureScore: 0.0, pressure: "normal"}

    # ============================================================
    # analyzer.rs — WorkloadAnalyzer.
    # ============================================================
    struct WorkloadProfileEntry:
        key: WorkloadKey
        profile: WorkloadProfile

    struct WorkloadAnalyzer:
        entries: [WorkloadProfileEntry]

    proc workloadAnalyzerNew() -> WorkloadAnalyzer:
        return WorkloadAnalyzer{entries: []}

    proc workloadAnalyzerIndexOf(entries: [WorkloadProfileEntry], key: WorkloadKey) -> int:
        let n = len(entries)
        let mut i = 0
        let mut found = -1
        loop i < n:
            if found == -1:
                let eq = do workloadKeyEquals(entries[i].key, key)
                if eq:
                    found = i
            i = i + 1
        return found

    # workloadAnalyzerObserve: `WorkloadAnalyzer::observe` — `HashMap::
    # insert` semantics (overwrite in place if the key already exists,
    # append otherwise), the same functional-update shape
    # `shardStorageInsert` already uses in fabric_core.fct.
    proc workloadAnalyzerObserve(analyzer: WorkloadAnalyzer, observation: Observation) -> WorkloadAnalyzer:
        let key = do workloadKeyNew(observation.shard.id, observation.coordinate)
        let profile = do workloadProfileFromMetrics(observation.shard.id, observation.coordinate, observation.metrics)
        let idx = do workloadAnalyzerIndexOf(analyzer.entries, key)
        if idx == -1:
            let grown = append(analyzer.entries, WorkloadProfileEntry{key: key, profile: profile})
            return WorkloadAnalyzer{entries: grown}
        let mut entries = analyzer.entries
        entries[idx] = WorkloadProfileEntry{key: key, profile: profile}
        return WorkloadAnalyzer{entries: entries}

    struct WorkloadProfileOption:
        has: bool
        val: WorkloadProfile

    # workloadAnalyzerProfile: `WorkloadAnalyzer::profile(&self, shard:
    # &Shard, coordinate)` — takes the caller's shard id directly (see this
    # file's header on why an Observation's shard is narrowed the same way).
    proc workloadAnalyzerProfile(analyzer: WorkloadAnalyzer, shardId: int, coordinate: Coordinate) -> WorkloadProfileOption:
        let key = do workloadKeyNew(shardId, coordinate)
        let idx = do workloadAnalyzerIndexOf(analyzer.entries, key)
        if idx == -1:
            let zero = do workloadProfileZero()
            return WorkloadProfileOption{has: false, val: zero}
        return WorkloadProfileOption{has: true, val: analyzer.entries[idx].profile}

    proc workloadAnalyzerHotCoordinates(analyzer: WorkloadAnalyzer) -> [Coordinate]:
        let n = len(analyzer.entries)
        let mut i = 0
        let mut result = []
        loop i < n:
            let hot = do workloadProfileIsHot(analyzer.entries[i].profile)
            if hot:
                result = append(result, analyzer.entries[i].profile.coordinate)
            i = i + 1
        return result

    proc workloadAnalyzerProfiles(analyzer: WorkloadAnalyzer) -> [WorkloadProfile]:
        let n = len(analyzer.entries)
        let mut i = 0
        let mut result = []
        loop i < n:
            result = append(result, analyzer.entries[i].profile)
            i = i + 1
        return result

    proc workloadAnalyzerLen(analyzer: WorkloadAnalyzer) -> int:
        return len(analyzer.entries)

    proc workloadAnalyzerIsEmpty(analyzer: WorkloadAnalyzer) -> bool:
        return len(analyzer.entries) == 0

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES — each proc below hand-traces one piece
    # of real Rust behavior against a literal, precomputed expectation.
    # ============================================================

    # `is_cpu_hot`/`is_memory_hot`/`is_queue_hot`/`is_hot`: exact >= boundary
    # (0.80, 0.80, 10_000) checked on both sides, per the real source's own
    # literal thresholds.
    proc demoWorkloadMetricsHotFlags() -> bool:
        let cold = WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 0.0, writesPerSecond: 0.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.79, memoryUtilization: 0.79, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 9999, cellBreakdown: [], cellBreakdownPartial: false}
        let coldCpuHot = do workloadMetricsIsCpuHot(cold)
        let coldMemHot = do workloadMetricsIsMemoryHot(cold)
        let coldQueueHot = do workloadMetricsIsQueueHot(cold)
        let coldHot = do workloadMetricsIsHot(cold)
        let hotCpu = WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 0.0, writesPerSecond: 0.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.80, memoryUtilization: 0.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 0, cellBreakdown: [], cellBreakdownPartial: false}
        let hotCpuHot = do workloadMetricsIsCpuHot(hotCpu)
        let hotMem = WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 0.0, writesPerSecond: 0.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.0, memoryUtilization: 0.80, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 0, cellBreakdown: [], cellBreakdownPartial: false}
        let hotMemHot = do workloadMetricsIsMemoryHot(hotMem)
        let hotQueue = WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 0.0, writesPerSecond: 0.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.0, memoryUtilization: 0.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 10000, cellBreakdown: [], cellBreakdownPartial: false}
        let hotQueueHot = do workloadMetricsIsQueueHot(hotQueue)
        let hotQueueOverall = do workloadMetricsIsHot(hotQueue)
        return !coldCpuHot && !coldMemHot && !coldQueueHot && !coldHot && hotCpuHot && hotMemHot && hotQueueHot && hotQueueOverall

    # PressureLevel's four buckets, both sides of each boundary.
    proc demoPressureLevelBoundaries() -> bool:
        let a = do pressureLevelFromScore(0.0)
        let b = do pressureLevelFromScore(0.49)
        let c = do pressureLevelFromScore(0.50)
        let d = do pressureLevelFromScore(0.74)
        let e = do pressureLevelFromScore(0.75)
        let f = do pressureLevelFromScore(0.89)
        let g = do pressureLevelFromScore(0.90)
        let h = do pressureLevelFromScore(1.0)
        return a == "normal" && b == "normal" && c == "elevated" && d == "elevated" && e == "high" && f == "high" && g == "critical" && h == "critical"

    # calculate_pressure + from_metrics, hand-traced: cpu=0.90 (already
    # inside [0,1]), memory=0.50, queueDepth=5000 -> queue=5000/10000=0.50,
    # readLatencyUs=50000/writeLatencyUs=30000 -> worst=50000/100000=0.50.
    # score = 0.90*0.35 + 0.50*0.20 + 0.50*0.25 + 0.50*0.20
    #       = 0.315 + 0.10 + 0.125 + 0.10 = 0.64 -> "elevated" ([0.50,0.75)),
    # not hot (only High/Critical count as hot). reads=300, writes=100 ->
    # total=400, readRatio=0.75, writeRatio=0.25. cellBreakdown/partial pass
    # straight through unchanged, per the real struct literal.
    proc demoWorkloadPressureScoreAndProfile() -> bool:
        let oneCell = CellWorkloadMetrics{x: 1, y: 2, z: 0, q: 0, readsPerSecond: 9.0, writesPerSecond: 1.0, bytesReadPerSecond: 0.0, bytesWrittenPerSecond: 0.0}
        let metrics = WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 300.0, writesPerSecond: 100.0, readLatencyUs: 50000.0, writeLatencyUs: 30000.0, cpuUtilization: 0.90, memoryUtilization: 0.50, storageBytesPerSecond: 7, networkInBytesPerSecond: 8, networkOutBytesPerSecond: 9, queueDepth: 5000, cellBreakdown: [oneCell], cellBreakdownPartial: true}
        let coordinate = Coordinate{x: 3, y: 4}
        let profile = do workloadProfileFromMetrics(42, coordinate, metrics)
        let scoreOk = profile.pressureScore == 0.64
        let totalOk = profile.operationsPerSecond == 400.0
        let readRatioOk = profile.readRatio == 0.75
        let writeRatioOk = profile.writeRatio == 0.25
        let levelOk = profile.pressure == "elevated"
        let passthroughOk = len(profile.cellBreakdown) == 1 && profile.cellBreakdown[0].x == 1 && profile.cellBreakdownPartial
        let isHot = do workloadProfileIsHot(profile)
        return scoreOk && totalOk && readRatioOk && writeRatioOk && levelOk && passthroughOk && !isHot

    # Zero-total edge case: `from_metrics` must give 0.0 ratios, never NaN
    # (`0.0 / 0.0` would be NaN if the real `if total > 0.0` guard were
    # dropped — this is exactly the guard that prevents that).
    proc demoZeroTotalGivesZeroRatiosNotNaN() -> bool:
        let metrics = do workloadMetricsDefault()
        let profile = do workloadProfileFromMetrics(1, Coordinate{x: 0, y: 0}, metrics)
        return profile.operationsPerSecond == 0.0 && profile.readRatio == 0.0 && profile.writeRatio == 0.0

    # WorkloadAnalyzer: observe two distinct cells, confirm hot_coordinates
    # finds only the pressured one, profile()/is_empty()/len() round-trip,
    # then re-observe the SAME key and confirm HashMap::insert semantics
    # (overwrite in place, len unchanged) turn a hot cell back to normal.
    proc demoWorkloadAnalyzerRoundTrip() -> bool:
        let empty = do workloadAnalyzerNew()
        let emptyIsEmpty = do workloadAnalyzerIsEmpty(empty)
        let coldMetrics = WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 10.0, writesPerSecond: 5.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.1, memoryUtilization: 0.1, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 0, cellBreakdown: [], cellBreakdownPartial: false}
        let hotMetrics = WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 1.0, writesPerSecond: 1.0, readLatencyUs: 200000.0, writeLatencyUs: 200000.0, cpuUtilization: 1.0, memoryUtilization: 1.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 20000, cellBreakdown: [], cellBreakdownPartial: false}
        let shardA = ObservationShard{id: 7, workloadDomain: "orders"}
        let obsCold = do observationNew(1000, shardA, Coordinate{x: 0, y: 0}, coldMetrics)
        let obsHot = do observationNew(2000, shardA, Coordinate{x: 1, y: 1}, hotMetrics)
        let a1 = do workloadAnalyzerObserve(empty, obsCold)
        let a2 = do workloadAnalyzerObserve(a1, obsHot)
        let lenAfterTwo = do workloadAnalyzerLen(a2)
        let hotCoords = do workloadAnalyzerHotCoordinates(a2)
        let hotCoordsLen = len(hotCoords)
        let hotCoordMatch = hotCoords[0].x == 1 && hotCoords[0].y == 1
        let lookupCold = do workloadAnalyzerProfile(a2, 7, Coordinate{x: 0, y: 0})
        let lookupMissing = do workloadAnalyzerProfile(a2, 99, Coordinate{x: 0, y: 0})
        let coldStillNormal = lookupCold.val.pressure == "normal"
        let updatedHot = WorkloadMetrics{operationsPerSecond: 0.0, readsPerSecond: 0.0, writesPerSecond: 0.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.0, memoryUtilization: 0.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 0, cellBreakdown: [], cellBreakdownPartial: false}
        let obsHotUpdated = do observationNew(3000, shardA, Coordinate{x: 1, y: 1}, updatedHot)
        let a3 = do workloadAnalyzerObserve(a2, obsHotUpdated)
        let lenAfterOverwrite = do workloadAnalyzerLen(a3)
        let hotCoordsAfterOverwrite = do workloadAnalyzerHotCoordinates(a3)
        let noLongerHot = len(hotCoordsAfterOverwrite) == 0
        let allProfiles = do workloadAnalyzerProfiles(a3)
        return emptyIsEmpty && lenAfterTwo == 2 && hotCoordsLen == 1 && hotCoordMatch && lookupCold.has && lookupCold.val.coordinate.x == 0 && coldStillNormal && !lookupMissing.has && lenAfterOverwrite == 2 && noLongerHot && len(allProfiles) == 2

    # Observation field round-trip — exactly the two fields a future
    # `from_observation` wiring (see this file's header) would read off of
    # it: `shard.id` and `timestampMs`.
    proc demoObservationFieldsForFromObservation() -> bool:
        let shard = ObservationShard{id: 55, workloadDomain: "billing"}
        let coordinate = Coordinate{x: 2, y: 9}
        let metrics = do workloadMetricsDefault()
        let observation = do observationNew(123456, shard, coordinate, metrics)
        return observation.shard.id == 55 && observation.timestampMs == 123456 && observation.coordinate.x == 2 && observation.coordinate.y == 9

    state demoWorkloadMetricsHotFlags: bool = false
    state demoPressureLevelBoundaries: bool = false
    state demoWorkloadPressureScoreAndProfile: bool = false
    state demoZeroTotalGivesZeroRatiosNotNaN: bool = false
    state demoWorkloadAnalyzerRoundTrip: bool = false
    state demoObservationFieldsForFromObservation: bool = false

    action runDemoTelemetry():
        let r1 = do demoWorkloadMetricsHotFlags()
        let r2 = do demoPressureLevelBoundaries()
        let r3 = do demoWorkloadPressureScoreAndProfile()
        let r4 = do demoZeroTotalGivesZeroRatiosNotNaN()
        let r5 = do demoWorkloadAnalyzerRoundTrip()
        let r6 = do demoObservationFieldsForFromObservation()
        demoWorkloadMetricsHotFlags = r1
        demoPressureLevelBoundaries = r2
        demoWorkloadPressureScoreAndProfile = r3
        demoZeroTotalGivesZeroRatiosNotNaN = r4
        demoWorkloadAnalyzerRoundTrip = r5
        demoObservationFieldsForFromObservation = r6
