        return VNode{kind: n.kind, children: n.children, segs: n.segs, label: n.label, pathSegs: n.pathSegs, placeholder: n.placeholder, alt: n.alt, altSet: n.altSet, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: v, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

