import "lower.fct"

app ViewParseSelfHost:
    # view_parse.fct — self-hosted port of internal/parser/parser.go's VIEW
    # grammar: parseView's header (`view Name [at "/path"] [in Layout]
    # [requires policy]`, `meta title/description`), parseNodes and every
    # node parser it dispatches to (box/row/text/heading/image/icon/video/
    # richtext/badge/tabs/match/for/stage/sprite/if/after/overlay/popover/
    # typeahead/the ast.Controls table/input/link/select/form/upload/use/
    # slot), stripNodeMods' trailing class/style/anchor modifiers, parseRange
    # + splitForClauses, and the quoted-text scanners they all share
    # (endOfQuoted/endOfInterp/indexTop/splitTop/matchParen/unquoteText/
    # parseTextBody). The output is VNode, a one-struct rendering of the
    # ast.Node sum type (see the kind list on VNode below), which
    # view_build.fct lowers into ir.Node exactly as internal/ir/build.go's
    # viewCtx does.
    #
    # Errors: a proc has no error channel, so a failed parse is a VNode of
    # kind "!err" whose `value` is the parser's own message. parseNodes
    # stops at the first one and returns it alone, which is exactly the
    # first-error-wins shape Go's `if err != nil { return nil, err }` has.
    #
    # Positions: every scanner works on a rune list (split(s, "")) and
    # slices with the rune-indexed `slice`, so a multi-byte character in a
    # label is never split — the Go code's byte indexes and these rune
    # indexes land on the same boundaries because every delimiter scanned
    # for is ASCII.
    struct VSeg:
        lit: text
        expr: [ExprNode]

    struct VRange:
        itemVar: text
        coll: text
        where: [ExprNode]
        order: text
        desc: bool
        limit: [ExprNode]
        more: text

    struct VOption:
        label: [VSeg]
        value: text
        val: [ExprNode]
        from: [VRange]

    struct VAssign:
        target: text
        value: ExprNode

    # VNode kinds (ast type in parentheses): box row text heading image icon
    # video richtext badge tabs tab(Tab) match case(MatchCase) else(Match.Else)
    # button for stage sprite(Sprite) if after input control(Control: ctl is
    # the keyword) overlay popover typeahead link select form upload use slot
    # slotref(SlotRef) modified(Modified: children = [inner]) — plus "!err".
    struct VNode:
        kind: text
        children: [VNode]
        segs: [VSeg]
        label: [VSeg]
        pathSegs: [VSeg]
        placeholder: [VSeg]
        alt: [VSeg]
        altSet: bool
        poster: [VSeg]
        autoplay: bool
        loopFlag: bool
        muted: bool
        action: text
        args: [ExprNode]
        onChange: bool
        debounce: int
        expr: [ExprNode]
        rng: [VRange]
        bind: text
        ctl: text
        options: [VOption]
        value: text
        seconds: int
        assigns: [VAssign]
        width: int
        height: int
        x: [ExprNode]
        y: [ExprNode]
        facing: [ExprNode]
        image: [ExprNode]
        entity: text
        field: text
        name: text
        classSegs: [VSeg]
        style: text
        anchor: text
        hasElse: bool

    proc vpNode(kind: text) -> VNode:
        return VNode{kind: kind, children: [], segs: [], label: [], pathSegs: [], placeholder: [], alt: [], altSet: false, poster: [], autoplay: false, loopFlag: false, muted: false, action: "", args: [], onChange: false, debounce: 0, expr: [], rng: [], bind: "", ctl: "", options: [], value: "", seconds: 0, assigns: [], width: 0, height: 0, x: [], y: [], facing: [], image: [], entity: "", field: "", name: "", classSegs: [], style: "", anchor: "", hasElse: false}

    proc vpSetChildren(n: VNode, v: [VNode]) -> VNode:
        return VNode{kind: n.kind, children: v, segs: n.segs, label: n.label, pathSegs: n.pathSegs, placeholder: n.placeholder, alt: n.alt, altSet: n.altSet, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: n.action, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

    proc vpSetSegs(n: VNode, v: [VSeg]) -> VNode:
        return VNode{kind: n.kind, children: n.children, segs: v, label: n.label, pathSegs: n.pathSegs, placeholder: n.placeholder, alt: n.alt, altSet: n.altSet, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: n.action, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

    proc vpSetLabel(n: VNode, v: [VSeg]) -> VNode:
        return VNode{kind: n.kind, children: n.children, segs: n.segs, label: v, pathSegs: n.pathSegs, placeholder: n.placeholder, alt: n.alt, altSet: n.altSet, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: n.action, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

    proc vpSetPathSegs(n: VNode, v: [VSeg]) -> VNode:
        return VNode{kind: n.kind, children: n.children, segs: n.segs, label: n.label, pathSegs: v, placeholder: n.placeholder, alt: n.alt, altSet: n.altSet, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: n.action, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

    proc vpSetPlaceholder(n: VNode, v: [VSeg]) -> VNode:
        return VNode{kind: n.kind, children: n.children, segs: n.segs, label: n.label, pathSegs: n.pathSegs, placeholder: v, alt: n.alt, altSet: n.altSet, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: n.action, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

    proc vpSetAlt(n: VNode, v: [VSeg]) -> VNode:
        return VNode{kind: n.kind, children: n.children, segs: n.segs, label: n.label, pathSegs: n.pathSegs, placeholder: n.placeholder, alt: v, altSet: n.altSet, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: n.action, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

    proc vpSetAltSet(n: VNode, v: bool) -> VNode:
        return VNode{kind: n.kind, children: n.children, segs: n.segs, label: n.label, pathSegs: n.pathSegs, placeholder: n.placeholder, alt: n.alt, altSet: v, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: n.action, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

    proc vpSetPoster(n: VNode, v: [VSeg]) -> VNode:
        return VNode{kind: n.kind, children: n.children, segs: n.segs, label: n.label, pathSegs: n.pathSegs, placeholder: n.placeholder, alt: n.alt, altSet: n.altSet, poster: v, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, action: n.action, args: n.args, onChange: n.onChange, debounce: n.debounce, expr: n.expr, rng: n.rng, bind: n.bind, ctl: n.ctl, options: n.options, value: n.value, seconds: n.seconds, assigns: n.assigns, width: n.width, height: n.height, x: n.x, y: n.y, facing: n.facing, image: n.image, entity: n.entity, field: n.field, name: n.name, classSegs: n.classSegs, style: n.style, anchor: n.anchor, hasElse: n.hasElse}

