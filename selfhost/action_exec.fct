import "sse_live.fct"

app ActionExec:
    # action_exec.fct — runtime/server.go's runActionValue / runActionLocked
    # / execActionBlock: a server action run against the world — arguments
    # bound and coerced (paramArg), `requires` policies enforced
    # (policyPasses), the body executed statement by statement (check,
    # assign, add, set, remove, clear, let, if, for, foreach, return,
    # exprstmt, establish), constraints checked before a row lands
    # (constraintError), and on success the entity changes fanned out to
    # the live stream and the session deltas handed back. A body that
    # stops part-way leaves the world exactly as it was: the world is a
    # value, so the rollback is the caller keeping the one it had.
    # RtHandled: one endpoint's answer — the response and the world after it.
    struct RtHandled:
        resp: HttpServerResponse
        w: RtWorld

    proc rtJSONResponse(status: int, body: text) -> HttpServerResponse:
        return HttpServerResponse{status: status, reason: "", headers: [HttpHeader{name: "content-type", value: "application/json"}], body: body}

    struct RtRun:
        w: RtWorld
        sid: text
        deltaKeys: [text]
        deltaVals: [Val]
        value: Val
        status: int
        msg: text
        # replyMeta: `return … status N`, the `header` statements, and the
        # failing check's `code` (statusReply in Go).
        retStatus: int
        headerNames: [text]
        headerVals: [text]
        code: text

    # RtExec: the state one action's body runs in.
    struct RtExec:
        w: RtWorld
        sc: RtScope
        ses: RtSession
        deltaKeys: [text]
        deltaVals: [Val]
        changed: [text]
        retVal: Val
        returned: bool
        status: int
        msg: text
        bound: [text]
        retStatus: int
        headerNames: [text]
        headerVals: [text]
        errCode: text
        revokes: [text]
        restateActors: [text]
        restateRoles: [text]
        rekey: text
        actName: text
        # how many `run`s deep this body is (maxRunDepth backstop: 16)
        runDepth: int
        # the action outcomes the body reported to /metrics, "action|outcome"
        # (observeAction): kept even when the action then rolls back
        obs: [text]
        # the caller as the action began (ar.actor), and the failures it
        # audited (recordAudit), kept like obs
        actor: text
        audits: [RtAudit]

    proc rtParamTypeName(p: IRParam) -> text:
        if p.list:
            return "[" + p.type + "]"
        return p.type

    # rtCoerceParam: coerceParam — a boundary coercion that can refuse.
    struct RtCoerced:
        ok: bool
        v: Val

    proc rtIsNumericText(s: text) -> bool:
        let t = trim(s)
        if t == "":
            return true
        let mut i = 0
        let mut digits = 0
        loop i < len(t):
            let c = charAt(t, i)
            let d = c >= "0" && c <= "9"
            if d:
                digits = digits + 1
            else:
                if !((c == "-" || c == "+") && i == 0) && c != "." && c != "_" && c != ",":
                    return false
            i = i + 1
        return digits > 0

    proc rtCoerceParam(v: Val, typ: text) -> RtCoerced:
        if typ == "int" || typ == "money" || typ == "date" || typ == "float":
            if v.kind == "none":
                if typ == "float":
                    return RtCoerced{ok: true, v: floatVal(0.0)}
                return RtCoerced{ok: true, v: intVal(0)}
            if v.kind == "text":
                let num = do rtIsNumericText(v.t)
                if !num:
                    return RtCoerced{ok: false, v: v}
            if v.kind == "bool" || v.kind == "record" || v.kind == "list":
                return RtCoerced{ok: false, v: v}
        if typ == "bool" || typ == "text":
            if v.kind == "record" || v.kind == "list":
                return RtCoerced{ok: false, v: v}
        let c = do rtCoerce(v, typ)
        return RtCoerced{ok: true, v: c}

    proc rtParamArg(v: Val, p: IRParam) -> RtCoerced:
        if !p.list:
            let c = do rtCoerceParam(v, p.type)
            return c
        let mut items = []
        if v.kind == "list":
            items = v.items
        if v.kind == "text":
            let parts = split(v.t, ",")
            let mut i = 0
            loop i < len(parts):
                let t = trim(parts[i])
                if t != "":
                    items = append(items, textVal(t))
                i = i + 1
        if v.kind == "record":
            return RtCoerced{ok: false, v: v}
        if v.kind == "int" || v.kind == "float" || v.kind == "bool":
            items = [v]
        let mut out = []
        let mut k = 0
        loop k < len(items):
            let c = do rtCoerceParam(items[k], p.type)
            if !c.ok:
                return RtCoerced{ok: false, v: v}
            out = append(out, c.v)
            k = k + 1
        return RtCoerced{ok: true, v: listVal(out)}

    # rtArgFor: argFor — a parameter typed by a wire `type` (or a list of
    # them) is shaped to it: each element an object, each declared field
    # coerced as a parameter of its type would be (absent: its zero; a
    # nested wire type shaped in turn). Any other parameter is rtParamArg's.
    proc rtArgFor(g: IRGraph, v: Val, p: IRParam) -> RtCoerced:
        let wi = do rtWireTypeIndex(g, p.type)
        if wi < 0:
            let c = do rtParamArg(v, p)
            return c
        if !p.list:
            if v.kind == "none":
                return RtCoerced{ok: true, v: v}
            let one = do rtWireValue(g, v, wi)
            return one
        if v.kind == "none":
            return RtCoerced{ok: true, v: listVal([])}
        if v.kind != "list":
            return RtCoerced{ok: false, v: v}
        let mut out = []
        let mut i = 0
        loop i < len(v.items):
            let c = do rtWireValue(g, v.items[i], wi)
            if !c.ok:
                return RtCoerced{ok: false, v: v}
            out = append(out, c.v)
            i = i + 1
        return RtCoerced{ok: true, v: listVal(out)}

    # rtWireValue: wireValue — one object shaped to a wire type's fields.
    proc rtWireValue(g: IRGraph, v: Val, wi: int) -> RtCoerced:
        if v.kind != "record":
            return RtCoerced{ok: false, v: v}
        let wt = g.types[wi]
        let mut keys = []
        let mut items = []
        let mut i = 0
        loop i < len(wt.fields):
            let f = wt.fields[i]
            let fv = do valGet(v, f.name)
            let c = do rtArgFor(g, fv, IRParam{name: f.name, type: f.type, optional: f.optional, list: f.list, map: false, key: "", depth: 0})
            if !c.ok:
                return RtCoerced{ok: false, v: v}
            keys = append(keys, f.name)
            items = append(items, c.v)
            i = i + 1
        let r = do recordVal(keys, items)
        return RtCoerced{ok: true, v: r}

    proc rtWireTypeIndex(g: IRGraph, name: text) -> int:
        let mut i = 0
        loop i < len(g.types):
            if g.types[i].name == name:
                return i
            i = i + 1
        return -1

    # rtGoV: fmt's %v of a decoded JSON value — a list as [a b], an object
    # as map[k:v] with its keys sorted, null as <nil>.
    proc rtGoV(v: Val) -> text:
        if v.kind == "none":
            return "<nil>"
        if v.kind == "list":
            let mut parts = []
            let mut i = 0
            loop i < len(v.items):
                parts = append(parts, rtGoV(v.items[i]))
                i = i + 1
            return "[" + join(parts, " ") + "]"
        if v.kind == "record":
            let idx = do rtSortedIndex(v.keys)
            let mut kv = []
            let mut j = 0
            loop j < len(idx):
                kv = append(kv, v.keys[idx[j]] + ":" + rtGoV(v.items[idx[j]]))
                j = j + 1
            return "map[" + join(kv, " ") + "]"
        let s = do valToStr(v)
        return s

    proc rtParamZero(p: IRParam) -> Val:
        if p.list:
            let l = do listVal([])
            return l
        if p.type == "int" || p.type == "money" || p.type == "date":
            let z = do intVal(0)
            return z
        if p.type == "float":
            let f = do floatVal(0.0)
            return f
        if p.type == "bool":
            let b = do boolVal(false)
            return b
        let t = do textVal("")
        return t

    # rtPolicyPasses: policyPasses — a policy's parameters bound from the
    # `requires` call site.
    proc rtPolicyPasses(g: IRGraph, req: IRRequire, sc: RtScope) -> bool:
        let pi = do rtPolicyIndex(g, req.name)
        if pi < 0:
            return false
        let pol = g.policies[pi]
        if len(pol.params) == 0:
            let r = do rtEvalOpt(pol.expr, sc, -1)
            let ok = do valTruthy(r.v)
            return ok
        let mut ps = sc
        let mut i = 0
        loop i < len(pol.params):
            let mut v = do noneVal()
            if i < len(req.args):
                let ar = do rtEval(req.args[i], sc, -1)
                v = ar.v
            let cv = do rtCoerce(v, pol.params[i].type)
            ps = do rtSet(ps, pol.params[i].name, cv)
            i = i + 1
        let r2 = do rtEvalOpt(pol.expr, ps, -1)
        let ok2 = do valTruthy(r2.v)
        return ok2

    proc rtFailed(w: RtWorld, sid: text, status: int, msg: text) -> RtRun:
        return RtRun{w: w, sid: sid, deltaKeys: [], deltaVals: [], value: noneVal(), status: status, msg: msg, retStatus: 0, headerNames: [], headerVals: [], code: ""}

    proc rtFailedCode(w: RtWorld, sid: text, status: int, msg: text, code: text) -> RtRun:
        return RtRun{w: w, sid: sid, deltaKeys: [], deltaVals: [], value: noneVal(), status: status, msg: msg, retStatus: 0, headerNames: [], headerVals: [], code: code}

    # rtRunActionValue: runActionValue — the whole of one action.
    proc rtRunActionValue(w0: RtWorld, sid: text, act: IRAction, args: [Val]) -> RtRun:
        let mut w = w0
        # The system and tool identities are minted on first use. Any other id
        # that names no live session was ended before its action ran, or is ""
        # (no session): it runs as a transient guest that is never stored under
        # that id, so an ended session is not minted back as a guest the same
        # token then resolves to (Go: runActionLocked).
        let si0 = do rtSessionIndex(w, sid)
        let transient = si0 < 0 && sid != "__system" && sid != "tool"
        let fresh = do rtNewSession(w, sid, "guest", "guest")
        if si0 < 0 && !transient:
            w = do rtPutSession(w, fresh)
        let mut scw = w
        if transient:
            scw = do rtPutSession(w, fresh)
        let mut sc = do rtScope(scw, sid)
        sc = do rtSet(sc, "sessionToken", textVal(rtSessionToken(w, sid)))
        let mut given = []
        let mut i = 0
        loop i < len(act.params):
            let p = act.params[i]
            let mut v = do rtParamZero(p)
            if i < len(args) && args[i].kind != "none":
                given = append(given, p.name)
            if i < len(args):
                let c = do rtArgFor(w.g, args[i], p)
                if !c.ok:
                    let bad = do rtFailed(w0, sid, 400, act.name + ": parameter \"" + p.name + "\" expects " + rtParamTypeName(p) + ", got " + rtGoV(args[i]))
                    return bad
                v = c.v
            sc = do rtSet(sc, p.name, v)
            i = i + 1
        let mut r = 0
        loop r < len(act.requires):
            let ok = do rtPolicyPasses(w.g, act.requires[r], sc)
            if !ok:
                let wd0 = do rtObserveActions(w0, [act.name + "|denied"])
                let actorD = do valToStr(rtGet(sc, "actor"))
                let wd = do rtRecordAudit(wd0, actorD, act.name, false, "denied: " + act.requires[r].name)
                let denied = do rtFailed(wd, sid, 403, "forbidden: " + act.requires[r].name)
                return denied
            r = r + 1
        sc.given = given
        let mut ses0 = fresh
        if !transient:
            let si = do rtSessionIndex(w, sid)
            ses0 = w.sessions[si]
        let ex0 = RtExec{w: w, sc: sc, ses: ses0, deltaKeys: [], deltaVals: [], changed: [], retVal: noneVal(), returned: false, status: 200, msg: "", bound: [], retStatus: 0, headerNames: [], headerVals: [], errCode: "", revokes: [], restateActors: [], restateRoles: [], rekey: "", actName: act.name, runDepth: 0, obs: [], actor: valToStr(rtGet(sc, "actor")), audits: []}
        let ex = do rtExecBlock(act.body, ex0)
        if ex.status != 200:
            let wf0 = do rtObserveActions(w0, ex.obs)
            let wf = do rtRecordAudits(wf0, ex.audits)
            let failed = do rtFailedCode(wf, sid, ex.status, ex.msg, ex.errCode)
            return failed
        w = ex.w
        let mut after = sid
        # The action is durable, so its session effects land now: a re-keyed
        # session (establish), the visitor keys it revoked, the actors it
        # restated.
        if ex.rekey != "":
            let ri = do rtSessionIndex(w, sid)
            let mut moved = ex.ses
            moved.sid = ex.rekey
            moved.persisted = false
            if ri >= 0:
                w.sessions[ri] = moved
            else:
                w = do rtPutSession(w, moved)
            after = ex.rekey
            # dropSharedSession(sid); adoptSession persists the new id
            w = do rtSesEnded(w, sid)
            w = do rtSesDirty(w, after)
        else:
            if !transient:
                w = do rtPutSession(w, ex.ses)
                # the action changed per-session state: share it
                if len(ex.deltaKeys) > 0:
                    w = do rtSesDirty(w, sid)
        let mut rv = 0
        loop rv < len(ex.revokes):
            if ex.revokes[rv] != "":
                let rvo = do rtRevokeVisitor(w, ex.revokes[rv], after)
                w = rvo.w
                if rvo.endedOwn:
                    after = ""
            rv = rv + 1
        let mut rs = 0
        loop rs < len(ex.restateActors):
            w = do rtRestateActor(w, ex.restateActors[rs], ex.restateRoles[rs])
            rs = rs + 1
        if len(ex.revokes) > 0 || ex.rekey != "":
            w.met.sessions = len(w.sessions)
        w = do rtObserveActions(w, ex.obs + [act.name + "|ok"])
        w = do rtRecordAudits(w, ex.audits)
        w = do rtRecordAudit(w, ex.actor, act.name, true, "")
        # The entity changes fan out once the writes are durable: the loop
        # commits pendingOps and then broadcasts pendingChanged.
        w.pendingChanged = w.pendingChanged + ex.changed
        # replyValue: an entity-typed reply carries only what the caller may
        # receive (visibleRows).
        let mut reply = ex.retVal
        let retEnt = do rtEntityIndex(w.g, act.ret)
        if retEnt >= 0 && reply.kind != "none":
            if act.retList && reply.kind == "list":
                let vis = do rtVisibleRows(act.ret, reply.items, ex.sc, false)
                reply = do listVal(vis)
            else:
                if reply.kind == "record":
                    let vis1 = do rtVisibleRows(act.ret, [reply], ex.sc, false)
                    reply = vis1[0]
        return RtRun{w: w, sid: after, deltaKeys: ex.deltaKeys, deltaVals: ex.deltaVals, value: reply, status: 200, msg: "", retStatus: ex.retStatus, headerNames: ex.headerNames, headerVals: ex.headerVals, code: ""}

    proc rtSessionToken(w: RtWorld, sid: text) -> text:
        if sid == "" || sid == "__system" || sid == "tool":
            return ""
        let t = do rtSignValue(w, sid)
        return t

    # rtRevokeVisitor: every session sharing the visitor key ends; whether
    # the caller's own did.
    struct RtRevoked:
        w: RtWorld
        endedOwn: bool

    proc rtRevokeVisitor(w0: RtWorld, key: text, own: text) -> RtRevoked:
        let mut w = w0
        let mut kept = []
        let mut endedOwn = false
        let mut i = 0
        loop i < len(w.sessions):
            let ses = w.sessions[i]
            let tok = do rtSessionToken(w, ses.sid)
            if ses.visitor == key && tok != "":
                if ses.sid == own:
                    endedOwn = true
            else:
                kept = append(kept, ses)
            i = i + 1
        w.sessions = kept
        # every instance's copies too: the shared table, then the bus
        if w.clusterOn:
            w.revokeKeys = append(w.revokeKeys, key)
        return RtRevoked{w: w, endedOwn: endedOwn}

    proc rtRestateActor(w0: RtWorld, actor: text, role: text) -> RtWorld:
        let mut w = w0
        if actor == "" || actor == "guest":
            return w
        let mut i = 0
        loop i < len(w.sessions):
            if w.sessions[i].actor == actor && w.sessions[i].sid != "__system" && w.sessions[i].sid != "tool":
                let mut ses = w.sessions[i]
                ses.role = role
                ses = do rtSesSet(ses, "role", textVal(role))
                w.sessions[i] = ses
            i = i + 1
        if w.clusterOn:
            w.restateActors = append(w.restateActors, actor)
            w.restateRoles = append(w.restateRoles, role)
        return w

    # ── constraints ─────────────────────────────────────────────────────
    proc rtConstraintError(w: RtWorld, entity: text, row: Val, changedField: text, excludeID: Val) -> text:
        let ei = do rtEntityIndex(w.g, entity)
        if ei < 0:
            return ""
        let def = w.g.entities[ei]
        let rows = do rtEntRows(w, entity)
        let mut i = 0
        loop i < len(def.fields):
            let f = def.fields[i]
            let relevant = changedField == "" || f.name == changedField
            let any = f.required || f.unique || f.hasMin || f.hasMax || f.matches != ""
            if relevant && any:
                let present = do valHas(row, f.name)
                let val = do valGet(row, f.name)
                let vs = do valToStr(val)
                if f.required && (!present || val.kind == "none" || vs == ""):
                    return f.name + " is required"
                if present && val.kind != "none":
                    if f.hasMin || f.hasMax:
                        if f.type == "text":
                            let n = len(vs)
                            if f.hasMin && n < f.min:
                                return f.name + " must be at least " + f.min + " characters"
                            if f.hasMax && n > f.max:
                                return f.name + " must be at most " + f.max + " characters"
                        else:
                            let n2 = do valToInt(val)
                            if f.hasMin && n2 < f.min:
                                return f.name + " must be at least " + f.min
                            if f.hasMax && n2 > f.max:
                                return f.name + " must be at most " + f.max
                    if f.unique:
                        let mut k = 0
                        loop k < len(rows):
                            let m = rows[k]
                            if m.kind == "record":
                                let mid = do valGet(m, "id")
                                let mut skip = false
                                if excludeID.kind != "none":
                                    skip = do valEqual(mid, excludeID)
                                if !skip:
                                    let mv = do valGet(m, f.name)
                                    let same = do valEqual(mv, val)
                                    if same:
                                        return f.name + " must be unique"
                            k = k + 1
            i = i + 1
        return ""

    proc rtIsHashed(g: IRGraph, entity: text, field: text) -> bool:
        let ei = do rtEntityIndex(g, entity)
        if ei < 0:
            return false
        let mut i = 0
        loop i < len(g.entities[ei].fields):
            let f = g.entities[ei].fields[i]
            if f.name == field:
                return f.password
            i = i + 1
        return false

    # rtStoredValue: storedValue — a @password field's value as it is
    # stored: its bcrypt hash ("" stays "", no credential), or a message when
    # it cannot be one (bcrypt reads at most 72 bytes).
    struct RtStored:
        v: Val
        msg: text

    proc rtStoredValue(g: IRGraph, entity: text, field: text, v: Val) -> RtStored:
        # a column holds its declared type from the first write (columnValue)
        let mut cv = v
        let ei = do rtEntityIndex(g, entity)
        if ei >= 0:
            let mut k = 0
            loop k < len(g.entities[ei].fields):
                if g.entities[ei].fields[k].name == field:
                    cv = do rtColumnValue(g.entities[ei].fields[k], v)
                k = k + 1
        let hashed = do rtIsHashed(g, entity, field)
        if !hashed:
            return RtStored{v: cv, msg: ""}
        let pv = do valToStr(cv)
        if pv == "":
            return RtStored{v: textVal(""), msg: ""}
        if byteLen(pv) > 72:
            return RtStored{v: v, msg: field + " must be at most 72 bytes"}
        return RtStored{v: textVal(bcryptHash(pv)), msg: ""}

    # rtStoreFields: storedValue over the named fields of a row about to be
    # written (storeRow: every field of a new row; a `set`: the ones it
    # assigns, so a stored hash it leaves alone is never hashed again).
    struct RtStoredRow:
        row: Val
        msg: text

    proc rtStoreFields(g: IRGraph, entity: text, row: Val, fields: [text]) -> RtStoredRow:
        let mut out = row
        let mut i = 0
        loop i < len(fields):
            let cur = do valGet(out, fields[i])
            let sv = do rtStoredValue(g, entity, fields[i], cur)
            if sv.msg != "":
                return RtStoredRow{row: row, msg: sv.msg}
            out = do valSet(out, fields[i], sv.v)
            i = i + 1
        return RtStoredRow{row: out, msg: ""}

    proc rtMarkChanged(ex0: RtExec, entity: text) -> RtExec:
        let mut ex = ex0
        let mut i = 0
        loop i < len(ex.changed):
            if ex.changed[i] == entity:
                return ex
            i = i + 1
        ex.changed = append(ex.changed, entity)
        return ex

    proc rtDelta(ex0: RtExec, name: text, v: Val) -> RtExec:
        let mut ex = ex0
        let mut i = 0
        loop i < len(ex.deltaKeys):
            if ex.deltaKeys[i] == name:
                ex.deltaVals[i] = v
                return ex
            i = i + 1
        ex.deltaKeys = append(ex.deltaKeys, name)
        ex.deltaVals = append(ex.deltaVals, v)
        return ex

    proc rtSesSet(ses0: RtSession, name: text, v: Val) -> RtSession:
        let mut ses = ses0
        let mut i = 0
        loop i < len(ses.stateKeys):
            if ses.stateKeys[i] == name:
                ses.stateVals[i] = v
                return ses
            i = i + 1
        ses.stateKeys = append(ses.stateKeys, name)
        ses.stateVals = append(ses.stateVals, v)
        return ses

    proc rtSesGet(ses: RtSession, name: text) -> Val:
        let v = do lookupRef(name, ses.stateKeys, ses.stateVals)
        return v

    proc rtSameValue(a: Val, b: Val) -> bool:
        if a.kind != b.kind:
            return false
        let x = do valToStr(a)
        let y = do valToStr(b)
        return x == y

    # rtRefresh: keep the entity collections in scope fresh for later
    # statements.
    proc rtRefresh(ex0: RtExec) -> RtExec:
        let mut ex = ex0
        let mut i = 0
        loop i < len(ex.changed):
            let rows = do rtEntRows(ex.w, ex.changed[i])
            ex.sc = do rtSet(ex.sc, ex.changed[i], listVal(rows))
            i = i + 1
        return ex

    proc rtFail(ex0: RtExec, status: int, msg: text) -> RtExec:
        let mut ex = ex0
        ex.status = status
        ex.msg = msg
        return ex

    # rtFailAs: rtFail at a site Go meters — observeAction(name, outcome)
    # for the action whose body is running (a `run` callee's own name).
    # rtFailAudit: rtFailAs at a site Go also audits (recordAudit, denied).
    proc rtFailAudit(ex0: RtExec, status: int, msg: text, outcome: text, detail: text) -> RtExec:
        let mut ex = ex0
        ex.audits = append(ex.audits, RtAudit{time: 0, actor: ex.actor, action: ex.actName, allowed: false, detail: detail})
        let f = do rtFailAs(ex, status, msg, outcome)
        return f

    proc rtFailAs(ex0: RtExec, status: int, msg: text, outcome: text) -> RtExec:
        let mut ex = ex0
        ex.obs = append(ex.obs, ex.actName + "|" + outcome)
        let f = do rtFail(ex, status, msg)
        return f

    # rtExecBlock: execActionBlock — a block's statements in order; names
    # the block bound are dropped on exit.
    proc rtExecBlock(body: [IRStmt], ex0: RtExec) -> RtExec:
        let mut ex = ex0
        let outerBound = ex.bound
        ex.bound = []
        let mut i = 0
        let mut stop = false
        loop i < len(body) && !stop:
            ex = do rtExecStmt(body[i], ex)
            if ex.status != 200 || ex.returned:
                stop = true
            ex = do rtRefresh(ex)
            i = i + 1
        let mut k = 0
        loop k < len(ex.bound):
            ex.sc = do rtDrop(ex.sc, ex.bound[k])
            k = k + 1
        ex.bound = outerBound
        return ex

    proc rtExecStmt(st: IRStmt, ex0: RtExec) -> RtExec:
        let mut ex = ex0
        let op = st.op
        # a statement that can write rows, or run something that does: the
        # scope's row indexes may no longer describe its rows
        if op in ["add", "set", "remove", "clear", "call", "run", "do"]:
            ex.sc.ixs = []
        if op == "check":
            let cr = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = cr.sc
            if ex.sc.err != "":
                let pf = do rtProcError(ex)
                return pf
            let ok = do valTruthy(cr.v)
            if !ok:
                let mut msg = st.msg
                if len(st.key) > 0:
                    let mr = do rtEvalOpt(st.key, ex.sc, -1)
                    msg = do valToStr(mr.v)
                ex.errCode = st.target
                let mut status = 422
                if st.status != 0:
                    status = st.status
                let f = do rtFailAudit(ex, status, msg, "invalid", "check failed: " + msg)
                return f
            return ex
        if op == "header":
            let hr = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = hr.sc
            let hv = do valToStr(hr.v)
            let valid = do rtValidHeaderValue(hv)
            if !valid:
                let hf = do rtFailAs(ex, 500, "header " + st.msg + " has a value that is not a valid HTTP header value", "invalid")
                return hf
            ex.headerNames = append(ex.headerNames, st.msg)
            ex.headerVals = append(ex.headerVals, hv)
            return ex
        if op == "revoke":
            let rvr = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = rvr.sc
            ex.revokes = append(ex.revokes, valToStr(rvr.v))
            return ex
        if op == "restate":
            let ra = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = ra.sc
            let rr0 = do rtEvalOpt(st.role, ex.sc, -1)
            ex.sc = rr0.sc
            ex.restateActors = append(ex.restateActors, valToStr(ra.v))
            ex.restateRoles = append(ex.restateRoles, valToStr(rr0.v))
            return ex
        if op == "emit":
            # `emit [name] Dto{…} [to actor] [on key…]`: recorded, and fanned
            # out to the declared streams once the action is durable
            # (fanoutEvents after commit); a failed action emits nothing.
            let er0 = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = er0.sc
            let payload = do rtValJSON(er0.v)
            let mut key = ""
            if len(st.args) > 0:
                let kr = do rtEvalList(st.args, ex.sc, -1)
                ex.sc = kr.sc
                let mut parts = []
                let mut ki = 0
                loop ki < len(kr.v.items):
                    parts = append(parts, valToStr(kr.v.items[ki]))
                    ki = ki + 1
                key = do rtJoinTexts(parts, "\x00")
            let mut to = ""
            let mut targeted = false
            if len(st.key) > 0:
                let tr = do rtEvalOpt(st.key, ex.sc, -1)
                ex.sc = tr.sc
                to = do valToStr(tr.v)
                targeted = true
            ex.w.pendingEvents = append(ex.w.pendingEvents, RtEmitted{typ: st.field, name: st.target, payload: payload, to: to, targeted: targeted, key: key})
            return ex
        if op == "assign":
            let vr = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = vr.sc
            if ex.sc.err != "":
                let pf2 = do rtProcError(ex)
                return pf2
            let cur = do rtSesGet(ex.ses, st.target)
            let same = do rtSameValue(cur, vr.v)
            if !same:
                ex.ses = do rtSesSet(ex.ses, st.target, vr.v)
                ex.sc = do rtSet(ex.sc, st.target, vr.v)
                let priv = do rtIsPrivateState(ex.w.g, st.target)
                if !priv:
                    ex = do rtDelta(ex, st.target, vr.v)
            return ex
        if op == "establish":
            let ar = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = ar.sc
            let na = do valToStr(ar.v)
            let curTok = do rtSessionToken(ex.w, ex.ses.sid)
            if ex.rekey == "" && curTok != "":
                let fresh = do rtNewSessionID()
                ex.rekey = fresh
                let tokV = do rtSessionToken(ex.w, fresh)
                ex.sc = do rtSet(ex.sc, "sessionToken", textVal(tokV))
            ex.ses.actor = na
            ex.sc = do rtSet(ex.sc, "actor", textVal(na))
            ex = do rtDelta(ex, "actor", textVal(na))
            if len(st.role) > 0:
                let rr = do rtEvalOpt(st.role, ex.sc, -1)
                ex.sc = rr.sc
                let nr = do valToStr(rr.v)
                ex.ses.role = nr
                ex.sc = do rtSet(ex.sc, "role", textVal(nr))
                ex = do rtDelta(ex, "role", textVal(nr))
            return ex
        if op == "add":
            let mut row = do recordVal([], [])
            let mut fi = 0
            loop fi < len(st.fieldNames):
                let fr = do rtEval(st.fieldExprs[fi], ex.sc, -1)
                ex.sc = fr.sc
                row = do valSet(row, st.fieldNames[fi], fr.v)
                fi = fi + 1
            if ex.sc.err != "":
                let pf3 = do rtProcError(ex)
                return pf3
            let none = do noneVal()
            let bad = do rtConstraintError(ex.w, st.entity, row, "", none)
            if bad != "":
                let f2 = do rtFailAudit(ex, 422, bad, "invalid", "constraint: " + bad)
                return f2
            # every column the add does not name holds its empty value, as a
            # store that reloaded the row would hand it back
            let aei = do rtEntityIndex(ex.w.g, st.entity)
            if aei >= 0:
                let mut k = 0
                loop k < len(ex.w.g.entities[aei].fields):
                    let af = ex.w.g.entities[aei].fields[k]
                    let named = do valHas(row, af.name)
                    if af.name != "id" && !named:
                        row = do valSet(row, af.name, rtColumnValue(af, noneVal()))
                    k = k + 1
            let stored = do rtStoreFields(ex.w.g, st.entity, row, row.keys)
            if stored.msg != "":
                let f3 = do rtFailAudit(ex, 422, stored.msg, "invalid", "constraint: " + stored.msg)
                return f3
            row = stored.row
            let ei = do rtEntIndex(ex.w, st.entity)
            if ei >= 0:
                let id = ex.w.nextIds[ei] + 1
                ex.w.nextIds[ei] = id
                row = do valSet(row, "id", intVal(id))
                let rows = do rtEntRows(ex.w, st.entity)
                ex.w = do rtSetEntRows(ex.w, st.entity, append(rows, row))
                ex.w = do rtDurSave(ex.w, st.entity, row)
                ex = do rtMarkChanged(ex, st.entity)
                if st.bind != "":
                    ex.sc = do rtSet(ex.sc, st.bind, intVal(id))
                    ex.bound = append(ex.bound, st.bind)
            return ex
        if op == "set":
            let sr = do rtExecSet(st, ex)
            return sr
        if op == "remove":
            let rmr = do rtExecRemove(st, ex)
            return rmr
        if op == "clear":
            ex.w = do rtSetEntRows(ex.w, st.entity, [])
            ex.w = do rtDurClear(ex.w, st.entity)
            ex = do rtMarkChanged(ex, st.entity)
            ex = do rtCascade(ex, st.entity, [])
            return ex
        if op == "exprstmt":
            let er = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = er.sc
            return ex
        if op == "return":
            if len(st.value) > 0:
                let rv = do rtEvalOpt(st.value, ex.sc, -1)
                ex.sc = rv.sc
                if ex.sc.err != "":
                    let pf4 = do rtProcError(ex)
                    return pf4
                ex.retVal = rv.v
            ex.retStatus = st.status
            ex.returned = true
            return ex
        if op == "let":
            let lr = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = lr.sc
            if ex.sc.err != "":
                let pf5 = do rtProcError(ex)
                return pf5
            ex.sc = do rtSet(ex.sc, st.target, lr.v)
            ex.bound = append(ex.bound, st.target)
            return ex
        if op == "if":
            let cr2 = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = cr2.sc
            if ex.sc.err != "":
                let pf6 = do rtProcError(ex)
                return pf6
            let t = do valTruthy(cr2.v)
            if t:
                let br = do rtExecBlock(st.body, ex)
                return br
            if len(st.elseBody) > 0:
                let er2 = do rtExecBlock(st.elseBody, ex)
                return er2
            return ex
        if op == "for":
            let fr2 = do rtExecFor(st, ex)
            return fr2
        if op == "foreach":
            let items = do rtEvalOpt(st.value, ex.sc, -1)
            ex.sc = items.sc
            let prev = do rtGet(ex.sc, st.itemVar)
            let had = do rtHas(ex.sc, st.itemVar)
            let mut i = 0
            let mut stop = false
            loop i < len(items.v.items) && !stop:
                ex.sc = do rtSet(ex.sc, st.itemVar, items.v.items[i])
                ex = do rtExecBlock(st.body, ex)
                if ex.status != 200 || ex.returned:
                    stop = true
                i = i + 1
            ex.sc = do rtRestore(ex.sc, st.itemVar, had, prev)
            return ex
        if op == "do":
            let dar = do rtEvalList(st.args, ex.sc, -1)
            ex.sc = dar.sc
            if ex.sc.err != "":
                let pf7 = do rtProcError(ex)
                return pf7
            let res = do rtRunProc(st.service, dar.v.items)
            if res.sc.err != "":
                let df = do rtFailAs(ex, 500, ex.actName + ": proc " + st.service + " failed: " + res.sc.err, "proc_error")
                return df
            if st.bind != "":
                let cv = do rtCoerceRet(res.v, st.ret, st.retList)
                ex.sc = do rtSet(ex.sc, st.bind, cv)
                ex.bound = append(ex.bound, st.bind)
            return ex
        if op == "run":
            let rr = do rtExecRun(st, ex)
            return rr
        if op == "call":
            # An external service (callService / callServiceSync): the only
            # egress the Go runtime makes; a self-hosted runtime has no
            # brain to post to in this harness, so a bound call fails as an
            # unreachable service does and a fire-and-forget one is dropped.
            if st.bind != "":
                let sf = do rtFailAs(ex, 502, st.service + "." + st.field + " unavailable", "service_error")
                return sf
            return ex
        return ex

    # rtExecRun: runNested — `run name(args)` / `let x = run name(args)`:
    # another action inside this one's transaction. Its parameters are bound
    # from the caller's arguments (a bad one is a 400), its `requires` gate it
    # (403), and its body runs against a fresh scope of the session and the
    # current working set with the caller's identity. Its writes, emits,
    # headers, deltas and session effects join the caller's — they live on
    # the same world and session this run carries — so a failure anywhere
    # rolls both back; its `return` ends only itself and binds when asked.
    proc rtExecRun(st: IRStmt, ex0: RtExec) -> RtExec:
        let mut ex = ex0
        let ai = do rtActionIndex(ex.w.g, st.service)
        if ai < 0:
            let f0 = do rtFail(ex, 500, "run: unknown action " + st.service)
            return f0
        if ex.runDepth >= 16:
            let f1 = do rtFail(ex, 500, "run: " + st.service + " nests deeper than 16 actions")
            return f1
        let callee = ex.w.g.actions[ai]
        let withSes = do rtPutSession(ex.w, ex.ses)
        let mut sc = do rtScope(withSes, ex.ses.sid)
        sc = do rtSet(sc, "actor", rtGet(ex.sc, "actor"))
        sc = do rtSet(sc, "role", rtGet(ex.sc, "role"))
        sc = do rtSet(sc, "verified", rtGet(ex.sc, "verified"))
        let mut i = 0
        loop i < len(callee.params):
            let p = callee.params[i]
            let mut v = do rtParamZero(p)
            if i < len(st.args):
                let ar = do rtEval(st.args[i], ex.sc, -1)
                ex.sc = ar.sc
                if ex.sc.err != "":
                    let pe = do rtProcError(ex)
                    return pe
                let c = do rtArgFor(ex.w.g, ar.v, p)
                if !c.ok:
                    let f2 = do rtFail(ex, 400, callee.name + ": parameter \"" + p.name + "\" expects " + rtParamTypeName(p))
                    return f2
                v = c.v
            sc = do rtSet(sc, p.name, v)
            i = i + 1
        let mut r = 0
        loop r < len(callee.requires):
            let ok = do rtPolicyPasses(ex.w.g, callee.requires[r], sc)
            if !ok:
                let f3 = do rtFail(ex, 403, "forbidden: " + callee.requires[r].name)
                return f3
            r = r + 1
        let mut child = ex
        child.sc = sc
        child.retVal = do noneVal()
        child.retStatus = 0
        child.returned = false
        child.bound = []
        child.actName = callee.name
        child.runDepth = ex.runDepth + 1
        let done = do rtExecBlock(callee.body, child)
        ex.w = done.w
        ex.ses = done.ses
        ex.deltaKeys = done.deltaKeys
        ex.deltaVals = done.deltaVals
        ex.changed = done.changed
        ex.headerNames = done.headerNames
        ex.headerVals = done.headerVals
        ex.revokes = done.revokes
        ex.restateActors = done.restateActors
        ex.restateRoles = done.restateRoles
        ex.rekey = done.rekey
        ex.obs = done.obs
        ex.audits = done.audits
        if done.status != 200:
            ex.errCode = done.errCode
            let f4 = do rtFail(ex, done.status, done.msg)
            return f4
        if st.bind != "":
            ex.sc = do rtSet(ex.sc, st.bind, done.retVal)
        return ex

    # rtProcError: a proc that failed inside an expression fails the action
    # with its own message (execActionBlockCatching).
    proc rtProcError(ex0: RtExec) -> RtExec:
        let mut ex = ex0
        let msg = ex.sc.err
        let mut cleared = ex.sc
        cleared.err = ""
        ex.sc = cleared
        let f = do rtFailAs(ex, 500, msg, "proc_error")
        return f

    proc rtValidHeaderValue(v: text) -> bool:
        let bs = textToBytes(v)
        let mut i = 0
        loop i < len(bs):
            let c = bs[i]
            if (c < 32 && c != 9) || c == 127:
                return false
            i = i + 1
        return true

    proc rtExecSet(st: IRStmt, ex0: RtExec) -> RtExec:
        let mut ex = ex0
        let rows = do rtEntRows(ex.w, st.entity)
        if len(st.where) > 0:
            let prev = do rtGet(ex.sc, st.itemVar)
            let had = do rtHas(ex.sc, st.itemVar)
            let mut out = []
            let mut matched = false
            let mut i = 0
            loop i < len(rows):
                let m = rows[i]
                let mut keep = m
                if m.kind == "record":
                    ex.sc = do rtSet(ex.sc, st.itemVar, m)
                    let pr = do rtEval(st.where[0], ex.sc, -1)
                    ex.sc = pr.sc
                    let hit = do valTruthy(pr.v)
                    if hit:
                        let mut cand = m
                        let mut fi = 0
                        loop fi < len(st.fieldNames):
                            let fr = do rtEval(st.fieldExprs[fi], ex.sc, -1)
                            ex.sc = fr.sc
                            cand = do valSet(cand, st.fieldNames[fi], fr.v)
                            fi = fi + 1
                        let mid = do valGet(m, "id")
                        let mut fj = 0
                        loop fj < len(st.fieldNames):
                            let bad = do rtConstraintError(ex.w, st.entity, cand, st.fieldNames[fj], mid)
                            if bad != "":
                                ex.sc = do rtRestore(ex.sc, st.itemVar, had, prev)
                                let f = do rtFailAudit(ex, 422, bad, "invalid", "constraint: " + bad)
                                return f
                            fj = fj + 1
                        let stc = do rtStoreFields(ex.w.g, st.entity, cand, st.fieldNames)
                        if stc.msg != "":
                            ex.sc = do rtRestore(ex.sc, st.itemVar, had, prev)
                            let f5 = do rtFailAudit(ex, 422, stc.msg, "invalid", "constraint: " + stc.msg)
                            return f5
                        cand = stc.row
                        keep = cand
                        matched = true
                        ex.w = do rtDurSave(ex.w, st.entity, cand)
                out = append(out, keep)
                i = i + 1
            ex.sc = do rtRestore(ex.sc, st.itemVar, had, prev)
            ex.w = do rtSetEntRows(ex.w, st.entity, out)
            if matched:
                ex = do rtMarkChanged(ex, st.entity)
            return ex
        let kr = do rtEvalOpt(st.key, ex.sc, -1)
        ex.sc = kr.sc
        let mut out2 = []
        let mut done = false
        let mut j = 0
        loop j < len(rows):
            let m2 = rows[j]
            let mut keep2 = m2
            if m2.kind == "record" && !done:
                let id2 = do valGet(m2, "id")
                let same = do valEqual(id2, kr.v)
                if same:
                    let nv = do rtEvalOpt(st.value, ex.sc, -1)
                    ex.sc = nv.sc
                    let mut cand2 = do valSet(m2, st.field, nv.v)
                    let bad2 = do rtConstraintError(ex.w, st.entity, cand2, st.field, id2)
                    if bad2 != "":
                        let f2 = do rtFailAudit(ex, 422, bad2, "invalid", "constraint: " + bad2)
                        return f2
                    let stc2 = do rtStoreFields(ex.w.g, st.entity, cand2, [st.field])
                    if stc2.msg != "":
                        let f6 = do rtFailAudit(ex, 422, stc2.msg, "invalid", "constraint: " + stc2.msg)
                        return f6
                    cand2 = stc2.row
                    keep2 = cand2
                    done = true
                    ex.w = do rtDurSave(ex.w, st.entity, cand2)
            out2 = append(out2, keep2)
            j = j + 1
        if done:
            ex.w = do rtSetEntRows(ex.w, st.entity, out2)
            ex = do rtMarkChanged(ex, st.entity)
        return ex

    proc rtIsSoftDelete(g: IRGraph, entity: text) -> bool:
        let ei = do rtEntityIndex(g, entity)
        if ei < 0:
            return false
        return g.entities[ei].softDelete

    proc rtExecRemove(st: IRStmt, ex0: RtExec) -> RtExec:
        let mut ex = ex0
        let soft = do rtIsSoftDelete(ex.w.g, st.entity)
        let rows = do rtEntRows(ex.w, st.entity)
        let mut kept = []
        let mut removed = []
        if len(st.where) > 0:
            let prev = do rtGet(ex.sc, st.itemVar)
            let had = do rtHas(ex.sc, st.itemVar)
            let mut i = 0
            loop i < len(rows):
                let m = rows[i]
                if m.kind != "record":
                    kept = append(kept, m)
                else:
                    ex.sc = do rtSet(ex.sc, st.itemVar, m)
                    let pr = do rtEval(st.where[0], ex.sc, -1)
                    ex.sc = pr.sc
                    let hit = do valTruthy(pr.v)
                    if hit:
                        let mid = do valGet(m, "id")
                        removed = append(removed, valToInt(mid))
                        if soft:
                            let archived = do valSet(m, "archived", boolVal(true))
                            kept = append(kept, archived)
                            ex.w = do rtDurSave(ex.w, st.entity, archived)
                        else:
                            ex.w = do rtDurDelete(ex.w, st.entity, valToInt(mid))
                    else:
                        kept = append(kept, m)
                i = i + 1
            ex.sc = do rtRestore(ex.sc, st.itemVar, had, prev)
        else:
            let kr = do rtEvalOpt(st.key, ex.sc, -1)
            ex.sc = kr.sc
            let mut done = false
            let mut j = 0
            loop j < len(rows):
                let m2 = rows[j]
                let mut drop = false
                if m2.kind == "record" && !done:
                    let id2 = do valGet(m2, "id")
                    let same = do valEqual(id2, kr.v)
                    if same:
                        drop = true
                        done = true
                        removed = append(removed, valToInt(id2))
                        if soft:
                            let archived2 = do valSet(m2, "archived", boolVal(true))
                            kept = append(kept, archived2)
                            ex.w = do rtDurSave(ex.w, st.entity, archived2)
                        else:
                            ex.w = do rtDurDelete(ex.w, st.entity, valToInt(id2))
                if !drop:
                    kept = append(kept, m2)
                j = j + 1
        if len(removed) > 0:
            if soft:
                let mut live = []
                let mut k = 0
                loop k < len(kept):
                    let av = do valGet(kept[k], "archived")
                    let arch = do valTruthy(av)
                    if !arch:
                        live = append(live, kept[k])
                    k = k + 1
                ex.w = do rtSetEntRows(ex.w, st.entity, live)
            else:
                ex.w = do rtSetEntRows(ex.w, st.entity, kept)
                ex = do rtCascade(ex, st.entity, removed)
            ex = do rtMarkChanged(ex, st.entity)
        return ex

    # rtCascade: cascadeMem — a hard delete removes the children that
    # reference the removed rows (a field with `ref` to the parent).
    proc rtCascade(ex0: RtExec, parent: text, removed: [int]) -> RtExec:
        let mut ex = ex0
        let g = ex.w.g
        let mut e = 0
        loop e < len(g.entities):
            let ent = g.entities[e]
            let mut f = 0
            loop f < len(ent.fields):
                let fld = ent.fields[f]
                if fld.ref == parent:
                    let rows = do rtEntRows(ex.w, ent.name)
                    let mut kept = []
                    let mut gone = []
                    let mut i = 0
                    loop i < len(rows):
                        let fv = do valGet(rows[i], fld.name)
                        let fid = do valToInt(fv)
                        let mut hit = false
                        let mut k = 0
                        loop k < len(removed):
                            if removed[k] == fid:
                                hit = true
                            k = k + 1
                        if len(removed) == 0:
                            hit = false
                        if hit:
                            let cid = do valGet(rows[i], "id")
                            gone = append(gone, valToInt(cid))
                        else:
                            kept = append(kept, rows[i])
                        i = i + 1
                    if len(gone) > 0:
                        ex.w = do rtSetEntRows(ex.w, ent.name, kept)
                        ex = do rtMarkChanged(ex, ent.name)
                        ex = do rtCascade(ex, ent.name, gone)
                f = f + 1
            e = e + 1
        return ex

    proc rtExecFor(st: IRStmt, ex0: RtExec) -> RtExec:
        let mut ex = ex0
        let rows = do rtEntRows(ex.w, st.entity)
        let prev = do rtGet(ex.sc, st.itemVar)
        let had = do rtHas(ex.sc, st.itemVar)
        let mut picked = []
        let mut i = 0
        loop i < len(rows):
            let m = rows[i]
            if m.kind == "record":
                ex.sc = do rtSet(ex.sc, st.itemVar, m)
                let mut hit = true
                if len(st.where) > 0:
                    let pr = do rtEval(st.where[0], ex.sc, -1)
                    ex.sc = pr.sc
                    hit = do valTruthy(pr.v)
                if hit:
                    picked = append(picked, m)
            i = i + 1
        ex.sc = do rtRestore(ex.sc, st.itemVar, had, prev)
        if ex.sc.err != "":
            let pfe = do rtProcError(ex)
            return pfe
        picked = do rtSortRows(picked, st.order, st.desc)
        if len(st.limit) > 0:
            let lr = do rtEvalOpt(st.limit, ex.sc, -1)
            ex.sc = lr.sc
            let lim = do valToInt(lr.v)
            if lim <= 0:
                picked = []
            else:
                if len(picked) > lim:
                    picked = slice(picked, 0, lim)
        let mut j = 0
        let mut stop = false
        loop j < len(picked) && !stop:
            ex.sc = do rtSet(ex.sc, st.itemVar, picked[j])
            ex = do rtExecBlock(st.body, ex)
            if ex.status != 200 || ex.returned:
                stop = true
            j = j + 1
        ex.sc = do rtRestore(ex.sc, st.itemVar, had, prev)
        return ex
