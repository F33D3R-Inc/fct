app CheckpointSelfHost:
    # checkpoint.fct — self-hosted port of facetql/src/storage/checkpoint.rs:
    # the durable high-water mark (the highest WAL sequence already
    # reflected in physical storage) and the open-transaction fences that
    # keep it from ever crossing a staged BEGIN … COMMIT frame.
    #
    # The file (`facetql.checkpoint` in the data directory) holds one ASCII
    # u64 and nothing else. read fails closed on anything that is not
    # unambiguously that — too long, not UTF-8, whitespace only, not plain
    # digits, too large for a u64 — naming the file and quoting what is in
    # it, because a value that reads too high silently skips recovery of
    # durable records. A missing or zero-length file is 0 (the latter with
    # a warning: it is what an interrupted create leaves behind).
    #
    # advance never moves backwards and never reaches the lowest open
    # fence; a write is a whole-file replace through a temp file: written,
    # fsynced (syncFile), atomically renamed over the name and the
    # directory fsynced (renameFile), so a reader sees the old value or the
    # new one, never a torn number, and the new name survives a crash.
    #
    # checkpoint.rs keeps its fences in a process-wide set; a proc has no
    # shared state, so the fence set and the temp-name counter are a value
    # (FqCkpt) every call takes and returns.
    struct FqCkpt:
        fences: [int]
        tmpCounter: int

    struct FqCkptRead:
        ok: bool
        err: text
        warning: text
        value: int

    struct FqCkptAdvance:
        ok: bool
        err: text
        ckpt: FqCkpt
        written: bool
        value: int

    proc ckNew() -> FqCkpt:
        return FqCkpt{fences: [], tmpCounter: 0}

    # ckBeginFence: begin_fence — register an open transaction's BEGIN.
    proc ckBeginFence(c: FqCkpt, beginSequence: int) -> FqCkpt:
        if beginSequence in c.fences:
            return c
        return FqCkpt{fences: append(c.fences, beginSequence), tmpCounter: c.tmpCounter}

    # ckReleaseFence: release_fence — the transaction has settled.
    proc ckReleaseFence(c: FqCkpt, beginSequence: int) -> FqCkpt:
        let mut kept = []
        let n = len(c.fences)
        let mut i = 0
        loop i < n:
            if c.fences[i] != beginSequence:
                kept = append(kept, c.fences[i])
            i = i + 1
        return FqCkpt{fences: kept, tmpCounter: c.tmpCounter}

    # ckCeiling: ceiling — min_fence - 1, or -1 (unbounded) with none open.
    proc ckCeiling(c: FqCkpt) -> int:
        let n = len(c.fences)
        if n == 0:
            return -1
        let mut m = c.fences[0]
        let mut i = 1
        loop i < n:
            if c.fences[i] < m:
                m = c.fences[i]
            i = i + 1
        if m == 0:
            return 0
        return m - 1

    # ckQuote: Rust's `{:?}` of the (lossily decoded) file content —
    # quotes, backslashes and the common escapes, other control characters
    # as \u{hex}.
    proc ckQuote(s: text) -> text:
        let cs = split(s, "")
        let digits = split("0123456789abcdef", "")
        let mut out = "\""
        let n = len(cs)
        let mut i = 0
        loop i < n:
            let c = cs[i]
            let bs = textToBytes(c)
            let mut cp = -1
            if len(bs) == 1:
                cp = bs[0]
            if len(bs) == 2 && bs[0] == 194 && bs[1] < 160:
                cp = bs[1]
            if c == "\"":
                out = out + "\\\""
            else:
                if c == "\\":
                    out = out + "\\\\"
                else:
                    if c == "\n":
                        out = out + "\\n"
                    else:
                        if c == "\t":
                            out = out + "\\t"
                        else:
                            if c == "\r":
                                out = out + "\\r"
                            else:
                                if cp == 0:
                                    out = out + "\\0"
                                else:
                                    if cp >= 0 && (cp < 32 || (cp >= 127 && cp < 160)):
                                        let mut h = digits[cp % 16]
                                        if cp >= 16:
                                            h = digits[cp / 16] + h
                                        out = out + "\\u{" + h + "}"
                                    else:
                                        out = out + c
            i = i + 1
        return out + "\""

    proc ckCorrupt(path: text, detail: text) -> FqCkptRead:
        return FqCkptRead{ok: false, err: "corrupt checkpoint file " + path + ": " + detail + ". Refusing to guess: a checkpoint that reads too high silently skips WAL recovery of durable records. Restore the file from a backup, or delete it to replay the whole WAL (safe, but re-applies non-idempotent archive/edge operations).", warning: "", value: 0}

    # CkUtf8: str::from_utf8's verdict on bytes starting at `from` — the
    # first error's valid_up_to and error_len (0 = None: the input ended
    # inside a sequence), or ok.
    struct CkUtf8:
        ok: bool
        validUpTo: int
        errLen: int

    proc ckIsCont(b: int) -> bool:
        return b >= 128 && b <= 191

    proc ckUtf8(bs: [int], from: int) -> CkUtf8:
        let n = len(bs)
        let mut i = from
        loop i < n:
            let b = bs[i]
            if b < 128:
                i = i + 1
                continue
            let mut width = 0
            if b >= 194 && b <= 223:
                width = 2
            if b >= 224 && b <= 239:
                width = 3
            if b >= 240 && b <= 244:
                width = 4
            if width == 0:
                return CkUtf8{ok: false, validUpTo: i, errLen: 1}
            if i + 1 >= n:
                return CkUtf8{ok: false, validUpTo: i, errLen: 0}
            let b1 = bs[i + 1]
            let mut okSecond = false
            if width == 2:
                okSecond = b1 >= 128 && b1 <= 191
            if width == 3:
                okSecond = (b == 224 && b1 >= 160 && b1 <= 191) || (b >= 225 && b <= 236 && b1 >= 128 && b1 <= 191) || (b == 237 && b1 >= 128 && b1 <= 159) || (b >= 238 && b1 >= 128 && b1 <= 191)
            if width == 4:
                okSecond = (b == 240 && b1 >= 144 && b1 <= 191) || (b >= 241 && b <= 243 && b1 >= 128 && b1 <= 191) || (b == 244 && b1 >= 128 && b1 <= 143)
            if !okSecond:
                return CkUtf8{ok: false, validUpTo: i, errLen: 1}
            let mut k = 2
            loop k < width:
                if i + k >= n:
                    return CkUtf8{ok: false, validUpTo: i, errLen: 0}
                let ck = do ckIsCont(bs[i + k])
                if !ck:
                    return CkUtf8{ok: false, validUpTo: i, errLen: k}
                k = k + 1
            i = i + width
        return CkUtf8{ok: true, validUpTo: n, errLen: 0}

    proc ckSliceText(bs: [int], a: int, b: int) -> text:
        let mut out = bytes(b - a)
        let mut i = a
        loop i < b:
            out[i - a] = bs[i]
            i = i + 1
        let t = bytesToText(out)
        return t

    # ckLossy: String::from_utf8_lossy — each invalid sequence one U+FFFD.
    proc ckLossy(bs: [int]) -> text:
        let n = len(bs)
        let mut out = ""
        let mut at = 0
        loop at < n:
            let v = do ckUtf8(bs, at)
            let good = do ckSliceText(bs, at, v.validUpTo)
            out = out + good
            if v.ok:
                return out
            out = out + "\ufffd"
            if v.errLen == 0:
                return out
            at = v.validUpTo + v.errLen
        return out

    proc ckIsSpace(c: text) -> bool:
        return c == " " || c == "\t" || c == "\n" || c == "\r" || c == "\u000b" || c == "\u000c" || c == "\u0085" || c == " " || c == " " || c == " " || c == " " || c == " " || c == " " || c == "　" || (c >= " " && c <= " ")

    # ckTrim: str::trim — Unicode White_Space off both ends.
    proc ckTrim(s: text) -> text:
        let cs = split(s, "")
        let n = len(cs)
        let mut a = 0
        loop a < n:
            let sp = do ckIsSpace(cs[a])
            if !sp:
                break
            a = a + 1
        let mut b = n
        loop b > a:
            let sp2 = do ckIsSpace(cs[b - 1])
            if !sp2:
                break
            b = b - 1
        return slice(s, a, b)

    # ckRead: read — the durable checkpoint value, failing closed.
    proc ckRead(path: text) -> FqCkptRead uses io.file:
        let size = fileSize(path)
        if size < 0:
            return FqCkptRead{ok: true, err: "", warning: "", value: 0}
        if size == 0:
            return FqCkptRead{ok: true, err: "", warning: "warning: " + path + " is zero-length — treating the checkpoint as 0 and replaying the WAL from the beginning. This is what an interrupted checkpoint write leaves behind; it is safe (replay is redundant, never lossy) but on a non-empty data directory it means a checkpoint update did not complete.", value: 0}
        if size > 64:
            let e0 = do ckCorrupt(path, "file is " + size + " bytes; a checkpoint is a single ASCII u64 and cannot exceed 64 bytes")
            return e0
        let raw = readFileAt(path, 0, size)
        let lossy = do ckLossy(raw)
        let q = do ckQuote(lossy)
        let utf = do ckUtf8(raw, 0)
        if !utf.ok:
            let mut why = "incomplete utf-8 byte sequence from index " + utf.validUpTo
            if utf.errLen > 0:
                why = "invalid utf-8 sequence of " + utf.errLen + " bytes from index " + utf.validUpTo
            let e1 = do ckCorrupt(path, "content is not valid UTF-8 (" + why + "): " + q)
            return e1
        let text0 = bytesToText(raw)
        let trimmed = do ckTrim(text0)
        if trimmed == "":
            let e2 = do ckCorrupt(path, "content is whitespace only: " + q + " — this is not an interrupted create (that leaves a zero-length file), so the previous checkpoint value has been overwritten by something that is not a number")
            return e2
        let ds = split(trimmed, "")
        let nd = len(ds)
        let mut i = 0
        loop i < nd:
            if ds[i] < "0" || ds[i] > "9":
                let e3 = do ckCorrupt(path, "content is not a plain decimal integer: " + q)
                return e3
            i = i + 1
        # u64::from_str: leading zeros are fine; the significant digits must
        # not exceed u64::MAX. A value past i64 cannot be held here either,
        # so the port's ceiling is i64::MAX and a larger u64 is refused with
        # the same message the engine uses for one past u64::MAX.
        let mut s = 0
        loop s < nd - 1 && ds[s] == "0":
            s = s + 1
        let sig = slice(trimmed, s, nd)
        let ns = len(sig)
        let max = "9223372036854775807"
        let mut tooBig = ns > 19
        if ns == 19:
            tooBig = sig > max
        if tooBig:
            let e4 = do ckCorrupt(path, "content does not fit in a u64 (number too large to fit in target type): " + q)
            return e4
        return FqCkptRead{ok: true, err: "", warning: "", value: toInt(sig)}

    # ckAdvance: advance — at most up to the fence ceiling, never backwards.
    proc ckAdvance(c: FqCkpt, dir: text, sequence: int) -> FqCkptAdvance uses io.file:
        let path = dir + "facetql.checkpoint"
        let cur = do ckRead(path)
        if !cur.ok:
            return FqCkptAdvance{ok: false, err: cur.err, ckpt: c, written: false, value: 0}
        let ceiling = do ckCeiling(c)
        let mut target = sequence
        if ceiling >= 0 && ceiling < target:
            target = ceiling
        if target <= cur.value:
            return FqCkptAdvance{ok: true, err: "", ckpt: c, written: false, value: cur.value}
        let w = do ckWriteValue(c, dir, target)
        return w

    # ckWriteValue: write_value — a unique temp file, written and fsynced,
    # renamed over the checkpoint, directory fsynced.
    proc ckWriteValue(c: FqCkpt, dir: text, sequence: int) -> FqCkptAdvance uses io.file:
        let path = dir + "facetql.checkpoint"
        let tmp = dir + "facetql.checkpoint.fct." + c.tmpCounter + ".tmp"
        let next = FqCkpt{fences: c.fences, tmpCounter: c.tmpCounter + 1}
        let wrote = writeFile(tmp, "" + sequence)
        let synced = syncFile(tmp)
        let renamed = renameFile(tmp, path)
        return FqCkptAdvance{ok: true, err: "", ckpt: next, written: true, value: sequence}

    # ── test harness ───────────────────────────────────────────────────
    state ckptOut: text = ""

    proc ckReadText(path: text) -> text uses io.file:
        let r = do ckRead(path)
        if !r.ok:
            return "error: " + r.err
        if r.warning != "":
            return "value=" + r.value + " " + r.warning
        return "value=" + r.value

    # ckScriptText: `fence N`, `release N`, `advance N` against `dir`,
    # each advance reporting whether it wrote and the value now durable.
    proc ckScriptText(dir: text, script: text) -> text uses io.file:
        let mut c = do ckNew()
        let mut out = ""
        let lines = split(script, "\n")
        let n = len(lines)
        let mut i = 0
        loop i < n:
            let w = split(trim(lines[i]), " ")
            if len(w) == 2:
                if w[0] == "fence":
                    let f = do ckBeginFence(c, toInt(w[1]))
                    c = f
                    out = out + "fence " + w[1] + ";"
                if w[0] == "release":
                    let r = do ckReleaseFence(c, toInt(w[1]))
                    c = r
                    out = out + "release " + w[1] + ";"
                if w[0] == "advance":
                    let a = do ckAdvance(c, dir, toInt(w[1]))
                    if !a.ok:
                        return out + "error: " + a.err
                    c = a.ckpt
                    out = out + "advance " + w[1] + "=" + a.value
                    if a.written:
                        out = out + " written"
                    out = out + ";"
            i = i + 1
        return out

    action runCkptRead(path: text):
        let r = do ckReadText(path)
        ckptOut = r

    action runCkptScript(dir: text, script: text):
        let r = do ckScriptText(dir, script)
        ckptOut = r

    view CkptHome at "/ckpt":
        text "{ckptOut}"
