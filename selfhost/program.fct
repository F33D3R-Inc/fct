import "parser_decl2.fct"
import "parser_decl3.fct"
import "nodes.fct"
import "action_stmt.fct"

app ProgramSelfHost:
    # Real, honest self-hosting port of the ACTUAL ASSEMBLY LAYER internal/
    # parser/parser.go's `Parse`/`parseFacet`/`parseApp`/`parseDecl` provide —
    # the piece every other selfhost file up to this point deliberately left
    # undone (each of expr_tree.fct/expr_tokens.fct/expr.fct, stmt.fct,
    # nodes.fct, and parser.fct/parser_proc.fct/parser_entity.fct/
    # parser_service.fct/parser_decl2.fct only ever parse ONE declaration's
    # own header+body in isolation, taking pre-split text as input; nothing
    # combines many heterogeneous top-level declarations, in source order,
    # into one real assembled value). This file is that combiner: a real
    # named `struct Program` (one list per declaration kind — this language
    # has no interface/union/sum type for "heterogeneous declaration", so a
    # parallel-list-of-kinds is the only real, honest encoding, exactly the
    # same shape ast.App itself uses in Go) plus `parseProgramSrc(src: text)
    # -> Program`, the real top-level driver: split raw whole-file source
    # into top-level blocks the same way source.go's `Parse`+`build` do,
    # recognize each block's own declaration keyword (parser.go's own
    # `parseDecl` switch, already ported as `declKeywordOf` in
    # parser_proc.fct), and dispatch to whichever existing per-kind parser
    # this port already has, accumulating every result into one `Program`.
    #
    # ============================================================
    # WHY THIS FILE REIMPLEMENTS ITS OWN "SPLIT SOURCE INTO AN INDENT TREE"
    # PRIMITIVES INSTEAD OF IMPORTING source.fct
    # ============================================================
    # source.fct's own `parentIndexForIndents`/`childrenOf` do exactly this
    # job — but this file cannot import it, for the same reason stmt.fct and
    # nodes.fct each ALREADY independently reimplement the identical
    # algorithm locally (see stmt.fct's own header, "WHY THIS FILE DOES NOT
    # import source.fct TOO", and nodes.fct's matching STAGE 8 note): this
    # file needs `proc`'s real body (parser_proc.fct -> stmt.fct), and
    # stmt.fct's own local `bodyIndents`/`bodyTexts`/`bodyParents`/
    # `bodyIsBlankOrComment`/`bodyIndentOf`/`bodyLineText` procs are named
    # IDENTICALLY to source.fct's own top-level algorithm (by design, so
    # `import "source.fct"` there would collide) — so a THIRD copy under yet
    # another set of names is this file's own honest way to get the same
    # proven algorithm without a name clash. Prefixed `prog*` throughout,
    # confirmed by grep to be unique across this file's entire import
    # closure (parser_decl2 -> parser_service -> parser_entity ->
    # parser_proc -> stmt -> expr -> expr_tokens/expr_tree) before being
    # used here.
    #
    # ============================================================
    # THE STRUCTURAL WALL THIS FILE ORIGINALLY HIT, AND HOW IT GOT FIXED
    # ============================================================
    # `view`/`component` bodies are real node TREES (nodes.fct's
    # `UiNode`/`Seg`, built by `nodeSingleNode`/`nodeBlockNodes` from that
    # file's own `bodyIndents`/`bodyTexts`/`bodyParents`/
    # `bodyIsBlankOrComment`/`bodyIndentOf`/`bodyLineText`, the exact same
    # six proc names stmt.fct independently reimplements for `proc`'s own
    # body). `Program` needs BOTH proc bodies (via parser_proc.fct ->
    # stmt.fct) AND view/component bodies (via nodes.fct) — importing both
    # into this file originally failed for real, not hypothetically:
    #
    #     import "parser_decl2.fct"
    #     import "nodes.fct"
    #     -> facet: proc "bodyIsBlankOrComment" is declared more than once
    #        (check your imported modules)
    #
    # This was the same CLASS of gap parser_proc.fct's own STAGE 9 header
    # already flagged for `view Home` name/path collisions on import — this
    # language's import model merged every declaration from every imported
    # file into one flat namespace, with no qualification, so two files that
    # each independently (and reasonably) reimplemented the same six-proc
    # algorithm under the same name could never both be imported by a third.
    #
    # ROOT FIX (not a workaround): a real `private` modifier on `proc`/`view`
    # declarations now exists (internal/parser/parser.go recognizes it,
    # internal/compile/private.go mangles a private declaration's name — and
    # every same-file `do`/`spawn` call to it — to a name unique to its own
    # file, before modules are merged). stmt.fct's and nodes.fct's six
    # colliding `body*` helpers are now `private proc` in both files, so they
    # mangle to two different, non-colliding names on merge; each file's own
    # internal calls were rewritten to match automatically, so neither file's
    # own behavior changed at all. `import "nodes.fct"` above now works
    # cleanly alongside the parser_decl2.fct chain — proven both by a minimal
    # two-file `private proc helper()` reproduction and by this file actually
    # importing both together and compiling clean.
    #
    # With the import now real, `view`/`component` bodies are genuinely
    # parsed via nodes.fct's own `nodeTreeSrc(src: text) -> [UiNode]` (the
    # same "raw body source in, real tree out" shape stmt.fct's
    # `parseProcBodySrc` already established for proc bodies) — see
    # ComponentEntry/ViewEntry below, which now carry a real `body: [UiNode]`
    # instead of raw, unparsed text. `layout` still has no header at all
    # beyond its name and a node-tree body, so a header-only struct would
    # carry no real information beyond what a bare `body: [UiNode]` already
    # would; it remains out of `Program` for now (a real but small follow-up,
    # not a structural blocker like the collision above was) and stays
    # reported via `unknownKeywords` below.
    #
    # ============================================================
    # OTHER GENUINE GAPS, CARRIED FORWARD HONESTLY (NOT FAKED)
    # ============================================================
    #   - `action`: CLOSED (this pass). parser_proc.fct's own STAGE 9
    #     closing note (and this file's own note here, before this pass)
    #     established, by reading real parseAction fresh, that an action's
    #     body is NOT proc-body grammar (`check`/`requires`/`add`/`set`/
    #     `remove`/`clear`/`call`/`establish` — proc bodies reject every one
    #     of those) — calling `parseProcDecl` on an action would silently
    #     mis-parse every real action. `action_stmt.fct` now provides the
    #     real, separate `ActionStmt`/`parseActionBodySrc` port that gap
    #     called for (its own header explains the full real grammar and the
    #     `private`-enabled import fix that made pulling BOTH that file's
    #     own tree-splitting AND expr.fct's grammar into this file's own
    #     import chain possible), so `ActionDecl` (above) now composes a
    #     real header with a real body — see `buildActionDecl`, below.
    #   - `type`, `message`, `layout`, `theme`/`theme dark`/named `theme`,
    #     `css`/`css from`, `daemon`, `file`: NO existing selfhost
    #     infrastructure ports any of these yet (confirmed by grepping every
    #     selfhost file for a combining struct or even flat per-line
    #     helpers under these names — none exist). Building real ports of
    #     these from scratch is genuine new parser work belonging to a
    #     future task, not a composition of already-proven pieces this one
    #     could safely assemble in the time available. They are recognized
    #     by keyword (so a `Program` never silently miscounts them as
    #     "unrecognized garbage") and counted in `unknownKeywords`, never
    #     given a fake/empty struct.
    #   - `declKeywordOf` (parser_proc.fct) itself is missing a `"struct"`
    #     case — confirmed by reading its full if-chain fresh: it recognizes
    #     entity/record/enum/type/message/component/layout/theme/css/state/
    #     derive/policy/action/proc/job/service/webhook/on/view/auth, but
    #     never checks a `struct ` prefix at all, even though `parseDecl`
    #     itself (parser.go line 135) does. This file works around that
    #     locally (checking `struct ` itself when `declKeywordOf` returns
    #     "") rather than editing parser_proc.fct, which is out of scope
    #     this round.
    #
    # ============================================================
    # STAGE 1: this file's own copy of the source-splitting primitives —
    # see the header above for why these cannot be imported from
    # source.fct/stmt.fct/nodes.fct. Identical algorithm, `prog`-prefixed.
    # ============================================================
    proc progIsBlankOrComment(line: text) -> bool:
        let t = trim(line)
        if len(t) == 0:
            return true
        return slice(t, 0, 1) == "#"

    proc progIndentOf(line: text) -> int:
        let n = len(line)
        let mut count = 0
        loop count < n && charAt(line, count) == " ":
            count = count + 1
        return count

    # progKeptRawLines: every line kept by source.go's own blank/comment
    # filter, in order, WITH its original leading whitespace intact (never
    # trimmed) — unlike source.fct's own `parsedTexts`, this file's copy
    # must preserve real indentation, because those raw lines are later
    # re-split and re-indented by whichever DEEPER per-kind parser (stmt.
    # fct's `parseProcBodySrc`, parser_decl2.fct's `parseRecordDeclSrc`, ...)
    # ultimately consumes them — every one of which recomputes its own
    # indentation from scratch over whatever raw text it's handed.
    proc progKeptRawLines(src: text) -> [text]:
        let rawLines = split(src, "\n")
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let raw = rawLines[i]
            let skip = do progIsBlankOrComment(raw)
            if !skip:
                out = append(out, raw)
            i = i + 1
        return out

    # progKeptLineNos: the 1-based source line of each progKeptRawLines entry.
    proc progKeptLineNos(src: text) -> [int]:
        let rawLines = split(src, "\n")
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let skip = do progIsBlankOrComment(rawLines[i])
            if !skip:
                out = append(out, i + 1)
            i = i + 1
        return out

    proc progIndentsOf(rawLines: [text]) -> [int]:
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let ind = do progIndentOf(rawLines[i])
            out = append(out, ind)
            i = i + 1
        return out

    # progParentsOf: source.go's `build`, the identical stack walk
    # source.fct's own `parentIndexForIndents` and stmt.fct's/nodes.fct's
    # own `bodyParents` already prove correct — a FOURTH restatement, for
    # the reason given above.
    proc progParentsOf(indents: [int]) -> [int]:
        let n = len(indents)
        let mut stackIndent = []
        let mut stackNode = []
        let mut fillI = 0
        loop fillI < n:
            stackIndent = append(stackIndent, -1)
            stackNode = append(stackNode, -1)
            fillI = fillI + 1
        let mut top = -1
        let mut parents = []
        let mut k = 0
        loop k < n:
            let cur = indents[k]
            loop top >= 0:
                if stackIndent[top] >= cur:
                    top = top - 1
                else:
                    break
            let mut parent = -1
            if top >= 0:
                parent = stackNode[top]
            parents = append(parents, parent)
            top = top + 1
            stackIndent[top] = cur
            stackNode[top] = k
            k = k + 1
        return parents

    proc progRangeOf(lines: [text], start: int, end: int) -> [text]:
        let mut out = []
        let mut i = start
        loop i < end:
            out = append(out, lines[i])
            i = i + 1
        return out

    proc progJoinLines(lines: [text]) -> text:
        let n = len(lines)
        let mut out = ""
        let mut i = 0
        loop i < n:
            if i > 0:
                out = out + "\n"
            out = out + lines[i]
            i = i + 1
        return out

    # combineHeaderBody: the exact "one text blob in" shape parseRecordDeclSrc/
    # parseStructDeclSrc/parseEnumDeclSrc already require (their own first
    # line is the header, everything after is child text) — an empty body
    # degrades to the header alone, the fully-inline-fields form those three
    # parsers already handle correctly on their own.
    proc combineHeaderBody(header: text, bodySrc: text) -> text:
        if bodySrc == "":
            return header
        return header + "\n" + bodySrc

    # ============================================================
    # STAGE 2: the facet header — `app Name:` (or `playground`/`wireframe`/
    # `ui`/`data`), possibly preceded by `import "…"` lines at the SAME
    # indent (parser.go's real `Parse`, lines 31-77, read fresh) — so the
    # true top-level declarations are children of the FACET header
    # specifically, not simply "every node whose parent is -1" (an import
    # line is also a parent==-1 root).
    # ============================================================
    proc progIsFacetHeader(line: text) -> bool:
        let t = trim(line)
        let isApp = do hasPrefixText(t, "app ")
        if isApp:
            return true
        let isPlayground = do hasPrefixText(t, "playground ")
        if isPlayground:
            return true
        let isWireframe = do hasPrefixText(t, "wireframe ")
        if isWireframe:
            return true
        let isUi = do hasPrefixText(t, "ui ")
        if isUi:
            return true
        let isData = do hasPrefixText(t, "data ")
        if isData:
            return true
        return false

    proc progFacetName(headerLine: text) -> text:
        let t = trim(headerLine)
        let isApp = do hasPrefixText(t, "app ")
        if isApp:
            let r1 = do trimPrefixText(t, "app")
            let r2 = trim(r1)
            let r3 = do trimSuffixText(r2, ":")
            return trim(r3)
        let isPlayground = do hasPrefixText(t, "playground ")
        if isPlayground:
            let r1 = do trimPrefixText(t, "playground")
            let r2 = trim(r1)
            let r3 = do trimSuffixText(r2, ":")
            return trim(r3)
        let isWireframe = do hasPrefixText(t, "wireframe ")
        if isWireframe:
            let r1 = do trimPrefixText(t, "wireframe")
            let r2 = trim(r1)
            let r3 = do trimSuffixText(r2, ":")
            return trim(r3)
        let isUi = do hasPrefixText(t, "ui ")
        if isUi:
            let r1 = do trimPrefixText(t, "ui")
            let r2 = trim(r1)
            let r3 = do trimSuffixText(r2, ":")
            return trim(r3)
        let isData = do hasPrefixText(t, "data ")
        if isData:
            let r1 = do trimPrefixText(t, "data")
            let r2 = trim(r1)
            let r3 = do trimSuffixText(r2, ":")
            return trim(r3)
        return ""

    # ============================================================
    # STAGE 3: combining structs for the declaration kinds that had no
    # combiner anywhere yet (state/derive/webhook/job/service/entity/view) —
    # pure composition over already-ported flat helpers, the same
    # "struct-milestone" convention parser_decl2.fct itself already
    # established for record/struct/enum/component/trigger/policy/
    # entity-field. `Program` itself is last, since it holds every one of
    # these plus the kinds parser_decl2.fct already combines.
    # ============================================================
    struct DeriveDeclFull:
        name: text
        typeCore: text
        headerValid: bool
        exprSrc: text
        expr: ExprNode
        # line/cont: the declaration's own text and any continuation lines
        # (a definition whose brackets span lines), for the driver's full
        # parseDerive (parameters, joinOpenBrackets).
        line: text
        cont: text

    struct StateDecl:
        name: text
        typeCore: text
        isList: bool
        isOptional: bool
        placement: text
        hasDefault: bool
        defaultSrc: text
        default: ExprNode
        valid: bool

    struct PolicyDeclFull:
        name: text
        paramNames: [text]
        paramTypes: [text]
        paramOptionals: [bool]
        headerValid: bool
        bodyChildCount: int
        bodyShapeValid: bool
        valid: bool
        predicateSrc: text
        predicate: ExprNode

    struct EntityDecl:
        name: text
        softDelete: bool
        ephemeral: bool
        headerValid: bool
        fields: [EntityFieldDecl]
        derives: [DeriveDeclFull]
        hasRead: bool
        readExprSrc: text
        readExpr: ExprNode
        valid: bool

    struct WebhookDecl:
        path: text
        action: text
        hasSecret: bool
        secret: text
        valid: bool
        line: int

    struct JobDecl:
        name: text
        action: text
        everySeconds: int
        onStart: bool
        valid: bool

    struct ServiceOpDecl:
        name: text
        paramNames: [text]
        paramTypes: [text]
        paramLists: [bool]
        paramOptionals: [bool]
        hasRet: bool
        retCore: text
        retIsList: bool
        valid: bool

    struct ServiceDecl:
        name: text
        url: text
        headerValid: bool
        ops: [ServiceOpDecl]
        # urlEnv / headerNames / headerEnvs: the header's `env VAR` and
        # `header "Name" env VAR` clauses; err: parseService's refusal.
        urlEnv: text
        headerNames: [text]
        headerEnvs: [text]
        err: text

    # ActionDecl: closes program.fct's own previously-named gap ("`action`:
    # ... `action` blocks are therefore left out of `Program`'s own fields
    # and counted only in `unknownKeywords`") — action_stmt.fct's real,
    # separate `ActionStmt`/`parseActionBodySrc` port (a DIFFERENT statement
    # grammar than `proc`'s own `Stmt`/`parseProcBodySrc` — see that file's
    # header) now exists, so an action's header (reusing parser_proc.fct's
    # own header helpers, exactly like ProcDecl already does — an action
    # header is a proc header with no return type/`uses` clause) can
    # finally be composed with its real body.
    #
    # `requires`/`body` are the real ast.Action's own two-list split
    # (action_stmt.fct's `actionRequiresOnly`/`actionBodyOnly` over ONE
    # `parseActionBodySrc` result — see that file's header for why
    # `requires` is modeled as one more ActionStmt kind rather than
    # dropped): `body` excludes every "requires" statement, matching real
    # ast.Action.Body exactly; `bodyValid` mirrors real parseAction's own
    # separate empty-body check (`if len(a.Body) == 0 { error }`) — over
    # `body` alone, NOT `requires` (an action with only `requires` clauses
    # and no real body statement is still invalid, exactly like real Go).
    struct ActionDecl:
        name: text
        paramNames: [text]
        paramTypes: [text]
        paramOptionals: [bool]
        optimistic: bool
        headerValid: bool
        requires: [ActionStmt]
        body: [ActionStmt]
        bodyValid: bool
        # bodySrc: the action's own raw body text (pre-split-into-ActionStmt),
        # added so a driver assembling a whole compiled IR graph can hand this
        # block straight to action_lower.fct's lowerActionSrc, which reparses
        # a body from raw text itself rather than taking a pre-split
        # [ActionStmt] list (see that file's own header for why: placement
        # inference needs a fresh ALowAcc walk over the statements, not the
        # bare parse tree this struct's own `body` field already holds).
        bodySrc: text
        # renameFrom/renameTo: see ProcDecl's (manglePrivate's per-file
        # rewrite of `do` targets).
        renameFrom: [text]
        renameTo: [text]
        # paramLists/ret/retList: parseSignature(allowList=true)'s list
        # parameters and the `-> Type` reply (parser.go parseAction).
        paramLists: [bool]
        ret: text
        retList: bool
        retErr: text

    # ComponentEntry/ViewEntry: header genuinely parsed (ComponentDecl reused
    # verbatim from parser_decl2.fct; the view header restated locally per
    # STAGE 2's own header note); body now a real `[UiNode]` tree, via
    # nodes.fct's `nodeTreeSrc` — see this file's own top header for how
    # importing nodes.fct alongside the parser_decl2.fct chain got unblocked.
    struct ComponentEntry:
        header: ComponentDecl
        body: [UiNode]
        # headerLine/bodySrc: the raw text, for view_parse.fct's full grammar.
        headerLine: text
        bodySrc: text

    # LayoutEntry: `layout Name:` and its raw body (parser.go parseLayout).
    # Layered-facet parts (parser.go parsePlayground/parseWireframe/
    # parseUIData): a playground's `mount`s, a wireframe's `socket`s and
    # `frame:`, a ui/data facet's `content:`.
    struct ProgMount:
        wireframe: text
        path: text
        requires: text
        err: text

    struct ProgSocket:
        name: text
        accept: text
        err: text

    # RawDecl: a declaration kept as its raw text for the driver's own
    # parsers — `type`, `message`, `api`, `contract`, `stream`, `file`,
    # `css from` (kw is the leading keyword).
    struct RawDecl:
        kw: text
        header: text
        bodySrc: text
        line: int
        # bodyLineNos: the source line of each (kept) line of bodySrc.
        bodyLineNos: [int]

    struct LayoutEntry:
        headerLine: text
        bodySrc: text

    struct ViewEntry:
        name: text
        path: text
        headerValid: bool
        body: [UiNode]
        # header/bodySrc: the declaration's own raw text, kept so the full
        # view grammar (view_parse.fct's vpParseView) can re-read it.
        header: text
        bodySrc: text
        # private: declared `private view` (a file-local name, mangled per
        # module by the driver exactly as internal/compile's manglePrivate).
        private: bool

    # DaemonDecl: parser.go's parseDaemon — `daemon Name [every <dur>]
    # [uses cap, …]:` plus its proc-shaped body (kept raw for
    # proc_lower.fct's plLowerDaemon). `err` carries the header's first
    # refusal ("" when well-formed).
    struct DaemonDecl:
        name: text
        every: int
        uses: [text]
        bodySrc: text
        err: text
        renameFrom: [text]
        renameTo: [text]
        bodyLineNos: [int]

    # SharedDecl: one `shared name: Type` / `shared name: [Type]` cell
    # (parser.go parseShared); err is its parse refusal, "" when none.
    struct SharedDecl:
        name: text
        type: text
        list: bool
        line: int

    # ProgThemeBlock: one `theme:` / `theme dark:` / `theme <name>:` block
    # (parser.go parseTheme/parseNamedTheme) — kind is "base", "dark" or
    # "named"; the entries are parser_decl3.fct's ThemeVar.
    struct ProgThemeBlock:
        kind: text
        name: text
        vars: [ThemeVar]
        valid: bool

    struct Program:
        name: text
        hasAuth: bool
        entities: [EntityDecl]
        records: [RecordDecl]
        structs: [StructDecl]
        enums: [EnumDecl]
        states: [StateDecl]
        derives: [DeriveDeclFull]
        policies: [PolicyDeclFull]
        procs: [ProcDecl]
        actions: [ActionDecl]
        webhooks: [WebhookDecl]
        jobs: [JobDecl]
        services: [ServiceDecl]
        components: [ComponentEntry]
        triggers: [TriggerDecl]
        views: [ViewEntry]
        themes: [ProgThemeBlock]
        css: text
        daemons: [DaemonDecl]
        # privateProcs: the names of this file's `private proc`s (see
        # ViewEntry.private); parseErrors: the refusals parseDecl makes that
        # no per-declaration struct carries (first one wins).
        privateProcs: [text]
        parseErrors: [text]
        layouts: [LayoutEntry]
        # kind: "app" | "playground" | "wireframe" | "ui" | "data"; into:
        # a ui/data facet's socket.
        rawDecls: [RawDecl]
        kind: text
        into: text
        mounts: [ProgMount]
        sockets: [ProgSocket]
        hasFrame: bool
        frameSrc: text
        hasContent: bool
        contentSrc: text
        unknownKeywords: [text]
        shareds: [SharedDecl]

    # ============================================================
    # STAGE 4: per-kind builders — thin composition over already-ported
    # flat helpers (state/derive/webhook/job/service/view) or over an
    # already-ported header-only parser plus a fresh, real expression parse
    # this file is the first to add (entity's fields+derives+read, policy's
    # real predicate) since it is the first file in this port able to `do
    # parseExprTree(...)` (via expr.fct, transitively imported through
    # parser_proc.fct -> stmt.fct -> expr.fct) alongside the decl-header
    # layer at the same time.
    # ============================================================
    proc buildDeriveDeclFull(lineText: text) -> DeriveDeclFull:
        let name = do deriveNameOf(lineText)
        let core = do deriveCore(lineText)
        let hv = do deriveValid(lineText)
        let exprSrc = do deriveExprRaw(lineText)
        let ex0 = do emptyNode()
        let mut ex = ex0
        if exprSrc != "":
            let parsed = do parseExprTree(exprSrc)
            ex = parsed
        return DeriveDeclFull{name: name, typeCore: core, headerValid: hv, exprSrc: exprSrc, expr: ex, line: lineText, cont: ""}

    proc buildStateDecl(lineText: text) -> StateDecl:
        let name = do stateNameOf(lineText)
        let core = do stateCore(lineText)
        let isL = do stateIsList(lineText)
        let isOpt = do stateIsOptional(lineText)
        let place = do statePlacement(lineText)
        let hasDef = do stateHasDefault(lineText)
        let defSrc = do stateDefaultRaw(lineText)
        let v = do stateValid(lineText)
        let def0 = do emptyNode()
        let mut def = def0
        if hasDef:
            let parsed = do parseExprTree(defSrc)
            def = parsed
        return StateDecl{name: name, typeCore: core, isList: isL, isOptional: isOpt, placement: place, hasDefault: hasDef, defaultSrc: defSrc, default: def, valid: v}

    proc buildPolicyDeclFull(header: text, bodyLines: [text]) -> PolicyDeclFull:
        let bodyChildCount = len(bodyLines)
        let base = do buildPolicyDecl(header, bodyChildCount)
        let mut predSrc = ""
        let pred0 = do emptyNode()
        let mut pred = pred0
        if bodyChildCount == 1:
            let p = trim(bodyLines[0])
            predSrc = p
            let parsed = do parseExprTree(predSrc)
            pred = parsed
        return PolicyDeclFull{name: base.name, paramNames: base.paramNames, paramTypes: base.paramTypes, paramOptionals: base.paramOptionals, headerValid: base.headerValid, bodyChildCount: base.bodyChildCount, bodyShapeValid: base.bodyShapeValid, valid: base.valid, predicateSrc: predSrc, predicate: pred}

    proc entityFieldsAllValid(fields: [EntityFieldDecl]) -> bool:
        let n = len(fields)
        let mut ok = true
        let mut i = 0
        loop i < n:
            if !fields[i].valid:
                ok = false
            i = i + 1
        return ok

    # qualifyRowRefs: internal/parser/parser.go's qualifyRowRefs — every
    # bare ref naming one of the entity's own fields becomes
    # `get($row, name)`, recursing through get/entityGet key/agg where+sel/
    # call/list/bin/un exactly as the Go switch does (index/map/struct and
    # literals fall into its default arm and are returned untouched).
    proc qualifyRowRefsList(xs: [ExprNode], fields: [text]) -> [ExprNode]:
        let mut out = []
        let n = len(xs)
        let mut i = 0
        loop i < n:
            let q = do qualifyRowRefs(xs[i], fields)
            out = append(out, q)
            i = i + 1
        return out

    proc qualifyRowRefs(ex: ExprNode, fields: [text]) -> ExprNode:
        if ex.kind == "ref":
            if ex.text in fields:
                let row = do refNode("$row")
                let g = do getNode(row, ex.text)
                return g
            return ex
        if ex.kind == "get" || ex.kind == "entityGet" || ex.kind == "call" || ex.kind == "list" || ex.kind == "bin" || ex.kind == "un":
            let kids = do qualifyRowRefsList(ex.children, fields)
            return ExprNode{kind: ex.kind, text: ex.text, field: ex.field, itemVar: ex.itemVar, coll: ex.coll, children: kids, pairs: ex.pairs, whereClause: ex.whereClause, sel: ex.sel, order: ex.order, desc: ex.desc, limit: ex.limit, orderBy: ex.orderBy, varFromArg: ex.varFromArg}
        if ex.kind == "agg":
            let w = do qualifyRowRefsList(ex.whereClause, fields)
            let sl = do qualifyRowRefsList(ex.sel, fields)
            return ExprNode{kind: ex.kind, text: ex.text, field: ex.field, itemVar: ex.itemVar, coll: ex.coll, children: ex.children, pairs: ex.pairs, whereClause: w, sel: sl, order: ex.order, desc: ex.desc, limit: ex.limit, orderBy: ex.orderBy, varFromArg: ex.varFromArg}
        return ex

    # buildEntityDecl: real parseEntity (parser.go lines 509-714), read
    # fresh again for this task — a `derive name: …` child line is an
    # embedded top-level-shaped derive (STAGE 4's own `buildDeriveDeclFull`
    # reused verbatim, unchanged, for both); a `read: <expr>` line is told
    # apart from a genuine field named `read` the exact way real Go does —
    # `fn == "read" && !isTypeName(core)` — everything else is an ordinary
    # field via parser_decl2.fct's own `buildEntityFieldDecl`.
    proc buildEntityDecl(header: text, bodyLines: [text]) -> EntityDecl:
        let headStripped = do entityHeadOf(header)
        let name = do entityHeaderName(headStripped)
        let softDelete = do entityHeaderHasSoftDelete(headStripped)
        let ephemeral = do entityHeaderHasEphemeral(headStripped)
        let headerValid = do entityHeaderValid(header)
        let mut fields = []
        let mut derives = []
        let mut hasRead = false
        let mut readExprSrc = ""
        let readExpr0 = do emptyNode()
        let mut readExpr = readExpr0
        let n = len(bodyLines)
        let mut i = 0
        loop i < n:
            let lt = trim(bodyLines[i])
            let isDerive = do hasPrefixText(lt, "derive ")
            if isDerive:
                let dd = do buildDeriveDeclFull(lt)
                derives = append(derives, dd)
            else:
                let fn = do entityFieldNameOf(lt)
                let ft = do entityFieldTypeRawOf(lt)
                let core = do entityFieldCore(ft)
                let typeOk = do isTypeNameToken(core)
                let mut isReadLine = false
                if fn == "read":
                    if !typeOk:
                        isReadLine = true
                if isReadLine:
                    hasRead = true
                    readExprSrc = ft
                    let parsed = do parseExprTree(ft)
                    readExpr = parsed
                else:
                    let fd = do buildEntityFieldDecl(lt)
                    fields = append(fields, fd)
            i = i + 1
        # parser.go qualifies `read:` and every entity derive against the
        # full field set once the field loop is done.
        let mut fieldNames = []
        let nf = len(fields)
        let mut fi = 0
        loop fi < nf:
            fieldNames = append(fieldNames, fields[fi].name)
            fi = fi + 1
        if hasRead:
            let qr = do qualifyRowRefs(readExpr, fieldNames)
            readExpr = qr
        let mut qderives = []
        let nd = len(derives)
        let mut di = 0
        loop di < nd:
            let d0 = derives[di]
            let qd = do qualifyRowRefs(d0.expr, fieldNames)
            qderives = append(qderives, DeriveDeclFull{name: d0.name, typeCore: d0.typeCore, headerValid: d0.headerValid, exprSrc: d0.exprSrc, expr: qd, line: d0.line, cont: d0.cont})
            di = di + 1
        derives = qderives
        let fieldsOk = do entityFieldsAllValid(fields)
        let mut valid = false
        if headerValid:
            if len(fields) > 0:
                if fieldsOk:
                    valid = true
        return EntityDecl{name: name, softDelete: softDelete, ephemeral: ephemeral, headerValid: headerValid, fields: fields, derives: derives, hasRead: hasRead, readExprSrc: readExprSrc, readExpr: readExpr, valid: valid}

    proc buildWebhookDecl(header: text) -> WebhookDecl:
        let path = do parseWebhookPath(header)
        let action = do parseWebhookAction(header)
        let secret = do parseWebhookSecret(header)
        let valid = do parseWebhookValid(header)
        let hasSecret = secret != ""
        return WebhookDecl{path: path, action: action, hasSecret: hasSecret, secret: secret, valid: valid, line: 0}

    proc buildJobDecl(header: text) -> JobDecl:
        let name = do parseJobName(header)
        let action = do parseJobAction(header)
        let every = do parseJobEverySeconds(header)
        let onStart = do parseJobOnStart(header)
        let valid = do parseJobValid(header)
        return JobDecl{name: name, action: action, everySeconds: every, onStart: onStart, valid: valid}

    proc buildServiceOpDecl(opLine: text) -> ServiceOpDecl:
        let name = do parseServiceOpName(opLine)
        let pn = do parseServiceOpParamNames(opLine)
        let pt = do parseServiceOpParamTypes(opLine)
        let pl = do parseServiceOpParamLists(opLine)
        let po = do parseServiceOpParamOptionals(opLine)
        let hr = do parseServiceOpHasRet(opLine)
        let rc = do parseServiceOpRetCore(opLine)
        let ril = do parseServiceOpRetIsList(opLine)
        let valid = do parseServiceOpValid(opLine)
        return ServiceOpDecl{name: name, paramNames: pn, paramTypes: pt, paramLists: pl, paramOptionals: po, hasRet: hr, retCore: rc, retIsList: ril, valid: valid}

    proc buildServiceDecl(header: text, bodyLines: [text]) -> ServiceDecl:
        let name = do parseServiceName(header)
        let url = do parseServiceUrl(header)
        let hv = do parseServiceHeaderValid(header)
        let mut ops = []
        let n = len(bodyLines)
        let mut i = 0
        loop i < n:
            let op = do buildServiceOpDecl(bodyLines[i])
            ops = append(ops, op)
            i = i + 1
        let sh = do progServiceHead(header)
        return ServiceDecl{name: name, url: url, headerValid: hv, ops: ops, urlEnv: sh.urlEnv, headerNames: sh.headerNames, headerEnvs: sh.headerEnvs, err: sh.err}

    # progServiceHead: parseService's header — `service Name at "url"`
    # followed by `env VAR` and any number of `header "Name" env VAR`.
    struct ProgServiceHead:
        err: text
        urlEnv: text
        headerNames: [text]
        headerEnvs: [text]

    proc progQuotedEnd(s: text) -> int:
        let n = len(s)
        if n == 0 || charAt(s, 0) != "\"":
            return -1
        let mut i = 1
        loop i < n:
            let c = charAt(s, i)
            if c == "\\":
                i = i + 2
                continue
            if c == "\"":
                return i
            i = i + 1
        return -1

    proc progWords(s: text) -> [text]:
        let parts = split(trim(s), " ")
        let mut out = []
        let n = len(parts)
        let mut i = 0
        loop i < n:
            if trim(parts[i]) != "":
                out = append(out, trim(parts[i]))
            i = i + 1
        return out

    proc progServiceHead(header: text) -> ProgServiceHead:
        let none = ProgServiceHead{err: "", urlEnv: "", headerNames: [], headerEnvs: []}
        let base = "service needs a base URL: service Name at \"http://host:port\""
        let h0 = do trimPrefixText(trim(header), "service")
        let rest0 = trim(h0)
        let rest = do trimSuffixText(rest0, ":")
        let i = do indexOf(rest, " at ")
        if i < 0:
            return ProgServiceHead{err: base, urlEnv: "", headerNames: [], headerEnvs: []}
        let name = trim(slice(rest, 0, i))
        let tail = trim(slice(rest, i + 4, len(rest)))
        let e = do progQuotedEnd(tail)
        if e < 0:
            return ProgServiceHead{err: base, urlEnv: "", headerNames: [], headerEnvs: []}
        let u = do goUnquote(slice(tail, 0, e + 1))
        if !u.ok || u.value == "":
            return ProgServiceHead{err: base, urlEnv: "", headerNames: [], headerEnvs: []}
        let mut urlEnv = ""
        let mut names = []
        let mut envs = []
        let mut clauses = trim(slice(tail, e + 1, len(tail)))
        loop clauses != "":
            let isEnv = do hasPrefixText(clauses, "env ")
            let isHeader = do hasPrefixText(clauses, "header ")
            if isEnv:
                let afterEnv = trim(slice(clauses, 4, len(clauses)))
                let f = do progWords(afterEnv)
                let mut ok = len(f) > 0
                if ok:
                    let fi = do isIdentToken(f[0])
                    ok = fi
                if !ok:
                    return ProgServiceHead{err: "service `env` names the env var that overrides its URL: env THEMIS_URL", urlEnv: "", headerNames: [], headerEnvs: []}
                urlEnv = f[0]
                let rem = do trimPrefixText(afterEnv, f[0])
                clauses = trim(rem)
            else:
                if isHeader:
                    let h = trim(slice(clauses, 7, len(clauses)))
                    let he = do progQuotedEnd(h)
                    if he < 0:
                        return ProgServiceHead{err: "service header is header \"Name\" env VAR", urlEnv: "", headerNames: [], headerEnvs: []}
                    let hn = do goUnquote(slice(h, 0, he + 1))
                    let after = slice(h, he + 1, len(h))
                    let f2 = do progWords(after)
                    let mut ok2 = len(f2) >= 2 && hn.value != ""
                    if ok2:
                        let fi2 = do isIdentToken(f2[1])
                        ok2 = f2[0] == "env" && fi2
                    if !ok2:
                        return ProgServiceHead{err: "service header is header \"Name\" env VAR — its value comes from the environment, never the source", urlEnv: "", headerNames: [], headerEnvs: []}
                    names = append(names, hn.value)
                    envs = append(envs, f2[1])
                    let a1 = do trimPrefixText(trim(after), "env")
                    let a2 = do trimPrefixText(trim(a1), f2[1])
                    clauses = trim(a2)
                else:
                    let cq = do goQuote(clauses)
                    return ProgServiceHead{err: "unknown service clause " + cq + " (expected env VAR or header \"Name\" env VAR)", urlEnv: "", headerNames: [], headerEnvs: []}
        let ni = do isIdentToken(name)
        if !ni:
            let nq = do goQuote(name)
            return ProgServiceHead{err: "invalid service name " + nq, urlEnv: "", headerNames: [], headerEnvs: []}
        let hp = do hasPrefixText(u.value, "http://")
        let hps = do hasPrefixText(u.value, "https://")
        if !hp && !hps:
            let nq2 = do goQuote(name)
            return ProgServiceHead{err: "service " + nq2 + " url must start with http:// or https://", urlEnv: "", headerNames: [], headerEnvs: []}
        return ProgServiceHead{err: "", urlEnv: urlEnv, headerNames: names, headerEnvs: envs}

    # buildActionDecl: real parseAction's header (action_stmt.fct's own
    # `actionHeadOf`/`actionIsOptimistic`/`actionHeadStripOptimistic`, then
    # parser_proc.fct's existing `headerName`/`headerParamNames`/
    # `headerParamTypes`/`headerParamOptionals` reused verbatim over the
    # action's own `@optimistic`-and-`:`-stripped head — see action_stmt.fct's
    # own STAGE 5 header for why that reuse is faithful) plus its real body
    # (action_stmt.fct's `parseActionBodySrc`, split into `requires`/`body`
    # via `actionRequiresOnly`/`actionBodyOnly`).
    proc buildActionDecl(header: text, bodySrc: text) -> ActionDecl:
        let rawHead = do actionHeadOf(header)
        let optimistic = do actionIsOptimistic(rawHead)
        let head = do actionHeadStripOptimistic(rawHead)
        let name = do headerName(head)
        let paramNames = do headerParamNames(head)
        let paramTypes = do headerParamTypes(head)
        let paramOptionals = do headerParamOptionals(head)
        let headerValid = do actionHeaderValid(head)
        let paramLists = do headerParamLists(head)
        let hasRet = do headerRetSectionExists(head)
        let mut ret = ""
        let mut retList = false
        let mut retErr = ""
        if hasRet:
            let rc = do headerRetCore(head)
            let rl = do headerRetIsList(head)
            let ropt = do headerRetIsOptional(head)
            let rtn = do isTypeNameToken(rc)
            if ropt || !rtn:
                let raw = do headerRetTypeRaw(head)
                retErr = "invalid return type \"" + raw + "\""
            ret = rc
            retList = rl
        let allStmts = do parseActionBodySrc(bodySrc)
        let body = do actionBodyOnly(allStmts)
        let requiresList = do actionRequiresOnly(allStmts)
        let bodyValid = len(body) > 0
        return ActionDecl{name: name, paramNames: paramNames, paramTypes: paramTypes, paramOptionals: paramOptionals, optimistic: optimistic, headerValid: headerValid, requires: requiresList, body: body, bodyValid: bodyValid, bodySrc: bodySrc, renameFrom: [], renameTo: [], paramLists: paramLists, ret: ret, retList: retList, retErr: retErr}

    proc buildComponentEntry(header: text, bodySrc: text) -> ComponentEntry:
        let cd = do buildComponentDecl(header)
        let body = do nodeTreeSrc(bodySrc)
        return ComponentEntry{header: cd, body: body, headerLine: header, bodySrc: bodySrc}

    # progViewHeadOf/progViewAtIndex: the trivial header-only restatement of
    # nodes.fct's own `viewHeadOf`/`viewAtMarkerIndex` (the body itself is
    # now genuinely parsed via nodes.fct's own `nodeTreeSrc`, imported above).
    proc progViewHeadOf(lineText: text) -> text:
        let stripped = do trimPrefixText(lineText, "view")
        let trimmed = trim(stripped)
        let r = do trimSuffixText(trimmed, ":")
        return r

    proc progViewAtIndex(head: text) -> int:
        let r = do indexOf(head, " at ")
        return r

    # progDurationSecs: parseDuration — `30s`/`5m`/`2h`, -1 when invalid.
    proc progDurationSecs(s: text) -> int:
        if len(s) < 2:
            return -1
        let unit = charAt(s, len(s) - 1)
        let num = slice(s, 0, len(s) - 1)
        let digits = split(num, "")
        let nd = len(digits)
        if nd == 0:
            return -1
        let mut i = 0
        loop i < nd:
            let c = digits[i]
            if c < "0" || c > "9":
                return -1
            i = i + 1
        let n = toInt(num)
        if n <= 0:
            return -1
        if unit == "s":
            return n
        if unit == "m":
            return n * 60
        if unit == "h":
            return n * 3600
        return -1

    proc buildDaemonDecl(header: text, bodySrc: text) -> DaemonDecl:
        let h0 = do trimPrefixText(trim(header), "daemon")
        let h1 = do trimSuffixText(trim(h0), ":")
        let mut head = trim(h1)
        let mut uses = []
        let ui = do indexOf(head, " uses ")
        if ui >= 0:
            let usesPart = trim(slice(head, ui + 6, len(head)))
            head = trim(slice(head, 0, ui))
            if usesPart == "":
                return DaemonDecl{name: "", every: 0, uses: [], bodySrc: bodySrc, err: "uses needs at least one capability (e.g. `uses io.file`)", renameFrom: [], renameTo: [], bodyLineNos: []}
            let parts = split(usesPart, ",")
            let np = len(parts)
            let mut pi = 0
            loop pi < np:
                let c = trim(parts[pi])
                let ok = do isCapabilityNameToken(c)
                if !ok:
                    return DaemonDecl{name: "", every: 0, uses: [], bodySrc: bodySrc, err: "invalid capability \"" + c + "\" in uses clause (expected a dotted name like io.file)", renameFrom: [], renameTo: [], bodyLineNos: []}
                uses = append(uses, c)
                pi = pi + 1
        let mut every = 0
        let ei = do indexOf(head, " every ")
        if ei >= 0:
            let durS = trim(slice(head, ei + 7, len(head)))
            head = trim(slice(head, 0, ei))
            let secs = do progDurationSecs(durS)
            if secs < 0:
                return DaemonDecl{name: "", every: 0, uses: [], bodySrc: bodySrc, err: "invalid duration \"" + durS + "\" (use 30s, 5m, 2h)", renameFrom: [], renameTo: [], bodyLineNos: []}
            every = secs
        let name = trim(head)
        let idOk = do isIdentToken(name)
        if !idOk:
            return DaemonDecl{name: name, every: 0, uses: [], bodySrc: bodySrc, err: "invalid daemon name \"" + name + "\"", renameFrom: [], renameTo: [], bodyLineNos: []}
        return DaemonDecl{name: name, every: every, uses: uses, bodySrc: bodySrc, err: "", renameFrom: [], renameTo: [], bodyLineNos: []}

    # buildProgThemeBlock: parser.go's three theme dispatch arms. Entries are
    # the block's direct children; a value's escapes are decoded the way
    # unquote's strconv.Unquote does for the characters a CSS value holds.
    proc buildProgThemeBlock(header: text, bodyLines: [text]) -> ProgThemeBlock:
        let isDark = do themeHeaderIsDark(header)
        let isBase = do themeHeaderIsBase(header)
        let mut kind = "named"
        let mut name = ""
        if isDark:
            kind = "dark"
        else:
            if isBase:
                kind = "base"
            else:
                let nm = do namedThemeName(header)
                name = nm
        let mut lines = []
        let n = len(bodyLines)
        let mut i = 0
        loop i < n:
            lines = append(lines, trim(bodyLines[i]))
            i = i + 1
        let d = do buildThemeDecl(lines)
        let mut valid = d.valid
        if kind == "named":
            let nv = do isThemeKeyToken(name)
            valid = valid && nv
        return ProgThemeBlock{kind: kind, name: name, vars: d.vars, valid: valid}

    # progThemeEntryDiag: parseTheme's per-entry refusal — `name "value"`
    # split at the first space, a theme key, a strconv.Unquote-able value.
    proc progThemeEntryDiag(t: text) -> text:
        let mut sp = -1
        let tn = len(t)
        let mut si = 0
        loop si < tn && sp < 0:
            if charAt(t, si) == " ":
                sp = si
            si = si + 1
        if sp < 0:
            return "theme entry must be `name \"value\"`"
        let name = slice(t, 0, sp)
        let ok = do isThemeKeyToken(name)
        if !ok:
            let nq = do goQuote(name)
            return "invalid theme name " + nq
        let raw = trim(slice(t, sp + 1, len(t)))
        let q = do themeValueIsQuoted(raw)
        let rq = do goQuote(raw)
        if !q:
            return "expected a quoted string, got " + rq
        let u = do goUnquote(raw)
        if !u.ok:
            return "invalid string " + rq
        return ""

    # progCSSBlock: parseCSS — every nested line of a `css:` block, trimmed,
    # in source order, joined with newlines.
    proc progCSSBlock(bodyLines: [text]) -> text:
        let mut out = ""
        let n = len(bodyLines)
        let mut i = 0
        loop i < n:
            if i > 0:
                out = out + "\n"
            out = out + trim(bodyLines[i])
            i = i + 1
        return out

    # buildProgMount: parseMount — `mount W [at "/path"] [requires p]`.
    proc buildProgMount(t: text) -> ProgMount:
        let r0 = do trimPrefixText(t, "mount ")
        let mut rest = trim(r0)
        let mut guard = ""
        let ri = do indexOf(rest, " requires ")
        if ri >= 0:
            let g0 = trim(slice(rest, ri + 10, len(rest)))
            let g1 = do trimSuffixText(g0, ":")
            guard = g1
            rest = trim(slice(rest, 0, ri))
            let gok = do isIdentToken(guard)
            if !gok:
                return ProgMount{wireframe: "", path: "", requires: "", err: "invalid guard policy \"" + guard + "\" after `requires`"}
        let mut path = "/"
        let ai = do indexOf(rest, " at ")
        if ai >= 0:
            let q = trim(slice(rest, ai + 4, len(rest)))
            let qn = len(q)
            if qn < 2 || charAt(q, 0) != "\"" || charAt(q, qn - 1) != "\"" || qn == 2:
                return ProgMount{wireframe: "", path: "", requires: "", err: "mount route must be a quoted path: `mount W at \"/path\"`"}
            path = slice(q, 1, qn - 1)
            rest = trim(slice(rest, 0, ai))
        let w0 = do trimSuffixText(trim(rest), ":")
        let w = trim(w0)
        let wok = do isIdentToken(w)
        if !wok:
            return ProgMount{wireframe: "", path: "", requires: "", err: "invalid wireframe name \"" + w + "\" after `mount`"}
        return ProgMount{wireframe: w, path: path, requires: guard, err: ""}

    # buildProgSocket: parseSocket — `socket <name>: <ui|data>`.
    proc buildProgSocket(t: text) -> ProgSocket:
        let r0 = do trimPrefixText(t, "socket ")
        let rest = trim(r0)
        let colon = do indexOf(rest, ":")
        if colon < 0:
            return ProgSocket{name: "", accept: "", err: "socket needs a kind: `socket <name>: <ui|data>`"}
        let sname = trim(slice(rest, 0, colon))
        let accept = trim(slice(rest, colon + 1, len(rest)))
        let ok = do isIdentToken(sname)
        if !ok:
            return ProgSocket{name: "", accept: "", err: "invalid socket name \"" + sname + "\""}
        if accept != "ui" && accept != "data":
            return ProgSocket{name: "", accept: "", err: "socket \"" + sname + "\" must accept `ui` or `data`, got \"" + accept + "\""}
        return ProgSocket{name: sname, accept: accept, err: ""}

    proc nodeFirstWordOf(s: text) -> text:
        let parts = split(s, " ")
        return parts[0]

    proc buildViewEntry(header: text, bodySrc: text) -> ViewEntry:
        let head = do progViewHeadOf(header)
        let atIdx = do progViewAtIndex(head)
        let mut name = trim(head)
        let mut path = ""
        let mut headerValid = false
        if atIdx >= 0:
            let namePart = slice(head, 0, atIdx)
            name = trim(namePart)
            let pathQuotedRaw = slice(head, atIdx + 4, len(head))
            let pathQuoted = trim(pathQuotedRaw)
            let p = do quotedInner(pathQuoted)
            path = p
            let idOk = do isIdentToken(name)
            let pathOk = do hasPrefixText(path, "/")
            headerValid = idOk && pathOk
        else:
            let idOk = do isIdentToken(name)
            headerValid = idOk
        let body = do nodeTreeSrc(bodySrc)
        return ViewEntry{name: name, path: path, headerValid: headerValid, body: body, header: header, bodySrc: bodySrc, private: false}

    # ============================================================
    # STAGE 5: the dispatch keyword set this file actually wires, restated
    # as a flat membership check (mirrors declKeywordOf's own if-chain
    # style) rather than a nested if/else nest, since the loop below needs
    # to know "was this recognized at all" separately from "which one".
    # ============================================================
    proc progKnownKeyword(kw: text) -> bool:
        if kw == "auth" || kw == "shared":
            return true
        if kw == "entity":
            return true
        if kw == "record":
            return true
        if kw == "struct":
            return true
        if kw == "enum":
            return true
        if kw == "state":
            return true
        if kw == "derive":
            return true
        if kw == "policy":
            return true
        if kw == "proc":
            return true
        if kw == "action":
            return true
        if kw == "webhook":
            return true
        if kw == "job":
            return true
        if kw == "service":
            return true
        if kw == "component":
            return true
        if kw == "on":
            return true
        if kw == "view":
            return true
        if kw == "type" || kw == "message" || kw == "api" || kw == "contract" || kw == "stream" || kw == "file" || kw == "cssfrom":
            return true
        if kw == "theme" || kw == "css" || kw == "daemon" || kw == "layout" || kw == "mount" || kw == "socket" || kw == "frame" || kw == "content":
            return true
        return false

    # ============================================================
    # STAGE 6: parseProgramSrc — the real end-to-end driver this task asks
    # for. Raw whole-file source in; one real `Program` out.
    # ============================================================
    proc parseProgramSrc(src: text) -> Program:
        let rawLines = do progKeptRawLines(src)
        let lineNos = do progKeptLineNos(src)
        let n = len(rawLines)
        let indents = do progIndentsOf(rawLines)
        let parents = do progParentsOf(indents)

        let mut appHeaderIndex = -1
        let mut i = 0
        loop i < n:
            if appHeaderIndex < 0:
                if parents[i] == -1:
                    let isHeader = do progIsFacetHeader(rawLines[i])
                    if isHeader:
                        appHeaderIndex = i
            i = i + 1

        let mut name = ""
        let mut hasAuth = false
        let mut entities = []
        let mut records = []
        let mut structs = []
        let mut enums = []
        let mut states = []
        let mut derives = []
        let mut policies = []
        let mut procs = []
        let mut actions = []
        let mut webhooks = []
        let mut jobs = []
        let mut services = []
        let mut components = []
        let mut triggers = []
        let mut views = []
        let mut unknownKeywords = []
        let mut themes = []
        let mut css = ""
        let mut daemons = []
        let mut privateProcs = []
        let mut parseErrors = []
        let mut layouts = []
        let mut rawDecls = []
        let mut kind = "app"
        let mut into = ""
        let mut mounts = []
        let mut sockets = []
        let mut hasFrame = false
        let mut frameSrc = ""
        let mut hasContent = false
        let mut contentSrc = ""
        let mut shareds = []

        if appHeaderIndex >= 0:
            let nm = do progFacetName(rawLines[appHeaderIndex])
            name = nm
            let hdr = trim(rawLines[appHeaderIndex])
            let fkw = do nodeFirstWordOf(hdr)
            kind = fkw
            if fkw == "ui" || fkw == "data":
                let hparts = split(trim(nm), " ")
                let mut hf = []
                let nhp = len(hparts)
                let mut hpi = 0
                loop hpi < nhp:
                    if trim(hparts[hpi]) != "":
                        hf = append(hf, trim(hparts[hpi]))
                    hpi = hpi + 1
                if len(hf) == 3 && hf[1] == "in":
                    name = hf[0]
                    into = hf[2]
                else:
                    parseErrors = append(parseErrors, fkw + " facet header must read `" + fkw + " Name in <socket>:`")

            let mut topIdx = []
            let mut j = 0
            loop j < n:
                if parents[j] == appHeaderIndex:
                    topIdx = append(topIdx, j)
                j = j + 1

            let topN = len(topIdx)
            let mut k = 0
            loop k < topN:
                let headerIndex = topIdx[k]
                let bodyStart = headerIndex + 1
                let mut bodyEnd = n
                if k + 1 < topN:
                    bodyEnd = topIdx[k + 1]
                let header0 = trim(rawLines[headerIndex])
                let mut header = header0
                let isPrivate = do hasPrefixText(header0, "private ")
                if isPrivate:
                    let stripped = do trimPrefixText(header0, "private ")
                    header = stripped
                    let pp = do hasPrefixText(stripped, "proc ")
                    let pv = do hasPrefixText(stripped, "view ")
                    if !pp && !pv:
                        let fw = do nodeFirstWordOf(stripped)
                        parseErrors = append(parseErrors, "`private` is only supported on proc and view declarations, not \"" + fw + "\"")
                let bodyLines = do progRangeOf(rawLines, bodyStart, bodyEnd)
                let bodySrc = do progJoinLines(bodyLines)

                let kw0 = do declKeywordOf(header)
                let mut kw = kw0
                if kw == "":
                    let isStruct = do hasPrefixText(header, "struct ")
                    if isStruct:
                        kw = "struct"
                    let isDaemon = do hasPrefixText(header, "daemon ")
                    if isDaemon:
                        kw = "daemon"
                    let isMount = do hasPrefixText(header, "mount ")
                    if isMount:
                        kw = "mount"
                    let isSocket = do hasPrefixText(header, "socket ")
                    if isSocket:
                        kw = "socket"
                    if header == "frame:" || header == "frame":
                        kw = "frame"
                    let isShared = do hasPrefixText(header, "shared ")
                    if isShared:
                        kw = "shared"
                    if header == "content:" || header == "content":
                        kw = "content"

                if kw == "auth":
                    hasAuth = true
                if kw == "entity":
                    let ed = do buildEntityDecl(header, bodyLines)
                    entities = append(entities, ed)
                if kw == "record":
                    let combined = do combineHeaderBody(header, bodySrc)
                    let rd = do parseRecordDeclSrc(combined)
                    records = append(records, rd)
                if kw == "struct":
                    let combined = do combineHeaderBody(header, bodySrc)
                    let sd = do parseStructDeclSrc(combined)
                    structs = append(structs, sd)
                if kw == "enum":
                    let combined = do combineHeaderBody(header, bodySrc)
                    let en = do parseEnumDeclSrc(combined)
                    enums = append(enums, en)
                if kw == "state":
                    let st = do buildStateDecl(header)
                    states = append(states, st)
                if kw == "derive":
                    let dv0 = do buildDeriveDeclFull(header)
                    let dv = DeriveDeclFull{name: dv0.name, typeCore: dv0.typeCore, headerValid: dv0.headerValid, exprSrc: dv0.exprSrc, expr: dv0.expr, line: header, cont: bodySrc}
                    derives = append(derives, dv)
                if kw == "policy":
                    let pd = do buildPolicyDeclFull(header, bodyLines)
                    policies = append(policies, pd)
                let mut bodyNos0 = []
                let mut bn0 = bodyStart
                loop bn0 < bodyEnd:
                    bodyNos0 = append(bodyNos0, lineNos[bn0])
                    bn0 = bn0 + 1
                if kw == "proc":
                    let mut pcd = do parseProcDecl(header, bodySrc)
                    pcd.bodyLineNos = bodyNos0
                    procs = append(procs, pcd)
                    if isPrivate:
                        privateProcs = append(privateProcs, pcd.name)
                if kw == "action":
                    let ad = do buildActionDecl(header, bodySrc)
                    actions = append(actions, ad)
                if kw == "webhook":
                    let wh = do buildWebhookDecl(header)
                    webhooks = append(webhooks, WebhookDecl{path: wh.path, action: wh.action, hasSecret: wh.hasSecret, secret: wh.secret, valid: wh.valid, line: lineNos[headerIndex]})
                if kw == "job":
                    let jb = do buildJobDecl(header)
                    jobs = append(jobs, jb)
                if kw == "service":
                    let sv = do buildServiceDecl(header, bodyLines)
                    services = append(services, sv)
                    if sv.err != "":
                        parseErrors = append(parseErrors, "line " + lineNos[headerIndex] + ": " + sv.err)
                if kw == "component":
                    let ce = do buildComponentEntry(header, bodySrc)
                    components = append(components, ce)
                if kw == "on":
                    let tr = do buildTriggerDecl(header)
                    triggers = append(triggers, tr)
                if kw == "view":
                    let ve = do buildViewEntry(header, bodySrc)
                    views = append(views, ViewEntry{name: ve.name, path: ve.path, headerValid: ve.headerValid, body: ve.body, header: ve.header, bodySrc: ve.bodySrc, private: isPrivate})
                let isApi = do hasPrefixText(header, "api ")
                let isContract = do hasPrefixText(header, "contract ")
                let isStream = do hasPrefixText(header, "stream ")
                let isFile = do hasPrefixText(header, "file ")
                let isCssFrom = do hasPrefixText(header, "css from ")
                if kw == "type" || kw == "message" || isApi || isContract || isStream || isFile || isCssFrom:
                    let mut rk = kw
                    if isApi:
                        rk = "api"
                    if isContract:
                        rk = "contract"
                    if isStream:
                        rk = "stream"
                    if isFile:
                        rk = "file"
                    if isCssFrom:
                        rk = "cssfrom"
                    let mut bodyNos = []
                    let mut bni = bodyStart
                    loop bni < bodyEnd:
                        bodyNos = append(bodyNos, lineNos[bni])
                        bni = bni + 1
                    rawDecls = append(rawDecls, RawDecl{kw: rk, header: header, bodySrc: bodySrc, line: lineNos[headerIndex], bodyLineNos: bodyNos})
                    kw = rk
                if kw == "mount":
                    let mt = do buildProgMount(header)
                    mounts = append(mounts, mt)
                if kw == "socket":
                    let sk = do buildProgSocket(header)
                    sockets = append(sockets, sk)
                if kw == "frame":
                    if hasFrame:
                        parseErrors = append(parseErrors, "a wireframe has one `frame`")
                    hasFrame = true
                    frameSrc = bodySrc
                if kw == "content":
                    if hasContent:
                        parseErrors = append(parseErrors, kind + " facet \"" + name + "\" has one `content` block")
                    hasContent = true
                    contentSrc = bodySrc
                if kw == "layout":
                    layouts = append(layouts, LayoutEntry{headerLine: header, bodySrc: bodySrc})
                if kw == "daemon":
                    let mut dm = do buildDaemonDecl(header, bodySrc)
                    dm.bodyLineNos = bodyNos0
                    daemons = append(daemons, dm)
                if kw == "shared":
                    # parseShared
                    let lno = lineNos[headerIndex]
                    let rest = trim(slice(header, 6, len(header)))
                    let colon = do indexOf(rest, ":")
                    let mut err = ""
                    if trim(bodySrc) != "":
                        err = "a shared cell has no body — write `shared name: Type`"
                    let mut sname = rest
                    let mut styp = ""
                    if colon >= 0:
                        sname = trim(slice(rest, 0, colon))
                        styp = trim(slice(rest, colon + 1, len(rest)))
                    if err == "" && (colon < 0 || styp == ""):
                        err = "shared needs a type: `shared name: Type`"
                    if err == "" && contains(styp, "="):
                        err = "a shared cell has no initializer — assign it from a proc (`name = expr`); reading it before that is an error, not a default"
                    let nameOk = do isIdentToken(sname)
                    if err == "" && !nameOk:
                        err = "invalid shared cell name \"" + sname + "\""
                    let mut slist = false
                    let tl = len(styp)
                    if tl >= 2 && charAt(styp, 0) == "[" && charAt(styp, tl - 1) == "]":
                        slist = true
                        styp = trim(slice(styp, 1, tl - 1))
                    let typOk = do isIdentToken(styp)
                    if err == "" && !typOk:
                        err = "invalid type \"" + styp + "\" for shared cell \"" + sname + "\""
                    if err != "":
                        parseErrors = append(parseErrors, "line " + lno + ": " + err)
                    else:
                        shareds = append(shareds, SharedDecl{name: sname, type: styp, list: slist, line: lno})
                if kw == "theme":
                    let tb = do buildProgThemeBlock(header, bodyLines)
                    themes = append(themes, tb)
                    # parseTheme's diagnostics, first failing entry first.
                    let ntl = len(bodyLines)
                    if ntl == 0:
                        parseErrors = append(parseErrors, "line " + lineNos[headerIndex] + ": theme block is empty")
                    let mut tli = 0
                    loop tli < ntl:
                        let td = do progThemeEntryDiag(trim(bodyLines[tli]))
                        if td != "":
                            parseErrors = append(parseErrors, "line " + lineNos[bodyStart + tli] + ": " + td)
                            break
                        tli = tli + 1
                if kw == "css":
                    # checkCSSComments: a `#`-anchored rule inside the block
                    # would be dropped as a comment — refuse it instead.
                    let cssFrom = lineNos[headerIndex]
                    let mut cssTo = cssFrom
                    if bodyEnd > bodyStart:
                        cssTo = lineNos[bodyEnd - 1]
                    let srcLines = split(src, "\n")
                    let mut cl = cssFrom
                    loop cl < cssTo:
                        let ct = trim(srcLines[cl])
                        let isC = do hasPrefixText(ct, "#")
                        if isC && contains(ct, "{"):
                            parseErrors = append(parseErrors, "line " + (cl + 1) + ": this looks like a CSS rule, but `#` starts a comment in this language, so the line is discarded and the rule never reaches the page: " + ct + "\n      Anchor the selector on something other than an id — `[data-fa-mount]` is the app root and is worth the same as a class — or drop the anchor entirely.")
                            break
                        cl = cl + 1
                    let block = do progCSSBlock(bodyLines)
                    if css == "":
                        css = block
                    else:
                        css = css + "\n" + block

                let known = do progKnownKeyword(kw)
                if !known:
                    unknownKeywords = append(unknownKeywords, header)

                k = k + 1

        return Program{name: name, hasAuth: hasAuth, entities: entities, records: records, structs: structs, enums: enums, states: states, derives: derives, policies: policies, procs: procs, actions: actions, webhooks: webhooks, jobs: jobs, services: services, components: components, triggers: triggers, views: views, themes: themes, css: css, daemons: daemons, privateProcs: privateProcs, parseErrors: parseErrors, layouts: layouts, rawDecls: rawDecls, kind: kind, into: into, mounts: mounts, sockets: sockets, hasFrame: hasFrame, frameSrc: frameSrc, hasContent: hasContent, contentSrc: contentSrc, unknownKeywords: unknownKeywords, shareds: shareds}

    # ============================================================
    # STAGE 7: the live, HTTP-exercisable driver — proof `parseProgramSrc`
    # actually assembles a real multi-kind `Program`, not just one kind at a
    # time. A struct value can never be a `state` cell (every earlier
    # struct-milestone file's own established limit), so the action below
    # does the struct-walking inside a proc and hands back only plain
    # `text`/`int` counts, exactly like nodes.fct's/parser_decl2.fct's own
    # closing drivers.
    # ============================================================
    proc demoProgramSrc() -> text:
        return "app Demo:\n    entity Widget:\n        name: text\n        price: int @min(0)\n    state counter: int = 0\n    derive doubled: int = counter * 2\n    record Point: x: int, y: int\n    proc addOne(n: int) -> int:\n        return n + 1\n    action bump():\n        check counter >= 0 \"counter went negative\"\n        counter = counter + 1\n    webhook \"/hook\" -> onHook\n    job Sweep every 60s -> sweepNow\n    policy owns(id: int):\n        actor == id\n    service Pay at \"https://pay.example.com\":\n        charge(amount: int) -> bool\n    on addOne -> sweepNow\n"

    # demoProgramXxx: a struct value (`Program`) can never be a `state` cell
    # or cross an action's own boundary (this file's own STAGE 3/4 header;
    # the same limit expr_tokens.fct/nodes.fct/stmt.fct/parser_decl2.fct
    # each already documented for their own struct trees) — so every one of
    # these re-parses `src` independently inside its OWN proc and returns
    # exactly one plain scalar, the same "re-derive rather than share one
    # multi-value result" convention source.fct's own parsedIndents/
    # parsedTexts/parsedSkipFlags already established for the identical
    # reason (a proc has exactly one return value).
    proc demoProgramName(src: text) -> text:
        let prog = do parseProgramSrc(src)
        return prog.name

    proc demoProgramEntityCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.entities)

    proc demoProgramRecordCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.records)

    proc demoProgramProcCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.procs)

    proc demoProgramActionCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.actions)

    proc demoProgramActionBodyDescribed(src: text) -> text:
        let prog = do parseProgramSrc(src)
        let d = do describeActionStmts(prog.actions[0].body)
        return d

    proc demoProgramStateCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.states)

    proc demoProgramDeriveCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.derives)

    proc demoProgramPolicyCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.policies)

    proc demoProgramWebhookCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.webhooks)

    proc demoProgramJobCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.jobs)

    proc demoProgramServiceCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.services)

    proc demoProgramTriggerCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.triggers)

    proc demoProgramUnknownCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.unknownKeywords)

    # demoProgramViewSrc/demoProgramViewBodyDescribed/
    # demoProgramViewBodyDirectDescribed: the real proof that `private`
    # actually unblocked something, not just that `facet check` stays green.
    # This source's one view has a genuine multi-node body (box wrapping two
    # texts); demoProgramViewBodyDescribed runs it through the FULL
    # parseProgramSrc pipeline (source -> Program -> views[0].body) and
    # describes the resulting [UiNode] tree via nodes.fct's own
    # describeUiNodes, while demoProgramViewBodyDirectDescribed calls
    # nodes.fct's nodeTreeSrc directly on the identical raw body text (same
    # indentation progRangeOf/progJoinLines would hand it, reproduced by
    # hand here). If Program's view body is genuinely the same tree
    # nodeTreeSrc builds on its own — not an empty placeholder, not a
    # mis-parsed stand-in — these two descriptions must be byte-identical.
    proc demoProgramViewSrc() -> text:
        return "app DemoView:\n    view Home at \"/\":\n        box:\n            text \"hello\"\n            text \"world\"\n"

    proc demoProgramViewBodyDescribed(src: text) -> text:
        let prog = do parseProgramSrc(src)
        let described = do describeUiNodes(prog.views[0].body)
        return described

    proc demoProgramViewBodyDirectDescribed() -> text:
        let nodes = do nodeTreeSrc("        box:\n            text \"hello\"\n            text \"world\"")
        let described = do describeUiNodes(nodes)
        return described

    proc demoProgramViewBodyNodeCount(src: text) -> int:
        let prog = do parseProgramSrc(src)
        return len(prog.views[0].body)

    state demoName: text = ""
    state demoEntityCount: int = 0
    state demoRecordCount: int = 0
    state demoProcCount: int = 0
    state demoActionCount: int = 0
    state demoActionBodyDescribed: text = ""
    state demoStateCount: int = 0
    state demoDeriveCount: int = 0
    state demoPolicyCount: int = 0
    state demoWebhookCount: int = 0
    state demoJobCount: int = 0
    state demoServiceCount: int = 0
    state demoTriggerCount: int = 0
    state demoUnknownCount: int = 0
    state demoViewBodyDescribed: text = ""
    state demoViewBodyDirectDescribed: text = ""
    state demoViewBodyNodeCount: int = 0

    action runParseProgram():
        let src = do demoProgramSrc()
        let nm = do demoProgramName(src)
        let ec = do demoProgramEntityCount(src)
        let rc = do demoProgramRecordCount(src)
        let pc = do demoProgramProcCount(src)
        let ac = do demoProgramActionCount(src)
        let abd = do demoProgramActionBodyDescribed(src)
        let sc = do demoProgramStateCount(src)
        let dc = do demoProgramDeriveCount(src)
        let plc = do demoProgramPolicyCount(src)
        let wc = do demoProgramWebhookCount(src)
        let jc = do demoProgramJobCount(src)
        let svc = do demoProgramServiceCount(src)
        let tc = do demoProgramTriggerCount(src)
        let uc = do demoProgramUnknownCount(src)
        let viewSrc = do demoProgramViewSrc()
        let vbd = do demoProgramViewBodyDescribed(viewSrc)
        let vbdd = do demoProgramViewBodyDirectDescribed()
        let vbc = do demoProgramViewBodyNodeCount(viewSrc)
        demoName = nm
        demoEntityCount = ec
        demoRecordCount = rc
        demoProcCount = pc
        demoActionCount = ac
        demoActionBodyDescribed = abd
        demoStateCount = sc
        demoDeriveCount = dc
        demoPolicyCount = plc
        demoWebhookCount = wc
        demoJobCount = jc
        demoServiceCount = svc
        demoTriggerCount = tc
        demoUnknownCount = uc
        demoViewBodyDescribed = vbd
        demoViewBodyDirectDescribed = vbdd
        demoViewBodyNodeCount = vbc

    private view Home at "/program":
        box:
            text "{demoName} entities={demoEntityCount} records={demoRecordCount} procs={demoProcCount} actions={demoActionCount}"
            text "actionBody={demoActionBodyDescribed}"
            text "states={demoStateCount} derives={demoDeriveCount} policies={demoPolicyCount}"
            text "webhooks={demoWebhookCount} jobs={demoJobCount} services={demoServiceCount} triggers={demoTriggerCount} unknown={demoUnknownCount}"
