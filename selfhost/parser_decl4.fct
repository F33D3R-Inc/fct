import "parser_decl3.fct"

app ParserDecl4SelfHost:
    # Self-hosting port of internal/parser/parser.go's parseDaemon
    # (parser.go lines 2490-2531, ~42 lines, read fresh before writing this
    # file — confirmed still exactly that range) — the declaration kind
    # parser_decl3.fct's own header explicitly named as the next open item
    # ("daemon ... is mid-size and doable, but needs parseProcBody ... wired
    # onto its tail — real, larger surface than the two [theme/file] ported
    # there"). `daemon Name [uses cap1, cap2] [every <duration>]:` is a
    # detached, process-lifetime background task: the header is proc-shaped
    # (a name plus an optional `uses` clause, exactly parseProc's own), the
    # body is a FULL proc-body statement list (the same vocabulary a `proc`
    # gets: let/if/loop/do/spawn/join/read/write/break/continue/return/
    # assign/indexAssign/exprStmt — all already real via stmt.fct's
    # `Stmt`/`parseProcBodySrc`, reached transitively through this file's
    # own `import "parser_decl3.fct"` -> parser_decl2 -> parser_service ->
    # parser_entity -> parser_proc -> stmt.fct -> expr.fct chain), plus one
    # daemon-ONLY statement kind stmt.fct does not model at all: `act
    # ActionName(args)` (ast.Act, parser.go's parseAct at line 1860 — the
    # one way a daemon body may touch entity/session state, since a plain
    # proc body cannot). See STAGE 2 below for how `act` is handled without
    # touching stmt.fct itself.
    #
    # ============================================================
    # THE HEADER — A REAL, CONFIRMED QUIRK PRESERVED ON PURPOSE
    # ============================================================
    # parseDaemon's own doc comment claims the `every <duration>` clause and
    # the `uses <capabilities>` clause "may appear in either order" — but
    # reading the CODE (not just the comment) shows this is only half true,
    # and running it live against the real compiled `facet` binary CONFIRMS
    # the gap rather than just guessing from the source:
    #
    #   if i := strings.Index(head, " uses "); i >= 0 {
    #       usesPart := strings.TrimSpace(head[i+len(" uses "):])   // <-- to
    #       head = strings.TrimSpace(head[:i])                      //   END
    #       ...                                                      //   of
    #   }                                                             //  head
    #   if i := strings.Index(head, " every "); i >= 0 { ... }
    #
    # `uses`'s own slice runs to the END of `head`, whatever is still there —
    # so if `every` was written AFTER `uses` in the source text, the
    # `every ...` tail rides along inside `usesPart` and gets comma-split
    # and capability-validated as one malformed "capability" alongside any
    # real ones, which isCapabilityName correctly rejects (a capability name
    # is dot-separated identifiers only, never containing a space). Only
    # `every ... uses ...` order survives, because then `uses` really is the
    # last clause once found. Confirmed live, not just by tracing:
    #
    #   daemon Listener uses io.net.listen every 5s:      (uses before every)
    #     -> facet: line 9: invalid capability "io.net.listen every 5s" in
    #        uses clause (expected a dotted name like io.file)
    #   daemon Listener every 5s uses io.net.listen:      (every before uses)
    #     -> ok
    #
    # This port replicates that exact behavior, quirk included — the same
    # "match the real algorithm's actual behavior" convention stmt.fct's own
    # `return`-prefix note and source.fct's ragged-sibling-indent note both
    # already established — by literally reusing the identical
    # substring-search-to-end-of-head shape below (daemonUsesPartOf), not a
    # "smarter" token-order-independent parse that would silently diverge
    # from what parser.go itself actually does.
    #
    # ============================================================
    # WHY THIS REUSES parser_proc.fct's headBeforeUses/usesPartOf/
    # headerUsesList/headerUsesValid/isCapabilityNameToken RATHER THAN
    # RESTATING THEM
    # ============================================================
    # Those procs (reached transitively via this file's own
    # `import "parser_decl3.fct"` chain) take a plain `head: text` and
    # search it for the literal substring " uses " — they have no
    # dependency on the `proc` keyword or on parseProc's own grammar at all
    # (only `procHeadOf`, a separate proc, strips the leading `proc `/
    # trailing `:`). Real parser.go itself independently repeats the
    # identical `strings.Index(head, " uses ")` snippet at BOTH parseProc's
    # own call site and parseDaemon's (parser.go 2493-2506 vs. the
    # `uses`-handling block inside parseProc) — two copies of the same
    # algorithm in the reference implementation itself. Reusing this port's
    # existing copy for daemon's header is a real, honest port of that
    # shared algorithm, not a stretch: `daemonHeadOf` below strips `daemon`/
    # `:` (daemon's own prefix, distinct from `procHeadOf`'s `proc`/`:`),
    # then hands the result to the SAME uses-clause machinery parser_proc.fct
    # already verified. Only the `every` clause (proc has no such clause at
    # all) and the final `name` extraction (order-dependent on uses/every
    # both having been stripped first) are new here.
    # ============================================================

    # daemonHeadOf: parser.go's own
    # `strings.TrimSuffix(strings.TrimSpace(strings.TrimPrefix(n.Line.Text, "daemon")), ":")`
    proc daemonHeadOf(lineText: text) -> text:
        let stripped = do trimPrefixText(lineText, "daemon")
        let trimmed = trim(stripped)
        let r = do trimSuffixText(trimmed, ":")
        return r

    # --- the `uses` clause: reuses parser_proc.fct's own uses-clause
    # machinery directly (see header note above) ---
    proc daemonUsesList(head: text) -> [text]:
        let r = do headerUsesList(head)
        return r

    proc daemonUsesValid(head: text) -> bool:
        let r = do headerUsesValid(head)
        return r

    proc daemonHeadAfterUses(head: text) -> text:
        let r = do headBeforeUses(head)
        return r

    # --- the `every` clause: parser.go's own
    # `strings.Index(head, " every ")`, applied to the head AFTER the
    # `uses` clause (if any) has already been stripped — daemon has no
    # other caller of an "every" search anywhere else in this port, so this
    # is new (job's own `every` is a totally different multi-token schedule
    # grammar — parser_service.fct's jobEverySeconds/jobScheduleValid walk a
    # SPACE-SPLIT FIELD LIST after a job's name, not a single trailing
    # substring search — the two are genuinely different shapes in the real
    # grammar, not the same code twice). ---
    proc daemonEveryMarkerIndex(headNoUses: text) -> int:
        let r = do indexOf(headNoUses, " every ")
        return r

    proc daemonEveryPartOf(headNoUses: text) -> text:
        let idx = do daemonEveryMarkerIndex(headNoUses)
        if idx < 0:
            return ""
        return trim(slice(headNoUses, idx + 7, len(headNoUses)))

    proc daemonHeadAfterEvery(headNoUses: text) -> text:
        let idx = do daemonEveryMarkerIndex(headNoUses)
        if idx < 0:
            return headNoUses
        return trim(slice(headNoUses, 0, idx))

    # daemonHasEvery/daemonEveryValid/daemonEverySeconds: independent
    # re-derivations of the identical every-clause walk (a proc returns one
    # value only — the same "parallel derivation" convention source.fct's
    # parsedIndents/parsedTexts/parsedSkipFlags and parser_proc.fct's own
    # typeIsOptional/typeIsList/typeCore family both already established).
    # `durationValid`/`durationSeconds` (parser_service.fct, reached
    # transitively) are the exact same `<N><s|m|h>` grammar `job every
    # <duration>` already uses — real parser.go's parseDaemon calls the
    # very same `parseDuration` job's own schedule parsing calls.
    proc daemonHasEvery(lineText: text) -> bool:
        let head = do daemonHeadOf(lineText)
        let headNoUses = do daemonHeadAfterUses(head)
        let idx = do daemonEveryMarkerIndex(headNoUses)
        return idx >= 0

    proc daemonEveryValid(lineText: text) -> bool:
        let head = do daemonHeadOf(lineText)
        let headNoUses = do daemonHeadAfterUses(head)
        let idx = do daemonEveryMarkerIndex(headNoUses)
        if idx < 0:
            return true
        let durS = do daemonEveryPartOf(headNoUses)
        let r = do durationValid(durS)
        return r

    # everySeconds stays the honest 0 (real ast.Daemon's own "unset" value —
    # see ast.Daemon's doc: "0 = Body runs once") both when `every` is
    # absent AND when it is present but malformed — the latter is a real
    # parseDuration ERROR in parser.go (this port has no error channel), so
    # `daemonEveryValid` above is the field a caller must check to tell
    # "genuinely no every clause" apart from "an every clause that failed to
    # parse", exactly how `headerValid`/`bodyValid` already separate
    # "absent" from "malformed" elsewhere in this port.
    proc daemonEverySeconds(lineText: text) -> int:
        let head = do daemonHeadOf(lineText)
        let headNoUses = do daemonHeadAfterUses(head)
        let idx = do daemonEveryMarkerIndex(headNoUses)
        if idx < 0:
            return 0
        let durS = do daemonEveryPartOf(headNoUses)
        let secs = do durationSeconds(durS)
        if secs < 0:
            return 0
        return secs

    # daemonName: whatever is left of `head` once BOTH the uses clause and
    # the every clause have been stripped, in that order — exactly
    # parser.go's own `name := strings.TrimSpace(head)` after both `if`
    # blocks have run.
    proc daemonName(lineText: text) -> text:
        let head = do daemonHeadOf(lineText)
        let headNoUses = do daemonHeadAfterUses(head)
        let headNoEvery = do daemonHeadAfterEvery(headNoUses)
        return trim(headNoEvery)

    proc daemonUses(lineText: text) -> [text]:
        let head = do daemonHeadOf(lineText)
        let r = do daemonUsesList(head)
        return r

    # daemonHeaderValid: every real rejection gate parseDaemon's HEADER half
    # has — a well-formed uses clause (if present), a well-formed every
    # clause (if present), and an identifier name. (parseDaemon's own
    # EMPTY-BODY rejection, `len(d.Body) == 0`, is tracked separately as
    # `DaemonDecl.bodyValid` below, mirroring ProcDecl's own
    # headerValid/bodyValid split.)
    proc daemonHeaderValid(lineText: text) -> bool:
        let head = do daemonHeadOf(lineText)
        let usesOk = do daemonUsesValid(head)
        if !usesOk:
            return false
        let everyOk = do daemonEveryValid(lineText)
        if !everyOk:
            return false
        let name = do daemonName(lineText)
        let r = do isIdentToken(name)
        return r

    # ============================================================
    # STAGE 2: `act ActionName(args)` — the one daemon-only statement kind.
    #
    # CONFIRMED: stmt.fct's `Stmt.kind` closed set (let/letMut/assign/
    # return/do/letDo/if/loop/break/continue/spawn/join/letJoin/write/
    # letWrite/read/letRead/indexAssign/exprStmt/unsupported — read fresh
    # from stmt.fct's own struct doc, lines 102-224) has NO "act" case, and
    # `singleStmt`'s dispatch (stmt.fct lines 575-777) has no `"act "`
    # prefix branch either — unsurprising, since stmt.fct's own task brief
    # was "port parseProcBody", and real parseProcBody's `act` case (parser.go
    # 2076-2087) is annotated as "valid to PARSE in any proc-shaped body"
    # but is a genuinely NEW addition on top of the plain proc-body grammar
    # stmt.fct ported first. Traced by hand what `singleStmt` actually DOES
    # with a line like "act tick()": it is not a `break`/`continue`/`loop `/
    # `return`/`do `/`write `/`read `/`join `/`let ` line, and
    # `stmtIsBareCallStmt` rejects it too (the name-before-`(` check,
    # `trim(slice(t, 0, open))`, yields "act tick" — containing a space, so
    # `stmtIsIdent` returns false) — so it falls all the way through to the
    # final default and comes back `Stmt{kind: "unsupported", lineIdx: ...}`
    # with lineIdx pointing at the real source line. That is the honest hook
    # this file uses: reclassify an "unsupported" Stmt into a real "act" one
    # by re-inspecting that exact source line, entirely from THIS file,
    # without touching stmt.fct.
    #
    # This needs the same raw line text stmt.fct's OWN internal
    # `bodyTexts(src)` builds (to look up `texts[lineIdx]`) — but
    # `bodyIndents`/`bodyTexts`/`bodyParents` are all declared `private` in
    # stmt.fct (confirmed by reading stmt.fct fresh: lines 435-510), and
    # `private` mangles a proc's name to a file-unique symbol (internal/
    # compile/private.go), so they are NOT reachable from this file even
    # though stmt.fct is imported transitively. The fix mirrors stmt.fct's
    # OWN precedent for the identical situation (its header explains why it
    # restates source.fct's childrenOf/indent logic locally rather than
    # importing source.fct): `daemonBodyTexts` below restates the same
    # blank/comment-skip-and-trim line split locally. Since both are pure
    # functions of the identical `bodySrc` string, `daemonBodyTexts(bodySrc)`
    # lines up index-for-index with the `lineIdx` values
    # `parseProcBodySrc(bodySrc)` already produced internally — verified
    # live below (STAGE 4) against both real daemon examples' actual `act`
    # lines, at both top level (daemon.fct's `act tick()`) and nested two
    # loops deep (echo_daemon.fct's `act recordConnection()`/
    # `act recordBytes(...)`).
    # ============================================================
    private proc d4IsBlankOrComment(line: text) -> bool:
        let t = trim(line)
        if len(t) == 0:
            return true
        return slice(t, 0, 1) == "#"

    private proc d4LineText(line: text) -> text:
        return trim(line)

    proc daemonBodyTexts(src: text) -> [text]:
        let rawLines = split(src, "\n")
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let raw = rawLines[i]
            let skip = do d4IsBlankOrComment(raw)
            if !skip:
                let tx = do d4LineText(raw)
                out = append(out, tx)
            i = i + 1
        return out

    # isActLine/actActionName/actArgsOf: the same prefix-then-paren
    # isolation bareDoProcName (stmt.fct) already uses for `do`, restated
    # for `act` (`do`'s own helper is not reusable as-is: it strips the
    # literal `"do "` prefix, not `"act "`) — and `doArgsNodes` (stmt.fct,
    # public) reused VERBATIM for the argument list, since `act
    # ActionName(args)`'s own argument list is syntactically identical to a
    # `do` call's (real parseAct, parser.go line 1860, is documented as
    # "identical call shape to parseDo/parseSpawn").
    proc isActLine(lineText: text) -> bool:
        let t = trim(lineText)
        let r = do stmtHasPrefix(t, "act ")
        return r

    proc actActionName(lineText: text) -> text:
        let t = trim(lineText)
        let rest0 = do stmtTrimPrefix(t, "act ")
        let rest = trim(rest0)
        let openParen = do firstParenIndex(rest)
        if openParen < 0:
            return rest
        return trim(slice(rest, 0, openParen))

    proc actArgsOf(lineText: text) -> [ExprNode]:
        let t = trim(lineText)
        let rest0 = do stmtTrimPrefix(t, "act ")
        let rest = trim(rest0)
        let args = do doArgsNodes(rest)
        return args

    # reclassifyStmt/reclassifyStmts: walk the WHOLE tree `parseProcBodySrc`
    # returned (not just the top level — echo_daemon.fct's real `act
    # recordConnection()`/`act recordBytes(...)` sit two `loop` bodies deep),
    # turning any "unsupported" Stmt whose real source line is `act
    # Name(args)`-shaped into a real `kind: "act"` Stmt (reusing Stmt's
    # existing `args: [ExprNode]` field exactly like "do" does — no new
    # field needed, mirroring stmt.fct's own "reuse an existing field
    # wherever the real AST's own shape reuses the same idea" convention).
    # Every other kind (and every genuinely-unsupported line) passes through
    # unchanged; `if`/`loop` are rebuilt with their own `body`/`elseBody`
    # recursively reclassified. This is real mutual mutual-list/single-node
    # recursion between two DIFFERENT top-level procs — the identical shape
    # stmt.fct's own `singleStmt` (defined first) already uses calling
    # `stmtBlockStmts` (defined later in the same file) for `loop`'s body,
    # confirming forward/mutual proc references across declaration order
    # are load-bearing and already relied on in this codebase.
    proc reclassifyStmt(s: Stmt, texts: [text]) -> Stmt:
        if s.kind == "unsupported":
            let lineText = texts[s.lineIdx]
            let isAct = do isActLine(lineText)
            if isAct:
                let args = do actArgsOf(lineText)
                let noExpr = do emptyNode()
                return Stmt{kind: "act", lineIdx: s.lineIdx, expr: noExpr, args: args, body: [], elseBody: [], index: noExpr}
            return s
        if s.kind == "if":
            let newThen = do reclassifyStmts(s.body, texts)
            let newElse = do reclassifyStmts(s.elseBody, texts)
            return Stmt{kind: s.kind, lineIdx: s.lineIdx, expr: s.expr, args: s.args, body: newThen, elseBody: newElse, index: s.index}
        if s.kind == "loop":
            let newBody = do reclassifyStmts(s.body, texts)
            return Stmt{kind: s.kind, lineIdx: s.lineIdx, expr: s.expr, args: s.args, body: newBody, elseBody: s.elseBody, index: s.index}
        return s

    proc reclassifyStmts(stmts: [Stmt], texts: [text]) -> [Stmt]:
        let n = len(stmts)
        let mut out = []
        let mut i = 0
        loop i < n:
            let r = do reclassifyStmt(stmts[i], texts)
            out = append(out, r)
            i = i + 1
        return out

    # actActionNameOf/actArgCountOf: name/arity recovery for a reclassified
    # "act" Stmt, on demand from its own `lineIdx` — mirroring stmt.fct's
    # own STAGE 9 name-recovery convention (bareDoProcName et al.) exactly,
    # never stored as a field on Stmt itself.
    proc actActionNameOf(s: Stmt, texts: [text]) -> text:
        let lineText = texts[s.lineIdx]
        let r = do actActionName(lineText)
        return r

    # ============================================================
    # STAGE 3: parseDaemonDeclBody/DaemonDecl/parseDaemonDeclSrc — the
    # end-to-end driver, direct template of parser_proc.fct's own STAGE 9
    # (parseProcDeclBody/ProcDecl/parseProcDecl), since a daemon's own shape
    # is proc-like: raw header LINE TEXT plus the header's own raw, dedented
    # body TEXT in, one real `DaemonDecl` struct out.
    # ============================================================
    proc parseDaemonDeclBody(bodySrc: text) -> [Stmt]:
        let raw = do parseProcBodySrc(bodySrc)
        let texts = do daemonBodyTexts(bodySrc)
        let r = do reclassifyStmts(raw, texts)
        return r

    struct DaemonDecl:
        name: text
        uses: [text]
        hasEvery: bool
        everySeconds: int
        headerValid: bool
        body: [Stmt]
        bodyValid: bool

    proc parseDaemonDeclSrc(lineText: text, bodySrc: text) -> DaemonDecl:
        let name = do daemonName(lineText)
        let uses = do daemonUses(lineText)
        let hasEvery = do daemonHasEvery(lineText)
        let everySeconds = do daemonEverySeconds(lineText)
        let headerValid = do daemonHeaderValid(lineText)
        let body = do parseDaemonDeclBody(bodySrc)
        let bodyValid = len(body) > 0
        return DaemonDecl{name: name, uses: uses, hasEvery: hasEvery, everySeconds: everySeconds, headerValid: headerValid, body: body, bodyValid: bodyValid}

    # ============================================================
    # STAGE 4: verification wiring — a real end-to-end run, driven from
    # `facet console`/`:as` against the actual two real examples this task
    # asks for (examples/daemon.fct's `daemon Pulse every 1s: act tick()`
    # and examples/echo_daemon.fct's `daemon Echo uses io.net.listen: ...`,
    # whose body nests `act recordConnection()`/`act recordBytes(len(data))`
    # two `loop` levels deep) — not a synthetic fixture.
    # ============================================================
    proc daemonUsesSummary(uses: [text]) -> text:
        let n = len(uses)
        let mut out = ""
        let mut i = 0
        loop i < n:
            if i > 0:
                out = out + ","
            out = out + uses[i]
            i = i + 1
        return out

    # A DaemonDecl struct value cannot cross into an action (structs are
    # proc-local — confirmed live: `facet check` refuses "an action cannot
    # bind" a proc that RETURNS a struct type, exactly the same rule
    # program.fct's own header already documents for ProcDecl/`parseProcDecl`
    # — see program.fct line ~104), so each field is its own independent
    # scalar-returning "summary" proc that builds the struct internally and
    # reads one field back out — the identical parallel-derivation shape
    # parser_decl3.fct's own `themeDeclSummaryVars`/`themeDeclSummaryCount`/
    # `themeDeclSummaryValid` already use for exactly this reason.
    proc daemonDeclSummaryName(lineText: text, bodySrc: text) -> text:
        let d = do parseDaemonDeclSrc(lineText, bodySrc)
        return d.name

    proc daemonDeclSummaryUses(lineText: text, bodySrc: text) -> text:
        let d = do parseDaemonDeclSrc(lineText, bodySrc)
        let r = do daemonUsesSummary(d.uses)
        return r

    proc daemonDeclSummaryHasEvery(lineText: text, bodySrc: text) -> bool:
        let d = do parseDaemonDeclSrc(lineText, bodySrc)
        return d.hasEvery

    proc daemonDeclSummaryEverySeconds(lineText: text, bodySrc: text) -> int:
        let d = do parseDaemonDeclSrc(lineText, bodySrc)
        return d.everySeconds

    proc daemonDeclSummaryHeaderValid(lineText: text, bodySrc: text) -> bool:
        let d = do parseDaemonDeclSrc(lineText, bodySrc)
        return d.headerValid

    proc daemonDeclSummaryBody(lineText: text, bodySrc: text) -> text:
        let d = do parseDaemonDeclSrc(lineText, bodySrc)
        let r = do describeStmts(d.body)
        return r

    proc daemonDeclSummaryBodyValid(lineText: text, bodySrc: text) -> bool:
        let d = do parseDaemonDeclSrc(lineText, bodySrc)
        return d.bodyValid

    state daemonDeclName: text = ""
    state daemonDeclUsesSummary: text = ""
    state daemonDeclHasEvery: bool = false
    state daemonDeclEverySeconds: int = 0
    state daemonDeclHeaderValidResult: bool = false
    state daemonDeclBodySummary: text = ""
    state daemonDeclBodyValidResult: bool = false

    action runParseDaemonDecl(lineText: text, bodySrc: text):
        let n = do daemonDeclSummaryName(lineText, bodySrc)
        let us = do daemonDeclSummaryUses(lineText, bodySrc)
        let he = do daemonDeclSummaryHasEvery(lineText, bodySrc)
        let es = do daemonDeclSummaryEverySeconds(lineText, bodySrc)
        let hv = do daemonDeclSummaryHeaderValid(lineText, bodySrc)
        let bs = do daemonDeclSummaryBody(lineText, bodySrc)
        let bv = do daemonDeclSummaryBodyValid(lineText, bodySrc)
        daemonDeclName = n
        daemonDeclUsesSummary = us
        daemonDeclHasEvery = he
        daemonDeclEverySeconds = es
        daemonDeclHeaderValidResult = hv
        daemonDeclBodySummary = bs
        daemonDeclBodyValidResult = bv

    private view Home at "/decl4":
        box:
            text "{daemonDeclName} uses={daemonDeclUsesSummary} hasEvery={daemonDeclHasEvery} every={daemonDeclEverySeconds}"
            text "header_valid={daemonDeclHeaderValidResult} body_valid={daemonDeclBodyValidResult}"
            text "body={daemonDeclBodySummary}"
