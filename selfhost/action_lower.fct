import "check.fct"
import "action_stmt.fct"
import "lower.fct"
import "ir_decl.fct"

app ActionLowerSelfHost:
    # Self-hosting port of internal/ir/build.go's `(e *env) action(a
    # *ast.Action) (Action, error)` — the ACTION lowering: every statement
    # kind of an action body lowered to ir_stmt.fct's IRStmt constructors,
    # the flags the body accumulates (writes, reads, entWrite, impure,
    # usesPrint, callsService, callsProc, establishesID), the placement
    # switch and its soundness gates, spelled into ir_decl.fct's IRAction
    # so `irActionJSON` prints exactly what encoding/json prints for the
    # real compiler's ir.Action.
    #
    # INPUT: the action's name, parameter names/types, `@optimistic` flag,
    # and its BODY SOURCE (the dedented lines under the `action …:` header),
    # parsed by action_stmt.fct's `parseActionBodySrc` (the port of
    # parseAction's body grammar) — `requires` lines split out with
    # `actionRequiresOnly`/`actionBodyOnly`, exactly as parseAction routes
    # them into ast.Action.Requires vs Body. Every expression is lowered by
    # lower.fct's `lowerNode` (the port of lower()).
    #
    # ============================================================
    # THE ENVIRONMENT (ALowEnv) — what `*env` becomes
    # ============================================================
    # A proc has no map-typed parameter, so each table action() reads off
    # `*env` is a parallel list, bundled in one struct:
    #
    #   stateNames / statePlacements   e.states: name -> "server"|"client"
    #                                  (a @private cell is "server", as the
    #                                  real builder records it)
    #   entityNames                    e.entities
    #   entityFields                   e.entityFields flattened to
    #                                  "Entity.field" (declared fields plus
    #                                  a @softdelete's injected `archived`;
    #                                  `id` is NOT in it, as in Go — `for …
    #                                  by id` is special-cased there too)
    #   entityDerives                  e.entityDerives as "Entity.derive"
    #   enumNames                      e.enums' key set
    #   policyNames / policyParamCounts e.policyParams (every policy, with
    #                                  its arity) — e.policySet is the same
    #                                  key set
    #   inlineNames / inlineExprs      e.inline: zero-arg policy and derive
    #                                  names -> their ALREADY-LOWERED IR,
    #                                  the same table lower() substitutes
    #   serviceNames / serviceOps / serviceArgCounts / serviceRets /
    #   serviceRetLists                e.services + e.serviceRets, one
    #                                  entry PER OPERATION (serviceNames[i]
    #                                  is the service op i belongs to)
    #   procNames / procParamCounts / procRets / procRetLists
    #                                  e.procSigs
    #   structNames                    e.structs' key set (a `do` cannot
    #                                  bind a struct-returning proc)
    #
    # ============================================================
    # THE ERROR CHANNEL
    # ============================================================
    # Go returns `(Action{}, error)`; a proc has one return value. Where
    # the real action() returns a BuildError, this port returns an
    # IRAction whose `placement` is "" (never a real placement — the real
    # compiler only ever assigns "server"/"client") and whose `reason`
    # carries the diagnostic text, spelled as build.go spells it (Go's %q
    # restated as a quoted name; BuildError's `line N: ` prefix is the
    # caller's business and is not reproduced). Every other field of that
    # IRAction is empty. The statement walk stops at the first error, as
    # the Go closure returns at its first `err`.
    #
    # ============================================================
    # WHAT IS PORTED
    # ============================================================
    # Statement kinds (block's type switch, in its order): check, assign,
    # add (with `let id = add` bind), set by id, set … where (filtered,
    # with its field block), remove by id, remove … where, clear, call
    # (with `let x = call` bind, ret/retList), do (with bind, ret/retList,
    # the float/struct/nothing-returned refusals), establish (actor +
    # optional role), exprstmt (a bare builtin call), let, if/else, for
    # (where/by/desc/limit, nested body). bindLocal's three scope rules
    # ("already in scope", "would shadow the state cell", "would shadow
    # the entity") and its clone-per-nested-block scoping. readExprIn's
    # bookkeeping (impure/print flags, state reads via depsIR over the
    # LOWERED expression, so an inlined derive's own state reads count).
    # `requires` with a row-level policy and args (arity, purity, the
    # "which is a derive, not a policy" / "unknown policy" refusals). The
    # float-parameter refusal. The placement switch with every Reason
    # string verbatim, the post-switch "writes authoritative state" upgrade
    # over the SORTED write set, the two soundness gates (client read /
    # client write by a server-placed action) and the requires gate.
    # Writes/Reads are sorted (sortedKeys).
    #
    # ============================================================
    # WHAT IS LEFT OUT, AND WHY
    # ============================================================
    # - @e2e sealed fields (e2eWrite, the seal-dataflow re-walk, `Seal`):
    #   the environment carries no e2e field set, so an action over an
    #   @e2e entity is out of scope; `seal` is always empty here.
    # - The full `e.check` rule set on each expression (builtin arity,
    #   proc-only operators/index/float/io/concurrency, dropped-brace text
    #   literals, `Enum.member` validation, record-field access on a
    #   `let`-bound record): check.fct ports those, but it cannot be
    #   imported alongside action_stmt.fct (both declare a public
    #   `indexOfFrom`), so this file ports only the piece placement
    #   depends on — free-name resolution ("unknown reference") and the
    #   now/rand/print purity rules of checkPure — and trusts the rest.
    # - `checkLiteral` on a check's message (the interpolation-brace
    #   diagnostic) and `checkNoPrivate` on establish's actor/role.
    # - e.locRecords (record-typed `let` binds) — bookkeeping for a check
    #   this file does not port.
    # - A statement the self-hosted grammar cannot parse (kind
    #   "unsupported") degrades to an error reason of its own, not a Go
    #   message — the real parser would have refused it earlier.
    # - Go's soundness loops iterate a map in random order; here the
    #   offending name reported is the FIRST in sorted order.
    # - `@optimistic` is parsed (ast.Action.Optimistic) but the real
    #   action() never copies it into ir.Action, so neither does this port
    #   (see lowerActionSrc's closing note).
    struct ALowEnv:
        stateNames: [text]
        statePlacements: [text]
        entityNames: [text]
        entityFields: [text]
        entityDerives: [text]
        enumNames: [text]
        policyNames: [text]
        policyParamCounts: [int]
        inlineNames: [text]
        inlineExprs: [IRExpr]
        serviceNames: [text]
        serviceOps: [text]
        serviceArgCounts: [int]
        serviceRets: [text]
        serviceRetLists: [bool]
        procNames: [text]
        procParamCounts: [int]
        procRets: [text]
        procRetLists: [bool]
        structNames: [text]
        # manglePrivate's rename table for the file this action came from:
        # a `do` of that file's private proc names its mangled form.
        renameFrom: [text]
        renameTo: [text]
        # e2eFields: every @e2e entity field as "Entity.field"; actionParams:
        # the parameters of the action being lowered (lowerActionSrc sets it).
        e2eFields: [text]
        actionParams: [text]
        # wireTypes: declared `type`/`message` names (an emit's payload, a
        # DTO return); actionName/actionRet: the action being lowered.
        wireTypes: [text]
        actionName: text
        actionRet: text
        recordNames: [text]
        # low: the lowering context (inline table, derive functions, and
        # the markTextAggs/deriveOrders/markOmits tables) env.low reads.
        low: LowCtx
        # privateStates: the @private state cells (checkNoPrivate).
        privateStates: [text]
        # ty / tsc: the program's typed names, and the action's typed
        # locals at the statement being lowered (exprtype.fct).
        ty: TyEnv
        tsc: TyScope

    # ALowAcc: the frame action()'s closures share — the lowered body of
    # the block in hand, the first error, the flag set the placement
    # switch reads, and the names in scope (`loc`). A proc cannot mutate
    # its caller's variables, so every step returns a fresh ALowAcc.
    struct ALowAcc:
        body: [IRStmt]
        err: text
        writes: [text]
        reads: [text]
        entWrite: bool
        impure: bool
        usesPrint: bool
        callsService: bool
        callsProc: bool
        establishesID: bool
        locals: [text]
        # seal: the parameters whose value flows straight into an @e2e field
        # (build.go's sealParams — the client encrypts them before POSTing).
        seal: [text]
        # usesSecret: touches an authentication secret (an authority-only
        # builtin or `sessionToken`); emits: puts an event on a stream.
        usesSecret: bool
        emits: bool
        # setsHeader: sets a response header (`header "Name" expr`).
        setsHeader: bool
        # tsc: the types of the action's parameters and locals so far —
        # build.go's actLocalTypes and locRecords, action-wide.
        tsc: TyScope

    private proc alowAccNew(locals: [text]) -> ALowAcc:
        return ALowAcc{body: [], err: "", writes: [], reads: [], entWrite: false, impure: false, usesPrint: false, callsService: false, callsProc: false, establishesID: false, locals: locals, seal: [], usesSecret: false, emits: false, setsHeader: false, tsc: tyEmptyScope()}

    # alowAccWith: the same flags, a different body and scope.
    private proc alowAccWith(a: ALowAcc, body: [IRStmt], locals: [text]) -> ALowAcc:
        return ALowAcc{body: body, err: a.err, writes: a.writes, reads: a.reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: locals, seal: a.seal, usesSecret: a.usesSecret, emits: a.emits, setsHeader: a.setsHeader, tsc: a.tsc}

    # alowTyped: a with `name` typed as `label` for the rest of the action
    # (build.go's actLocalTypes[name] = …).
    private proc alowTyped(a: ALowAcc, name: text, label: text) -> ALowAcc:
        let sc = do tyScopeWith(a.tsc, name, label)
        return ALowAcc{body: a.body, err: a.err, writes: a.writes, reads: a.reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: a.locals, seal: a.seal, usesSecret: a.usesSecret, emits: a.emits, setsHeader: a.setsHeader, tsc: sc}

    # alowRecordBound: a with `name` bound to a record (locRecords), when
    # ret is one.
    private proc alowRecordBound(a: ALowAcc, name: text, ret: text, retList: bool, env: ALowEnv) -> ALowAcc:
        if !(ret in env.recordNames):
            return a
        let mut l = ret
        if retList:
            l = "[" + ret + "]"
        let sc = TyScope{names: a.tsc.names, types: a.tsc.types, recNames: append(a.tsc.recNames, name), recTypes: append(a.tsc.recTypes, l)}
        return ALowAcc{body: a.body, err: a.err, writes: a.writes, reads: a.reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: a.locals, seal: a.seal, usesSecret: a.usesSecret, emits: a.emits, setsHeader: a.setsHeader, tsc: sc}

    # alowEnvScoped: env with the typed locals of the statement at hand.
    private proc alowEnvScoped(env: ALowEnv, tsc: TyScope) -> ALowEnv:
        return ALowEnv{stateNames: env.stateNames, statePlacements: env.statePlacements, entityNames: env.entityNames, entityFields: env.entityFields, entityDerives: env.entityDerives, enumNames: env.enumNames, policyNames: env.policyNames, policyParamCounts: env.policyParamCounts, inlineNames: env.inlineNames, inlineExprs: env.inlineExprs, serviceNames: env.serviceNames, serviceOps: env.serviceOps, serviceArgCounts: env.serviceArgCounts, serviceRets: env.serviceRets, serviceRetLists: env.serviceRetLists, procNames: env.procNames, procParamCounts: env.procParamCounts, procRets: env.procRets, procRetLists: env.procRetLists, structNames: env.structNames, renameFrom: env.renameFrom, renameTo: env.renameTo, e2eFields: env.e2eFields, actionParams: env.actionParams, wireTypes: env.wireTypes, actionName: env.actionName, actionRet: env.actionRet, recordNames: env.recordNames, low: env.low, privateStates: env.privateStates, ty: env.ty, tsc: tsc}

    private proc alowFail(a: ALowAcc, msg: text) -> ALowAcc:
        return ALowAcc{body: a.body, err: msg, writes: a.writes, reads: a.reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: a.locals, seal: a.seal, usesSecret: a.usesSecret, emits: a.emits, setsHeader: a.setsHeader, tsc: a.tsc}

    private proc alowEmit(a: ALowAcc, st: IRStmt) -> ALowAcc:
        let body = append(a.body, st)
        let out = do alowAccWith(a, body, a.locals)
        return out

    # alowFlags: one flag flipped on (the accumulating `x = true` writes).
    private proc alowFlags(a: ALowAcc, entWrite: bool, impure: bool, usesPrint: bool, callsService: bool, callsProc: bool, establishesID: bool) -> ALowAcc:
        return ALowAcc{body: a.body, err: a.err, writes: a.writes, reads: a.reads, entWrite: a.entWrite || entWrite, impure: a.impure || impure, usesPrint: a.usesPrint || usesPrint, callsService: a.callsService || callsService, callsProc: a.callsProc || callsProc, establishesID: a.establishesID || establishesID, locals: a.locals, seal: a.seal, usesSecret: a.usesSecret, emits: a.emits, setsHeader: a.setsHeader, tsc: a.tsc}

    private proc alowWithWrites(a: ALowAcc, writes: [text]) -> ALowAcc:
        return ALowAcc{body: a.body, err: a.err, writes: writes, reads: a.reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: a.locals, seal: a.seal, usesSecret: a.usesSecret, emits: a.emits, setsHeader: a.setsHeader, tsc: a.tsc}

    private proc alowWithReads(a: ALowAcc, reads: [text]) -> ALowAcc:
        return ALowAcc{body: a.body, err: a.err, writes: a.writes, reads: reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: a.locals, seal: a.seal, usesSecret: a.usesSecret, emits: a.emits, setsHeader: a.setsHeader, tsc: a.tsc}

    # ── name-set helpers (Go's map[string]bool) ─────────────────────────
    private proc alowAddName(names: [text], name: text) -> [text]:
        if name in names:
            return names
        return append(names, name)

    private proc alowMergeNames(a: [text], b: [text]) -> [text]:
        let n = len(b)
        let mut out = a
        let mut i = 0
        loop i < n:
            let merged = do alowAddName(out, b[i])
            out = merged
            i = i + 1
        return out

    # alowSortText: sortedKeys — an insertion sort over text (`>` compares
    # text lexicographically, as Go's sort.Strings does).
    proc alowSortText(names: [text]) -> [text]:
        let mut xs = names
        let n = len(xs)
        let mut i = 1
        loop i < n:
            let mut j = i
            loop j > 0:
                if xs[j - 1] > xs[j]:
                    let tmp = xs[j - 1]
                    xs[j - 1] = xs[j]
                    xs[j] = tmp
                    j = j - 1
                else:
                    break
            i = i + 1
        return xs

    private proc alowStatePlacement(name: text, env: ALowEnv) -> text:
        let at = do lowerFindName(env.stateNames, name)
        if at < 0:
            return ""
        return env.statePlacements[at]

    # alowWritesOnlyClientState: writesOnlyClientState — at least one
    # write, and every one lands in a @client cell.
    private proc alowWritesOnlyClientState(writes: [text], env: ALowEnv) -> bool:
        let n = len(writes)
        if n == 0:
            return false
        let mut i = 0
        loop i < n:
            let p = do alowStatePlacement(writes[i], env)
            if p != "client":
                return false
            i = i + 1
        return true

    # ── expression facts (the slice of check/checkPure placement needs) ──
    private proc alowIsBuiltinRef(n: text) -> bool:
        return n == "actor" || n == "role" || n == "verified" || n == "tenant" || n == "tenantRole" || n == "session"

    # alowHasCall: procCapabilities' walk restricted to "does any call node
    # name one of these" — hasImpure is [now, rand], hasPrint is [print].
    private proc alowHasCall(n: ExprNode, names: [text]) -> bool:
        if n.kind == "call":
            if n.text in names:
                return true
        let mut i = 0
        loop i < len(n.children):
            let viaChild = do alowHasCall(n.children[i], names)
            if viaChild:
                return true
            i = i + 1
        let mut j = 0
        loop j < len(n.pairs):
            let viaKey = do alowHasCall(n.pairs[j].key, names)
            if viaKey:
                return true
            let viaVal = do alowHasCall(n.pairs[j].value, names)
            if viaVal:
                return true
            j = j + 1
        let mut k = 0
        loop k < len(n.whereClause):
            let viaWhere = do alowHasCall(n.whereClause[k], names)
            if viaWhere:
                return true
            k = k + 1
        let mut m = 0
        loop m < len(n.sel):
            let viaSel = do alowHasCall(n.sel[m], names)
            if viaSel:
                return true
            m = m + 1
        return false

    private proc alowDropName(names: [text], name: text) -> [text]:
        let mut out = []
        let mut i = 0
        loop i < len(names):
            if names[i] != name:
                out = append(out, names[i])
            i = i + 1
        return out

    # alowFreeNames: build.go's freeNames — a ref's name, an entity
    # lookup's entity, an aggregate's collection plus its filter's and
    # reduced value's names minus the item variable, a struct literal's
    # field VALUES only (its keys are field names, not references), a map
    # literal's keys and values, and every other node's children.
    private proc alowFreeNames(n: ExprNode) -> [text]:
        if n.kind == "ref":
            return [n.text]
        if n.kind == "astate":
            return []
        let mut out = []
        if n.kind == "entityGet":
            out = append(out, n.text)
        if n.kind == "agg":
            out = append(out, n.coll)
            let mut k = 0
            loop k < len(n.whereClause):
                let whereNames = do alowFreeNames(n.whereClause[k])
                let whereKept = do alowDropName(whereNames, n.itemVar)
                let mergedWhere = do alowMergeNames(out, whereKept)
                out = mergedWhere
                k = k + 1
            let mut m = 0
            loop m < len(n.sel):
                let selNames = do alowFreeNames(n.sel[m])
                let selKept = do alowDropName(selNames, n.itemVar)
                let mergedSel = do alowMergeNames(out, selKept)
                out = mergedSel
                m = m + 1
            return out
        let mut i = 0
        loop i < len(n.children):
            let childNames = do alowFreeNames(n.children[i])
            let mergedChild = do alowMergeNames(out, childNames)
            out = mergedChild
            i = i + 1
        let mut j = 0
        loop j < len(n.pairs):
            if n.kind != "struct":
                let keyNames = do alowFreeNames(n.pairs[j].key)
                let mergedKey = do alowMergeNames(out, keyNames)
                out = mergedKey
            let valNames = do alowFreeNames(n.pairs[j].value)
            let mergedVal = do alowMergeNames(out, valNames)
            out = mergedVal
            j = j + 1
        return out

    # alowResolves: (e *env) resolves — locals/builtin, state, entity,
    # enum, inline, in that order.
    private proc alowResolves(name: text, locals: [text], env: ALowEnv) -> bool:
        if name in locals:
            return true
        let builtin = do alowIsBuiltinRef(name)
        if builtin:
            return true
        if name in env.stateNames:
            return true
        if name in env.entityNames:
            return true
        if name in env.enumNames:
            return true
        return name in env.inlineNames

    # alowCheckDiag: the "unknown reference" half of e.check ("" = ok).
    private proc alowCheckDiag(n: ExprNode, locals: [text], env: ALowEnv) -> text:
        # check(): the structural stages, then every name resolved, then the
        # literal text rule.
        let mut fnNames = []
        let mut fnArities = []
        let nf = len(env.low.fns)
        let mut fi = 0
        loop fi < nf:
            fnNames = append(fnNames, env.low.fns[fi].name)
            fnArities = append(fnArities, len(env.low.fns[fi].params))
            fi = fi + 1
        let ce = CallEnv{fnNames: fnNames, fnArities: fnArities, procNames: env.procNames, procArities: env.procParamCounts, procDerives: [], listNames: [], jsonNames: [], deriveKeys: env.entityDerives, inAction: true, inDerive: false, inProc: false, ty: env.ty, tsc: env.tsc}
        let sd = do exprStructureDiag(n, env.entityNames, env.entityFields, ce)
        if sd != "":
            return sd
        let gn = do allNodes(n)
        let ngn = len(gn)
        let mut gi = 0
        loop gi < ngn:
            if gn[gi].kind == "call" && gn[gi].text == "given" && len(gn[gi].children) == 1:
                let pn = gn[gi].children[0].text
                if !(pn in env.actionParams):
                    return "given(" + pn + "): \"" + pn + "\" is not a parameter of this action"
            gi = gi + 1
        let rd = do alowRefDiag(n, locals, env)
        if rd != "":
            return rd
        let nodes = do allNodes(n)
        let ld = do checkLiteralExpr(nodes, locals, env.stateNames, env.entityNames, env.enumNames, env.inlineNames)
        return ld

    private proc alowRefDiag(n: ExprNode, locals: [text], env: ALowEnv) -> text:
        let names = do alowFreeNames(n)
        let mut i = 0
        loop i < len(names):
            let ok = do alowResolves(names[i], locals, env)
            if !ok:
                return "unknown reference \"" + names[i] + "\""
            i = i + 1
        return ""

    # alowCheckPureDiag: checkPure — check, then no now/rand, no print.
    private proc alowCheckPureDiag(n: ExprNode, locals: [text], env: ALowEnv, ctx: text) -> text:
        let r = do alowCheckPureDiagIn(n, locals, env, ctx, false)
        return r

    # alowCheckPureDiagIn: checkPureIn — `secrets` says whether this
    # position (an action's `check`) may call an authority-only builtin.
    private proc alowCheckPureDiagIn(n: ExprNode, locals: [text], env: ALowEnv, ctx: text, secrets: bool) -> text:
        let d = do alowCheckDiag(n, locals, env)
        if d != "":
            return d
        if !secrets:
            let names = ["verifyPassword", "totpSecret", "totpValid", "randomToken", "fileDigest", "ed25519Verify", "ecdsaP256Verify", "sha256Hex", "canonicalJson", "shuffleOrder"]
            let nn = len(names)
            let mut i = 0
            loop i < nn:
                let hc = do alowHasCall(n, [names[i]])
                if hc:
                    return ctx + " cannot call " + names[i] + "(...); it handles an authentication secret and runs only on the authority. Call it from an action body instead"
                i = i + 1
        let impure = do alowHasCall(n, ["now", "rand", "randomBytes"])
        if impure:
            return ctx + " cannot use an effectful builtin (now/rand); it must be pure so it can run on any client. Compute it in an action instead"
        let prints = do alowHasCall(n, ["print"])
        if prints:
            return ctx + " cannot call print(...); it is a server-only debugging aid with no client implementation. Call it from an action body or a proc instead"
        return ""

    # alowStateDeps: e.depsIR over the LOWERED expression, filtered to
    # state names (the only deps action() keeps: `if _, isState :=
    # e.states[n]`). Walks exactly the kinds depsIR walks — ref, get,
    # eget, astate (dirty/touched name the cell itself), agg (its filter),
    # call/list args, bin, un — and, like Go, not index/map/struct.
    private proc alowStateDeps(e: IRExpr, env: ALowEnv) -> [text]:
        if e.kind == "ref":
            if e.name in env.stateNames:
                return [e.name]
            return []
        if e.kind == "get":
            if len(e.obj) > 0:
                let viaObj = do alowStateDeps(e.obj[0], env)
                return viaObj
            return []
        if e.kind == "eget":
            if len(e.key) > 0:
                let viaKey = do alowStateDeps(e.key[0], env)
                return viaKey
            return []
        if e.kind == "astate":
            if e.op == "dirty" || e.op == "touched":
                if e.name in env.stateNames:
                    return [e.name]
            return []
        if e.kind == "agg":
            let mut aout = []
            if len(e.where) > 0:
                let viaWhere = do alowStateDeps(e.where[0], env)
                aout = viaWhere
            if len(e.sel) > 0:
                let viaSel = do alowStateDeps(e.sel[0], env)
                let m1 = do alowMergeNames(aout, viaSel)
                aout = m1
            if len(e.limit) > 0:
                let viaLim = do alowStateDeps(e.limit[0], env)
                let m2 = do alowMergeNames(aout, viaLim)
                aout = m2
            return aout
        if e.kind == "call" || e.kind == "list" || e.kind == "struct":
            let mut out = []
            let mut i = 0
            loop i < len(e.args):
                let viaArg = do alowStateDeps(e.args[i], env)
                let merged = do alowMergeNames(out, viaArg)
                out = merged
                i = i + 1
            return out
        if e.kind == "bin":
            let mut out = []
            if len(e.l) > 0:
                let viaL = do alowStateDeps(e.l[0], env)
                out = viaL
            if len(e.r) > 0:
                let viaR = do alowStateDeps(e.r[0], env)
                let merged = do alowMergeNames(out, viaR)
                out = merged
            return out
        if e.kind == "un":
            if len(e.x) > 0:
                let viaX = do alowStateDeps(e.x[0], env)
                return viaX
            return []
        return []

    private proc alowLow(n: ExprNode, env: ALowEnv) -> IRExpr:
        let e = do lowFull(n, env.low)
        return e

    # alowReadDeps: record the state cells a lowered expression reads.
    private proc alowReadDeps(a: ALowAcc, e: IRExpr, env: ALowEnv) -> ALowAcc:
        let deps = do alowStateDeps(e, env)
        let reads = do alowMergeNames(a.reads, deps)
        let out = do alowWithReads(a, reads)
        return out

    # alowReadExpr: readExprIn — check the expression in `locals`, flip
    # impure/usesPrint, record its state reads.
    private proc alowReadExpr(a: ALowAcc, n: ExprNode, locals: [text], env: ALowEnv) -> ALowAcc:
        let d = do alowCheckDiag(n, locals, env)
        if d != "":
            let failed = do alowFail(a, d)
            return failed
        let impure = do alowHasCall(n, ["now", "rand", "randomBytes"])
        let prints = do alowHasCall(n, ["print"])
        let flagged0 = do alowFlags(a, false, impure, prints, false, false, false)
        let sec = do alowHandlesSecret(n)
        let mut flagged = flagged0
        if sec:
            let fs = do alowMarkSecret(flagged0)
            flagged = fs
        let low = do alowLow(n, env)
        let out = do alowReadDeps(flagged, low, env)
        return out

    # alowBindLocal: bindLocal — fresh, not a state cell, not an entity;
    # then in scope for the rest of this block.
    private proc alowBindLocal(a: ALowAcc, name: text, what: text, env: ALowEnv) -> ALowAcc:
        if name in a.locals:
            let f1 = do alowFail(a, "\"" + name + "\" is already in scope — pick another name for " + what)
            return f1
        if name in env.stateNames:
            let f2 = do alowFail(a, what + " \"" + name + "\" would shadow the state cell of the same name — pick another name")
            return f2
        if name in env.entityNames:
            let f3 = do alowFail(a, what + " \"" + name + "\" would shadow the entity of the same name — pick another name")
            return f3
        let locals = append(a.locals, name)
        let out = do alowAccWith(a, a.body, locals)
        return out

    private proc alowEntityHasField(entity: text, field: text, env: ALowEnv) -> bool:
        return (entity + "." + field) in env.entityFields

    private proc alowEntityHasDerive(entity: text, field: text, env: ALowEnv) -> bool:
        return (entity + "." + field) in env.entityDerives

    private proc alowDeriveDiag(entity: text, field: text, inAdd: bool) -> text:
        let base = "entity \"" + entity + "\"'s \"" + field + "\" is a derive, not a stored field — it is computed from the row's own other fields on every read and cannot be set"
        if inAdd:
            return base + " in `add`"
        return base

    # alowServiceOpIndex: the op's row in the per-op service tables, -1 when
    # the service has no such op; alowServiceKnown says whether the service
    # itself is declared at all.
    private proc alowServiceKnown(service: text, env: ALowEnv) -> bool:
        return service in env.serviceNames

    private proc alowServiceOpIndex(service: text, op: text, env: ALowEnv) -> int:
        let n = len(env.serviceNames)
        let mut i = 0
        loop i < n:
            if env.serviceNames[i] == service && env.serviceOps[i] == op:
                return i
            i = i + 1
        return -1

    # ── the statement kinds ─────────────────────────────────────────────
    private proc alowCheck(a0: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let d = do alowCheckPureDiagIn(s.cond, a0.locals, env, "a check", true)
        if d != "":
            let failed = do alowFail(a0, d)
            return failed
        let sec = do alowHandlesSecret(s.cond)
        let mut a = a0
        if sec:
            let a1 = do alowMarkSecret(a0)
            a = a1
        let cond = do alowLow(s.cond, env)
        let msg = do lowerUnquote(s.msg)
        let st0 = do irCheck(cond, msg)
        # an interpolating message (`"No league named {league}."`) is read,
        # in the action's scope, when the check fails
        let mut key = []
        if contains(msg, "{"):
            let mx = do alowMsgExpr(msg)
            if mx.err != "":
                let fm = do alowFail(a, mx.err)
                return fm
            let rm = do alowReadExpr(a, mx.node, a.locals, env)
            if rm.err != "":
                return rm
            a = rm
            let km = do alowLow(mx.node, env)
            key = [km]
        let st = IRStmt{op: st0.op, target: s.target, entity: "", field: "", key: key, value: st0.value, fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: st0.msg, status: s.status, body: [], elseBody: [], bytesFlag: false, file: "", path: ""}
        let out = do alowEmit(a, st)
        return out

    # alowMsgExpr: parseCheck's MsgExpr — the message's segments
    # (parseTextBody) folded left into `"" + seg + …`.
    struct AlowMsg:
        err: text
        node: ExprNode

    private proc alowEndOfInterp(cs: [text], i: int) -> int:
        let n = len(cs)
        let mut depth = 0
        let mut j = i
        loop j < n:
            let c = cs[j]
            if c == "\\":
                j = j + 1
            else:
                if c == "{":
                    depth = depth + 1
                else:
                    if c == "}":
                        depth = depth - 1
                        if depth == 0:
                            return j
                    else:
                        if c == "\"":
                            let mut k = j + 1
                            let mut closed = -1
                            loop k < n && closed < 0:
                                if cs[k] == "\\":
                                    k = k + 1
                                else:
                                    if cs[k] == "\"":
                                        closed = k
                                k = k + 1
                            if closed < 0:
                                return -1
                            j = closed
            j = j + 1
        return -1

    private proc alowMsgExpr(msg: text) -> AlowMsg:
        let cs = split(msg, "")
        let n = len(cs)
        let mut x = do textLitNode("\"\"")
        let mut lit = ""
        let mut i = 0
        loop i < n:
            if cs[i] == "{":
                let end = do alowEndOfInterp(cs, i)
                if end < 0:
                    let e0 = do emptyNode()
                    return AlowMsg{err: "unterminated `{` in text", node: e0}
                if lit != "":
                    let q = do goQuote(lit)
                    let ln = do textLitNode(q)
                    let b0 = do binNode("+", x, ln)
                    x = b0
                    lit = ""
                let inner = slice(msg, i + 1, end)
                let perr = do epParseError(inner)
                if perr != "":
                    let e1 = do emptyNode()
                    return AlowMsg{err: perr, node: e1}
                let ex = do parseExprTree(inner)
                let b1 = do binNode("+", x, ex)
                x = b1
                i = end + 1
                continue
            lit = lit + cs[i]
            i = i + 1
        if lit != "":
            let q2 = do goQuote(lit)
            let ln2 = do textLitNode(q2)
            let b2 = do binNode("+", x, ln2)
            x = b2
        return AlowMsg{err: "", node: x}

    # alowExprCallsProc / alowStmtsCallProc: stmtsCallProc — any call of a
    # proc name, in any expression a statement carries, at any depth.
    private proc alowExprCallsProc(x: IRExpr, procs: [text]) -> bool:
        if x.kind == "call" && (x.name in procs):
            return true
        let kids = [x.l, x.r, x.x, x.obj, x.key, x.where, x.sel, x.limit, x.keys, x.args]
        let nk = len(kids)
        let mut k = 0
        loop k < nk:
            let hit = do alowExprsCallProc(kids[k], procs)
            if hit:
                return true
            k = k + 1
        return false

    private proc alowExprsCallProc(xs: [IRExpr], procs: [text]) -> bool:
        let n = len(xs)
        let mut i = 0
        loop i < n:
            let h = do alowExprCallsProc(xs[i], procs)
            if h:
                return true
            i = i + 1
        return false

    private proc alowStmtsCallProc(body: [IRStmt], procs: [text]) -> bool:
        let n = len(body)
        let mut i = 0
        loop i < n:
            let st = body[i]
            let parts = [st.value, st.key, st.where, st.limit, st.role, st.args, st.fieldExprs]
            let np = len(parts)
            let mut p = 0
            loop p < np:
                let h = do alowExprsCallProc(parts[p], procs)
                if h:
                    return true
                p = p + 1
            let hb = do alowStmtsCallProc(st.body, procs)
            if hb:
                return true
            let he = do alowStmtsCallProc(st.elseBody, procs)
            if he:
                return true
            i = i + 1
        return false

    # alowServerOnlyBuiltins: every builtin internal/parser/builtins.go does
    # not mark SiteEverywhere — the ones the browser has no mirror of.
    private proc alowServerOnlyBuiltins() -> [text]:
        return ["print", "given", "floatBits", "floatFromBits", "verifyPassword", "totpSecret", "totpValid", "randomToken", "fileDigest", "ed25519Verify", "ecdsaP256Verify", "sha256Hex", "canonicalJson", "shuffleOrder", "u64Cmp", "u64Min", "u64Max", "u64SatSub", "u64Div", "u64Rem", "u64Text", "u64Parse", "u64ParseError", "u64ToFloat", "fromLocal", "formatIn", "zoneValid", "append", "bytes", "textToBytes", "bytesToText", "aesGcmSeal", "aesGcmOpen", "aesGcmAuthentic", "randomBytes", "readFile", "writeFile", "appendFile", "fileExists", "truncateFile", "fileSize", "readFileAt", "writeFileAt", "syncFile", "renameFile", "removeFile", "httpGet", "httpPost", "listen", "listenOn", "accept", "connect", "connectTls", "readBytes", "writeBytes", "closeConn", "setTimeoutMs", "connError", "pollBytes", "connOpen", "shutdownConn", "closeListener", "listenError", "grantRead", "writeStdout", "writeStderr", "readStdin", "envVar", "envSet", "channel", "send", "recv", "sleepMs", "monoMs", "nowMs", "signals", "awaitAny", "closeChannel", "exitProcess", "processStats", "listenTls", "connPeer"]

    # alowExprFirstCall / alowStmtsFirstCall: build.go's stmtsCall — the
    # first call (same walk order) whose name is in names, or "".
    private proc alowExprFirstCall(x: IRExpr, names: [text]) -> text:
        if x.kind == "call" && (x.name in names):
            return x.name
        let kids = [x.l, x.r, x.x, x.obj, x.key, x.where, x.sel, x.limit, x.keys, x.args]
        let nk = len(kids)
        let mut k = 0
        loop k < nk:
            let hit = do alowExprsFirstCall(kids[k], names)
            if hit != "":
                return hit
            k = k + 1
        return ""

    private proc alowExprsFirstCall(xs: [IRExpr], names: [text]) -> text:
        let n = len(xs)
        let mut i = 0
        loop i < n:
            let h = do alowExprFirstCall(xs[i], names)
            if h != "":
                return h
            i = i + 1
        return ""

    private proc alowStmtsFirstCall(body: [IRStmt], names: [text]) -> text:
        let n = len(body)
        let mut i = 0
        loop i < n:
            let st = body[i]
            let parts = [st.value, st.key, st.where, st.limit, st.role, st.args, st.fieldExprs]
            let np = len(parts)
            let mut p = 0
            loop p < np:
                let h = do alowExprsFirstCall(parts[p], names)
                if h != "":
                    return h
                p = p + 1
            let hb = do alowStmtsFirstCall(st.body, names)
            if hb != "":
                return hb
            let he = do alowStmtsFirstCall(st.elseBody, names)
            if he != "":
                return he
            i = i + 1
        return ""

    # alowHandlesSecret: handlesSecret — an authority-only builtin call
    # (verifyPassword/totpSecret/totpValid/randomToken/fileDigest) or a read of the
    # `sessionToken` credential.
    private proc alowHandlesSecret(n: ExprNode) -> bool:
        let hc = do alowHasCall(n, ["verifyPassword", "totpSecret", "totpValid", "randomToken", "fileDigest", "ed25519Verify", "ecdsaP256Verify", "sha256Hex", "canonicalJson", "shuffleOrder"])
        if hc:
            return true
        let names = do alowFreeNames(n)
        return "sessionToken" in names

    private proc alowMarkSecret(a: ALowAcc) -> ALowAcc:
        return ALowAcc{body: a.body, err: a.err, writes: a.writes, reads: a.reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: a.locals, seal: a.seal, usesSecret: true, emits: a.emits, setsHeader: a.setsHeader, tsc: a.tsc}

    private proc alowMarkEmits(a: ALowAcc) -> ALowAcc:
        return ALowAcc{body: a.body, err: a.err, writes: a.writes, reads: a.reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: a.locals, seal: a.seal, usesSecret: a.usesSecret, emits: true, setsHeader: a.setsHeader, tsc: a.tsc}

    # alowReturn / alowEmitStmt / alowRevoke: build.go's Return, Emit and
    # Revoke arms.
    private proc alowReturn(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        if !s.hasValue:
            if env.actionRet != "":
                let f1 = do alowFail(a, "action \"" + env.actionName + "\" returns " + env.actionRet + ", so `return` needs a value")
                return f1
            let st0 = do irStmt("return")
            let o0 = do alowEmit(a, st0)
            return o0
        if env.actionRet == "":
            let f2 = do alowFail(a, "action \"" + env.actionName + "\" declares no return type (`action " + env.actionName + "(...) -> Type:`), so `return` cannot carry a value")
            return f2
        let read = do alowReadExpr(a, s.value, a.locals, env)
        if read.err != "":
            return read
        let v = do alowLow(s.value, env)
        let st = IRStmt{op: "return", target: "", entity: "", field: "", key: [], value: [v], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: "", status: s.status, body: [], elseBody: [], bytesFlag: false, file: "", path: ""}
        let out = do alowEmit(read, st)
        return out

    # alowEmitType: the wire type an emit's payload has — a wire-type
    # literal's own, or a projection's: a parameterized derive declared
    # to return one (not a list of one). "" when it is neither.
    private proc alowEmitType(v: ExprNode, env: ALowEnv) -> text:
        if v.kind == "struct":
            if v.text in env.wireTypes:
                return v.text
            return ""
        if v.kind == "call":
            let at = do lowerFindFn(env.low, v.text)
            if at >= 0 && len(env.low.fns[at].params) == len(v.children):
                let rt = env.low.fns[at].ret
                if rt in env.wireTypes:
                    return rt
        return ""

    private proc alowEmitStmt(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let typ = do alowEmitType(s.value, env)
        if typ == "":
            let f1 = do alowFail(a, "emit takes a wire type value: emit EventType{field: value, …} or a projection returning one")
            return f1
        let read = do alowReadExpr(a, s.value, a.locals, env)
        if read.err != "":
            return read
        let v = do alowLow(s.value, env)
        let mut acc = read
        let mut key = []
        if s.hasTo:
            let rt = do alowReadExpr(acc, s.key, acc.locals, env)
            if rt.err != "":
                return rt
            acc = rt
            let k = do alowLow(s.key, env)
            key = [k]
        let mut onArgs = []
        let no = len(s.callArgs)
        let mut oi = 0
        loop oi < no:
            let ro = do alowReadExpr(acc, s.callArgs[oi], acc.locals, env)
            if ro.err != "":
                return ro
            acc = ro
            let ol = do alowLow(s.callArgs[oi], env)
            onArgs = append(onArgs, ol)
            oi = oi + 1
        let marked = do alowMarkEmits(acc)
        let st = IRStmt{op: "emit", target: s.event, entity: "", field: typ, key: key, value: [v], fieldNames: [], fieldExprs: [], service: "", args: onArgs, itemVar: "", where: [], order: "", desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: false, file: "", path: ""}
        let out = do alowEmit(marked, st)
        return out

    # alowRestate: `restate actor A role R` — an identity change, so the
    # authority's (establishesID), both expressions ordinary reads.
    private proc alowRestate(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let flagged = do alowFlags(a, false, false, false, false, false, true)
        let ra = do alowReadExpr(flagged, s.actor, flagged.locals, env)
        if ra.err != "":
            return ra
        let rr = do alowReadExpr(ra, s.role, ra.locals, env)
        if rr.err != "":
            return rr
        let who = do alowLow(s.actor, env)
        let role = do alowLow(s.role, env)
        let st = IRStmt{op: "restate", target: "", entity: "", field: "", key: [], value: [who], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", desc: false, limit: [], bind: "", ret: "", retList: false, role: [role], msg: "", status: 0, body: [], elseBody: [], bytesFlag: false, file: "", path: ""}
        let out = do alowEmit(rr, st)
        return out

    # alowHeaderName: checkActionHeaderName — an RFC 9110 token the
    # runtime does not own; "" when it is fine.
    private proc alowHeaderName(name: text) -> text:
        if name == "":
            return "header needs a name: header \"HX-Redirect\" expr"
        let ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!#$%&'*+-.^_`|~"
        let cs = split(name, "")
        let n = len(cs)
        let mut i = 0
        loop i < n:
            if !contains(ok, cs[i]):
                let q = do goQuote(name)
                return "header name " + q + " is not an HTTP token (letters, digits, and !#$%&'*+-.^_`|~ only)"
            i = i + 1
        let canon = do alowCanonicalHeader(name)
        let owned = ["Set-Cookie", "Cookie", "X-Session-Token", "Content-Type", "Content-Length", "Content-Encoding", "Content-Disposition", "Content-Range", "Accept-Ranges", "Transfer-Encoding", "Connection", "Keep-Alive", "Upgrade", "Trailer", "Te", "Host", "Date", "Server", "Location", "Authorization", "Www-Authenticate", "Cache-Control", "Etag", "Last-Modified", "Vary", "Expires", "Pragma", "Age", "Retry-After", "Strict-Transport-Security", "Content-Security-Policy", "X-Content-Type-Options", "X-Frame-Options", "Referrer-Policy", "Permissions-Policy", "Allow", "Alt-Svc"]
        let mut isOwned = canon in owned
        let prefixes = ["Access-Control-", "X-Ratelimit-", "Proxy-", "Cross-Origin-", "Sec-"]
        let mut p = 0
        loop p < 5:
            let pl = len(prefixes[p])
            if len(canon) >= pl && slice(canon, 0, pl) == prefixes[p]:
                isOwned = true
            p = p + 1
        if isOwned:
            let cq = do goQuote(canon)
            return "header " + cq + " is written by the runtime itself (session, framing, caching, rate limits or security policy) — an action cannot set it"
        return ""

    # alowCanonicalHeader: textproto.CanonicalMIMEHeaderKey for a valid
    # token — the first letter and each letter after a '-' upper-cased,
    # the rest lower-cased.
    private proc alowCanonicalHeader(name: text) -> text:
        let cs = split(name, "")
        let n = len(cs)
        let mut out = ""
        let mut upperNext = true
        let mut i = 0
        loop i < n:
            let c = cs[i]
            if upperNext:
                out = out + upper(c)
            else:
                out = out + lower(c)
            upperNext = c == "-"
            i = i + 1
        return out

    # alowHeader: `header "Name" expr` — a response header on the reply:
    # the authority's (setsHeader), never a @private value.
    private proc alowHeader(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let hd = do alowHeaderName(s.field)
        if hd != "":
            let f0 = do alowFail(a, hd)
            return f0
        let rv = do alowReadExpr(a, s.value, a.locals, env)
        if rv.err != "":
            return rv
        let v = do alowLow(s.value, env)
        let deps = do alowStateDeps(v, env)
        let nd = len(deps)
        let mut di = 0
        loop di < nd:
            if deps[di] in env.privateStates:
                let f1 = do alowFail(rv, "a response header is sent to the caller, so it cannot carry a @private value")
                return f1
            di = di + 1
        let canon = do alowCanonicalHeader(s.field)
        let marked = ALowAcc{body: rv.body, err: rv.err, writes: rv.writes, reads: rv.reads, entWrite: rv.entWrite, impure: rv.impure, usesPrint: rv.usesPrint, callsService: rv.callsService, callsProc: rv.callsProc, establishesID: rv.establishesID, locals: rv.locals, seal: rv.seal, usesSecret: rv.usesSecret, emits: rv.emits, setsHeader: true, tsc: tyEmptyScope()}
        let st = IRStmt{op: "header", target: "", entity: "", field: "", key: [], value: [v], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: canon, status: 0, body: [], elseBody: [], bytesFlag: false, file: "", path: ""}
        let out = do alowEmit(marked, st)
        return out

    private proc alowRevoke(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let flagged = do alowFlags(a, false, false, false, false, false, true)
        let read = do alowReadExpr(flagged, s.value, flagged.locals, env)
        if read.err != "":
            return read
        let v = do alowLow(s.value, env)
        let st = IRStmt{op: "revoke", target: "", entity: "", field: "", key: [], value: [v], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: false, file: "", path: ""}
        let out = do alowEmit(read, st)
        return out

    private proc alowAssign(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let known = s.target in env.stateNames
        if !known:
            let failed = do alowFail(a, "assignment to unknown state \"" + s.target + "\"")
            return failed
        let read = do alowReadExpr(a, s.value, a.locals, env)
        if read.err != "":
            return read
        let writes = do alowAddName(read.writes, s.target)
        let wrote = do alowWithWrites(read, writes)
        let value = do alowLow(s.value, env)
        let st = do irAssign(s.target, value)
        let out = do alowEmit(wrote, st)
        return out

    # alowE2EWrite: build.go's e2eWrite — an @e2e field may only be written
    # straight from an action parameter (the value the client seals); that
    # parameter joins the seal set. Returns the acc (err set on refusal);
    # alowIsE2E says whether the field is sealed at all.
    private proc alowIsE2E(entity: text, field: text, env: ALowEnv) -> bool:
        return (entity + "." + field) in env.e2eFields

    private proc alowE2EWrite(a: ALowAcc, entity: text, field: text, val: ExprNode, env: ALowEnv) -> ALowAcc:
        if val.kind != "ref":
            let f1 = do alowFail(a, "@e2e field " + entity + "." + field + " must be written straight from an action parameter (the value the client seals); an expression here would be computed by the authority in plaintext")
            return f1
        if !(val.text in env.actionParams):
            let f2 = do alowFail(a, "@e2e field " + entity + "." + field + " must be written from an action parameter; \"" + val.text + "\" is not one (only a parameter can be sealed on the client before sending)")
            return f2
        let seal = do alowAddName(a.seal, val.text)
        return ALowAcc{body: a.body, err: a.err, writes: a.writes, reads: a.reads, entWrite: a.entWrite, impure: a.impure, usesPrint: a.usesPrint, callsService: a.callsService, callsProc: a.callsProc, establishesID: a.establishesID, locals: a.locals, seal: seal, usesSecret: a.usesSecret, emits: a.emits, setsHeader: a.setsHeader, tsc: a.tsc}

    private proc alowAdd(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let known = s.entity in env.entityNames
        if !known:
            let failed = do alowFail(a, "add to unknown entity \"" + s.entity + "\"")
            return failed
        let flagged = do alowFlags(a, true, false, false, false, false, false)
        let mut acc = flagged
        let mut exprs = []
        let n = len(s.fieldNames)
        let mut i = 0
        loop i < n:
            let isDerive = do alowEntityHasDerive(s.entity, s.fieldNames[i], env)
            if isDerive:
                let dd = do alowDeriveDiag(s.entity, s.fieldNames[i], true)
                let failedD = do alowFail(acc, dd)
                return failedD
            let sealed = do alowIsE2E(s.entity, s.fieldNames[i], env)
            if sealed:
                # opaque ciphertext to the authority: carried, never read.
                let sw = do alowE2EWrite(acc, s.entity, s.fieldNames[i], s.fieldValues[i], env)
                if sw.err != "":
                    return sw
                acc = sw
            else:
                let read = do alowReadExpr(acc, s.fieldValues[i], acc.locals, env)
                if read.err != "":
                    return read
                acc = read
            let low = do alowLow(s.fieldValues[i], env)
            exprs = append(exprs, low)
            i = i + 1
        if s.bindName != "":
            let bound = do alowBindLocal(acc, s.bindName, "the new row's id", env)
            if bound.err != "":
                return bound
            acc = bound
        let st = do irAdd(s.entity, s.fieldNames, exprs, s.bindName)
        let out = do alowEmit(acc, st)
        return out

    private proc alowSetWhere(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let wl = do alowAddName(a.locals, s.itemVar)
        let d = do alowCheckPureDiag(s.cond, wl, env, "a `set … where` filter")
        if d != "":
            let failed = do alowFail(a, d)
            return failed
        let lw = do alowLow(s.cond, env)
        let readW = do alowReadDeps(a, lw, env)
        let mut acc = readW
        let mut exprs = []
        let n = len(s.fieldNames)
        let mut i = 0
        loop i < n:
            let isDerive = do alowEntityHasDerive(s.entity, s.fieldNames[i], env)
            if isDerive:
                let dd = do alowDeriveDiag(s.entity, s.fieldNames[i], false)
                let failedD = do alowFail(acc, dd)
                return failedD
            let hasField = do alowEntityHasField(s.entity, s.fieldNames[i], env)
            if !hasField:
                let failedF = do alowFail(acc, "entity \"" + s.entity + "\" has no field \"" + s.fieldNames[i] + "\" to set")
                return failedF
            let read = do alowReadExpr(acc, s.fieldValues[i], wl, env)
            if read.err != "":
                return read
            acc = read
            let low = do alowLow(s.fieldValues[i], env)
            exprs = append(exprs, low)
            i = i + 1
        let st = do irSetWhere(s.entity, s.itemVar, lw, s.fieldNames, exprs)
        let out = do alowEmit(acc, st)
        return out

    private proc alowSet(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let known = s.entity in env.entityNames
        if !known:
            let failed = do alowFail(a, "set on unknown entity \"" + s.entity + "\"")
            return failed
        let flagged = do alowFlags(a, true, false, false, false, false, false)
        if s.kind == "setWhere":
            let viaWhere = do alowSetWhere(flagged, s, env)
            return viaWhere
        let isDerive = do alowEntityHasDerive(s.entity, s.field, env)
        if isDerive:
            let dd = do alowDeriveDiag(s.entity, s.field, false)
            let failedD = do alowFail(flagged, dd)
            return failedD
        let readK = do alowReadExpr(flagged, s.key, flagged.locals, env)
        if readK.err != "":
            return readK
        let mut readV = readK
        let sealed = do alowIsE2E(s.entity, s.field, env)
        if sealed:
            let sw = do alowE2EWrite(readK, s.entity, s.field, s.value, env)
            if sw.err != "":
                return sw
            readV = sw
        else:
            let rv = do alowReadExpr(readK, s.value, readK.locals, env)
            if rv.err != "":
                return rv
            readV = rv
        let key = do alowLow(s.key, env)
        let value = do alowLow(s.value, env)
        let st = do irSet(s.entity, key, s.field, value)
        let out = do alowEmit(readV, st)
        return out

    private proc alowRemove(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let known = s.entity in env.entityNames
        if !known:
            let failed = do alowFail(a, "remove on unknown entity \"" + s.entity + "\"")
            return failed
        let flagged = do alowFlags(a, true, false, false, false, false, false)
        if s.kind == "removeWhere":
            let wl = do alowAddName(flagged.locals, s.itemVar)
            let d = do alowCheckPureDiag(s.cond, wl, env, "a `remove … where` filter")
            if d != "":
                let failedW = do alowFail(flagged, d)
                return failedW
            let lw = do alowLow(s.cond, env)
            let readW = do alowReadDeps(flagged, lw, env)
            let stW = do irRemoveWhere(s.entity, s.itemVar, lw)
            let outW = do alowEmit(readW, stW)
            return outW
        let readK = do alowReadExpr(flagged, s.key, flagged.locals, env)
        if readK.err != "":
            return readK
        let key = do alowLow(s.key, env)
        let st = do irRemove(s.entity, key)
        let out = do alowEmit(readK, st)
        return out

    private proc alowClear(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let known = s.entity in env.entityNames
        if !known:
            let failed = do alowFail(a, "clear on unknown entity \"" + s.entity + "\"")
            return failed
        let flagged = do alowFlags(a, true, false, false, false, false, false)
        let st = do irClear(s.entity)
        let out = do alowEmit(flagged, st)
        return out

    private proc alowArgs(a: ALowAcc, args: [ExprNode], env: ALowEnv) -> ALowAcc:
        let mut acc = a
        let mut i = 0
        loop i < len(args):
            let read = do alowReadExpr(acc, args[i], acc.locals, env)
            if read.err != "":
                return read
            acc = read
            i = i + 1
        return acc

    private proc alowLowList(args: [ExprNode], env: ALowEnv) -> [IRExpr]:
        let mut out = []
        let n = len(args)
        let mut i = 0
        loop i < n:
            let e = do lowFull(args[i], env.low)
            out = append(out, e)
            i = i + 1
        return out

    private proc alowCall(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let svcKnown = do alowServiceKnown(s.serviceName, env)
        if !svcKnown:
            let f1 = do alowFail(a, "call to unknown service \"" + s.serviceName + "\"")
            return f1
        let at = do alowServiceOpIndex(s.serviceName, s.opName, env)
        if at < 0:
            let f2 = do alowFail(a, "service \"" + s.serviceName + "\" has no operation \"" + s.opName + "\"")
            return f2
        let argc = env.serviceArgCounts[at]
        if len(s.callArgs) != argc:
            let f3 = do alowFail(a, s.serviceName + "." + s.opName + " expects " + argc + " argument(s), got " + len(s.callArgs))
            return f3
        let flagged = do alowFlags(a, false, false, false, true, false, false)
        let readArgs = do alowArgs(flagged, s.callArgs, env)
        if readArgs.err != "":
            return readArgs
        let mut acc = readArgs
        let mut ret = ""
        let mut retList = false
        if s.bindName != "":
            if env.serviceRets[at] == "":
                let f4 = do alowFail(acc, s.serviceName + "." + s.opName + " returns nothing — declare a return type (`" + s.opName + "(…) -> Type`) to bind it")
                return f4
            let bound = do alowBindLocal(acc, s.bindName, "the bound result", env)
            if bound.err != "":
                return bound
            ret = env.serviceRets[at]
            retList = env.serviceRetLists[at]
            acc = do alowRecordBound(bound, s.bindName, ret, retList, env)
        let args = do alowLowList(s.callArgs, env)
        let st = do irCallStmt(s.serviceName, s.opName, args, s.bindName, ret, retList)
        let out = do alowEmit(acc, st)
        return out

    # alowRenamed: the statement with its `do` target run through the
    # file's private-proc rename table (manglePrivate's rewriteProcCalls).
    private proc alowRenamed(s: ActionStmt, env: ALowEnv) -> ActionStmt:
        let at = do lowerFindName(env.renameFrom, s.procName)
        if at < 0:
            return s
        let name = env.renameTo[at]
        return ActionStmt{kind: s.kind, lineIdx: s.lineIdx, cond: s.cond, msg: s.msg, policyName: s.policyName, policyArgs: s.policyArgs, entity: s.entity, key: s.key, field: s.field, value: s.value, itemVar: s.itemVar, fieldNames: s.fieldNames, fieldValues: s.fieldValues, serviceName: s.serviceName, opName: s.opName, callArgs: s.callArgs, procName: name, bindName: s.bindName, actor: s.actor, hasRole: s.hasRole, role: s.role, target: s.target, exprCall: s.exprCall, orderField: s.orderField, orderDesc: s.orderDesc, limit: s.limit, hasLimit: s.hasLimit, body: s.body, elseBody: s.elseBody, valid: s.valid, status: s.status, hasValue: s.hasValue, event: s.event, hasTo: s.hasTo}

    private proc alowDo(a: ALowAcc, s0: ActionStmt, env: ALowEnv) -> ALowAcc:
        let s = do alowRenamed(s0, env)
        let at = do lowerFindName(env.procNames, s.procName)
        if at < 0:
            let f1 = do alowFail(a, "do calls unknown proc \"" + s.procName + "\"")
            return f1
        let argc = env.procParamCounts[at]
        if len(s.callArgs) != argc:
            let f2 = do alowFail(a, "proc \"" + s.procName + "\" expects " + argc + " argument(s), got " + len(s.callArgs))
            return f2
        let flagged = do alowFlags(a, false, false, false, false, true, false)
        let readArgs = do alowArgs(flagged, s.callArgs, env)
        if readArgs.err != "":
            return readArgs
        let mut acc = readArgs
        let mut ret = ""
        let mut retList = false
        if s.bindName != "":
            let sigRet = env.procRets[at]
            if sigRet == "":
                let f3 = do alowFail(acc, "proc \"" + s.procName + "\" returns nothing — declare a return type (`proc " + s.procName + "(...) -> Type`) to bind it")
                return f3
            if sigRet in env.structNames:
                let f5 = do alowFail(acc, "proc \"" + s.procName + "\" returns " + sigRet + ", a struct type usable only inside another proc — an action cannot bind it (structs are proc-local values, with no schema/wire representation yet; see LANGUAGE.md's `proc` section). Read its fields inside the proc and give \"" + s.procName + "\" a scalar/list return type instead")
                return f5
            let bound = do alowBindLocal(acc, s.bindName, "the bound result", env)
            if bound.err != "":
                return bound
            ret = sigRet
            retList = env.procRetLists[at]
            acc = do alowRecordBound(bound, s.bindName, ret, retList, env)
        let args = do alowLowList(s.callArgs, env)
        let st = do irDo(s.procName, args, s.bindName, ret, retList)
        let out = do alowEmit(acc, st)
        return out

    private proc alowEstablish(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let flagged = do alowFlags(a, false, false, false, false, false, true)
        let readA = do alowReadExpr(flagged, s.actor, flagged.locals, env)
        if readA.err != "":
            return readA
        let actor = do alowLow(s.actor, env)
        let mut acc = readA
        let mut role = []
        if s.hasRole:
            let readR = do alowReadExpr(acc, s.role, acc.locals, env)
            if readR.err != "":
                return readR
            acc = readR
            let r = do alowLow(s.role, env)
            role = [r]
        let st = do irEstablish(actor, role)
        let out = do alowEmit(acc, st)
        return out

    private proc alowExprStmt(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let read = do alowReadExpr(a, s.exprCall, a.locals, env)
        if read.err != "":
            return read
        let call = do alowLow(s.exprCall, env)
        let st = do irExprStmt(call)
        let out = do alowEmit(read, st)
        return out

    private proc alowLet(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let read = do alowReadExpr(a, s.value, a.locals, env)
        if read.err != "":
            return read
        let bound = do alowBindLocal(read, s.target, "the local", env)
        if bound.err != "":
            return bound
        let value = do alowLow(s.value, env)
        let st = do irLet(s.target, value)
        let vt = do tyExpr(env.ty, s.value, env.tsc)
        let vl = do tyLabel(vt)
        let typed = do alowTyped(bound, s.target, vl)
        let out = do alowEmit(typed, st)
        return out

    private proc alowIf(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let read = do alowReadExpr(a, s.cond, a.locals, env)
        if read.err != "":
            return read
        let outerBody = read.body
        let outerLocals = read.locals
        let thenIn = do alowAccWith(read, [], outerLocals)
        let thenOut = do alowBlock(s.body, thenIn, env)
        if thenOut.err != "":
            return thenOut
        let mut els = []
        let mut acc = thenOut
        if len(s.elseBody) > 0:
            let elseIn = do alowAccWith(thenOut, [], outerLocals)
            let elseOut = do alowBlock(s.elseBody, elseIn, env)
            if elseOut.err != "":
                return elseOut
            els = elseOut.body
            acc = elseOut
        let cond = do alowLow(s.cond, env)
        let st = do irIf(cond, thenOut.body, els)
        let body = append(outerBody, st)
        let out = do alowAccWith(acc, body, outerLocals)
        return out

    private proc alowFor(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        let known = s.entity in env.entityNames
        if !known && (s.entity in a.locals):
            # `for x in names:` over a list-valued local or parameter — each
            # element in order, the body run once per element.
            let hasWhere0 = s.cond.kind != "int" || s.cond.text != "0"
            if hasWhere0 || s.orderField != "" || s.hasLimit:
                let fl = do alowFail(a, "`for " + s.itemVar + " in " + s.entity + "` walks a list value; where/by/limit filter an entity's rows — shape the list before the loop")
                return fl
            let outer0 = a.body
            let outerLoc0 = a.locals
            let sc0 = do alowAccWith(a, a.body, outerLoc0)
            let b0 = do alowBindLocal(sc0, s.itemVar, "the loop variable", env)
            if b0.err != "":
                return b0
            let mut b1 = b0
            let ct = do tyLookup(a.tsc.names, a.tsc.types, s.entity)
            let cv = do tyParse(ct)
            if cv.list:
                b1 = do alowTyped(b0, s.itemVar, cv.core)
            let bin0 = do alowAccWith(b1, [], b1.locals)
            let bout0 = do alowBlock(s.body, bin0, env)
            if bout0.err != "":
                return bout0
            let collRef = do irRef(s.entity)
            let fe0 = do irStmt("foreach")
            let fe = IRStmt{op: "foreach", target: fe0.target, entity: fe0.entity, field: fe0.field, key: fe0.key, value: [collRef], fieldNames: fe0.fieldNames, fieldExprs: fe0.fieldExprs, service: fe0.service, args: fe0.args, itemVar: s.itemVar, where: fe0.where, order: fe0.order, desc: fe0.desc, limit: fe0.limit, bind: fe0.bind, ret: fe0.ret, retList: fe0.retList, role: fe0.role, msg: fe0.msg, status: fe0.status, body: bout0.body, elseBody: fe0.elseBody, bytesFlag: fe0.bytesFlag, file: fe0.file, path: fe0.path}
            let fbody = append(outer0, fe)
            let fout = do alowAccWith(bout0, fbody, outerLoc0)
            return fout
        if !known:
            let f1 = do alowFail(a, "`for` in an action walks an entity's rows or a list-valued local; \"" + s.entity + "\" is not an entity or a local")
            return f1
        let outerBody = a.body
        let outerLocals = a.locals
        let scoped = do alowAccWith(a, a.body, outerLocals)
        let bound = do alowBindLocal(scoped, s.itemVar, "the loop variable", env)
        if bound.err != "":
            return bound
        let wl = bound.locals
        let mut acc = bound
        let mut where = []
        let hasWhere = s.cond.kind != "int" || s.cond.text != "0"
        if hasWhere:
            let d = do alowCheckPureDiag(s.cond, wl, env, "a `for … where` filter")
            if d != "":
                let f2 = do alowFail(acc, d)
                return f2
            let lw = do alowLow(s.cond, env)
            where = [lw]
            let readW = do alowReadDeps(acc, lw, env)
            acc = readW
        if s.orderField != "":
            let hasField = do alowEntityHasField(s.entity, s.orderField, env)
            if !hasField && s.orderField != "id":
                let f3 = do alowFail(acc, "entity \"" + s.entity + "\" has no field \"" + s.orderField + "\" to order by")
                return f3
        let mut limit = []
        if s.hasLimit:
            let readL = do alowReadExpr(acc, s.limit, outerLocals, env)
            if readL.err != "":
                return readL
            acc = readL
            let ll = do alowLow(s.limit, env)
            limit = [ll]
        let bodyIn = do alowAccWith(acc, [], wl)
        let bodyOut = do alowBlock(s.body, bodyIn, env)
        if bodyOut.err != "":
            return bodyOut
        let st = do irFor(s.entity, s.itemVar, where, s.orderField, s.orderDesc, limit, bodyOut.body)
        let body = append(outerBody, st)
        let out = do alowAccWith(bodyOut, body, outerLocals)
        return out

    # alowStmt: block's type switch, one statement.
    private proc alowStmt(a: ALowAcc, s: ActionStmt, env: ALowEnv) -> ALowAcc:
        if !s.valid:
            let fu = do alowFail(a, "unsupported statement in action \"" + env.actionName + "\" at body line " + (s.lineIdx + 1) + " (outside the self-hosted action grammar)")
            return fu
        if s.kind == "check":
            let r = do alowCheck(a, s, env)
            return r
        if s.kind == "assign":
            let r = do alowAssign(a, s, env)
            return r
        if s.kind == "add" || s.kind == "letAdd":
            let r = do alowAdd(a, s, env)
            return r
        if s.kind == "set" || s.kind == "setWhere":
            let r = do alowSet(a, s, env)
            return r
        if s.kind == "remove" || s.kind == "removeWhere":
            let r = do alowRemove(a, s, env)
            return r
        if s.kind == "clear":
            let r = do alowClear(a, s, env)
            return r
        if s.kind == "call" || s.kind == "letCall":
            let r = do alowCall(a, s, env)
            return r
        if s.kind == "do" || s.kind == "letDo":
            let r = do alowDo(a, s, env)
            return r
        if s.kind == "establish":
            let r = do alowEstablish(a, s, env)
            return r
        if s.kind == "return":
            let r = do alowReturn(a, s, env)
            return r
        if s.kind == "emit":
            let r = do alowEmitStmt(a, s, env)
            return r
        if s.kind == "revoke":
            let r = do alowRevoke(a, s, env)
            return r
        if s.kind == "restate":
            let r = do alowRestate(a, s, env)
            return r
        if s.kind == "header":
            let r = do alowHeader(a, s, env)
            return r
        if s.kind == "exprStmt":
            let r = do alowExprStmt(a, s, env)
            return r
        if s.kind == "let":
            let r = do alowLet(a, s, env)
            return r
        if s.kind == "if":
            let r = do alowIf(a, s, env)
            return r
        if s.kind == "for":
            let r = do alowFor(a, s, env)
            return r
        let f = do alowFail(a, "unsupported statement kind \"" + s.kind + "\"")
        return f

    # alowBlock: block — one statement list against the scope in
    # `a.locals`; a `let`/bind widens the scope for the statements after
    # it in this block only (the caller restores its own scope).
    proc alowBlock(stmts: [ActionStmt], a: ALowAcc, env: ALowEnv) -> ALowAcc:
        let mut acc = a
        let n = len(stmts)
        let mut i = 0
        loop i < n:
            let senv = do alowEnvScoped(env, acc.tsc)
            let next = do alowStmt(acc, stmts[i], senv)
            if next.err != "":
                return next
            acc = next
            i = i + 1
        return acc

    # ── the action ──────────────────────────────────────────────────────
    # alowSealUses: the @e2e dataflow guarantee's second walk — every name
    # read anywhere the authority evaluates (a check, a let, an assignment,
    # a non-sealed field, a key, a filter, a call's arguments, an identity),
    # at any depth, exactly the statement parts build.go's collect visits.
    private proc alowCollect(acc: [text], n: ExprNode) -> [text]:
        let names = do alowFreeNames(n)
        let merged = do alowMergeNames(acc, names)
        return merged

    private proc alowCollectAll(acc: [text], ns: [ExprNode]) -> [text]:
        let mut out = acc
        let n = len(ns)
        let mut i = 0
        loop i < n:
            let c = do alowCollect(out, ns[i])
            out = c
            i = i + 1
        return out

    private proc alowSealUses(stmts: [ActionStmt], env: ALowEnv, acc0: [text]) -> [text]:
        let mut acc = acc0
        let n = len(stmts)
        let mut i = 0
        loop i < n:
            let s = stmts[i]
            let k = s.kind
            if k == "check" || k == "if" || k == "removeWhere":
                let a1 = do alowCollect(acc, s.cond)
                acc = a1
            if k == "let" || k == "assign":
                let a2 = do alowCollect(acc, s.value)
                acc = a2
            if k == "add" || k == "letAdd":
                let nf = len(s.fieldNames)
                let mut fi = 0
                loop fi < nf:
                    let sealed = do alowIsE2E(s.entity, s.fieldNames[fi], env)
                    if !sealed:
                        let a3 = do alowCollect(acc, s.fieldValues[fi])
                        acc = a3
                    fi = fi + 1
            if k == "set":
                let a4 = do alowCollect(acc, s.key)
                acc = a4
                let sealed2 = do alowIsE2E(s.entity, s.field, env)
                if !sealed2:
                    let a5 = do alowCollect(acc, s.value)
                    acc = a5
            if k == "setWhere":
                let a6 = do alowCollect(acc, s.cond)
                let a7 = do alowCollectAll(a6, s.fieldValues)
                acc = a7
            if k == "remove":
                let a8 = do alowCollect(acc, s.key)
                acc = a8
            if k == "call" || k == "letCall" || k == "do" || k == "letDo":
                let a9 = do alowCollectAll(acc, s.callArgs)
                acc = a9
            if k == "establish":
                let a10 = do alowCollect(acc, s.actor)
                acc = a10
                if s.hasRole:
                    let a11 = do alowCollect(acc, s.role)
                    acc = a11
            if k == "exprStmt":
                let a12 = do alowCollect(acc, s.exprCall)
                acc = a12
            if k == "for":
                let a13 = do alowCollect(acc, s.cond)
                acc = a13
                if s.hasLimit:
                    let a14 = do alowCollect(acc, s.limit)
                    acc = a14
            if k == "if" || k == "for":
                let b1 = do alowSealUses(s.body, env, acc)
                let b2 = do alowSealUses(s.elseBody, env, b1)
                acc = b2
            i = i + 1
        return acc

    private proc alowFailedAction(msg: text) -> IRAction:
        return IRAction{name: "", params: [], requires: [], optimistic: false, ret: "", retList: false, placement: "", reason: msg, writes: [], reads: [], seal: [], body: []}

    # lowerActionSrc: action(), end to end. `paramTypes[i]` is the declared
    # type of `paramNames[i]`; `bodySrc` is the action's dedented body
    # (including its `requires` lines).
    proc lowerActionSrc(name: text, paramNames: [text], paramTypes: [text], optimistic: bool, bodySrc: text, env: ALowEnv) -> IRAction:
        let mut lists = []
        let mut opts = []
        let n0 = len(paramNames)
        let mut k = 0
        loop k < n0:
            lists = append(lists, false)
            opts = append(opts, false)
            k = k + 1
        let r = do lowerActionSrcFull(name, paramNames, paramTypes, lists, opts, optimistic, "", false, bodySrc, env)
        return r

    proc alowIsScalarType(t: text, env: ALowEnv) -> bool:
        if t == "int" || t == "text" || t == "bool" || t == "money" || t == "date" || t == "float" || t == "datetime":
            return true
        return t in env.enumNames

    # lowerActionSrcFull: action() with the whole header — list/optional
    # parameters and the `-> Type` reply.
    proc lowerActionSrcFull(name: text, paramNames: [text], paramTypes: [text], paramLists: [bool], paramOptionals: [bool], optimistic: bool, ret: text, retList: bool, bodySrc: text, env0: ALowEnv) -> IRAction:
        if ret != "":
            if ret in env0.structNames:
                let fs = do alowFailedAction("action \"" + name + "\" returns " + ret + ", a proc-only type with no wire form — return a primitive, an entity row, or a wire `type`")
                return fs
            if ret == "bytes" && retList:
                let fb = do alowFailedAction("action \"" + name + "\" returns [bytes] — a reply carries one file")
                return fb
            let scalar = do alowIsScalarType(ret, env0)
            let known = ret == "bytes" || scalar || (ret in env0.entityNames) || (ret in env0.wireTypes) || (ret in env0.recordNames)
            if !known:
                let fu = do alowFailedAction("action \"" + name + "\" returns unknown type \"" + ret + "\"")
                return fu
        let mut psc = do tyEmptyScope()
        let npn = len(paramNames)
        let mut pti = 0
        loop pti < npn:
            let mut pl = paramTypes[pti]
            if paramLists[pti]:
                pl = "[" + pl + "]"
            psc = do tyScopeWith(psc, paramNames[pti], pl)
            pti = pti + 1
        let env = ALowEnv{stateNames: env0.stateNames, statePlacements: env0.statePlacements, entityNames: env0.entityNames, entityFields: env0.entityFields, entityDerives: env0.entityDerives, enumNames: env0.enumNames, policyNames: env0.policyNames, policyParamCounts: env0.policyParamCounts, inlineNames: env0.inlineNames, inlineExprs: env0.inlineExprs, serviceNames: env0.serviceNames, serviceOps: env0.serviceOps, serviceArgCounts: env0.serviceArgCounts, serviceRets: env0.serviceRets, serviceRetLists: env0.serviceRetLists, procNames: env0.procNames, procParamCounts: env0.procParamCounts, procRets: env0.procRets, procRetLists: env0.procRetLists, structNames: env0.structNames, renameFrom: env0.renameFrom, renameTo: env0.renameTo, e2eFields: env0.e2eFields, actionParams: env0.actionParams, wireTypes: env0.wireTypes, actionName: name, actionRet: ret, recordNames: env0.recordNames, low: env0.low, privateStates: env0.privateStates, ty: env0.ty, tsc: psc}
        let mut params = []
        let mut loc = ["actor", "role", "verified", "tenant", "tenantRole", "session", "sessionToken"]
        let pn = len(paramNames)
        let mut i = 0
        loop i < pn:
            if paramLists[i]:
                let sc = do alowIsScalarType(paramTypes[i], env)
                if !sc:
                    let fl = do alowFailedAction("action \"" + name + "\" parameter \"" + paramNames[i] + "\" is a list of " + paramTypes[i] + " — a list parameter holds scalars (int, text, bool, money, date, float, datetime or an enum), the values a client sends as a JSON array or a comma-separated query")
                    return fl
            params = append(params, IRParam{name: paramNames[i], type: paramTypes[i], optional: paramOptionals[i], list: paramLists[i]})
            loc = append(loc, paramNames[i])
            i = i + 1
        let stmts = do parseActionBodySrc(bodySrc)
        let reqStmts = do actionRequiresOnly(stmts)
        let bodyStmts = do actionBodyOnly(stmts)
        # requires: a known policy, the right arity, pure arguments.
        let mut reqs = []
        let rn = len(reqStmts)
        let mut r = 0
        loop r < rn:
            let rs = reqStmts[r]
            if !rs.valid:
                let fu = do alowFailedAction("unsupported requires clause (outside the self-hosted action grammar)")
                return fu
            let pat = do lowerFindName(env.policyNames, rs.policyName)
            if pat < 0:
                let isInline = rs.policyName in env.inlineNames
                if isInline:
                    let fd = do alowFailedAction("requires \"" + rs.policyName + "\", which is a derive, not a policy")
                    return fd
                let fp = do alowFailedAction("requires unknown policy \"" + rs.policyName + "\"")
                return fp
            let want = env.policyParamCounts[pat]
            if len(rs.policyArgs) != want:
                let fa = do alowFailedAction("policy \"" + rs.policyName + "\" takes " + want + " argument(s), got " + len(rs.policyArgs))
                return fa
            let mut args = []
            let an = len(rs.policyArgs)
            let mut j = 0
            loop j < an:
                let d = do alowCheckPureDiag(rs.policyArgs[j], loc, env, "a requires argument")
                if d != "":
                    let fc = do alowFailedAction(d)
                    return fc
                let low = do alowLow(rs.policyArgs[j], env)
                args = append(args, low)
                j = j + 1
            reqs = append(reqs, IRRequire{name: rs.policyName, args: args})
            r = r + 1
        # the body (with this action's parameters known, for e2eWrite)
        let benv = ALowEnv{stateNames: env.stateNames, statePlacements: env.statePlacements, entityNames: env.entityNames, entityFields: env.entityFields, entityDerives: env.entityDerives, enumNames: env.enumNames, policyNames: env.policyNames, policyParamCounts: env.policyParamCounts, inlineNames: env.inlineNames, inlineExprs: env.inlineExprs, serviceNames: env.serviceNames, serviceOps: env.serviceOps, serviceArgCounts: env.serviceArgCounts, serviceRets: env.serviceRets, serviceRetLists: env.serviceRetLists, procNames: env.procNames, procParamCounts: env.procParamCounts, procRets: env.procRets, procRetLists: env.procRetLists, structNames: env.structNames, renameFrom: env.renameFrom, renameTo: env.renameTo, e2eFields: env.e2eFields, actionParams: paramNames, wireTypes: env.wireTypes, actionName: env.actionName, actionRet: env.actionRet, recordNames: env.recordNames, low: env.low, privateStates: env.privateStates, ty: env.ty, tsc: env.tsc}
        let accNew = do alowAccNew(loc)
        let acc0 = ALowAcc{body: accNew.body, err: accNew.err, writes: accNew.writes, reads: accNew.reads, entWrite: accNew.entWrite, impure: accNew.impure, usesPrint: accNew.usesPrint, callsService: accNew.callsService, callsProc: accNew.callsProc, establishesID: accNew.establishesID, locals: accNew.locals, seal: accNew.seal, usesSecret: accNew.usesSecret, emits: accNew.emits, setsHeader: accNew.setsHeader, tsc: psc}
        let acc = do alowBlock(bodyStmts, acc0, benv)
        if acc.err != "":
            let fb = do alowFailedAction(acc.err)
            return fb
        # @e2e: a sealed parameter is ciphertext to the authority, so it may
        # appear nowhere else the server evaluates.
        let mut seal = []
        if len(acc.seal) > 0:
            let used0 = do alowSealUses(bodyStmts, benv, [])
            let mut used = used0
            let nr = len(reqStmts)
            let mut ri = 0
            loop ri < nr:
                let u = do alowCollectAll(used, reqStmts[ri].policyArgs)
                used = u
                ri = ri + 1
            let sorted = do alowSortText(acc.seal)
            let ns = len(sorted)
            let mut si = 0
            loop si < ns:
                if sorted[si] in used:
                    let fs = do alowFailedAction("parameter \"" + sorted[si] + "\" seals into an @e2e field, so the authority only ever holds its ciphertext — it cannot also be read elsewhere in \"" + name + "\" (a check, policy, or another write all run on the server). Validate it on the client or model the readable part as a separate parameter")
                    return fs
                si = si + 1
            seal = sorted
        let writes = do alowSortText(acc.writes)
        let reads = do alowSortText(acc.reads)
        # placement: server iff it writes any authoritative cell OR is
        # impure — with the @client-only exception (see build.go).
        let onlyClient = do alowWritesOnlyClientState(writes, env)
        # stmtsCallProc: a proc called inside any expression (a `list()`
        # shaping rows through one) runs on the authority just as `do` does.
        let mut callsProc = acc.callsProc
        if !callsProc:
            let cp = do alowStmtsCallProc(acc.body, env.procNames)
            callsProc = cp
        let mut placement = "client"
        let mut reason = "only touches @client state, so it runs in the browser with no round-trip"
        let mut decided = false
        if acc.entWrite:
            placement = "server"
            reason = "writes durable entity data — the authority owns the database"
            decided = true
        if !decided && acc.usesPrint:
            placement = "server"
            reason = "calls print(...) — a server-only debugging aid with no client implementation; the authority is the only process with log output to write it to"
            decided = true
        if !decided && acc.usesSecret:
            placement = "server"
            reason = "handles an authentication secret or a stored file (verifyPassword/totpSecret/totpValid/randomToken/sessionToken/fileDigest) — only the authority holds it"
            decided = true
        if !decided && acc.impure && !onlyClient:
            placement = "server"
            reason = "uses an effectful builtin (now/rand) — the authority owns nondeterminism, so every client sees one agreed result"
            decided = true
        if !decided && acc.callsService:
            placement = "server"
            reason = "calls an external service — egress routes through the authority, never the client"
            decided = true
        if !decided && callsProc:
            placement = "server"
            reason = "calls a `proc`, which is unconditionally server-executed — no client mirror of proc code exists"
            decided = true
        if !decided && acc.establishesID:
            placement = "server"
            reason = "establishes the session identity — only the authority may set who you are"
            decided = true
        if !decided && acc.setsHeader:
            placement = "server"
            reason = "sets a response header — only the authority answers the HTTP request"
            decided = true
        if !decided && ret != "":
            placement = "server"
            reason = "returns a value — the authority computes the reply"
            decided = true
        if !decided && acc.emits:
            placement = "server"
            reason = "emits a stream event — only the authority holds the subscribers"
            decided = true
        if placement == "client":
            let wn = len(writes)
            let mut w = 0
            loop w < wn:
                let p = do alowStatePlacement(writes[w], env)
                if p == "server":
                    placement = "server"
                    reason = "writes authoritative state \"" + writes[w] + "\" — only the authority may change it"
                    break
                w = w + 1
        if placement == "client":
            # a builtin the browser does not implement pins the action to the
            # authority — last, so any other reason is reported first.
            let sob = do alowServerOnlyBuiltins()
            let sb = do alowStmtsFirstCall(acc.body, sob)
            if sb != "":
                placement = "server"
                reason = "calls " + sb + "(...), which only the authority implements — the browser has no mirror of it"
        if placement == "server":
            let rdn = len(reads)
            let mut k = 0
            loop k < rdn:
                let p = do alowStatePlacement(reads[k], env)
                if p == "client":
                    let fr = do alowFailedAction("action \"" + name + "\" runs on the server (it writes authoritative state or uses an effectful builtin) but reads client-only state \"" + reads[k] + "\"; the authority cannot see ephemeral client state")
                    return fr
                k = k + 1
            let wrn = len(writes)
            let mut m = 0
            loop m < wrn:
                let p = do alowStatePlacement(writes[m], env)
                if p == "client":
                    let fw = do alowFailedAction("action \"" + name + "\" runs on the server but writes client-only state \"" + writes[m] + "\"; the authority cannot reach ephemeral client state")
                    return fw
                m = m + 1
        if len(reqs) > 0 && placement != "server":
            let fg = do alowFailedAction("action \"" + name + "\" has `requires` but is client-placed; only authoritative (server) actions can be gated")
            return fg
        # `optimistic` is accepted (it is ast.Action's flag) but NOT copied
        # into the result: the real action() starts from `Action{Name:
        # a.Name}` and nothing in build.go ever sets ir.Action.Optimistic,
        # so `@optimistic` is dropped on the floor there — mirrored here so
        # the JSON stays byte for byte the compiler's.
        let dropped = optimistic && false
        return IRAction{name: name, params: params, requires: reqs, optimistic: dropped, ret: ret, retList: retList, placement: placement, reason: reason, writes: writes, reads: reads, seal: seal, body: acc.body}

    proc lowerActionJSON(name: text, paramNames: [text], paramTypes: [text], optimistic: bool, bodySrc: text, env: ALowEnv) -> text:
        let a = do lowerActionSrc(name, paramNames, paramTypes, optimistic, bodySrc, env)
        let j = do irActionJSON(a)
        return j

    # ── text-list environment (the HTTP driver's wire shape) ────────────
    # An action cannot take a list parameter, so every table arrives as
    # one newline-separated text, each line colon-separated:
    #   paramLines      name:type
    #   stateLines      name:placement
    #   entityLines     Entity
    #   fieldLines      Entity.field
    #   deriveLines     Entity.derive
    #   enumLines       Enum
    #   policyLines     name:paramCount
    #   inlineNameLines name            (index-parallel to inlineJSONLines)
    #   inlineJSONLines the real compiler's lowered ir.Expr JSON, one per
    #                   line (json.Marshal never emits a newline)
    #   serviceLines    Service.op:argCount:ret:retList
    #   procLines       name:paramCount:ret:retList
    #   structLines     Struct
    private proc alowField(line: text, i: int) -> text:
        let parts = split(line, ":")
        if i < len(parts):
            return parts[i]
        return ""

    proc alowEnvFromLines(stateLines: text, entityLines: text, fieldLines: text, deriveLines: text, enumLines: text, policyLines: text, inlineNameLines: text, inlineJSONLines: text, serviceLines: text, procLines: text, structLines: text) -> ALowEnv:
        let states = do lowerSplitLines(stateLines)
        let mut stateNames = []
        let mut statePlacements = []
        let mut i = 0
        loop i < len(states):
            let n = do alowField(states[i], 0)
            let p = do alowField(states[i], 1)
            stateNames = append(stateNames, n)
            statePlacements = append(statePlacements, p)
            i = i + 1
        let entityNames = do lowerSplitLines(entityLines)
        let entityFields = do lowerSplitLines(fieldLines)
        let entityDerives = do lowerSplitLines(deriveLines)
        let enumNames = do lowerSplitLines(enumLines)
        let policies = do lowerSplitLines(policyLines)
        let mut policyNames = []
        let mut policyParamCounts = []
        let mut j = 0
        loop j < len(policies):
            let n = do alowField(policies[j], 0)
            let c = do alowField(policies[j], 1)
            policyNames = append(policyNames, n)
            policyParamCounts = append(policyParamCounts, toInt(c))
            j = j + 1
        let inlineNames = do lowerSplitLines(inlineNameLines)
        let inlineJSON = do lowerSplitLines(inlineJSONLines)
        let mut inlineExprs = []
        let mut k = 0
        loop k < len(inlineJSON):
            let e = do irExprFromJSON(inlineJSON[k])
            inlineExprs = append(inlineExprs, e)
            k = k + 1
        let services = do lowerSplitLines(serviceLines)
        let mut serviceNames = []
        let mut serviceOps = []
        let mut serviceArgCounts = []
        let mut serviceRets = []
        let mut serviceRetLists = []
        let mut s = 0
        loop s < len(services):
            let svcOp = do alowField(services[s], 0)
            let dot = split(svcOp, ".")
            let argc = do alowField(services[s], 1)
            let ret = do alowField(services[s], 2)
            let rl = do alowField(services[s], 3)
            serviceNames = append(serviceNames, dot[0])
            serviceOps = append(serviceOps, dot[1])
            serviceArgCounts = append(serviceArgCounts, toInt(argc))
            serviceRets = append(serviceRets, ret)
            serviceRetLists = append(serviceRetLists, rl == "true")
            s = s + 1
        let procs = do lowerSplitLines(procLines)
        let mut procNames = []
        let mut procParamCounts = []
        let mut procRets = []
        let mut procRetLists = []
        let mut q = 0
        loop q < len(procs):
            let n = do alowField(procs[q], 0)
            let c = do alowField(procs[q], 1)
            let ret = do alowField(procs[q], 2)
            let rl = do alowField(procs[q], 3)
            procNames = append(procNames, n)
            procParamCounts = append(procParamCounts, toInt(c))
            procRets = append(procRets, ret)
            procRetLists = append(procRetLists, rl == "true")
            q = q + 1
        let structNames = do lowerSplitLines(structLines)
        let lowBasicCtx = do lowCtxBasic(inlineNames, inlineExprs, enumNames)
        return ALowEnv{stateNames: stateNames, statePlacements: statePlacements, entityNames: entityNames, entityFields: entityFields, entityDerives: entityDerives, enumNames: enumNames, policyNames: policyNames, policyParamCounts: policyParamCounts, inlineNames: inlineNames, inlineExprs: inlineExprs, serviceNames: serviceNames, serviceOps: serviceOps, serviceArgCounts: serviceArgCounts, serviceRets: serviceRets, serviceRetLists: serviceRetLists, procNames: procNames, procParamCounts: procParamCounts, procRets: procRets, procRetLists: procRetLists, structNames: structNames, renameFrom: [], renameTo: [], e2eFields: [], actionParams: [], wireTypes: [], actionName: "", actionRet: "", recordNames: [], low: lowBasicCtx, privateStates: [], ty: tyEmptyEnv(), tsc: tyEmptyScope()}

    proc lowerActionLinesJSON(name: text, paramLines: text, optimistic: bool, bodySrc: text, stateLines: text, entityLines: text, fieldLines: text, deriveLines: text, enumLines: text, policyLines: text, inlineNameLines: text, inlineJSONLines: text, serviceLines: text, procLines: text, structLines: text) -> text:
        let params = do lowerSplitLines(paramLines)
        let mut paramNames = []
        let mut paramTypes = []
        let mut i = 0
        loop i < len(params):
            let n = do alowField(params[i], 0)
            let t = do alowField(params[i], 1)
            paramNames = append(paramNames, n)
            paramTypes = append(paramTypes, t)
            i = i + 1
        let env = do alowEnvFromLines(stateLines, entityLines, fieldLines, deriveLines, enumLines, policyLines, inlineNameLines, inlineJSONLines, serviceLines, procLines, structLines)
        let j = do lowerActionJSON(name, paramNames, paramTypes, optimistic, bodySrc, env)
        return j

    state actionLowerResult: text = ""

    # runLowerAction: POST {"args": [name, paramLines, optimistic, bodySrc,
    # stateLines, entityLines, fieldLines, deriveLines, enumLines,
    # policyLines, inlineNameLines, inlineJSONLines, serviceLines,
    # procLines, structLines]} -> actionLowerResult is the action's IR JSON
    # (or, for a compile error, an action with placement "" and the
    # diagnostic in `reason`).
    action runLowerAction(name: text, paramLines: text, optimistic: bool, bodySrc: text, stateLines: text, entityLines: text, fieldLines: text, deriveLines: text, enumLines: text, policyLines: text, inlineNameLines: text, inlineJSONLines: text, serviceLines: text, procLines: text, structLines: text):
        let j = do lowerActionLinesJSON(name, paramLines, optimistic, bodySrc, stateLines, entityLines, fieldLines, deriveLines, enumLines, policyLines, inlineNameLines, inlineJSONLines, serviceLines, procLines, structLines)
        actionLowerResult = j

    private view ActionLowerHome at "/action_lower":
        box:
            text "{actionLowerResult}"
