import "expr_tokens.fct"

app ExprTreeSelfHost:
    # expr_tree.fct — the self-hosted port of internal/parser/expr.go's
    # parser: parseBinary's precedence climbing over binPrec (`||` 1, `&&`
    # 2, `|` 3, `^` 4, `&` 5, comparisons and `in` 6, shifts 7, `+ -` 8,
    # `* / %` 9), parseUnary, parsePostfix (struct literals, aggregates,
    # pending/failed/dirty/touched, calls — a builtin or any lowercase name
    # — entity lookups, `.field` and `[index]`), parseAgg (count/sum/
    # exists/avg/min/max/list with `x in Coll`, a reduced value, `where`,
    # and list's `by … [desc|asc]` and `limit`), parseAtom (numbers,
    # strings, true/false, `asset from "…"`, parentheses, list and map
    # literals) — over expr_tokens.fct's token arrays.
    #
    # Every step returns an EP: the node, the token position after it, and
    # the parser's error ("" on success) — expr.go's `(ast.Expr, error)`
    # plus the position its receiver carries. orNodes/orEnd/argListNodes
    # are the entry points the rest of selfhost calls; an error surfaces as
    # orEnd returning -1 (never the token count) and orNodes returning the
    # emptyNode filler.
    struct EP:
        node: ExprNode
        pos: int
        err: text

    proc epFail(pos: int, msg: text) -> EP:
        let e = do emptyNode()
        return EP{node: e, pos: pos, err: msg}

    proc epOk(node: ExprNode, pos: int) -> EP:
        return EP{node: node, pos: pos, err: ""}

    proc epKind(kinds: [text], pos: int) -> text:
        if pos < len(kinds):
            return kinds[pos]
        return "eof"

    proc epText(texts: [text], pos: int) -> text:
        if pos < len(texts):
            return texts[pos]
        return ""

    proc epIsOp(kinds: [text], texts: [text], pos: int, op: text) -> bool:
        if pos < len(kinds):
            return kinds[pos] == "op" && texts[pos] == op
        return false

    proc epIsIdent(kinds: [text], texts: [text], pos: int, w: text) -> bool:
        if pos < len(kinds):
            return kinds[pos] == "ident" && texts[pos] == w
        return false

    proc epPrec(op: text) -> int:
        if op == "||":
            return 1
        if op == "&&":
            return 2
        if op == "|":
            return 3
        if op == "^":
            return 4
        if op == "&":
            return 5
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "in":
            return 6
        if op == "<<" || op == ">>":
            return 7
        if op == "+" || op == "-":
            return 8
        if op == "*" || op == "/" || op == "%":
            return 9
        return -1

    # epBinary: parseBinary(minPrec).
    proc epBinary(kinds: [text], texts: [text], pos0: int, minPrec: int) -> EP:
        let l0 = do epUnary(kinds, texts, pos0)
        if l0.err != "":
            return l0
        let mut left = l0.node
        let mut pos = l0.pos
        let n = len(kinds)
        loop pos < n:
            let k = kinds[pos]
            let mut op = ""
            if k == "op":
                op = texts[pos]
            else:
                if k == "ident" && texts[pos] == "in":
                    op = "in"
                else:
                    break
            let prec = do epPrec(op)
            if prec < 0 || prec < minPrec:
                break
            let r = do epBinary(kinds, texts, pos + 1, prec + 1)
            if r.err != "":
                return r
            let b = do binNode(op, left, r.node)
            left = b
            pos = r.pos
        return EP{node: left, pos: pos, err: ""}

    proc epUnary(kinds: [text], texts: [text], pos: int) -> EP:
        let k = do epKind(kinds, pos)
        let t = do epText(texts, pos)
        if k == "op" && (t == "!" || t == "-" || t == "~"):
            let x = do epUnary(kinds, texts, pos + 1)
            if x.err != "":
                return x
            let u = do unNode(t, x.node)
            return EP{node: u, pos: x.pos, err: ""}
        let p = do epPostfix(kinds, texts, pos)
        return p

    proc epIsUpperName(s: text) -> bool:
        let c = charAt(s, 0)
        return c >= "A" && c <= "Z"

    # epIsBuiltinCall: parser.IsBuiltinCall.
    proc epIsBuiltinCall(name: text) -> bool:
        return name in ["now", "rand", "print", "abs", "min", "max", "floor", "round", "money", "toFloat", "toInt", "floatBits", "floatFromBits", "toMoney", "len", "upper", "lower", "trim", "contains", "take", "split", "join", "slice", "charAt", "replace", "slug", "textToBytes", "bytesToText", "byteLen", "aesGcmSeal", "aesGcmOpen", "aesGcmAuthentic", "envVar", "envSet", "randomBytes", "year", "month", "day", "ago", "compact", "commas", "iso", "fromIso", "first", "given", "fromJson", "append", "bytes", "readFile", "writeFile", "appendFile", "fileExists", "truncateFile", "fileSize", "readFileAt", "writeFileAt", "syncFile", "renameFile", "removeFile", "httpGet", "httpPost", "listen", "listenOn", "accept", "connect", "readBytes", "writeBytes", "closeConn", "setTimeoutMs", "connError", "pollBytes", "connOpen", "shutdownConn", "sleepMs", "monoMs", "nowMs", "signals", "writeStdout", "writeStderr", "readStdin", "channel", "send", "recv", "verifyPassword", "totpSecret", "totpValid", "randomToken", "fileDigest", "ed25519Verify", "sha256Hex", "canonicalJson", "shuffleOrder", "ecdsaP256Verify", "fromLocal", "formatIn", "zoneValid"]

    # epArgListHasComma: argListHasComma — a top-level `,` before the
    # `(` at pos closes.
    proc epArgListHasComma(kinds: [text], texts: [text], pos: int) -> bool:
        let n = len(kinds)
        let mut depth = 0
        let mut i = pos
        loop i < n:
            if kinds[i] == "lparen":
                depth = depth + 1
            if kinds[i] == "rparen":
                depth = depth - 1
                if depth == 0:
                    return false
            if depth == 1 && kinds[i] == "op" && texts[i] == ",":
                return true
            i = i + 1
        return false

    proc epPostfix(kinds: [text], texts: [text], pos0: int) -> EP:
        let a = do epAtom(kinds, texts, pos0)
        if a.err != "":
            return a
        let mut atom = a.node
        let mut pos = a.pos
        if atom.kind == "ref":
            let name = atom.text
            let brace = do epIsOp(kinds, texts, pos, "{")
            let up = do epIsUpperName(name)
            let lp = do epKind(kinds, pos)
            if brace && up:
                let sl = do epStructLit(kinds, texts, pos, name)
                if sl.err != "":
                    return sl
                atom = sl.node
                pos = sl.pos
            else:
                if lp == "lparen":
                    let comma = do epArgListHasComma(kinds, texts, pos)
                    let isAgg = name == "count" || name == "sum" || name == "exists" || name == "avg" || name == "list" || ((name == "min" || name == "max") && !comma)
                    let isState = name == "pending" || name == "failed" || name == "dirty" || name == "touched"
                    let builtin = do epIsBuiltinCall(name)
                    if isAgg:
                        let ag = do epAgg(kinds, texts, pos, name)
                        if ag.err != "":
                            return ag
                        atom = ag.node
                        pos = ag.pos
                    else:
                        if isState:
                            let st = do epActState(kinds, texts, pos, name)
                            if st.err != "":
                                return st
                            atom = st.node
                            pos = st.pos
                        else:
                            if builtin || !up:
                                let cl = do epCall(kinds, texts, pos, name)
                                if cl.err != "":
                                    return cl
                                atom = cl.node
                                pos = cl.pos
                            else:
                                let key = do epBinary(kinds, texts, pos + 1, 0)
                                if key.err != "":
                                    return key
                                let rk = do epKind(kinds, key.pos)
                                if rk != "rparen":
                                    let f0 = do epFail(key.pos, "missing `)` in entity lookup")
                                    return f0
                                pos = key.pos + 1
                                let mut field = ""
                                let dot = do epIsOp(kinds, texts, pos, ".")
                                if dot:
                                    let fk = do epKind(kinds, pos + 1)
                                    if fk != "ident":
                                        let f1 = do epFail(pos + 1, "expected a field name after `.`")
                                        return f1
                                    field = texts[pos + 1]
                                    pos = pos + 2
                                let eg = do entityGetNode(name, key.node, field)
                                atom = eg
        let n = len(kinds)
        loop pos < n && kinds[pos] == "op":
            let t = texts[pos]
            if t == ".":
                let fk2 = do epKind(kinds, pos + 1)
                if fk2 != "ident":
                    let f2 = do epFail(pos + 1, "expected a field name after `.`")
                    return f2
                let g = do getNode(atom, texts[pos + 1])
                atom = g
                pos = pos + 2
            else:
                if t == "[":
                    let idx = do epBinary(kinds, texts, pos + 1, 0)
                    if idx.err != "":
                        return idx
                    let close = do epIsOp(kinds, texts, idx.pos, "]")
                    if !close:
                        let f3 = do epFail(idx.pos, "missing closing `]` in index")
                        return f3
                    let ix = do indexNode(atom, idx.node)
                    atom = ix
                    pos = idx.pos + 1
                else:
                    break
        return EP{node: atom, pos: pos, err: ""}

    # epCall: parseCall — `name(args…)`.
    proc epCall(kinds: [text], texts: [text], pos: int, name: text) -> EP:
        let al = do epArgs(kinds, texts, pos + 1)
        if al.err != "":
            let f = do epFail(al.pos, al.err)
            return f
        let c = do callNode(name, al.nodes)
        return EP{node: c, pos: al.pos, err: ""}

    struct EPList:
        nodes: [ExprNode]
        pos: int
        err: text

    # epArgs: the arguments after `(` up to and including its `)`.
    proc epArgs(kinds: [text], texts: [text], pos0: int) -> EPList:
        let k0 = do epKind(kinds, pos0)
        if k0 == "rparen":
            return EPList{nodes: [], pos: pos0 + 1, err: ""}
        let mut out = []
        let mut pos = pos0
        loop true:
            let e = do epBinary(kinds, texts, pos, 0)
            if e.err != "":
                return EPList{nodes: [], pos: e.pos, err: e.err}
            out = append(out, e.node)
            pos = e.pos
            let k = do epKind(kinds, pos)
            if k == "rparen":
                return EPList{nodes: out, pos: pos + 1, err: ""}
            let comma = do epIsOp(kinds, texts, pos, ",")
            if !comma:
                return EPList{nodes: [], pos: pos, err: "expected `,` or `)` in call"}
            pos = pos + 1
        return EPList{nodes: out, pos: pos, err: ""}

    # epActState: parseActState — `op(name)`, one bare identifier.
    proc epActState(kinds: [text], texts: [text], pos: int, op: text) -> EP:
        let k = do epKind(kinds, pos + 1)
        if k != "ident":
            let f0 = do epFail(pos + 1, op + "(...) takes an action or cell name")
            return f0
        let k2 = do epKind(kinds, pos + 2)
        if k2 != "rparen":
            let f1 = do epFail(pos + 2, "missing `)` in " + op + "(...)")
            return f1
        let s = do actStateNode(op, texts[pos + 1])
        return EP{node: s, pos: pos + 3, err: ""}

    proc epNumericAgg(op: text) -> bool:
        return op == "sum" || op == "avg" || op == "min" || op == "max"

    # epRowVar: aggRowVar/freeRowVar — the object of the leftmost member
    # access (pre-order), skipping names nested aggregates bind.
    proc epRowVar(ex: ExprNode, bound: [text]) -> text:
        let k = ex.kind
        if k == "get":
            let obj = ex.children[0]
            if obj.kind == "ref":
                if obj.text in bound:
                    return ""
                return obj.text
            let r = do epRowVar(obj, bound)
            return r
        if k == "entityGet":
            let r2 = do epRowVar(ex.children[0], bound)
            return r2
        if k == "struct":
            let np = len(ex.pairs)
            let mut i = 0
            loop i < np:
                let v = do epRowVar(ex.pairs[i].value, bound)
                if v != "":
                    return v
                i = i + 1
            return ""
        if k == "agg":
            let inner = append(bound, ex.itemVar)
            if len(ex.whereClause) > 0:
                let w = do epRowVar(ex.whereClause[0], inner)
                if w != "":
                    return w
            if len(ex.sel) > 0:
                let s = do epRowVar(ex.sel[0], inner)
                if s != "":
                    return s
            return ""
        if k == "bin" || k == "call":
            let nc = len(ex.children)
            let mut j = 0
            loop j < nc:
                let v2 = do epRowVar(ex.children[j], bound)
                if v2 != "":
                    return v2
                j = j + 1
            return ""
        if k == "un":
            let x = do epRowVar(ex.children[0], bound)
            return x
        return ""

    proc epAgg(kinds: [text], texts: [text], pos0: int, op: text) -> EP:
        let pos1 = pos0 + 1
        let k1 = do epKind(kinds, pos1)
        if k1 == "rparen" || k1 == "eof":
            let mut hint = ""
            let na = do epNumericAgg(op)
            if na:
                hint = ".field"
            let f0 = do epFail(pos1, op + " needs a collection: " + op + "(Entity" + hint + ")")
            return f0
        let h = do epBinary(kinds, texts, pos1, 7)
        if h.err != "":
            return h
        let head = h.node
        let mut pos = h.pos
        let mut itemVar = ""
        let mut coll = ""
        let mut field = ""
        let mut sel = []
        let isIn = do epIsIdent(kinds, texts, pos, "in")
        if isIn:
            let ck = do epKind(kinds, pos + 1)
            if ck != "ident":
                let f1 = do epFail(pos + 1, op + "(... in ...) needs a collection after `in`")
                return f1
            coll = texts[pos + 1]
            pos = pos + 2
            if head.kind == "ref":
                itemVar = head.text
            if head.kind == "get" && op != "list":
                let obj = head.children[0]
                if obj.kind == "ref":
                    itemVar = obj.text
                    field = head.text
            if itemVar == "":
                let rv = do epRowVar(head, [])
                itemVar = rv
                if itemVar == "" && op != "list":
                    let f2 = do epFail(pos, op + "(... in " + coll + " ...) reduces a value read off each row, so the value must read one: " + op + "(x.field * x.other in " + coll + " where …)")
                    return f2
                sel = [head]
        else:
            if head.kind == "ref":
                coll = head.text
            if head.kind == "get":
                let obj2 = head.children[0]
                if obj2.kind == "ref":
                    coll = obj2.text
                    field = head.text
            if coll == "":
                let f3 = do epFail(pos, op + " over an expression needs an item variable to read the row: " + op + "(x.a * x.b in Entity where …)")
                return f3
        let numeric = do epNumericAgg(op)
        if numeric && field == "" && len(sel) == 0:
            if itemVar != "":
                let f4 = do epFail(pos, op + " needs a field: " + op + "(" + itemVar + ".field in " + coll + " where …)")
                return f4
            let f5 = do epFail(pos, op + " needs a field: " + op + "(" + coll + ".field)")
            return f5
        if op != "list" && !numeric:
            if field != "":
                let f6 = do epFail(pos, op + " ranges over rows, not a field — drop the `." + field + "`")
                return f6
            if len(sel) > 0:
                let f7 = do epFail(pos, op + " ranges over rows, not a value — it counts the rows the filter accepts, so it takes `" + op + "(x in " + coll + " where …)`")
                return f7
        let mut whereC = []
        let isWhere = do epIsIdent(kinds, texts, pos, "where")
        if isWhere:
            let w = do epBinary(kinds, texts, pos + 1, 0)
            if w.err != "":
                return w
            whereC = [w.node]
            pos = w.pos
            if itemVar == "" && op == "list":
                let rv2 = do epRowVar(w.node, [])
                itemVar = rv2
        let mut varFromArg = false
        if itemVar == "" && op == "list" && len(sel) > 0:
            if sel[0].kind == "call":
                let na2 = len(sel[0].children)
                let mut ai = 0
                loop ai < na2:
                    if sel[0].children[ai].kind == "ref":
                        itemVar = sel[0].children[ai].text
                        varFromArg = true
                        break
                    ai = ai + 1
        let mut order = ""
        let mut orderBy = []
        let mut desc = false
        let mut limit = []
        if op == "list":
            let isBy = do epIsIdent(kinds, texts, pos, "by")
            if isBy:
                let bk = do epKind(kinds, pos + 1)
                if bk == "rparen" || bk == "eof":
                    let f8 = do epFail(pos + 1, "list(...) ordering is `by field [desc|asc]` or `by <expression over the row> [desc|asc]`")
                    return f8
                let key = do epBinary(kinds, texts, pos + 1, 0)
                if key.err != "":
                    return key
                pos = key.pos
                let kn = key.node
                if kn.kind == "ref":
                    order = kn.text
                else:
                    if kn.kind == "get" && kn.children[0].kind == "ref" && kn.children[0].text == itemVar && itemVar != "":
                        order = kn.text
                    else:
                        orderBy = [kn]
                let isDesc = do epIsIdent(kinds, texts, pos, "desc")
                let isAsc = do epIsIdent(kinds, texts, pos, "asc")
                if isDesc || isAsc:
                    desc = isDesc
                    pos = pos + 1
            let isLimit = do epIsIdent(kinds, texts, pos, "limit")
            if isLimit:
                let lim = do epBinary(kinds, texts, pos + 1, 0)
                if lim.err != "":
                    return lim
                limit = [lim.node]
                pos = lim.pos
        else:
            let isBy2 = do epIsIdent(kinds, texts, pos, "by")
            let isLim2 = do epIsIdent(kinds, texts, pos, "limit")
            if isBy2 || isLim2:
                let f9 = do epFail(pos, "`" + texts[pos] + "` is a clause of list(...) — " + op + " reduces every matching row, so it takes no ordering or limit")
                return f9
        let rk = do epKind(kinds, pos)
        if rk != "rparen":
            let f10 = do epFail(pos, "missing `)` in " + op + "(...)")
            return f10
        let node = ExprNode{kind: "agg", text: op, field: field, itemVar: itemVar, coll: coll, children: [], pairs: [], whereClause: whereC, sel: sel, order: order, desc: desc, limit: limit, orderBy: orderBy, varFromArg: varFromArg}
        return EP{node: node, pos: pos + 1, err: ""}

    # epAtom: parseAtom.
    proc epAtom(kinds: [text], texts: [text], pos: int) -> EP:
        let k = do epKind(kinds, pos)
        if k == "eof":
            let f0 = do epFail(pos, "unexpected end of expression")
            return f0
        let t = texts[pos]
        if k == "lparen":
            let e = do epBinary(kinds, texts, pos + 1, 0)
            if e.err != "":
                return e
            let rk = do epKind(kinds, e.pos)
            if rk != "rparen":
                let f1 = do epFail(e.pos, "missing closing `)`")
                return f1
            return EP{node: e.node, pos: e.pos + 1, err: ""}
        if k == "op":
            if t == "[":
                let l = do epListLit(kinds, texts, pos)
                return l
            if t == "{":
                let m = do epMapLit(kinds, texts, pos)
                return m
            let f2 = do epFail(pos, "unexpected \"" + t + "\" in expression")
            return f2
        if k == "num":
            if contains(t, ".") || contains(t, "e") || contains(t, "E"):
                let fl = do floatLitNode(t)
                return EP{node: fl, pos: pos + 1, err: ""}
            let il = do intLitNode(t)
            return EP{node: il, pos: pos + 1, err: ""}
        if k == "str":
            let n = len(t)
            if n < 2 || charAt(t, n - 1) != "\"":
                let f3 = do epFail(pos, "bad string " + t)
                return f3
            let sl = do textLitNode(t)
            return EP{node: sl, pos: pos + 1, err: ""}
        if k == "ident":
            if t == "true" || t == "false":
                let bl = do boolLitNode(t)
                return EP{node: bl, pos: pos + 1, err: ""}
            if t == "asset":
                let fromW = do epIsIdent(kinds, texts, pos + 1, "from")
                if fromW:
                    let sk = do epKind(kinds, pos + 2)
                    if sk != "str":
                        let f4 = do epFail(pos + 2, "asset from needs a quoted path: asset from \"logo.png\"")
                        return f4
                    let raw = texts[pos + 2]
                    if raw == "\"\"":
                        let f5 = do epFail(pos + 2, "asset from path is empty")
                        return f5
                    let an = ExprNode{kind: "asset", text: raw, field: "", itemVar: "", coll: "", children: [], pairs: [], whereClause: [], sel: [], order: "", desc: false, limit: [], orderBy: [], varFromArg: false}
                    return EP{node: an, pos: pos + 3, err: ""}
            let r = do refNode(t)
            return EP{node: r, pos: pos + 1, err: ""}
        let f6 = do epFail(pos, "unexpected \"" + t + "\" in expression")
        return f6

    proc epListLit(kinds: [text], texts: [text], pos0: int) -> EP:
        let close0 = do epIsOp(kinds, texts, pos0 + 1, "]")
        if close0:
            let e0 = do listNode([])
            return EP{node: e0, pos: pos0 + 2, err: ""}
        let mut elems = []
        let mut pos = pos0 + 1
        loop true:
            let e = do epBinary(kinds, texts, pos, 0)
            if e.err != "":
                return e
            elems = append(elems, e.node)
            pos = e.pos
            let k = do epKind(kinds, pos)
            if k == "eof":
                let f0 = do epFail(pos, "missing closing `]` in list")
                return f0
            let close = do epIsOp(kinds, texts, pos, "]")
            if close:
                let l = do listNode(elems)
                return EP{node: l, pos: pos + 1, err: ""}
            let comma = do epIsOp(kinds, texts, pos, ",")
            if !comma:
                let f1 = do epFail(pos, "expected `,` or `]` in list literal")
                return f1
            pos = pos + 1
        let l2 = do listNode(elems)
        return EP{node: l2, pos: pos, err: ""}

    proc epMapLit(kinds: [text], texts: [text], pos0: int) -> EP:
        let close0 = do epIsOp(kinds, texts, pos0 + 1, "}")
        if close0:
            let m0 = do mapLitNode([])
            return EP{node: m0, pos: pos0 + 2, err: ""}
        let mut pairs = []
        let mut pos = pos0 + 1
        loop true:
            let k = do epBinary(kinds, texts, pos, 0)
            if k.err != "":
                return k
            let colon = do epIsOp(kinds, texts, k.pos, ":")
            if !colon:
                let f0 = do epFail(k.pos, "expected `:` after a map key in a map literal")
                return f0
            let v = do epBinary(kinds, texts, k.pos + 1, 0)
            if v.err != "":
                return v
            pairs = append(pairs, Pair{key: k.node, value: v.node})
            pos = v.pos
            let kk = do epKind(kinds, pos)
            if kk == "eof":
                let f1 = do epFail(pos, "missing closing `}` in map literal")
                return f1
            let close = do epIsOp(kinds, texts, pos, "}")
            if close:
                let m = do mapLitNode(pairs)
                return EP{node: m, pos: pos + 1, err: ""}
            let comma = do epIsOp(kinds, texts, pos, ",")
            if !comma:
                let f2 = do epFail(pos, "expected `,` or `}` in map literal")
                return f2
            pos = pos + 1
        let m2 = do mapLitNode(pairs)
        return EP{node: m2, pos: pos, err: ""}

    proc epStructLit(kinds: [text], texts: [text], pos0: int, typeName: text) -> EP:
        let mut fields = []
        let mut pos = pos0 + 1
        loop true:
            let k = do epKind(kinds, pos)
            if k == "eof":
                let f0 = do epFail(pos, "missing closing `}` in " + typeName + "{...} literal")
                return f0
            if k != "ident":
                let f1 = do epFail(pos, "expected a field name in " + typeName + "{...} literal")
                return f1
            let fname = texts[pos]
            let colon = do epIsOp(kinds, texts, pos + 1, ":")
            if !colon:
                let f2 = do epFail(pos + 1, "expected `:` after field \"" + fname + "\" in " + typeName + "{...} literal")
                return f2
            let v = do epBinary(kinds, texts, pos + 2, 0)
            if v.err != "":
                return v
            let keyNode = do refNode(fname)
            fields = append(fields, Pair{key: keyNode, value: v.node})
            pos = v.pos
            let ck = do epKind(kinds, pos)
            if ck == "eof":
                let f3 = do epFail(pos, "missing closing `}` in " + typeName + "{...} literal")
                return f3
            let close = do epIsOp(kinds, texts, pos, "}")
            if close:
                pos = pos + 1
                break
            let comma = do epIsOp(kinds, texts, pos, ",")
            if !comma:
                let f4 = do epFail(pos, "expected `,` or `}` in " + typeName + "{...} literal")
                return f4
            pos = pos + 1
        if len(fields) == 0:
            let f5 = do epFail(pos, typeName + "{...} literal has no fields — a struct literal must set every field")
            return f5
        let s = do structLitNode(typeName, fields)
        return EP{node: s, pos: pos, err: ""}

    # ── entry points ───────────────────────────────────────────────────
    proc epParse(kinds: [text], texts: [text], pos: int) -> EP:
        let r = do epBinary(kinds, texts, pos, 0)
        return r

    proc orNodes(kinds: [text], texts: [text], pos: int) -> ExprNode:
        let r = do epBinary(kinds, texts, pos, 0)
        if r.err != "":
            let e = do emptyNode()
            return e
        return r.node

    proc orEnd(kinds: [text], texts: [text], pos: int) -> int:
        let r = do epBinary(kinds, texts, pos, 0)
        if r.err != "":
            return -1
        return r.pos

    # argListNodes: the comma-separated expressions starting at pos (the
    # token after a call's `(`), stopping before its `)`.
    proc argListNodes(kinds: [text], texts: [text], pos: int) -> [ExprNode]:
        let k = do epKind(kinds, pos)
        if k == "rparen" || k == "eof":
            return []
        let mut out = []
        let mut p = pos
        loop true:
            let e = do epBinary(kinds, texts, p, 0)
            if e.err != "":
                return out
            out = append(out, e.node)
            p = e.pos
            let comma = do epIsOp(kinds, texts, p, ",")
            if !comma:
                break
            p = p + 1
        return out

    # epParseError: expr.go's parseExpr error for a whole source, "" when
    # it parses and consumes every token.
    proc epParseError(src: text) -> text:
        let kinds = do tokenKinds(src)
        let texts = do tokenTexts(src)
        let r = do epBinary(kinds, texts, 0, 0)
        if r.err != "":
            return r.err
        if r.pos != len(kinds):
            return "unexpected \"" + texts[r.pos] + "\" in expression"
        return ""
