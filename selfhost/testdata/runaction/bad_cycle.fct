app R:
    entity Acct:
        id: int
        owner: text
        bal: int
    type Out:
        n: int
    action a:
        add Acct { owner: "x", bal: 0 }
        run b
    action b:
        add Acct { owner: "y", bal: 0 }
        run c
    action c:
        add Acct { owner: "z", bal: 0 }
        run a
    view Home at "/":
        text "x"
