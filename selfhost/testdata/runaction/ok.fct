app R:
    entity Acct:
        id: int
        owner: text
        bal: int
    type Out:
        n: int
    action ensure(who: text):
        add Acct { owner: who, bal: 0 }
    action total(who: text) -> Out:
        return Out{n: count(a in Acct where a.owner == who)}
    action ping:
        add Acct { owner: "p", bal: 1 }
    action fund(who: text):
        run ensure(who)
        let t = run total(who)
        run ping
        if t.n > 1:
            run ping
    view Home at "/":
        text "x"
