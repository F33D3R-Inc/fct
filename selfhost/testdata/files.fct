app Files:
    file Notes: text at "notes/log.txt"
    file Blob: bytes at "blob.bin"
    state last: text = ""
    proc save(s: text) -> bool uses io.file:
        let ok = write Notes(s)
        return ok
    proc load() -> text uses io.file:
        let t = read Notes()
        return t
    proc size() -> int uses io.file:
        let b = read Blob()
        write Blob(b)
        return len(b)
    action keep(s: text):
        let ok = do save(s)
        let t = do load()
        last = t
    daemon tick every 60s uses io.file:
        let t = read Notes()
        print(t)
    view Home at "/":
        text "{last}"
