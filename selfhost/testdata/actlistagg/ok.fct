app L:
    entity Tag:
        id: int
        name: text
    proc firstN(xs: [text], n: int) -> [text]:
        return take(xs, n)
    action tag(names: [text]):
        let picked = do firstN(names, 3)
        check count(n in picked where n == "") == 0 "no empty tags"
        if exists(n in names where n == "x"):
            add Tag { name: "x" }
        let ls = list(n in picked where n != "y")
        add Tag { name: "" + len(ls) }
    view Home at "/":
        text "t"
