app Chat:
    type LineDTO:
        body: text
    entity Line:
        id: int
        body: text
    contract "/api/_contract"
    stream "/api/v2/chat": LineDTO
    api POST "/api/v2/chat" -> post
    webhook "/hooks/chat" -> post
    on post -> tidy
    action post(body: text):
        add Line { body: body }
        emit LineDTO{body: body}
    action tidy():
        remove l in Line where l.body == ""
