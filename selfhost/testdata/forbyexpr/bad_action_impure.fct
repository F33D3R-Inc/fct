app O:
    entity Post:
        id: int
        title: text
        score: int
    entity Like:
        id: int
        post: int
    entity Pick:
        id: int
        title: text
    state pick: text = "" @client
    action pickTop:
        for p in Post where true by count(l in Like where l.post == p.id) desc limit 1:
            add Pick { title: p.title }
    action pickAsc:
        for p in Post by p.score + now() asc:
            add Pick { title: p.title }
    action pickPlain:
        for p in Post by len(p.title):
            add Pick { title: p.title }
    view Home at "/":
        for p in Post where true by count(l in Like where l.post == p.id) desc limit 2:
            text "[{p.title}]"
        for q in Post by q.score - 1:
            text "{q.title}"
        for r in Post by score desc:
            text "{r.title}"
        select bind pick:
            for c in Post by len(c.title) desc:
                option "{c.title}" -> c.title
