# detach from a daemon: both compilers must agree on the whole IR
# (selfhost/detach_parity_test.go).
app DetachParity:
    proc echo(c: int, greeting: text) uses io.net.listen:
        let data = readBytes(c, 64)
        let wrote = writeBytes(c, textToBytes(greeting) + data)
        let closed = closeConn(c)

    daemon Echo uses io.net.listen:
        let l = listen(7401)
        loop true:
            let c = accept(l)
            detach echo(c, "hi ")
