app NB:
    proc half(c: int) -> bool uses io.net:
        let ok = closeWrite(c)
        return ok
    proc wellFormed(b: [int]) -> bool:
        let v = validUtf8(b)
        return v && validUtf8(textToBytes("é"))
    proc both(c: int, b: [int]) -> bool uses io.net:
        let h = do half(c)
        let w = do wellFormed(b)
        return h && w
    view Home at "/":
        text "nb"
