app JE:
    # strings whose IR spelling uses every encoding/json escape: <, >, &,
    # U+2028/U+2029, control characters by name (\b \f \n \r \t) and by
    # \u00xx, a quote, a backslash — and characters it writes raw (an
    # accent, CJK, an emoji outside the BMP)
    proc marks() -> [text]:
        return ["a<b>&c", "line\u2028sep\u2029para", "bell\u0007 bs\u0008 ff\u000c", "tab\t nl\n cr\r", "q\"uote \\ slash", "caf\u00e9 \u65e5\u672c \U0001F600"]
    view Home at "/":
        text "je"
