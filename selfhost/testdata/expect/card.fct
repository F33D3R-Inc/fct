app Host:
    expect entity Stream:
        id: int
        title: text
        live: bool
    expect action pay(stream: int, cents: money)
    expect state draft: text
    expect view at "/profile/:handle"
    component StreamCard(s: Stream):
        box:
            text "{s.title}"
            input bind draft
            button "Tip" -> pay(s.id, 500)
            link "Profile" -> "/profile/{s.title}"
