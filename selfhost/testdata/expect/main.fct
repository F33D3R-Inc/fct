import "card.fct"

app Host:
    entity Stream:
        id: int
        owner: text
        title: text
        live: bool
        viewers: int
    state draft: text = "" @client
    action pay(stream: int, cents: money):
        set Stream(stream).viewers = Stream(stream).viewers + 1
    view Home at "/":
        for s in Stream:
            use StreamCard(s)
    view Profile at "/profile/:handle":
        text "{handle}"
