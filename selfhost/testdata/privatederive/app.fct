app PD:
    entity Post:
        id: int
        body: text
    private proc norm(s: text) -> text:
        return lower(trim(s))
    derive clean(s: text): text = norm(s)
    state last: text = ""
    action save(s: text):
        let c = clean(s)
        last = c
    view Home at "/":
        text "{last}"
