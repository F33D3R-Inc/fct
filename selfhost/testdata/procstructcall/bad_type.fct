app P:
    struct Q:
        n: int
        words: [text]
    proc empty() -> Q:
        return Q{n: 0, words: []}
    proc build(w: text) -> Q:
        let mut q = empty()
        q.n = "one"
        q.words = append(q.words, w)
        return q
    private proc tally(xs: [int]) -> [int]:
        return xs
    proc sum3() -> int:
        let t = tally([1, 2, 3])
        return len(t) + t[0]
    action a(w: text) -> int:
        let q = build(w)
        return q.n
    view Home at "/":
        text "p"
