app P:
    type CardDTO:
        title: text
        score: int
    entity Post:
        id: int
        title: text
    proc scoreOf(t: text) -> int:
        return len(t) * 2
    derive cardDTO(p: Post): CardDTO = CardDTO{title: p.title, score: scoreOf(p.title)}
    derive wrapped(p: Post): CardDTO = cardDTO(p)
    action cards() -> [CardDTO]:
        return list(wrapped(p) in Post by id)
    action firstTitle(raw: text) -> text:
        let when = fromIso(raw)
        let t = first(list(p.title in Post by id))
        return "" + t
    view Home at "/":
        text "x"
