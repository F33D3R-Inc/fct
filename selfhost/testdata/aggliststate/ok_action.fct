app Q:
    state words: [text] = [] @server
    state hits: int = 0 @server
    action addWord(w: text):
        words = words + [w]
    action tally(w: text):
        if exists(x in words where x == w):
            hits = hits + count(x in words where x == w)
    view Home at "/":
        text "{hits}"
