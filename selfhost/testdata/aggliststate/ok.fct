app Q:
    state words: [text] = [] @server
    action addWord(w: text):
        words = words + [w]
    derive hit(body: text): bool = count(w in words where !contains(body, w)) == 0
    derive any(body: text): bool = exists(w in words where w == body)
    derive some(body: text): bool = len(list(w in words where contains(body, w))) > 0
    view Home at "/":
        text "{hit(\"x\")} {any(\"y\")} {some(\"z\")}"
