app FloatLits:
    # float literals at encoding/json's formatting edges: its 'e' form below
    # 1e-6 and from 1e21 up, shortest round-trip digits, whole floats
    proc lits() -> [float]:
        return [0.0, 00.5, 1.0, 2.50, 0.1, 0.2, 0.30000000000000004, 0.1000000000000000055511151231257827, 0.000001, 0.0000009999999999, 0.00000001, 0.0000001, 0.000000000000000000000000001234567, 123456.789, 1234567.5, 12345678901234567890.0, 99999999999999999999.0, 100000000000000000000.0, 999999999999999999999.0, 1000000000000000000000.0, 123456789012345678901234.5, 3.141592653589793238462643, 1.7976931348623157, 17976931348623157000000000000000000000000000000000000000000.0, 0., 9007199254740993.0, 4.35]
    proc neg() -> float:
        return 0.0 - 0.00000001 - 1000000000000000000000.0
    view Home at "/":
        text "f"
