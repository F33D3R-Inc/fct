app FabricU64Check:
    # The u64 builtins against Rust's u64 (u64ops_rust.tsv): cmp, min, max,
    # saturating_sub, / and %, Display, `as f64`, `as i64` (the bit pattern
    # these ints hold) and FromStr over values around 2^32, 2^53, 2^63 and
    # 2^64. Values past i64::MAX are written as text and read with u64Parse.

    proc lbVals() -> [int]:
        let ts = ["0", "1", "2", "7", "10", "156", "1000", "4294967295", "4294967296", "9007199254740993", "4611686018427387907", "9223372036854775806", "9223372036854775807", "9223372036854775808", "9223372036854775809", "12345678901234567890", "18446744073709551557", "18446744073709551614", "18446744073709551615"]
        let mut out = []
        let mut i = 0
        loop i < len(ts):
            out = append(out, u64Parse(ts[i]))
            i = i + 1
        return out

    proc lbPairs() -> text:
        let v = do lbVals()
        let mut t = []
        let mut i = 0
        loop i < len(v):
            let mut j = 0
            loop j < len(v):
                let a = v[i]
                let b = v[j]
                let mut d = "z"
                if b != 0:
                    d = u64Text(u64Div(a, b)) + ":" + u64Text(u64Rem(a, b))
                t = append(t, "" + u64Cmp(a, b) + ":" + u64Text(u64Min(a, b)) + ":" + u64Text(u64Max(a, b)) + ":" + u64Text(u64SatSub(a, b)) + ":" + d)
                j = j + 1
            i = i + 1
        return join(t, "#")

    proc lbUnary() -> text:
        let v = do lbVals()
        let mut t = []
        let mut i = 0
        loop i < len(v):
            t = append(t, u64Text(v[i]) + ":" + floatBits(u64ToFloat(v[i])) + ":" + v[i])
            i = i + 1
        return join(t, "#")

    proc lbParse() -> text:
        let ts = ["", "+", "-", "0", "+0", "-0", "7", "+7", "007", " 7", "7 ", "1e3", "18446744073709551615", "18446744073709551616", "99999999999999999999x", "x99999999999999999999", "184467440737095516150", "9223372036854775808", "0x10", "١", "12a"]
        let mut t = []
        let mut i = 0
        loop i < len(ts):
            let e = u64ParseError(ts[i])
            if e == "":
                t = append(t, "ok:" + u64Text(u64Parse(ts[i])))
            else:
                t = append(t, "err:" + e)
            i = i + 1
        return join(t, "#")

    state u64Pairs: text = ""
    state u64Unary: text = ""
    state u64Parse: text = ""

    action runU64Check():
        let a = do lbPairs()
        let b = do lbUnary()
        let c = do lbParse()
        u64Pairs = a
        u64Unary = b
        u64Parse = c
