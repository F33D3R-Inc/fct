import "types.fct"

app M:
    proc grantFor(user: text) -> Grant:
        return Grant{user: user, scopes: ["read", "write"]}
    proc audit(user: text) -> Audit:
        let g = do grantFor(user)
        return Audit{grants: [g, g], by: g}
    proc scopeCount(user: text) -> int:
        let a = do audit(user)
        return len(a.grants[0].scopes)
    action scopesOf(user: text) -> int @internal:
        let k = do scopeCount(user)
        return k
    action card(n: int) -> Card:
        return Card{title: "c", n: n}
    api GET "/api/card" -> card
    view Home at "/":
        text "m"
