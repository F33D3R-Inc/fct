app D:
    type Envelope:
        kind: text
        data: json?
    message Event tag "event_type":
        | post as "post.create" (title: text "The title" also name) -> createPost since "2026-09-01" "Creates a post.":
            mode: text? one of "a", "b"
        | wrap -> takeEnvelope body env: Envelope
        | patch -> patchPost:
            id: int
            then_<field>: text? "Changes" into changes
        | pinged -> pingIt
    entity Post:
        id: int
        title: text
    action createPost(title: text, mode: text?):
        add Post { title: title }
    action takeEnvelope(env: Envelope):
        print(env.kind)
    action patchPost(id: int, changes: json?):
        set Post(id).title = "x"
    action pingIt():
        print("ping")
    api POST "/api/events" -> Event
    view Home at "/":
        text "x"
