# The `run` statement and @internal actions, driven through both runtimes by
# TestRuntimeParityRun (the semantics of runtime/runaction_test.go).
app RunParity:
    entity Acct:
        id: int
        owner: text
        bal: int
    entity Log:
        id: int
        note: text
    policy member:
        actor != "guest"
    policy admin:
        role == "admin"
    action credit(who: text, n: int) -> int @internal:
        requires member
        check n > 0 "amount must be positive" code "bad_amount"
        if !exists(a in Acct where a.owner == who):
            add Acct { owner: who, bal: 0 }
        set a in Acct where a.owner == who:
            bal = a.bal + n
        return sum(a.bal in Acct where a.owner == who)
        add Log { note: "unreachable after return" }
    action pay(to: text, n: int):
        add Log { note: "before" }
        let after = run credit(to, n)
        add Log { note: "after " + after }
    action payThenFail(to: text, n: int):
        add Log { note: "before" }
        run credit(to, n)
        check false "the caller refuses after the run"
    action audit(note: text) @internal:
        requires admin
        add Log { note: note }
    action payAudited(to: text, n: int):
        run credit(to, n)
        run audit("paid " + to)
    action hop1(n: int) -> int @internal:
        add Log { note: "hop 1" }
        let d = run hop2(n + 1)
        return d
    action hop2(n: int) -> int @internal:
        add Log { note: "hop 2" }
        let d = run hop3(n + 1)
        return d
    action hop3(n: int) -> int @internal:
        add Log { note: "hop 3" }
        let d = run hop4(n + 1)
        return d
    action hop4(n: int) -> int @internal:
        add Log { note: "hop 4" }
        let d = run hop5(n + 1)
        return d
    action hop5(n: int) -> int @internal:
        add Log { note: "hop 5" }
        let d = run hop6(n + 1)
        return d
    action hop6(n: int) -> int @internal:
        add Log { note: "hop 6" }
        let d = run hop7(n + 1)
        return d
    action hop7(n: int) -> int @internal:
        add Log { note: "hop 7" }
        let d = run hop8(n + 1)
        return d
    action hop8(n: int) -> int @internal:
        add Log { note: "hop 8" }
        let d = run hop9(n + 1)
        return d
    action hop9(n: int) -> int @internal:
        add Log { note: "hop 9" }
        let d = run hop10(n + 1)
        return d
    action hop10(n: int) -> int @internal:
        add Log { note: "hop 10" }
        let d = run hop11(n + 1)
        return d
    action hop11(n: int) -> int @internal:
        add Log { note: "hop 11" }
        let d = run hop12(n + 1)
        return d
    action hop12(n: int) -> int @internal:
        add Log { note: "hop 12" }
        let d = run hop13(n + 1)
        return d
    action hop13(n: int) -> int @internal:
        add Log { note: "hop 13" }
        let d = run hop14(n + 1)
        return d
    action hop14(n: int) -> int @internal:
        add Log { note: "hop 14" }
        let d = run hop15(n + 1)
        return d
    action hop15(n: int) -> int @internal:
        add Log { note: "hop 15" }
        let d = run hop16(n + 1)
        return d
    action hop16(n: int) -> int @internal:
        add Log { note: "hop 16" }
        let d = run hop17(n + 1)
        return d
    action hop17(n: int) -> int @internal:
        add Log { note: "hop 17" }
        let d = run hop18(n + 1)
        return d
    action hop18(n: int) -> int @internal:
        add Log { note: "hop 18" }
        return n
    # a run chain 18 deep: the runtime's 16-deep backstop stops it, and
    # every hop's write rolls back with the caller's
    action dive():
        let d = run hop1(1)
        add Log { note: "never " + d }
    action shallow():
        let d = run hop12(12)
        add Log { note: "shallow reached " + d }
    derive logo: text = asset from "dot.png"
    view Home at "/":
        text "{count(Log)} logs, {sum(a.bal in Acct)} total"
        image "{logo}"
