# Wire-typed action parameters (runtime/wirearg.go) and float ordering
# (lessVal), driven through both runtimes by TestRuntimeParityWire.
app WireParity:
    type Tag:
        label: text
        weight: float
    type Item:
        name: text
        qty: int
        price: float
        note: text?
        tag: Tag?
        tags: [Tag]
    type Order:
        who: text
        rush: bool
        first: Item?
    entity Line:
        id: int
        name: text
        qty: int
        price: float
        note: text
        label: text
        tagCount: int
    entity R:
        id: int
        b: text
        sim: float
    action addItems(items: [Item]) -> int:
        for it in items:
            check it.qty > 0 "qty must be positive" status 422
            add Line { name: it.name, qty: it.qty, price: it.price, note: it.note, label: it.tag.label, tagCount: len(it.tags) }
        return count(Line)
    action placeOrder(order: Order) -> text:
        return order.who + " " + order.rush + " " + order.first.name + " " + order.first.qty
    action batch(owner: text, items: [Item]) -> text:
        return owner + ":" + len(items)
    action seedRows():
        add R { b: "a", sim: 0.1 }
        add R { b: "c", sim: 0.9 }
        add R { b: "b", sim: 0.5 }
        add R { b: "d", sim: 2.0 }
        add R { b: "e", sim: 2 }
    action top() -> [text]:
        return list(r.b in R where true by sim desc limit 3)
    action bottom() -> [text]:
        return list(r.b in R where true by sim)
    api POST "/api/items" -> addItems
    api POST "/api/orders" -> placeOrder
    api POST "/api/batches/{owner}" -> batch
    view V at "/":
        text "{count(Line)} lines"
        for r in R by sim desc:
            text "{r.b}"
