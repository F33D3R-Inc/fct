# runtime/columntype_test.go's app, driven through both runtimes and both
# stores by TestRuntimeParityColumns.
app C:
    entity Row:
        id: int
        n: int
        f: float
        b: bool
        s: text
        opt: int?
        left: text
        when: date
    action put(n: text, f: text, b: text, s: text, opt: text):
        add Row { n: fromJson(n), f: fromJson(f), b: fromJson(b), s: fromJson(s), opt: fromJson(opt) }
    action reset(id: int, n: text):
        set Row(id).n = fromJson(n)
    view V at "/":
        text "x"
