# The generated admin console and the stored form of @password fields,
# driven through both runtimes by TestRuntimeParityAdmin.
app AdminParity:
    enum Tier: free, pro
    entity Author:
        id: int
        handle: text
        password: text @password
        token: text @secret
        active: bool
        score: float
        tier: Tier
        joined: date
    entity Post:
        id: int
        author: Author
        title: text
    action becomeAdmin():
        establish actor "root" role "admin"
    action whoAmI() -> text:
        return actor + "/" + role
    action becomeMember():
        establish actor "ada" role "member"
    action join(handle: text, password: text):
        add Author { handle: handle, password: password, token: "t-" + handle, active: true, score: 1.5, tier: Tier.free, joined: 0 }
    action write(handle: text, title: text):
        let a = max(x.id in Author where x.handle == handle)
        add Post { author: a, title: title }
    action rescore(handle: text, s: float):
        set x in Author where x.handle == handle:
            score = s
    action repassword(id: int, password: text):
        set Author(id).password = password
    action signIn(handle: text, password: text) -> bool:
        let id = max(x.id in Author where x.handle == handle)
        return verifyPassword(Author(id).password, password)
    view Home at "/":
        text "{count(Author)} authors, {count(Post)} posts"
