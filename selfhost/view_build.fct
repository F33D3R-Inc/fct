        return IRNode{kind: n.kind, children: n.children, segs: n.segs, label: n.label, action: n.action, args: n.args, debounce: n.debounce, id: n.id, itemVar: n.itemVar, coll: n.coll, where: n.where, order: n.order, desc: n.desc, limit: n.limit, more: n.more, cond: n.cond, seconds: n.seconds, body: n.body, level: n.level, bind: n.bind, placeholder: n.placeholder, alt: n.alt, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, path: n.path, pathSegs: n.pathSegs, route: n.route, external: n.external, name: n.name, options: n.options, value: n.value, val: n.val, class: n.class, style: v, classSegs: n.classSegs, anchor: n.anchor, width: n.width, height: n.height, tiles: n.tiles, x: n.x, y: n.y, facing: n.facing, image: n.image}

