import "view_parse.fct"
import "check.fct"
import "ir_graph.fct"

app ViewBuildSelfHost:
    # view_build.fct — self-hosted port of internal/ir/build.go's VIEW
    # compiler: viewCtx.nodes (every ast.Node kind view_parse.fct produces),
    # lowerSegs (top-level interpolations -> page-local binding ids `b0…`,
    # in-region ones -> inline Expr segments), lowerRange (+ itemFields /
    # comparedItemFields / markQueried / markIndex — the view-driven index
    # inference), lowerOptions, the dynamic-region ids (`l`/`f`/`m`/`t`/`g`/
    # `u` + the shared `b` counter) with their dependency edges (depsIR /
    # nodeDeps / optionDeps), link destination classification (route
    # expression / external URL / path template / anchor), and Build's
    # step 5: views -> pages -> routes, the first page's view/bindings/
    # depGraph lifted to the top level, then the call-arity, link-route and
    # anchor validations.
    #
    # Components (`use`) and layouts (`in Layout`) are not lowered here: a
    # page that uses one is refused with a diagnostic naming the missing
    # port rather than compiled into a tree that silently lacks it.
    #
    # Errors travel in VCtx.err (first error wins, as Go's early return
    # does); every lowering step checks it before doing more work.
    struct VEnv:
        stateNames: [text]
        stateClient: [bool]
        stateTypes: [text]
        stateLists: [bool]
        privateNames: [text]
        entityNames: [text]
        fieldKeys: [text]
        fieldTypes: [text]
        deriveKeys: [text]
        e2eKeys: [text]
        enumFieldKeys: [text]
        enumFieldEnums: [text]
        enumNames: [text]
        enumMemberKeys: [text]
        inlineNames: [text]
        inlineExprs: [IRExpr]
        actionNames: [text]
        actionParamCounts: [int]
        policyNames: [text]
        policyParamCounts: [int]
        low: LowCtx
        # calls: the parameterized derives and procs a call may name (a
        # view may call neither a proc nor a derive that calls one).
        calls: CallEnv

    struct VScope:
        locals: [text]
        inRegion: bool
        varNames: [text]
        varTypes: [text]

    struct VRes:
        nodes: [IRNode]
        ctx: VCtx

    # VGlobal: the parts of Build's env that the view compiler grows as it
    # goes and every later page must see — component tables, per-component
    # dependency sets and region edges (compDeps/compRegions), the
    # specialization counter, the expanded templates (e.special) and the
    # expansion stack that refuses recursion. It rides inside VCtx so it
    # flows through every lowering step's return value.
    struct VTextList:
        items: [text]

    struct VRegion:
        keys: [text]
        ids: [text]

    struct VGlobal:
        comps: [VComp]
        compSlot: [text]
        depNames: [text]
        deps: [VTextList]
        regNames: [text]
        regions: [VRegion]
        nspec: int
        special: [IRComponent]
        specStack: [text]

    struct VSegRes:
        segs: [IRSeg]
        ctx: VCtx

    struct VPagesOut:
        err: text
        pages: [IRPage]
        routes: [IRRoute]
        indexKeys: [text]
        queriedKeys: [text]
        components: [IRComponent]

    struct VCtx:
        pfx: text
        bindings: [IRBinding]
        depKeys: [text]
        depIds: [text]
        callNames: [text]
        callArgc: [int]
        callVia: [text]
        links: [text]
        indexKeys: [text]
        queriedKeys: [text]
        nb: int
        nl: int
        nf: int
        nu: int
        ng: int
        err: text
        g: VGlobal
        slotOK: bool
        slot: [IRNode]

    proc vbCtxG(pfx: text, g: VGlobal) -> VCtx:
        return VCtx{pfx: pfx, bindings: [], depKeys: [], depIds: [], callNames: [], callArgc: [], callVia: [], links: [], indexKeys: [], queriedKeys: [], nb: 0, nl: 0, nf: 0, nu: 0, ng: 0, err: "", g: g, slotOK: false, slot: []}

    proc vcSetPfx(n: VCtx, v: text) -> VCtx:
        return VCtx{pfx: v, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetBindings(n: VCtx, v: [IRBinding]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: v, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetDepKeys(n: VCtx, v: [text]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: v, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetDepIds(n: VCtx, v: [text]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: v, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetCallNames(n: VCtx, v: [text]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: v, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetCallArgc(n: VCtx, v: [int]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: v, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetCallVia(n: VCtx, v: [text]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: v, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetLinks(n: VCtx, v: [text]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: v, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetIndexKeys(n: VCtx, v: [text]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: v, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetQueriedKeys(n: VCtx, v: [text]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: v, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetNb(n: VCtx, v: int) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: v, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetNl(n: VCtx, v: int) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: v, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetNf(n: VCtx, v: int) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: v, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetNu(n: VCtx, v: int) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: v, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetNg(n: VCtx, v: int) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: v, err: n.err, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetErr(n: VCtx, v: text) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: v, g: n.g, slotOK: n.slotOK, slot: n.slot}

    proc vcSetG(n: VCtx, v: VGlobal) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: v, slotOK: n.slotOK, slot: n.slot}

    proc vcSetSlotOK(n: VCtx, v: bool) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: v, slot: n.slot}

    proc vcSetSlot(n: VCtx, v: [IRNode]) -> VCtx:
        return VCtx{pfx: n.pfx, bindings: n.bindings, depKeys: n.depKeys, depIds: n.depIds, callNames: n.callNames, callArgc: n.callArgc, callVia: n.callVia, links: n.links, indexKeys: n.indexKeys, queriedKeys: n.queriedKeys, nb: n.nb, nl: n.nl, nf: n.nf, nu: n.nu, ng: n.ng, err: n.err, g: n.g, slotOK: n.slotOK, slot: v}

    proc vbNode(kind: text) -> IRNode:
        return IRNode{kind: kind, children: [], segs: [], label: [], action: "", args: [], debounce: 0, id: "", itemVar: "", coll: "", where: [], order: "", desc: false, limit: [], more: "", cond: [], seconds: 0, body: [], level: [], bind: "", placeholder: [], alt: [], poster: [], autoplay: false, loopFlag: false, muted: false, path: "", pathSegs: [], route: false, external: false, name: "", options: [], value: "", val: [], class: "", style: "", classSegs: [], anchor: "", width: 0, height: 0, tiles: [], x: [], y: [], facing: [], image: []}

    proc vbSetChildren(n: IRNode, v: [IRNode]) -> IRNode:
        return IRNode{kind: n.kind, children: v, segs: n.segs, label: n.label, action: n.action, args: n.args, debounce: n.debounce, id: n.id, itemVar: n.itemVar, coll: n.coll, where: n.where, order: n.order, desc: n.desc, limit: n.limit, more: n.more, cond: n.cond, seconds: n.seconds, body: n.body, level: n.level, bind: n.bind, placeholder: n.placeholder, alt: n.alt, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, path: n.path, pathSegs: n.pathSegs, route: n.route, external: n.external, name: n.name, options: n.options, value: n.value, val: n.val, class: n.class, style: n.style, classSegs: n.classSegs, anchor: n.anchor, width: n.width, height: n.height, tiles: n.tiles, x: n.x, y: n.y, facing: n.facing, image: n.image}

    proc vbSetSegs(n: IRNode, v: [IRSeg]) -> IRNode:
        return IRNode{kind: n.kind, children: n.children, segs: v, label: n.label, action: n.action, args: n.args, debounce: n.debounce, id: n.id, itemVar: n.itemVar, coll: n.coll, where: n.where, order: n.order, desc: n.desc, limit: n.limit, more: n.more, cond: n.cond, seconds: n.seconds, body: n.body, level: n.level, bind: n.bind, placeholder: n.placeholder, alt: n.alt, poster: n.poster, autoplay: n.autoplay, loopFlag: n.loopFlag, muted: n.muted, path: n.path, pathSegs: n.pathSegs, route: n.route, external: n.external, name: n.name, options: n.options, value: n.value, val: n.val, class: n.class, style: n.style, classSegs: n.classSegs, anchor: n.anchor, width: n.width, height: n.height, tiles: n.tiles, x: n.x, y: n.y, facing: n.facing, image: n.image}

