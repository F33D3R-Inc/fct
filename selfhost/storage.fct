app StorageSelfHost:
    # Self-hosting port of a piece of facetql/src/storage/page.rs — the
    # physical page: a fixed-size (16 KiB), self-describing, individually
    # verifiable block every durable structure in FacetQL (heap, B-tree,
    # catalog) is built out of. Read in full before writing this file,
    # along with facetql/src/storage/pager.rs (the buffer cache + AES-GCM
    # layer built on top of Page) for context.
    #
    # ============================================================
    # WHAT WAS PORTED, AND WHY THE CUT LANDS WHERE IT DOES:
    # ============================================================
    # This file ports Page's STRUCTURAL surface only: the fixed 24-byte
    # header layout, the slot-directory offset math, `free_space`/
    # `reclaimable_space`, the CRC-32 checksum (byte-for-byte the same
    # algorithm as `crc32_parts` in facetql/src/storage/binary.rs), and
    # the FULL structural validation pipeline `Page::decode` runs before
    # any caller sees a cell (magic → version → kind → CRC → directory/
    # cell-area bounds → per-slot bounds) — everything page.rs's own doc
    # comment means by "a page verifies itself."
    #
    # Deliberately NOT ported: `insert_cell`/`push_cell`/`replace_cell`/
    # `remove_cell`/`compact` — these are a page-MUTATION/allocation
    # POLICY (shifting the slot directory, packing cells toward one end,
    # deciding when to compact vs. fail) layered on top of the pure
    # layout arithmetic this file covers. That is a genuinely separate,
    # well-scoped piece of its own — folding it in here would have meant
    # two unrelated algorithms in one file, and the task asked for one.
    #
    # Also NOT here, and needing no stub: any crypto. Page (page.rs)
    # itself makes zero calls to `crypto::encrypt`/`crypto::decrypt` —
    # encryption wraps a page's ENCODED bytes one layer up, in
    # pager.rs's `read_from_disk`/`write_to_disk` (page.rs's own header
    # comment says so explicitly: "Pages are encrypted at rest (see
    # `storage::pager`)"). Choosing Page's own logic rather than
    # Pager's therefore sidesteps the "don't ship unverified crypto"
    # concern by construction, not by adding a pass-through stub for
    # something that was never called in the first place.
    #
    # ============================================================
    # BYTE-BUFFER REPRESENTATION:
    # ============================================================
    # A page body is one `[int]` array, one element per byte (0-255) —
    # this file's own version of predicate.fct's parallel-array "row"
    # convention, and the literal reading of the task's own "byte
    # buffers" suggestion. There is no text anywhere in this file.
    # Checked against LANGUAGE.md's full builtin list (`abs, ago,
    # channel, charAt, commas, compact, contains, day, floor, httpGet,
    # httpPost, len, lower, max, min, money, month, now, rand, readFile,
    # recv, round, send, slice, split, take, toFloat, toInt, trim,
    # upper, writeFile, year`) before assuming anything: fct has no
    # ord()/charCode-style "the numeric byte value of this character"
    # builtin. That is a real, confirmed gap (LANGUAGE.md says so
    # outright for any missing string function: "it doesn't exist yet
    # — that's a real gap, not something you're missing"), so turning
    # `readFile`'s text or a real on-disk page into this file's `[int]`
    # buffers is out of scope for this port. Every buffer here is
    # constructed directly as byte values, exactly mirroring how
    # `crc32_parts` itself is always called with `&[u8]`, never text.
    #
    # ============================================================
    # TWO LANGUAGE FACTS THIS FILE'S SHAPE IS BUILT AROUND (both
    # confirmed against fct's own source/docs, not assumed):
    # ============================================================
    # 1. No indexed array assignment. `arr[i] = v` does not exist in
    #    fct — LANGUAGE.md's own array examples only ever build one with
    #    a literal or `append`, and `append` (runtime/eval.go's "append"
    #    case) always allocates a fresh backing array rather than
    #    mutating in place. So every Page "setter" the Rust source has
    #    (`set_slot_count`/`set_free_end`/`set_extra`/`set_slot`) is
    #    restated here as a PURE function returning a brand-new body
    #    array with that one field's bytes replaced (`replaceBytesRange`,
    #    below) — never an in-place mutation, because this language has
    #    no in-place array mutation to reach for.
    # 2. `do ProcName(args)` may only appear as a bare fire-and-forget
    #    statement, or as the RHS of a FRESH `let name = do
    #    ProcName(args)` binding — never as a loop-body reassignment
    #    (`x = do Foo()`), and never nested inside another expression
    #    (`return do Foo()`, `a + do Foo()`). This is stricter than
    #    LANGUAGE.md's own "let mut can't bind a do call directly" note
    #    — expr.fct's own header documents hitting this empirically
    #    (`p = do termEnd(...)` inside a loop body fails to compile with
    #    "unexpected \"termEnd\" in expression"). Every proc below
    #    follows the one shape that survives it: bind each `do` result
    #    to its own fresh `let` (even inside a loop, even when it is
    #    logically "the same" running value each pass — expr.fct's
    #    `tokenKinds` does exactly this with `let dj = do
    #    isDigitChar(...)` inside its scan loop), then fold that into an
    #    accumulator with a plain, `do`-free expression
    #    (`allOk = allOk && slotOk`, not `allOk = do ...`).
    #
    # ============================================================
    # CRC-32 — restated bit-for-bit from `crc32_parts`
    # (facetql/src/storage/binary.rs): same init (`0xFFFFFFFF`), same
    # polynomial (`0xEDB88320`), same one-bit-at-a-time inner loop, same
    # final complement. The one necessary rewording: Rust's branchless
    # `(crc & 1).wrapping_neg()` mask trick negates a `u32`, an operation
    # this language has no equivalent for (and if it did, `~`/unary `-`
    # on this language's `int` would flip/negate across 64 bits, not the
    # 32 this algorithm needs). Restated as the arithmetic identity
    # `(crc & 1) * 0xFFFFFFFF` instead: 0 when the low bit is clear,
    # exactly `0xFFFFFFFF` when it is set — the same two outcomes Rust's
    # trick produces, reached by multiplication rather than negation,
    # and still branchless.
    #
    # Hand-verified before writing this file: a from-scratch Python
    # transliteration of the exact operations below (same mask trick,
    # same mask/shift/XOR sequence) was checked against `zlib.crc32` for
    # four inputs, including the empty string (0x00000000) and the
    # standard CRC-32/ISO-HDLC catalogue check value for the ASCII bytes
    # of "123456789" (0xCBF43926 = 3421780262 decimal) — see this file's
    # own `demoCrc32Check9`/`demoCrc32CheckEmpty` below, and the task
    # report for the full trace.
    #
    # ============================================================
    # PAGE LAYOUT — restated exactly from page.rs's own doc comment and
    # constants (PAGE_SIZE=16384, PAGE_ENVELOPE_LEN=28,
    # PAGE_BODY_LEN=16356, PAGE_HEADER_LEN=24, SLOT_LEN=4). Offsets used
    # as plain integer literals throughout (the same convention
    # predicate.fct's own arena stride (`5 * node`) already uses, rather
    # than defining a wrapper proc per constant):
    #   0   4   magic ("FQPG" = bytes 70,81,80,71)
    #   4   1   page kind (1=Meta 2=Leaf 3=Branch 4=Heap 5=Overflow)
    #   5   1   page format version (1)
    #   6   2   slot count (u16 LE)
    #   8   2   free_end — start of the cell area (u16 LE)
    #   10  2   reserved
    #   12  4   extra (u32 LE)
    #   16  4   CRC-32 of the body with these 4 bytes excluded (u32 LE)
    #   20  4   reserved
    #   24  ... slot directory: slot_count × (offset u16 LE, len u16 LE)
    proc sliceBytes(buf: [int], start: int, end: int) -> [int]:
        let mut out = []
        let mut i = start
        loop i < end:
            out = append(out, buf[i])
            i = i + 1
        return out

    proc concatBytes(a: [int], b: [int]) -> [int]:
        let mut out = a
        let n = len(b)
        let mut i = 0
        loop i < n:
            out = append(out, b[i])
            i = i + 1
        return out

    # replaceBytesRange: the pure-functional stand-in for every Page
    # "setter" in the Rust source — since fct arrays have no indexed
    # assignment (see header note 1), "setting" a field means building a
    # whole new buffer: everything before `start`, then `replacement`,
    # then everything after it.
    proc replaceBytesRange(buf: [int], start: int, replacement: [int]) -> [int]:
        let before = do sliceBytes(buf, 0, start)
        let replacedLen = len(replacement)
        let afterStart = start + replacedLen
        let bufLen = len(buf)
        let after = do sliceBytes(buf, afterStart, bufLen)
        let withReplacement = do concatBytes(before, replacement)
        let result = do concatBytes(withReplacement, after)
        return result

    proc bytesEqual(a: [int], b: [int]) -> bool:
        let na = len(a)
        let nb = len(b)
        if na != nb:
            return false
        let mut i = 0
        let mut eq = true
        loop i < na:
            if a[i] != b[i]:
                eq = false
            i = i + 1
        return eq

    proc zeroBytes(count: int) -> [int]:
        let mut out = []
        let mut i = 0
        loop i < count:
            out = append(out, 0)
            i = i + 1
        return out

    proc readU16LE(buf: [int], offset: int) -> int:
        let b0 = buf[offset]
        let b1 = buf[offset + 1]
        return b0 | (b1 << 8)

    proc readU32LE(buf: [int], offset: int) -> int:
        let b0 = buf[offset]
        let b1 = buf[offset + 1]
        let b2 = buf[offset + 2]
        let b3 = buf[offset + 3]
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

    proc writeU16LEBytes(v: int) -> [int]:
        let b0 = v & 255
        let b1 = (v >> 8) & 255
        return [b0, b1]

    proc writeU32LEBytes(v: int) -> [int]:
        let b0 = v & 255
        let b1 = (v >> 8) & 255
        let b2 = (v >> 16) & 255
        let b3 = (v >> 24) & 255
        return [b0, b1, b2, b3]

    # ============================================================
    # CRC-32 (see header note above for the full derivation).
    # ============================================================
    proc crc32Bytes(bytes: [int]) -> int:
        let n = len(bytes)
        let mut crc = 4294967295
        let mut i = 0
        loop i < n:
            crc = crc ^ bytes[i]
            let mut b = 0
            loop b < 8:
                let lsb = crc & 1
                let mask = lsb * 4294967295
                crc = ((crc >> 1) ^ (3988292384 & mask)) & 4294967295
                b = b + 1
            i = i + 1
        return crc ^ 4294967295

    # crc32TwoParts: `crc32_parts`'s own real call shape in facetql — a
    # page's checksum covers the whole body EXCEPT the 4 bytes holding
    # the checksum itself, which is two ranges and no single slice.
    # `crc32_parts`'s own doc says this computes the CRC "as if [the
    # parts] were concatenated", so concatenating and delegating to
    # `crc32Bytes` is not a shortcut — it is that exact definition,
    # restated instead of duplicating the bit-loop a second time (which
    # `do`-inside-a-loop's restriction, header note 2, would make
    # awkward here anyway, since a two-array version would need the SAME
    # running `crc` folded across two loops).
    proc crc32TwoParts(a: [int], b: [int]) -> int:
        let combined = do concatBytes(a, b)
        let crc = do crc32Bytes(combined)
        return crc

    # ============================================================
    # PAGE CONSTRUCTION / ENCODE.
    # ============================================================
    proc pageMagicBytes() -> [int]:
        return [70, 81, 80, 71]

    # pageNewBody: `Page::new` — a fresh, all-zero PAGE_BODY_LEN-byte
    # body with the header fields it sets (magic, kind, version,
    # slot_count=0, free_end=PAGE_BODY_LEN, extra=0) written in, and the
    # CRC field left at 0 (a placeholder — `pageEncode`, not this proc,
    # is what fills in a real checksum, mirroring how `Page::new` alone
    # never computes one either; only `encode` does).
    proc pageNewBody(kind: int) -> [int]:
        let magic = do pageMagicBytes()
        let h1 = append(magic, kind)
        let h2 = append(h1, 1)
        let slotCountBytes = do writeU16LEBytes(0)
        let h3 = do concatBytes(h2, slotCountBytes)
        let freeEndBytes = do writeU16LEBytes(16356)
        let h4 = do concatBytes(h3, freeEndBytes)
        let h5 = append(h4, 0)
        let h6 = append(h5, 0)
        let extraBytes = do writeU32LEBytes(0)
        let h7 = do concatBytes(h6, extraBytes)
        let crcPlaceholder = do writeU32LEBytes(0)
        let h8 = do concatBytes(h7, crcPlaceholder)
        let h9 = append(h8, 0)
        let h10 = append(h9, 0)
        let h11 = append(h10, 0)
        let header = append(h11, 0)
        let pad = do zeroBytes(16332)
        let body = do concatBytes(header, pad)
        return body

    # pageComputeCrc / pageEncode: `Page::compute_crc` / `Page::encode`.
    proc pageComputeCrc(body: [int]) -> int:
        let before = do sliceBytes(body, 0, 16)
        let bodyLen = len(body)
        let after = do sliceBytes(body, 20, bodyLen)
        let crc = do crc32TwoParts(before, after)
        return crc

    proc pageEncode(body: [int]) -> [int]:
        let crc = do pageComputeCrc(body)
        let crcBytes = do writeU32LEBytes(crc)
        let encoded = do replaceBytesRange(body, 16, crcBytes)
        return encoded

    # ============================================================
    # FIELD ACCESSORS — `Page::kind`/`extra`/`slot_count`/`free_end`,
    # plus the CRC field and the read half of `Page::slot`.
    # ============================================================
    proc pageKind(body: [int]) -> int:
        return body[4]

    proc pageVersion(body: [int]) -> int:
        return body[5]

    proc pageSlotCount(body: [int]) -> int:
        let v = do readU16LE(body, 6)
        return v

    proc pageFreeEnd(body: [int]) -> int:
        let v = do readU16LE(body, 8)
        return v

    proc pageExtra(body: [int]) -> int:
        let v = do readU32LE(body, 12)
        return v

    proc pageCrcStored(body: [int]) -> int:
        let v = do readU32LE(body, 16)
        return v

    proc pageSlotOffset(body: [int], index: int) -> int:
        let at = 24 + index * 4
        let v = do readU16LE(body, at)
        return v

    proc pageSlotLength(body: [int], index: int) -> int:
        let at = 24 + index * 4 + 2
        let v = do readU16LE(body, at)
        return v

    # ============================================================
    # FIELD "SETTERS" — pure functions returning a new body (see header
    # note 1: no indexed assignment exists to set one in place).
    # ============================================================
    proc pageSetSlotCount(body: [int], count: int) -> [int]:
        let bytes = do writeU16LEBytes(count)
        let result = do replaceBytesRange(body, 6, bytes)
        return result

    proc pageSetFreeEnd(body: [int], value: int) -> [int]:
        let bytes = do writeU16LEBytes(value)
        let result = do replaceBytesRange(body, 8, bytes)
        return result

    proc pageSetExtra(body: [int], value: int) -> [int]:
        let bytes = do writeU32LEBytes(value)
        let result = do replaceBytesRange(body, 12, bytes)
        return result

    proc pageSetSlot(body: [int], index: int, offset: int, length: int) -> [int]:
        let offsetBytes = do writeU16LEBytes(offset)
        let lengthBytes = do writeU16LEBytes(length)
        let slotBytes = do concatBytes(offsetBytes, lengthBytes)
        let at = 24 + index * 4
        let result = do replaceBytesRange(body, at, slotBytes)
        return result

    # ============================================================
    # LAYOUT ARITHMETIC — `Page::free_space` / `Page::reclaimable_space`.
    # ============================================================
    proc pageFreeSpace(body: [int]) -> int:
        let slotCount = do pageSlotCount(body)
        let freeEnd = do pageFreeEnd(body)
        let directoryEnd = 24 + slotCount * 4
        let diff = freeEnd - directoryEnd
        # `saturating_sub` in the Rust source: a malformed page could in
        # principle have a directory that already runs past free_end,
        # and free_space is defined as 0 then, not a negative number.
        if diff < 0:
            return 0
        return diff

    proc sumSlotLengths(body: [int], count: int) -> int:
        let mut i = 0
        let mut total = 0
        loop i < count:
            let length = do pageSlotLength(body, i)
            total = total + length
            i = i + 1
        return total

    proc pageReclaimableSpace(body: [int]) -> int:
        let slotCount = do pageSlotCount(body)
        let used = do sumSlotLengths(body, slotCount)
        return 16356 - 24 - slotCount * 4 - used

    # ============================================================
    # STRUCTURAL VALIDATION — `Page::decode`'s full check sequence,
    # restated as a bool (a proc has no `Result` to return — the same
    # split predicate.fct's own `evalPredicateOk` documents for the same
    # reason: a caller that gets `true` back already holds the exact
    # body array it asked about, so there is nothing further a decoded
    # "Page" value would need to carry that this array doesn't already
    # carry itself).
    # ============================================================
    proc pageMagicOk(body: [int]) -> bool:
        let magic = do sliceBytes(body, 0, 4)
        let expected = do pageMagicBytes()
        let eq = do bytesEqual(magic, expected)
        return eq

    proc pageVersionOk(body: [int]) -> bool:
        return body[5] == 1

    proc pageKindValid(kind: int) -> bool:
        return kind >= 1 && kind <= 5

    proc pageCrcOk(body: [int]) -> bool:
        let stored = do pageCrcStored(body)
        let computed = do pageComputeCrc(body)
        return stored == computed

    proc pageBoundsOk(body: [int]) -> bool:
        let slotCount = do pageSlotCount(body)
        let freeEnd = do pageFreeEnd(body)
        let directoryEnd = 24 + slotCount * 4
        return directoryEnd <= freeEnd && freeEnd <= 16356

    proc pageSlotBoundsOk(body: [int], index: int) -> bool:
        let offset = do pageSlotOffset(body, index)
        let length = do pageSlotLength(body, index)
        let freeEnd = do pageFreeEnd(body)
        return offset >= freeEnd && offset + length <= 16356

    proc pageAllSlotsBoundsOk(body: [int], count: int) -> bool:
        let mut i = 0
        let mut allOk = true
        loop i < count:
            let slotOk = do pageSlotBoundsOk(body, i)
            allOk = allOk && slotOk
            i = i + 1
        return allOk

    proc pageDecodeOk(body: [int]) -> bool:
        let bodyLen = len(body)
        if bodyLen != 16356:
            return false
        let magicOk = do pageMagicOk(body)
        if !magicOk:
            return false
        let versionOk = do pageVersionOk(body)
        if !versionOk:
            return false
        let kind = do pageKind(body)
        let kindOk = do pageKindValid(kind)
        if !kindOk:
            return false
        let crcOk = do pageCrcOk(body)
        if !crcOk:
            return false
        let boundsOk = do pageBoundsOk(body)
        if !boundsOk:
            return false
        let slotCount = do pageSlotCount(body)
        let slotsOk = do pageAllSlotsBoundsOk(body, slotCount)
        if !slotsOk:
            return false
        return true

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES.
    # ============================================================
    # A fresh Heap page (kind=4), encoded (CRC filled in), should decode
    # clean; the same bytes with one byte flipped inside the (currently
    # all-zero) cell area should fail decode on the CRC check alone,
    # exactly like page.rs's own "the page checksum mismatch" case.
    proc demoFreshPageEncoded() -> [int]:
        let fresh = do pageNewBody(4)
        let encoded = do pageEncode(fresh)
        return encoded

    proc demoFreshPageOk() -> bool:
        let encoded = do demoFreshPageEncoded()
        let ok = do pageDecodeOk(encoded)
        return ok

    proc demoOneCorruptByte() -> [int]:
        return [255]

    proc demoCorruptedPageOk() -> bool:
        let encoded = do demoFreshPageEncoded()
        let corruptByte = do demoOneCorruptByte()
        let corrupted = do replaceBytesRange(encoded, 5000, corruptByte)
        let ok = do pageDecodeOk(corrupted)
        return ok

    proc demoFreeSpaceCheck() -> bool:
        let fresh = do pageNewBody(4)
        let freeSpace = do pageFreeSpace(fresh)
        return freeSpace == 16332

    # CRC-32 hand-verification fixtures (see header note + task report
    # for the full derivation): the empty input's CRC-32 is 0x00000000,
    # and the ASCII bytes of "123456789" (49,50,...,57) are the standard
    # CRC-32/ISO-HDLC catalogue check value, 0xCBF43926 = 3421780262.
    proc demoEmptyBytes() -> [int]:
        return []

    proc demoNineDigitsBytes() -> [int]:
        return [49, 50, 51, 52, 53, 54, 55, 56, 57]

    proc demoCrc32CheckEmpty() -> bool:
        let bytes = do demoEmptyBytes()
        let crc = do crc32Bytes(bytes)
        return crc == 0

    proc demoCrc32Check9() -> bool:
        let bytes = do demoNineDigitsBytes()
        let crc = do crc32Bytes(bytes)
        return crc == 3421780262

    # ============================================================
    # PART TWO — the buffer cache's LRU eviction policy, ported from
    # facetql/src/storage/pager.rs (`PagerInner`, read in full alongside
    # page.rs before writing this section).
    # ============================================================
    # WHAT WAS PORTED: `PagerInner::admit` — the "which page to evict"
    # decision a bounded-size page cache makes every time a page is
    # faulted in or written — plus the two call shapes that reach it,
    # `Pager::read`'s cache-hit tick bump and its cache-miss admit, and
    # `Pager::write`'s unconditional dirty admit. Together these are
    # exactly the task's own "LRU eviction policy... a real,
    # self-contained, checkable algorithm using arrays/maps" example.
    #
    # NOT ported, and confirmed needing no stub: `Pager::flush`,
    # `read_from_disk`, `write_to_disk` — the actual disk I/O, and the
    # ONLY place `crypto::encrypt`/`crypto::decrypt` are called anywhere
    # in pager.rs (verified by reading the whole file: `admit`, `read`,
    # `write`, `allocate`, `page_count` make zero crypto calls; only
    # `PagerInner::read_from_disk` calls `crypto::decrypt` and only
    # `PagerInner::write_to_disk` calls `crypto::encrypt`). This is the
    # same finding storage.fct's PART ONE already made for `Page` itself
    # ("Page makes zero calls to crypto::encrypt/decrypt... encryption
    # wraps a page's ENCODED bytes one layer up, in pager.rs's
    # read_from_disk/write_to_disk") — restated here because this port
    # reaches into pager.rs itself and the same layering boundary holds
    # one level in: the CACHE POLICY (which page id is resident, which
    # is dirty, which is least recently used) is pure bookkeeping over
    # page ids and tick counters, decided entirely before any byte is
    # ever encrypted or decrypted. Eviction only ever decides WHETHER a
    # write-back would be needed (a dirty flag this port tracks
    # faithfully); it never performs one.
    #
    # ============================================================
    # REWRITE NOTE (struct milestone): `PagerInner`'s real fields are a
    # `HashMap<u32, Entry>` (`cache`) plus a `BTreeMap<u64, u32>` ordered
    # by tick (`order`) purely so eviction can find the globally oldest
    # tick in O(log n) via `.iter().next()`. Neither a hash map nor an
    # ordered map exists in this language (LANGUAGE.md's builtin list
    # has no map type at all, only `[T]`), so this cache used to be
    # threaded as three parallel arrays (`ids: [int]` / `ticks: [int]` /
    # `dirty: [bool]`), aligned by hand-maintained index — exactly the
    # shape predicate.fct's own header describes replacing. Now that a
    # proc can declare a real `struct`, one resident page is a real
    # `PagerEntry` value with named fields, and the cache is one
    # `[PagerEntry]` array: `entries[i].tick` reads as what it is,
    # `ticks[i]` (kept in sync with `ids[i]` only by convention) does
    # not. This also collapses what used to be four near-identical
    # "step" procs (`pagerCacheStepIds`/`Ticks`/`Dirty`) into one
    # (`pagerCacheStep`, below), since a single page access now updates
    # one struct's fields instead of three separately-threaded arrays —
    # see that proc's own doc for why `pagerCacheStepEvicted` still has
    # to stay a second, independent proc.
    #
    # There is no `order` array at all: rather than keeping a second
    # structure sorted by tick, `pagerCacheLruVictimIndex` finds the
    # minimum-tick index by a linear scan over `entries` — the direct
    # restatement of what `order.iter().next()` returns (the entry with
    # the smallest key), reached by scanning instead of by a
    # pre-sorted map this language has no primitive for. Tick values are
    # a strictly increasing counter assigned once per access (mirroring
    # `self.tick += 1`), so two entries never tie — the scan's
    # first-minimum tie-break is never actually exercised, just never
    # wrong either.
    #
    # As with PART ONE's page body, no field is ever set in place —
    # `arr[i] = v` does not exist for a struct array either — so every
    # "set"/"remove" below (`pagerCacheSetEntryAt`,
    # `pagerCacheRemoveEntryAt`) is a pure function returning a
    # brand-new array, and every `do` result inside a loop is bound to
    # its own fresh `let` before being folded into an accumulator with a
    # plain, `do`-free reassignment — the same two restrictions PART
    # ONE's own header already documents in full.
    struct PagerEntry:
        id: int
        tick: int
        dirty: bool

    proc pagerDemoEmptyEntries() -> [PagerEntry]:
        return []

    proc pagerSliceEntries(buf: [PagerEntry], start: int, end: int) -> [PagerEntry]:
        let mut out = []
        let mut i = start
        loop i < end:
            out = append(out, buf[i])
            i = i + 1
        return out

    proc pagerConcatEntries(a: [PagerEntry], b: [PagerEntry]) -> [PagerEntry]:
        let mut out = a
        let n = len(b)
        let mut i = 0
        loop i < n:
            out = append(out, b[i])
            i = i + 1
        return out

    # pagerCacheFindIndex: `self.cache.get(&id)` restated as a linear
    # scan over `entries` — the direct analog of predicate.fct's own
    # `rowFieldIndex`.
    proc pagerCacheFindIndex(entries: [PagerEntry], target: int) -> int:
        let n = len(entries)
        let mut i = 0
        let mut found = -1
        loop i < n:
            if found == -1:
                if entries[i].id == target:
                    found = i
            i = i + 1
        return found

    proc pagerCacheSetEntryAt(entries: [PagerEntry], index: int, val: PagerEntry) -> [PagerEntry]:
        let before = do pagerSliceEntries(entries, 0, index)
        let n = len(entries)
        let after = do pagerSliceEntries(entries, index + 1, n)
        let withVal = append(before, val)
        let result = do pagerConcatEntries(withVal, after)
        return result

    proc pagerCacheRemoveEntryAt(entries: [PagerEntry], index: int) -> [PagerEntry]:
        let before = do pagerSliceEntries(entries, 0, index)
        let n = len(entries)
        let after = do pagerSliceEntries(entries, index + 1, n)
        let result = do pagerConcatEntries(before, after)
        return result

    # pagerCacheLruVictimIndex: `order.iter().next()` restated — the
    # index of the resident page with the SMALLEST tick, i.e. the one
    # least recently touched. Returns -1 for an empty cache (mirrors
    # `order.iter().next()` returning `None`).
    proc pagerCacheLruVictimIndex(entries: [PagerEntry]) -> int:
        let n = len(entries)
        if n == 0:
            return -1
        let mut bestIdx = 0
        let mut bestTick = entries[0].tick
        let mut i = 1
        loop i < n:
            if entries[i].tick < bestTick:
                bestTick = entries[i].tick
                bestIdx = i
            i = i + 1
        return bestIdx

    # pagerEntryIds / pagerEntryTicks / pagerEntryDirtyFlags: project one
    # field out of the whole cache as a plain array — used only by this
    # file's own demo fixtures below, which report a scenario's final
    # ids/ticks/dirty flags separately for the build-check view even
    # though they now live in one struct array.
    proc pagerEntryIds(entries: [PagerEntry]) -> [int]:
        let n = len(entries)
        let mut out = []
        let mut i = 0
        loop i < n:
            out = append(out, entries[i].id)
            i = i + 1
        return out

    proc pagerEntryTicks(entries: [PagerEntry]) -> [int]:
        let n = len(entries)
        let mut out = []
        let mut i = 0
        loop i < n:
            out = append(out, entries[i].tick)
            i = i + 1
        return out

    proc pagerEntryDirtyFlags(entries: [PagerEntry]) -> [bool]:
        let n = len(entries)
        let mut out = []
        let mut i = 0
        loop i < n:
            out = append(out, entries[i].dirty)
            i = i + 1
        return out

    # ============================================================
    # THE EVICTION LOOP — `PagerInner::admit`'s `while self.cache.len() >
    # self.capacity { ... }`, restated once for the array result plus
    # once more to trace which id, if any, was actually evicted (a proc
    # returns exactly one typed value, and eviction produces both a new
    # cache AND a "what got evicted" fact — the same two-independent-
    # re-derivations shape this file's header already explains for
    # `pagerCacheStep`/`pagerCacheStepEvicted`, below). Struct fields
    # collapse what used to be three copies of this loop (one per
    # `ids`/`ticks`/`dirty` array) into one: evicting an entry now means
    # removing one `PagerEntry` at an index, not three parallel removes
    # that had to be kept in lockstep by hand. The one Rust guards
    # against evicting is the entry just admitted itself (`if victim_id
    # == id { break }`, needed because a freshly admitted page always
    # carries the newest tick and can only ever be its own cache's
    # minimum when it is the cache's ONLY entry, e.g. a capacity of 0 —
    # see demoScenario3 below for that exact edge case traced by hand).
    # ============================================================
    proc pagerCacheEvictLoop(entries: [PagerEntry], capacity: int, justAdmittedId: int) -> [PagerEntry]:
        let mut cur = entries
        let mut looping = true
        loop looping:
            let n = len(cur)
            if n <= capacity:
                looping = false
            else:
                let victimIdx = do pagerCacheLruVictimIndex(cur)
                if victimIdx == -1:
                    looping = false
                else:
                    let victimId = cur[victimIdx].id
                    if victimId == justAdmittedId:
                        looping = false
                    else:
                        let newCur = do pagerCacheRemoveEntryAt(cur, victimIdx)
                        cur = newCur
        return cur

    proc pagerCacheEvictLoopLastEvicted(entries: [PagerEntry], capacity: int, justAdmittedId: int) -> int:
        let mut cur = entries
        let mut lastEvicted = -1
        let mut looping = true
        loop looping:
            let n = len(cur)
            if n <= capacity:
                looping = false
            else:
                let victimIdx = do pagerCacheLruVictimIndex(cur)
                if victimIdx == -1:
                    looping = false
                else:
                    let victimId = cur[victimIdx].id
                    if victimId == justAdmittedId:
                        looping = false
                    else:
                        let newCur = do pagerCacheRemoveEntryAt(cur, victimIdx)
                        cur = newCur
                        lastEvicted = victimId
        return lastEvicted

    # ============================================================
    # THE TWO TOP-LEVEL STEP PROCS a real caller (a self-hosted Pager)
    # would actually call once per page access — down from four before
    # this file's struct rewrite (`pagerCacheStepIds`/`Ticks`/`Dirty`
    # collapse into the one `pagerCacheStep` below, since a single page
    # access now updates one struct's fields instead of three separately
    # -threaded arrays that had to be kept in sync by hand;
    # `pagerCacheStepEvicted` stays independent for the same reason the
    # eviction loop above does — a proc returns exactly one typed value,
    # and "the updated cache" and "what got evicted" are two different
    # facts about the same access).
    # ============================================================
    # pagerCacheStep: `Pager::read`'s hit branch (bump tick, cache
    # unchanged, dirty untouched) merged with its miss branch (`admit(id,
    # page, false, ...)`), and `Pager::write`'s branch (always `admit(id,
    # page, true, ...)`). Admitting on an existing id changes no resident
    # id and always refreshes its tick, exactly like a hit does; only
    # whether the entry is dirty differs — a read hit leaves it
    # untouched, a write hit sets it true, and either kind of miss admits
    # a fresh entry whose dirty flag is exactly `isWrite` (`false` from a
    # page fault, `true` from writing a brand-new page).
    proc pagerCacheStep(entries: [PagerEntry], capacity: int, id: int, tick: int, isWrite: bool) -> [PagerEntry]:
        let idx = do pagerCacheFindIndex(entries, id)
        if idx != -1:
            let existing = entries[idx]
            let mut newDirty = existing.dirty
            if isWrite:
                newDirty = true
            let updated = PagerEntry{id: existing.id, tick: tick, dirty: newDirty}
            let result = do pagerCacheSetEntryAt(entries, idx, updated)
            return result
        let newEntry = PagerEntry{id: id, tick: tick, dirty: isWrite}
        let appended = append(entries, newEntry)
        let result = do pagerCacheEvictLoop(appended, capacity, id)
        return result

    proc pagerCacheStepEvicted(entries: [PagerEntry], capacity: int, id: int, tick: int) -> int:
        let idx = do pagerCacheFindIndex(entries, id)
        if idx != -1:
            return -1
        let newEntry = PagerEntry{id: id, tick: tick, dirty: false}
        let appended = append(entries, newEntry)
        let result = do pagerCacheEvictLoopLastEvicted(appended, capacity, id)
        return result

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES — three hand-traced scenarios (full
    # arithmetic in the task report):
    #
    # Scenario 1 — classic 3-slot LRU, all reads, page ids/ticks
    # (1,1) (2,2) (3,3) (1,4) (4,5) on a capacity-3 cache: filling the
    # cache with 1,2,3, re-touching 1 (so 2 becomes the oldest), then
    # faulting in 4 evicts 2, not 1 or 3. Expected eviction trace
    # [-1,-1,-1,-1,2]; expected final ids [1,3,4], ticks [4,3,5].
    #
    # Scenario 2 — continues scenario 1, adds two writes: write(3)
    # (a hit — ticks[idx]=6, dirty[idx]=true, nothing evicted) then
    # write(5) (a miss — evicts page 1, the true LRU survivor from
    # scenario 1 that was never touched again, and it evicts CLEAN
    # since page 1's dirty flag was still false). Expected final ids
    # [3,4,5], dirty [true,false,true], evicted-at-this-step 1.
    #
    # Scenario 3 — the `victim_id == id` self-eviction guard: a single
    # access on a capacity-0 cache admits its own only entry, finds
    # itself as the (only, therefore minimum-tick) victim, and refuses
    # to evict itself — the cache is left one page over its target
    # capacity rather than evicting the page the caller is actively
    # using, exactly mirroring the real `admit`'s documented reason for
    # that guard. Expected final ids [1], evicted -1.
    # ============================================================
    proc pagerDemoScenario1EvictedTrace() -> [int]:
        let entries0 = do pagerDemoEmptyEntries()
        let e1 = do pagerCacheStepEvicted(entries0, 3, 1, 1)
        let entries1 = do pagerCacheStep(entries0, 3, 1, 1, false)
        let e2 = do pagerCacheStepEvicted(entries1, 3, 2, 2)
        let entries2 = do pagerCacheStep(entries1, 3, 2, 2, false)
        let e3 = do pagerCacheStepEvicted(entries2, 3, 3, 3)
        let entries3 = do pagerCacheStep(entries2, 3, 3, 3, false)
        let e4 = do pagerCacheStepEvicted(entries3, 3, 1, 4)
        let entries4 = do pagerCacheStep(entries3, 3, 1, 4, false)
        let e5 = do pagerCacheStepEvicted(entries4, 3, 4, 5)
        return [e1, e2, e3, e4, e5]

    # pagerDemoScenario1FinalEntries: the one chain scenario 1's own
    # FinalIds/FinalTicks below both read from — a struct array is one
    # value carrying both facts, so unlike the old parallel-array version
    # (which had to rebuild an `ids` chain and a `ticks` chain
    # separately even though they were always advanced together), there
    # is now exactly one chain to build.
    proc pagerDemoScenario1FinalEntries() -> [PagerEntry]:
        let entries0 = do pagerDemoEmptyEntries()
        let entries1 = do pagerCacheStep(entries0, 3, 1, 1, false)
        let entries2 = do pagerCacheStep(entries1, 3, 2, 2, false)
        let entries3 = do pagerCacheStep(entries2, 3, 3, 3, false)
        let entries4 = do pagerCacheStep(entries3, 3, 1, 4, false)
        let entries5 = do pagerCacheStep(entries4, 3, 4, 5, false)
        return entries5

    proc pagerDemoScenario1FinalIds() -> [int]:
        let entries = do pagerDemoScenario1FinalEntries()
        let ids = do pagerEntryIds(entries)
        return ids

    proc pagerDemoScenario1FinalTicks() -> [int]:
        let entries = do pagerDemoScenario1FinalEntries()
        let ticks = do pagerEntryTicks(entries)
        return ticks

    # pagerDemoScenario2Entries6 / FinalEntries: scenario 2 continues
    # scenario 1 with two writes — write(3) (a hit, step 6) then
    # write(5) (a miss, step 7). Entries6 is kept as its own proc because
    # `pagerCacheStepEvicted` needs the cache AS OF just before step 7,
    # not after it.
    proc pagerDemoScenario2Entries6() -> [PagerEntry]:
        let entries5 = do pagerDemoScenario1FinalEntries()
        let entries6 = do pagerCacheStep(entries5, 3, 3, 6, true)
        return entries6

    proc pagerDemoScenario2FinalEntries() -> [PagerEntry]:
        let entries6 = do pagerDemoScenario2Entries6()
        let entries7 = do pagerCacheStep(entries6, 3, 5, 7, true)
        return entries7

    proc pagerDemoScenario2FinalIds() -> [int]:
        let entries = do pagerDemoScenario2FinalEntries()
        let ids = do pagerEntryIds(entries)
        return ids

    proc pagerDemoScenario2FinalDirty() -> [bool]:
        let entries = do pagerDemoScenario2FinalEntries()
        let dirty = do pagerEntryDirtyFlags(entries)
        return dirty

    proc pagerDemoScenario2EvictedAtStep7() -> int:
        let entries6 = do pagerDemoScenario2Entries6()
        let evicted = do pagerCacheStepEvicted(entries6, 3, 5, 7)
        return evicted

    proc pagerDemoScenario3FinalIds() -> [int]:
        let entries0 = do pagerDemoEmptyEntries()
        let entries1 = do pagerCacheStep(entries0, 0, 1, 1, false)
        let ids = do pagerEntryIds(entries1)
        return ids

    proc pagerDemoScenario3Evicted() -> int:
        let entries0 = do pagerDemoEmptyEntries()
        let e1 = do pagerCacheStepEvicted(entries0, 0, 1, 1)
        return e1

    state demoFreshOk: bool = false
    state demoCorruptedOk: bool = false
    state demoFreeSpaceOk: bool = false
    state demoCrcEmptyOk: bool = false
    state demoCrc9Ok: bool = false

    action runDemoStorage():
        let freshOk = do demoFreshPageOk()
        let corruptedOk = do demoCorruptedPageOk()
        let freeSpaceOk = do demoFreeSpaceCheck()
        let crcEmptyOk = do demoCrc32CheckEmpty()
        let crc9Ok = do demoCrc32Check9()
        demoFreshOk = freshOk
        demoCorruptedOk = corruptedOk
        demoFreeSpaceOk = freeSpaceOk
        demoCrcEmptyOk = crcEmptyOk
        demoCrc9Ok = crc9Ok

    state demoLruEvictedTrace: [int] = []
    state demoLruFinalIds: [int] = []
    state demoLruFinalTicks: [int] = []
    state demoLruWritesFinalIds: [int] = []
    state demoLruWritesFinalDirty: [bool] = []
    state demoLruWritesEvicted: int = 0
    state demoLruZeroCapIds: [int] = []
    state demoLruZeroCapEvicted: int = 0

    action runDemoPagerCache():
        let trace1 = do pagerDemoScenario1EvictedTrace()
        let ids1 = do pagerDemoScenario1FinalIds()
        let ticks1 = do pagerDemoScenario1FinalTicks()
        let ids2 = do pagerDemoScenario2FinalIds()
        let dirty2 = do pagerDemoScenario2FinalDirty()
        let evicted2 = do pagerDemoScenario2EvictedAtStep7()
        let ids3 = do pagerDemoScenario3FinalIds()
        let evicted3 = do pagerDemoScenario3Evicted()
        demoLruEvictedTrace = trace1
        demoLruFinalIds = ids1
        demoLruFinalTicks = ticks1
        demoLruWritesFinalIds = ids2
        demoLruWritesFinalDirty = dirty2
        demoLruWritesEvicted = evicted2
        demoLruZeroCapIds = ids3
        demoLruZeroCapEvicted = evicted3

    # ============================================================
    # PART THREE — the write-ahead log's on-disk frame envelope and its
    # "replay rule", ported from facetql/src/storage/wal.rs (`encode_
    # frame`/`decode_frame`/`FrameOutcome`) and facetql/src/storage/
    # recovery.rs (`classify_transactions`/`classify_transaction`). Read
    # both files in full alongside page.rs/pager.rs before writing this
    # section.
    #
    # ============================================================
    # CRYPTO INVOLVEMENT — CONFIRMED FIRST, AND DIFFERENT FROM PAGE:
    # ============================================================
    # PART ONE's page.rs never calls crypto at all; encryption lives
    # entirely one layer up, in pager.rs. wal.rs is NOT the same shape.
    # Read end to end, `encode_frame` calls `crypto::encrypt(&bytes)`
    # itself, BEFORE building the frame header, and `decode_frame` calls
    # `crypto::decrypt(payload)` itself, AFTER the frame's magic/version/
    # length/CRC have all been checked but BEFORE `bincode::deserialize`
    # ever runs. So — unlike Page/Pager's clean split into a whole
    # crypto-free module and a whole crypto-owning one — wal.rs's own
    # single pair of functions straddles the boundary: structural framing
    # on one side of the `crypto::encrypt`/`crypto::decrypt` call, a
    # structural integrity check (magic/version/length/CRC) on the OTHER
    # side of it too, and the encrypted bytes themselves as the thing
    # that call converts in between.
    #
    # This still leaves a real, well-scoped, crypto-free port available,
    # for the same reason PART ONE's argument works even though it sits
    # in a different place here: EVERY check `encode_frame`/`decode_frame`
    # perform — the magic bytes, the frame version, the length prefix
    # (bounded by `MAX_WAL_PAYLOAD_LEN` before it is ever used to size an
    # allocation or a slice), and the CRC-32 — is computed OVER the
    # payload as an opaque byte string. Nothing about those checks reads
    # what the bytes decrypt to; `crc32(&payload)` is computed on the
    # still-encrypted ciphertext on the write path and verified against
    # the still-encrypted ciphertext on the read path, before decryption
    # is even attempted. So this port draws its crypto line at exactly
    # that byte string — a `payload: [int]` parameter that a real caller
    # would fill with `crypto::encrypt`'s output and a real reader would
    # hand to `crypto::decrypt`, and that this port's own demo fixtures
    # fill with plain placeholder bytes instead, because the frame-level
    # logic provably cannot tell the difference. No call to `crypto::
    # encrypt`/`crypto::decrypt` is implemented or stubbed anywhere below
    # — the same "don't ship unverified crypto" line PART ONE already
    # drew, just landing inside `encode_frame`/`decode_frame` instead of
    # around them.
    #
    # The one remaining post-decrypt check in `decode_frame` —
    # `record.format_version`/`record.sequence`/`record.operation_id`
    # being well-formed — runs on already-decrypted, already-deserialized
    # plain integers. It needs no crypto either (only bytes that have
    # already survived the crypto step do), so it is restated below too,
    # taking those three fields directly as parameters exactly as a
    # caller holding a successfully-decrypted `WalRecord` already would.
    #
    # recovery.rs's `classify_transactions`/`classify_transaction` — the
    # "replay rule" this project elsewhere states as "iff exactly
    # BEGIN...COMMIT, else discard" — runs entirely on ALREADY-DECODED
    # `WalRecord`s (their `sequence`, `transaction_id`, and which
    # `WalOperation` variant they hold). It is downstream of every crypto
    # call in the module and makes none of its own; it is exactly as
    # crypto-free as PART TWO's cache-eviction policy is disk-I/O-free.
    #
    # ============================================================
    # REPRESENTATION:
    # ============================================================
    # A frame is one `[int]` byte buffer, reusing PART ONE's byte-buffer
    # helpers (`sliceBytes`/`concatBytes`/`bytesEqual`/`readU16LE`/
    # `readU32LE`/`writeU16LEBytes`/`writeU32LEBytes`/`replaceBytesRange`)
    # and its `crc32Bytes` — wal.rs's own `crc32` is, by inspection, the
    # byte-for-byte same algorithm as `crc32_parts`/page.rs's CRC (same
    # `0xFFFFFFFF` init, same `0xEDB8_8320` polynomial, same one-bit-at-
    # a-time inner loop, same final complement — restated in wal.rs only
    # because page.rs and wal.rs are different compilation units, not
    # because the algorithm differs), so it is reused rather than
    # re-derived a third time in this same file.
    #
    # REWRITE NOTE (struct milestone): a WAL record's fields relevant to
    # the replay rule used to be threaded as two parallel arrays, one
    # element per record — `seqs: [int]` and `opKinds: [int]`, aligned by
    # hand-maintained index exactly like PART TWO's old cache arrays.
    # That is exactly the kind of "several named facts about one entity"
    # this language's `struct` now has a real answer for: one
    # `WalRecordEntry` value per record, one `[WalRecordEntry]` array in
    # place of the two arrays that a bug could silently desync (a
    # `seqs`/`opKinds` pair built to different lengths, or reordered
    # relative to each other, was never a type error before this — it is
    # now impossible, because there is only one array to build).
    #   seq:    int  the record's `sequence`
    #   opKind: int  the record's `WalOperation` tag, COLLAPSED to
    #                0=Begin, 1=Commit, 2=Abort, or one shared code for
    #                every mutation variant (Insert/Delete/InsertEdge/
    #                DeleteEdge/Archive/...). This mirrors
    #                `classify_transaction`'s own `match`: it has a named
    #                arm for `Begin`/`Commit`/`Abort` and a single `_ =>`
    #                catch-all for every other variant, which treats them
    #                all identically ("mutations cannot occur before
    #                BEGIN" / "...after termination" — never which
    #                mutation). Demo data below still uses distinct codes
    #                (3=Insert, 4=Delete, 5=InsertEdge, 6=DeleteEdge,
    #                7=Archive) purely for readability; the replay-rule
    #                procs themselves only ever ask "is this 0, 1, 2, or
    #                something else."
    # The record array is assumed already filtered to ONE transaction and
    # already in ascending-sequence order. That is not a shortcut: every
    # real caller's input already has this shape before
    # `classify_transaction` runs — `classify_transactions` builds its
    # per-transaction groups by pushing records from `records: &[WalRecord]`
    # in encounter order, and that slice is always `read_all`'s output,
    # which returns records in FILE order (append-only, so file order IS
    # ascending-sequence order); a subsequence of an ascending sequence is
    # itself ascending. `classify_transaction`'s own `ordered.sort_by_key
    # (|r| r.sequence)` is a defensive re-assertion of an invariant that
    # already holds on every real call site's input, not a step that ever
    # changes the order — so it is not reimplemented here, the same way
    # this file elsewhere ports the decision logic and not every
    # belt-and-suspenders restatement of an invariant nothing violates.
    #
    # ============================================================
    # WHY TWO PARALLEL PROCS INSTEAD OF ONE "RESULT":
    # ============================================================
    # A proc returns exactly one typed value, and classifying one
    # transaction produces two independent facts — an outcome
    # (committed / discard / hard-error) and, only when committed, a
    # COMMIT sequence number — so, following PART TWO's own documented
    # precedent for the identical constraint, `walClassifyTransactionOutcome`
    # and `walClassifyTransactionCommitSequence` are two independent
    # re-walks of the SAME control flow: every `return 2` (hard error) in
    # the outcome proc has a line-for-line `return -1` at the identical
    # branch in the commit-sequence proc, and the one branch that
    # actually assigns a value (`commitSeq = records[i].seq` on a valid,
    # final COMMIT) is the only place the two procs' final return values
    # can differ from each other by more than "2 vs. -1" — guaranteeing
    # agreement by construction rather than by cross-checking two
    # independently-invented algorithms.
    struct WalRecordEntry:
        seq: int
        opKind: int
    proc walFrameMagicBytes() -> [int]:
        return [70, 81, 87, 49]

    # ============================================================
    # FRAME ENCODE — `encode_frame`'s structural half (magic + frame
    # version + length prefix + CRC-32), stopping at the `crypto::
    # encrypt`/`bincode::serialize` boundary: `payload` here IS what a
    # real caller would already have run through both (see header note).
    # ============================================================
    proc walPayloadTooLarge(payload: [int]) -> bool:
        return len(payload) > 67108864

    proc walEncodeFrame(payload: [int]) -> [int]:
        let magic = do walFrameMagicBytes()
        let versionBytes = do writeU16LEBytes(1)
        let payloadLen = len(payload)
        let lenBytes = do writeU32LEBytes(payloadLen)
        let crc = do crc32Bytes(payload)
        let crcBytes = do writeU32LEBytes(crc)
        let h1 = do concatBytes(magic, versionBytes)
        let h2 = do concatBytes(h1, lenBytes)
        let header = do concatBytes(h2, crcBytes)
        let frame = do concatBytes(header, payload)
        return frame

    # ============================================================
    # FRAME DECODE — `decode_frame`'s structural half, restated as an
    # outcome CODE (a proc has no `FrameOutcome` enum to return): 0 =
    # Durable, 1 = Torn, 2 = Corrupt. The check ORDER is preserved
    # exactly, including checking the declared payload length against
    # `MAX_WAL_PAYLOAD_LEN` before it is used for anything else — the
    # same "bound the declared length BEFORE it is used" comment
    # decode_frame itself carries.
    # ============================================================
    proc walFrameOutcomeCode(frame: [int]) -> int:
        let n = len(frame)
        if n < 14:
            return 1
        let magic = do sliceBytes(frame, 0, 4)
        let expectedMagic = do walFrameMagicBytes()
        let magicOk = do bytesEqual(magic, expectedMagic)
        if !magicOk:
            return 2
        let frameVersion = do readU16LE(frame, 4)
        if frameVersion != 1:
            return 2
        let payloadLen = do readU32LE(frame, 6)
        if payloadLen > 67108864:
            return 2
        let declaredCrc = do readU32LE(frame, 10)
        let available = n - 14
        if available < payloadLen:
            return 1
        if available > payloadLen:
            return 2
        let payload = do sliceBytes(frame, 14, n)
        let computedCrc = do crc32Bytes(payload)
        if computedCrc != declaredCrc:
            return 2
        return 0

    # walFramePayload: only meaningful when `walFrameOutcomeCode` returns
    # 0 (Durable) — the exact bytes `crypto::decrypt` would be handed
    # next in the real `decode_frame`. Decrypting them is deliberately
    # NOT done here (see header note on crypto scope).
    proc walFramePayload(frame: [int]) -> [int]:
        let n = len(frame)
        let payload = do sliceBytes(frame, 14, n)
        return payload

    # walRecordFieldsOk: the one post-decrypt check in `decode_frame`
    # that needs no crypto of its own — `record.format_version ==
    # WAL_FORMAT_VERSION`, `record.sequence != 0`,
    # `record.operation_id != 0` — taking those three already-decrypted,
    # already-deserialized fields directly as parameters.
    proc walRecordFieldsOk(formatVersion: int, sequence: int, operationId: int) -> bool:
        if formatVersion != 3:
            return false
        if sequence == 0:
            return false
        if operationId == 0:
            return false
        return true

    # ============================================================
    # THE REPLAY RULE — `classify_transaction`, restated over the
    # `[WalRecordEntry]` array described in the header note.
    # ============================================================
    proc walClassifyTransactionOutcome(records: [WalRecordEntry]) -> int:
        let n = len(records)
        if n == 0:
            return 0
        if records[0].opKind != 0:
            # First surviving record isn't BEGIN. A COMMIT anywhere in
            # the set means the log asserts a commit whose opening
            # record is gone — a hard error, never a silent discard
            # (`classify_transaction`'s own "the log was truncated
            # through the middle of a frame" case). No COMMIT at all
            # just means nothing was ever promised: discard.
            let mut i = 0
            let mut hasCommit = false
            loop i < n:
                if records[i].opKind == 1:
                    hasCommit = true
                i = i + 1
            if hasCommit:
                return 2
            return 0
        let mut commitSeq = -1
        let mut aborted = false
        let mut i = 0
        loop i < n:
            let kind = records[i].opKind
            if kind == 0:
                if i != 0:
                    return 2
            if kind == 1:
                if aborted:
                    return 2
                if commitSeq != -1:
                    return 2
                if i != n - 1:
                    return 2
                commitSeq = records[i].seq
            if kind == 2:
                if commitSeq != -1:
                    return 2
                if aborted:
                    return 2
                if i != n - 1:
                    return 2
                aborted = true
            if kind != 0 && kind != 1 && kind != 2:
                if i == 0:
                    return 2
                if commitSeq != -1 || aborted:
                    return 2
            i = i + 1
        if commitSeq != -1:
            return 1
        return 0

    # walClassifyTransactionCommitSequence: see header note — the same
    # walk as `walClassifyTransactionOutcome`, returning -1 wherever that
    # proc returns 2 (hard error) or 0-via-no-commit (discard), and the
    # actual COMMIT sequence wherever it returns 1 (committed).
    proc walClassifyTransactionCommitSequence(records: [WalRecordEntry]) -> int:
        let n = len(records)
        if n == 0:
            return -1
        if records[0].opKind != 0:
            return -1
        let mut commitSeq = -1
        let mut aborted = false
        let mut i = 0
        loop i < n:
            let kind = records[i].opKind
            if kind == 0:
                if i != 0:
                    return -1
            if kind == 1:
                if aborted:
                    return -1
                if commitSeq != -1:
                    return -1
                if i != n - 1:
                    return -1
                commitSeq = records[i].seq
            if kind == 2:
                if commitSeq != -1:
                    return -1
                if aborted:
                    return -1
                if i != n - 1:
                    return -1
                aborted = true
            if kind != 0 && kind != 1 && kind != 2:
                if i == 0:
                    return -1
                if commitSeq != -1 || aborted:
                    return -1
            i = i + 1
        return commitSeq

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES — frame envelope.
    # ============================================================
    # A clean payload framed and decoded should read back Durable with
    # the original payload intact; a single flipped payload byte should
    # fail the CRC (Corrupt); dropping the last few bytes should read as
    # Torn (a structurally short frame, the exact shape a crash mid-
    # `write_all` leaves — see `WalHandle::write_line`'s own comment on
    # why the frame and its newline go out as one write).
    proc walDemoPayload() -> [int]:
        # Stands in for whatever bytes `crypto::encrypt` would have
        # produced over a real bincode-serialized `WalRecord`; the frame
        # envelope's own checks cannot tell placeholder bytes from real
        # ciphertext (see header note), so any concrete bytes exercise
        # the same logic.
        return [1, 2, 3, 4, 5, 6, 7, 8]

    proc walDemoCleanFrame() -> [int]:
        let payload = do walDemoPayload()
        let frame = do walEncodeFrame(payload)
        return frame

    proc walDemoCleanFrameOutcome() -> int:
        let frame = do walDemoCleanFrame()
        let outcome = do walFrameOutcomeCode(frame)
        return outcome

    proc walDemoPayloadRoundtripOk() -> bool:
        let frame = do walDemoCleanFrame()
        let original = do walDemoPayload()
        let extracted = do walFramePayload(frame)
        let eq = do bytesEqual(extracted, original)
        return eq

    proc walDemoCorruptFrame() -> [int]:
        let frame = do walDemoCleanFrame()
        let corrupted = do replaceBytesRange(frame, 14, [255])
        return corrupted

    proc walDemoCorruptFrameOutcome() -> int:
        let frame = do walDemoCorruptFrame()
        let outcome = do walFrameOutcomeCode(frame)
        return outcome

    proc walDemoTornFrame() -> [int]:
        let frame = do walDemoCleanFrame()
        let n = len(frame)
        let torn = do sliceBytes(frame, 0, n - 3)
        return torn

    proc walDemoTornFrameOutcome() -> int:
        let frame = do walDemoTornFrame()
        let outcome = do walFrameOutcomeCode(frame)
        return outcome

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES — the replay rule. Full hand-traced
    # arithmetic in the task report; summary:
    #
    # Scenario 1 — clean BEGIN(10) -> Insert(11) -> COMMIT(12): the
    # textbook committed transaction. Expected outcome 1, commit
    # sequence 12.
    #
    # Scenario 2 — BEGIN(20) -> Insert(21), no COMMIT (the process died,
    # or a scan is running against a still-open transaction). Expected
    # outcome 0 (discard), commit sequence -1.
    #
    # Scenario 3 — BEGIN(30) -> Insert(31) -> ABORT(32): explicitly
    # aborted. Expected outcome 0 (discard, same as scenario 2 — an
    # abort and a crash before COMMIT are indistinguishable to a
    # replayer, by design), commit sequence -1.
    #
    # Scenario 4 — mutation(41) -> COMMIT(42), no BEGIN at all: the
    # log asserts a commit whose opening record is missing. Expected
    # outcome 2 (hard error, NOT a silent discard) — the one case this
    # rule refuses to guess about.
    # ============================================================
    proc walDemoScenarioCommittedRecords() -> [WalRecordEntry]:
        return [WalRecordEntry{seq: 10, opKind: 0}, WalRecordEntry{seq: 11, opKind: 3}, WalRecordEntry{seq: 12, opKind: 1}]

    proc walDemoScenarioNoCommitRecords() -> [WalRecordEntry]:
        return [WalRecordEntry{seq: 20, opKind: 0}, WalRecordEntry{seq: 21, opKind: 3}]

    proc walDemoScenarioAbortedRecords() -> [WalRecordEntry]:
        return [WalRecordEntry{seq: 30, opKind: 0}, WalRecordEntry{seq: 31, opKind: 3}, WalRecordEntry{seq: 32, opKind: 2}]

    proc walDemoScenarioHardErrorRecords() -> [WalRecordEntry]:
        return [WalRecordEntry{seq: 41, opKind: 3}, WalRecordEntry{seq: 42, opKind: 1}]

    proc walDemoCommittedOutcome() -> int:
        let records = do walDemoScenarioCommittedRecords()
        let outcome = do walClassifyTransactionOutcome(records)
        return outcome

    proc walDemoCommittedSeq() -> int:
        let records = do walDemoScenarioCommittedRecords()
        let seq = do walClassifyTransactionCommitSequence(records)
        return seq

    proc walDemoNoCommitOutcome() -> int:
        let records = do walDemoScenarioNoCommitRecords()
        let outcome = do walClassifyTransactionOutcome(records)
        return outcome

    proc walDemoAbortedOutcome() -> int:
        let records = do walDemoScenarioAbortedRecords()
        let outcome = do walClassifyTransactionOutcome(records)
        return outcome

    proc walDemoHardErrorOutcome() -> int:
        let records = do walDemoScenarioHardErrorRecords()
        let outcome = do walClassifyTransactionOutcome(records)
        return outcome

    state demoWalCleanOutcome: int = -1
    state demoWalRoundtripOk: bool = false
    state demoWalCorruptOutcome: int = -1
    state demoWalTornOutcome: int = -1
    state demoWalCommittedOutcome: int = -1
    state demoWalCommittedSeq: int = -1
    state demoWalNoCommitOutcome: int = -1
    state demoWalAbortedOutcome: int = -1
    state demoWalHardErrorOutcome: int = -1

    action runDemoWal():
        let cleanOutcome = do walDemoCleanFrameOutcome()
        let roundtripOk = do walDemoPayloadRoundtripOk()
        let corruptOutcome = do walDemoCorruptFrameOutcome()
        let tornOutcome = do walDemoTornFrameOutcome()
        let committedOutcome = do walDemoCommittedOutcome()
        let committedSeq = do walDemoCommittedSeq()
        let noCommitOutcome = do walDemoNoCommitOutcome()
        let abortedOutcome = do walDemoAbortedOutcome()
        let hardErrorOutcome = do walDemoHardErrorOutcome()
        demoWalCleanOutcome = cleanOutcome
        demoWalRoundtripOk = roundtripOk
        demoWalCorruptOutcome = corruptOutcome
        demoWalTornOutcome = tornOutcome
        demoWalCommittedOutcome = committedOutcome
        demoWalCommittedSeq = committedSeq
        demoWalNoCommitOutcome = noCommitOutcome
        demoWalAbortedOutcome = abortedOutcome
        demoWalHardErrorOutcome = hardErrorOutcome

    private view Home at "/":
        box:
            text "{demoFreshOk} {demoCorruptedOk} {demoFreeSpaceOk} {demoCrcEmptyOk} {demoCrc9Ok}"
            text "{demoLruEvictedTrace} {demoLruFinalIds} {demoLruFinalTicks} {demoLruWritesFinalIds} {demoLruWritesFinalDirty} {demoLruWritesEvicted} {demoLruZeroCapIds} {demoLruZeroCapEvicted}"
            text "{demoWalCleanOutcome} {demoWalRoundtripOk} {demoWalCorruptOutcome} {demoWalTornOutcome} {demoWalCommittedOutcome} {demoWalCommittedSeq} {demoWalNoCommitOutcome} {demoWalAbortedOutcome} {demoWalHardErrorOutcome}"
