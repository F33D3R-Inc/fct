app FabricMlSelfHost:
    # Self-hosting port of fabric/crates/fabric-ml/src/ IN FULL — features.rs
    # (58L: WorkloadFeatures + its one `From<&WorkloadProfile>` conversion)
    # and predictor.rs (147L: HotspotPrediction, AnomalyScore,
    # WorkloadPredictor + its four real methods: predict_hotspot,
    # detect_anomaly, and their two private helpers hotspot_probability/
    # anomaly_score, plus the public threshold() getter). lib.rs (8L) is
    # just re-exports, nothing to port. Both files read in full before
    # writing a line here; no method or field was skipped. `cargo test -p
    # fabric-ml --lib` confirmed: 0 tests exist in this crate (no
    # `#[cfg(test)]` module anywhere), so every check below is a hand-trace
    # against the real Rust source, not a pre-existing test port.
    #
    # ============================================================
    # IMPORTANT CORRECTION TO THIS TASK'S OWN BRIEF — fabric-workload is
    # NOT untouched.
    # ============================================================
    # This task's brief describes `fabric-workload` (profile.rs 145L +
    # analyzer.rs 80L + lib.rs 11L) as "fully untouched" and asks for it to
    # be ported together with fabric-ml in one new file. That is incorrect:
    # `fct/selfhost/fabric_telemetry.fct` (read in full before writing this
    # file, per this task's own instruction) already ports fabric-workload
    # COMPLETELY — its own header says so explicitly ("PLUS fabric/crates/
    # fabric-workload/src/ in full — analyzer.rs (81L: WorkloadKey,
    # WorkloadAnalyzer) and profile.rs (146L: PressureLevel, WorkloadProfile,
    # WorkloadProfile::from_metrics + its private calculate_pressure)"), and
    # line-by-line comparison against the real Rust confirms every field,
    # every method, and every boundary condition is present there:
    #   - `PressureLevel::from_score`      -> `pressureLevelFromScore`
    #   - `WorkloadProfile::from_metrics`  -> `workloadProfileFromMetrics`
    #     (private `calculate_pressure`   -> `workloadPressureScore`)
    #   - `WorkloadProfile::is_hot`        -> `workloadProfileIsHot`
    #   - `WorkloadKey::new`               -> `workloadKeyNew` (+ `Eq`/`Hash`
    #     stand-in `workloadKeyEquals`, since this language has no derived
    #     trait machinery)
    #   - `WorkloadAnalyzer::{new,observe,profile,hot_coordinates,profiles,
    #     len,is_empty}` -> `workloadAnalyzer{New,Observe,Profile,
    #     HotCoordinates,Profiles,Len,IsEmpty}`, `HashMap<WorkloadKey,
    #     WorkloadProfile>` restated as the linear-scan `[WorkloadProfileEntry]`
    #     this directory's own established convention already uses elsewhere.
    # `fabric-workload` and `fabric-telemetry`'s "analyzer" concerns are, on
    # inspection, THE SAME real thing, not two distinct crates covering
    # different concerns: `fabric-workload` is not an independent leaf with
    # its own subject matter — it is entirely telemetry's own consumer,
    # built on nothing but `fabric_telemetry::{Observation, WorkloadMetrics,
    # CellWorkloadMetrics}` read at their exact real shape (grepped directly
    # in fabric-workload/src/{analyzer,profile}.rs: no other crate is
    # imported besides `fabric_core` for `Coordinate`/`Shard`). That is
    # exactly the reasoning fabric_telemetry.fct's own header already gives
    # for combining the two crates into one file, and having read both
    # crates independently for this task, that reasoning holds up.
    #
    # So there is no fabric-workload logic left to port, and this file does
    # NOT duplicate `WorkloadKey`/`WorkloadAnalyzer`/`PressureLevel`/
    # `WorkloadProfile::from_metrics` — that would be exact rework of
    # already-correct, already-verified code, forbidden by this task's own
    # root-solutions rule. This file is named `fabric_ml.fct`, not
    # `fabric_workload.fct`, so it does not claim to contain a port it does
    # not: it ports ONLY the genuinely unported crate, fabric-ml.
    #
    # ============================================================
    # WHY A SEPARATE FILE, NOT MERGED INTO fabric_telemetry.fct
    # ============================================================
    # This task's own brief leaves the split/combine choice to judgment.
    # Unlike fabric-workload's relationship to fabric-telemetry (identical
    # shape, zero narrowing, the same real concern), fabric-ml IS a
    # genuinely distinct concern from telemetry/workload: it is a baseline
    # PREDICTION model (`WorkloadPredictor::{predict_hotspot,detect_anomaly}`)
    # that reads a `WorkloadProfile` as input but computes its own separate
    # numerical feature vector and its own separate scoring formulas found
    # nowhere in fabric-telemetry or fabric-workload. Since this task's
    # instructions were not to edit fabric_telemetry.fct, and since this
    # directory's established convention has no cross-file `import`
    # (confirmed again here, same as fabric_telemetry.fct's own header
    # already confirmed for fabric_routing.fct/fabric_replication.fct), a
    # separate `fabric_ml.fct` is the only option that (a) does not touch
    # the already-correct existing file and (b) does not force a fake
    # single-file merge of two files' unrelated demo/state sections. The
    # cost is the same one every other file in this directory already pays:
    # `Coordinate` and `WorkloadProfile`'s exact shape are restated below,
    # field-for-field identical to fabric_telemetry.fct's own copies (which
    # are themselves the real Rust shape) — the SAME "no import mechanism
    # exists, so every file owns its own copy" convention fabric_core.fct's
    # and fabric_routing.fct's own headers already establish for
    # `Coordinate` itself.
    #
    # ============================================================
    # REPRESENTATION CHOICES
    # ============================================================
    # `WorkloadProfile` here is NOT narrowed the way fabric_telemetry.fct's
    # own `ObservationShard` deliberately narrows `Shard` — every real field
    # `fabric_workload::WorkloadProfile` carries is restated here too (even
    # `cellBreakdown`/`cellBreakdownPartial`/`pressure`, which
    # `WorkloadFeatures::from` never reads), because `WorkloadPredictor::
    # predict_hotspot`/`detect_anomaly` take the real type BY REFERENCE, not
    # a hand-picked subset of it — narrowing the input type itself (as
    # opposed to narrowing which of its fields get read internally) would be
    # a real, dishonest divergence from the actual function signature, not
    # an honest one like `ObservationShard`'s documented case.
    #
    # `WorkloadFeatures`'s three `u64`-as-`f64` casts (`storage_bytes_per_
    # second as f64`, `network_in_bytes_per_second as f64`,
    # `network_out_bytes_per_second as f64`) and its `queue_depth as f64`
    # cast are all `toFloat(...)`, this language's int-to-float conversion
    # builtin (already used the same way in fabric_telemetry.fct's own
    # `toFloat(m.queueDepth)`).
    #
    # `f64::clamp`/`f64::max` (no clamp builtin, per fabric_telemetry.fct's
    # own header) are restated via the identical `clampFloat(v, lo, hi) =
    # max(lo, min(v, hi))` helper fabric_telemetry.fct already defines —
    # duplicated here rather than imported, for the same no-cross-file-
    # import reason as `Coordinate`/`WorkloadProfile` above.
    #
    # ONE GENUINE, HONEST OBSERVATION about the real Rust logic itself (not
    # a porting gap): `WorkloadPredictor.hotspot_threshold` — set by `new()`/
    # `Default` and readable via `threshold()` — is NEVER actually consulted
    # by `hotspot_probability` or by `HotspotPrediction::is_likely_hot`
    # (which hardcodes its own `>= 0.80` literal, independent of whatever
    # threshold the predictor was constructed with). This is exactly what
    # the real source does — verified by reading predictor.rs's full body,
    # not a porting mistake — so `workloadPredictorHotspotThreshold` is
    # restated as a plain stored-and-returned field with no effect on
    # `workloadPredictorPredictHotspot`'s own math, matching the real
    # (apparently unfinished/baseline) behavior exactly rather than "fixing"
    # it into a threshold that actually gates something.

    # ============================================================
    # SHARED SHAPE — restated field-for-field from fabric_core::Coordinate
    # and fabric_telemetry::{CellWorkloadMetrics, WorkloadMetrics-derived
    # WorkloadProfile}, per this file's header.
    # ============================================================
    struct Coordinate:
        x: int
        y: int

    struct CellWorkloadMetrics:
        x: int
        y: int
        z: int
        q: int
        readsPerSecond: float
        writesPerSecond: float
        bytesReadPerSecond: float
        bytesWrittenPerSecond: float

    struct WorkloadProfile:
        shardId: int
        coordinate: Coordinate
        operationsPerSecond: float
        readRatio: float
        writeRatio: float
        readLatencyUs: float
        writeLatencyUs: float
        cpuUtilization: float
        memoryUtilization: float
        storageBytesPerSecond: int
        networkInBytesPerSecond: int
        networkOutBytesPerSecond: int
        queueDepth: int
        cellBreakdown: [CellWorkloadMetrics]
        cellBreakdownPartial: bool
        pressureScore: float
        pressure: text

    # clampFloat: `f64::clamp` restated, same expansion as
    # fabric_telemetry.fct's own copy (no clamp builtin in this language).
    proc clampFloat(v: float, lo: float, hi: float) -> float:
        let capped = min(v, hi)
        return max(lo, capped)

    # ============================================================
    # features.rs — WorkloadFeatures, the numerical feature vector fed to
    # every model below. Pure passthrough plus int-to-float casts, exactly
    # like the real `From<&WorkloadProfile>` impl.
    # ============================================================
    struct WorkloadFeatures:
        coordinate: Coordinate
        operationsPerSecond: float
        readRatio: float
        writeRatio: float
        readLatencyUs: float
        writeLatencyUs: float
        cpuUtilization: float
        memoryUtilization: float
        storageBytesPerSecond: float
        networkInBytesPerSecond: float
        networkOutBytesPerSecond: float
        queueDepth: float
        pressureScore: float

    # workloadFeaturesFromProfile: `WorkloadFeatures::from(profile:
    # &WorkloadProfile)` — `storage_bytes_per_second`/
    # `network_in_bytes_per_second`/`network_out_bytes_per_second`/
    # `queue_depth` are the four fields cast `as f64`; every other field
    # copies straight through unchanged, same as the real struct literal.
    proc workloadFeaturesFromProfile(profile: WorkloadProfile) -> WorkloadFeatures:
        return WorkloadFeatures{coordinate: profile.coordinate, operationsPerSecond: profile.operationsPerSecond, readRatio: profile.readRatio, writeRatio: profile.writeRatio, readLatencyUs: profile.readLatencyUs, writeLatencyUs: profile.writeLatencyUs, cpuUtilization: profile.cpuUtilization, memoryUtilization: profile.memoryUtilization, storageBytesPerSecond: toFloat(profile.storageBytesPerSecond), networkInBytesPerSecond: toFloat(profile.networkInBytesPerSecond), networkOutBytesPerSecond: toFloat(profile.networkOutBytesPerSecond), queueDepth: toFloat(profile.queueDepth), pressureScore: profile.pressureScore}

    # ============================================================
    # predictor.rs — HotspotPrediction, AnomalyScore, WorkloadPredictor.
    # ============================================================
    struct HotspotPrediction:
        coordinate: Coordinate
        probability: float

    # hotspotPredictionIsLikelyHot: hardcoded `>= 0.80`, independent of any
    # predictor's own configurable threshold — see this file's header.
    proc hotspotPredictionIsLikelyHot(p: HotspotPrediction) -> bool:
        return p.probability >= 0.80

    struct AnomalyScore:
        coordinate: Coordinate
        score: float

    proc anomalyScoreIsAnomalous(a: AnomalyScore) -> bool:
        return a.score >= 0.80

    struct WorkloadPredictor:
        hotspotThreshold: float

    # workloadPredictorDefault: `impl Default for WorkloadPredictor` ->
    # hotspot_threshold: 0.75.
    proc workloadPredictorDefault() -> WorkloadPredictor:
        return WorkloadPredictor{hotspotThreshold: 0.75}

    # workloadPredictorNew: `WorkloadPredictor::new` clamps its argument
    # into [0.0, 1.0] before storing it.
    proc workloadPredictorNew(hotspotThreshold: float) -> WorkloadPredictor:
        let clamped = do clampFloat(hotspotThreshold, 0.0, 1.0)
        return WorkloadPredictor{hotspotThreshold: clamped}

    # workloadPredictorHotspotProbability: private `hotspot_probability` —
    # four weighted, clamped terms (pressure 0.45, latency 0.15 of
    # worst(read,write)/100_000, queue 0.20 of queueDepth/10_000, resource
    # 0.20 of cpu*0.6+memory*0.4), summed then clamped again. Does NOT read
    # `self.hotspot_threshold` at all, exactly like the real method body.
    proc workloadPredictorHotspotProbability(features: WorkloadFeatures) -> float:
        let pressure = features.pressureScore
        let worstLatency = max(features.readLatencyUs, features.writeLatencyUs)
        let latencyRaw = worstLatency / 100000.0
        let latencyPressure = do clampFloat(latencyRaw, 0.0, 1.0)
        let queueRaw = features.queueDepth / 10000.0
        let queuePressure = do clampFloat(queueRaw, 0.0, 1.0)
        let resourcePressure = (features.cpuUtilization * 0.6) + (features.memoryUtilization * 0.4)
        let probability = (pressure * 0.45) + (latencyPressure * 0.15) + (queuePressure * 0.20) + (resourcePressure * 0.20)
        let clamped = do clampFloat(probability, 0.0, 1.0)
        return clamped

    # workloadPredictorPredictHotspot: `WorkloadPredictor::predict_hotspot`.
    proc workloadPredictorPredictHotspot(predictor: WorkloadPredictor, profile: WorkloadProfile) -> HotspotPrediction:
        let features = do workloadFeaturesFromProfile(profile)
        let probability = do workloadPredictorHotspotProbability(features)
        return HotspotPrediction{coordinate: features.coordinate, probability: probability}

    # workloadPredictorAnomalyScore: private `anomaly_score` — four
    # over-threshold terms (cpu over 0.80 scaled by 0.20, memory over 0.80
    # scaled by 0.20, queue over 10_000 scaled by 10_000, latency over
    # 50_000 scaled by 50_000), each floored at 0.0 (`f64::max(_, 0.0)`,
    # NOT clamped to 1.0 individually — only the final weighted sum is
    # clamped), weighted 0.30/0.20/0.25/0.25 and summed, then clamped once.
    proc workloadPredictorAnomalyScore(features: WorkloadFeatures) -> float:
        let cpuRaw = (features.cpuUtilization - 0.80) / 0.20
        let cpuAnomaly = max(cpuRaw, 0.0)
        let memoryRaw = (features.memoryUtilization - 0.80) / 0.20
        let memoryAnomaly = max(memoryRaw, 0.0)
        let queueRaw = (features.queueDepth - 10000.0) / 10000.0
        let queueAnomaly = max(queueRaw, 0.0)
        let latency = max(features.readLatencyUs, features.writeLatencyUs)
        let latencyRaw = (latency - 50000.0) / 50000.0
        let latencyAnomaly = max(latencyRaw, 0.0)
        let score = (cpuAnomaly * 0.30) + (memoryAnomaly * 0.20) + (queueAnomaly * 0.25) + (latencyAnomaly * 0.25)
        let clamped = do clampFloat(score, 0.0, 1.0)
        return clamped

    # workloadPredictorDetectAnomaly: `WorkloadPredictor::detect_anomaly`.
    proc workloadPredictorDetectAnomaly(predictor: WorkloadPredictor, profile: WorkloadProfile) -> AnomalyScore:
        let features = do workloadFeaturesFromProfile(profile)
        let score = do workloadPredictorAnomalyScore(features)
        return AnomalyScore{coordinate: features.coordinate, score: score}

    proc workloadPredictorThreshold(predictor: WorkloadPredictor) -> float:
        return predictor.hotspotThreshold

    # floatApproxEquals: NOT part of the Rust port — a demo-assertion-only
    # helper. `f64` arithmetic (in Rust exactly as in this language) does
    # not represent decimals like 0.1 exactly in binary, so a sum of
    # several such terms (e.g. 0.64*0.45 + 0.5*0.15 + 0.5*0.20 + 0.74*0.20)
    # lands a few ULPs away from the literal "0.611" a human would write
    # down for it — the real Rust code has the exact same rounding, it is
    # simply never compared with `==` against a hand-typed literal there.
    # This tolerance-based check exists ONLY so this file's own demo procs
    # can assert against a human-readable expected value without that
    # unrelated float-formatting noise; it changes nothing about the ported
    # logic itself.
    proc floatApproxEquals(a: float, b: float) -> bool:
        let diff = abs(a - b)
        return diff < 0.0000001

    proc workloadProfileZero() -> WorkloadProfile:
        return WorkloadProfile{shardId: 0, coordinate: Coordinate{x: 0, y: 0}, operationsPerSecond: 0.0, readRatio: 0.0, writeRatio: 0.0, readLatencyUs: 0.0, writeLatencyUs: 0.0, cpuUtilization: 0.0, memoryUtilization: 0.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 0, cellBreakdown: [], cellBreakdownPartial: false, pressureScore: 0.0, pressure: "normal"}

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURES — each proc below hand-traces one piece
    # of real Rust behavior against a literal, precomputed expectation. No
    # `cargo test` exists for fabric-ml (confirmed: `cargo test -p
    # fabric-ml --lib` reports 0 tests), so these are the verification.
    # ============================================================

    # D1: WorkloadFeatures::from — the SAME profile numbers
    # fabric_telemetry.fct's own `demoWorkloadPressureScoreAndProfile`
    # already hand-traces (cpu=0.90, memory=0.50, queueDepth=5000,
    # readLatencyUs=50000, writeLatencyUs=30000, reads=300, writes=100 ->
    # total=400, readRatio=0.75, writeRatio=0.25, pressureScore=0.64),
    # reused here as a cross-file regression check: the cast fields
    # (storage/network/queue) become floats with identical numeric value.
    proc demoWorkloadFeaturesFromProfile() -> bool:
        let profile = WorkloadProfile{shardId: 42, coordinate: Coordinate{x: 3, y: 4}, operationsPerSecond: 400.0, readRatio: 0.75, writeRatio: 0.25, readLatencyUs: 50000.0, writeLatencyUs: 30000.0, cpuUtilization: 0.90, memoryUtilization: 0.50, storageBytesPerSecond: 7, networkInBytesPerSecond: 8, networkOutBytesPerSecond: 9, queueDepth: 5000, cellBreakdown: [], cellBreakdownPartial: true, pressureScore: 0.64, pressure: "elevated"}
        let features = do workloadFeaturesFromProfile(profile)
        let coordOk = features.coordinate.x == 3 && features.coordinate.y == 4
        let opsOk = features.operationsPerSecond == 400.0
        let ratiosOk = features.readRatio == 0.75 && features.writeRatio == 0.25
        let latencyOk = features.readLatencyUs == 50000.0 && features.writeLatencyUs == 30000.0
        let resourceOk = features.cpuUtilization == 0.90 && features.memoryUtilization == 0.50
        let castOk = features.storageBytesPerSecond == 7.0 && features.networkInBytesPerSecond == 8.0 && features.networkOutBytesPerSecond == 9.0 && features.queueDepth == 5000.0
        let pressureOk = features.pressureScore == 0.64
        return coordOk && opsOk && ratiosOk && latencyOk && resourceOk && castOk && pressureOk

    # D2: predict_hotspot on that same moderate profile — pressure=0.64,
    # latencyPressure=max(50000,30000)/100000=0.5, queuePressure=5000/10000
    # =0.5, resourcePressure=0.90*0.6+0.50*0.4=0.74. probability =
    # 0.64*0.45 + 0.5*0.15 + 0.5*0.20 + 0.74*0.20
    #           = 0.288 + 0.075 + 0.10 + 0.148 = 0.611, below the hardcoded
    # 0.80 is_likely_hot line -> not likely hot.
    proc demoPredictHotspotModerate() -> bool:
        let profile = WorkloadProfile{shardId: 42, coordinate: Coordinate{x: 3, y: 4}, operationsPerSecond: 400.0, readRatio: 0.75, writeRatio: 0.25, readLatencyUs: 50000.0, writeLatencyUs: 30000.0, cpuUtilization: 0.90, memoryUtilization: 0.50, storageBytesPerSecond: 7, networkInBytesPerSecond: 8, networkOutBytesPerSecond: 9, queueDepth: 5000, cellBreakdown: [], cellBreakdownPartial: false, pressureScore: 0.64, pressure: "elevated"}
        let predictor = do workloadPredictorDefault()
        let prediction = do workloadPredictorPredictHotspot(predictor, profile)
        let coordOk = prediction.coordinate.x == 3 && prediction.coordinate.y == 4
        let probOk = do floatApproxEquals(prediction.probability, 0.611)
        let likely = do hotspotPredictionIsLikelyHot(prediction)
        return coordOk && probOk && !likely

    # D3: detect_anomaly on the same moderate profile — cpuAnomaly=
    # (0.90-0.80)/0.20=0.5, memoryAnomaly=max((0.50-0.80)/0.20,0.0)=
    # max(-1.5,0.0)=0.0, queueAnomaly=max((5000-10000)/10000,0.0)=
    # max(-0.5,0.0)=0.0, latency=50000, latencyAnomaly=max((50000-50000)
    # /50000,0.0)=0.0. score = 0.5*0.30 + 0*0.20 + 0*0.25 + 0*0.25 = 0.15,
    # below 0.80 -> not anomalous.
    proc demoDetectAnomalyModerate() -> bool:
        let profile = WorkloadProfile{shardId: 42, coordinate: Coordinate{x: 3, y: 4}, operationsPerSecond: 400.0, readRatio: 0.75, writeRatio: 0.25, readLatencyUs: 50000.0, writeLatencyUs: 30000.0, cpuUtilization: 0.90, memoryUtilization: 0.50, storageBytesPerSecond: 7, networkInBytesPerSecond: 8, networkOutBytesPerSecond: 9, queueDepth: 5000, cellBreakdown: [], cellBreakdownPartial: false, pressureScore: 0.64, pressure: "elevated"}
        let predictor = do workloadPredictorDefault()
        let anomaly = do workloadPredictorDetectAnomaly(predictor, profile)
        let scoreOk = do floatApproxEquals(anomaly.score, 0.15)
        let anomalous = do anomalyScoreIsAnomalous(anomaly)
        return scoreOk && !anomalous

    # D4: extreme profile — every raw term saturates so both clamps
    # (probability and anomaly score) actually engage. pressure=1.0,
    # latencyPressure=max(200000,200000)/100000=2.0 -> clamp 1.0,
    # queuePressure=20000/10000=2.0 -> clamp 1.0, resourcePressure=
    # 1.0*0.6+1.0*0.4=1.0. probability = 1.0*0.45+1.0*0.15+1.0*0.20+1.0*0.20
    # = 1.0 exactly, clamp is a no-op here but IS exercised on the
    # pre-clamp per-term values above. is_likely_hot: 1.0 >= 0.80 -> true.
    # anomaly: cpuAnomaly=(1.0-0.80)/0.20=1.0, memoryAnomaly=1.0,
    # queueAnomaly=(20000-10000)/10000=1.0, latency=200000, latencyAnomaly=
    # (200000-50000)/50000=3.0 (unclamped per-term, per the real source).
    # score = 1.0*0.30+1.0*0.20+1.0*0.25+3.0*0.25 = 0.30+0.20+0.25+0.75=1.50,
    # clamped down to 1.0 by the FINAL clamp only -> anomalous.
    proc demoExtremeProfileSaturatesBothClamps() -> bool:
        let profile = WorkloadProfile{shardId: 7, coordinate: Coordinate{x: 1, y: 1}, operationsPerSecond: 2.0, readRatio: 0.5, writeRatio: 0.5, readLatencyUs: 200000.0, writeLatencyUs: 200000.0, cpuUtilization: 1.0, memoryUtilization: 1.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 20000, cellBreakdown: [], cellBreakdownPartial: false, pressureScore: 1.0, pressure: "critical"}
        let predictor = do workloadPredictorDefault()
        let prediction = do workloadPredictorPredictHotspot(predictor, profile)
        let anomaly = do workloadPredictorDetectAnomaly(predictor, profile)
        let probOk = prediction.probability == 1.0
        let likely = do hotspotPredictionIsLikelyHot(prediction)
        let scoreOk = anomaly.score == 1.0
        let anomalous = do anomalyScoreIsAnomalous(anomaly)
        return probOk && likely && scoreOk && anomalous

    # D5: threshold construction — `Default` gives 0.75; `new` clamps an
    # out-of-range argument into [0.0, 1.0] on both sides; the stored
    # threshold has NO effect on predict_hotspot's own math (see header) —
    # confirmed here by running the same extreme profile through two
    # predictors built with very different thresholds and getting the
    # identical probability back either way.
    proc demoThresholdConstructionAndIndependence() -> bool:
        let def = do workloadPredictorDefault()
        let defOk = def.hotspotThreshold == 0.75
        let tooHigh = do workloadPredictorNew(1.5)
        let highOk = tooHigh.hotspotThreshold == 1.0
        let tooLow = do workloadPredictorNew(-0.5)
        let lowOk = tooLow.hotspotThreshold == 0.0
        let mid = do workloadPredictorNew(0.42)
        let midThreshold = do workloadPredictorThreshold(mid)
        let midResultOk = midThreshold == 0.42
        let profile = WorkloadProfile{shardId: 7, coordinate: Coordinate{x: 1, y: 1}, operationsPerSecond: 2.0, readRatio: 0.5, writeRatio: 0.5, readLatencyUs: 200000.0, writeLatencyUs: 200000.0, cpuUtilization: 1.0, memoryUtilization: 1.0, storageBytesPerSecond: 0, networkInBytesPerSecond: 0, networkOutBytesPerSecond: 0, queueDepth: 20000, cellBreakdown: [], cellBreakdownPartial: false, pressureScore: 1.0, pressure: "critical"}
        let predictionLow = do workloadPredictorPredictHotspot(tooLow, profile)
        let predictionHigh = do workloadPredictorPredictHotspot(tooHigh, profile)
        let independentOk = predictionLow.probability == predictionHigh.probability
        return defOk && highOk && lowOk && midResultOk && independentOk

    # D6: zero-value profile — every raw anomaly term goes negative, every
    # `max(_, 0.0)` floors it to 0.0, final score is exactly 0.0, matching
    # the real source's `f64::max` floor behavior at the boundary.
    proc demoZeroProfileGivesZeroAnomaly() -> bool:
        let profile = do workloadProfileZero()
        let predictor = do workloadPredictorDefault()
        let anomaly = do workloadPredictorDetectAnomaly(predictor, profile)
        return anomaly.score == 0.0

    state demoWorkloadFeaturesFromProfile: bool = false
    state demoPredictHotspotModerate: bool = false
    state demoDetectAnomalyModerate: bool = false
    state demoExtremeProfileSaturatesBothClamps: bool = false
    state demoThresholdConstructionAndIndependence: bool = false
    state demoZeroProfileGivesZeroAnomaly: bool = false

    action runDemoMl():
        let r1 = do demoWorkloadFeaturesFromProfile()
        let r2 = do demoPredictHotspotModerate()
        let r3 = do demoDetectAnomalyModerate()
        let r4 = do demoExtremeProfileSaturatesBothClamps()
        let r5 = do demoThresholdConstructionAndIndependence()
        let r6 = do demoZeroProfileGivesZeroAnomaly()
        demoWorkloadFeaturesFromProfile = r1
        demoPredictHotspotModerate = r2
        demoDetectAnomalyModerate = r3
        demoExtremeProfileSaturatesBothClamps = r4
        demoThresholdConstructionAndIndependence = r5
        demoZeroProfileGivesZeroAnomaly = r6
