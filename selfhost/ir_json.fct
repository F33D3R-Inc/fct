import "ir_stmt.fct"

app IRJSONSelfHost:
    # Self-hosting port of the READ side of the IR: the JSON the real
    # compiler emits (`facet ir`, the `#fa-ir` script a page carries, the
    # graph runtime.New loads) parsed back into ir_expr.fct's IRExpr and
    # ir_stmt.fct's IRStmt. A self-hosted runtime has to load the compiler's
    # output before it can interpret it, and this is that loader for the two
    # recursive shapes; the flat declaration shapes (entities, states,
    # routes, nodes) are a later, separate port.
    #
    # PART ONE is a small, complete JSON parser (objects, arrays, strings
    # with every escape encoding/json produces including \uXXXX, numbers,
    # true/false/null) into a generic `JVal` tree — `kind`-discriminated,
    # with an object's keys and values as index-parallel lists (the same
    # parallel-list convention every other port uses in place of a map).
    # A malformed document degrades to a "none" value at the point of the
    # fault rather than crashing, the established honest-degrade convention.
    #
    # PART TWO maps a JVal into IRExpr / IRStmt by the exact key names
    # encoding/json gives ir.Expr / ir.Stmt, so `irExprJSON(irExprFromJSON(j))
    # == j` for every j the real compiler produces — the round trip the Go
    # test pins.
    struct JVal:
        kind: text
        s: text
        keys: [text]
        vals: [JVal]

    proc jNone() -> JVal:
        return JVal{kind: "none", s: "", keys: [], vals: []}

    # jGet: the value under key k of an object, or none.
    proc jGet(v: JVal, k: text) -> JVal:
        let n = len(v.keys)
        let mut i = 0
        loop i < n:
            if v.keys[i] == k:
                return v.vals[i]
            i = i + 1
        let none = do jNone()
        return none

    proc jHas(v: JVal, k: text) -> bool:
        let n = len(v.keys)
        let mut i = 0
        loop i < n:
            if v.keys[i] == k:
                return true
            i = i + 1
        return false

    # jStr: a string value's text, "" when absent or not a string.
    proc jStr(v: JVal, k: text) -> text:
        let x = do jGet(v, k)
        if x.kind == "str":
            return x.s
        return ""

    proc jBool(v: JVal, k: text) -> bool:
        let x = do jGet(v, k)
        return x.kind == "bool" && x.s == "true"

    # ── PART ONE: the JSON parser ───────────────────────────────────────────
    # ParseState threads the cursor through the recursive descent: `pos` is
    # where the next value starts after this one was read. A proc cannot
    # return two values, so every reader returns the value with the new
    # cursor tucked into a wrapper struct.
    struct JRead:
        val: JVal
        pos: int

    private proc jSkipWs(s: text, pos: int) -> int:
        let n = len(s)
        let mut i = pos
        let mut go = true
        loop i < n && go:
            if charAt(s, i) in [" ", "\n", "\t", "\r"]:
                i = i + 1
            else:
                go = false
        return i

    private proc jHexVal(c: text) -> int:
        if c == "0":
            return 0
        if c == "1":
            return 1
        if c == "2":
            return 2
        if c == "3":
            return 3
        if c == "4":
            return 4
        if c == "5":
            return 5
        if c == "6":
            return 6
        if c == "7":
            return 7
        if c == "8":
            return 8
        if c == "9":
            return 9
        if c == "a" || c == "A":
            return 10
        if c == "b" || c == "B":
            return 11
        if c == "c" || c == "C":
            return 12
        if c == "d" || c == "D":
            return 13
        if c == "e" || c == "E":
            return 14
        if c == "f" || c == "F":
            return 15
        return 0

    # jCharOf: the one-character text for a code point below 128 — the only
    # range encoding/json's \uXXXX escapes ever cover for the characters it
    # escapes (<, >, &, and control characters). Built through a one-byte
    # buffer, since the language has no code-point-to-text builtin.
    private proc jCharOf(code: int) -> text:
        let mut buf = bytes(1)
        buf[0] = code
        let t = bytesToText(buf)
        return t

    # jReadString: s[pos] is the opening quote; returns the decoded text and
    # the position after the closing quote. The closing quote is found by
    # search (indexOf), skipping one that a run of backslashes escapes; the
    # segment before it is taken whole when it holds no escape, and
    # decoded escape by escape otherwise — so a document is read in a few
    # steps per string, not a step per character.
    private proc jReadString(s: text, pos: int) -> JRead:
        let n = len(s)
        let start = pos + 1
        let mut q = indexOf(s, "\"", start)
        let mut escaped = true
        loop q >= 0 && escaped:
            let mut bs = 0
            loop q - 1 - bs >= start && charAt(s, q - 1 - bs) == "\\":
                bs = bs + 1
            if bs % 2 == 0:
                escaped = false
            else:
                q = indexOf(s, "\"", q + 1)
        if q < 0:
            let none = do jNone()
            return JRead{val: none, pos: n}
        let seg = slice(s, start, q)
        let firstEsc = indexOf(seg, "\\", 0)
        if firstEsc < 0:
            return JRead{val: JVal{kind: "str", s: seg, keys: [], vals: []}, pos: q + 1}
        let m = len(seg)
        let mut out = slice(seg, 0, firstEsc)
        let mut i = firstEsc
        loop i < m:
            let c = charAt(seg, i)
            if c == "\\" && i + 1 < m:
                let e = charAt(seg, i + 1)
                if e == "n":
                    out = out + "\n"
                    i = i + 2
                else:
                    if e == "t":
                        out = out + "\t"
                        i = i + 2
                    else:
                        if e == "r":
                            out = out + "\r"
                            i = i + 2
                        else:
                            if e == "u" && i + 5 < m:
                                let h1 = do jHexVal(charAt(seg, i + 2))
                                let h2 = do jHexVal(charAt(seg, i + 3))
                                let h3 = do jHexVal(charAt(seg, i + 4))
                                let h4 = do jHexVal(charAt(seg, i + 5))
                                let code = h1 * 4096 + h2 * 256 + h3 * 16 + h4
                                let ch = do jCharOf(code)
                                out = out + ch
                                i = i + 6
                            else:
                                # \" \\ \/ and anything else: the character itself
                                out = out + e
                                i = i + 2
            else:
                let nextEsc = indexOf(seg, "\\", i)
                if nextEsc < 0:
                    out = out + slice(seg, i, m)
                    i = m
                else:
                    out = out + slice(seg, i, nextEsc)
                    i = nextEsc
        return JRead{val: JVal{kind: "str", s: out, keys: [], vals: []}, pos: q + 1}

    private proc jIsNumChar(c: text) -> bool:
        return c == "-" || c == "+" || c == "." || c == "e" || c == "E" || c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"

    private proc jReadNumber(s: text, pos: int) -> JRead:
        let n = len(s)
        let mut i = pos
        let mut go = true
        loop i < n && go:
            let ok = do jIsNumChar(charAt(s, i))
            if ok:
                i = i + 1
            else:
                go = false
        return JRead{val: JVal{kind: "num", s: slice(s, pos, i), keys: [], vals: []}, pos: i}

    # jReadValue: one JSON value starting at pos (whitespace allowed before
    # it); the recursion for arrays and objects.
    proc jReadValue(s: text, pos0: int) -> JRead:
        let n = len(s)
        let pos = do jSkipWs(s, pos0)
        if pos >= n:
            let none = do jNone()
            return JRead{val: none, pos: n}
        let c = charAt(s, pos)
        if c == "\"":
            let r = do jReadString(s, pos)
            return r
        if c == "{":
            let mut keys = []
            let mut vals = []
            let mut i = pos + 1
            let mut done = false
            let mut bad = false
            loop !done && !bad:
                let ni = do jSkipWs(s, i)
                i = ni
                if i >= n:
                    bad = true
                else:
                    if charAt(s, i) == "}":
                        done = true
                        i = i + 1
                    else:
                        if charAt(s, i) == ",":
                            i = i + 1
                        else:
                            if charAt(s, i) != "\"":
                                bad = true
                            else:
                                let kr = do jReadString(s, i)
                                let colon = do jSkipWs(s, kr.pos)
                                if colon >= n || charAt(s, colon) != ":":
                                    bad = true
                                else:
                                    let vr = do jReadValue(s, colon + 1)
                                    keys = append(keys, kr.val.s)
                                    vals = append(vals, vr.val)
                                    i = vr.pos
            if bad:
                let none = do jNone()
                return JRead{val: none, pos: n}
            return JRead{val: JVal{kind: "obj", s: "", keys: keys, vals: vals}, pos: i}
        if c == "[":
            let mut items = []
            let mut i = pos + 1
            let mut done = false
            let mut bad = false
            loop !done && !bad:
                let ni = do jSkipWs(s, i)
                i = ni
                if i >= n:
                    bad = true
                else:
                    if charAt(s, i) == "]":
                        done = true
                        i = i + 1
                    else:
                        if charAt(s, i) == ",":
                            i = i + 1
                        else:
                            let vr = do jReadValue(s, i)
                            if vr.val.kind == "none":
                                bad = true
                            else:
                                items = append(items, vr.val)
                                i = vr.pos
            if bad:
                let none = do jNone()
                return JRead{val: none, pos: n}
            return JRead{val: JVal{kind: "arr", s: "", keys: [], vals: items}, pos: i}
        if slice(s, pos, min(pos + 4, n)) == "true":
            return JRead{val: JVal{kind: "bool", s: "true", keys: [], vals: []}, pos: pos + 4}
        if slice(s, pos, min(pos + 5, n)) == "false":
            return JRead{val: JVal{kind: "bool", s: "false", keys: [], vals: []}, pos: pos + 5}
        if slice(s, pos, min(pos + 4, n)) == "null":
            return JRead{val: JVal{kind: "null", s: "", keys: [], vals: []}, pos: pos + 4}
        let isNum = do jIsNumChar(c)
        if isNum:
            let r = do jReadNumber(s, pos)
            return r
        let none = do jNone()
        return JRead{val: none, pos: n}

    proc jsonParse(s: text) -> JVal:
        let r = do jReadValue(s, 0)
        return r.val

    # ── PART TWO: JVal → IR ─────────────────────────────────────────────────
    # Each object is read in ONE pass over its keys (a `continue` per key
    # matched), not a scan per field name: an expression node has 25
    # possible keys and carries 3-6, so a lookup per key name was ~125
    # text compares and 25 calls per node, most of them misses.
    private proc jExprListX(x: JVal) -> [IRExpr]:
        let n = len(x.vals)
        let mut out = []
        let mut i = 0
        loop i < n:
            let e = do irExprFromJVal(x.vals[i])
            out = append(out, e)
            i = i + 1
        return out

    private proc jTextListX(x: JVal) -> [text]:
        let n = len(x.vals)
        let mut out = []
        let mut i = 0
        loop i < n:
            out = append(out, x.vals[i].s)
            i = i + 1
        return out

    private proc jTextList(v: JVal, k: text) -> [text]:
        let x = do jGet(v, k)
        let r = do jTextListX(x)
        return r

    # irExprFromJVal: the inverse of ir_expr.fct's irExprJSON, key for key.
    # A literal's `val` keeps its JSON spelling (a number's digits, a bool's
    # word, a string's decoded text), which is what irExprJSON re-emits.
    proc irExprFromJVal(v: JVal) -> IRExpr:
        let mut hasVal = false
        let mut valText = ""
        let mut kind = ""
        let mut vtype = ""
        let mut name = ""
        let mut field = ""
        let mut obj = []
        let mut key = []
        let mut op = ""
        let mut args = []
        let mut keys = []
        let mut fields = []
        let mut l = []
        let mut r = []
        let mut x = []
        let mut itemVar = ""
        let mut where = []
        let mut sel = []
        let mut order = ""
        let mut desc = false
        let mut limit = []
        let mut orderBy = []
        let mut omit = []
        let mut nulls = []
        let n = len(v.keys)
        let mut i = 0
        loop i < n:
            let k = v.keys[i]
            let val = v.vals[i]
            i = i + 1
            if k == "kind":
                kind = val.s
                continue
            if k == "name":
                name = val.s
                continue
            if k == "val":
                hasVal = true
                valText = val.s
                continue
            if k == "vtype":
                vtype = val.s
                continue
            if k == "args":
                args = do jExprListX(val)
                continue
            if k == "l":
                let le = do irExprFromJVal(val)
                l = [le]
                continue
            if k == "r":
                let re = do irExprFromJVal(val)
                r = [re]
                continue
            if k == "op":
                op = val.s
                continue
            if k == "field":
                field = val.s
                continue
            if k == "obj":
                let oe = do irExprFromJVal(val)
                obj = [oe]
                continue
            if k == "key":
                let ke = do irExprFromJVal(val)
                key = [ke]
                continue
            if k == "x":
                let xe = do irExprFromJVal(val)
                x = [xe]
                continue
            if k == "var":
                itemVar = val.s
                continue
            if k == "where":
                let we = do irExprFromJVal(val)
                where = [we]
                continue
            if k == "sel":
                let se = do irExprFromJVal(val)
                sel = [se]
                continue
            if k == "order":
                order = val.s
                continue
            if k == "desc":
                desc = val.kind == "bool" && val.s == "true"
                continue
            if k == "limit":
                let lie = do irExprFromJVal(val)
                limit = [lie]
                continue
            if k == "orderBy":
                let obe = do irExprFromJVal(val)
                orderBy = [obe]
                continue
            if k == "keys":
                keys = do jExprListX(val)
                continue
            if k == "fields":
                fields = do jTextListX(val)
                continue
            if k == "omit":
                omit = do jTextListX(val)
                continue
            if k == "nulls":
                nulls = do jTextListX(val)
                continue
        return IRExpr{kind: kind, hasVal: hasVal, val: valText, vtype: vtype, name: name, field: field, obj: obj, key: key, op: op, args: args, keys: keys, fields: fields, l: l, r: r, x: x, itemVar: itemVar, where: where, sel: sel, order: order, desc: desc, limit: limit, orderBy: orderBy, omit: omit, nulls: nulls}

    proc irExprFromJSON(s: text) -> IRExpr:
        let v = do jsonParse(s)
        let e = do irExprFromJVal(v)
        return e

    private proc jStmtListX(x: JVal) -> [IRStmt]:
        let n = len(x.vals)
        let mut out = []
        let mut i = 0
        loop i < n:
            let st = do irStmtFromJVal(x.vals[i])
            out = append(out, st)
            i = i + 1
        return out

    # irStmtFromJVal: the inverse of ir_stmt.fct's irStmtJSON. `fields` (Go's
    # []FieldInit of {name, expr}) unzips into the parallel fieldNames/
    # fieldExprs lists.
    proc irStmtFromJVal(v: JVal) -> IRStmt:
        let mut op = ""
        let mut target = ""
        let mut entity = ""
        let mut field = ""
        let mut key = []
        let mut value = []
        let mut fieldNames = []
        let mut fieldExprs = []
        let mut service = ""
        let mut args = []
        let mut itemVar = ""
        let mut where = []
        let mut order = ""
        let mut desc = false
        let mut limit = []
        let mut orderBy = []
        let mut omit = []
        let mut bind = ""
        let mut ret = ""
        let mut retList = false
        let mut role = []
        let mut msg = ""
        let mut status = 0
        let mut body = []
        let mut elseBody = []
        let mut bytesFlag = false
        let mut file = ""
        let mut path = ""
        let n = len(v.keys)
        let mut i = 0
        loop i < n:
            let k = v.keys[i]
            let val = v.vals[i]
            i = i + 1
            if k == "op":
                op = val.s
                continue
            if k == "target":
                target = val.s
                continue
            if k == "value":
                let ve = do irExprFromJVal(val)
                value = [ve]
                continue
            if k == "args":
                args = do jExprListX(val)
                continue
            if k == "service":
                service = val.s
                continue
            if k == "bind":
                bind = val.s
                continue
            if k == "ret":
                ret = val.s
                continue
            if k == "retList":
                retList = val.kind == "bool" && val.s == "true"
                continue
            if k == "body":
                body = do jStmtListX(val)
                continue
            if k == "else":
                elseBody = do jStmtListX(val)
                continue
            if k == "entity":
                entity = val.s
                continue
            if k == "field":
                field = val.s
                continue
            if k == "key":
                let ke = do irExprFromJVal(val)
                key = [ke]
                continue
            if k == "fields":
                let fn = len(val.vals)
                let mut fi = 0
                loop fi < fn:
                    let nm = do jStr(val.vals[fi], "name")
                    let ex = do jGet(val.vals[fi], "expr")
                    let e = do irExprFromJVal(ex)
                    fieldNames = append(fieldNames, nm)
                    fieldExprs = append(fieldExprs, e)
                    fi = fi + 1
                continue
            if k == "var":
                itemVar = val.s
                continue
            if k == "where":
                let we = do irExprFromJVal(val)
                where = [we]
                continue
            if k == "order":
                order = val.s
                continue
            if k == "desc":
                desc = val.kind == "bool" && val.s == "true"
                continue
            if k == "limit":
                let lie = do irExprFromJVal(val)
                limit = [lie]
                continue
            if k == "orderBy":
                let obe = do irExprFromJVal(val)
                orderBy = [obe]
                continue
            if k == "omit":
                omit = do jTextListX(val)
                continue
            if k == "role":
                let roe = do irExprFromJVal(val)
                role = [roe]
                continue
            if k == "msg":
                msg = val.s
                continue
            if k == "status":
                if val.kind == "num":
                    status = toInt(val.s)
                continue
            if k == "bytes":
                bytesFlag = val.kind == "bool" && val.s == "true"
                continue
            if k == "file":
                file = val.s
                continue
            if k == "path":
                path = val.s
                continue
        return IRStmt{op: op, target: target, entity: entity, field: field, key: key, value: value, fieldNames: fieldNames, fieldExprs: fieldExprs, service: service, args: args, itemVar: itemVar, where: where, order: order, desc: desc, limit: limit, bind: bind, ret: ret, retList: retList, role: role, msg: msg, status: status, body: body, elseBody: elseBody, bytesFlag: bytesFlag, file: file, path: path}

    proc irStmtFromJSON(s: text) -> IRStmt:
        let v = do jsonParse(s)
        let st = do irStmtFromJVal(v)
        return st

    # ── live drivers: round trips ───────────────────────────────────────────
    proc irExprRoundTrip(s: text) -> text:
        let e = do irExprFromJSON(s)
        let j = do irExprJSON(e)
        return j

    proc irStmtRoundTrip(s: text) -> text:
        let st = do irStmtFromJSON(s)
        let j = do irStmtJSON(st)
        return j

    state irExprBack: text = ""
    state irStmtBack: text = ""

    action runIRExprRoundTrip(src: text):
        let j = do irExprRoundTrip(src)
        irExprBack = j

    action runIRStmtRoundTrip(src: text):
        let j = do irStmtRoundTrip(src)
        irStmtBack = j

    private view IRJSONHome at "/ir_json":
        box:
            text "{irExprBack} {irStmtBack}"
