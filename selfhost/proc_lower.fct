import "check.fct"
import "stmt.fct"
import "lower.fct"
import "ir_decl.fct"
import "parser_proc.fct"

app ProcLowerSelfHost:
    # Self-hosting port of internal/ir/build.go's `proc()` + `procBlock()`
    # — the lowering of one `proc` declaration (header + body) into
    # ir_decl.fct's IRProc (the port of ir.Proc), statement by statement,
    # with the scope rules the Go builder enforces. The INPUT is the proc's
    # header line (parsed by parser_proc.fct's header helpers) and its raw
    # body text (parsed by stmt.fct's parseProcBodySrc into [Stmt]); the
    # OUTPUT is an IRProc whose `irProcJSON` spelling equals
    # `json.Marshal(ir.Proc)` byte for byte, which proc_lower_test.go pins
    # against the real compiler.
    #
    # Go's environment maps become parallel lists, since a proc has no map
    # parameter:
    #   e.procSigs  -> procNames / procRets / procRetLists (index-parallel;
    #                  a proc with no return type has ret ""). The
    #                  signature's PARAM COUNT is not carried, so the
    #                  "expects N argument(s), got M" arity check is the
    #                  one `do`/`spawn` rule left out here.
    #   e.files     -> fileNames / fileTypes ("text"|"bytes") / filePaths
    #   e.enums     -> enumNames (only its key set matters to lower())
    #   locals / mutable / types -> names / muts / types, threaded through
    #                  plBlock by value, which is exactly Go's clone-on-
    #                  entry: a nested block's additions never leak back.
    #   pendingSpawns -> pendNames / pendProcs, fresh per block, checked
    #                  empty at every point Go calls checkSpawnsJoined.
    #
    # DIAGNOSTIC CHANNEL: a proc has no error return, so every compile
    # error the Go builder would raise degrades to an IRProc whose `name`
    # is "" (never a valid proc name), and `lowerProcDiag(...)` returns the
    # Go message text ("" on success). The two are computed by one
    # internal `plLowerProc` returning a PLResult{proc, diag} pair; the
    # public `lowerProcSrc`/`lowerProcJSON`/`lowerProcDiag` are its views.
    # Messages are spelled exactly as build.go's fmt.Sprintf calls spell
    # them (with %q rendered as a plain double-quoted identifier), so a Go
    # test can assert the real compiler's message is a substring.
    #
    # Statement kinds ported (stmt.fct kind -> IR op), with their rules:
    #   let / letMut     -> let       already-declared check; type inferred
    #   assign           -> assign    "is not declared" / "is not mutable"
    #   indexAssign      -> indexset  same two, "not an array or map", map
    #                                 key int/text, `bytes` flag from type
    #   do / letDo       -> do        unknown proc; bind: in-scope, returns
    #                                 nothing; ret/retList; array tagging
    #   spawn            -> spawn     unknown proc; handle in-scope; task
    #                                 type; pending
    #   join / letJoin   -> join      undeclared / not a handle / already
    #                                 joined; bind rules as `do`
    #   exprStmt         -> exprstmt  the call checked like any expression
    #   read / letRead   -> fileread  undeclared file; no args; io.file cap
    #   write / letWrite -> filewrite undeclared file; one arg; io.file
    #                                 cap; content type vs file type
    #   loop             -> loop      spawns joined; nested block depth+1
    #   if               -> if        spawns joined; then/else blocks
    #   break / continue -> break/continue  spawns joined; outside a loop;
    #                                 must be last of its block
    #   return           -> return    spawns joined; must be last; value
    #                                 vs declared return type
    #   (anything else)  -> "unsupported statement in proc"
    # Plus proc-level: duplicate parameter, empty body, return
    # completeness (stmtsReturnComplete), and the end-of-block spawn check.
    #
    # checkProcExpr is ported as far as it gates what lowers here: unknown
    # reference (freeNames), daemon-only builtins, index-on-non-array,
    # task-handle-as-value, and the capability gate (checkProcCapabilities
    # / requireProcCapability). Left out: checkBuiltins (the self-hosted
    # parser only produces known builtins), the bitwise/numeric/map-key
    # operand type checks, struct-field checks and the `{expr}` literal
    # check — none of them change the IR of a proc that compiles.

    struct PLEnv:
        procName: text
        procRet: text
        uses: [text]
        texts: [text]
        procNames: [text]
        # procArities: parallel to procNames, -1 where the arity is checked
        # at the call statement instead.
        procArities: [int]
        procRets: [text]
        procRetLists: [bool]
        # procParamMaps: per proc, its parameters as "name=K:V" (a map
        # parameter) or "name=" joined by "|" — for plMapArgDiag.
        procParamMaps: [text]
        fileNames: [text]
        fileTypes: [text]
        filePaths: [text]
        enumNames: [text]
        # Daemon lowering (build.go's e.daemon -> procBlock with non-nil
        # actionSigs): `act` is legal, the daemon-only builtins are too, and
        # every `act` target is checked against these action signatures.
        isDaemon: bool
        actionNames: [text]
        actionServer: [bool]
        actionParamCounts: [int]
        # manglePrivate's rename table for the file this body came from.
        renameFrom: [text]
        renameTo: [text]
        # structFieldKeys/structFieldTypes: "Struct.field" and its declared
        # type ("int", "[int]", …), for a `local.field = expr` write.
        structFieldKeys: [text]
        structFieldTypes: [text]
        # sharedNames/sharedTypes: the app's `shared` cells and their types
        # ("array" for a list cell) — build.go's e.shareds, seeded into a
        # body's type map (seedSharedTypes) but never its locals.
        sharedNames: [text]
        sharedTypes: [text]
        # lineNos: each body line's source line number ([] when unknown).
        lineNos: [int]
        # structNames: the declared structs; ty: the wire types (a proc may
        # build a wire-type literal, held to checkWireLits' rules).
        structNames: [text]
        # structStart/structEnd: each struct's run [start, end) of fields
        # in structFieldKeys.
        structStart: {text: int}
        structEnd: {text: int}
        # structFieldAt: "Struct.field" -> its index in structFieldKeys (the
        # first, as a scan finds it); procAt: proc name -> its index in
        # procNames — each lookup one map probe rather than a list scan
        structFieldAt: {text: int}
        procAt: {text: int}
        ty: TyEnv

    # PLCtx: what a body is lowered against beyond its own file: the shared
    # cells, and the procs that are daemon-context bodies (detachctx.go).
    struct PLCtx:
        sharedNames: [text]
        sharedTypes: [text]
        ctxProcs: [text]
        lineNos: [int]
        structNames: [text]
        # structStart/structEnd: each struct's run [start, end) of fields
        # in structFieldKeys.
        structStart: {text: int}
        structEnd: {text: int}
        # structFieldAt: "Struct.field" -> its index in structFieldKeys (the
        # first, as a scan finds it); procAt: proc name -> its index in
        # procNames — each lookup one map probe rather than a list scan
        structFieldAt: {text: int}
        procAt: {text: int}
        # unchecked: -1 per proc name — no proc call's arity is checked here
        unchecked: [int]
        ty: TyEnv

    struct PLBlock:
        stmts: [IRStmt]
        diag: text

    struct PLResult:
        proc: IRProc
        diag: text

    # ── shared cells ───────────────────────────────────────────────────
    # plNotShared: checkNotShared — a parameter or local may not take a
    # shared cell's name.
    proc plNotShared(env: PLEnv, name: text) -> text:
        let at = do lowerFindName(env.sharedNames, name)
        if at < 0:
            return ""
        let q = do plQuote(name)
        return q + " is a shared cell — a parameter or local may not reuse its name"

    # plSharedExpr / plSharedStmts: lowerSharedRefs — every read of a shared
    # cell becomes a "$shared.get" call (no local can carry a cell's name,
    # so every ref by that name is the cell).
    proc plSharedExpr(e0: IRExpr, shared: [text]) -> IRExpr:
        if e0.kind == "ref" && lowerFindName(shared, e0.name) >= 0:
            let c = do irCall("$shared.get", [irLit(e0.name, "text")])
            return c
        let mut e = e0
        e.obj = plSharedList(e0.obj, shared)
        e.key = plSharedList(e0.key, shared)
        e.args = plSharedList(e0.args, shared)
        e.keys = plSharedList(e0.keys, shared)
        e.l = plSharedList(e0.l, shared)
        e.r = plSharedList(e0.r, shared)
        e.x = plSharedList(e0.x, shared)
        e.where = plSharedList(e0.where, shared)
        e.sel = plSharedList(e0.sel, shared)
        e.limit = plSharedList(e0.limit, shared)
        e.orderBy = plSharedList(e0.orderBy, shared)
        return e

    proc plSharedList(xs: [IRExpr], shared: [text]) -> [IRExpr]:
        let mut out = []
        let n = len(xs)
        let mut i = 0
        loop i < n:
            let x = do plSharedExpr(xs[i], shared)
            out = append(out, x)
            i = i + 1
        return out

    # plDesugar: desugarNestedWrite — `target = val` two or more steps deep
    # as one-level writes: the innermost step written on a `let mut`
    # temporary holding its container (named `__w<line>_<n>`), written back
    # into its own container the same way, up to the root local. Each
    # statement comes with the line text the lowering reads its names from.
    struct PLDesugar:
        stmts: [Stmt]
        texts: [text]
        n: int
        err: text

    proc plStmtNodeOf(x: Stmt) -> Stmt:
        return x

    proc plDesugar(target: ExprNode, val: ExprNode, line: int, n0: int, acc: [Stmt]) -> PLDesugar:
        let none = do emptyNode()
        if target.kind == "ref":
            return PLDesugar{stmts: [Stmt{kind: "assign", lineIdx: 0, expr: val, args: [], body: [], elseBody: [], index: none}], texts: [target.text + " = _"], n: n0, err: ""}
        if (target.kind == "get" || target.kind == "index") && len(target.children) >= 1:
            let obj = target.children[0]
            let mut one = Stmt{kind: "fieldAssign", lineIdx: 0, expr: val, args: [], body: [], elseBody: [], index: none}
            if target.kind == "index":
                one = Stmt{kind: "indexAssign", lineIdx: 0, expr: val, args: [], body: [], elseBody: [], index: target.children[1]}
            if obj.kind == "ref":
                let mut t1 = obj.text + "." + target.text + " = _"
                if target.kind == "index":
                    t1 = obj.text + "[_] = _"
                return PLDesugar{stmts: [one], texts: [t1], n: n0, err: ""}
            let n = n0 + 1
            let tmp = "__w" + line + "_" + n
            let up = do plDesugar(obj, refNode(tmp), line, n, [])
            if up.err != "":
                return up
            let letTmp = Stmt{kind: "letMut", lineIdx: 0, expr: obj, args: [], body: [], elseBody: [], index: none}
            let mut t2 = tmp + "." + target.text + " = _"
            if target.kind == "index":
                t2 = tmp + "[_] = _"
            return PLDesugar{stmts: [letTmp, one] + up.stmts, texts: ["let mut " + tmp + " = _", t2] + up.texts, n: up.n, err: ""}
        return PLDesugar{stmts: [], texts: [], n: n0, err: "invalid assignment target — a write goes through a local's fields and indexes"}

    proc plStmtOf(x: IRStmt) -> IRStmt:
        return x

    proc plSharedStmts(ss: [IRStmt], shared: [text]) -> [IRStmt]:
        if len(shared) == 0:
            return ss
        let mut out = []
        let n = len(ss)
        let mut i = 0
        loop i < n:
            let mut st = do plStmtOf(ss[i])
            st.key = plSharedList(ss[i].key, shared)
            st.value = plSharedList(ss[i].value, shared)
            st.where = plSharedList(ss[i].where, shared)
            st.limit = plSharedList(ss[i].limit, shared)
            st.role = plSharedList(ss[i].role, shared)
            st.args = plSharedList(ss[i].args, shared)
            st.fieldExprs = plSharedList(ss[i].fieldExprs, shared)
            st.body = plSharedStmts(ss[i].body, shared)
            st.elseBody = plSharedStmts(ss[i].elseBody, shared)
            out = append(out, st)
            i = i + 1
        return out

    # plStructExprType: structExprType — inferProcType, and a `.field` read
    # chased through the struct table to the field's declared type (a list
    # field answers "array").
    # Map types (build.go's mapTag / isMapType / mapKeyType / mapValType):
    # a `{K: V}` parameter, field or return is tagged "map:K:V"; a map
    # literal is the bare "map" (its values are whatever was put in).
    proc plIsMapType(t: text) -> bool:
        return t == "map" || (len(t) > 4 && slice(t, 0, 4) == "map:")

    proc plMapKeyType(t: text) -> text:
        if len(t) > 4 && slice(t, 0, 4) == "map:":
            let rest = slice(t, 4, len(t))
            let c = indexOf(rest, ":", 0)
            if c >= 0:
                return slice(rest, 0, c)
        return ""

    proc plMapValType(t: text) -> text:
        if len(t) > 4 && slice(t, 0, 4) == "map:":
            let rest = slice(t, 4, len(t))
            let c = indexOf(rest, ":", 0)
            if c >= 0:
                return slice(rest, c + 1, len(rest))
        return ""

    # plRetCore: a proc signature's result type as the IR records it — a
    # map return's value type V (the signature list carries "map:K:V").
    proc plRetCore(sigRet: text) -> text:
        let v = do plMapValType(sigRet)
        if v != "":
            return v
        let nb = do nestedBase(sigRet)
        return nb

    # plRetDepth: the depth of a nested list signature return (the list's
    # element `[T]` rides the signature list; see the driver), 0 otherwise.
    proc plRetDepth(sigRet: text, retList: bool) -> int:
        if !retList:
            return 0
        let d = do nestedDepth(sigRet)
        return d

    # plMapArgDiag: a `do`'s arguments against the callee's map parameters
    # (build.go: a map parameter takes a map and nothing else; a map goes
    # nowhere else). spec: the callee's parameters as "name=K:V" / "name=".
    proc plMapArgDiag(env: PLEnv, proc: text, spec: text, args: [ExprNode], names: [text], types: [text]) -> text:
        if spec == "":
            return ""
        let ps = split(spec, "|")
        let n = len(args)
        let mut i = 0
        loop i < n && i < len(ps):
            let eq = indexOf(ps[i], "=", 0)
            let pname = slice(ps[i], 0, eq)
            let ms = slice(ps[i], eq + 1, len(ps[i]))
            let at = do plStructExprType(env, args[i], names, types)
            let cq = do plQuote(proc)
            let pq = do plQuote(pname)
            let isMapArg = do plIsMapType(at)
            if ms != "":
                let mk = do mapSpecKey(ms)
                let mv = do mapSpecVal(ms)
                if at != "" && !isMapArg:
                    return "proc " + cq + " parameter " + pq + " is a {" + mk + ": " + mv + "} map, got " + at
                if at != "":
                    let dv = do plMapValType(at)
                    if dv != "" && dv != mv:
                        let dk = do plMapKeyType(at)
                        return "proc " + cq + " parameter " + pq + " is a {" + mk + ": " + mv + "} map, got {" + dk + ": " + dv + "}"
            else:
                if isMapArg:
                    return "proc " + cq + " parameter " + pq + " is not a map, got one"
            i = i + 1
        return ""

    proc plStructExprType(env: PLEnv, e: ExprNode, names: [text], types: [text]) -> text:
        if e.kind == "get" && len(e.children) == 1:
            let ot = do plStructExprType(env, e.children[0], names, types)
            if ot != "":
                let at = do plFieldAt(env, ot + "." + e.text)
                if at >= 0:
                    let ft = env.structFieldTypes[at]
                    if len(ft) > 0 && charAt(ft, 0) == "[":
                        return "array"
                    return ft
            return ""
        # an element of a struct's list field has the field's element type
        if e.kind == "index" && len(e.children) >= 1 && e.children[0].kind == "get":
            let g = e.children[0]
            let ot2 = do plStructExprType(env, g.children[0], names, types)
            let at2 = do plFieldAt(env, ot2 + "." + g.text)
            if ot2 != "" && at2 >= 0:
                let ft2 = env.structFieldTypes[at2]
                if len(ft2) > 1 && charAt(ft2, 0) == "[":
                    let el2 = slice(ft2, 1, len(ft2) - 1)
                    # a nested list field's element is itself a list
                    if len(el2) > 0 && charAt(el2, 0) == "[":
                        return "array"
                    return el2
                # an element of a struct's map field has its value type
                let mv2 = do plMapValType(ft2)
                if mv2 != "":
                    return mv2
        # a call of a declared proc has its declared return type, so `let
        # mut q = emptyQuery(raw)` is a struct local whose fields can be
        # written and read like one built from a literal
        if e.kind == "call":
            let pn = do plRename(env, e.text)
            let pat = do plProcAt(env, pn)
            if pat >= 0:
                if env.procRetLists[pat]:
                    return "array"
                return env.procRets[pat]
        let t = do plInferType(e, names, types)
        return t

    # plStructFieldTypes: checkStructFieldTypes — a struct literal sets every
    # declared field exactly once, each to a value of its type where that is
    # provable, and nothing else; a `.field` read of a value known to be a
    # struct names a field it has (and of one known not to be a struct, is
    # refused). A wire-type literal is held to checkWireLits' rules.
    proc plStructFieldTypes(env: PLEnv, e: ExprNode, names: [text], types: [text]) -> text:
        if e.kind == "struct":
            if !(e.text in env.structNames) && e.text in env.ty.wireNames:
                let wd = do tyWireLitsDiag(env.ty, e, tyEmptyScope())
                if wd != "":
                    return wd
                let mut wi = 0
                loop wi < len(e.pairs):
                    let wsub = do plStructFieldTypes(env, e.pairs[wi].value, names, types)
                    if wsub != "":
                        return wsub
                    wi = wi + 1
                return ""
            if !(e.text in env.structNames):
                return "unknown struct type \"" + e.text + "\""
            let mut seenF = []
            let np = len(e.pairs)
            let mut i = 0
            loop i < np:
                let fname = e.pairs[i].key.text
                let at = do plFieldAt(env, e.text + "." + fname)
                if at < 0:
                    return "struct \"" + e.text + "\" has no field \"" + fname + "\""
                if fname in seenF:
                    return "field \"" + fname + "\" set twice in a " + e.text + "{...} literal"
                seenF = append(seenF, fname)
                let sub = do plStructFieldTypes(env, e.pairs[i].value, names, types)
                if sub != "":
                    return sub
                let got = do plStructExprType(env, e.pairs[i].value, names, types)
                if got != "":
                    let ft = env.structFieldTypes[at]
                    let fMapVal = do plMapValType(ft)
                    if fMapVal != "":
                        # a `{K: V}` field takes a map — of those types, when known
                        let fMapKey = do plMapKeyType(ft)
                        let gotMap = do plIsMapType(got)
                        if !gotMap:
                            return "field \"" + fname + "\" of " + e.text + "{...} wants {" + fMapKey + ": " + fMapVal + "}, got " + got
                        let gv = do plMapValType(got)
                        if gv != "" && gv != fMapVal:
                            let gk = do plMapKeyType(got)
                            return "field \"" + fname + "\" of " + e.text + "{...} wants {" + fMapKey + ": " + fMapVal + "}, got {" + gk + ": " + gv + "}"
                    else:
                        if len(ft) > 0 && charAt(ft, 0) == "[":
                            let elem = slice(ft, 1, len(ft) - 1)
                            let bytesAsInts = got == "bytes" && elem == "int"
                            if got != "array" && !bytesAsInts:
                                return "field \"" + fname + "\" of " + e.text + "{...} wants " + ft + ", got " + got
                        else:
                            if got != ft:
                                return "field \"" + fname + "\" of " + e.text + "{...} wants " + ft + ", got " + got
                i = i + 1
            if e.text in env.structStart:
                let pre = e.text + "."
                let mut k = env.structStart[e.text]
                let kend = env.structEnd[e.text]
                loop k < kend:
                    let key = env.structFieldKeys[k]
                    let fn = slice(key, len(pre), len(key))
                    if !(fn in seenF):
                        return e.text + "{...} literal is missing field \"" + fn + "\""
                    k = k + 1
            return ""
        if e.kind == "get" && len(e.children) == 1:
            let ot = do plStructExprType(env, e.children[0], names, types)
            if ot != "":
                if ot in env.structNames:
                    let fat = do plFieldAt(env, ot + "." + e.text)
                    if fat < 0:
                        return "struct \"" + ot + "\" has no field \"" + e.text + "\""
                else:
                    let prim = ot == "int" || ot == "text" || ot == "bool" || ot == "money" || ot == "date" || ot == "float" || ot == "datetime"
                    if ot == "array" || plIsMapType(ot) || ot == "bytes" || ot == "task" || prim:
                        return "field access (`." + e.text + "`) needs a struct value, but this expression is " + ot
            let r = do plStructFieldTypes(env, e.children[0], names, types)
            return r
        if e.kind == "bin" || e.kind == "un" || e.kind == "call" || e.kind == "list" || e.kind == "index":
            let mut c = 0
            loop c < len(e.children):
                let sub2 = do plStructFieldTypes(env, e.children[c], names, types)
                if sub2 != "":
                    return sub2
                c = c + 1
            return ""
        if e.kind == "map":
            let mut m = 0
            loop m < len(e.pairs):
                let sk = do plStructFieldTypes(env, e.pairs[m].key, names, types)
                if sk != "":
                    return sk
                let sv = do plStructFieldTypes(env, e.pairs[m].value, names, types)
                if sv != "":
                    return sv
                m = m + 1
        return ""

    # ── small helpers ──────────────────────────────────────────────────
    proc plQuote(s: text) -> text:
        return "\"" + s + "\""

    proc plAppendAll(a: [text], b: [text]) -> [text]:
        let n = len(b)
        let mut out = a
        let mut i = 0
        loop i < n:
            out = append(out, b[i])
            i = i + 1
        return out

    proc plRemoveAt(xs: [text], at: int) -> [text]:
        let n = len(xs)
        let mut out = []
        let mut i = 0
        loop i < n:
            if i != at:
                out = append(out, xs[i])
            i = i + 1
        return out

    proc plTextAt(xs: [text], i: int) -> text:
        if i < 0 || i >= len(xs):
            return ""
        return xs[i]

    proc plBoolAt(xs: [bool], i: int) -> bool:
        if i < 0 || i >= len(xs):
            return false
        return xs[i]

    # plMinText: sort.Strings(names)[0] — the smallest name.
    proc plMinText(xs: [text]) -> text:
        let n = len(xs)
        if n == 0:
            return ""
        let mut m = xs[0]
        let mut i = 1
        loop i < n:
            if xs[i] < m:
                m = xs[i]
            i = i + 1
        return m

    # plBodyTexts: stmt.fct's (private) bodyTexts restated — the same
    # trimmed, blank/comment-free line list its Stmt.lineIdx indexes.
    proc plBodyTexts(src: text) -> [text]:
        let rawLines = split(src, "\n")
        let n = len(rawLines)
        let mut out = []
        let mut i = 0
        loop i < n:
            let t = trim(rawLines[i])
            let blank = len(t) == 0 || slice(t, 0, 1) == "#"
            if !blank:
                out = append(out, t)
            i = i + 1
        return out

    proc plEmptyProc() -> IRProc:
        return IRProc{name: "", params: [], ret: "", retList: false, body: [], retMap: false, retKey: "", retDepth: 0}

    # ── IRStmt constructors for the proc-only ops ──────────────────────
    proc plIndexSet(target: text, key: IRExpr, value: IRExpr, bytesFlag: bool) -> IRStmt:
        return IRStmt{op: "indexset", target: target, entity: "", field: "", key: [key], value: [value], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", orderBy: [], desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: bytesFlag, file: "", path: "", retMap: false, retDepth: 0}

    proc plReturn(value: [IRExpr]) -> IRStmt:
        return IRStmt{op: "return", target: "", entity: "", field: "", key: [], value: value, fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", orderBy: [], desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: false, file: "", path: "", retMap: false, retDepth: 0}

    proc plLoop(cond: IRExpr, body: [IRStmt]) -> IRStmt:
        return IRStmt{op: "loop", target: "", entity: "", field: "", key: [], value: [cond], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", orderBy: [], desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: "", status: 0, body: body, elseBody: [], bytesFlag: false, file: "", path: "", retMap: false, retDepth: 0}

    proc plSpawn(handle: text, procName: text, args: [IRExpr]) -> IRStmt:
        return IRStmt{op: "spawn", target: handle, entity: "", field: "", key: [], value: [], fieldNames: [], fieldExprs: [], service: procName, args: args, itemVar: "", where: [], order: "", orderBy: [], desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: false, file: "", path: "", retMap: false, retDepth: 0}

    proc plJoin(handle: text, bind: text, ret: text, retList: bool) -> IRStmt:
        return IRStmt{op: "join", target: handle, entity: "", field: "", key: [], value: [], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", orderBy: [], desc: false, limit: [], bind: bind, ret: ret, retList: retList, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: false, file: "", path: "", retMap: false, retDepth: 0}

    proc plFileRead(file: text, path: text, bytesFlag: bool, bind: text) -> IRStmt:
        return IRStmt{op: "fileread", target: "", entity: "", field: "", key: [], value: [], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", orderBy: [], desc: false, limit: [], bind: bind, ret: "", retList: false, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: bytesFlag, file: file, path: path, retMap: false, retDepth: 0}

    proc plFileWrite(file: text, path: text, bytesFlag: bool, value: IRExpr, bind: text) -> IRStmt:
        return IRStmt{op: "filewrite", target: "", entity: "", field: "", key: [], value: [value], fieldNames: [], fieldExprs: [], service: "", args: [], itemVar: "", where: [], order: "", orderBy: [], desc: false, limit: [], bind: bind, ret: "", retList: false, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: bytesFlag, file: file, path: path, retMap: false, retDepth: 0}

    # ── expression walks (the checkProcExpr subset) ────────────────────
    # plSubNodes: every direct child expression of a node — children,
    # map pairs, an aggregate's where/sel — the union of what Go's
    # per-check walkers descend into.
    proc plSubNodes(e: ExprNode) -> [ExprNode]:
        let mut out = e.children
        let np = len(e.pairs)
        let mut i = 0
        loop i < np:
            out = append(out, e.pairs[i].key)
            out = append(out, e.pairs[i].value)
            i = i + 1
        let nw = len(e.whereClause)
        let mut j = 0
        loop j < nw:
            out = append(out, e.whereClause[j])
            j = j + 1
        let ns = len(e.sel)
        let mut k = 0
        loop k < ns:
            out = append(out, e.sel[k])
            k = k + 1
        return out

    proc plFreeNamesList(ns: [ExprNode]) -> [text]:
        let n = len(ns)
        let mut out = []
        let mut i = 0
        loop i < n:
            let sub = do plFreeNames(ns[i])
            let merged = do plAppendAll(out, sub)
            out = merged
            i = i + 1
        return out

    # plFreeNames: freeNames() — every referenced name, an entity lookup's
    # entity and an aggregate's collection included, the aggregate's own
    # item variable excluded from its where/sel.
    proc plFreeNames(e: ExprNode) -> [text]:
        if e.kind == "ref":
            return [e.text]
        if e.kind == "entityGet":
            let sub = do plFreeNamesList(e.children)
            let out = do plAppendAll([e.text], sub)
            return out
        if e.kind == "agg":
            let w = do plFreeNamesList(e.whereClause)
            let s = do plFreeNamesList(e.sel)
            let both = do plAppendAll(w, s)
            let mut out = [e.coll]
            let n = len(both)
            let mut i = 0
            loop i < n:
                if both[i] != e.itemVar:
                    out = append(out, both[i])
                i = i + 1
            return out
        if e.kind == "map":
            let np = len(e.pairs)
            let mut out = []
            let mut i = 0
            loop i < np:
                let k = do plFreeNames(e.pairs[i].key)
                let v = do plFreeNames(e.pairs[i].value)
                let m1 = do plAppendAll(out, k)
                let m2 = do plAppendAll(m1, v)
                out = m2
                i = i + 1
            return out
        let out = do plFreeNamesList(e.children)
        return out

    # plBuiltinCap: builtinCapability().
    proc plBuiltinCap(name: text) -> text:
        if name == "readFile" || name == "writeFile" || name == "appendFile" || name == "fileExists" || name == "truncateFile" || name == "fileSize" || name == "fileModTime" || name == "readFileAt" || name == "writeFileAt" || name == "syncFile" || name == "renameFile" || name == "removeFile" || name == "lockFile" || name == "grantRead" || name == "grantDir" || name == "listDir" || name == "makeDir":
            return "io.file"
        if name == "closeListener" || name == "listenError" || name == "listenerPort":
            return "io.net.listen"
        if name == "httpGet" || name == "httpPost" || name == "httpSend" || name == "connect" || name == "connectTls":
            return "io.net"
        if name == "writeStdout" || name == "writeStderr" || name == "readStdin" || name == "readStdinLine" || name == "signals" || name == "exitProcess" || name == "processStats":
            return "io.console"
        if name == "envVar" || name == "envSet":
            return "io.env"
        if name == "readBytes" || name == "writeBytes" || name == "closeConn" || name == "setTimeoutMs" || name == "connError" || name == "connPeer" || name == "pollBytes" || name == "connOpen" || name == "shutdownConn" || name == "closeWrite":
            return "io.net.conn"
        if name == "listen" || name == "listenOn" || name == "listenTls" || name == "accept":
            return "io.net.listen"
        return ""

    # plRequireCap: requireProcCapability().
    # "io.net.conn" (netConnCap) is satisfied by io.net or io.net.listen.
    proc plRequireCap(env: PLEnv, cap: text, what: text) -> text:
        let at = do lowerFindName(env.uses, cap)
        if at >= 0:
            return ""
        let pq = do plQuote(env.procName)
        if cap == "io.net.conn":
            let atNet = do lowerFindName(env.uses, "io.net")
            let atListen = do lowerFindName(env.uses, "io.net.listen")
            if atNet >= 0 || atListen >= 0:
                return ""
            return "proc " + pq + " calls " + what + ", which requires capability \"io.net\" (or \"io.net.listen\" for an accepted connection) — declare it on the proc header (e.g. `proc " + env.procName + "(...) -> ... uses io.net:`)"
        let cq = do plQuote(cap)
        return "proc " + pq + " calls " + what + ", which requires capability " + cq + " — declare it on the proc header (e.g. `proc " + env.procName + "(...) -> ... uses " + cap + ":`)"

    # plCheckCaps: checkProcCapabilities() over nodes (allNodes' walk
    # order) — for each capability name, sorted ("io.console" < "io.env" <
    # "io.file" < "io.net" < "io.net.conn" < "io.net.listen"), the LAST
    # builtin in walk order that needs it (procCapabilities' `caps[cap] =
    # t.Name`), required in turn.
    proc plCheckCaps(env: PLEnv, nodes: [ExprNode]) -> text:
        let caps = ["io.console", "io.env", "io.file", "io.net", "io.net.conn", "io.net.listen"]
        let mut last = {}
        let n = len(nodes)
        let mut k = 0
        loop k < n:
            if nodes[k].kind == "call":
                let c = do plBuiltinCap(nodes[k].text)
                if c != "":
                    last[c] = nodes[k].text
            k = k + 1
        let mut i = 0
        loop i < 6:
            if caps[i] in last:
                let d = do plRequireCap(env, caps[i], last[caps[i]] + "(...)")
                if d != "":
                    return d
            i = i + 1
        return ""

    # plEntryOnly: checkEntryOnlyBuiltins() with isEntry false — the first
    # grantRead/grantDir in walk order.
    proc plEntryOnly(nodes: [ExprNode]) -> text:
        let n = len(nodes)
        let mut i = 0
        loop i < n:
            let e = nodes[i]
            if e.kind == "call" && (e.text == "grantRead" || e.text == "grantDir"):
                return e.text + "(...) is only available in `proc main(args: [text]) -> int` — a file becomes readable outside the sandbox only when the operator names it (an argument or an environment variable) to the process entry point, before any request or connection exists"
            i = i + 1
        return ""

    # plDaemonOnly: checkDaemonOnlyBuiltins() with isDaemon false.
    proc plDaemonOnly(nodes: [ExprNode]) -> text:
        let n = len(nodes)
        let mut i = 0
        loop i < n:
            let e = nodes[i]
            if e.kind == "call":
                let c = do plBuiltinCap(e.text)
                if c == "io.net.listen":
                    return e.text + "(...) is only available inside a daemon body — it can block indefinitely, and only a daemon runs detached from every request's lock (see `daemon Name uses io.net.listen:`)"
            i = i + 1
        return ""

    # plIndexTypes: checkIndexTypes() — an index read on a local whose
    # type is known and is not array/bytes/map (the first in walk order).
    proc plIndexTypes(nodes: [ExprNode], names: [text], types: [text]) -> text:
        let n = len(nodes)
        let mut i = 0
        loop i < n:
            let e = nodes[i]
            if e.kind == "index":
                let obj = e.children[0]
                if obj.kind == "ref":
                    let at = do lowerFindName(names, obj.text)
                    if at >= 0:
                        let ty = types[at]
                        let tyMap = do plIsMapType(ty)
                        if ty != "" && ty != "array" && ty != "bytes" && !tyMap:
                            let q = do plQuote(obj.text)
                            return q + " is not an array or map (its type is " + ty + ") — index access (`" + obj.text + "[...]`) needs an array, map, or byte-buffer local"
            i = i + 1
        return ""

    # plTaskUse: checkNoTaskUse() — a spawned handle used as a value.
    proc plTaskUse(nodes: [ExprNode], names: [text], types: [text]) -> text:
        let n = len(nodes)
        let mut i = 0
        loop i < n:
            let e = nodes[i]
            if e.kind == "ref":
                let at = do lowerFindName(names, e.text)
                if at >= 0:
                    if types[at] == "task":
                        let q = do plQuote(e.text)
                        return q + " is a spawned task handle — it can only be consumed by `join " + e.text + "`, not used as a value"
            i = i + 1
        return ""

    # plInferType: inferProcType() — the shallow static type of a proc
    # expression ("" = unknown), over the parser's node kinds.
    proc plInferType(e: ExprNode, names: [text], types: [text]) -> text:
        if e.kind == "int" || e.kind == "float" || e.kind == "bool" || e.kind == "text":
            return e.kind
        if e.kind == "list":
            return "array"
        if e.kind == "map":
            return "map"
        if e.kind == "struct":
            return e.text
        if e.kind == "ref":
            let at = do lowerFindName(names, e.text)
            if at < 0:
                return ""
            return types[at]
        if e.kind == "call":
            let r = do plInferCallType(e, names, types)
            return r
        # a typed map's element has the map's declared value type; every
        # other index read stays unknown (an array's element type is erased)
        if e.kind == "index" && len(e.children) >= 1 && e.children[0].kind == "ref":
            let ati = do lowerFindName(names, e.children[0].text)
            if ati >= 0:
                let mv = do plMapValType(types[ati])
                return mv
            return ""
        if e.kind == "un":
            if e.text == "!":
                return "bool"
            if e.text == "-" || e.text == "~":
                let r = do plInferType(e.children[0], names, types)
                return r
            return ""
        if e.kind == "bin":
            let r = do plInferBinType(e, names, types)
            return r
        return ""

    proc plInferCallType(e: ExprNode, names: [text], types: [text]) -> text:
        let name = e.text
        if name == "append" || name == "split" || name == "listDir":
            return "array"
        if name == "readStdinLine":
            return "text"
        if name == "p256PrivateKey" || name == "p256PublicKey" || name == "p256Ecdh" || name == "es256Sign" || name == "fromBase64UrlRaw" || name == "uploadBytes":
            return "bytes"
        if name == "httpSend":
            return "int"
        # take(xs, n) is the first n elements of a list
        if name == "take" && len(e.children) == 2:
            let tk = do plInferType(e.children[0], names, types)
            if tk == "array":
                return "array"
        if name == "bytes" || name == "fromHex" || name == "bytesPut" || name == "textToBytes" || name == "readBytes" || name == "pollBytes" || name == "readFileAt" || name == "aesGcmSeal" || name == "aesGcmOpen" || name == "randomBytes" || name == "sha256Bytes" || name == "hmacSha256":
            return "bytes"
        if name == "bytesToText" || name == "toHex" || name == "readFile" || name == "httpGet" || name == "httpPost" || name == "recv" || name == "connError" || name == "connPeer" || name == "listenError" || name == "readStdin" || name == "envVar" || name == "processStats" || name == "base64UrlRaw" || name == "bcryptHash":
            return "text"
        if name == "byteLen" || name == "crc32" || name == "bytesCmp" || name == "bytesCmpRange" || name == "uintLE" || name == "listenerPort" || name == "listen" || name == "listenOn" || name == "listenTls" || name == "awaitAny" || name == "accept" || name == "connect" || name == "connectTls" || name == "channel" || name == "monoMs" || name == "nowMs" || name == "signals" || name == "floatBits" || name == "toInt" || name == "floor" || name == "round" || name == "fileSize" || name == "fileModTime" || name == "indexOf":
            return "int"
        if name == "aesGcmAuthentic" || name == "bcryptMatches" || name == "validUtf8" || name == "trySend" || name == "closeListener" || name == "grantRead" || name == "grantDir" || name == "makeDir" || name == "envSet" || name == "closeChannel" || name == "exitProcess" || name == "connOpen" || name == "lockFile" || name == "shutdownConn" || name == "closeWrite" || name == "sleepMs" || name == "writeBytes" || name == "closeConn" || name == "setTimeoutMs" || name == "send" || name == "writeFile" || name == "appendFile" || name == "fileExists" || name == "truncateFile" || name == "writeFileAt" || name == "syncFile" || name == "renameFile" || name == "removeFile" || name == "writeStdout" || name == "writeStderr":
            return "bool"
        if name == "toFloat" || name == "floatFromBits" || name == "exp" || name == "ln" || name == "sqrt" || name == "sin" || name == "cos" || name == "u64ToFloat":
            return "float"
        if name == "u64Cmp" || name == "u64Min" || name == "u64Max" || name == "u64SatSub" || name == "u64Div" || name == "u64Rem" || name == "u64Parse":
            return "int"
        if name == "u64Text" || name == "u64ParseError" || name == "jsonQuote":
            return "text"
        if name == "print":
            if len(e.children) == 1:
                let r = do plInferType(e.children[0], names, types)
                return r
            return ""
        if name == "abs":
            if len(e.children) == 1:
                let at = do plInferType(e.children[0], names, types)
                if at == "int" || at == "float":
                    return at
            return ""
        if name == "min" || name == "max":
            if len(e.children) == 2:
                let at = do plInferType(e.children[0], names, types)
                let bt = do plInferType(e.children[1], names, types)
                if at == bt && (at == "int" || at == "float"):
                    return at
            return ""
        return ""

    proc plInferBinType(e: ExprNode, names: [text], types: [text]) -> text:
        let op = e.text
        if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" || op == "in":
            return "bool"
        if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>":
            return "int"
        let lt = do plInferType(e.children[0], names, types)
        let rt = do plInferType(e.children[1], names, types)
        if op == "+":
            if lt == "text" || rt == "text":
                return "text"
            if lt == "int" && rt == "int":
                return "int"
            if lt == "float" && rt == "float":
                return "float"
            return ""
        if op == "-" || op == "*" || op == "/":
            if lt == "int" && rt == "int":
                return "int"
            if lt == "float" && rt == "float":
                return "float"
            return ""
        if op == "%":
            if lt == "int" && rt == "int":
                return "int"
            return ""
        return ""

    # ── checkProcExpr's type rules (checkBitwiseTypes, checkNumericTypes,
    #    checkMapKeyTypes) over inferProcType ───────────────────────────
    proc plIsIntType(t: text) -> bool:
        return t == "" || t == "int"

    proc plIsNumeric(t: text) -> bool:
        return t == "int" || t == "float"

    proc plTypeDiag(e: ExprNode, names: [text], types: [text]) -> text:
        if e.kind == "bin" && len(e.children) == 2:
            let op = e.text
            let lt = do plInferType(e.children[0], names, types)
            let rt = do plInferType(e.children[1], names, types)
            if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>":
                let li = do plIsIntType(lt)
                if !li:
                    return op + " needs int operands; left side is " + lt
                let rti = do plIsIntType(rt)
                if !rti:
                    return op + " needs int operands; right side is " + rt
            if op == "%":
                if lt == "float":
                    return "% needs int operands; left side is float (% is int-only — there is no fractional modulus in this language)"
                if rt == "float":
                    return "% needs int operands; right side is float (% is int-only — there is no fractional modulus in this language)"
            let ln = do plIsNumeric(lt)
            let rn = do plIsNumeric(rt)
            let cmpOp = op == "-" || op == "*" || op == "/" || op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="
            if (cmpOp || (op == "+" && lt != "text" && rt != "text")) && ln && rn && lt != rt:
                return op + " needs matching numeric types; left is " + lt + ", right is " + rt + " — there is no automatic int/float promotion, convert one side explicitly with toFloat()/toInt()"
        if e.kind == "un" && e.text == "~" && len(e.children) == 1:
            let xt = do plInferType(e.children[0], names, types)
            let xi = do plIsIntType(xt)
            if !xi:
                return "~ needs an int operand; got " + xt
        if e.kind == "call" && (e.text == "min" || e.text == "max") && len(e.children) == 2:
            let at = do plInferType(e.children[0], names, types)
            let bt = do plInferType(e.children[1], names, types)
            let an = do plIsNumeric(at)
            let bn = do plIsNumeric(bt)
            if an && bn && at != bt:
                return e.text + " needs matching numeric types; got " + at + " and " + bt + " — there is no automatic int/float promotion, convert one side explicitly with toFloat()/toInt()"
        if e.kind == "map":
            let np = len(e.pairs)
            let mut pi = 0
            loop pi < np:
                let kt = do plInferType(e.pairs[pi].key, names, types)
                if kt != "" && kt != "int" && kt != "text":
                    return "map key must be int or text, got " + kt
                pi = pi + 1
        if e.kind == "index" && len(e.children) == 2 && e.children[0].kind == "ref":
            let at2 = do lowerFindName(names, e.children[0].text)
            let isMap2 = at2 >= 0 && plIsMapType(types[at2])
            if isMap2:
                let kt2 = do plInferType(e.children[1], names, types)
                if kt2 != "" && kt2 != "int" && kt2 != "text":
                    return "map key must be int or text, got " + kt2
                let dk2 = do plMapKeyType(types[at2])
                if dk2 != "" && kt2 != "" && kt2 != dk2:
                    let mq2 = do plQuote(e.children[0].text)
                    let dv2 = do plMapValType(types[at2])
                    return mq2 + " is a {" + dk2 + ": " + dv2 + "} map — its key must be " + dk2 + ", got " + kt2
        let subs = do plSubNodes(e)
        let ns = len(subs)
        let mut i = 0
        loop i < ns:
            let d = do plTypeDiag(subs[i], names, types)
            if d != "":
                return d
            i = i + 1
        return ""

    # plCheckExpr: checkProcExpr()'s gating subset, in Go's order.
    proc plCheckExpr(env: PLEnv, e: ExprNode, names0: [text], types0: [text]) -> text:
        let names = names0 + env.sharedNames
        let types = types0 + env.sharedTypes
        let free = do plFreeNames(e)
        let nf = len(free)
        let mut i = 0
        loop i < nf:
            let at = do lowerFindName(names, free[i])
            if at < 0:
                let q = do plQuote(free[i])
                return "unknown reference " + q + " — a proc sees only its own parameters and `let` locals (no state or entities in this milestone)"
            i = i + 1
        let ce = CallEnv{fnNames: [], fnArities: [], procNames: env.procNames, procAt: env.procAt, procArities: env.procArities, procDerives: [], listNames: [], jsonNames: [], deriveKeys: [], inAction: false, inDerive: false, inProc: true, ty: tyEmptyEnv(), tsc: tyEmptyScope(), actionNames: env.actionNames, stateNames: [], stateDeclPlacements: []}
        let nodes = do allNodes(e)
        let bd = do checkBuiltins(nodes, [], [], ce)
        if bd != "":
            return bd
        if !env.isDaemon:
            let d1 = do plDaemonOnly(nodes)
            if d1 != "":
                return d1
        # checkEntryOnlyBuiltins: grantRead only in `proc main` (the entry
        # point is the one daemon-context body named "main").
        if !(env.isDaemon && env.procName == "main"):
            let d0 = do plEntryOnly(nodes)
            if d0 != "":
                return d0
        let td = do plTypeDiag(e, names, types)
        if td != "":
            return td
        let d2 = do plIndexTypes(nodes, names, types)
        if d2 != "":
            return d2
        let d3 = do plTaskUse(nodes, names, types)
        if d3 != "":
            return d3
        let d35 = do plStructFieldTypes(env, e, names, types)
        if d35 != "":
            return d35
        let d4 = do plCheckCaps(env, nodes)
        if d4 != "":
            return d4
        let d5 = do checkProcLiteralExpr(nodes, names)
        return d5

    proc plCheckArgs(env: PLEnv, args: [ExprNode], names: [text], types: [text]) -> text:
        let n = len(args)
        let mut i = 0
        loop i < n:
            let d = do plCheckExpr(env, args[i], names, types)
            if d != "":
                return d
            i = i + 1
        return ""

    # plLower: e.low() — lower() with no inline table (a proc never sees a
    # derive/policy name: freeNames would have refused it first).
    proc plLower(env: PLEnv, e: ExprNode) -> IRExpr:
        let noNames = []
        let noExprs = []
        let r = do lowerNode(e, noNames, noExprs, env.enumNames)
        return r

    proc plLowerList(env: PLEnv, es: [ExprNode]) -> [IRExpr]:
        let noNames = []
        let noExprs = []
        let r = do lowerNodeList(es, noNames, noExprs, env.enumNames)
        return r

    # plSpawnsJoined: checkSpawnsJoined().
    proc plSpawnsJoined(env: PLEnv, pendNames: [text], what: text) -> text:
        if len(pendNames) == 0:
            return ""
        let h = do plMinText(pendNames)
        let pq = do plQuote(env.procName)
        let hq = do plQuote(h)
        return "proc " + pq + " has a spawned task handle " + hq + " still unjoined when " + what + " — join it with `join " + h + "` first; every spawn must be joined in the same block before it can end"

    # plReturnComplete: stmtsReturnComplete().
    proc plReturnComplete(body: [IRStmt]) -> bool:
        let n = len(body)
        if n == 0:
            return false
        let last = body[n - 1]
        if last.op == "return":
            return true
        if last.op == "if":
            if len(last.elseBody) == 0:
                return false
            let a = do plReturnComplete(last.body)
            if !a:
                return false
            let b = do plReturnComplete(last.elseBody)
            return b
        return false

    # ── procBlock ──────────────────────────────────────────────────────
    # plDiagAt: a statement's diagnostic as build.go's BuildError spells it,
    # "line N: …" with the statement's source line — unless it already
    # names one (a nested block's statement, reported by that block).
    proc plDiagAt(env: PLEnv, lineIdx: int, d: text) -> PLBlock:
        let named = do plNamesLine(d)
        if !named && lineIdx >= 0 && lineIdx < len(env.lineNos):
            return PLBlock{stmts: [], diag: "line " + env.lineNos[lineIdx] + ": " + d}
        return PLBlock{stmts: [], diag: d}

    # plNamesLine: d starts "line <digits>: ".
    proc plNamesLine(d: text) -> bool:
        if !hasPrefixText(d, "line "):
            return false
        let colon = indexOf(d, ": ", 5)
        if colon <= 5:
            return false
        let num = slice(d, 5, colon)
        return u64ParseError(num) == ""

    proc plBlock(env: PLEnv, stmts: [Stmt], names0: [text], muts0: [bool], types0: [text], loopDepth: int) -> PLBlock:
        let mut nestedN = 0
        let mut names = names0
        let mut muts = muts0
        let mut types = types0
        let mut pendNames = []
        let mut pendProcs = []
        let mut out = []
        let pq = do plQuote(env.procName)
        let n = len(stmts)
        let mut i = 0
        loop i < n:
            let s = stmts[i]
            let last = i == n - 1
            let lineText = env.texts[s.lineIdx]
            if s.kind == "let" || s.kind == "letMut":
                let name = do letOrAssignName(lineText)
                let at = do lowerFindName(names, name)
                if at >= 0:
                    let q = do plQuote(name)
                    return plDiagAt(env, s.lineIdx, q + " is already declared in proc " + pq)
                let ns = do plNotShared(env, name)
                if ns != "":
                    return plDiagAt(env, s.lineIdx, ns)
                let d = do plCheckExpr(env, s.expr, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let ty = do plStructExprType(env, s.expr, names + env.sharedNames, types + env.sharedTypes)
                names = append(names, name)
                muts = append(muts, s.kind == "letMut")
                types = append(types, ty)
                let v = do plLower(env, s.expr)
                let st = do irLet(name, v)
                out = append(out, st)
            let sharedAt = do lowerFindName(env.sharedNames, letOrAssignName(lineText))
            if s.kind == "assign" && sharedAt >= 0 && lowerFindName(names, letOrAssignName(lineText)) < 0:
                # a shared cell's whole value replaced (build.go's ast.Assign
                # case for e.shareds)
                let d = do plCheckExpr(env, s.expr, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let vt = do plInferType(s.expr, names + env.sharedNames, types + env.sharedTypes)
                let want = env.sharedTypes[sharedAt]
                if vt != "" && vt != want && !(want == "float" && vt == "int"):
                    let sq = do plQuote(env.sharedNames[sharedAt])
                    return plDiagAt(env, s.lineIdx, "cannot assign " + vt + " to shared cell " + sq + ", whose type is " + want)
                let v = do plLower(env, s.expr)
                let st = do irExprStmt(irCall("$shared.set", [irLit(env.sharedNames[sharedAt], "text"), v]))
                out = append(out, st)
            if s.kind == "assign" && !(sharedAt >= 0 && lowerFindName(names, letOrAssignName(lineText)) < 0):
                let target = do letOrAssignName(lineText)
                let at = do lowerFindName(names, target)
                let q = do plQuote(target)
                if at < 0:
                    return plDiagAt(env, s.lineIdx, q + " is not declared in proc " + pq + " — use `let " + target + " = …` first")
                if !muts[at]:
                    return plDiagAt(env, s.lineIdx, q + " is not mutable — declare it `let mut " + target + " = …` to reassign it")
                let d = do plCheckExpr(env, s.expr, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let v = do plLower(env, s.expr)
                let st = do irAssign(target, v)
                out = append(out, st)
            if s.kind == "indexAssign":
                let target = do indexAssignTargetName(lineText)
                let at = do lowerFindName(names, target)
                let q = do plQuote(target)
                if at < 0:
                    return plDiagAt(env, s.lineIdx, q + " is not declared in proc " + pq + " — use `let " + target + " = …` first")
                if !muts[at]:
                    return plDiagAt(env, s.lineIdx, q + " is not mutable — declare it `let mut " + target + " = …` to index-assign into it")
                let ty = types[at]
                let tyIsMap = do plIsMapType(ty)
                if ty != "" && ty != "array" && ty != "bytes" && !tyIsMap:
                    return plDiagAt(env, s.lineIdx, q + " is not an array or map (its type is " + ty + ") — index assignment (`" + target + "[...] = …`) needs an array, map, or byte-buffer local")
                let d1 = do plCheckExpr(env, s.index, names, types)
                if d1 != "":
                    return plDiagAt(env, s.lineIdx, d1)
                let d2 = do plCheckExpr(env, s.expr, names, types)
                if d2 != "":
                    return plDiagAt(env, s.lineIdx, d2)
                if tyIsMap:
                    let kt = do plInferType(s.index, names + env.sharedNames, types + env.sharedTypes)
                    let keyOk = kt == "" || kt == "int" || kt == "text"
                    if !keyOk:
                        return plDiagAt(env, s.lineIdx, "map key must be int or text, got " + kt)
                    # a typed map: its keys and values are what it declared
                    let dk = do plMapKeyType(ty)
                    let dv = do plMapValType(ty)
                    if dk != "" && kt != "" && kt != dk:
                        return plDiagAt(env, s.lineIdx, q + " is a {" + dk + ": " + dv + "} map — its key must be " + dk + ", got " + kt)
                    if dv != "":
                        let vt = do plStructExprType(env, s.expr, names, types)
                        if vt != "" && vt != dv && !(dv == "int" && vt == "bytes"):
                            return plDiagAt(env, s.lineIdx, q + " is a {" + dk + ": " + dv + "} map — its value must be " + dv + ", got " + vt)
                let k = do plLower(env, s.index)
                let v = do plLower(env, s.expr)
                let st = do plIndexSet(target, k, v, ty == "bytes")
                out = append(out, st)
            if s.kind == "fieldAssign":
                let local = do fieldAssignLocal(lineText)
                let field = do fieldAssignField(lineText)
                let at = do lowerFindName(names, local)
                let q = do plQuote(local)
                if at < 0:
                    return plDiagAt(env, s.lineIdx, q + " is not declared in proc " + pq + " — use `let " + local + " = …` first")
                if !muts[at]:
                    return plDiagAt(env, s.lineIdx, q + " is not mutable — declare it `let mut " + local + " = …` to assign its fields")
                let sty = types[at]
                let mut isStruct = false
                if sty in env.structStart:
                    isStruct = env.structEnd[sty] > env.structStart[sty]
                if sty == "" || !isStruct:
                    return plDiagAt(env, s.lineIdx, q + " is not a struct (its type is " + sty + ") — a field write (`" + local + "." + field + " = …`) needs a struct local")
                let fat = do plFieldAt(env, sty + "." + field)
                if fat < 0:
                    let sq = do plQuote(sty)
                    let fq = do plQuote(field)
                    return plDiagAt(env, s.lineIdx, "struct " + sq + " has no field " + fq)
                let d = do plCheckExpr(env, s.expr, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let ftype = env.structFieldTypes[fat]
                let isListField = len(ftype) > 0 && charAt(ftype, 0) == "["
                let fmv = do plMapValType(ftype)
                if fmv != "":
                    # a `{K: V}` field takes a map — of those types, when known
                    let vtm = do plStructExprType(env, s.expr, names, types)
                    let vtmMap = do plIsMapType(vtm)
                    let vtmVal = do plMapValType(vtm)
                    if vtm != "" && (!vtmMap || (vtmVal != "" && vtmVal != fmv)):
                        let fqm = do plQuote(field)
                        let sqm = do plQuote(sty)
                        let fmk = do plMapKeyType(ftype)
                        return plDiagAt(env, s.lineIdx, "cannot assign " + vtm + " to field " + fqm + " of struct " + sqm + ", whose type is {" + fmk + ": " + fmv + "}")
                let vt = do plInferType(s.expr, names + env.sharedNames, types + env.sharedTypes)
                if fmv == "" && vt != "" && !isListField && vt != ftype && !(ftype == "float" && vt == "int"):
                    let fq2 = do plQuote(field)
                    let sq2 = do plQuote(sty)
                    return plDiagAt(env, s.lineIdx, "cannot assign " + vt + " to field " + fq2 + " of struct " + sq2 + ", whose type is " + ftype)
                let v = do plLower(env, s.expr)
                let fs0 = do irStmt("fieldset")
                let fs = IRStmt{op: "fieldset", target: local, entity: fs0.entity, field: field, key: fs0.key, value: [v], fieldNames: fs0.fieldNames, fieldExprs: fs0.fieldExprs, service: fs0.service, args: fs0.args, itemVar: fs0.itemVar, where: fs0.where, order: fs0.order, orderBy: fs0.orderBy, desc: fs0.desc, limit: fs0.limit, bind: fs0.bind, ret: fs0.ret, retList: fs0.retList, role: fs0.role, msg: fs0.msg, status: fs0.status, body: fs0.body, elseBody: fs0.elseBody, bytesFlag: fs0.bytesFlag, file: fs0.file, path: fs0.path, retMap: false, retDepth: 0}
                out = append(out, fs)
            if s.kind == "nestedAssign":
                let mut line = 0
                if s.lineIdx < len(env.lineNos):
                    line = env.lineNos[s.lineIdx]
                let ds = do plDesugar(s.index, s.expr, line, nestedN, [])
                nestedN = ds.n
                if ds.err != "":
                    return plDiagAt(env, s.lineIdx, ds.err)
                let base = len(env.texts)
                let mut synth = []
                let mut k = 0
                loop k < len(ds.stmts):
                    let mut st0 = do plStmtNodeOf(ds.stmts[k])
                    st0.lineIdx = base + k
                    synth = append(synth, st0)
                    k = k + 1
                let mut env2 = env
                env2.texts = env.texts + ds.texts
                let sub = do plBlock(env2, synth, names, muts, types, loopDepth)
                if sub.diag != "":
                    return plDiagAt(env, s.lineIdx, sub.diag)
                out = out + sub.stmts
            if s.kind == "assignDoNested":
                # `s.f = do Proc(args)`: parseProcBody's composition — the
                # result into a `let mut` temporary numbered like a nested
                # write's (nestedWriteTemp), then the ordinary write of that
                # temporary (one level, or desugarNestedWrite's chain).
                let mut line = 0
                if s.lineIdx < len(env.lineNos):
                    line = env.lineNos[s.lineIdx]
                let n1 = nestedN + 1
                let tmp = "__w" + line + "_" + n1
                let pn0 = do assignDoProcName(lineText)
                let none = do emptyNode()
                let ds = do plDesugar(s.index, refNode(tmp), line, n1, [])
                nestedN = ds.n
                if ds.err != "":
                    return plDiagAt(env, s.lineIdx, ds.err)
                let base = len(env.texts)
                let letTmp = Stmt{kind: "letMutDo", lineIdx: base, expr: none, args: s.args, body: [], elseBody: [], index: none}
                let mut synth = [letTmp]
                let mut k = 0
                loop k < len(ds.stmts):
                    let mut st0 = do plStmtNodeOf(ds.stmts[k])
                    st0.lineIdx = base + 1 + k
                    synth = append(synth, st0)
                    k = k + 1
                let mut env2 = env
                env2.texts = env.texts + ["let mut " + tmp + " = do " + pn0 + "("] + ds.texts
                let sub = do plBlock(env2, synth, names, muts, types, loopDepth)
                if sub.diag != "":
                    return plDiagAt(env, s.lineIdx, sub.diag)
                out = out + sub.stmts
            if s.kind == "assignDo":
                let target = do assignDoTarget(lineText)
                let pn0 = do assignDoProcName(lineText)
                let pn = do plRename(env, pn0)
                let sigAt = do plProcAt(env, pn)
                let cq = do plQuote(pn)
                if sigAt < 0:
                    return plDiagAt(env, s.lineIdx, "do calls unknown proc " + cq)
                let d = do plCheckArgs(env, s.args, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let args = do plLowerList(env, s.args)
                let at = do lowerFindName(names, target)
                let tq = do plQuote(target)
                if at < 0:
                    return plDiagAt(env, s.lineIdx, tq + " is not declared in proc " + pq + " — use `let " + target + " = …` first")
                if !muts[at]:
                    return plDiagAt(env, s.lineIdx, tq + " is not mutable — declare it `let mut " + target + " = …` to reassign it")
                let sigRet = do plTextAt(env.procRets, sigAt)
                let sigRetList = do plBoolAt(env.procRetLists, sigAt)
                if sigRet == "":
                    return plDiagAt(env, s.lineIdx, "proc " + cq + " returns nothing — declare a return type to assign its result")
                if sigRetList:
                    types[at] = "array"
                else:
                    types[at] = sigRet
                let dmap = do plMapArgDiag(env, pn, plTextAt(env.procParamMaps, sigAt), s.args, names, types)
                if dmap != "":
                    return plDiagAt(env, s.lineIdx, dmap)
                let mut d0 = do irDo(pn, args, "", plRetCore(sigRet), sigRetList)
                d0.retMap = plIsMapType(sigRet)
                d0.retDepth = plRetDepth(sigRet, sigRetList)
                let ds = IRStmt{op: d0.op, target: target, entity: d0.entity, field: d0.field, key: d0.key, value: d0.value, fieldNames: d0.fieldNames, fieldExprs: d0.fieldExprs, service: d0.service, args: d0.args, itemVar: d0.itemVar, where: d0.where, order: d0.order, orderBy: d0.orderBy, desc: d0.desc, limit: d0.limit, bind: d0.bind, ret: d0.ret, retList: d0.retList, role: d0.role, msg: d0.msg, status: d0.status, body: d0.body, elseBody: d0.elseBody, bytesFlag: d0.bytesFlag, file: d0.file, path: d0.path, retMap: false, retDepth: 0}
                out = append(out, ds)
            if s.kind == "do" || s.kind == "letDo" || s.kind == "letMutDo":
                let mut procName = ""
                let mut bind = ""
                if s.kind == "do":
                    let pn0 = do bareDoProcName(lineText)
                    let pn = do plRename(env, pn0)
                    procName = pn
                else:
                    let pn0 = do letDoProcName(lineText)
                    let pn = do plRename(env, pn0)
                    let bn = do letDoBoundName(lineText)
                    procName = pn
                    bind = bn
                let sigAt = do plProcAt(env, procName)
                let cq = do plQuote(procName)
                if sigAt < 0:
                    return plDiagAt(env, s.lineIdx, "do calls unknown proc " + cq)
                let d = do plCheckArgs(env, s.args, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let dmap = do plMapArgDiag(env, procName, plTextAt(env.procParamMaps, sigAt), s.args, names, types)
                if dmap != "":
                    return plDiagAt(env, s.lineIdx, dmap)
                let args = do plLowerList(env, s.args)
                let sigRet = do plTextAt(env.procRets, sigAt)
                let sigRetList = do plBoolAt(env.procRetLists, sigAt)
                let mut ret = ""
                let mut retList = false
                if bind != "":
                    let bat = do lowerFindName(names, bind)
                    if bat >= 0:
                        let bq = do plQuote(bind)
                        return plDiagAt(env, s.lineIdx, bq + " is already in scope — pick another name for the bound result")
                    let nsh = do plNotShared(env, bind)
                    if nsh != "":
                        return plDiagAt(env, s.lineIdx, nsh)
                    if sigRet == "":
                        return plDiagAt(env, s.lineIdx, "proc " + cq + " returns nothing — declare a return type to bind it")
                    names = append(names, bind)
                    muts = append(muts, s.kind == "letMutDo")
                    if sigRetList:
                        types = append(types, "array")
                    else:
                        types = append(types, sigRet)
                    ret = sigRet
                    retList = sigRetList
                let mut st = do irDo(procName, args, bind, plRetCore(ret), retList)
                st.retMap = plIsMapType(ret)
                st.retDepth = plRetDepth(ret, retList)
                out = append(out, st)
            if s.kind == "spawn":
                let pn0 = do spawnProcName(lineText)
                let pn = do plRename(env, pn0)
                let handle = do spawnHandleName(lineText)
                let sigAt = do plProcAt(env, pn)
                if sigAt < 0:
                    let cq = do plQuote(pn)
                    return plDiagAt(env, s.lineIdx, "spawn calls unknown proc " + cq)
                let d = do plCheckArgs(env, s.args, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let args = do plLowerList(env, s.args)
                let hat = do lowerFindName(names, handle)
                if hat >= 0:
                    let hq = do plQuote(handle)
                    return plDiagAt(env, s.lineIdx, hq + " is already in scope — pick another name for the spawned task handle")
                let nsh = do plNotShared(env, handle)
                if nsh != "":
                    return plDiagAt(env, s.lineIdx, nsh)
                names = append(names, handle)
                muts = append(muts, false)
                types = append(types, "task")
                pendNames = append(pendNames, handle)
                pendProcs = append(pendProcs, pn)
                let st = do plSpawn(handle, pn, args)
                out = append(out, st)
            if s.kind == "join" || s.kind == "letJoin":
                let mut handle = ""
                let mut bind = ""
                if s.kind == "join":
                    let h = do joinHandleName(lineText)
                    handle = h
                else:
                    let h = do letJoinHandleName(lineText)
                    let b = do letJoinBoundName(lineText)
                    handle = h
                    bind = b
                let hq = do plQuote(handle)
                let hat = do lowerFindName(names, handle)
                if hat < 0:
                    return plDiagAt(env, s.lineIdx, "join of undeclared local " + hq + " — expected a handle from `let " + handle + " = spawn ProcName(args)`")
                if types[hat] != "task":
                    return plDiagAt(env, s.lineIdx, hq + " is not a spawned task handle — join needs a `let h = spawn ProcName(args)` result")
                let pat = do lowerFindName(pendNames, handle)
                if pat < 0:
                    return plDiagAt(env, s.lineIdx, hq + " was already joined — a task handle can only be joined once, and only in the same block it was spawned in")
                let taskProc = pendProcs[pat]
                let pn2 = do plRemoveAt(pendNames, pat)
                let pp2 = do plRemoveAt(pendProcs, pat)
                pendNames = pn2
                pendProcs = pp2
                let sigAt = do plProcAt(env, taskProc)
                let sigRet = do plTextAt(env.procRets, sigAt)
                let sigRetList = do plBoolAt(env.procRetLists, sigAt)
                let mut ret = ""
                let mut retList = false
                let mut jdepth = 0
                if bind != "":
                    let bat = do lowerFindName(names, bind)
                    if bat >= 0:
                        let bq = do plQuote(bind)
                        return plDiagAt(env, s.lineIdx, bq + " is already in scope — pick another name for the joined result")
                    let nsh = do plNotShared(env, bind)
                    if nsh != "":
                        return plDiagAt(env, s.lineIdx, nsh)
                    if sigRet == "":
                        let tq = do plQuote(taskProc)
                        return plDiagAt(env, s.lineIdx, "spawned proc " + tq + " returns nothing — declare a return type to bind its joined result")
                    names = append(names, bind)
                    muts = append(muts, false)
                    # join binds the value type (build.go's task.sig.ret)
                    let jret = do plRetCore(sigRet)
                    jdepth = plRetDepth(sigRet, sigRetList)
                    if sigRetList:
                        types = append(types, "array")
                    else:
                        types = append(types, jret)
                    ret = jret
                    retList = sigRetList
                let mut st = do plJoin(handle, bind, ret, retList)
                st.retDepth = jdepth
                out = append(out, st)
            if s.kind == "exprStmt":
                let d = do plCheckExpr(env, s.expr, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let v = do plLower(env, s.expr)
                let st = do irExprStmt(v)
                out = append(out, st)
            if s.kind == "read" || s.kind == "letRead" || s.kind == "write" || s.kind == "letWrite":
                let isRead = s.kind == "read" || s.kind == "letRead"
                let mut op = "write"
                if isRead:
                    op = "read"
                let mut fileName = ""
                let mut bind = ""
                if s.kind == "read" || s.kind == "write":
                    let fnm = do bareFileOpName(lineText, op + " ")
                    fileName = fnm
                else:
                    let fnm = do letFileOpFileName(lineText, op + " ")
                    let b = do letFileOpBoundName(lineText)
                    fileName = fnm
                    bind = b
                let fq = do plQuote(fileName)
                let fat = do lowerFindName(env.fileNames, fileName)
                if fat < 0:
                    return plDiagAt(env, s.lineIdx, op + " " + fileName + "(...) — " + fq + " is not a declared file (add `file " + fileName + ": text at \"...\"` or `bytes`)")
                let fileType = do plTextAt(env.fileTypes, fat)
                let filePath = do plTextAt(env.filePaths, fat)
                let isBytes = fileType == "bytes"
                if isRead:
                    if len(s.args) != 0:
                        return plDiagAt(env, s.lineIdx, "read " + fileName + "() takes no arguments")
                    let cd = do plRequireCap(env, "io.file", "read " + fileName + "(...)")
                    if cd != "":
                        return plDiagAt(env, s.lineIdx, cd)
                    if bind != "":
                        let bat = do lowerFindName(names, bind)
                        if bat >= 0:
                            let bq = do plQuote(bind)
                            return plDiagAt(env, s.lineIdx, bq + " is already in scope — pick another name for the bound result")
                        let nsh = do plNotShared(env, bind)
                        if nsh != "":
                            return plDiagAt(env, s.lineIdx, nsh)
                        names = append(names, bind)
                        muts = append(muts, false)
                        if isBytes:
                            types = append(types, "bytes")
                        else:
                            types = append(types, "text")
                    let st = do plFileRead(fileName, filePath, isBytes, bind)
                    out = append(out, st)
                else:
                    if len(s.args) != 1:
                        return plDiagAt(env, s.lineIdx, "write " + fileName + "(...) takes exactly one argument (the content to write)")
                    let cd = do plRequireCap(env, "io.file", "write " + fileName + "(...)")
                    if cd != "":
                        return plDiagAt(env, s.lineIdx, cd)
                    let d = do plCheckExpr(env, s.args[0], names, types)
                    if d != "":
                        return plDiagAt(env, s.lineIdx, d)
                    let mut wantType = "text"
                    if isBytes:
                        wantType = "bytes"
                    let argType = do plInferType(s.args[0], names + env.sharedNames, types + env.sharedTypes)
                    if argType != "" && argType != wantType:
                        if isBytes:
                            return plDiagAt(env, s.lineIdx, "write " + fileName + "(...) needs a byte buffer — file " + fq + " is declared `bytes`, got " + argType)
                        return plDiagAt(env, s.lineIdx, "write " + fileName + "(...) needs text — file " + fq + " is declared `text`, got " + argType)
                    if bind != "":
                        let bat = do lowerFindName(names, bind)
                        if bat >= 0:
                            let bq = do plQuote(bind)
                            return plDiagAt(env, s.lineIdx, bq + " is already in scope — pick another name for the bound result")
                        let nsh = do plNotShared(env, bind)
                        if nsh != "":
                            return plDiagAt(env, s.lineIdx, nsh)
                        names = append(names, bind)
                        muts = append(muts, false)
                        types = append(types, "bool")
                    let v = do plLower(env, s.args[0])
                    let st = do plFileWrite(fileName, filePath, isBytes, v, bind)
                    out = append(out, st)
            if s.kind == "loop":
                let sj = do plSpawnsJoined(env, pendNames, "starting a loop")
                if sj != "":
                    return plDiagAt(env, s.lineIdx, sj)
                let d = do plCheckExpr(env, s.expr, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let kids = do plBlock(env, s.body, names, muts, types, loopDepth + 1)
                if kids.diag != "":
                    return plDiagAt(env, s.lineIdx, kids.diag)
                let cond = do plLower(env, s.expr)
                let st = do plLoop(cond, kids.stmts)
                out = append(out, st)
            if s.kind == "if":
                let sj = do plSpawnsJoined(env, pendNames, "branching (if)")
                if sj != "":
                    return plDiagAt(env, s.lineIdx, sj)
                let d = do plCheckExpr(env, s.expr, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let then = do plBlock(env, s.body, names, muts, types, loopDepth)
                if then.diag != "":
                    return plDiagAt(env, s.lineIdx, then.diag)
                let mut els = []
                if len(s.elseBody) > 0:
                    let eb = do plBlock(env, s.elseBody, names, muts, types, loopDepth)
                    if eb.diag != "":
                        return plDiagAt(env, s.lineIdx, eb.diag)
                    els = eb.stmts
                let cond = do plLower(env, s.expr)
                let st = do irIf(cond, then.stmts, els)
                out = append(out, st)
            if s.kind == "break" || s.kind == "continue":
                let mut what = "breaking"
                if s.kind == "continue":
                    what = "continuing"
                let sj = do plSpawnsJoined(env, pendNames, what)
                if sj != "":
                    return plDiagAt(env, s.lineIdx, sj)
                if loopDepth == 0:
                    return plDiagAt(env, s.lineIdx, s.kind + " outside a loop in proc " + pq)
                if !last:
                    return plDiagAt(env, s.lineIdx, s.kind + " must be the last statement of its block")
                let st = do irStmt(s.kind)
                out = append(out, st)
            if s.kind == "return":
                let sj = do plSpawnsJoined(env, pendNames, "returning")
                if sj != "":
                    return plDiagAt(env, s.lineIdx, sj)
                if !last:
                    return plDiagAt(env, s.lineIdx, "return must be the last statement of its block")
                let bare = trim(lineText) == "return"
                if env.procRet == "":
                    if !bare:
                        return plDiagAt(env, s.lineIdx, "proc " + pq + " declares no return type, so `return` cannot carry a value")
                    let st = do plReturn([])
                    out = append(out, st)
                else:
                    if bare:
                        return plDiagAt(env, s.lineIdx, "proc " + pq + " returns " + env.procRet + ", so `return` needs a value")
                    let d = do plCheckExpr(env, s.expr, names, types)
                    if d != "":
                        return plDiagAt(env, s.lineIdx, d)
                    let v = do plLower(env, s.expr)
                    let st = do plReturn([v])
                    out = append(out, st)
            if s.kind == "act":
                let an = do plActName(lineText)
                let aq = do plQuote(an)
                if !env.isDaemon:
                    return plDiagAt(env, s.lineIdx, "act is only valid inside a daemon body — " + pq + " is a proc, not a daemon")
                let sigAt = do lowerFindName(env.actionNames, an)
                if sigAt < 0:
                    return plDiagAt(env, s.lineIdx, "act calls unknown action " + aq)
                if !env.actionServer[sigAt]:
                    return plDiagAt(env, s.lineIdx, "act calls client-placed action " + aq + "; a daemon runs on the server authority, so the action must be authoritative")
                if len(s.args) != env.actionParamCounts[sigAt]:
                    return plDiagAt(env, s.lineIdx, "action " + aq + " expects " + env.actionParamCounts[sigAt] + " argument(s), got " + len(s.args))
                let d = do plCheckArgs(env, s.args, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let args = do plLowerList(env, s.args)
                let st0 = do irStmt("actcall")
                let st = IRStmt{op: st0.op, target: "", entity: "", field: "", key: [], value: [], fieldNames: [], fieldExprs: [], service: an, args: args, itemVar: "", where: [], order: "", orderBy: [], desc: false, limit: [], bind: "", ret: "", retList: false, role: [], msg: "", status: 0, body: [], elseBody: [], bytesFlag: false, file: "", path: "", retMap: false, retDepth: 0}
                out = append(out, st)
            if s.kind == "detach":
                # build.go's ast.Detach case: daemon-context bodies only, a
                # known proc, its arguments checked, lowered to the "$detach"
                # intrinsic call with the proc's name as its first argument.
                let t0 = trim(lineText)
                let rest0 = do stmtTrimPrefix(t0, "detach ")
                let rest = trim(rest0)
                let openParen = do firstParenIndex(rest)
                let pn = do plRename(env, trim(slice(rest, 0, openParen)))
                if !env.isDaemon:
                    return plDiagAt(env, s.lineIdx, "detach is only valid inside a daemon body — " + pq + " is a proc, and a proc's concurrency is structured: use `let h = spawn " + pn + "(...)` and `join h`")
                let sigAt = do plProcAt(env, pn)
                if sigAt < 0:
                    let dq = do plQuote(pn)
                    return plDiagAt(env, s.lineIdx, "detach calls unknown proc " + dq)
                let d = do plCheckArgs(env, s.args, names, types)
                if d != "":
                    return plDiagAt(env, s.lineIdx, d)
                let args = do plLowerList(env, s.args)
                let call = do irCall("$detach", [irLit(pn, "text")] + args)
                let st = do irExprStmt(call)
                out = append(out, st)
            if s.kind == "unsupported":
                return plDiagAt(env, s.lineIdx, "unsupported statement in proc " + pq)
            i = i + 1
        let endDiag = do plSpawnsJoined(env, pendNames, "the block ends")
        if endDiag != "":
            return PLBlock{stmts: [], diag: endDiag}
        return PLBlock{stmts: out, diag: ""}

    # ── proc ───────────────────────────────────────────────────────────
    proc plLowerProc(headerLine: text, bodySrc: text, procNames: [text], procRets: [text], procRetLists: [bool], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text]) -> PLResult:
        let name0 = do parseProcHeaderName(headerLine)
        let r = do plLowerProcR(name0, headerLine, bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enumNames, [], [])
        return r

    # plFieldAt: lowerFindName(env.structFieldKeys, key), by the index map.
    proc plFieldAt(env: PLEnv, key: text) -> int:
        if key in env.structFieldAt:
            return env.structFieldAt[key]
        return -1

    # plProcAt: lowerFindName(env.procNames, name), by the index map.
    proc plProcAt(env: PLEnv, name: text) -> int:
        if name in env.procAt:
            return env.procAt[name]
        return -1

    # plRename: the mangled name of a same-file private proc, else name.
    proc plRename(env: PLEnv, name: text) -> text:
        let at = do lowerFindName(env.renameFrom, name)
        if at < 0:
            return name
        return env.renameTo[at]

    # plLowerProcR: plLowerProc with the proc's (possibly mangled) name and
    # its file's private-proc rename table given explicitly.
    proc plLowerProcR(name: text, headerLine: text, bodySrc: text, procNames: [text], procRets: [text], procRetLists: [bool], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text], renameFrom: [text], renameTo: [text]) -> PLResult:
        let r = do plLowerProcS(name, headerLine, bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enumNames, renameFrom, renameTo, [], [])
        return r

    # plLowerProcS: plLowerProcR with the app's struct table, for a
    # `local.field = expr` write.
    proc plLowerProcS(name: text, headerLine: text, bodySrc: text, procNames: [text], procRets: [text], procRetLists: [bool], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text], renameFrom: [text], renameTo: [text], structFieldKeys: [text], structFieldTypes: [text]) -> PLResult:
        let pNames = do parseProcHeaderParamNames(headerLine)
        let pTypes = do parseProcHeaderParamTypes(headerLine)
        let pLists = do parseProcHeaderParamLists(headerLine)
        let hasRet = do parseProcHeaderHasRet(headerLine)
        let retCore0 = do parseProcHeaderRetCore(headerLine)
        let retList0 = do parseProcHeaderRetIsList(headerLine)
        # the program entry point (`proc main(args: [text]) -> int`) is a
        # daemon-context body, as isProcessEntry makes it in build.go
        let entry = name == "main" && len(pNames) == 1 && pLists[0] && pTypes[0] == "text" && hasRet && retCore0 == "int" && !retList0
        let bare = do plBareCtx(structFieldKeys, procNames)
        let body = do parseProcBodySrc(bodySrc)
        let r = do plLowerProcX(name, headerLine, bodySrc, body, procNames, procRets, procRetLists, [], fileNames, fileTypes, filePaths, enumNames, renameFrom, renameTo, structFieldKeys, structFieldTypes, bare, entry, [], [], [])
        return r

    proc plStmtAt(ss: [Stmt], i: int) -> Stmt:
        return ss[i]

    # plRenameCalls: rewriteInlineCalls over a proc body — every call of
    # a same-file private proc, in every statement's expressions.
    proc plRenameCalls(ss: [Stmt], from: [text], to: [text]) -> [Stmt]:
        let mut out = []
        let mut i = 0
        loop i < len(ss):
            let mut s = plStmtAt(ss, i)
            s.expr = exprRenameCalls(ss[i].expr, from, to)
            s.index = exprRenameCalls(ss[i].index, from, to)
            s.args = exprsRenameCalls(ss[i].args, from, to)
            s.body = plRenameCalls(ss[i].body, from, to)
            s.elseBody = plRenameCalls(ss[i].elseBody, from, to)
            out = append(out, s)
            i = i + 1
        return out

    # plBareCtx: a PLCtx with no shared cells, context procs or struct
    # names, whose struct spans index keys ("Struct.field", each struct's
    # fields contiguous), over procNames.
    proc plBareCtx(keys: [text], procNames: [text]) -> PLCtx:
        let mut unchecked = []
        let mut procAt = {}
        loop len(unchecked) < len(procNames):
            if !(procNames[len(unchecked)] in procAt):
                procAt[procNames[len(unchecked)]] = len(unchecked)
            unchecked = append(unchecked, -1)
        let mut fieldAt = {}
        let mut fi = 0
        loop fi < len(keys):
            if !(keys[fi] in fieldAt):
                fieldAt[keys[fi]] = fi
            fi = fi + 1
        let mut start = {}
        let mut end = {}
        let mut i = 0
        loop i < len(keys):
            let dot = indexOf(keys[i], ".", 0)
            let sname = slice(keys[i], 0, dot)
            if !(sname in start):
                start[sname] = i
                let mut j = i
                loop j < len(keys) && slice(keys[j], 0, dot + 1) == sname + ".":
                    j = j + 1
                end[sname] = j
            i = i + 1
        return PLCtx{sharedNames: [], sharedTypes: [], ctxProcs: [], lineNos: [], structNames: [], structStart: start, structEnd: end, structFieldAt: fieldAt, procAt: procAt, unchecked: unchecked, ty: tyEmptyEnv()}

    # plLowerProcX: procIn — a proc lowered against the app's shared cells;
    # daemonCtx lowers it as a daemon-context body (the entry point, or a
    # proc only ever detached from one), with `act` resolved against the
    # action signatures. body is bodySrc already parsed (a ProcDecl's
    # own body — parseProcDecl parsed it once; it is not parsed again).
    proc plLowerProcX(name: text, headerLine: text, bodySrc: text, body: [Stmt], procNames: [text], procRets: [text], procRetLists: [bool], procParamMaps: [text], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text], renameFrom: [text], renameTo: [text], structFieldKeys: [text], structFieldTypes: [text], ctx: PLCtx, daemonCtx: bool, actionNames: [text], actionServer: [bool], actionParamCounts: [int]) -> PLResult:
        let pNames = do parseProcHeaderParamNames(headerLine)
        let pTypes = do parseProcHeaderParamTypes(headerLine)
        let pLists = do parseProcHeaderParamLists(headerLine)
        let pOpts = do parseProcHeaderParamOptionals(headerLine)
        let pMaps = do parseProcHeaderParamMapSpecs(headerLine)
        let retMapSpec = do parseProcHeaderRetMapSpec(headerLine)
        let hasRet = do parseProcHeaderHasRet(headerLine)
        let retCore0 = do parseProcHeaderRetCore(headerLine)
        let retList0 = do parseProcHeaderRetIsList(headerLine)
        let uses = do parseProcHeaderUses(headerLine)
        let mut ret = ""
        let mut retList = false
        let mut retMap = false
        let mut retKey = ""
        let mut retDepth = 0
        if hasRet:
            ret = retCore0
            retList = retList0
            # `-> [[T]]`: the element type peeled to T, the depth recorded
            let rd0 = do nestedDepth(retCore0)
            if retList0 && rd0 > 0:
                ret = do nestedBase(retCore0)
                retDepth = rd0
            if retMapSpec != "":
                ret = do mapSpecVal(retMapSpec)
                retKey = do mapSpecKey(retMapSpec)
                retMap = true
        let empty = do plEmptyProc()
        let pq = do plQuote(name)
        let np = len(pNames)
        let mut names = []
        let mut muts = []
        let mut types = []
        let mut params = []
        let mut i = 0
        loop i < np:
            let dup = do lowerFindName(names, pNames[i])
            if dup >= 0:
                let dq = do plQuote(pNames[i])
                return PLResult{proc: empty, diag: "proc " + pq + " has duplicate parameter " + dq}
            names = append(names, pNames[i])
            muts = append(muts, false)
            # a map parameter is tagged as a typed map (mapTag): `p[k]` then
            # has the value type, and `p[k].field` is checked against it
            let pms = pMaps[i]
            if pms != "":
                let pmk = do mapSpecKey(pms)
                let pmv = do mapSpecVal(pms)
                types = append(types, "map:" + pmk + ":" + pmv)
                params = append(params, IRParam{name: pNames[i], type: pmv, optional: false, list: false, map: true, key: pmk, depth: 0})
            else:
                if pLists[i]:
                    types = append(types, "array")
                else:
                    types = append(types, pTypes[i])
                # `[[T]]`: the element type peeled to T, the depth recorded
                let mut ptype = pTypes[i]
                let mut pdepth = 0
                let pd0 = do nestedDepth(pTypes[i])
                if pLists[i] && pd0 > 0:
                    ptype = do nestedBase(pTypes[i])
                    pdepth = pd0
                params = append(params, IRParam{name: pNames[i], type: ptype, optional: pOpts[i], list: pLists[i], map: false, key: "", depth: pdepth})
            i = i + 1
        let mut si = 0
        loop si < np:
            if lowerFindName(ctx.sharedNames, pNames[si]) >= 0:
                let sq = do plQuote(pNames[si])
                return PLResult{proc: empty, diag: sq + " is a shared cell — a parameter or local may not reuse its name"}
            si = si + 1
        let texts = do plBodyTexts(bodySrc)
        let mut stmts = body
        if len(renameFrom) > 0:
            stmts = plRenameCalls(body, renameFrom, renameTo)
        let env = PLEnv{procName: name, procRet: ret, uses: uses, texts: texts, procNames: procNames, procArities: ctx.unchecked, procRets: procRets, procRetLists: procRetLists, procParamMaps: procParamMaps, fileNames: fileNames, fileTypes: fileTypes, filePaths: filePaths, enumNames: enumNames, isDaemon: daemonCtx, actionNames: actionNames, actionServer: actionServer, actionParamCounts: actionParamCounts, renameFrom: renameFrom, renameTo: renameTo, structFieldKeys: structFieldKeys, structFieldTypes: structFieldTypes, sharedNames: ctx.sharedNames, sharedTypes: ctx.sharedTypes, lineNos: ctx.lineNos, structNames: ctx.structNames, structStart: ctx.structStart, structEnd: ctx.structEnd, structFieldAt: ctx.structFieldAt, procAt: ctx.procAt, ty: ctx.ty}
        let blk0 = do plBlock(env, stmts, names, muts, types, 0)
        if blk0.diag != "":
            return PLResult{proc: empty, diag: blk0.diag}
        let blk = PLBlock{stmts: plSharedStmts(blk0.stmts, ctx.sharedNames), diag: ""}
        if len(blk.stmts) == 0:
            return PLResult{proc: empty, diag: "proc " + pq + " has no body"}
        if ret != "":
            let complete = do plReturnComplete(blk.stmts)
            if !complete:
                return PLResult{proc: empty, diag: "proc " + pq + " declares a return type " + ret + ", so its body must end with `return <expr>` on every path — an `if` used as the last statement needs an `else`, and both branches must themselves end that way"}
        return PLResult{proc: IRProc{name: name, params: params, ret: ret, retList: retList, body: blk.stmts, retMap: retMap, retKey: retKey, retDepth: retDepth}, diag: ""}

    # plActName: parseAct's action name — the text before the first `(`.
    proc plActName(lineText: text) -> text:
        let t = trim(lineText)
        let rest0 = do stmtTrimPrefix(t, "act ")
        let rest = trim(rest0)
        let openParen = do firstParenIndex(rest)
        if openParen < 0:
            return rest
        return trim(slice(rest, 0, openParen))

    # plLowerDaemon: build.go's e.daemon — the capability list validated
    # (known, no repeats), then the body lowered as a proc body named
    # `daemon <Name>` with `act` and the daemon-only builtins enabled.
    struct PLDaemon:
        body: [IRStmt]
        diag: text

    proc plLowerDaemon(name: text, uses: [text], bodySrc: text, procNames: [text], procRets: [text], procRetLists: [bool], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text], actionNames: [text], actionServer: [bool], actionParamCounts: [int], renameFrom: [text], renameTo: [text], structFieldKeys: [text], structFieldTypes: [text]) -> PLDaemon:
        let bare = do plBareCtx(structFieldKeys, procNames)
        let r = do plLowerDaemonX(name, uses, bodySrc, procNames, procRets, procRetLists, [], fileNames, fileTypes, filePaths, enumNames, actionNames, actionServer, actionParamCounts, renameFrom, renameTo, structFieldKeys, structFieldTypes, bare)
        return r

    proc plLowerDaemonX(name: text, uses: [text], bodySrc: text, procNames: [text], procRets: [text], procRetLists: [bool], procParamMaps: [text], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text], actionNames: [text], actionServer: [bool], actionParamCounts: [int], renameFrom: [text], renameTo: [text], structFieldKeys: [text], structFieldTypes: [text], ctx: PLCtx) -> PLDaemon:
        let dq = do plQuote(name)
        let mut seen = []
        let nu = len(uses)
        let mut ui = 0
        loop ui < nu:
            let u = uses[ui]
            let uq = do plQuote(u)
            if u != "io.console" && u != "io.env" && u != "io.file" && u != "io.net" && u != "io.net.listen":
                return PLDaemon{body: [], diag: "daemon " + dq + " declares unknown capability " + uq + " — known capabilities: io.console, io.env, io.file, io.net, io.net.listen"}
            let dup = do lowerFindName(seen, u)
            if dup >= 0:
                return PLDaemon{body: [], diag: "daemon " + dq + " declares capability " + uq + " more than once"}
            seen = append(seen, u)
            ui = ui + 1
        let texts = do plBodyTexts(bodySrc)
        let mut stmts = do parseProcBodySrc(bodySrc)
        if len(renameFrom) > 0:
            stmts = plRenameCalls(stmts, renameFrom, renameTo)
        let env = PLEnv{procName: "daemon " + name, procRet: "", uses: uses, texts: texts, procNames: procNames, procArities: ctx.unchecked, procRets: procRets, procRetLists: procRetLists, procParamMaps: procParamMaps, fileNames: fileNames, fileTypes: fileTypes, filePaths: filePaths, enumNames: enumNames, isDaemon: true, actionNames: actionNames, actionServer: actionServer, actionParamCounts: actionParamCounts, renameFrom: renameFrom, renameTo: renameTo, structFieldKeys: structFieldKeys, structFieldTypes: structFieldTypes, sharedNames: ctx.sharedNames, sharedTypes: ctx.sharedTypes, lineNos: ctx.lineNos, structNames: ctx.structNames, structStart: ctx.structStart, structEnd: ctx.structEnd, structFieldAt: ctx.structFieldAt, procAt: ctx.procAt, ty: ctx.ty}
        let blk = do plBlock(env, stmts, [], [], [], 0)
        if blk.diag != "":
            return PLDaemon{body: [], diag: blk.diag}
        if len(blk.stmts) == 0:
            return PLDaemon{body: [], diag: "daemon " + dq + " has no body"}
        let body = do plSharedStmts(blk.stmts, ctx.sharedNames)
        return PLDaemon{body: body, diag: ""}

    # lowerProcSrc: the IRProc (name "" on a compile error).
    proc lowerProcSrc(headerLine: text, bodySrc: text, procNames: [text], procRets: [text], procRetLists: [bool], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text]) -> IRProc:
        let r = do plLowerProc(headerLine, bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enumNames)
        return r.proc

    # lowerProcDiag: "" on success, else the Go builder's message.
    proc lowerProcDiag(headerLine: text, bodySrc: text, procNames: [text], procRets: [text], procRetLists: [bool], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text]) -> text:
        let r = do plLowerProc(headerLine, bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enumNames)
        return r.diag

    # lowerProcJSON: json.Marshal(ir.Proc)'s spelling of the lowered proc
    # ("" on a compile error, since an unnamed proc is never emitted).
    proc lowerProcJSON(headerLine: text, bodySrc: text, procNames: [text], procRets: [text], procRetLists: [bool], fileNames: [text], fileTypes: [text], filePaths: [text], enumNames: [text]) -> text:
        let r = do plLowerProc(headerLine, bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enumNames)
        if r.diag != "":
            return ""
        let j = do irProcJSON(r.proc)
        return j

    # ── HTTP driver ────────────────────────────────────────────────────
    # Newline-separated text lists (lower.fct's lowerSplitLines: "" is
    # the empty list); procRetListLines is "true"/"false" per line.
    proc plBoolLines(s: text) -> [bool]:
        let parts = do lowerSplitLines(s)
        let n = len(parts)
        let mut out = []
        let mut i = 0
        loop i < n:
            out = append(out, parts[i] == "true")
            i = i + 1
        return out

    proc lowerProcLinesJSON(headerLine: text, bodySrc: text, procNameLines: text, procRetLines: text, procRetListLines: text, fileNameLines: text, fileTypeLines: text, filePathLines: text, enumLines: text) -> text:
        let procNames = do lowerSplitLines(procNameLines)
        let procRets = do lowerSplitLines(procRetLines)
        let procRetLists = do plBoolLines(procRetListLines)
        let fileNames = do lowerSplitLines(fileNameLines)
        let fileTypes = do lowerSplitLines(fileTypeLines)
        let filePaths = do lowerSplitLines(filePathLines)
        let enums = do lowerSplitLines(enumLines)
        let j = do lowerProcJSON(headerLine, bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enums)
        return j

    proc lowerProcLinesDiag(headerLine: text, bodySrc: text, procNameLines: text, procRetLines: text, procRetListLines: text, fileNameLines: text, fileTypeLines: text, filePathLines: text, enumLines: text) -> text:
        let procNames = do lowerSplitLines(procNameLines)
        let procRets = do lowerSplitLines(procRetLines)
        let procRetLists = do plBoolLines(procRetListLines)
        let fileNames = do lowerSplitLines(fileNameLines)
        let fileTypes = do lowerSplitLines(fileTypeLines)
        let filePaths = do lowerSplitLines(filePathLines)
        let enums = do lowerSplitLines(enumLines)
        let d = do lowerProcDiag(headerLine, bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enums)
        return d

    state procLowerResult: text = ""
    state procLowerDiag: text = ""

    # runLowerProc: POST {"args": [headerLine, bodySrc, "p1\np2",
    # "int\n", "false\ntrue", "Config", "text", "config.txt", "Status"]}
    # -> procLowerResult is the IR JSON ("" on error), procLowerDiag the
    # message ("" on success).
    action runLowerProc(headerLine: text, bodySrc: text, procNameLines: text, procRetLines: text, procRetListLines: text, fileNameLines: text, fileTypeLines: text, filePathLines: text, enumLines: text):
        let j = do lowerProcLinesJSON(headerLine, bodySrc, procNameLines, procRetLines, procRetListLines, fileNameLines, fileTypeLines, filePathLines, enumLines)
        let d = do lowerProcLinesDiag(headerLine, bodySrc, procNameLines, procRetLines, procRetListLines, fileNameLines, fileTypeLines, filePathLines, enumLines)
        procLowerResult = j
        procLowerDiag = d

    private view ProcLowerHome at "/proc_lower":
        box:
            text "{procLowerDiag} {procLowerResult}"
