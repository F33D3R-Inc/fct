app SemanticsSelfHost:
    # Partial, honest self-hosting port of ONE sub-algorithm out of
    # internal/ir/build.go — the placement-inference decision procedure that
    # decides whether an `action` runs on the server (the authority) or the
    # client (the browser, zero round-trip), plus the two compile-error
    # gates that ride alongside it (server/client soundness, and the
    # `requires`-implies-server rule).
    #
    # ============================================================
    # WHY THIS FILE, AND WHY THIS PIECE OF build.go
    # ============================================================
    # build.go is internal/ir's whole semantic-analysis stage (4,000+ lines
    # at the time this file was written) — name resolution, dependency-graph
    # construction for view refresh, and this placement calculus, all
    # against `ast.App`/`ast.Expr` values that only exist once the parser has
    # already run. Read in full (not skimmed) before choosing what to port:
    # the overwhelming majority of the file is NOT independently portable —
    # `e.check`/`e.checkPure`/`e.checkBuiltins`/`e.depsIR`/`c.nodes`/
    # `procBlock` and everything view-related (viewCtx, scope, lowerSegs,
    # lowerRange, lowerOptions) all take or walk an `ast.Expr`/`ast.Node`
    # tree directly, or an `*env` carrying a dozen name tables built from
    # `ast.App`'s own declarations (entities, records, structs, services,
    # enums — see env's own field list, build.go lines 25-61). None of that
    # has a plain-value shape a `.fct` proc could accept — porting any of it
    # honestly would mean porting the parser's own AST representation first
    # (this port's earlier files — source.fct, expr_tokens.fct/expr_tree.fct,
    # stmt.fct, nodes.fct — are exactly that prerequisite work, still
    # incomplete: stmt.fct's own header names porting `parseProcBody`'s
    # arbitrary nesting as the concrete remaining wall).
    #
    # `env.action` (build.go lines 1705-2271) is the one place in the whole
    # file where a REAL decision — not a tree walk — is made almost entirely
    # over PLAIN FACTS the surrounding function has already reduced an
    # action's body down to: six `bool`s set while walking the statement
    # list (`entWrite`, `usesPrint`, `impure`, `callsService`, `callsProc`,
    # `establishesID` — build.go lines 1780-1788) plus two `map[string]bool`
    # sets of state names (`writes`, `reads`). The actual placement switch
    # (lines 2208-2234), the post-switch write-upgrade (2235-2243), the
    # server/client soundness check (2244-2261), and the `requires`-implies-
    # server gate (2262-2267) never once touch an `ast.Expr` or a `Node` —
    # they only ever ask "is this bool true", "is this name's placement
    # server/client", and "is this set empty". That is exactly this task's
    # own suggested shape: "a real, bounded decision procedure that could
    # take its inputs as plain bools/flags rather than needing the full
    # AST" — ported below verbatim, not approximated, against the real
    # line numbers cited throughout.
    #
    # `triggerCycle` (build.go lines 6289-6334, a DFS cycle-detector over a
    # `map[string][]string` trigger graph) was the other strong candidate
    # this task named — also genuinely portable — but the placement
    # calculus was chosen because it is literally what Build's own doc
    # comment (build.go lines 155-169) calls out as "where the placement
    # calculus runs": the single decision this whole compiler stage exists
    # to make, and the one a reader would most want proof actually works
    # outside of Go.
    #
    # ============================================================
    # WHAT IS DELIBERATELY LEFT OUT, AND WHY
    # ============================================================
    # `env.action` also does a mountain of AST-shaped work THIS file does
    # NOT port, each for the same reason: it needs a real `ast.Expr` tree
    # (or the full `env` name-table set) to operate on, not a plain value —
    # e2e-seal-parameter tracking (`e2eWrite`, lines 1737-1755), `requires`
    # argument purity/arity checking against `e.policyParams` (1756-1778),
    # per-statement `mustValidateFirst` check-before-mutation ordering
    # (1815-1823), and the actual walk that PRODUCES `entWrite`/`impure`/
    # `writes`/`reads` in the first place (`readExprIn`, `hasImpure`,
    # `hasPrint`, `e.depsIR` — these need `e.check`/`e.low` over a real
    # expression). This file starts exactly where that walk's OUTPUT would
    # land: the six bools plus the read/write name sets, already computed,
    # taken as parameters — precisely the boundary the task's own framing
    # drew ("given a set of already-known facts about the action body").
    #
    # ============================================================
    # THE ONE REPRESENTATION GAP: no map type for a proc
    # ============================================================
    # `e.states` is a `map[string]string` (state name -> "server"/"client"/
    # "private" placement) — this language has no declarable map type for a
    # proc parameter (confirmed by reading internal/parser's signature
    # grammar: a param's type is a scalar, a `[T]` of a scalar, or a
    # struct/record/enum name; nothing here or in any earlier selfhost file
    # has ever declared a map-typed parameter, only ever a runtime `{k: v}`
    # map LITERAL inside an expression, itself just an AST-representation
    # detail — see expr_tokens.fct's own `Pair`/`mapLitNode` doc). This file
    # restates a name -> placement map the same way source.fct/nodes.fct/
    # stmt.fct already restate "a struct value's own tree" when no
    # composite VALUE shape exists: as two PARALLEL arrays,
    # `stateNames: [text]` / `statePlacements: [text]`, looked up by a
    # linear scan (statePlacementOf, below) — the identical `childrenOf`-
    # style idiom every earlier file in this port already established for
    # "no map/pointer-chase available, so scan the parallel arrays".
    # `writes`/`reads` (Go sets, `map[string]bool`) become plain
    # `[text]` arrays of names — order never matters for what this file
    # computes (an empty-check, an all-of/any-of test, or a plain
    # membership test), so no ordering-fidelity note is needed the way
    # source.fct's own ragged-sibling-indent note was for the offside rule.
    #
    # ============================================================
    # STAGE 1: statePlacementOf — the map-restated-as-parallel-arrays lookup
    # every later stage in this file is built from. "" is the honest
    # "name not found" answer (mirrors Go's own `states[name]` zero-value
    # read on a missing key, which is also "" for a `map[string]string`) —
    # this can never collide with a genuine answer, since every real
    # placement this compiler ever assigns a state cell is "server",
    # "client", or "private" (see build.go lines 560-567), never "".
    # ============================================================
    proc statePlacementOf(name: text, stateNames: [text], statePlacements: [text]) -> text:
        let n = len(stateNames)
        let mut result = ""
        let mut i = 0
        loop i < n:
            if stateNames[i] == name:
                result = statePlacements[i]
            i = i + 1
        return result

    # ============================================================
    # STAGE 2: writesOnlyClientState — build.go lines 5856-5874, ported
    # exactly, "at least one write, and every one of them is @client" load-
    # bearing per that function's own doc: an action that writes NOTHING is
    # NOT "only client state" (it falls through to false), so an impure
    # action with an empty write set still gets pinned server-side by
    # STAGE 4's own switch below, exactly matching the real compiler's
    # documented rationale (an impure-but-writeless action still has a
    # `requires` gate that must stay authoritative).
    # ============================================================
    proc writesOnlyClientState(writeNames: [text], stateNames: [text], statePlacements: [text]) -> bool:
        let n = len(writeNames)
        if n == 0:
            return false
        let mut allClient = true
        let mut i = 0
        loop i < n:
            let p = do statePlacementOf(writeNames[i], stateNames, statePlacements)
            if p != "client":
                allClient = false
            i = i + 1
        return allClient

    # anyWriteIsServerState: the post-switch upgrade build.go lines 2235-2243
    # runs when the switch below left placement at Client — "does this
    # action write even one @server-placed cell" (a plain state write, not
    # an entity write — entWrite already forces server earlier in the real
    # switch, at line 2211-2213).
    proc anyWriteIsServerState(writeNames: [text], stateNames: [text], statePlacements: [text]) -> bool:
        let n = len(writeNames)
        let mut found = false
        let mut i = 0
        loop i < n:
            let p = do statePlacementOf(writeNames[i], stateNames, statePlacements)
            if p == "server":
                found = true
            i = i + 1
        return found

    # anyReadIsClientState / anyWriteIsClientState: the two soundness scans
    # build.go's own `if act.Placement == Server` block runs (lines
    # 2246-2260) — "the authority cannot see or touch ephemeral client
    # state". Two separate procs (not one shared "any name in this list is
    # client-placed" helper) because STAGE 5 below needs to name WHICH one
    # failed and or say why (a read is "unobservable", a write is
    # "unreachable" — build.go's own two distinct messages), and a proc
    # cannot return more than one fact — the identical "parallel derivation
    # over the same shape" convention as source.fct's parsedIndents /
    # parsedTexts / parsedSkipFlags.
    proc anyReadIsClientState(readNames: [text], stateNames: [text], statePlacements: [text]) -> bool:
        let n = len(readNames)
        let mut found = false
        let mut i = 0
        loop i < n:
            let p = do statePlacementOf(readNames[i], stateNames, statePlacements)
            if p == "client":
                found = true
            i = i + 1
        return found

    proc anyWriteIsClientState(writeNames: [text], stateNames: [text], statePlacements: [text]) -> bool:
        let n = len(writeNames)
        let mut found = false
        let mut i = 0
        loop i < n:
            let p = do statePlacementOf(writeNames[i], stateNames, statePlacements)
            if p == "client":
                found = true
            i = i + 1
        return found

    # firstClientRead / firstClientWrite: the OFFENDING name itself, for a
    # readable error (build.go's own `fmt.Sprintf(..., r)` / `(..., w)`) —
    # re-derived from scratch rather than threaded alongside the bool above,
    # the same "position vs. presence are separate pure re-derivations"
    # idiom nodeSegStartAt/nodeSegIsExprAt (nodes.fct) already established.
    # "" is the honest "no such name" answer (never a real state name, since
    # isIdentToken rejects the empty string everywhere a state name is
    # actually declared).
    proc firstClientRead(readNames: [text], stateNames: [text], statePlacements: [text]) -> text:
        let n = len(readNames)
        let mut result = ""
        let mut i = 0
        loop i < n && result == "":
            let p = do statePlacementOf(readNames[i], stateNames, statePlacements)
            if p == "client":
                result = readNames[i]
            i = i + 1
        return result

    proc firstClientWrite(writeNames: [text], stateNames: [text], statePlacements: [text]) -> text:
        let n = len(writeNames)
        let mut result = ""
        let mut i = 0
        loop i < n && result == "":
            let p = do statePlacementOf(writeNames[i], stateNames, statePlacements)
            if p == "client":
                result = writeNames[i]
            i = i + 1
        return result

    # ============================================================
    # STAGE 3: PlacementDecision / SoundnessCheck / PlacementOutcome — the
    # three structs this file needs. Every field always present on every
    # value (a struct literal must set all of them), only the ones a given
    # outcome shape actually uses ever meaningfully non-default — the same
    # convention predicate.fct's Node / expr_tokens.fct's ExprNode / stmt.fct's
    # Stmt already established.
    # ============================================================
    #   PlacementDecision — "server" | "client" plus the human-readable
    #   reason build.go's own `act.Reason` carries (every `act.Reason =
    #   "..."` string below is copied verbatim from build.go, not
    #   paraphrased, so a diff against the real compiler's own message is
    #   exact).
    struct PlacementDecision:
        placement: text
        reason: text

    #   SoundnessCheck — the verdict of STAGE 5 below: valid, or the exact
    #   offending name plus which half (read/write) failed.
    struct SoundnessCheck:
        valid: bool
        offendingName: text
        reason: text

    #   PlacementOutcome — the full end-to-end verdict STAGE 6's
    #   `inferActionPlacement` returns: the placement this action gets IF it
    #   compiles at all, whether it actually compiles, and — if not — the
    #   real BuildError-shaped reason (build.go returns `Action{},
    #   &BuildError{...}` in exactly two places for this whole procedure:
    #   the soundness violation, and the `requires`-on-a-client-action
    #   violation; everything else in `env.action`'s placement half always
    #   succeeds once it reaches a verdict).
    struct PlacementOutcome:
        placement: text
        reason: text
        valid: bool
        errorReason: text
        offendingName: text

    # ============================================================
    # STAGE 4: actionPlacementCore — build.go lines 2208-2234, ported
    # exactly: default Client, then the six real Server-forcing conditions
    # IN THEIR REAL ORDER (a Go `switch` with no `fallthrough` only ever
    # takes its FIRST matching case — restated here as a plain if-chain,
    # since `.fct` has no switch statement, but the same "first match wins,
    # no case after the first can still fire" semantics, achieved by
    # returning immediately from each arm rather than needing a `break`).
    # `writesOnlyClientState` is taken as an already-computed `bool`
    # parameter here (not the array-based STAGE 2 proc) — this is
    # deliberately the CORE decision procedure in the shape the task's own
    # framing asked for: plain bools in, a verdict out, no array/name-table
    # machinery visible at this layer at all. STAGE 6 is what actually
    # wires STAGE 2's array-based computation into this core.
    # ============================================================
    proc actionPlacementCore(entWrite: bool, usesPrint: bool, impure: bool, writesOnlyClientState: bool, callsService: bool, callsProc: bool, establishesID: bool) -> PlacementDecision:
        if entWrite:
            return PlacementDecision{placement: "server", reason: "writes durable entity data — the authority owns the database"}
        if usesPrint:
            return PlacementDecision{placement: "server", reason: "calls print(...) — a server-only debugging aid with no client implementation; the authority is the only process with log output to write it to"}
        if impure && !writesOnlyClientState:
            return PlacementDecision{placement: "server", reason: "uses an effectful builtin (now/rand) — the authority owns nondeterminism, so every client sees one agreed result"}
        if callsService:
            return PlacementDecision{placement: "server", reason: "calls an external service — egress routes through the authority, never the client"}
        if callsProc:
            return PlacementDecision{placement: "server", reason: "calls a `proc`, which is unconditionally server-executed — no client mirror of proc code exists"}
        if establishesID:
            return PlacementDecision{placement: "server", reason: "establishes the session identity — only the authority may set who you are"}
        return PlacementDecision{placement: "client", reason: "only touches @client state, so it runs in the browser with no round-trip"}

    # ============================================================
    # STAGE 5: checkServerSoundness — build.go lines 2244-2261, ported
    # exactly: only meaningful once placement is already "server" (the real
    # code is inside `if act.Placement == Server { ... }`); a caller that
    # invokes this while placement is "client" would get a vacuous `valid:
    # true` back, which is correct (client placement is never subject to
    # this soundness rule at all — see STAGE 6 for the real gate).
    # ============================================================
    proc checkServerSoundness(placement: text, readNames: [text], writeNames: [text], stateNames: [text], statePlacements: [text]) -> SoundnessCheck:
        if placement != "server":
            return SoundnessCheck{valid: true, offendingName: "", reason: ""}
        let badRead = do anyReadIsClientState(readNames, stateNames, statePlacements)
        if badRead:
            let name = do firstClientRead(readNames, stateNames, statePlacements)
            return SoundnessCheck{valid: false, offendingName: name, reason: "runs on the server (it writes authoritative state or uses an effectful builtin) but reads client-only state; the authority cannot see ephemeral client state"}
        let badWrite = do anyWriteIsClientState(writeNames, stateNames, statePlacements)
        if badWrite:
            let name2 = do firstClientWrite(writeNames, stateNames, statePlacements)
            return SoundnessCheck{valid: false, offendingName: name2, reason: "runs on the server but writes client-only state; the authority cannot reach ephemeral client state"}
        return SoundnessCheck{valid: true, offendingName: "", reason: ""}

    # requiresGateValid: build.go lines 2262-2267 — an action with a
    # `requires` clause must be server-placed; a client-placed action can
    # never be securely gated, since the gate itself only runs on the
    # authority.
    proc requiresGateValid(hasRequires: bool, placement: text) -> bool:
        if hasRequires:
            return placement == "server"
        return true

    # ============================================================
    # STAGE 6: inferActionPlacement — the full end-to-end driver, wiring
    # STAGE 2 (array-based name lookups) into STAGE 4's core decision, then
    # STAGE 5's soundness gate, then the requires gate — build.go lines
    # 2208-2267 in one real, callable procedure, taking exactly the facts a
    # caller who has already walked an action's body (this file's own
    # scope boundary, see the header above) would have on hand: six bools,
    # one more bool for whether a `requires` clause is present at all, and
    # the four parallel-array name/placement facts STAGE 1-2 need.
    # ============================================================
    proc inferActionPlacement(entWrite: bool, usesPrint: bool, impure: bool, callsService: bool, callsProc: bool, establishesID: bool, hasRequires: bool, readNames: [text], writeNames: [text], stateNames: [text], statePlacements: [text]) -> PlacementOutcome:
        let onlyClient = do writesOnlyClientState(writeNames, stateNames, statePlacements)
        let core = do actionPlacementCore(entWrite, usesPrint, impure, onlyClient, callsService, callsProc, establishesID)
        let mut placement = core.placement
        let mut reason = core.reason
        if placement == "client":
            let serverWrite = do anyWriteIsServerState(writeNames, stateNames, statePlacements)
            if serverWrite:
                placement = "server"
                reason = "writes authoritative state — only the authority may change it"
        let sound = do checkServerSoundness(placement, readNames, writeNames, stateNames, statePlacements)
        if !sound.valid:
            return PlacementOutcome{placement: placement, reason: reason, valid: false, errorReason: sound.reason, offendingName: sound.offendingName}
        let gateOk = do requiresGateValid(hasRequires, placement)
        if !gateOk:
            return PlacementOutcome{placement: placement, reason: reason, valid: false, errorReason: "has `requires` but is client-placed; only authoritative (server) actions can be gated", offendingName: ""}
        return PlacementOutcome{placement: placement, reason: reason, valid: true, errorReason: "", offendingName: ""}

    # ============================================================
    # HAND-TRACED VERIFICATION — six real scenarios, each one a real branch
    # of the real build.go decision this file ports, re-traced against
    # inferActionPlacement above. Each scenario is its own tiny set of
    # fixture procs (a scalar-parameter action cannot pass a `[text]`
    # literal directly — see LANGUAGE.md's `proc` section on why only a
    # PROC parameter may be list-typed — so exactly like source.fct's own
    # buildCyclicIndents, each scenario's array facts are built by a
    # zero-argument proc a driver action then calls server-side).
    #
    #   SCENARIO A — "seenAt = now() into a @client cell" (build.go's own
    #   worked example, lines 2196-2203): impure, writes ONE cell that is
    #   itself @client, nothing else fires. Expect: placement "client" (the
    #   impure-but-only-client-state exception applies), valid.
    #
    #   SCENARIO B — writes an entity: entWrite alone should force server
    #   regardless of anything else, and `requires` is fine once server.
    #   Expect: placement "server", reason cites entity data, valid.
    #
    #   SCENARIO C — impure AND writes nothing at all: build.go's own doc
    #   note that "an impure action that writes nothing... kept server"
    #   (writesOnlyClientState is false when writes is empty — the "at
    #   least one write" gate, STAGE 2's own doc). Expect: placement
    #   "server", reason cites the effectful builtin, valid.
    #
    #   SCENARIO D — writes a plain @server state cell, nothing else fires:
    #   the post-switch upgrade (STAGE 6's `anyWriteIsServerState` branch).
    #   Expect: placement "server", reason cites authoritative state.
    #
    #   SCENARIO E — `requires` present, but only @client state touched (no
    #   entWrite/impure/etc. to force server): the requires-gate violation.
    #   Expect: invalid, errorReason cites the requires/client conflict.
    #
    #   SCENARIO F — entWrite forces server, but the action also READS a
    #   @client-only cell: the soundness violation. Expect: invalid,
    #   errorReason cites reading client-only state, offendingName names it.
    # ============================================================
    proc scenarioAWrites() -> [text]:
        return ["seenAt"]

    proc scenarioAReads() -> [text]:
        return []

    proc scenarioAStateNames() -> [text]:
        return ["seenAt", "postCount"]

    proc scenarioAStatePlacements() -> [text]:
        return ["client", "server"]

    proc scenarioADecision() -> PlacementOutcome:
        let w = do scenarioAWrites()
        let r = do scenarioAReads()
        let sn = do scenarioAStateNames()
        let sp = do scenarioAStatePlacements()
        let d = do inferActionPlacement(false, false, true, false, false, false, false, r, w, sn, sp)
        return d

    proc scenarioBStateNames() -> [text]:
        return ["postCount"]

    proc scenarioBStatePlacements() -> [text]:
        return ["server"]

    proc scenarioBDecision() -> PlacementOutcome:
        let sn = do scenarioBStateNames()
        let sp = do scenarioBStatePlacements()
        let d = do inferActionPlacement(true, false, false, false, false, false, true, [], [], sn, sp)
        return d

    proc scenarioCDecision() -> PlacementOutcome:
        let d = do inferActionPlacement(false, false, true, false, false, false, false, [], [], [], [])
        return d

    proc scenarioDWrites() -> [text]:
        return ["postCount"]

    proc scenarioDStateNames() -> [text]:
        return ["postCount"]

    proc scenarioDStatePlacements() -> [text]:
        return ["server"]

    proc scenarioDDecision() -> PlacementOutcome:
        let w = do scenarioDWrites()
        let sn = do scenarioDStateNames()
        let sp = do scenarioDStatePlacements()
        let d = do inferActionPlacement(false, false, false, false, false, false, false, [], w, sn, sp)
        return d

    proc scenarioEStateNames() -> [text]:
        return ["seenAt"]

    proc scenarioEStatePlacements() -> [text]:
        return ["client"]

    proc scenarioEDecision() -> PlacementOutcome:
        let w = do scenarioAWrites()
        let sn = do scenarioEStateNames()
        let sp = do scenarioEStatePlacements()
        let d = do inferActionPlacement(false, false, false, false, false, false, true, [], w, sn, sp)
        return d

    proc scenarioFReads() -> [text]:
        return ["seenAt"]

    proc scenarioFStateNames() -> [text]:
        return ["seenAt"]

    proc scenarioFStatePlacements() -> [text]:
        return ["client"]

    proc scenarioFDecision() -> PlacementOutcome:
        let r = do scenarioFReads()
        let sn = do scenarioFStateNames()
        let sp = do scenarioFStatePlacements()
        let d = do inferActionPlacement(true, false, false, false, false, false, false, r, [], sn, sp)
        return d

    # ============================================================
    # STAGE 7: describeOutcome — proof the PlacementOutcome struct is
    # actually walkable, not just buildable (this task's own verification
    # ask), and the direct reason no scenario proc below ever hands a
    # PlacementOutcome to an action: a struct value can never be a `state`
    # cell, nor even a plain `let` bind INSIDE an action body — "structs are
    # proc-local values, with no schema/wire representation yet" (confirmed
    # live: `facet check` on an earlier draft of this file rejected exactly
    # that, naming the struct return type outright) — the same restriction
    # every earlier struct-milestone file in this port already documents
    # for its own tree type. So every scenario below is read apart entirely
    # INSIDE proc-land (one proc composes the decision, a second reads its
    # fields into one summary `text`), and only that final `text`/`bool`
    # pair ever crosses into an action — exactly the "do the struct work in
    # a proc, expose only scalars to state" shape stmt.fct's/nodes.fct's own
    # describeStmt/describeUiNode already established, restated here for a
    # decision-result struct instead of a tree.
    # ============================================================
    proc describeOutcome(o: PlacementOutcome) -> text:
        let mut validText = "false"
        if o.valid:
            validText = "true"
        return "placement=" + o.placement + " reason=" + o.reason + " valid=" + validText + " error=" + o.errorReason + " offending=" + o.offendingName

    # --- one summary/valid proc PAIR per scenario — each independently
    # re-derives that scenario's own PlacementOutcome (a proc has one return
    # value only, so "the text summary" and "the bare bool" are two
    # separate, from-scratch calls into the same pure decision proc, not one
    # shared pass — the identical parallel-derivation idiom source.fct's own
    # parsedIndents/parsedTexts/parsedSkipFlags already established). ---
    proc scenarioASummary() -> text:
        let d = do scenarioADecision()
        let s = do describeOutcome(d)
        return s

    proc scenarioAValid() -> bool:
        let d = do scenarioADecision()
        return d.valid

    proc scenarioBSummary() -> text:
        let d = do scenarioBDecision()
        let s = do describeOutcome(d)
        return s

    proc scenarioBValid() -> bool:
        let d = do scenarioBDecision()
        return d.valid

    proc scenarioCSummary() -> text:
        let d = do scenarioCDecision()
        let s = do describeOutcome(d)
        return s

    proc scenarioCValid() -> bool:
        let d = do scenarioCDecision()
        return d.valid

    proc scenarioDSummary() -> text:
        let d = do scenarioDDecision()
        let s = do describeOutcome(d)
        return s

    proc scenarioDValid() -> bool:
        let d = do scenarioDDecision()
        return d.valid

    proc scenarioESummary() -> text:
        let d = do scenarioEDecision()
        let s = do describeOutcome(d)
        return s

    proc scenarioEValid() -> bool:
        let d = do scenarioEDecision()
        return d.valid

    proc scenarioFSummary() -> text:
        let d = do scenarioFDecision()
        let s = do describeOutcome(d)
        return s

    proc scenarioFValid() -> bool:
        let d = do scenarioFDecision()
        return d.valid

    # ============================================================
    # STAGE 8: the live HTTP/console-exercisable drivers — one `state`
    # text/bool pair, reused by every scenario action below (the same
    # "shared result cell, whichever `run*` action fired last" convention
    # source.fct's own multi-stage state cells already use), plus the
    # general-purpose driver that exercises `inferActionPlacement` over any
    # single named state cell's placement, checked as both a possible read
    # and a possible write source in one call.
    # ============================================================
    state summaryResult: text = ""
    state validResult: bool = false

    action runScenarioA():
        let s = do scenarioASummary()
        let v = do scenarioAValid()
        summaryResult = s
        validResult = v

    action runScenarioB():
        let s = do scenarioBSummary()
        let v = do scenarioBValid()
        summaryResult = s
        validResult = v

    action runScenarioC():
        let s = do scenarioCSummary()
        let v = do scenarioCValid()
        summaryResult = s
        validResult = v

    action runScenarioD():
        let s = do scenarioDSummary()
        let v = do scenarioDValid()
        summaryResult = s
        validResult = v

    action runScenarioE():
        let s = do scenarioESummary()
        let v = do scenarioEValid()
        summaryResult = s
        validResult = v

    action runScenarioF():
        let s = do scenarioFSummary()
        let v = do scenarioFValid()
        summaryResult = s
        validResult = v

    # runInferActionPlacement: the general-purpose driver — every scalar
    # fact plus four name/placement facts, built server-side from four
    # plain scalar arguments rather than accepting a `[text]` argument
    # directly (an action parameter stays scalar-only — see LANGUAGE.md's
    # `proc` section — the same constraint every list-consuming driver in
    # this port already works around, e.g. source.fct's own
    # runParentIndexForIndents building its list server-side from a scalar
    # `n`). `oneNameList` turns a single scalar name into the one-element
    # `[text]` STAGE 1-2's lookups expect ("" -> `[]`, so a caller who
    # leaves a field blank genuinely passes an empty read/write/state set,
    # not a set containing one empty-string name).
    proc oneNameList(name: text) -> [text]:
        if name == "":
            return []
        return [name]

    proc inferActionPlacementSummary(entWrite: bool, usesPrint: bool, impure: bool, callsService: bool, callsProc: bool, establishesID: bool, hasRequires: bool, readNames: [text], writeNames: [text], stateNames: [text], statePlacements: [text]) -> text:
        let d = do inferActionPlacement(entWrite, usesPrint, impure, callsService, callsProc, establishesID, hasRequires, readNames, writeNames, stateNames, statePlacements)
        let s = do describeOutcome(d)
        return s

    proc inferActionPlacementValid(entWrite: bool, usesPrint: bool, impure: bool, callsService: bool, callsProc: bool, establishesID: bool, hasRequires: bool, readNames: [text], writeNames: [text], stateNames: [text], statePlacements: [text]) -> bool:
        let d = do inferActionPlacement(entWrite, usesPrint, impure, callsService, callsProc, establishesID, hasRequires, readNames, writeNames, stateNames, statePlacements)
        return d.valid

    action runInferActionPlacement(entWrite: bool, usesPrint: bool, impure: bool, callsService: bool, callsProc: bool, establishesID: bool, hasRequires: bool, readName: text, writeName: text, stateName: text, statePlacement: text):
        let reads = do oneNameList(readName)
        let writes = do oneNameList(writeName)
        let stateNames = do oneNameList(stateName)
        let statePlacements = do oneNameList(statePlacement)
        let s = do inferActionPlacementSummary(entWrite, usesPrint, impure, callsService, callsProc, establishesID, hasRequires, reads, writes, stateNames, statePlacements)
        let v = do inferActionPlacementValid(entWrite, usesPrint, impure, callsService, callsProc, establishesID, hasRequires, reads, writes, stateNames, statePlacements)
        summaryResult = s
        validResult = v

    private view Home at "/":
        box:
            text "{summaryResult}"
            text "{validResult}"
