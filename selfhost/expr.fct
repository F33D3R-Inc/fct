import "expr_tokens.fct"
import "expr_tree.fct"

app ExprSelfHost:
    # ============================================================
    # DRIVER: this file no longer carries the tokenizer/struct layer or the
    # precedence-climbing tree builder itself — they now live in
    # expr_tokens.fct (ExprNode/Pair, the node constructors, STAGE 0
    # character classification, STAGE 1 tokenizer) and expr_tree.fct (STAGE
    # 2a-2f: the whole factor/postfix/unary/term/expr/comparison/bitAnd/
    # bitXor/bitOr/and/or precedence chain, plus calls/lists/entity-lookups/
    # maps/aggregates), both imported above. Those two, not four, because
    # STAGE 2a/2b's own `factorNodes`/`factorEnd` dispatch DOWN into
    # STAGE 2c-2f's call/list/entityGet/map/agg atoms, and STAGE 2c-2f's own
    # argument/where-clause/reduced-value sub-expressions recurse back UP
    # into STAGE 2b's `orNodes`/`orEnd` (and `exprNodes`/`exprEnd`) —
    # genuine mutual recursion, confirmed live by grepping every `do` call
    # in each STAGE range. A file-per-precedence-level split (as tried
    # first) would need expr_precedence.fct to import expr_postfix.fct AND
    # expr_postfix.fct to import expr_precedence.fct back — a real import
    # cycle (internal/compile/compile.go's collectModules rejects it
    # outright), or, breaking it the other way, a library file that fails
    # `facet check` in isolation because half its calls resolve only
    # through a sibling it cannot import without creating that same cycle.
    # STAGE 2a-2f is the actual strongly-connected unit this grammar's
    # recursive descent produces, so it stays one file rather than being
    # forced into an artificial, cycle-prone split.
    #
    # What's left here is exactly the demo scaffolding that engine feeds
    # into: the STAGE 3 end-to-end driver, the DEMO/build-check fixture,
    # and the single `state`/`action`/`view Home` this merged app is
    # allowed to own (a second file declaring its own view/duplicate action
    # names would collide at merge time; see compile.go's checkDuplicates).
    # ============================================================
    # STAGE 3: the end-to-end driver — raw expression text in, the real
    # `ExprNode` tree out, exactly parseExpr(src)'s job (minus its error
    # return).
    # ============================================================
    proc parseExprTree(src: text) -> ExprNode:
        let kinds = do tokenKinds(src)
        let texts = do tokenTexts(src)
        let tree = do orNodes(kinds, texts, 0)
        return tree

    # parseExprConsumedAll: the honest status signal this file DOES provide
    # — true iff the whole token stream was consumed by one top-level
    # expression, i.e. `src` has no trailing garbage after a complete,
    # valid expression of this subset's grammar.
    proc parseExprConsumedAll(src: text) -> bool:
        let kinds = do tokenKinds(src)
        let texts = do tokenTexts(src)
        let endPos = do orEnd(kinds, texts, 0)
        return endPos == len(kinds)

    # ============================================================
    # DEMO / BUILD-CHECK FIXTURE. Per this file's header, an action cannot
    # bind a struct (or struct-list) proc result at all, so — exactly like
    # predicate.fct's own demo — the `ExprNode` tree itself never crosses
    # into `state`; only plain `text`/`bool` facts READ FROM it do. The
    # sample expression is `1 + 2 * 3`, hand-verified to parse as
    # `Bin("+", Lit(1), Bin("*", Lit(2), Lit(3)))` (`*` binds tighter than
    # `+`, exactly as this grammar's precedence table requires) — compare
    # this to the old arena encoding this file's git history holds, where
    # the same tree was twenty bare integers with a slot-numbering scheme
    # you had to hold in your head to read at all.
    # ============================================================
    proc demoSampleSrc() -> text:
        return "1 + 2 * 3"

    proc demoParseTree() -> ExprNode:
        let src = do demoSampleSrc()
        let tree = do parseExprTree(src)
        return tree

    proc demoRootKind() -> text:
        let tree = do demoParseTree()
        return tree.kind

    proc demoRootOp() -> text:
        let tree = do demoParseTree()
        return tree.text

    proc demoShapeOk() -> bool:
        let tree = do demoParseTree()
        if tree.kind != "bin":
            return false
        if tree.text != "+":
            return false
        let left = tree.children[0]
        let right = tree.children[1]
        if left.kind != "int":
            return false
        if left.text != "1":
            return false
        if right.kind != "bin":
            return false
        if right.text != "*":
            return false
        let rl = right.children[0]
        let rr = right.children[1]
        if rl.kind != "int":
            return false
        if rl.text != "2":
            return false
        if rr.kind != "int":
            return false
        if rr.text != "3":
            return false
        return true

    state tokenKindsResult: [text] = []
    state tokenTextsResult: [text] = []
    state consumedAllResult: bool = false
    state rootKindResult: text = ""
    state rootOpResult: text = ""
    state shapeOkResult: bool = false

    action runTokenKinds(src: text):
        let r = do tokenKinds(src)
        tokenKindsResult = r

    action runTokenTexts(src: text):
        let r = do tokenTexts(src)
        tokenTextsResult = r

    action runParseExprConsumedAll(src: text):
        let r = do parseExprConsumedAll(src)
        consumedAllResult = r

    # runParseExpr: the combined, one-HTTP-call driver expr_test.go mostly
    # uses — tokens (both arrays) and the consumed-all status, from one
    # `src`.
    action runParseExpr(src: text):
        let k = do tokenKinds(src)
        let t = do tokenTexts(src)
        let ok = do parseExprConsumedAll(src)
        tokenKindsResult = k
        tokenTextsResult = t
        consumedAllResult = ok

    # runDemoShape: parses this file's own hand-verified fixture
    # (`1 + 2 * 3`) and exposes the root's kind/operator plus the full
    # shape check, proving the new struct-based tree actually works
    # end-to-end without ever needing to bind the tree itself to `state`.
    action runDemoShape():
        let rk = do demoRootKind()
        let ro = do demoRootOp()
        let sok = do demoShapeOk()
        rootKindResult = rk
        rootOpResult = ro
        shapeOkResult = sok

    view ExprHome at "/":
        box:
            text "{tokenKindsResult} {tokenTextsResult} {consumedAllResult} {rootKindResult} {rootOpResult} {shapeOkResult}"
