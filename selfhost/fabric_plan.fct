            text "{planDemoKindScoped}"
            text "{planDemoTxTwoKinds}"
            text "{planDemoTxAllOpShapes}"
            text "{planDemoEdge}"
            text "{planDemoMultiget}"
            text "{planDemoNamespaceWide}"
            text "{planDemoDeclarations}"
            text "{planDemoPublishEvents}"
            text "{planDemoUnknownPathStatus} {planDemoMalformedBodyStatus} {planDemoUnmappedAddressStatus} {planDemoMissingCredentialMessage}"
