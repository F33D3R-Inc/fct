import "fabric.fct"
import "fabric_json.fct"

app FabricPlanSelfHost:
    # Self-hosting port of fabric/crates/fabric-facetql/src/frontdoor/plan.rs:
    # classify one FacetQL request (method, raw path, raw query, raw body)
    # against the declared Keyspace (fabric.fct's keyspace port) as
    # Colocated, Broadcast, Subscribe or Refuse.
    #
    # The body is read exactly as plan.rs reads it: serde_json::from_slice
    # into a Value (fabric_json.fct: serde_json's own parser, so a
    # MalformedBody refusal carries serde_json's own error text and
    # position, and a repeated key keeps its last value), then
    # `.get(name).and_then(as_str)` / `as_array`. Path segments are
    # percent_encoding::percent_decode_str(..).decode_utf8() (any byte, with
    # std's Utf8Error text on invalid UTF-8); query values are
    # decode_utf8_lossy (U+FFFD per maximal invalid subpart).
    #
    # Representation: RouteIntent -> PlanRouteIntent {isWrite, readPref};
    # ReadPreference -> PlanReadPreference {code 0=Primary 1=AnyFresh
    # 2=PreferRegion 3=AnyCopy, region}; Plan -> PlanValue {kind
    # 0=Colocated 1=Broadcast 2=Subscribe 3=Refuse, ...}; Refusal ->
    # PlanRefusal {code 0=UnknownRoute 1=MalformedPath 2=MalformedBody
    # 3=Keyspace 4=SpansBackends 5=NotProxyable 6=MissingCredential, and
    # each variant's fields}. Routing keys are fabric.fct's packed ints.
    # SpansBackends and MissingCredential are built by the dispatch stage /
    # auth middleware, never by plan() itself; they are here for status()
    # and Display.

    # ============================================================
    # SECTION 1: BYTES, UTF-8, PERCENT-DECODING AND QUERY STRINGS
    # ============================================================

    proc planHexDigitValue(c: int) -> int:
        if c >= 48 && c <= 57:
            return c - 48
        if c >= 97 && c <= 102:
            return c - 87
        if c >= 65 && c <= 70:
            return c - 55
        return -1

    # percent_encoding::percent_decode: every `%` followed by two hex digits
    # becomes that byte; anything else passes through.
    proc planPercentDecodeBytes(s: text) -> [int]:
        let bs = textToBytes(s)
        let n = len(bs)
        let mut out = []
        let mut i = 0
        loop i < n:
            let c = bs[i]
            if c == 37 && i + 2 < n:
                let h = do planHexDigitValue(bs[i + 1])
                let l = do planHexDigitValue(bs[i + 2])
                if h >= 0 && l >= 0:
                    out = append(out, h * 16 + l)
                    i = i + 3
                else:
                    out = append(out, c)
                    i = i + 1
            else:
                out = append(out, c)
                i = i + 1
        return out

    proc planUtf8Width(c: int) -> int:
        if c < 128:
            return 1
        if c >= 194 && c <= 223:
            return 2
        if c >= 224 && c <= 239:
            return 3
        if c >= 240 && c <= 244:
            return 4
        return 0

    proc planIsCont(c: int) -> bool:
        return c >= 128 && c <= 191

    # One step of core::str::run_utf8_validation at `i`: `len` > 0 is a valid
    # char of that many bytes; otherwise `errLen` is Utf8Error::error_len
    # (1..3, or 0 for None: the input ended inside a sequence).
    struct PlanUtf8Step:
        len: int
        errLen: int

    proc planUtf8Step(bs: [int], i: int) -> PlanUtf8Step:
        let n = len(bs)
        let first = bs[i]
        let w = do planUtf8Width(first)
        if w == 1:
            return PlanUtf8Step{len: 1, errLen: 0}
        if w == 0:
            return PlanUtf8Step{len: 0, errLen: 1}
        if i + 1 >= n:
            return PlanUtf8Step{len: 0, errLen: 0}
        let b1 = bs[i + 1]
        if w == 2:
            let ok = do planIsCont(b1)
            if !ok:
                return PlanUtf8Step{len: 0, errLen: 1}
            return PlanUtf8Step{len: 2, errLen: 0}
        let mut secondOk = false
        if w == 3:
            secondOk = (first == 224 && b1 >= 160 && b1 <= 191) || (first >= 225 && first <= 236 && b1 >= 128 && b1 <= 191) || (first == 237 && b1 >= 128 && b1 <= 159) || (first >= 238 && first <= 239 && b1 >= 128 && b1 <= 191)
        if w == 4:
            secondOk = (first == 240 && b1 >= 144 && b1 <= 191) || (first >= 241 && first <= 243 && b1 >= 128 && b1 <= 191) || (first == 244 && b1 >= 128 && b1 <= 143)
        if !secondOk:
            return PlanUtf8Step{len: 0, errLen: 1}
        if i + 2 >= n:
            return PlanUtf8Step{len: 0, errLen: 0}
        let c2 = do planIsCont(bs[i + 2])
        if !c2:
            return PlanUtf8Step{len: 0, errLen: 2}
        if w == 3:
            return PlanUtf8Step{len: 3, errLen: 0}
        if i + 3 >= n:
            return PlanUtf8Step{len: 0, errLen: 0}
        let c3 = do planIsCont(bs[i + 3])
        if !c3:
            return PlanUtf8Step{len: 0, errLen: 3}
        return PlanUtf8Step{len: 4, errLen: 0}

    struct PlanDecodeResult:
        ok: bool
        value: text

    # str::from_utf8, failing with Utf8Error's Display text.
    proc planDecodeUtf8(bs: [int]) -> PlanDecodeResult:
        let n = len(bs)
        let mut i = 0
        loop i < n:
            let st = do planUtf8Step(bs, i)
            if st.len == 0:
                if st.errLen == 0:
                    return PlanDecodeResult{ok: false, value: "incomplete utf-8 byte sequence from index " + i}
                return PlanDecodeResult{ok: false, value: "invalid utf-8 sequence of " + st.errLen + " bytes from index " + i}
            i = i + st.len
        return PlanDecodeResult{ok: true, value: bytesToText(bs)}

    # String::from_utf8_lossy: each maximal invalid subpart (the rest of
    # the input when it ends inside a sequence) becomes one U+FFFD.
    proc planDecodeUtf8Lossy(bs: [int]) -> text:
        let n = len(bs)
        let mut out = []
        let mut i = 0
        loop i < n:
            let st = do planUtf8Step(bs, i)
            if st.len > 0:
                let mut k = 0
                loop k < st.len:
                    out = append(out, bs[i + k])
                    k = k + 1
                i = i + st.len
            else:
                out = append(out, 239)
                out = append(out, 191)
                out = append(out, 189)
                if st.errLen == 0:
                    i = n
                else:
                    i = i + st.errLen
        return bytesToText(out)

    struct PlanSegmentsResult:
        ok: bool
        reason: text
        segments: [text]

    struct PlanQueryParamResult:
        present: bool
        value: text

    # decode_segments: split on '/', drop empty segments, percent-decode
    # each, refuse one that is not UTF-8.
    proc planDecodeSegments(path: text) -> PlanSegmentsResult:
        let raw = split(path, "/")
        let mut segs = []
        let mut i = 0
        loop i < len(raw):
            let seg = raw[i]
            if len(seg) > 0:
                let bytesOut = do planPercentDecodeBytes(seg)
                let decoded = do planDecodeUtf8(bytesOut)
                if !decoded.ok:
                    let reason = "'" + seg + "' is not valid UTF-8: " + decoded.value
                    return PlanSegmentsResult{ok: false, reason: reason, segments: []}
                segs = append(segs, decoded.value)
            i = i + 1
        return PlanSegmentsResult{ok: true, reason: "", segments: segs}

    # The (rune) index of the first `sep` in `s`, or -1.
    proc planIndexOf(s: text, sep: text) -> int:
        let n = len(s)
        let m = len(sep)
        let mut i = 0
        loop i + m <= n:
            if slice(s, i, i + m) == sep:
                return i
            i = i + 1
        return -1

    # query_param: the first `&`-separated pair with an `=` whose key is
    # `name`; its value with `+` as space, percent-decoded lossily.
    proc planQueryParam(hasQuery: bool, query: text, name: text) -> PlanQueryParamResult:
        if !hasQuery:
            return PlanQueryParamResult{present: false, value: ""}
        let pairs = split(query, "&")
        let mut i = 0
        loop i < len(pairs):
            let pair = pairs[i]
            let eq = do planIndexOf(pair, "=")
            if eq >= 0:
                let key = slice(pair, 0, eq)
                if key == name:
                    let rawValue = slice(pair, eq + 1, len(pair))
                    let spaced = join(split(rawValue, "+"), " ")
                    let bs = do planPercentDecodeBytes(spaced)
                    let decoded = do planDecodeUtf8Lossy(bs)
                    return PlanQueryParamResult{present: true, value: decoded}
            i = i + 1
        return PlanQueryParamResult{present: false, value: ""}

    struct PlanBody:
        ok: bool
        value: SjV
        message: text

    # json(): serde_json::from_slice::<Value>, the error as its Display.
    proc planJson(body: text) -> PlanBody:
        let r = do sjDecode([], body, "value")
        return PlanBody{ok: r.ok, value: r.v, message: r.err}

    # field(): a string field, absent when missing, null or not a string.
    proc planField(v: SjV, name: text) -> SjOptText:
        let f = do sjStrField(v, name)
        return f

    # ============================================================
    # SECTION 2: KEYSPACE-AS-A-VALUE, AND THE ONE LOOKUP
    # ============================================================
    # The Keyspace plan() is handed (the same three fields as fabric.fct's
    # Keyspace).
    struct PlanKeyspace:
        rules: [RoutingRule]
        hasFallback: bool
        fallbackKey: RoutingKey

    proc planKeyspaceOf(ks: PlanKeyspace) -> Keyspace:
        return Keyspace{rules: ks.rules, hasFallback: ks.hasFallback, fallbackKey: ks.fallbackKey}

    # PlanResolveResult: `Result<RoutingKey, KeyspaceMiss>` flattened.
    # missCode: -1 = Ok (key holds the answer), 0 = Unmapped, 1 =
    # Inconsistent (missByKind/missByAddress hold the two differing keys).
    struct PlanResolveResult:
        missCode: int
        key: RoutingKey
        missHasKind: bool
        missKind: text
        missHasAddress: bool
        missAddress: text
        missByKind: RoutingKey
        missByAddress: RoutingKey

    # Keyspace::resolve (fabric.fct's keyspaceResolve).
    proc planKeyspaceResolve(ks: PlanKeyspace, hasKind: bool, kind: text, hasAddress: bool, address: text) -> PlanResolveResult:
        let k = do planKeyspaceOf(ks)
        let r = do keyspaceResolve(k, hasKind, kind, hasAddress, address)
        if r.ok:
            return PlanResolveResult{missCode: -1, key: r.key, missHasKind: false, missKind: "", missHasAddress: false, missAddress: "", missByKind: r.miss.byKind, missByAddress: r.miss.byAddress}
        let mut code = 0
        if r.miss.kind == "Inconsistent":
            code = 1
        return PlanResolveResult{missCode: code, key: r.key, missHasKind: r.miss.hasKind, missKind: r.miss.kindName, missHasAddress: r.miss.hasAddress, missAddress: r.miss.address, missByKind: r.miss.byKind, missByAddress: r.miss.byAddress}

    # ============================================================
    # SECTION 3: ROUTE INTENT, KEY INTENT
    # ============================================================
    struct PlanReadPreference:
        code: int
        region: text

    struct PlanRouteIntent:
        isWrite: bool
        readPref: PlanReadPreference

    struct PlanKeyIntent:
        key: RoutingKey
        intent: PlanRouteIntent
        origin: text

    # ============================================================
    # SECTION 4: REFUSAL — struct, status(), Display
    # ============================================================
    # code: 0=UnknownRoute 1=MalformedPath 2=MalformedBody 3=Keyspace
    #       4=SpansBackends 5=NotProxyable 6=MissingCredential (-1 = none,
    #       used only as PlanValue's placeholder refusal for non-Refuse
    #       plans).
    struct PlanRefusal:
        code: int
        method: text
        path: text
        reason: text
        context: text
        message: text
        keyspaceMissCode: int
        missKind: text
        missHasKind: bool
        missAddress: text
        missHasAddress: bool
        missByKind: RoutingKey
        missByAddress: RoutingKey
        spansWhat: text
        spansNodes: [text]
        notProxyableWhat: text

    proc planRefusalNone() -> PlanRefusal:
        return PlanRefusal{code: -1, method: "", path: "", reason: "", context: "", message: "", keyspaceMissCode: -1, missKind: "", missHasKind: false, missAddress: "", missHasAddress: false, missByKind: routingKeyUnset(), missByAddress: routingKeyUnset(), spansWhat: "", spansNodes: [], notProxyableWhat: ""}

    proc planRefusalUnknownRoute(method: text, path: text) -> PlanRefusal:
        return PlanRefusal{code: 0, method: method, path: path, reason: "", context: "", message: "", keyspaceMissCode: -1, missKind: "", missHasKind: false, missAddress: "", missHasAddress: false, missByKind: routingKeyUnset(), missByAddress: routingKeyUnset(), spansWhat: "", spansNodes: [], notProxyableWhat: ""}

    proc planRefusalMalformedPath(reason: text) -> PlanRefusal:
        return PlanRefusal{code: 1, method: "", path: "", reason: reason, context: "", message: "", keyspaceMissCode: -1, missKind: "", missHasKind: false, missAddress: "", missHasAddress: false, missByKind: routingKeyUnset(), missByAddress: routingKeyUnset(), spansWhat: "", spansNodes: [], notProxyableWhat: ""}

    proc planRefusalMalformedBody(context: text, message: text) -> PlanRefusal:
        return PlanRefusal{code: 2, method: "", path: "", reason: "", context: context, message: message, keyspaceMissCode: -1, missKind: "", missHasKind: false, missAddress: "", missHasAddress: false, missByKind: routingKeyUnset(), missByAddress: routingKeyUnset(), spansWhat: "", spansNodes: [], notProxyableWhat: ""}

    proc planKeyspaceMissToRefusal(r: PlanResolveResult) -> PlanRefusal:
        return PlanRefusal{code: 3, method: "", path: "", reason: "", context: "", message: "", keyspaceMissCode: r.missCode, missKind: r.missKind, missHasKind: r.missHasKind, missAddress: r.missAddress, missHasAddress: r.missHasAddress, missByKind: r.missByKind, missByAddress: r.missByAddress, spansWhat: "", spansNodes: [], notProxyableWhat: ""}

    proc planRefusalSpansBackends(what: text, nodes: [text]) -> PlanRefusal:
        return PlanRefusal{code: 4, method: "", path: "", reason: "", context: "", message: "", keyspaceMissCode: -1, missKind: "", missHasKind: false, missAddress: "", missHasAddress: false, missByKind: routingKeyUnset(), missByAddress: routingKeyUnset(), spansWhat: what, spansNodes: nodes, notProxyableWhat: ""}

    proc planRefusalNotProxyable(what: text, reason: text) -> PlanRefusal:
        return PlanRefusal{code: 5, method: "", path: "", reason: reason, context: "", message: "", keyspaceMissCode: -1, missKind: "", missHasKind: false, missAddress: "", missHasAddress: false, missByKind: routingKeyUnset(), missByAddress: routingKeyUnset(), spansWhat: "", spansNodes: [], notProxyableWhat: what}

    proc planRefusalMissingCredential() -> PlanRefusal:
        return PlanRefusal{code: 6, method: "", path: "", reason: "", context: "", message: "", keyspaceMissCode: -1, missKind: "", missHasKind: false, missAddress: "", missHasAddress: false, missByKind: routingKeyUnset(), missByAddress: routingKeyUnset(), spansWhat: "", spansNodes: [], notProxyableWhat: ""}

    # planRefusalStatus: `Refusal::status()` — the whole mapping, restated
    # exactly (404 / 400 / 401 / 421 for Keyspace|SpansBackends|NotProxyable).
    proc planRefusalStatus(r: PlanRefusal) -> int:
        if r.code == 0:
            return 404
        if r.code == 1 || r.code == 2:
            return 400
        if r.code == 6:
            return 401
        if r.code == 3 || r.code == 4 || r.code == 5:
            return 421
        return 500

    proc planKeyspaceMissOf(r: PlanRefusal) -> KeyspaceMiss:
        let mut kind = "Unmapped"
        if r.keyspaceMissCode == 1:
            kind = "Inconsistent"
        return KeyspaceMiss{kind: kind, hasKind: r.missHasKind, kindName: r.missKind, hasAddress: r.missHasAddress, address: r.missAddress, byKind: r.missByKind, byAddress: r.missByAddress}

    proc planKeyspaceMissDisplay(r: PlanRefusal) -> text:
        let m = do planKeyspaceMissOf(r)
        let t = do keyspaceMissDisplay(m)
        return t

    # planRefusalDisplay: `impl Display for Refusal`, restated exactly
    # (including the byte-for-byte `MissingCredential` message the real
    # source shares with `facetql::auth::auth_middleware`).
    proc planRefusalDisplay(r: PlanRefusal) -> text:
        if r.code == 0:
            return "no route for " + r.method + " " + r.path
        if r.code == 1:
            return "malformed path: " + r.reason
        if r.code == 2:
            return r.context + ": could not decode the request body: " + r.message
        if r.code == 3:
            let miss = do planKeyspaceMissDisplay(r)
            return "fabric front door: " + miss
        if r.code == 4:
            let joined = join(r.spansNodes, ", ")
            return "fabric front door: " + r.spansWhat + " spans " + len(r.spansNodes) + " backends (" + joined + "), and this request cannot be split without losing the guarantee it was made for; nothing was forwarded"
        if r.code == 5:
            return "fabric front door: " + r.notProxyableWhat + " cannot be served across a split fleet: " + r.reason + "; address one FacetQL instance directly"
        if r.code == 6:
            return "missing x-api-key header (or ?key= for SSE)"
        return ""

    # ============================================================
    # SECTION 5: PLAN VALUE, AND THE colocated()/spanning() HELPERS
    # ============================================================
    # kind: 0=Colocated 1=Broadcast 2=Subscribe 3=Refuse
    struct PlanValue:
        kind: int
        keys: [PlanKeyIntent]
        broadcastAgreement: int
        broadcastWhat: text
        refusal: PlanRefusal

    proc planValueColocated(keys: [PlanKeyIntent]) -> PlanValue:
        let none = do planRefusalNone()
        return PlanValue{kind: 0, keys: keys, broadcastAgreement: -1, broadcastWhat: "", refusal: none}

    proc planValueBroadcast(agreement: int, what: text) -> PlanValue:
        let none = do planRefusalNone()
        return PlanValue{kind: 1, keys: [], broadcastAgreement: agreement, broadcastWhat: what, refusal: none}

    proc planValueSubscribe() -> PlanValue:
        let none = do planRefusalNone()
        return PlanValue{kind: 2, keys: [], broadcastAgreement: -1, broadcastWhat: "", refusal: none}

    proc planValueRefuse(refusal: PlanRefusal) -> PlanValue:
        return PlanValue{kind: 3, keys: [], broadcastAgreement: -1, broadcastWhat: "", refusal: refusal}

    # planColocated1: `colocated()` — one key, from a kind and/or an
    # address.
    proc planColocated1(ks: PlanKeyspace, origin: text, intent: PlanRouteIntent, hasKind: bool, kind: text, hasAddress: bool, address: text) -> PlanValue:
        let resolved = do planKeyspaceResolve(ks, hasKind, kind, hasAddress, address)
        if resolved.missCode == -1:
            let ki = PlanKeyIntent{key: resolved.key, intent: intent, origin: origin}
            let v = do planValueColocated([ki])
            return v
        let refusal = do planKeyspaceMissToRefusal(resolved)
        let v = do planValueRefuse(refusal)
        return v

    # planSpanning: `spanning()` — routable only when the whole namespace is
    # one place (fabric.fct's own `spanningKeyPresent`, reused directly, not
    # re-derived).
    proc planSpanning(ks: PlanKeyspace, intent: PlanRouteIntent, what: text, reason: text) -> PlanValue:
        let present = do spanningKeyPresent(ks.rules, ks.hasFallback, ks.fallbackKey)
        if present:
            let ki = PlanKeyIntent{key: ks.fallbackKey, intent: intent, origin: what}
            let v = do planValueColocated([ki])
            return v
        let refusal = do planRefusalNotProxyable(what, reason)
        let v = do planValueRefuse(refusal)
        return v

    # ============================================================
    # SECTION 6: THE BATCH — transaction_plan
    # ============================================================
    struct PlanTxTouchResult:
        refused: bool
        plan: PlanValue

    # planTxOrigin: the exact `format!("operations[{index}] ('{op_type}')
    # {}", ...)` message, one touched (kind, address) pair at a time.
    proc planTxOrigin(index: int, opType: text, hasKind: bool, kind: text, hasAddress: bool, address: text) -> text:
        if hasKind && hasAddress:
            return "operations[" + index + "] ('" + opType + "') kind '" + kind + "' at '" + address + "'"
        if hasKind:
            return "operations[" + index + "] ('" + opType + "') kind '" + kind + "'"
        if hasAddress:
            return "operations[" + index + "] ('" + opType + "') '" + address + "'"
        return ""

    # planTransactionAddTouch: one touched (kind, address) pair -> either a
    # refusal (both absent, or a keyspace miss) or the growing key list with
    # one more `PlanKeyIntent` appended.
    proc planTransactionAddTouch(keys: [PlanKeyIntent], index: int, opType: text, hasKind: bool, kind: text, hasAddress: bool, address: text, ks: PlanKeyspace, w: PlanRouteIntent) -> PlanTxTouchResult:
        if !hasKind && !hasAddress:
            let msg = "operations[" + index + "] ('" + opType + "') names neither a kind nor an address, so there is nowhere to route it"
            let refusal = do planRefusalMalformedBody("POST /transaction", msg)
            let v = do planValueRefuse(refusal)
            return PlanTxTouchResult{refused: true, plan: v}
        let origin = do planTxOrigin(index, opType, hasKind, kind, hasAddress, address)
        let resolved = do planKeyspaceResolve(ks, hasKind, kind, hasAddress, address)
        if resolved.missCode != -1:
            let refusal = do planKeyspaceMissToRefusal(resolved)
            let v = do planValueRefuse(refusal)
            return PlanTxTouchResult{refused: true, plan: v}
        let ki = PlanKeyIntent{key: resolved.key, intent: w, origin: origin}
        let newKeys = append(keys, ki)
        let v = do planValueColocated(newKeys)
        return PlanTxTouchResult{refused: false, plan: v}

    proc planTransactionKeys(ops: [SjV], ks: PlanKeyspace) -> PlanValue:
        let n = len(ops)
        let mut i = 0
        let mut keys = []
        let w = PlanRouteIntent{isWrite: true, readPref: PlanReadPreference{code: 0, region: ""}}
        loop i < n:
            let op = ops[i]
            let typeField = do planField(op, "type")
            if !typeField.has:
                let msg = "operations[" + i + "] has no `type`"
                let refusal = do planRefusalMalformedBody("POST /transaction", msg)
                let v = do planValueRefuse(refusal)
                return v
            let opType = typeField.s
            if opType == "insert_node":
                let kindField = do planField(op, "kind")
                let addressField = do planField(op, "address")
                let res = do planTransactionAddTouch(keys, i, opType, kindField.has, kindField.s, addressField.has, addressField.s, ks, w)
                if res.refused:
                    return res.plan
                keys = res.plan.keys
            else:
                if opType == "delete_node" || opType == "set_if":
                    let addressField = do planField(op, "address")
                    let res = do planTransactionAddTouch(keys, i, opType, false, "", addressField.has, addressField.s, ks, w)
                    if res.refused:
                        return res.plan
                    keys = res.plan.keys
                else:
                    if opType == "clear_kind" || opType == "delete_where":
                        let kindField = do planField(op, "kind")
                        let res = do planTransactionAddTouch(keys, i, opType, kindField.has, kindField.s, false, "", ks, w)
                        if res.refused:
                            return res.plan
                        keys = res.plan.keys
                    else:
                        if opType == "insert_edge" || opType == "delete_edge":
                            let fromField = do planField(op, "from")
                            let res1 = do planTransactionAddTouch(keys, i, opType, false, "", fromField.has, fromField.s, ks, w)
                            if res1.refused:
                                return res1.plan
                            let toField = do planField(op, "to")
                            let res2 = do planTransactionAddTouch(res1.plan.keys, i, opType, false, "", toField.has, toField.s, ks, w)
                            if res2.refused:
                                return res2.plan
                            keys = res2.plan.keys
                        else:
                            let msg = "operations[" + i + "] has unknown type '" + opType + "'"
                            let refusal = do planRefusalMalformedBody("POST /transaction", msg)
                            let v = do planValueRefuse(refusal)
                            return v
            i = i + 1
        if len(keys) == 0:
            let v = do planSpanning(ks, w, "an empty POST /transaction", "it touches no address and no kind, so nothing decides which backend should answer it")
            return v
        let v = do planValueColocated(keys)
        return v

    # transaction_plan.
    proc planTransactionPlan(body: text, ks: PlanKeyspace) -> PlanValue:
        let parsed = do planJson(body)
        if !parsed.ok:
            let refusal = do planRefusalMalformedBody("POST /transaction", parsed.message)
            let v = do planValueRefuse(refusal)
            return v
        let ops = do sjGet(parsed.value, "operations")
        if !ops.has || ops.v.kind != "arr":
            let refusal = do planRefusalMalformedBody("POST /transaction", "no `operations` array")
            let v = do planValueRefuse(refusal)
            return v
        let v = do planTransactionKeys(ops.v.items, ks)
        return v

    # ============================================================
    # SECTION 7: /nodes/multiget
    # ============================================================
    proc planMultigetKeys(addresses: [SjV], ks: PlanKeyspace, readIntent: PlanRouteIntent) -> PlanValue:
        let n = len(addresses)
        let mut i = 0
        let mut keys = []
        loop i < n:
            let a = addresses[i]
            if a.kind != "str":
                let msg = "addresses[" + i + "] is not a string"
                let refusal = do planRefusalMalformedBody("POST /nodes/multiget", msg)
                let v = do planValueRefuse(refusal)
                return v
            let resolved = do planKeyspaceResolve(ks, false, "", true, a.s)
            if resolved.missCode != -1:
                let refusal = do planKeyspaceMissToRefusal(resolved)
                let v = do planValueRefuse(refusal)
                return v
            let origin = "addresses[" + i + "] '" + a.s + "'"
            keys = append(keys, PlanKeyIntent{key: resolved.key, intent: readIntent, origin: origin})
            i = i + 1
        if len(keys) == 0:
            let v = do planSpanning(ks, readIntent, "an empty POST /nodes/multiget", "it names no address, so nothing decides which backend should answer it")
            return v
        let v = do planValueColocated(keys)
        return v

    # ============================================================
    # SECTION 8: THE MAIN ENTRY POINT — `plan()` itself
    # ============================================================
    # planRequest: restates `plan()`'s whole match, arm for arm, in the
    # source's own order (the arms never actually overlap — method + path
    # shape uniquely selects one — so this port's linear if-chain is
    # equivalent to Rust's match regardless of order, but the order is kept
    # identical to the source for easy side-by-side reading).
    proc planRequest(method: text, path: text, hasQuery: bool, query: text, body: text, ks: PlanKeyspace, readPref: PlanReadPreference) -> PlanValue:
        let decoded = do planDecodeSegments(path)
        if !decoded.ok:
            let refusal = do planRefusalMalformedPath(decoded.reason)
            let v = do planValueRefuse(refusal)
            return v
        let segs = decoded.segments
        let n = len(segs)
        let readIntent = PlanRouteIntent{isWrite: false, readPref: readPref}
        let writeIntent = PlanRouteIntent{isWrite: true, readPref: readPref}

        # ── liveness ────────────────────────────────────────────────
        if method == "GET" && n == 0:
            let v = do planValueBroadcast(0, "GET /")
            return v

        # ── one node, addressed ────────────────────────────────────
        if method == "POST" && n == 1 && segs[0] == "node":
            let parsed = do planJson(body)
            if !parsed.ok:
                let refusal = do planRefusalMalformedBody("POST /node", parsed.message)
                let v = do planValueRefuse(refusal)
                return v
            let kindField = do planField(parsed.value, "kind")
            let addressField = do planField(parsed.value, "address")
            let v = do planColocated1(ks, "POST /node", writeIntent, kindField.has, kindField.s, addressField.has, addressField.s)
            return v

        if method == "GET" && n == 2 && segs[0] == "node":
            let address = segs[1]
            let v = do planColocated1(ks, path, readIntent, false, "", true, address)
            return v
        if method == "GET" && n == 3 && segs[0] == "node" && segs[2] == "history":
            let address = segs[1]
            let v = do planColocated1(ks, path, readIntent, false, "", true, address)
            return v
        if method == "GET" && n == 3 && segs[0] == "node" && segs[2] == "owned":
            let address = segs[1]
            let v = do planColocated1(ks, path, readIntent, false, "", true, address)
            return v
        if method == "GET" && n == 4 && segs[0] == "node" && segs[2] == "edges" && segs[3] == "out":
            let address = segs[1]
            let v = do planColocated1(ks, path, readIntent, false, "", true, address)
            return v
        if method == "GET" && n == 4 && segs[0] == "node" && segs[2] == "edges" && segs[3] == "in":
            let address = segs[1]
            let v = do planColocated1(ks, path, readIntent, false, "", true, address)
            return v

        if method == "PUT" && n == 2 && segs[0] == "node":
            let address = segs[1]
            let v = do planColocated1(ks, path, writeIntent, false, "", true, address)
            return v
        if method == "DELETE" && n == 2 && segs[0] == "node":
            let address = segs[1]
            let v = do planColocated1(ks, path, writeIntent, false, "", true, address)
            return v
        if method == "POST" && n == 3 && segs[0] == "node" && segs[2] == "claim":
            let address = segs[1]
            let v = do planColocated1(ks, path, writeIntent, false, "", true, address)
            return v

        if method == "POST" && n == 3 && segs[0] == "sequence" && segs[2] == "next":
            let name = segs[1]
            let v = do planColocated1(ks, path, writeIntent, false, "", true, name)
            return v

        # ── many nodes ──────────────────────────────────────────────
        if method == "GET" && n == 1 && segs[0] == "nodes":
            let kindParam = do planQueryParam(hasQuery, query, "kind")
            if kindParam.present:
                let v = do planColocated1(ks, "GET /nodes", readIntent, true, kindParam.value, false, "")
                return v
            let v = do planSpanning(ks, readIntent, "GET /nodes without a kind", "it lists every kind, and pages from two backends cannot be merged into one offset sequence")
            return v

        if method == "POST" && n == 2 && segs[0] == "nodes" && (segs[1] == "query" || segs[1] == "count" || segs[1] == "count_by"):
            let context = path
            let parsed = do planJson(body)
            if !parsed.ok:
                let refusal = do planRefusalMalformedBody(context, parsed.message)
                let v = do planValueRefuse(refusal)
                return v
            let kindField = do planField(parsed.value, "kind")
            if kindField.has:
                let v = do planColocated1(ks, context, readIntent, true, kindField.s, false, "")
                return v
            let v = do planSpanning(ks, readIntent, "a kind-less predicate query", "it selects across every kind, and the keyset cursor it pages with is opaque and backend-local, so two backends' pages cannot be merged into one resumable sequence")
            return v

        if method == "POST" && n == 2 && segs[0] == "nodes" && segs[1] == "multiget":
            let parsed = do planJson(body)
            if !parsed.ok:
                let refusal = do planRefusalMalformedBody("POST /nodes/multiget", parsed.message)
                let v = do planValueRefuse(refusal)
                return v
            let addrArr = do sjGet(parsed.value, "addresses")
            if !addrArr.has || addrArr.v.kind != "arr":
                let refusal = do planRefusalMalformedBody("POST /nodes/multiget", "no `addresses` array")
                let v = do planValueRefuse(refusal)
                return v
            let v = do planMultigetKeys(addrArr.v.items, ks, readIntent)
            return v

        # ── edges ───────────────────────────────────────────────────
        if (method == "POST" || method == "DELETE") && n == 1 && segs[0] == "edge":
            let context = method + " /edge"
            let parsed = do planJson(body)
            if !parsed.ok:
                let refusal = do planRefusalMalformedBody(context, parsed.message)
                let v = do planValueRefuse(refusal)
                return v
            let fromField = do planField(parsed.value, "from")
            if !fromField.has:
                let refusal = do planRefusalMalformedBody(context, "no `from` address")
                let v = do planValueRefuse(refusal)
                return v
            let fromResolved = do planKeyspaceResolve(ks, false, "", true, fromField.s)
            if fromResolved.missCode != -1:
                let refusal = do planKeyspaceMissToRefusal(fromResolved)
                let v = do planValueRefuse(refusal)
                return v
            let toField = do planField(parsed.value, "to")
            if !toField.has:
                let refusal = do planRefusalMalformedBody(context, "no `to` address")
                let v = do planValueRefuse(refusal)
                return v
            let toResolved = do planKeyspaceResolve(ks, false, "", true, toField.s)
            if toResolved.missCode != -1:
                let refusal = do planKeyspaceMissToRefusal(toResolved)
                let v = do planValueRefuse(refusal)
                return v
            let fromOrigin = "from '" + fromField.s + "'"
            let toOrigin = "to '" + toField.s + "'"
            let fromKi = PlanKeyIntent{key: fromResolved.key, intent: writeIntent, origin: fromOrigin}
            let toKi = PlanKeyIntent{key: toResolved.key, intent: writeIntent, origin: toOrigin}
            let v = do planValueColocated([fromKi, toKi])
            return v

        # ── the batch ───────────────────────────────────────────────
        if method == "POST" && n == 1 && segs[0] == "transaction":
            let v = do planTransactionPlan(body, ks)
            return v

        # ── events ──────────────────────────────────────────────────
        if method == "GET" && n == 1 && segs[0] == "events":
            let v = do planValueSubscribe()
            return v

        if method == "POST" && n == 1 && segs[0] == "publish":
            let parsed = do planJson(body)
            if !parsed.ok:
                let refusal = do planRefusalMalformedBody("POST /publish", parsed.message)
                let v = do planValueRefuse(refusal)
                return v
            let channelField = do planField(parsed.value, "channel")
            if !channelField.has:
                let refusal = do planRefusalMalformedBody("POST /publish", "no `channel`")
                let v = do planValueRefuse(refusal)
                return v
            let v = do planColocated1(ks, "POST /publish", writeIntent, true, channelField.s, false, "")
            return v

        # ── per-instance state ─────────────────────────────────────
        if method == "GET" && n == 1 && segs[0] == "stats":
            let v = do planSpanning(ks, readIntent, "GET /stats", "its counts and its process-lifetime operation counters describe one engine, and no fleet-wide sum of them is true — Fabric's own telemetry poller reads /stats from each instance directly")
            return v

        if method == "POST" && n == 2 && segs[0] == "admin" && segs[1] == "users":
            let v = do planSpanning(ks, writeIntent, "the /admin/users endpoints", "creating a user mints a secret inside the instance that serves it and returns it once, so broadcasting would create one identity per backend with a different token each; FacetQL exposes no way to create a user from a caller-supplied token or hash")
            return v
        if method == "GET" && n == 2 && segs[0] == "admin" && segs[1] == "users":
            let v = do planSpanning(ks, writeIntent, "the /admin/users endpoints", "creating a user mints a secret inside the instance that serves it and returns it once, so broadcasting would create one identity per backend with a different token each; FacetQL exposes no way to create a user from a caller-supplied token or hash")
            return v
        if method == "DELETE" && n == 3 && segs[0] == "admin" && segs[1] == "users":
            let v = do planSpanning(ks, writeIntent, "the /admin/users endpoints", "creating a user mints a secret inside the instance that serves it and returns it once, so broadcasting would create one identity per backend with a different token each; FacetQL exposes no way to create a user from a caller-supplied token or hash")
            return v

        # ── fleet-wide declarations ────────────────────────────────
        if method == "GET" && n == 2 && segs[0] == "admin" && (segs[1] == "indexes" || segs[1] == "references"):
            let v = do planValueBroadcast(0, "a fleet-wide declaration listing")
            return v

        if method == "POST" && n == 2 && segs[0] == "admin" && (segs[1] == "indexes" || segs[1] == "references"):
            let v = do planValueBroadcast(1, "a fleet-wide declaration")
            return v
        if method == "DELETE" && n == 3 && segs[0] == "admin" && (segs[1] == "indexes" || segs[1] == "references"):
            let v = do planValueBroadcast(1, "a fleet-wide declaration")
            return v

        let refusal = do planRefusalUnknownRoute(method, path)
        let v = do planValueRefuse(refusal)
        return v

    # ============================================================
    # SECTION 9: DEMO / HAND-TRACED VERIFICATION FIXTURES — restating
    # plan.rs's own eleven `#[test]` functions, one demo proc per test (or
    # per small cluster of the same test's assertions), each returning a
    # text/int summary of the facts that test checks. Expected values are
    # given in each proc's own comment, hand-traced against `plan()`'s real
    # match arms above and cross-checked against the exact bodies/paths
    # `plan.rs`'s own `#[test]` functions use.
    # ============================================================
    proc planDemoReadPrimary() -> PlanReadPreference:
        return PlanReadPreference{code: 0, region: ""}

    # key(shard_id) = RoutingKey::new(shard_id, Coordinate::new(0,0)), plan.rs's
    # own test helper; displayed "{shard}/0,0".
    proc planDemoKey(shardId: int) -> RoutingKey:
        return RoutingKey{shardId: shardId, coordinate: Coordinate{x: 0, y: 0}}

    # split(): {"Post"->key(1), "User"->key(2)}, no fallback — restates
    # plan.rs's own test helper `split()` exactly.
    proc planDemoSplitKeyspace() -> PlanKeyspace:
        let rules = [RoutingRule{kind: "Post", prefix: "Post:", key: planDemoKey(1)}, RoutingRule{kind: "User", prefix: "User:", key: planDemoKey(2)}]
        return PlanKeyspace{rules: rules, hasFallback: false, fallbackKey: routingKeyUnset()}

    # Keyspace::single(key(7)) — restates the namespace-wide tests' own
    # single-backend fixture.
    proc planDemoSingleKeyspace() -> PlanKeyspace:
        return PlanKeyspace{rules: [], hasFallback: true, fallbackKey: planDemoKey(7)}

    # a_point_read_routes_by_its_address +
    # a_percent_encoded_address_routes_the_same_as_a_bare_one. Expected:
    # bareKey=1/0,0 isWrite=false percentEncodedKey=1/0,0.
    proc planDemoPointReadRoutesByAddress() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let v1 = do planRequest("GET", "/node/Post:17", false, "", "", ks, rp)
        let ki1 = v1.keys[0]
        let v2 = do planRequest("GET", "/node/Post%3A17", false, "", "", ks, rp)
        let ki2 = v2.keys[0]
        return "bareKey=" + routingKeyDisplay(ki1.key) + " isWrite=" + ki1.intent.isWrite + " percentEncodedKey=" + routingKeyDisplay(ki2.key)

    # a_write_is_planned_as_a_write. Expected: put=true delete=true
    # claim=true.
    proc planDemoWriteIsPlannedAsWrite() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let vPut = do planRequest("PUT", "/node/Post:1", false, "", "", ks, rp)
        let vDel = do planRequest("DELETE", "/node/Post:1", false, "", "", ks, rp)
        let vClaim = do planRequest("POST", "/node/Post:1/claim", false, "", "", ks, rp)
        return "put=" + vPut.keys[0].intent.isWrite + " delete=" + vDel.keys[0].intent.isWrite + " claim=" + vClaim.keys[0].intent.isWrite

    # a_kind_scoped_query_routes_by_its_kind. Expected: byBodyKind=2/0,0
    # byQueryParam=1/0,0.
    proc planDemoKindScopedQueryRoutesByKind() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let vBody = do planRequest("POST", "/nodes/query", false, "", "{\"kind\":\"User\",\"limit\":500}", ks, rp)
        let vQuery = do planRequest("GET", "/nodes", true, "kind=Post&limit=50", "", ks, rp)
        return "byBodyKind=" + routingKeyDisplay(vBody.keys[0].key) + " byQueryParam=" + routingKeyDisplay(vQuery.keys[0].key)

    # a_transaction_over_two_kinds_is_refused_not_split — plan.rs's own
    # comment: "Planning yields both keys; it is dispatch that discovers
    # they are two backends." Expected: kind=0 (Colocated) keyCount=2
    # key0=1/0,0 key1=2/0,0.
    proc planDemoTransactionOverTwoKindsRefusedNotSplit() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let body = "{\"operations\":[{\"type\":\"insert_node\",\"address\":\"Post:1\",\"kind\":\"Post\",\"x\":0,\"y\":0,\"z\":0,\"q\":0,\"data\":\"{}\",\"public\":false},{\"type\":\"delete_node\",\"address\":\"User:9\"}]}"
        let v = do planRequest("POST", "/transaction", false, "", body, ks, rp)
        let keyCount = len(v.keys)
        return "kind=" + v.kind + " keyCount=" + keyCount + " key0=" + routingKeyDisplay(v.keys[0].key) + " key1=" + routingKeyDisplay(v.keys[1].key)

    # every_transaction_op_shape_contributes_its_keys. Expected: keyCount=9
    # (6 single-address/kind ops + 2 two-ended edge ops). Exercises the
    # JSON skipper on nested `"set":{}`, numbers, and `false`.
    proc planDemoEveryTransactionOpShapeContributesKeys() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let body = "{\"operations\":[{\"type\":\"insert_node\",\"address\":\"Post:1\",\"kind\":\"Post\",\"x\":0,\"y\":0,\"z\":0,\"q\":0,\"data\":\"{}\",\"public\":false},{\"type\":\"delete_node\",\"address\":\"Post:2\"},{\"type\":\"clear_kind\",\"kind\":\"Post\"},{\"type\":\"delete_where\",\"kind\":\"Post\"},{\"type\":\"set_if\",\"address\":\"Post:3\",\"field\":\"v\",\"expect_eq\":1,\"set\":{}},{\"type\":\"insert_edge\",\"from\":\"Post:4\",\"to\":\"Post:5\",\"kind\":\"rel\"},{\"type\":\"delete_edge\",\"from\":\"Post:6\",\"to\":\"Post:7\",\"kind\":\"rel\"}]}"
        let v = do planRequest("POST", "/transaction", false, "", body, ks, rp)
        let keyCount = len(v.keys)
        return "keyCount=" + keyCount

    # an_edge_names_both_of_its_ends. Expected: key0=1/0,0 key1=2/0,0.
    proc planDemoEdgeNamesBothEnds() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let body = "{\"from\":\"Post:1\",\"to\":\"User:2\",\"kind\":\"wrote\"}"
        let v = do planRequest("POST", "/edge", false, "", body, ks, rp)
        return "key0=" + routingKeyDisplay(v.keys[0].key) + " key1=" + routingKeyDisplay(v.keys[1].key)

    # a_multiget_names_every_address_it_asks_about. Expected: key0=1/0,0
    # key1=1/0,0 key2=2/0,0.
    proc planDemoMultigetNamesEveryAddress() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let body = "{\"addresses\":[\"Post:1\",\"Post:2\",\"User:3\"]}"
        let v = do planRequest("POST", "/nodes/multiget", false, "", body, ks, rp)
        return "key0=" + routingKeyDisplay(v.keys[0].key) + " key1=" + routingKeyDisplay(v.keys[1].key) + " key2=" + routingKeyDisplay(v.keys[2].key)

    # namespace_wide_requests_are_refused_only_when_the_namespace_is_split.
    # Expected: every splitCode=5 (NotProxyable) and every singleKey=7/0,0
    # (key(7)).
    proc planDemoNamespaceWideRefusedOnlyWhenSplit() -> text:
        let split = do planDemoSplitKeyspace()
        let single = do planDemoSingleKeyspace()
        let rp = do planDemoReadPrimary()
        let vNodesSplit = do planRequest("GET", "/nodes", false, "", "", split, rp)
        let vNodesSingle = do planRequest("GET", "/nodes", false, "", "", single, rp)
        let vStatsSplit = do planRequest("GET", "/stats", false, "", "", split, rp)
        let vStatsSingle = do planRequest("GET", "/stats", false, "", "", single, rp)
        let vUsersSplit = do planRequest("POST", "/admin/users", false, "", "{\"owner\":\"a\"}", split, rp)
        let vUsersSingle = do planRequest("POST", "/admin/users", false, "", "{\"owner\":\"a\"}", single, rp)
        let vQuerySplit = do planRequest("POST", "/nodes/query", false, "", "{\"limit\":10}", split, rp)
        let vQuerySingle = do planRequest("POST", "/nodes/query", false, "", "{\"limit\":10}", single, rp)
        return "nodes: splitCode=" + vNodesSplit.refusal.code + " singleKey=" + routingKeyDisplay(vNodesSingle.keys[0].key) + "; stats: splitCode=" + vStatsSplit.refusal.code + " singleKey=" + routingKeyDisplay(vStatsSingle.keys[0].key) + "; users: splitCode=" + vUsersSplit.refusal.code + " singleKey=" + routingKeyDisplay(vUsersSingle.keys[0].key) + "; query: splitCode=" + vQuerySplit.refusal.code + " singleKey=" + routingKeyDisplay(vQuerySingle.keys[0].key)

    # declarations_go_to_every_backend_and_listings_must_agree. Expected:
    # indexesGet kind=1 agreement=0 what="a fleet-wide declaration listing";
    # referencesPost agreement=1 what="a fleet-wide declaration"; root
    # kind=1 agreement=0 what="GET /".
    proc planDemoDeclarationsBroadcastAndAgreement() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let vIndexesGet = do planRequest("GET", "/admin/indexes", false, "", "", ks, rp)
        let vReferencesPost = do planRequest("POST", "/admin/references", false, "", "{}", ks, rp)
        let vRoot = do planRequest("GET", "/", false, "", "", ks, rp)
        return "indexesGet: kind=" + vIndexesGet.kind + " agreement=" + vIndexesGet.broadcastAgreement + " what=" + vIndexesGet.broadcastWhat + "; referencesPost: agreement=" + vReferencesPost.broadcastAgreement + " what=" + vReferencesPost.broadcastWhat + "; root: kind=" + vRoot.kind + " agreement=" + vRoot.broadcastAgreement + " what=" + vRoot.broadcastWhat

    # a_publish_routes_by_its_channel_to_exactly_one_backend. Expected:
    # publishKey=1/0,0 eventsKind=2 (Subscribe).
    proc planDemoPublishRoutesToOneBackendEventsSubscribe() -> text:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let vPublish = do planRequest("POST", "/publish", false, "", "{\"channel\":\"Post\",\"payload\":\"{}\"}", ks, rp)
        let vEvents = do planRequest("GET", "/events", false, "", "", ks, rp)
        return "publishKey=" + routingKeyDisplay(vPublish.keys[0].key) + " eventsKind=" + vEvents.kind

    # an_unknown_path_is_a_404_exactly_as_facetql_answers_it. Expected: 404.
    proc planDemoUnknownPathIs404() -> int:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let v = do planRequest("GET", "/nope", false, "", "", ks, rp)
        let status = do planRefusalStatus(v.refusal)
        return status

    # a_body_that_is_not_the_contract_is_a_400_not_a_misroute. Expected:
    # 400.
    proc planDemoMalformedBodyIs400() -> int:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let v = do planRequest("POST", "/transaction", false, "", "not json", ks, rp)
        let status = do planRefusalStatus(v.refusal)
        return status

    # an_unmapped_address_is_refused_rather_than_sent_somewhere_plausible.
    # Expected: 421.
    proc planDemoUnmappedAddressIs421() -> int:
        let ks = do planDemoSplitKeyspace()
        let rp = do planDemoReadPrimary()
        let v = do planRequest("GET", "/node/Comment:1", false, "", "", ks, rp)
        let status = do planRefusalStatus(v.refusal)
        return status

    # the_missing_credential_message_is_facetqls_own_words. Expected:
    # "missing x-api-key header (or ?key= for SSE)". `MissingCredential`
    # (and `SpansBackends`, exercised nowhere else in this file — see
    # header) is never built by `planRequest` itself; this demo exercises
    # its builder/Display directly, matching plan.rs's own test doing the
    # same to a bare `Refusal::MissingCredential` value.
    proc planDemoMissingCredentialMessage() -> text:
        let r = do planRefusalMissingCredential()
        let msg = do planRefusalDisplay(r)
        return msg

    state planDemoPointRead: text = ""
    state planDemoWriteIntent: text = ""
    state planDemoKindScoped: text = ""
    state planDemoTxTwoKinds: text = ""
    state planDemoTxAllOpShapes: text = ""
    state planDemoEdge: text = ""
    state planDemoMultiget: text = ""
    state planDemoNamespaceWide: text = ""
    state planDemoDeclarations: text = ""
    state planDemoPublishEvents: text = ""
    state planDemoUnknownPathStatus: int = 0
    state planDemoMalformedBodyStatus: int = 0
    state planDemoUnmappedAddressStatus: int = 0
    state planDemoMissingCredentialMessage: text = ""

    action runFabricPlanDemo():
        let r1 = do planDemoPointReadRoutesByAddress()
        let r2 = do planDemoWriteIsPlannedAsWrite()
        let r3 = do planDemoKindScopedQueryRoutesByKind()
        let r4 = do planDemoTransactionOverTwoKindsRefusedNotSplit()
        let r5 = do planDemoEveryTransactionOpShapeContributesKeys()
        let r6 = do planDemoEdgeNamesBothEnds()
        let r7 = do planDemoMultigetNamesEveryAddress()
        let r8 = do planDemoNamespaceWideRefusedOnlyWhenSplit()
        let r9 = do planDemoDeclarationsBroadcastAndAgreement()
        let r10 = do planDemoPublishRoutesToOneBackendEventsSubscribe()
        let r11 = do planDemoUnknownPathIs404()
        let r12 = do planDemoMalformedBodyIs400()
        let r13 = do planDemoUnmappedAddressIs421()
        let r14 = do planDemoMissingCredentialMessage()
        planDemoPointRead = r1
        planDemoWriteIntent = r2
        planDemoKindScoped = r3
        planDemoTxTwoKinds = r4
        planDemoTxAllOpShapes = r5
        planDemoEdge = r6
        planDemoMultiget = r7
        planDemoNamespaceWide = r8
        planDemoDeclarations = r9
        planDemoPublishEvents = r10
        planDemoUnknownPathStatus = r11
        planDemoMalformedBodyStatus = r12
        planDemoUnmappedAddressStatus = r13
        planDemoMissingCredentialMessage = r14

    private view Home at "/fabric_plan":
        box:
            text "{planDemoPointRead}"
