    # driverMangle: manglePrivate — this module's private procs and views
    # renamed `name~<fnv32a(abs)>`, and every same-file call to a private
    # proc rewritten to match, before the module is merged.
    proc driverMangle(prog: Program, abs: text) -> Program:
        let suffix = do driverFNV32a(abs)
        let mut from = []
        let mut to = []
        let np = len(prog.privateProcs)
        let mut i = 0
        loop i < np:
            from = append(from, prog.privateProcs[i])
            to = append(to, prog.privateProcs[i] + "~" + suffix)
            i = i + 1
        let mut views = []
        let nv = len(prog.views)
        let mut vi = 0
        loop vi < nv:
            let v = prog.views[vi]
            if v.private:
                views = append(views, ViewEntry{name: v.name + "~" + suffix, path: v.path, headerValid: v.headerValid, body: v.body, header: v.header, bodySrc: v.bodySrc, private: true})
            else:
                views = append(views, v)
            vi = vi + 1
        if len(from) == 0:
            return Program{name: prog.name, hasAuth: prog.hasAuth, entities: prog.entities, records: prog.records, structs: prog.structs, enums: prog.enums, states: prog.states, derives: prog.derives, policies: prog.policies, procs: prog.procs, actions: prog.actions, webhooks: prog.webhooks, jobs: prog.jobs, services: prog.services, components: prog.components, triggers: prog.triggers, views: views, themes: prog.themes, css: prog.css, daemons: prog.daemons, privateProcs: [], parseErrors: prog.parseErrors, layouts: prog.layouts, rawDecls: prog.rawDecls, kind: prog.kind, into: prog.into, mounts: prog.mounts, sockets: prog.sockets, hasFrame: prog.hasFrame, frameSrc: prog.frameSrc, hasContent: prog.hasContent, contentSrc: prog.contentSrc, unknownKeywords: prog.unknownKeywords, shareds: prog.shareds}
        let mut procs = []
        let npr = len(prog.procs)
        let mut pi = 0
        loop pi < npr:
            let pd = prog.procs[pi]
            let at = do vbFind(from, pd.name)
            let mut name = pd.name
            if at >= 0:
                name = to[at]
            procs = append(procs, ProcDecl{name: name, paramNames: pd.paramNames, paramTypes: pd.paramTypes, paramLists: pd.paramLists, paramOptionals: pd.paramOptionals, hasRet: pd.hasRet, retCore: pd.retCore, retIsList: pd.retIsList, retIsOptional: pd.retIsOptional, uses: pd.uses, headerValid: pd.headerValid, body: pd.body, bodyValid: pd.bodyValid, headerLine: pd.headerLine, bodySrc: pd.bodySrc, renameFrom: from, renameTo: to, bodyLineNos: pd.bodyLineNos})
            pi = pi + 1
        let mut actions = []
        let na = len(prog.actions)
        let mut ai = 0
        loop ai < na:
            let ad = prog.actions[ai]
            actions = append(actions, ActionDecl{name: ad.name, paramNames: ad.paramNames, paramTypes: ad.paramTypes, paramOptionals: ad.paramOptionals, optimistic: ad.optimistic, headerValid: ad.headerValid, requires: ad.requires, body: ad.body, bodyValid: ad.bodyValid, bodySrc: ad.bodySrc, renameFrom: from, renameTo: to, paramLists: ad.paramLists, ret: ad.ret, retList: ad.retList, retErr: ad.retErr})
            ai = ai + 1
        let mut daemons = []
        let nd = len(prog.daemons)
        let mut di = 0
        loop di < nd:
            let dd = prog.daemons[di]
            daemons = append(daemons, DaemonDecl{name: dd.name, every: dd.every, uses: dd.uses, bodySrc: dd.bodySrc, err: dd.err, renameFrom: from, renameTo: to, bodyLineNos: dd.bodyLineNos})
            di = di + 1
        return Program{name: prog.name, hasAuth: prog.hasAuth, entities: prog.entities, records: prog.records, structs: prog.structs, enums: prog.enums, states: prog.states, derives: prog.derives, policies: prog.policies, procs: procs, actions: actions, webhooks: prog.webhooks, jobs: prog.jobs, services: prog.services, components: prog.components, triggers: prog.triggers, views: views, themes: prog.themes, css: prog.css, daemons: daemons, privateProcs: [], parseErrors: prog.parseErrors, layouts: prog.layouts, rawDecls: prog.rawDecls, kind: prog.kind, into: prog.into, mounts: prog.mounts, sockets: prog.sockets, hasFrame: prog.hasFrame, frameSrc: prog.frameSrc, hasContent: prog.hasContent, contentSrc: prog.contentSrc, unknownKeywords: prog.unknownKeywords, shareds: prog.shareds}

    # ── layered composition: internal/compile/compose.go ───────────────
    proc driverIsLayered(mods: [Program]) -> bool:
        let n = len(mods)
        let mut i = 0
        loop i < n:
            let k = mods[i].kind
            if k == "playground" || k == "wireframe" || k == "ui" || k == "data":
                return true
            i = i + 1
        return false

    proc driverIsPresentational(f: Program) -> bool:
        let contributes = len(f.components) > 0 || len(f.layouts) > 0 || f.css != "" || len(f.themes) > 0
        if !contributes:
            return false
        if len(f.entities) > 0 || len(f.records) > 0 || len(f.enums) > 0 || len(f.states) > 0 || len(f.derives) > 0 || len(f.policies) > 0:
            return false
        if len(f.actions) > 0 || len(f.procs) > 0 || len(f.jobs) > 0 || len(f.services) > 0 || len(f.webhooks) > 0 || len(f.triggers) > 0 || len(f.views) > 0:
            return false
        if len(f.mounts) > 0 || len(f.sockets) > 0 || f.hasFrame || f.hasAuth:
            return false
        return true

    struct DriverComposed:
        err: text
        prog: Program
        views: [VView]

    proc driverComposeErr(p: Program, msg: text) -> DriverComposed:
        return DriverComposed{err: msg, prog: p, views: []}

    proc driverFrameOf(f: Program) -> [VNode]:
        let lines = do vpLinesOf(f.frameSrc)
        let nodes = do vpNodes(lines)
        return nodes

    proc driverJoinCSS(a: text, b: text) -> text:
        if a == "":
            return b
        if b == "":
            return a
        return a + "\n" + b

    proc driverAppendThemes(a: [ProgThemeBlock], b: [ProgThemeBlock]) -> [ProgThemeBlock]:
        let mut out = a
        let n = len(b)
        let mut i = 0
        loop i < n:
            out = append(out, b[i])
            i = i + 1
        return out

    proc driverCompose(mods: [Program]) -> DriverComposed:
        let n = len(mods)
        let mut pgAt = -1
        let mut wfs = []
        let mut bricks = []
        let mut atoms = []
        let mut i = 0
        loop i < n:
            let f = mods[i]
            if len(f.parseErrors) > 0:
                let e0 = do driverComposeErr(f, f.parseErrors[0])
                return e0
            if f.kind == "playground":
                if pgAt >= 0:
                    let e1 = do driverComposeErr(f, "two playgrounds (\"" + mods[pgAt].name + "\" and \"" + f.name + "\") — an app has exactly one baseplate")
                    return e1
                pgAt = i
            if f.kind == "wireframe":
                wfs = append(wfs, i)
            if f.kind == "ui" || f.kind == "data":
                bricks = append(bricks, i)
            if f.kind == "app":
                let pres = do driverIsPresentational(f)
                if !pres:
                    let e2 = do driverComposeErr(f, "plain `app` \"" + f.name + "\" cannot be mixed into a layered build — make it a `ui`/`data` facet (or strip it to presentation: components, layouts, theme, css), or build from a playground")
                    return e2
                atoms = append(atoms, i)
            i = i + 1
        if pgAt < 0:
            let e3 = do driverComposeErr(mods[0], "a layered app needs a `playground` baseplate to build from")
            return e3
        let pg = mods[pgAt]
        # wireframes and their sockets
        let mut wfNames = []
        let mut sockNames = []
        let mut sockOwners = []
        let mut sockAccepts = []
        let nw = len(wfs)
        let mut wi = 0
        loop wi < nw:
            let w = mods[wfs[wi]]
            if w.name in wfNames:
                let e4 = do driverComposeErr(w, "two wireframes are both named \"" + w.name + "\"")
                return e4
            if !w.hasFrame:
                let e4b = do driverComposeErr(w, "wireframe \"" + w.name + "\" needs a `frame:` block")
                return e4b
            wfNames = append(wfNames, w.name)
            let ns = len(w.sockets)
            let mut si = 0
            loop si < ns:
                let sk = w.sockets[si]
                if sk.err != "":
                    let e5 = do driverComposeErr(w, sk.err)
                    return e5
                let at = do vbFind(sockNames, sk.name)
                if at >= 0:
                    let e6 = do driverComposeErr(w, "socket \"" + sk.name + "\" is declared by both wireframe \"" + sockOwners[at] + "\" and \"" + w.name + "\" — socket names must be unique")
                    return e6
                sockNames = append(sockNames, sk.name)
                sockOwners = append(sockOwners, w.name)
                sockAccepts = append(sockAccepts, sk.accept)
                si = si + 1
            wi = wi + 1
        # fill: (owner, socket) -> content, in brick order
        let mut fillOwner = []
        let mut fillSocket = []
        let mut fillNodes = []
        let nb = len(bricks)
        let mut bi = 0
        loop bi < nb:
            let b = mods[bricks[bi]]
            let at2 = do vbFind(sockNames, b.into)
            if at2 < 0:
                let sorted = do vbSortText(sockNames)
                let mut hint = " (the wireframe declares no sockets)"
                if len(sorted) > 0:
                    let mut joined = ""
                    let nsn = len(sorted)
                    let mut ji = 0
                    loop ji < nsn:
                        if ji > 0:
                            joined = joined + ", "
                        joined = joined + sorted[ji]
                        ji = ji + 1
                    hint = " (sockets: " + joined + ")"
                let e7 = do driverComposeErr(b, b.kind + " facet \"" + b.name + "\" snaps into socket \"" + b.into + "\", but no wireframe declares it" + hint)
                return e7
            if sockAccepts[at2] != b.kind:
                let e8 = do driverComposeErr(b, "socket \"" + b.into + "\" accepts `" + sockAccepts[at2] + "` facets, but \"" + b.name + "\" is a `" + b.kind + "` facet — the bricks don't fit")
                return e8
            if !b.hasContent:
                let e8b = do driverComposeErr(b, b.kind + " facet \"" + b.name + "\" needs a `content:` block to fill socket \"" + b.into + "\"")
                return e8b
            if b.kind == "ui" && len(b.entities) > 0:
                let e8c = do driverComposeErr(b, "ui facet \"" + b.name + "\" may not declare an entity — move durable data into a `data` facet")
                return e8c
            let clines = do vpLinesOf(b.contentSrc)
            let content = do vpNodes(clines)
            let ce = do vpListErr(content)
            if ce != "":
                let e9 = do driverComposeErr(b, ce)
                return e9
            let owner = sockOwners[at2]
            let mut found = -1
            let nf = len(fillOwner)
            let mut fi = 0
            loop fi < nf:
                if fillOwner[fi] == owner && fillSocket[fi] == b.into:
                    found = fi
                fi = fi + 1
            if found >= 0:
                let mut merged = fillNodes[found].nodes
                let nc = len(content)
                let mut ci = 0
                loop ci < nc:
                    merged = append(merged, content[ci])
                    ci = ci + 1
                fillNodes[found] = VFill{nodes: merged}
            else:
                fillOwner = append(fillOwner, owner)
                fillSocket = append(fillSocket, b.into)
                fillNodes = append(fillNodes, VFill{nodes: content})
            bi = bi + 1
        # the composite app
        let mut themes = pg.themes
        let mut css = pg.css
        let mut hasAuth = pg.hasAuth
        let mut wj = 0
        loop wj < nw:
            let w2 = mods[wfs[wj]]
            let t1 = do driverAppendThemes(themes, w2.themes)
            themes = t1
            let c1 = do driverJoinCSS(css, w2.css)
            css = c1
            wj = wj + 1
        let mut app = Program{name: pg.name, hasAuth: false, entities: [], records: [], structs: [], enums: [], states: [], derives: [], policies: [], procs: [], actions: [], webhooks: [], jobs: [], services: [], components: [], triggers: [], views: [], themes: [], css: "", daemons: [], privateProcs: [], parseErrors: [], layouts: [], rawDecls: [], kind: "app", into: "", mounts: [], sockets: [], hasFrame: false, frameSrc: "", hasContent: false, contentSrc: "", unknownKeywords: [], shareds: []}
        let mut policyNames = []
        let mut policyCounts = []
        let mut bj = 0
        loop bj < nb:
            let b2 = mods[bricks[bj]]
            hasAuth = hasAuth || b2.hasAuth
            let entities = do driverCatEntities(app.entities, b2.entities)
            let enums = do driverCatEnums(app.enums, b2.enums)
            let states = do driverCatStates(app.states, b2.states)
            let derives = do driverCatDerives(app.derives, b2.derives)
            let policies = do driverCatPolicies(app.policies, b2.policies)
            let actions = do driverCatActions(app.actions, b2.actions)
            let procs = do driverCatProcs(app.procs, b2.procs)
            let jobs = do driverCatJobs(app.jobs, b2.jobs)
            let daemons = do driverCatDaemons(app.daemons, b2.daemons)
            let components = do driverCatComponents(app.components, b2.components)
            let services = do driverCatServices(app.services, b2.services)
            let mut layouts = app.layouts
            let nly = len(b2.layouts)
            let mut lyi = 0
            loop lyi < nly:
                layouts = append(layouts, b2.layouts[lyi])
                lyi = lyi + 1
            app = Program{name: app.name, hasAuth: false, entities: entities, records: [], structs: [], enums: enums, states: states, derives: derives, policies: policies, procs: procs, actions: actions, webhooks: [], jobs: jobs, services: services, components: components, triggers: [], views: [], themes: [], css: "", daemons: daemons, privateProcs: [], parseErrors: [], layouts: layouts, rawDecls: [], kind: "app", into: "", mounts: [], sockets: [], hasFrame: false, frameSrc: "", hasContent: false, contentSrc: "", unknownKeywords: [], shareds: app.shareds + b2.shareds}
            let t2 = do driverAppendThemes(themes, b2.themes)
            themes = t2
            let c2 = do driverJoinCSS(css, b2.css)
            css = c2
            let npl = len(b2.policies)
            let mut pli = 0
            loop pli < npl:
                policyNames = append(policyNames, b2.policies[pli].name)
                policyCounts = append(policyCounts, len(b2.policies[pli].paramNames))
                pli = pli + 1
            bj = bj + 1
        let mut components2 = app.components
        let mut layouts2 = app.layouts
        let na = len(atoms)
        let mut ai = 0
        loop ai < na:
            let a = mods[atoms[ai]]
            let cc = do driverCatComponents(components2, a.components)
            components2 = cc
            let nly2 = len(a.layouts)
            let mut l2 = 0
            loop l2 < nly2:
                layouts2 = append(layouts2, a.layouts[l2])
                l2 = l2 + 1
            let t3 = do driverAppendThemes(themes, a.themes)
            themes = t3
            let c3 = do driverJoinCSS(css, a.css)
            css = c3
            ai = ai + 1
        # screens: every mount, then every brick view spliced into its frame
        if len(pg.mounts) == 0:
            let e10 = do driverComposeErr(pg, "playground \"" + pg.name + "\" must `mount <Wireframe>`")
            return e10
        let mut views = []
        let mut seenPaths = []
        let mut seenNames = []
        let nm = len(pg.mounts)
        let mut mi = 0
        loop mi < nm:
            let m = pg.mounts[mi]
            if m.err != "":
                let e11 = do driverComposeErr(pg, m.err)
                return e11
            let wat = do vbFind(wfNames, m.wireframe)
            if wat < 0:
                let e12 = do driverComposeErr(pg, "playground \"" + pg.name + "\" mounts wireframe \"" + m.wireframe + "\", which was not found (did you import it?)")
                return e12
            if m.requires != "":
                let pat = do vbFind(policyNames, m.requires)
                if pat < 0:
                    let e13 = do driverComposeErr(pg, "screen \"" + m.wireframe + "\" (at \"" + m.path + "\") requires policy \"" + m.requires + "\", which is not defined in any data facet")
                    return e13
                if policyCounts[pat] != 0:
                    let e14 = do driverComposeErr(pg, "screen guard \"" + m.requires + "\" must be a zero-argument policy")
                    return e14
            let dp = do vbFind(seenPaths, m.path)
            if dp >= 0:
                let e15 = do driverComposeErr(pg, "two screens mount at \"" + m.path + "\" (\"" + seenNames[dp] + "\" and \"" + m.wireframe + "\")")
                return e15
            seenPaths = append(seenPaths, m.path)
            seenNames = append(seenNames, m.wireframe)
            let w3 = mods[wfs[wat]]
            let frame = do driverFrameOf(w3)
            let fe = do vpListErr(frame)
            if fe != "":
                let e16 = do driverComposeErr(pg, fe)
                return e16
            let mut names = []
            let mut fills = []
            let nf2 = len(fillOwner)
            let mut f2 = 0
            loop f2 < nf2:
                if fillOwner[f2] == w3.name:
                    names = append(names, fillSocket[f2])
                    fills = append(fills, fillNodes[f2])
                f2 = f2 + 1
            let sp = do vpSpliceInto(frame, false, "frame", "", [], names, fills, 0)
            if sp.err != "":
                let e17 = do driverComposeErr(pg, sp.err)
                return e17
            views = append(views, VView{err: "", name: m.wireframe, path: m.path, params: [], layout: "", requires: m.requires, titleSegs: [], descSegs: [], root: sp.nodes, screen: true})
            mi = mi + 1
        let mut bk = 0
        loop bk < nb:
            let b3 = mods[bricks[bk]]
            let nbv = len(b3.views)
            if nbv > 0:
                let oat = do vbFind(sockNames, b3.into)
                let owner2 = sockOwners[oat]
                let wat2 = do vbFind(wfNames, owner2)
                let w4 = mods[wfs[wat2]]
                let frame2 = do driverFrameOf(w4)
                let mut bv = 0
                loop bv < nbv:
                    let ve = b3.views[bv]
                    let v = do vpParseView(ve.header, ve.bodySrc)
                    if v.err != "":
                        let e18 = do driverComposeErr(b3, v.err)
                        return e18
                    if v.layout != "":
                        let e19 = do driverComposeErr(b3, b3.kind + " facet \"" + b3.name + "\": view \"" + v.name + "\" may not name a layout — the wireframe that owns socket \"" + b3.into + "\" is this screen's chrome")
                        return e19
                    if v.path == "":
                        let e20 = do driverComposeErr(b3, b3.kind + " facet \"" + b3.name + "\": view \"" + v.name + "\" needs an explicit route — write `view " + v.name + " at \"/path\":`")
                        return e20
                    let dp2 = do vbFind(seenPaths, v.path)
                    if dp2 >= 0:
                        let e21 = do driverComposeErr(b3, "two screens mount at \"" + v.path + "\" (\"" + seenNames[dp2] + "\" and \"" + v.name + "\")")
                        return e21
                    seenPaths = append(seenPaths, v.path)
                    seenNames = append(seenNames, v.name)
                    let mut names2 = []
                    let mut fills2 = []
                    let mut swappedIn = false
                    let nf3 = len(fillOwner)
                    let mut f3 = 0
                    loop f3 < nf3:
                        if fillOwner[f3] == owner2:
                            names2 = append(names2, fillSocket[f3])
                            if fillSocket[f3] == b3.into:
                                fills2 = append(fills2, VFill{nodes: v.root})
                                swappedIn = true
                            else:
                                fills2 = append(fills2, fillNodes[f3])
                        f3 = f3 + 1
                    if !swappedIn:
                        names2 = append(names2, b3.into)
                        fills2 = append(fills2, VFill{nodes: v.root})
                    let sp2 = do vpSpliceInto(frame2, false, "frame", "", [], names2, fills2, 0)
                    if sp2.err != "":
                        let e22 = do driverComposeErr(b3, sp2.err)
                        return e22
                    views = append(views, VView{err: "", name: v.name, path: v.path, params: v.params, layout: "", requires: v.requires, titleSegs: v.titleSegs, descSegs: v.descSegs, root: sp2.nodes, screen: true})
                    bv = bv + 1
            bk = bk + 1
        let out = Program{name: app.name, hasAuth: hasAuth, entities: app.entities, records: [], structs: [], enums: app.enums, states: app.states, derives: app.derives, policies: app.policies, procs: app.procs, actions: app.actions, webhooks: [], jobs: app.jobs, services: app.services, components: components2, triggers: [], views: [], themes: themes, css: css, daemons: app.daemons, privateProcs: [], parseErrors: [], layouts: layouts2, rawDecls: [], kind: "app", into: "", mounts: [], sockets: [], hasFrame: false, frameSrc: "", hasContent: false, contentSrc: "", unknownKeywords: [], shareds: app.shareds}
        return DriverComposed{err: "", prog: out, views: views}

    # driverCSSFrom: collectModules' `css from "styles.css"` pass — each
    # sibling stylesheet (relative to this module's own directory) read and
    # folded into the module's CSS after its inline blocks, in order.
    struct DriverCSSOut:
        prog: Program
        err: text

    proc driverCSSFrom(root: text, abs: text, p: Program) -> DriverCSSOut:
        let base = do driverBaseOf(abs)
        let dir = do driverDirOf(abs)
        let mut css = p.css
        let mut kept = []
        let nr = len(p.rawDecls)
        let mut i = 0
        loop i < nr:
            let rd = p.rawDecls[i]
            if rd.kw != "cssfrom":
                kept = append(kept, rd)
                i = i + 1
                continue
            let r0 = do vpTrimPrefix(trim(rd.header), "css from")
            let u = do goUnquote(trim(r0))
            if !u.ok:
                return DriverCSSOut{prog: p, err: base + ": line " + rd.line + ": css from needs a quoted path: css from \"styles.css\""}
            if u.value == "":
                return DriverCSSOut{prog: p, err: base + ": line " + rd.line + ": css from path is empty"}
            let isAbs = do vpHasPrefix(u.value, "/")
            let mut cssAbs = dir + "/" + u.value
            if isAbs:
                cssAbs = u.value
            let clean = do driverCleanPath(cssAbs)
            let pre = root + "/"
            let under = do vpHasPrefix(clean, pre)
            let mut exists = false
            if under:
                let ex = do driverFileExists(slice(clean, len(pre), len(clean)))
                exists = ex
            if !exists:
                let q = do goQuote(u.value)
                return DriverCSSOut{prog: p, err: base + ":" + rd.line + ": css from " + q + ": open " + clean + ": no such file or directory"}
            let body = do driverReadFile(slice(clean, len(pre), len(clean)))
            if css == "":
                css = body
            else:
                if body != "":
                    css = css + "\n" + body
            i = i + 1
        let out = Program{name: p.name, hasAuth: p.hasAuth, entities: p.entities, records: p.records, structs: p.structs, enums: p.enums, states: p.states, derives: p.derives, policies: p.policies, procs: p.procs, actions: p.actions, webhooks: p.webhooks, jobs: p.jobs, services: p.services, components: p.components, triggers: p.triggers, views: p.views, themes: p.themes, css: css, daemons: p.daemons, privateProcs: p.privateProcs, parseErrors: p.parseErrors, layouts: p.layouts, rawDecls: kept, kind: p.kind, into: p.into, mounts: p.mounts, sockets: p.sockets, hasFrame: p.hasFrame, frameSrc: p.frameSrc, hasContent: p.hasContent, contentSrc: p.contentSrc, unknownKeywords: p.unknownKeywords, shareds: p.shareds}
        return DriverCSSOut{prog: out, err: ""}

    proc driverFileExists(path: text) -> bool uses io.file:
        let e = fileExists(path)
        return e

    proc compileFileJSON(root: text, rel: text) -> text:
        let entry = do driverCleanPath(root + "/" + rel)
        let col = do driverCollect(root, entry, [], [])
        if col.err != "":
            let q0 = do jsonQuote(col.err)
            return "{\"error\":" + q0 + "}"
        let mut mods = []
        let n = len(col.mods)
        let mut i = 0
        loop i < n:
            let p0 = do parseProgramSrc(col.mods[i].src)
            let p1 = do driverMangle(p0, col.mods[i].abs)
            if len(p1.parseErrors) > 0:
                mods = append(mods, p1)
                i = i + 1
                continue
            let cf = do driverCSSFrom(root, col.mods[i].abs, p1)
            if cf.err != "":
                let qf = do jsonQuote(cf.err)
                return "{\"error\":" + qf + "}"
            mods = append(mods, cf.prog)
            i = i + 1
        let layered = do driverIsLayered(mods)
        let mut out = do driverEmptyOut(mods[0])
        if layered:
            let comp = do driverCompose(mods)
            if comp.err != "":
                let qc = do jsonQuote(comp.err)
                return "{\"error\":" + qc + "}"
            let dupC = do driverCheckDuplicates(comp.prog)
            if dupC != "":
                let qd = do jsonQuote(dupC)
                return "{\"error\":" + qd + "}"
            let o1 = do compileProgramV(comp.prog, true, comp.views)
            out = o1
        else:
            let mut files = []
            let mut fi = 0
            loop fi < n:
                files = append(files, col.mods[fi].abs)
                fi = fi + 1
            let rc = do driverRouteCollisions(mods, files)
            if rc != "":
                let qr = do jsonQuote(rc)
                return "{\"error\":" + qr + "}"
            let mut prog = mods[0]
            let mut k = 1
            loop k < n:
                let merged = do driverMerge(prog, mods[k])
                prog = merged
                k = k + 1
            let dup = do driverCheckDuplicates(prog)
            if dup != "":
                let qd2 = do jsonQuote(dup)
                return "{\"error\":" + qd2 + "}"
            let o2 = do compileProgram(prog)
            out = o2
        if out.err != "":
            let q = do jsonQuote(out.err)
            return "{\"error\":" + q + "}"
        let j = do irGraphJSON(out.graph)
        return j

    state compiledOut: text = ""

    action runCompileFile(root: text, rel: text):
        let out = do compileFileJSON(root, rel)
        compiledOut = out

    action runCompileSrc(src: text):
        let out = do compileSrc(src)
        compiledOut = out

    private view DriverHome at "/driver":
        box:
            text "{compiledOut}"
