# driver.fct — the missing root piece the earlier selfhost ports never
# built: a single end-to-end compiler over a WHOLE .fct app's source text,
# chaining program.fct's parseProgramSrc (source -> Program), the
# per-declaration lowerers (action_lower.fct/proc_lower.fct/lower.fct), and
# ir_graph.fct's native IRGraph + irGraphJSON into one `compileSrc(src) ->
# text` that answers with the same JSON shape encoding/json.Marshal(*ir.IR)
# produces for the declarations this file covers.
#
# SCOPE: the whole compiled graph for a plain `app` — enums, records,
# structs, states (with the built-in `theme` cell a dark/named palette
# injects), top-level derives, policies, entities (with parser.go's
# qualifyRowRefs applied to `read:`/derive bodies, and every index the view
# compiler infers), actions (including the @e2e seal set), procs, daemons,
# services, jobs, webhooks, triggers, the `auth` table, the theme maps and
# css — and, through view_build.fct, every view: pages, routes, bindings,
# the top-level view and depGraph. compileFile resolves `import`s the way
# compile.File does (depth-first collection, private-name mangling,
# mergeInto) through the io.file capability. driver_test.go compares the
# WHOLE IR against the real compiler for every example app.
#
# Not yet here: components/`use`, layouts, wire types/messages, files,
# api/stream declarations, assets and `css from` — a program that uses one
# of the view-side ones is refused by name rather than compiled wrongly.
import "program.fct"
import "action_lower.fct"
import "proc_lower.fct"
import "ir_graph.fct"
import "wire_build.fct"

app DriverSelfHost:
    # ── literal ExprNode builders for synthesized defaults ──────────────
    # State with no `= default` clause: real parser.go's defaultFor (int
    # -> 0, bool -> false, else -> ""), or an empty list for a `[T]` state
    # (ast.ListLit{}). program.fct's own buildStateDecl always leaves
    # `default` as expr_tokens.fct's emptyNode() (a filler int-0 node) when
    # hasDefault is false, regardless of the state's real type — wrong for
    # a bool/text/list cell, so this driver recomputes the correct default
    # itself rather than trusting that filler.
    private proc driverIntLit(text0: text) -> ExprNode:
        return ExprNode{kind: "int", text: text0, field: "", itemVar: "", coll: "", children: [], pairs: [], whereClause: [], sel: [], order: "", desc: false, limit: [], orderBy: [], varFromArg: false}

    private proc driverBoolLit(text0: text) -> ExprNode:
        return ExprNode{kind: "bool", text: text0, field: "", itemVar: "", coll: "", children: [], pairs: [], whereClause: [], sel: [], order: "", desc: false, limit: [], orderBy: [], varFromArg: false}

    private proc driverTextLit(quoted: text) -> ExprNode:
        return ExprNode{kind: "text", text: quoted, field: "", itemVar: "", coll: "", children: [], pairs: [], whereClause: [], sel: [], order: "", desc: false, limit: [], orderBy: [], varFromArg: false}

    private proc driverEmptyListLit() -> ExprNode:
        return ExprNode{kind: "list", text: "", field: "", itemVar: "", coll: "", children: [], pairs: [], whereClause: [], sel: [], order: "", desc: false, limit: [], orderBy: [], varFromArg: false}

    proc driverStateDefaultNode(sd: StateDecl) -> ExprNode:
        if sd.hasDefault:
            return sd.default
        if sd.isList:
            let el = do driverEmptyListLit()
            return el
        if sd.typeCore == "int":
            let il = do driverIntLit("0")
            return il
        if sd.typeCore == "bool":
            let bl = do driverBoolLit("false")
            return bl
        let tl = do driverTextLit("\"\"")
        return tl

    private proc driverAddName(names: [text], name: text) -> [text]:
        if name in names:
            return names
        return append(names, name)

    # ── dependency walk for a top-level derive's lowered expression ─────
    # Mirrors internal/ir/build.go's (*env).depsIR exactly: only
    # ref/get/eget/astate/agg/call/list/bin/un are walked (agg only
    # descends into `where`, never `sel` — a real, deliberate Go asymmetry,
    # reproduced here rather than "fixed").
    private proc driverDepsWalk(e: IRExpr, stateNames: [text], entityNames: [text], acc: [text]) -> [text]:
        if e.kind == "ref":
            if e.name in stateNames:
                let t1 = do driverAddName(acc, e.name)
                return t1
            if e.name in entityNames:
                let t2 = do driverAddName(acc, e.name)
                return t2
            return acc
        if e.kind == "get":
            if len(e.obj) > 0:
                let t3 = do driverDepsWalk(e.obj[0], stateNames, entityNames, acc)
                return t3
            return acc
        if e.kind == "eget":
            let mut acc2 = acc
            if e.name in entityNames:
                let t4 = do driverAddName(acc2, e.name)
                acc2 = t4
            if len(e.key) > 0:
                let t5 = do driverDepsWalk(e.key[0], stateNames, entityNames, acc2)
                acc2 = t5
            return acc2
        if e.kind == "astate":
            if e.op == "dirty" || e.op == "touched":
                let t6 = do driverAddName(acc, e.name)
                return t6
            let t7 = do driverAddName(acc, "@act:" + e.name)
            return t7
        if e.kind == "agg":
            let mut acc3 = acc
            if e.name in entityNames:
                let t8 = do driverAddName(acc3, e.name)
                acc3 = t8
            if len(e.where) > 0:
                let t9 = do driverDepsWalk(e.where[0], stateNames, entityNames, acc3)
                acc3 = t9
            if len(e.sel) > 0:
                let t9s = do driverDepsWalk(e.sel[0], stateNames, entityNames, acc3)
                acc3 = t9s
            if len(e.limit) > 0:
                let t9l = do driverDepsWalk(e.limit[0], stateNames, entityNames, acc3)
                acc3 = t9l
            return acc3
        if e.kind == "call" || e.kind == "list" || e.kind == "struct":
            let mut acc4 = acc
            let n = len(e.args)
            let mut i = 0
            loop i < n:
                let t10 = do driverDepsWalk(e.args[i], stateNames, entityNames, acc4)
                acc4 = t10
                i = i + 1
            return acc4
        if e.kind == "bin":
            let mut acc5 = acc
            if len(e.l) > 0:
                let t11 = do driverDepsWalk(e.l[0], stateNames, entityNames, acc5)
                acc5 = t11
            if len(e.r) > 0:
                let t12 = do driverDepsWalk(e.r[0], stateNames, entityNames, acc5)
                acc5 = t12
            return acc5
        if e.kind == "un":
            if len(e.x) > 0:
                let __t136 = do driverDepsWalk(e.x[0], stateNames, entityNames, acc)
                return __t136
            return acc
        return acc

    proc driverDepsOf(e: IRExpr, stateNames: [text], entityNames: [text]) -> [text]:
        let raw = do driverDepsWalk(e, stateNames, entityNames, [])
        let sorted = do alowSortText(raw)
        return sorted

    # ── entity field lowering (enum text-tag, relation Ref+index, @unique
    #    index, @requires read policy) ────────────────────────────────────
    proc driverEntityFieldIR(f: EntityFieldDecl, enumNames: [text], entityNames: [text]) -> IRField:
        let mut ftype = f.typeCore
        let mut ref = ""
        let mut enumName = ""
        let mut idx = false
        if f.typeCore in enumNames:
            ftype = "text"
            enumName = f.typeCore
        if f.typeCore in entityNames:
            ref = f.typeCore
            idx = true
        if f.unique:
            idx = true
        let mut onDel = ""
        if f.onDeleteRestrict:
            onDel = "restrict"
        if f.onDeleteSetNull:
            onDel = "setNull"
        let mut readPolicy = ""
        if f.hasRequiresPolicy:
            readPolicy = f.requiresPolicy
        return IRField{name: f.name, type: ftype, ref: ref, enumName: enumName, index: idx, secret: f.secret, e2e: f.e2e, password: f.password, readPolicy: readPolicy, optional: f.isOptional, unique: f.unique, required: f.required, hasMin: f.hasMin, min: f.minValue, hasMax: f.hasMax, max: f.maxValue, matches: f.matchesPattern, onDelete: onDel}

    proc driverArchivedField() -> IRField:
        return IRField{name: "archived", type: "bool", ref: "", enumName: "", index: true, secret: false, e2e: false, password: false, readPolicy: "", optional: false, unique: false, required: false, hasMin: false, min: 0, hasMax: false, max: 0, matches: "", onDelete: ""}

    # driverParseFile: parseFile — `file Name: text|bytes at "path"`, one
    # line, no body.
    struct DriverFile:
        err: text
        name: text
        type: text
        path: text

    proc driverParseFile(rd: RawDecl) -> DriverFile:
        let ln = "line " + rd.line + ": "
        if trim(rd.bodySrc) != "":
            return DriverFile{err: ln + "file declares no body — `read`/`write` are proc statements, not part of the declaration", name: "", type: "", path: ""}
        let r0 = do vpTrimPrefix(trim(rd.header), "file")
        let rest = trim(r0)
        let colon = do vpIndexOf(rest, ":")
        if colon < 0:
            return DriverFile{err: ln + "file needs a type: file Name: text at \"path.txt\"", name: "", type: "", path: ""}
        let name = trim(slice(rest, 0, colon))
        let tail = trim(slice(rest, colon + 1, len(rest)))
        let at = do vpIndexOf(tail, " at ")
        if at < 0:
            return DriverFile{err: ln + "file needs a path: file Name: text at \"path.txt\"", name: "", type: "", path: ""}
        let typ = trim(slice(tail, 0, at))
        let u = do goUnquote(trim(slice(tail, at + 4, len(tail))))
        if !u.ok || u.value == "":
            return DriverFile{err: ln + "file needs a quoted path: file Name: text at \"path.txt\"", name: "", type: "", path: ""}
        let ni = do vpIsIdent(name)
        let nq = do goQuote(name)
        if !ni:
            return DriverFile{err: ln + "invalid file name " + nq, name: "", type: "", path: ""}
        if typ != "text" && typ != "bytes":
            let tq = do goQuote(typ)
            return DriverFile{err: ln + "file " + nq + " type must be text or bytes, got " + tq, name: "", type: "", path: ""}
        return DriverFile{err: "", name: name, type: typ, path: u.value}

    # ── declaration checks Build makes (records, entities, states,
    #    services, webhooks, triggers) ───────────────────────────────────
    proc driverIsPrimitive(t: text) -> bool:
        return t == "int" || t == "text" || t == "bool" || t == "money" || t == "date" || t == "float" || t == "datetime"

    # driverDeclDiag: the structural refusals that need no expression
    # typing — the first one, or "".
    # driverBraceErr: braceErr — the one diagnostic for a quoted position
    # that does not interpolate.
    proc driverBraceErr(pos: text, s: text, snip: text, fix: text) -> text:
        let sq = do goQuote(s)
        return pos + " does not interpolate, so " + sq + " renders `" + snip + "` as literal text — " + fix + ". `{…}` interpolates in node text, labels, placeholders, `class`, `meta` and link/image destinations, and nowhere else; braces around a name the scope does not define are literal everywhere"

    proc driverDeclDiag(prog: Program, enumNames: [text], entityNames: [text], policyNames: [text], policyParamCounts: [int], litNames: [text]) -> text:
        # theme tokens and service URLs are fixed at compile time
        let nth = len(prog.themes)
        let mut th = 0
        loop th < nth:
            let nv = len(prog.themes[th].vars)
            let mut tv = 0
            loop tv < nv:
                let v = prog.themes[th].vars[tv]
                let snip = do driverLitInterp(v.value, litNames)
                if snip != "":
                    let nq = do goQuote(v.name)
                    let be = do driverBraceErr("theme token " + nq, v.value, snip, "a theme token is a CSS value emitted once into the page's stylesheet, so it cannot read the app's data — switch whole palettes with `theme <name>:` blocks and the built-in `theme` cell instead")
                    return be
                tv = tv + 1
            th = th + 1
        let nsv0 = len(prog.services)
        let mut sv0 = 0
        loop sv0 < nsv0:
            let snip2 = do driverLitInterp(prog.services[sv0].url, litNames)
            if snip2 != "":
                let sq2 = do goQuote(prog.services[sv0].name)
                let be2 = do driverBraceErr("service " + sq2 + "'s base URL", prog.services[sv0].url, snip2, "a service's base URL is fixed at compile time — it is where the authority connects, not something a render decides; put the varying part in the operation's arguments")
                return be2
            sv0 = sv0 + 1
        # records are flat
        let nr = len(prog.records)
        let mut ri = 0
        loop ri < nr:
            let rd = prog.records[ri]
            let nf = len(rd.fields)
            let mut fi = 0
            loop fi < nf:
                let f = rd.fields[fi]
                let prim = do driverIsPrimitive(f.typeCore)
                if !prim && !(f.typeCore in enumNames):
                    let fq = do goQuote(f.name)
                    let tq = do goQuote(f.typeCore)
                    return "record field " + fq + " has type " + tq + " — a record field must be a primitive, an enum, or a list of those (records are flat: no nested records or entities)"
                fi = fi + 1
            ri = ri + 1
        # entities
        let ne = len(prog.entities)
        let mut ei = 0
        loop ei < ne:
            let ed = prog.entities[ei]
            let enq = do goQuote(ed.name)
            if ed.ephemeral && ed.softDelete:
                return "entity " + enq + " is @ephemeral, so @softdelete has nothing to archive into — drop one"
            let nd = len(ed.derives)
            let mut di = 0
            loop di < nd:
                let dh = ed.derives[di].line
                let colon = do indexOf(dh, ":")
                let paren = do indexOf(dh, "(")
                if paren >= 0 && (colon < 0 || paren < colon):
                    let dq = do goQuote(ed.derives[di].name)
                    return "entity " + enq + "'s derive " + dq + " is computed from the row itself, so it takes no parameters — declare a parameterized derive at the app level"
                di = di + 1
            let nf2 = len(ed.fields)
            let mut fj = 0
            loop fj < nf2:
                let f2 = ed.fields[fj]
                let fq2 = do goQuote(f2.name)
                if f2.onDeleteRestrict && f2.onDeleteSetNull:
                    return "field " + fq2 + " cannot be both @restrict and @setNull — @restrict refuses the delete while a reference remains, @setNull clears this field instead; pick one"
                if f2.onDeleteSetNull && !f2.isOptional:
                    return "field " + fq2 + " is @setNull but not optional — write `" + f2.name + ": " + f2.typeCore + "?` so the column has a null to hold once the referenced row is deleted"
                if (f2.onDeleteRestrict || f2.onDeleteSetNull) && !(f2.typeCore in entityNames):
                    return "field " + fq2 + " has an on-delete modifier (@restrict/@setNull) but is not a relation to another entity"
                if f2.hasRequiresPolicy:
                    let pat = do vbFind(policyNames, f2.requiresPolicy)
                    let pq = do goQuote(f2.requiresPolicy)
                    if pat < 0:
                        return "field " + ed.name + "." + f2.name + " @requires unknown policy " + pq
                    if policyParamCounts[pat] != 0:
                        return "field " + ed.name + "." + f2.name + " @requires row-level policy " + pq + "; a field gate must be a zero-argument policy"
                fj = fj + 1
            ei = ei + 1
        # states: the built-in `route`
        let ns = len(prog.states)
        let mut si = 0
        loop si < ns:
            if prog.states[si].name == "route":
                return "state \"route\" collides with the built-in `route` (the path being rendered) — rename the cell"
            si = si + 1
        # service replies
        let nsv = len(prog.services)
        let mut vi = 0
        loop vi < nsv:
            let sv = prog.services[vi]
            let no = len(sv.ops)
            let mut oi = 0
            loop oi < no:
                let op = sv.ops[oi]
                if op.hasRet && op.retCore == "bytes" && op.retIsList:
                    return sv.name + "." + op.name + " returns [bytes] — a service answers one file per call"
                let prim2 = do driverIsPrimitive(op.retCore)
                if op.hasRet && op.retCore != "" && op.retCore != "bytes" && !prim2 && !(op.retCore in enumNames):
                    let mut isRec = false
                    let mut rk = 0
                    loop rk < nr:
                        if prog.records[rk].name == op.retCore:
                            isRec = true
                        rk = rk + 1
                    if !isRec:
                        let rq = do goQuote(op.retCore)
                        return sv.name + "." + op.name + " returns unknown type " + rq + " — declare a `record " + op.retCore + ": …` for a structured reply, or use a primitive/enum"
                oi = oi + 1
            vi = vi + 1
        return ""

    # driverReservedWebhook: reservedWebhookPath.
    proc driverReservedWebhook(p: text) -> bool:
        if p in ["/", "/event", "/live", "/api", "/upload", "/admin", "/facet.js", "/healthz", "/readyz", "/metrics", "/billing/webhook"]:
            return true
        let pres = ["/api/", "/uploads/", "/admin/", "/auth/", "/dev/"]
        let mut i = 0
        loop i < 5:
            let pl = len(pres[i])
            if len(p) >= pl && slice(p, 0, pl) == pres[i]:
                return true
            i = i + 1
        return false

    # driverRouteDiag: Build 4d (webhooks) and 4e (triggers) over the built
    # actions.
    proc driverRouteDiag(prog: Program, actions: [IRAction], litNames: [text]) -> text:
        let mut seen = []
        let nw = len(prog.webhooks)
        let mut wi = 0
        loop wi < nw:
            let wh = prog.webhooks[wi]
            let pq = do goQuote(wh.path)
            let at = do wFindAction(actions, wh.action)
            if at < 0:
                let aq = do goQuote(wh.action)
                return "line " + wh.line + ": webhook " + pq + " targets unknown action " + aq
            let sat = do vbFind(seen, wh.path)
            if sat >= 0:
                return "line " + wh.line + ": webhook path " + pq + " redeclared (first at line " + prog.webhooks[sat].line + ")"
            let res = do driverReservedWebhook(wh.path)
            if res:
                return "line " + wh.line + ": webhook path " + pq + " collides with a route the runtime reserves"
            let snip = do driverLitInterp(wh.path, litNames)
            if snip != "":
                return "line " + wh.line + ": webhook path " + pq + " does not interpolate, so " + pq + " renders `" + snip + "` as literal text — a webhook path is a fixed endpoint an external system POSTs to, so it is literal — read the varying part out of the body in the action it targets. `{…}` interpolates in node text, labels, placeholders, `class`, `meta` and link/image destinations, and nowhere else; braces around a name the scope does not define are literal everywhere"
            seen = append(seen, wh.path)
            wi = wi + 1
        # triggers: known source, a zero-argument server reaction, no cycle
        let mut keys = []
        let mut froms = []
        let mut tos = []
        let nt = len(prog.triggers)
        let mut ti = 0
        loop ti < nt:
            let tr = prog.triggers[ti]
            let src = do wFindAction(actions, tr.onAction)
            if src < 0:
                return "trigger `on " + tr.onAction + "` names unknown action \"" + tr.onAction + "\""
            let rx = do wFindAction(actions, tr.reactionAction)
            let rq = do goQuote(tr.reactionAction)
            if rx < 0:
                return "trigger reaction " + rq + " is not a defined action"
            if actions[rx].placement != "server":
                return "trigger reaction " + rq + " is client-placed; a reaction runs on the server authority, so it must be authoritative"
            if len(actions[rx].params) != 0:
                return "trigger reaction " + rq + " takes arguments; a reaction runs a zero-argument action"
            let key = tr.onAction + " -> " + tr.reactionAction
            if key in keys:
                return "trigger `on " + key + "` redeclared"
            keys = append(keys, key)
            froms = append(froms, tr.onAction)
            tos = append(tos, tr.reactionAction)
            ti = ti + 1
        let cyc = do driverTriggerCycle(froms, tos)
        if cyc != "":
            return "trigger cycle: " + cyc + " — reactions would never terminate"
        return ""

    # driverTriggerCycle: triggerCycle — DFS over sources in sorted order,
    # each node's edges in declaration order; the first back edge's cycle.
    struct DrCyc:
        color: [int]
        stack: [text]
        found: text

    proc driverTriggerCycle(froms: [text], tos: [text]) -> text:
        let mut nodes = []
        let n = len(froms)
        let mut i = 0
        loop i < n:
            if !(froms[i] in nodes):
                nodes = append(nodes, froms[i])
            i = i + 1
        let sorted = do vbSortText(nodes)
        let mut all = sorted
        let mut j = 0
        loop j < n:
            if !(tos[j] in all):
                all = append(all, tos[j])
            j = j + 1
        let mut color = []
        let na = len(all)
        let mut k = 0
        loop k < na:
            color = append(color, 0)
            k = k + 1
        let mut st = DrCyc{color: color, stack: [], found: ""}
        let ns = len(sorted)
        let mut s = 0
        loop s < ns:
            let at = do vbFind(all, sorted[s])
            if st.color[at] == 0:
                let r = do driverCycDfs(all, froms, tos, sorted[s], st)
                if r.found != "":
                    return r.found
                st = r
            s = s + 1
        return ""

    proc driverCycDfs(all: [text], froms: [text], tos: [text], node: text, st0: DrCyc) -> DrCyc:
        let at = do vbFind(all, node)
        let mut color = st0.color
        color[at] = 1
        let mut st = DrCyc{color: color, stack: append(st0.stack, node), found: ""}
        let n = len(froms)
        let mut i = 0
        loop i < n:
            if froms[i] == node:
                let m = tos[i]
                let mat = do vbFind(all, m)
                if st.color[mat] == 1:
                    let mut start = 0
                    let ls = len(st.stack)
                    let mut q = ls - 1
                    loop q >= 0:
                        if st.stack[q] == m:
                            start = q
                        q = q - 1
                    let mut path = ""
                    let mut p = start
                    loop p < ls:
                        path = path + st.stack[p] + " -> "
                        p = p + 1
                    return DrCyc{color: st.color, stack: st.stack, found: path + m}
                if st.color[mat] == 0:
                    let r = do driverCycDfs(all, froms, tos, m, st)
                    if r.found != "":
                        return r
                    st = r
            i = i + 1
        let mut c2 = st.color
        c2[at] = 2
        let mut popped = []
        let ls2 = len(st.stack)
        let mut pi = 0
        loop pi < ls2 - 1:
            popped = append(popped, st.stack[pi])
            pi = pi + 1
        return DrCyc{color: c2, stack: popped, found: ""}

    # driverLitInterp: litInterp — the first `{…}` in s whose contents
    # parse as an expression reading only names in scope.
    proc driverLitInterp(s: text, defined: [text]) -> text:
        let cs = split(s, "")
        let n = len(cs)
        let mut i = 0
        loop i < n:
            if cs[i] == "{":
                let mut end = -1
                let mut j = i + 1
                loop j < n && end < 0:
                    if cs[j] == "}":
                        end = j
                    j = j + 1
                if end < 0:
                    return ""
                let inner = slice(s, i + 1, end)
                let perr = do epParseError(inner)
                if perr == "" && trim(inner) != "":
                    let ex = do parseExprTree(inner)
                    let names = do freeNames(ex)
                    if len(names) > 0:
                        let mut ok = true
                        let nn = len(names)
                        let mut k = 0
                        loop k < nn:
                            if !(names[k] in defined):
                                ok = false
                            k = k + 1
                        if ok:
                            return "{" + inner + "}"
                i = end
            i = i + 1
        return ""

    # driverPureDiag: checkPure — an authority-only builtin refused first,
    # then check() (every stage and name), then no now/rand and no print.
    proc driverPureDiag(ex: ExprNode, locals: [text], ctx: text, stateNames: [text], entityNames: [text], fieldKeys: [text], enumNames: [text], inlineNames: [text], ce: CallEnv) -> text:
        let nodes = do allNodes(ex)
        let secrets = ["verifyPassword", "totpSecret", "totpValid", "randomToken", "fileDigest", "ed25519Verify", "ecdsaP256Verify", "sha256Hex", "canonicalJson", "shuffleOrder"]
        let mut lastSecret = ""
        let nn = len(nodes)
        let mut i = 0
        loop i < nn:
            if nodes[i].kind == "call" && (nodes[i].text in secrets):
                lastSecret = nodes[i].text
            i = i + 1
        if lastSecret != "":
            return ctx + " cannot call " + lastSecret + "(...); it handles an authentication secret and runs only on the authority. Call it from an action body instead"
        let d = do exprCheckTreeC(ex, locals, stateNames, entityNames, fieldKeys, enumNames, inlineNames, ce)
        if d != "":
            return d
        let impure = do nodesHaveImpure(nodes)
        if impure:
            return ctx + " cannot use an effectful builtin (now/rand); it must be pure so it can run on any client. Compute it in an action instead"
        let prints = do nodesHavePrint(nodes)
        if prints:
            return ctx + " cannot call print(...); it is a server-only debugging aid with no client implementation. Call it from an action body or a proc instead"
        return ""

    # driverExprDiag: the declaration expressions Build checks — state
    # initial values (literal text rule), policies, derives, entity
    # derives and read gates — the first refusal, or "".
    proc driverExprDiag(prog: Program, allStates: [StateDecl], stateNames: [text], entityNames: [text], entities: [IREntity], enumNames: [text], inlineNames: [text], ce: CallEnv) -> text:
        let mut fieldKeys = []
        let ne = len(entities)
        let mut ei = 0
        loop ei < ne:
            let nf = len(entities[ei].fields)
            let mut fi = 0
            loop fi < nf:
                fieldKeys = append(fieldKeys, entities[ei].name + "." + entities[ei].fields[fi].name)
                fi = fi + 1
            ei = ei + 1
        let actorScope = do withActor([])
        let ns = len(prog.states)
        let mut si = 0
        loop si < ns:
            let dn = do driverStateDefaultNode(prog.states[si])
            let dnodes = do allNodes(dn)
            let ld = do checkLiteralExpr(dnodes, [], stateNames, entityNames, enumNames, inlineNames)
            if ld != "":
                return ld
            si = si + 1
        let np = len(prog.policies)
        let mut pi = 0
        loop pi < np:
            let pd = prog.policies[pi]
            let plocals = do withActor(pd.paramNames)
            let pdg = do driverPureDiag(pd.predicate, plocals, "a policy", stateNames, entityNames, fieldKeys, enumNames, inlineNames, ce)
            if pdg != "":
                return pdg
            pi = pi + 1
        let nd = len(prog.derives)
        let mut di = 0
        loop di < nd:
            let wd = do wParseDerive(prog.derives[di].line, prog.derives[di].cont)
            if wd.err == "":
                let mut dlocals = actorScope
                let mut ctx = "a derive"
                let npar = len(wd.params)
                if npar > 0:
                    let dq = do goQuote(wd.name)
                    ctx = "derive " + dq
                    let mut pk = 0
                    loop pk < npar:
                        dlocals = append(dlocals, wd.params[pk].name)
                        pk = pk + 1
                let mut dsc = do tyEmptyScope()
                let mut dp = 0
                loop dp < npar:
                    let pt = do tyDeclType(ce.ty, wd.params[dp].type, wd.params[dp].list)
                    if pt.core != "":
                        let pl = do tyLabel(pt)
                        dsc = do tyScopeWith(dsc, wd.params[dp].name, pl)
                    dp = dp + 1
                if npar > 0:
                    let rv = do tyParse(wd.type)
                    let mut ret = do tyDeclType(ce.ty, rv.core, rv.list)
                    if rv.core in ce.ty.wireNames:
                        ret = rv
                    if ret.core == "":
                        return "derive \"" + wd.name + "\" returns unknown type \"" + wd.type + "\""
                let dce = CallEnv{fnNames: ce.fnNames, fnArities: ce.fnArities, procNames: ce.procNames, procArities: ce.procArities, procDerives: ce.procDerives, listNames: ce.listNames, jsonNames: ce.jsonNames, deriveKeys: ce.deriveKeys, inAction: false, inDerive: npar > 0, inProc: false, ty: ce.ty, tsc: dsc}
                let ddg = do driverPureDiag(wd.expr, dlocals, ctx, stateNames, entityNames, fieldKeys, enumNames, inlineNames, dce)
                if ddg != "":
                    return ddg
                if npar > 0:
                    let dad = do tyDeriveArgsDiag(ce.ty, wd.expr, dsc)
                    if dad != "":
                        return dad
                    let rv2 = do tyParse(wd.type)
                    let mut ret2 = do tyDeclType(ce.ty, rv2.core, rv2.list)
                    if rv2.core in ce.ty.wireNames:
                        ret2 = rv2
                    let got = do tyExpr(ce.ty, wd.expr, dsc)
                    let asg = do tyAssignable(ce.ty, got, ret2)
                    if !asg:
                        let rl2 = do tyLabel(ret2)
                        let gl = do tyLabel(got)
                        return "derive \"" + wd.name + "\" is declared " + rl2 + ", but its definition is " + gl
            di = di + 1
        let rowScope = do withActor(["$row"])
        let mut ej = 0
        loop ej < len(prog.entities):
            let ed = prog.entities[ej]
            let enq = do goQuote(ed.name)
            let nde = len(ed.derives)
            let mut dk = 0
            loop dk < nde:
                let dq2 = do goQuote(ed.derives[dk].name)
                let edg = do driverPureDiag(ed.derives[dk].expr, rowScope, "entity " + enq + "'s derive " + dq2, stateNames, entityNames, fieldKeys, enumNames, inlineNames, ce)
                if edg != "":
                    return edg
                dk = dk + 1
            ej = ej + 1
        return ""

    # driverEntityIR: Build step 1 for one entity — its fields, then each
    # carried derive and its `read:` gate lowered through env.low with the
    # entity's own field types (markTextAggs) and every earlier entity
    # derive (deriveOrders) in the context, which it returns grown.
    struct DriverEntityOut:
        ent: IREntity
        ctx: LowCtx

    proc driverEntityIR(ed: EntityDecl, enumNames: [text], entityNames: [text], ctx0: LowCtx) -> DriverEntityOut:
        let mut fields = []
        let mut textKeys = ctx0.textFieldKeys
        let fn = len(ed.fields)
        let mut fi = 0
        loop fi < fn:
            let irf = do driverEntityFieldIR(ed.fields[fi], enumNames, entityNames)
            fields = append(fields, irf)
            if irf.type == "text":
                textKeys = append(textKeys, ed.name + "." + irf.name)
            fi = fi + 1
        if ed.softDelete:
            let af = do driverArchivedField()
            fields = append(fields, af)
        let mut ctx = LowCtx{inlineNames: ctx0.inlineNames, inlineExprs: ctx0.inlineExprs, enumNames: ctx0.enumNames, fns: ctx0.fns, textFieldKeys: textKeys, deriveKeys: ctx0.deriveKeys, deriveExprs: ctx0.deriveExprs, wireOptKeys: ctx0.wireOptKeys, wireNullKeys: ctx0.wireNullKeys}
        let mut readList = []
        if ed.hasRead:
            let rl = do lowFull(ed.readExpr, ctx)
            readList = [rl]
        let mut derives = []
        let dn = len(ed.derives)
        let mut di = 0
        loop di < dn:
            let dd = ed.derives[di]
            let lowered = do lowFull(dd.expr, ctx)
            derives = append(derives, IRDerive{name: dd.name, params: [], type: dd.typeCore, expr: [lowered], deps: []})
            ctx = LowCtx{inlineNames: ctx.inlineNames, inlineExprs: ctx.inlineExprs, enumNames: ctx.enumNames, fns: ctx.fns, textFieldKeys: ctx.textFieldKeys, deriveKeys: append(ctx.deriveKeys, ed.name + "." + dd.name), deriveExprs: append(ctx.deriveExprs, lowered), wireOptKeys: ctx.wireOptKeys, wireNullKeys: ctx.wireNullKeys}
            di = di + 1
        let ent = IREntity{name: ed.name, softDelete: ed.softDelete, ephemeral: ed.ephemeral, fields: fields, read: readList, derives: derives}
        return DriverEntityOut{ent: ent, ctx: ctx}

    # ── state lowering (placement + private flag + correct zero default) ─
    proc driverStateIR(sd: StateDecl, ctx: LowCtx) -> IRState:
        let mut placement = "server"
        let mut private = false
        if sd.placement == "client":
            placement = "client"
        if sd.placement == "private":
            private = true
        let defNode = do driverStateDefaultNode(sd)
        let lowered = do lowFull(defNode, ctx)
        let mut styp = sd.typeCore
        let mut selem = ""
        if sd.isList:
            styp = "[" + sd.typeCore + "]"
            selem = sd.typeCore
        return IRState{name: sd.name, type: styp, elem: selem, list: sd.isList, optional: sd.isOptional, placement: placement, private: private, init: [lowered]}

    # ── the fixed `auth` table (mirrors internal/ir/build.go's
    #    reservedUserEntity + authActions() verbatim) ─────────────────────
    proc driverAuthPlainField(name0: text, type0: text, secret0: bool) -> IRField:
        return IRField{name: name0, type: type0, ref: "", enumName: "", index: false, secret: secret0, e2e: false, password: false, readPolicy: "", optional: false, unique: false, required: false, hasMin: false, min: 0, hasMax: false, max: 0, matches: "", onDelete: ""}

    proc driverAuthEntity() -> IREntity:
        let mut fields = []
        let f_id = do driverAuthPlainField("id", "int", false)
        fields = append(fields, f_id)
        let f_username = do driverAuthPlainField("username", "text", false)
        fields = append(fields, f_username)
        # parser.go/build.go: FacetUser.password is @password (bcrypt-hashed).
        let f_password = IRField{name: "password", type: "text", ref: "", enumName: "", index: false, secret: false, e2e: false, password: true, readPolicy: "", optional: false, unique: false, required: false, hasMin: false, min: 0, hasMax: false, max: 0, matches: "", onDelete: ""}
        fields = append(fields, f_password)
        let f_role = do driverAuthPlainField("role", "text", false)
        fields = append(fields, f_role)
        let f_email = do driverAuthPlainField("email", "text", false)
        fields = append(fields, f_email)
        let f_verified = do driverAuthPlainField("verified", "bool", false)
        fields = append(fields, f_verified)
        let f_verifyToken = do driverAuthPlainField("verifyToken", "text", false)
        fields = append(fields, f_verifyToken)
        let f_resetToken = do driverAuthPlainField("resetToken", "text", false)
        fields = append(fields, f_resetToken)
        let f_resetExpires = do driverAuthPlainField("resetExpires", "int", false)
        fields = append(fields, f_resetExpires)
        let f_mfaSecret = do driverAuthPlainField("mfaSecret", "text", true)
        fields = append(fields, f_mfaSecret)
        let f_mfaEnabled = do driverAuthPlainField("mfaEnabled", "bool", false)
        fields = append(fields, f_mfaEnabled)
        return IREntity{name: "FacetUser", softDelete: false, ephemeral: false, fields: fields, read: [], derives: []}

    private proc driverAuthActionNoParams(name: text) -> IRAction:
        return IRAction{name: name, params: [], requires: [], optimistic: false, ret: "", retList: false, placement: "server", reason: "", writes: [], reads: [], seal: [], body: []}

    private proc driverAuthActionParams(name: text, paramNames: [text]) -> IRAction:
        let mut ps = []
        let n = len(paramNames)
        let mut i = 0
        loop i < n:
            ps = append(ps, IRParam{name: paramNames[i], type: "text", optional: false, list: false})
            i = i + 1
        return IRAction{name: name, params: ps, requires: [], optimistic: false, ret: "", retList: false, placement: "server", reason: "", writes: [], reads: [], seal: [], body: []}

    proc driverAuthActions() -> [IRAction]:
        let mut acts = []
        let a1 = do driverAuthActionParams("signup", ["username", "password"])
        acts = append(acts, a1)
        let a2 = do driverAuthActionParams("login", ["username", "password"])
        acts = append(acts, a2)
        let a3 = do driverAuthActionNoParams("logout")
        acts = append(acts, a3)
        let a4 = do driverAuthActionParams("setRole", ["username", "role"])
        acts = append(acts, a4)
        let a5 = do driverAuthActionParams("requestReset", ["username"])
        acts = append(acts, a5)
        let a6 = do driverAuthActionParams("resetPassword", ["username", "token", "password"])
        acts = append(acts, a6)
        let a7 = do driverAuthActionParams("verifyEmail", ["token"])
        acts = append(acts, a7)
        let a8 = do driverAuthActionNoParams("enableMFA")
        acts = append(acts, a8)
        let a9 = do driverAuthActionParams("confirmMFA", ["code"])
        acts = append(acts, a9)
        let a10 = do driverAuthActionParams("loginMFA", ["username", "code"])
        acts = append(acts, a10)
        return acts

    # ── the end-to-end driver ────────────────────────────────────────────
    struct DriverOut:
        graph: IRGraph
        err: text

    # ── daemon-context procs (internal/ir/detachctx.go) ────────────────
    # A proc is a daemon-context body iff it is referenced, every reference
    # to it anywhere in the program is a `detach` from a daemon-context body
    # (a daemon, main, or another such proc), and it is reachable from a
    # daemon or main by those detaches alone — computed to a fixpoint. why
    # names, for a detached proc that is not one, the reference that makes
    # it an ordinary proc.
    struct DrRefs:
        names: [text]
        detach: [bool]
        from: [text]
        where: [text]

    struct DrCtx:
        procs: [text]
        whyNames: [text]
        whyTexts: [text]

    proc driverIsIdentByte(b: int) -> bool:
        return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95

    # driverScanRefs: every `P(` naming a proc in src (strings skipped),
    # with whether it is the target of a `detach` statement, and how it is
    # written (do / spawn / detach / a call).
    proc driverScanRefs(r0: DrRefs, src: text, procNames: [text], renameFrom: [text], renameTo: [text], from: text, what: text) -> DrRefs:
        let mut r = r0
        let lines = split(src, "\n")
        let nl = len(lines)
        let mut li = 0
        loop li < nl:
            let line = trim(lines[li])
            if line != "" && charAt(line, 0) != "#":
                let bs = textToBytes(line)
                let n = len(bs)
                let mut i = 0
                let mut inStr = false
                let mut prevWord = ""
                loop i < n:
                    let b = bs[i]
                    if inStr:
                        if b == 92:
                            i = i + 1
                        else:
                            if b == 34:
                                inStr = false
                        i = i + 1
                    else:
                        if b == 34:
                            inStr = true
                            i = i + 1
                        else:
                            if driverIsIdentByte(b) && !(b >= 48 && b <= 57):
                                let st = i
                                loop i < n && driverIsIdentByte(bs[i]):
                                    i = i + 1
                                let word = bytesToText(slice(bs, st, i))
                                let mut j = i
                                loop j < n && bs[j] == 32:
                                    j = j + 1
                                let dotted = st > 0 && bs[st - 1] == 46
                                if !dotted && j < n && bs[j] == 40:
                                    let at = do lowerFindName(renameFrom, word)
                                    let mut target = word
                                    if at >= 0:
                                        target = renameTo[at]
                                    if target in procNames:
                                        let mut kind = "call"
                                        if prevWord == "do" || prevWord == "spawn" || prevWord == "detach":
                                            kind = prevWord
                                        let mut shown = word + "(...)"
                                        if kind != "call":
                                            shown = kind + " " + word + "(...)"
                                        r.names = append(r.names, target)
                                        r.detach = append(r.detach, kind == "detach")
                                        r.from = append(r.from, from)
                                        r.where = append(r.where, "`" + shown + "` in " + what)
                                prevWord = word
                            else:
                                if b != 32:
                                    prevWord = ""
                                i = i + 1
            li = li + 1
        return r

    proc driverIsEntry(pd: ProcDecl) -> bool:
        return pd.name == "main" && len(pd.paramNames) == 1 && pd.paramLists[0] && pd.paramTypes[0] == "text" && pd.hasRet && pd.retCore == "int" && !pd.retIsList

    proc driverDaemonCtx(prog: Program) -> DrCtx:
        let mut procNames = []
        let mut i = 0
        loop i < len(prog.procs):
            procNames = append(procNames, prog.procs[i].name)
            i = i + 1
        let mut r = DrRefs{names: [], detach: [], from: [], where: []}
        i = 0
        loop i < len(prog.procs):
            let pd = prog.procs[i]
            let mut from = pd.name
            if driverIsEntry(pd):
                from = ""
            r = do driverScanRefs(r, pd.bodySrc, procNames, pd.renameFrom, pd.renameTo, from, "proc " + pd.name)
            i = i + 1
        i = 0
        loop i < len(prog.daemons):
            let dd = prog.daemons[i]
            r = do driverScanRefs(r, dd.bodySrc, procNames, dd.renameFrom, dd.renameTo, "", "daemon " + dd.name)
            i = i + 1
        i = 0
        loop i < len(prog.actions):
            r = do driverScanRefs(r, prog.actions[i].bodySrc, procNames, [], [], "\u0000", "the app's Actions")
            i = i + 1
        i = 0
        loop i < len(prog.views):
            r = do driverScanRefs(r, prog.views[i].bodySrc, procNames, [], [], "\u0000", "the app's Views")
            i = i + 1
        i = 0
        loop i < len(prog.components):
            r = do driverScanRefs(r, prog.components[i].bodySrc, procNames, [], [], "\u0000", "the app's Components")
            i = i + 1
        i = 0
        loop i < len(prog.derives):
            r = do driverScanRefs(r, prog.derives[i].line, procNames, [], [], "\u0000", "the app's Derives")
            i = i + 1
        let nr = len(r.names)
        # candidates: every referenced proc
        let mut ctx = []
        let mut k = 0
        loop k < nr:
            if !(r.names[k] in ctx):
                ctx = append(ctx, r.names[k])
            k = k + 1
        let mut changed = true
        loop changed:
            changed = false
            let mut kept = []
            let mut c = 0
            loop c < len(ctx):
                let name = ctx[c]
                let mut ok = true
                let mut q = 0
                loop q < nr && ok:
                    if r.names[q] == name && (!r.detach[q] || (r.from[q] != "" && !(r.from[q] in ctx))):
                        ok = false
                    q = q + 1
                if ok:
                    kept = append(kept, name)
                else:
                    changed = true
                c = c + 1
            ctx = kept
        let mut reach = []
        changed = true
        loop changed:
            changed = false
            let mut c2 = 0
            loop c2 < len(ctx):
                let name2 = ctx[c2]
                if !(name2 in reach):
                    let mut q2 = 0
                    let mut found = false
                    loop q2 < nr && !found:
                        if r.names[q2] == name2 && (r.from[q2] == "" || r.from[q2] in reach):
                            found = true
                        q2 = q2 + 1
                    if found:
                        reach = append(reach, name2)
                        changed = true
                c2 = c2 + 1
        let mut whyNames = []
        let mut whyTexts = []
        let mut w = 0
        loop w < len(procNames):
            let pn = procNames[w]
            if !(pn in reach):
                let mut detached = false
                let mut q3 = 0
                loop q3 < nr:
                    if r.names[q3] == pn && r.detach[q3]:
                        detached = true
                    q3 = q3 + 1
                if detached:
                    let mut why = ""
                    let mut q4 = 0
                    let mut stop = false
                    loop q4 < nr && !stop:
                        if r.names[q4] == pn:
                            if !r.detach[q4]:
                                why = r.where[q4]
                                stop = true
                            else:
                                if r.from[q4] != "" && !(r.from[q4] in reach):
                                    why = r.where[q4] + ", which is not itself only ever detached from a daemon or main"
                        q4 = q4 + 1
                    if why != "":
                        whyNames = append(whyNames, pn)
                        whyTexts = append(whyTexts, why)
            w = w + 1
        return DrCtx{procs: reach, whyNames: whyNames, whyTexts: whyTexts}

    # driverCtxDiag: a daemon-only refusal in a detached proc that is not
    # daemon-context says which reference made it an ordinary proc.
    proc driverCtxDiag(dc: DrCtx, name: text, diag: text) -> text:
        let at = do lowerFindName(dc.whyNames, name)
        if at < 0:
            return diag
        if contains(diag, "only available inside a daemon body") || contains(diag, "only valid inside a daemon body"):
            return diag + " (proc \"" + name + "\" is started by `detach`, but it is also reached by " + dc.whyTexts[at] + ", so it runs as an ordinary proc, possibly under a caller's lock)"
        return diag

    proc compileGraph(src: text) -> DriverOut:
        let prog = do parseProgramSrc(src)
        let out = do compileProgram(prog)
        return out

    proc compileProgram(prog: Program) -> DriverOut:
        let r = do compileProgramV(prog, false, [])
        return r

    # compileProgramV: Build over a Program; a composed (layered) build
    # hands its screens over already spliced (composedViews) instead of
    # having them parsed from the Program's own views.
    proc compileProgramV(prog: Program, composed: bool, composedViews: [VView]) -> DriverOut:
        if len(prog.parseErrors) > 0:
            let pe = do driverFailed(prog, prog.parseErrors[0])
            return pe
        # Build's built-in theme switch: any `theme dark:` or named palette
        # injects a `@client` text cell `theme` after the declared states,
        # unless the author declared their own.
        let allStates = do driverStatesWithTheme(prog)

        # Pass 0: enums (name set needed by entity field + state resolution).
        let mut enums = []
        let mut enumNames = []
        let en = len(prog.enums)
        let mut ei = 0
        loop ei < en:
            let ed = prog.enums[ei]
            let mut values = []
            let mut wireNames = []
            let vn = len(ed.values)
            let mut vi = 0
            loop vi < vn:
                values = append(values, ed.values[vi].name)
                wireNames = append(wireNames, ed.values[vi].wireName)
                vi = vi + 1
            enums = append(enums, IREnum{name: ed.name, values: values, wireNames: wireNames})
            enumNames = append(enumNames, ed.name)
            ei = ei + 1

        # Records (flat value objects).
        let mut records = []
        let rn = len(prog.records)
        let mut ri = 0
        loop ri < rn:
            let rd = prog.records[ri]
            let mut rfields = []
            let rfn = len(rd.fields)
            let mut rfi = 0
            loop rfi < rfn:
                let rf = rd.fields[rfi]
                rfields = append(rfields, IRRecordField{name: rf.name, type: rf.typeCore, list: rf.isList, optional: rf.isOptional})
                rfi = rfi + 1
            records = append(records, IRRecord{name: rd.name, fields: rfields})
            ri = ri + 1

        # Structs (proc-local composite types) — same wire shape as Record.
        let mut structs = []
        let sn2 = len(prog.structs)
        let mut si2 = 0
        loop si2 < sn2:
            let sd2 = prog.structs[si2]
            let mut sfields = []
            let sfn = len(sd2.fields)
            let mut sfi = 0
            loop sfi < sfn:
                let sf = sd2.fields[sfi]
                sfields = append(sfields, IRRecordField{name: sf.name, type: sf.typeCore, list: sf.isList, optional: false})
                sfi = sfi + 1
            structs = append(structs, IRRecord{name: sd2.name, fields: sfields})
            si2 = si2 + 1

        # Wire schema (`type` / `message`): resolved before anything that
        # can name one (an action's reply, an emit, a stream).
        let mut wtypes = []
        let mut wmsgs = []
        let nrd = len(prog.rawDecls)
        let mut rdi = 0
        loop rdi < nrd:
            let rd = prog.rawDecls[rdi]
            if rd.kw == "type":
                let wt = do wParseType(rd.header, rd.bodySrc)
                wtypes = append(wtypes, wt)
            if rd.kw == "message":
                let wm = do wParseMessage(rd.header, rd.bodySrc, rd.line, rd.bodyLineNos)
                wmsgs = append(wmsgs, wm)
            rdi = rdi + 1
        let wire = do wBuild(wtypes, wmsgs, enumNames)
        if wire.err != "":
            let wf = do driverFailed(prog, wire.err)
            return wf
        let mut recordNames = []
        let nrn = len(prog.records)
        let mut rni = 0
        loop rni < nrn:
            recordNames = append(recordNames, prog.records[rni].name)
            rni = rni + 1

        # Entity name set (needed for relation-field resolution).
        let mut entityNames = []
        let en2 = len(prog.entities)
        let mut eni = 0
        loop eni < en2:
            entityNames = append(entityNames, prog.entities[eni].name)
            eni = eni + 1

        # env.low's tables: which wire-type fields are optional (markOmits).
        let mut wireOptKeys = []
        let mut wireNullKeys = []
        let nwt = len(wire.types)
        let mut wti = 0
        loop wti < nwt:
            let wt2 = wire.types[wti]
            let nwf = len(wt2.fields)
            let mut wfi = 0
            loop wfi < nwf:
                if wt2.fields[wfi].optional:
                    wireOptKeys = append(wireOptKeys, wt2.name + "." + wt2.fields[wfi].name)
                if wt2.fields[wfi].nullable && !wt2.fields[wfi].optional:
                    wireNullKeys = append(wireNullKeys, wt2.name + "." + wt2.fields[wfi].name)
                wfi = wfi + 1
            wti = wti + 1
        let mut lowCtx = LowCtx{inlineNames: [], inlineExprs: [], enumNames: enumNames, fns: [], textFieldKeys: [], deriveKeys: [], deriveExprs: [], wireOptKeys: wireOptKeys, wireNullKeys: wireNullKeys}

        # Entities (Build step 1), growing env.low's field-type and
        # entity-derive tables as they go.
        let mut entities = []
        let mut eni3 = 0
        loop eni3 < en2:
            let eo = do driverEntityIR(prog.entities[eni3], enumNames, entityNames, lowCtx)
            entities = append(entities, eo.ent)
            lowCtx = eo.ctx
            eni3 = eni3 + 1
        if prog.hasAuth:
            let authEnt = do driverAuthEntity()
            entities = append(entities, authEnt)

        # States (step 2).
        let mut states = []
        let stn = len(allStates)
        let mut sti = 0
        loop sti < stn:
            let irSt = do driverStateIR(allStates[sti], lowCtx)
            states = append(states, irSt)
            sti = sti + 1
        let mut stateNames = []
        let mut stj = 0
        loop stj < stn:
            stateNames = append(stateNames, allStates[stj].name)
            stj = stj + 1

        # Policies (step 3; zero-arg ones join the inline table).
        let mut polProcNames = []
        let npp = len(prog.procs)
        let mut ppj = 0
        loop ppj < npp:
            polProcNames = append(polProcNames, prog.procs[ppj].name)
            ppj = ppj + 1
        let mut policies = []
        let mut policyNames = []
        let mut policyParamCounts = []
        let pn = len(prog.policies)
        let mut pi = 0
        loop pi < pn:
            let pd = prog.policies[pi]
            let ppd = do procCallDiag(pd.predicate, polProcNames, [])
            if ppd != "":
                let ppf = do driverFailed(prog, ppd)
                return ppf
            let lowered = do lowFull(pd.predicate, lowCtx)
            let mut pparams = []
            let ppn = len(pd.paramNames)
            let mut ppi = 0
            loop ppi < ppn:
                pparams = append(pparams, IRParam{name: pd.paramNames[ppi], type: pd.paramTypes[ppi], optional: pd.paramOptionals[ppi], list: false})
                ppi = ppi + 1
            policies = append(policies, IRPolicy{name: pd.name, params: pparams, expr: [lowered]})
            policyNames = append(policyNames, pd.name)
            policyParamCounts = append(policyParamCounts, ppn)
            if ppn == 0:
                lowCtx = LowCtx{inlineNames: append(lowCtx.inlineNames, pd.name), inlineExprs: append(lowCtx.inlineExprs, lowered), enumNames: lowCtx.enumNames, fns: lowCtx.fns, textFieldKeys: lowCtx.textFieldKeys, deriveKeys: lowCtx.deriveKeys, deriveExprs: lowCtx.deriveExprs, wireOptKeys: lowCtx.wireOptKeys, wireNullKeys: lowCtx.wireNullKeys}
            pi = pi + 1

        # Top-level derives (step 3b).
        let builtDerives = do driverBuildDerives(prog.derives, entityNames, stateNames, lowCtx, polProcNames)
        let tyEnv = do driverTyEnv(prog, wtypes, enumNames, entityNames)
        if builtDerives.err != "":
            let dfl = do driverFailed(prog, builtDerives.err)
            return dfl
        lowCtx = builtDerives.ctx

        # Build's refusals over the declarations themselves.
        let mut declLitNames = do withActor(stateNames)
        declLitNames = do appendAllText(declLitNames, entityNames)
        declLitNames = do appendAllText(declLitNames, lowCtx.inlineNames)
        let declDiag = do driverDeclDiag(prog, enumNames, entityNames, policyNames, policyParamCounts, declLitNames)
        if declDiag != "":
            let ddf = do driverFailed(prog, declDiag)
            return ddf
        let mut pceFns = []
        let mut pceArities = []
        let npd = len(builtDerives.derives)
        let mut pdi = 0
        loop pdi < npd:
            if len(builtDerives.derives[pdi].params) > 0:
                pceFns = append(pceFns, builtDerives.derives[pdi].name)
                pceArities = append(pceArities, len(builtDerives.derives[pdi].params))
            pdi = pdi + 1
        let mut pceProcArities = []
        let mut ppa = 0
        loop ppa < len(prog.procs):
            pceProcArities = append(pceProcArities, len(prog.procs[ppa].paramNames))
            ppa = ppa + 1
        let mut pceEntityDerives = []
        let mut ped = 0
        loop ped < len(prog.entities):
            let mut pedk = 0
            loop pedk < len(prog.entities[ped].derives):
                pceEntityDerives = append(pceEntityDerives, prog.entities[ped].name + "." + prog.entities[ped].derives[pedk].name)
                pedk = pedk + 1
            ped = ped + 1
        let declCalls = CallEnv{fnNames: pceFns, fnArities: pceArities, procNames: polProcNames, procArities: pceProcArities, procDerives: builtDerives.procDerives, listNames: [], jsonNames: [], deriveKeys: pceEntityDerives, inAction: false, inDerive: false, inProc: false, ty: tyEnv, tsc: tyEmptyScope()}
        let exprDiag = do driverExprDiag(prog, allStates, stateNames, entityNames, entities, enumNames, lowCtx.inlineNames, declCalls)
        if exprDiag != "":
            let edf = do driverFailed(prog, exprDiag)
            return edf

        # Services.
        let mut services = []
        let svn = len(prog.services)
        let mut svi = 0
        loop svi < svn:
            let sv = prog.services[svi]
            let mut ops = []
            let opn = len(sv.ops)
            let mut opi = 0
            loop opi < opn:
                let op = sv.ops[opi]
                ops = append(ops, IRServiceOp{name: op.name, params: op.paramNames, ret: op.retCore, retList: op.retIsList})
                opi = opi + 1
            services = append(services, IRService{name: sv.name, url: sv.url, urlEnv: sv.urlEnv, headerNames: sv.headerNames, headerEnvs: sv.headerEnvs, ops: ops})
            svi = svi + 1

        # Files (3d″): declared file resources a proc's `read`/`write`
        # operate on, registered before any proc body is built.
        let mut files = []
        let mut fileNames = []
        let mut fileTypes = []
        let mut filePaths = []
        let nfd = len(prog.rawDecls)
        let mut fdi = 0
        loop fdi < nfd:
            if prog.rawDecls[fdi].kw == "file":
                let fd = do driverParseFile(prog.rawDecls[fdi])
                if fd.err != "":
                    let ffl = do driverFailed(prog, fd.err)
                    return ffl
                let fq = do goQuote(fd.name)
                if fd.name in fileNames:
                    let ffd = do driverFailed(prog, "line " + prog.rawDecls[fdi].line + ": file " + fq + " redeclared")
                    return ffd
                let absP = do vpHasPrefix(fd.path, "/")
                if absP:
                    let pq = do goQuote(fd.path)
                    let ffa = do driverFailed(prog, "line " + prog.rawDecls[fdi].line + ": file " + fq + " path " + pq + " must be relative to the sandboxed data directory, not absolute")
                    return ffa
                files = append(files, IRFile{name: fd.name, type: fd.type, path: fd.path})
                fileNames = append(fileNames, fd.name)
                fileTypes = append(fileTypes, fd.type)
                filePaths = append(filePaths, fd.path)
            fdi = fdi + 1

        # The struct table a proc's `local.field = expr` write checks against.
        let mut structFieldKeys = []
        let mut structFieldTypes = []
        let nsd = len(prog.structs)
        let mut sdi = 0
        loop sdi < nsd:
            let sdd = prog.structs[sdi]
            let nsf = len(sdd.fields)
            let mut sfj = 0
            loop sfj < nsf:
                structFieldKeys = append(structFieldKeys, sdd.name + "." + sdd.fields[sfj].name)
                let mut sft = sdd.fields[sfj].typeCore
                if sdd.fields[sfj].isList:
                    sft = "[" + sft + "]"
                structFieldTypes = append(structFieldTypes, sft)
                sfj = sfj + 1
            sdi = sdi + 1

        # Shared cells (buildShareds): known before any proc or daemon body.
        let mut sharedNames = []
        let mut sharedTypes = []
        let mut irShareds = []
        let nsh = len(prog.shareds)
        let mut shi = 0
        loop shi < nsh:
            let sh = prog.shareds[shi]
            let shq = "\"" + sh.name + "\""
            let prevAt = do lowerFindName(sharedNames, sh.name)
            if prevAt >= 0:
                let sf0 = do driverFailed(prog, "line " + sh.line + ": shared cell " + shq + " redeclared (first at line " + prog.shareds[prevAt].line + ")")
                return sf0
            let mut clash = sh.name in stateNames || sh.name in entityNames
            let mut spi = 0
            loop spi < len(prog.procs):
                if prog.procs[spi].name == sh.name:
                    clash = true
                spi = spi + 1
            if clash:
                let sf1 = do driverFailed(prog, "line " + sh.line + ": shared cell " + shq + " collides with a state cell, entity or proc of the same name")
                return sf1
            let prim = do driverIsPrimitive(sh.type)
            if !prim:
                let mut known = sh.type in enumNames
                let mut srk = 0
                loop srk < len(prog.records):
                    if prog.records[srk].name == sh.type:
                        known = true
                    srk = srk + 1
                let mut ssk = 0
                loop ssk < len(prog.structs):
                    if prog.structs[ssk].name == sh.type:
                        known = true
                    ssk = ssk + 1
                if !known:
                    let sf2 = do driverFailed(prog, "line " + sh.line + ": shared cell " + shq + " has unknown type \"" + sh.type + "\"")
                    return sf2
            sharedNames = append(sharedNames, sh.name)
            if sh.list:
                sharedTypes = append(sharedTypes, "array")
            else:
                sharedTypes = append(sharedTypes, sh.type)
            irShareds = append(irShareds, IRShared{name: sh.name, type: sh.type, list: sh.list})
            shi = shi + 1
        # daemon-context procs: lowered after the actions, with the daemons
        let dctx = do driverDaemonCtx(prog)
        let mut plStructNames = []
        let mut psn = 0
        loop psn < len(prog.structs):
            plStructNames = append(plStructNames, prog.structs[psn].name)
            psn = psn + 1
        let plctx = PLCtx{sharedNames: sharedNames, sharedTypes: sharedTypes, ctxProcs: dctx.procs, lineNos: [], structNames: plStructNames, ty: tyEnv}

        # Procs (name/paramCount/ret/retList env, then real lowering).
        let mut procNames = []
        let mut procRets = []
        let mut procRetLists = []
        let pcn = len(prog.procs)
        let mut pci = 0
        loop pci < pcn:
            procNames = append(procNames, prog.procs[pci].name)
            let mut rc = ""
            if prog.procs[pci].hasRet:
                rc = prog.procs[pci].retCore
            procRets = append(procRets, rc)
            procRetLists = append(procRetLists, prog.procs[pci].retIsList)
            pci = pci + 1
        let mut procs = []
        let mut pci2 = 0
        loop pci2 < pcn:
            let pd2 = prog.procs[pci2]
            let later = driverIsEntry(pd2) || pd2.name in dctx.procs
            if later:
                procs = append(procs, plEmptyProc())
            else:
                let mut pctx = plctx
                pctx.lineNos = pd2.bodyLineNos
                let lp = do plLowerProcX(pd2.name, pd2.headerLine, pd2.bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enumNames, pd2.renameFrom, pd2.renameTo, structFieldKeys, structFieldTypes, pctx, false, [], [], [])
                if lp.diag != "":
                    let pdiag = do driverCtxDiag(dctx, pd2.name, lp.diag)
                    let pf = do driverFailed(prog, pdiag)
                    return pf
                procs = append(procs, lp.proc)
            pci2 = pci2 + 1

        # Entity field env for action lowering: "Entity.field" / "Entity.derive".
        let mut entityFieldKeys = []
        let mut entityDeriveKeys = []
        let mut efi = 0
        loop efi < en2:
            let ent = prog.entities[efi]
            let fkn = len(ent.fields)
            let mut fki = 0
            loop fki < fkn:
                entityFieldKeys = append(entityFieldKeys, ent.name + "." + ent.fields[fki].name)
                fki = fki + 1
            let dkn = len(ent.derives)
            let mut dki = 0
            loop dki < dkn:
                entityDeriveKeys = append(entityDeriveKeys, ent.name + "." + ent.derives[dki].name)
                dki = dki + 1
            efi = efi + 1

        let mut e2eFieldKeys = []
        let mut e2i = 0
        loop e2i < en2:
            let ent2 = prog.entities[e2i]
            let nfe = len(ent2.fields)
            let mut fe = 0
            loop fe < nfe:
                if ent2.fields[fe].e2e:
                    e2eFieldKeys = append(e2eFieldKeys, ent2.name + "." + ent2.fields[fe].name)
                fe = fe + 1
            e2i = e2i + 1

        let mut structNames = []
        let mut stni = 0
        loop stni < sn2:
            structNames = append(structNames, prog.structs[stni].name)
            stni = stni + 1

        # ALowEnv for action lowering — state placements, entity/field/
        # derive sets, enums, policies, the same inline table, services,
        # procs, structs. Mirrors action_lower_test.go's alowEnvArgs, built
        # here directly from the Program instead of round-tripped through
        # a compiled Go graph.
        let mut privateStateNames = []
        let npst = len(allStates)
        let mut psti = 0
        loop psti < npst:
            if allStates[psti].placement == "private":
                privateStateNames = append(privateStateNames, allStates[psti].name)
            psti = psti + 1
        let mut statePlacements = []
        let mut stk = 0
        loop stk < stn:
            statePlacements = append(statePlacements, allStates[stk].placement)
            stk = stk + 1
        # ALowEnv.statePlacements expects "server"/"client" only (never
        # "infer"/"private" — see alowStatePlacement's callers); recompute
        # from the same rule driverStateIR uses.
        let mut alowPlacements = []
        let mut stk2 = 0
        loop stk2 < stn:
            let mut p = "server"
            if allStates[stk2].placement == "client":
                p = "client"
            alowPlacements = append(alowPlacements, p)
            stk2 = stk2 + 1

        let mut serviceEnvNames = []
        let mut serviceEnvOps = []
        let mut serviceEnvArgCounts = []
        let mut serviceEnvRets = []
        let mut serviceEnvRetLists = []
        let mut svi2 = 0
        loop svi2 < svn:
            let sv2 = prog.services[svi2]
            let opn2 = len(sv2.ops)
            let mut opi2 = 0
            loop opi2 < opn2:
                let op2 = sv2.ops[opi2]
                serviceEnvNames = append(serviceEnvNames, sv2.name)
                serviceEnvOps = append(serviceEnvOps, op2.name)
                serviceEnvArgCounts = append(serviceEnvArgCounts, len(op2.paramNames))
                serviceEnvRets = append(serviceEnvRets, op2.retCore)
                serviceEnvRetLists = append(serviceEnvRetLists, op2.retIsList)
                opi2 = opi2 + 1
            svi2 = svi2 + 1

        let mut procEnvParamCounts = []
        let mut pci3 = 0
        loop pci3 < pcn:
            procEnvParamCounts = append(procEnvParamCounts, len(prog.procs[pci3].paramNames))
            pci3 = pci3 + 1

        let env = ALowEnv{stateNames: stateNames, statePlacements: alowPlacements, entityNames: entityNames, entityFields: entityFieldKeys, entityDerives: entityDeriveKeys, enumNames: enumNames, policyNames: policyNames, policyParamCounts: policyParamCounts, inlineNames: lowCtx.inlineNames, inlineExprs: lowCtx.inlineExprs, serviceNames: serviceEnvNames, serviceOps: serviceEnvOps, serviceArgCounts: serviceEnvArgCounts, serviceRets: serviceEnvRets, serviceRetLists: serviceEnvRetLists, procNames: procNames, procParamCounts: procEnvParamCounts, procRets: procRets, procRetLists: procRetLists, structNames: structNames, renameFrom: [], renameTo: [], e2eFields: e2eFieldKeys, actionParams: [], wireTypes: wire.names, actionName: "", actionRet: "", recordNames: recordNames, low: lowCtx, privateStates: privateStateNames, ty: tyEnv, tsc: tyEmptyScope()}

        # Actions.
        let mut actions = []
        let an = len(prog.actions)
        let mut ai = 0
        loop ai < an:
            let ad = prog.actions[ai]
            let aenv = ALowEnv{stateNames: env.stateNames, statePlacements: env.statePlacements, entityNames: env.entityNames, entityFields: env.entityFields, entityDerives: env.entityDerives, enumNames: env.enumNames, policyNames: env.policyNames, policyParamCounts: env.policyParamCounts, inlineNames: env.inlineNames, inlineExprs: env.inlineExprs, serviceNames: env.serviceNames, serviceOps: env.serviceOps, serviceArgCounts: env.serviceArgCounts, serviceRets: env.serviceRets, serviceRetLists: env.serviceRetLists, procNames: env.procNames, procParamCounts: env.procParamCounts, procRets: env.procRets, procRetLists: env.procRetLists, structNames: env.structNames, renameFrom: ad.renameFrom, renameTo: ad.renameTo, e2eFields: env.e2eFields, actionParams: [], wireTypes: env.wireTypes, actionName: "", actionRet: "", recordNames: env.recordNames, low: env.low, privateStates: env.privateStates, ty: env.ty, tsc: env.tsc}
            if ad.retErr != "":
                let re = do driverFailed(prog, ad.retErr)
                return re
            let ira = do lowerActionSrcFull(ad.name, ad.paramNames, ad.paramTypes, ad.paramLists, ad.paramOptionals, ad.optimistic, ad.ret, ad.retList, ad.bodySrc, aenv)
            # lowerActionSrc's refusal is an unnamed action carrying the
            # diagnostic as its reason.
            if ira.name == "":
                let af = do driverFailed(prog, ira.reason)
                return af
            actions = append(actions, ira)
            ai = ai + 1
        if prog.hasAuth:
            let authActs = do driverAuthActions()
            let aan = len(authActs)
            let mut aai = 0
            loop aai < aan:
                actions = append(actions, authActs[aai])
                aai = aai + 1

        # Daemons (Build 4b′): each body lowered against the user actions'
        # signatures (auth's built-ins are injected after this pass).
        let mut sigNames = []
        let mut sigServer = []
        let mut sigCounts = []
        let mut sgi = 0
        loop sgi < an:
            sigNames = append(sigNames, actions[sgi].name)
            sigServer = append(sigServer, actions[sgi].placement == "server")
            sigCounts = append(sigCounts, len(actions[sgi].params))
            sgi = sgi + 1
        # the process entry point and the daemon-context procs: lowered as
        # daemon bodies are (listen/accept, detach and act allowed)
        let mut pcl = 0
        loop pcl < len(prog.procs):
            let pd3 = prog.procs[pcl]
            if driverIsEntry(pd3) || pd3.name in dctx.procs:
                let mut pctx3 = plctx
                pctx3.lineNos = pd3.bodyLineNos
                let lp3 = do plLowerProcX(pd3.name, pd3.headerLine, pd3.bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enumNames, pd3.renameFrom, pd3.renameTo, structFieldKeys, structFieldTypes, pctx3, true, sigNames, sigServer, sigCounts)
                if lp3.diag != "":
                    let pf3 = do driverFailed(prog, lp3.diag)
                    return pf3
                procs[pcl] = lp3.proc
            pcl = pcl + 1
        let mut daemons = []
        let mut daemonNames = []
        let ndm = len(prog.daemons)
        let mut dmi = 0
        loop dmi < ndm:
            let dd = prog.daemons[dmi]
            if dd.err != "":
                let fd = do driverFailed(prog, dd.err)
                return fd
            if dd.name in daemonNames:
                let fd2 = do driverFailed(prog, "daemon \"" + dd.name + "\" redeclared")
                return fd2
            daemonNames = append(daemonNames, dd.name)
            let mut dctx2 = plctx
            dctx2.lineNos = dd.bodyLineNos
            let ld = do plLowerDaemonX(dd.name, dd.uses, dd.bodySrc, procNames, procRets, procRetLists, fileNames, fileTypes, filePaths, enumNames, sigNames, sigServer, sigCounts, dd.renameFrom, dd.renameTo, structFieldKeys, structFieldTypes, dctx2)
            if ld.diag != "":
                let fd3 = do driverFailed(prog, ld.diag)
                return fd3
            daemons = append(daemons, IRDaemon{name: dd.name, every: dd.every, body: ld.body})
            dmi = dmi + 1

        # Declared routes (4d′/4d‴/4d″): api endpoints bound to their
        # actions (a client-placed target moves to the authority), the
        # contract route, the streams, and every emit checked against them.
        let mut clientStates = []
        let ncs = len(allStates)
        let mut csi = 0
        loop csi < ncs:
            if allStates[csi].placement == "client":
                clientStates = append(clientStates, allStates[csi].name)
            csi = csi + 1
        let routesB = do wBuildRoutes(actions, prog.rawDecls, clientStates, policyNames, policyParamCounts, wire.names, wire.messages, wire.types)
        if routesB.err != "":
            let rf = do driverFailed(prog, routesB.err)
            return rf
        actions = routesB.actions
        let mut litNames = do withActor(stateNames)
        litNames = do appendAllText(litNames, entityNames)
        litNames = do appendAllText(litNames, lowCtx.inlineNames)
        let rtd = do driverRouteDiag(prog, actions, litNames)
        if rtd != "":
            let rtf = do driverFailed(prog, rtd)
            return rtf

        # Jobs.
        let mut jobs = []
        let jn = len(prog.jobs)
        let mut ji = 0
        loop ji < jn:
            let jd = prog.jobs[ji]
            jobs = append(jobs, IRJob{name: jd.name, action: jd.action, every: jd.everySeconds, onStart: jd.onStart})
            ji = ji + 1

        # Webhooks.
        let mut webhooks = []
        let whn = len(prog.webhooks)
        let mut whi = 0
        loop whi < whn:
            let wh = prog.webhooks[whi]
            webhooks = append(webhooks, IRWebhook{path: wh.path, action: wh.action, secret: wh.secret})
            whi = whi + 1

        # Triggers.
        let mut triggers = []
        let trn = len(prog.triggers)
        let mut tri = 0
        loop tri < trn:
            let tr = prog.triggers[tri]
            triggers = append(triggers, IRTrigger{on: tr.onAction, action: tr.reactionAction})
            tri = tri + 1

        # Views -> pages (Build step 5), then the index flags the view
        # compiler accumulated (every field a `for`'s where compares or its
        # `by` orders on) stamped onto the entity fields.
        let mut ceFns = []
        let mut ceFnArities = []
        let ndv = len(builtDerives.derives)
        let mut dvi = 0
        loop dvi < ndv:
            if len(builtDerives.derives[dvi].params) > 0:
                ceFns = append(ceFns, builtDerives.derives[dvi].name)
                ceFnArities = append(ceFnArities, len(builtDerives.derives[dvi].params))
            dvi = dvi + 1
        let mut ceLists = []
        let mut ceJson = []
        let nce = len(allStates)
        let mut cei = 0
        loop cei < nce:
            if allStates[cei].isList:
                ceLists = append(ceLists, allStates[cei].name)
            else:
                if allStates[cei].typeCore == "json":
                    ceJson = append(ceJson, allStates[cei].name)
            cei = cei + 1
        let callEnv = CallEnv{fnNames: ceFns, fnArities: ceFnArities, procNames: procNames, procArities: procEnvParamCounts, procDerives: builtDerives.procDerives, listNames: ceLists, jsonNames: ceJson, deriveKeys: entityDeriveKeys, inAction: false, inDerive: false, inProc: false, ty: tyEnv, tsc: tyEmptyScope()}
        let venv = do driverViewEnv(prog, allStates, enumNames, entityNames, entities, alowPlacements, lowCtx, policyNames, policyParamCounts, callEnv)
        let mut vviews = composedViews
        let mut nvw = len(prog.views)
        if composed:
            nvw = 0
        let mut vwi = 0
        loop vwi < nvw:
            let ve = prog.views[vwi]
            let vv = do vpParseView(ve.header, ve.bodySrc)
            if ve.private && vv.err == "":
                vviews = append(vviews, VView{err: "", name: ve.name, path: vv.path, params: vv.params, layout: vv.layout, requires: vv.requires, titleSegs: vv.titleSegs, descSegs: vv.descSegs, root: vv.root, screen: false})
            else:
                vviews = append(vviews, vv)
            vwi = vwi + 1
        let mut vcomps = []
        let ncm = len(prog.components)
        let mut cmi = 0
        loop cmi < ncm:
            let vc = do vpParseComponent(prog.components[cmi].headerLine, prog.components[cmi].bodySrc)
            vcomps = append(vcomps, vc)
            cmi = cmi + 1
        let mut vlayouts = []
        let nlo = len(prog.layouts)
        let mut loi = 0
        loop loi < nlo:
            let vl = do vpParseLayout(prog.layouts[loi].headerLine, prog.layouts[loi].bodySrc)
            if vl.err != "":
                let lf = do driverFailed(prog, vl.err)
                return lf
            let lnames = do driverLayoutNames(vlayouts)
            if vl.name in lnames:
                let lf2 = do driverFailed(prog, "layout \"" + vl.name + "\" redeclared")
                return lf2
            vlayouts = append(vlayouts, vl)
            loi = loi + 1
        let builtComps = do vbBuildComponents(venv, vcomps)
        if builtComps.err != "":
            let cf = do driverFailed(prog, builtComps.err)
            return cf
        let built = do vbBuildPages(venv, vviews, vlayouts, builtComps)
        let noneVal = do jNone()
        if built.err != "":
            let failed = IRGraph{app: prog.name, auth: prog.hasAuth, entities: [], records: [], structs: [], enums: [], types: [], messages: [], states: [], derives: [], policies: [], actions: [], procs: [], jobs: [], daemons: [], shareds: [], components: [], services: [], files: [], webhooks: [], apis: [], contract: [], streams: [], triggers: [], theme: noneVal, themeDark: noneVal, themes: noneVal, css: "", assets: noneVal, routes: [], pages: [], bindings: [], view: [], depGraph: noneVal}
            return DriverOut{graph: failed, err: built.err}
        let stamped = do driverStampIndexes(entities, built.indexKeys, built.queriedKeys)
        if stamped.err != "":
            let failed2 = IRGraph{app: prog.name, auth: prog.hasAuth, entities: [], records: [], structs: [], enums: [], types: [], messages: [], states: [], derives: [], policies: [], actions: [], procs: [], jobs: [], daemons: [], shareds: [], components: [], services: [], files: [], webhooks: [], apis: [], contract: [], streams: [], triggers: [], theme: noneVal, themeDark: noneVal, themes: noneVal, css: "", assets: noneVal, routes: [], pages: [], bindings: [], view: [], depGraph: noneVal}
            return DriverOut{graph: failed2, err: stamped.err}
        let mut topView = []
        let mut topBindings = []
        if len(built.pages) > 0:
            topView = built.pages[0].view
            topBindings = built.pages[0].bindings
        let depGraph = do vbDepGraphJVal(built.pages)
        let themeBase = do driverThemeMap(prog, "base", "")
        let themeDark = do driverThemeMap(prog, "dark", "")
        let themesNamed = do driverNamedThemes(prog)
        let g = IRGraph{app: prog.name, auth: prog.hasAuth, entities: stamped.entities, records: records, structs: structs, enums: enums, types: wire.types, messages: wire.messages, states: states, derives: builtDerives.derives, policies: policies, actions: actions, procs: procs, jobs: jobs, daemons: daemons, shareds: irShareds, components: built.components, services: services, files: files, webhooks: webhooks, apis: routesB.apis, contract: routesB.contract, streams: routesB.streams, triggers: triggers, theme: themeBase, themeDark: themeDark, themes: themesNamed, css: prog.css, assets: noneVal, routes: built.routes, pages: built.pages, bindings: topBindings, view: topView, depGraph: depGraph}
        return DriverOut{graph: g, err: ""}

    proc driverEmptyOut(p: Program) -> DriverOut:
        let o = do driverFailed(p, "")
        return o

    proc driverLayoutNames(ls: [VLayout]) -> [text]:
        let mut out = []
        let n = len(ls)
        let mut i = 0
        loop i < n:
            out = append(out, ls[i].name)
            i = i + 1
        return out

    proc driverFailed(prog: Program, msg: text) -> DriverOut:
        let noneVal = do jNone()
        let g = IRGraph{app: prog.name, auth: prog.hasAuth, entities: [], records: [], structs: [], enums: [], types: [], messages: [], states: [], derives: [], policies: [], actions: [], procs: [], jobs: [], daemons: [], shareds: [], components: [], services: [], files: [], webhooks: [], apis: [], contract: [], streams: [], triggers: [], theme: noneVal, themeDark: noneVal, themes: noneVal, css: "", assets: noneVal, routes: [], pages: [], bindings: [], view: [], depGraph: noneVal}
        return DriverOut{graph: g, err: msg}

    proc driverStatesWithTheme(prog: Program) -> [StateDecl]:
        let mut hasAlt = false
        let nt = len(prog.themes)
        let mut ti = 0
        loop ti < nt:
            if prog.themes[ti].kind != "base":
                hasAlt = true
            ti = ti + 1
        let mut declared = false
        let ns = len(prog.states)
        let mut si = 0
        loop si < ns:
            if prog.states[si].name == "theme":
                declared = true
            si = si + 1
        if !hasAlt || declared:
            return prog.states
        let def = do emptyNode()
        return append(prog.states, StateDecl{name: "theme", typeCore: "text", isList: false, isOptional: false, placement: "client", hasDefault: false, defaultSrc: "", default: def, valid: true})

    # driverThemeMap: the base (`kind` "base") or dark token table as the
    # JVal ir_graph.fct spells — keys sorted as encoding/json sorts a map,
    # a repeated token keeping its last value.
    proc driverThemeMap(prog: Program, kind: text, name: text) -> JVal:
        let mut keys = []
        let mut vals = []
        let nt = len(prog.themes)
        let mut ti = 0
        loop ti < nt:
            let tb = prog.themes[ti]
            if tb.kind == kind && tb.name == name:
                let nv = len(tb.vars)
                let mut vi = 0
                loop vi < nv:
                    let at = do vbFind(keys, tb.vars[vi].name)
                    if at >= 0:
                        vals[at] = tb.vars[vi].value
                    else:
                        keys = append(keys, tb.vars[vi].name)
                        vals = append(vals, tb.vars[vi].value)
                    vi = vi + 1
            ti = ti + 1
        let sorted = do vbSortText(keys)
        let mut jv = []
        let n = len(sorted)
        let mut i = 0
        loop i < n:
            let at2 = do vbFind(keys, sorted[i])
            jv = append(jv, JVal{kind: "str", s: vals[at2], keys: [], vals: []})
            i = i + 1
        return JVal{kind: "obj", s: "", keys: sorted, vals: jv}

    proc driverNamedThemes(prog: Program) -> JVal:
        let mut names = []
        let nt = len(prog.themes)
        let mut ti = 0
        loop ti < nt:
            if prog.themes[ti].kind == "named":
                let a = do vbAddUnique(names, prog.themes[ti].name)
                names = a
            ti = ti + 1
        let sorted = do vbSortText(names)
        let mut jv = []
        let n = len(sorted)
        let mut i = 0
        loop i < n:
            let m = do driverThemeMap(prog, "named", sorted[i])
            jv = append(jv, m)
            i = i + 1
        return JVal{kind: "obj", s: "", keys: sorted, vals: jv}

    # driverViewEnv: the name/type tables viewCtx reads off Build's env, taken
    # from the Program and the already-lowered declarations.
    proc driverViewEnv(prog: Program, allStates: [StateDecl], enumNames: [text], entityNames: [text], entities: [IREntity], placements: [text], lowCtx: LowCtx, policyNames: [text], policyParamCounts: [int], calls: CallEnv) -> VEnv:
        let mut stateNames = []
        let mut stateClient = []
        let mut stateTypes = []
        let mut stateLists = []
        let mut privateNames = []
        let sn = len(allStates)
        let mut si = 0
        loop si < sn:
            let sd = allStates[si]
            stateNames = append(stateNames, sd.name)
            stateClient = append(stateClient, placements[si] == "client")
            stateTypes = append(stateTypes, sd.typeCore)
            stateLists = append(stateLists, sd.isList)
            if sd.placement == "private":
                privateNames = append(privateNames, sd.name)
            si = si + 1
        let mut fieldKeys = []
        let mut fieldTypes = []
        let mut e2eKeys = []
        let mut enumFieldKeys = []
        let mut enumFieldEnums = []
        let mut deriveKeys = []
        let en = len(prog.entities)
        let mut ei = 0
        loop ei < en:
            let ir = entities[ei]
            let nf = len(ir.fields)
            let mut fi = 0
            loop fi < nf:
                let f = ir.fields[fi]
                fieldKeys = append(fieldKeys, ir.name + "." + f.name)
                fieldTypes = append(fieldTypes, f.type)
                if f.e2e:
                    e2eKeys = append(e2eKeys, ir.name + "." + f.name)
                if f.enumName != "":
                    enumFieldKeys = append(enumFieldKeys, ir.name + "." + f.name)
                    enumFieldEnums = append(enumFieldEnums, f.enumName)
                fi = fi + 1
            let nd = len(prog.entities[ei].derives)
            let mut di = 0
            loop di < nd:
                deriveKeys = append(deriveKeys, ir.name + "." + prog.entities[ei].derives[di].name)
                di = di + 1
            ei = ei + 1
        let mut enumMemberKeys = []
        let nen = len(prog.enums)
        let mut ni = 0
        loop ni < nen:
            let ed = prog.enums[ni]
            let nv = len(ed.values)
            let mut vi = 0
            loop vi < nv:
                enumMemberKeys = append(enumMemberKeys, ed.name + "." + ed.values[vi].name)
                vi = vi + 1
            ni = ni + 1
        let mut actionNames = []
        let mut actionParamCounts = []
        let na = len(prog.actions)
        let mut ai = 0
        loop ai < na:
            actionNames = append(actionNames, prog.actions[ai].name)
            actionParamCounts = append(actionParamCounts, len(prog.actions[ai].paramNames))
            ai = ai + 1
        if prog.hasAuth:
            let authActs = do driverAuthActions()
            let nau = len(authActs)
            let mut au = 0
            loop au < nau:
                actionNames = append(actionNames, authActs[au].name)
                actionParamCounts = append(actionParamCounts, len(authActs[au].params))
                au = au + 1
        return VEnv{stateNames: stateNames, stateClient: stateClient, stateTypes: stateTypes, stateLists: stateLists, privateNames: privateNames, entityNames: entityNames, fieldKeys: fieldKeys, fieldTypes: fieldTypes, deriveKeys: deriveKeys, e2eKeys: e2eKeys, enumFieldKeys: enumFieldKeys, enumFieldEnums: enumFieldEnums, enumNames: enumNames, enumMemberKeys: enumMemberKeys, inlineNames: lowCtx.inlineNames, inlineExprs: lowCtx.inlineExprs, actionNames: actionNames, actionParamCounts: actionParamCounts, policyNames: policyNames, policyParamCounts: policyParamCounts, low: lowCtx, calls: calls}

    struct DriverStamped:
        entities: [IREntity]
        err: text

    # driverStampIndexes: Build's closing loop — an index flag on every field
    # the view compiler marked, and the @secret refusal for any field a
    # where/by read at all (an encrypted column cannot be filtered).
    proc driverStampIndexes(entities: [IREntity], indexKeys: [text], queriedKeys: [text]) -> DriverStamped:
        let mut out = []
        let n = len(entities)
        let mut i = 0
        loop i < n:
            let e = entities[i]
            let mut fields = []
            let nf = len(e.fields)
            let mut fi = 0
            loop fi < nf:
                let f = e.fields[fi]
                let key = e.name + "." + f.name
                if f.secret && (key in queriedKeys):
                    return DriverStamped{entities: [], err: "field \"" + f.name + "\" is @secret and cannot be used in a `where`, `by`, or relation; it is encrypted at rest"}
                let idx = f.index || (key in indexKeys)
                fields = append(fields, IRField{name: f.name, type: f.type, ref: f.ref, enumName: f.enumName, index: idx, secret: f.secret, e2e: f.e2e, password: f.password, readPolicy: f.readPolicy, optional: f.optional, unique: f.unique, required: f.required, hasMin: f.hasMin, min: f.min, hasMax: f.hasMax, max: f.max, matches: f.matches, onDelete: f.onDelete})
                fi = fi + 1
            out = append(out, IREntity{name: e.name, softDelete: e.softDelete, ephemeral: e.ephemeral, fields: fields, read: e.read, derives: e.derives})
            i = i + 1
        return DriverStamped{entities: out, err: ""}

    # driverBuildDerives: Go's step 3b — every derive parsed in full
    # (parameters, continuation lines), a redeclaration refused, then built
    # in dependency order (deriveOrder): a parameterized derive becomes a
    # function its callers expand (LowFn), a plain one joins the inline
    # table, each lowered through env.low against everything built so far.
    struct DriverDerivesResult:
        err: text
        derives: [IRDerive]
        ctx: LowCtx
        procDerives: [text]

    # driverTyEnv: the typed names exprtype.fct reads — build.go's
    # stateTypes/stateList, entFieldType (an enum field reads as text, a
    # soft-deleting entity has `archived`), records, wireFieldTypes (the
    # `type` declarations), procSigs, deriveFns (a parameterized derive's
    # declared type: a primitive, enum, entity or wire type) and inlineType
    # (a zero-argument derive's declared type text; a zero-argument policy
    # is a bool).
    proc driverTyEnv(prog: Program, wtypes: [WType], enumNames: [text], entityNames: [text]) -> TyEnv:
        let mut te = do tyEmptyEnv()
        let mut stateNames = []
        let mut stateTypes = []
        let ns = len(prog.states)
        let mut i = 0
        loop i < ns:
            stateNames = append(stateNames, prog.states[i].name)
            let mut lt = prog.states[i].typeCore
            if prog.states[i].isList:
                lt = "[" + lt + "]"
            stateTypes = append(stateTypes, lt)
            i = i + 1
        let mut fieldKeys = []
        let mut fieldTypes = []
        let ne = len(prog.entities)
        let mut e = 0
        loop e < ne:
            let ed = prog.entities[e]
            fieldKeys = append(fieldKeys, ed.name + ".id")
            fieldTypes = append(fieldTypes, "int")
            let nf = len(ed.fields)
            let mut f = 0
            loop f < nf:
                let mut ft = ed.fields[f].typeCore
                if ft in enumNames:
                    ft = "text"
                fieldKeys = append(fieldKeys, ed.name + "." + ed.fields[f].name)
                fieldTypes = append(fieldTypes, ft)
                f = f + 1
            if ed.softDelete:
                fieldKeys = append(fieldKeys, ed.name + ".archived")
                fieldTypes = append(fieldTypes, "bool")
            e = e + 1
        let mut recordNames = []
        let mut recKeys = []
        let mut recTypes = []
        let nr = len(prog.records)
        let mut r = 0
        loop r < nr:
            let rd = prog.records[r]
            recordNames = append(recordNames, rd.name)
            let nrf = len(rd.fields)
            let mut rf = 0
            loop rf < nrf:
                let mut rt = rd.fields[rf].typeCore
                if rd.fields[rf].isList:
                    rt = "[" + rt + "]"
                recKeys = append(recKeys, rd.name + "." + rd.fields[rf].name)
                recTypes = append(recTypes, rt)
                rf = rf + 1
            r = r + 1
        let mut wireNames = []
        let mut wireKeys = []
        let mut wireTypes = []
        let nw = len(wtypes)
        let mut w = 0
        loop w < nw:
            let wt = wtypes[w]
            wireNames = append(wireNames, wt.name)
            let nwf = len(wt.fields)
            let mut wf = 0
            loop wf < nwf:
                let mut wft = wt.fields[wf].type
                if wt.fields[wf].list:
                    wft = "[" + wft + "]"
                if wt.fields[wf].map || wt.fields[wf].depth > 0:
                    wft = "json"
                wireKeys = append(wireKeys, wt.name + "." + wt.fields[wf].name)
                wireTypes = append(wireTypes, wft)
                wf = wf + 1
            w = w + 1
        let mut procNames = []
        let mut procRets = []
        let npr = len(prog.procs)
        let mut p = 0
        loop p < npr:
            let pd = prog.procs[p]
            procNames = append(procNames, pd.name)
            let mut pr = ""
            if pd.hasRet:
                pr = pd.retCore
                if pd.retIsList:
                    pr = "[" + pr + "]"
            procRets = append(procRets, pr)
            p = p + 1
        let mut inlineNames = []
        let mut inlineTypes = []
        let npo = len(prog.policies)
        let mut po = 0
        loop po < npo:
            if len(prog.policies[po].paramNames) == 0:
                inlineNames = append(inlineNames, prog.policies[po].name)
                inlineTypes = append(inlineTypes, "bool")
            po = po + 1
        te = TyEnv{stateNames: stateNames, stateTypes: stateTypes, entityNames: entityNames, fieldKeys: fieldKeys, fieldTypes: fieldTypes, enumNames: enumNames, recordNames: recordNames, recFieldKeys: recKeys, recFieldTypes: recTypes, wireNames: wireNames, wireFieldKeys: wireKeys, wireFieldTypes: wireTypes, procNames: procNames, procRets: procRets, deriveNames: [], deriveRets: [], deriveParams: [], inlineNames: inlineNames, inlineTypes: inlineTypes}
        let mut deriveNames = []
        let mut deriveRets = []
        let mut deriveParams = []
        let nd = len(prog.derives)
        let mut d = 0
        loop d < nd:
            let wd = do wParseDerive(prog.derives[d].line, prog.derives[d].cont)
            if wd.err == "":
                if len(wd.params) > 0:
                    let rv = do tyParse(wd.type)
                    let mut ret = do tyDeclType(te, rv.core, rv.list)
                    if rv.core in wireNames:
                        ret = rv
                    deriveNames = append(deriveNames, wd.name)
                    let rl = do tyLabel(ret)
                    deriveRets = append(deriveRets, rl)
                    let mut enc = ""
                    let nq = len(wd.params)
                    let mut q = 0
                    loop q < nq:
                        if q > 0:
                            enc = enc + ","
                        let mut lf = "S"
                        if wd.params[q].list:
                            lf = "L"
                        enc = enc + wd.params[q].name + "|" + wd.params[q].type + "|" + lf
                        q = q + 1
                    deriveParams = append(deriveParams, enc)
                else:
                    inlineNames = append(inlineNames, wd.name)
                    inlineTypes = append(inlineTypes, wd.type)
            d = d + 1
        return TyEnv{stateNames: stateNames, stateTypes: stateTypes, entityNames: entityNames, fieldKeys: fieldKeys, fieldTypes: fieldTypes, enumNames: enumNames, recordNames: recordNames, recFieldKeys: recKeys, recFieldTypes: recTypes, wireNames: wireNames, wireFieldKeys: wireKeys, wireFieldTypes: wireTypes, procNames: procNames, procRets: procRets, deriveNames: deriveNames, deriveRets: deriveRets, deriveParams: deriveParams, inlineNames: inlineNames, inlineTypes: inlineTypes}

    proc driverBuildDerives(decls: [DeriveDeclFull], entityNames: [text], stateNames: [text], ctx0: LowCtx, procNames: [text]) -> DriverDerivesResult:
        let mut parsed = []
        let mut seen = []
        let n = len(decls)
        let mut i = 0
        loop i < n:
            let wd = do wParseDerive(decls[i].line, decls[i].cont)
            if wd.err != "":
                return DriverDerivesResult{err: wd.err, derives: [], ctx: ctx0, procDerives: []}
            if wd.name in seen:
                return DriverDerivesResult{err: "derive \"" + wd.name + "\" redeclared", derives: [], ctx: ctx0, procDerives: []}
            seen = append(seen, wd.name)
            parsed = append(parsed, wd)
            i = i + 1
        let ord = do wDeriveOrder(parsed)
        if ord.err != "":
            return DriverDerivesResult{err: ord.err, derives: [], ctx: ctx0, procDerives: []}
        let mut ctx = ctx0
        let mut out = []
        let mut procDerives = []
        let no = len(ord.order)
        let mut k = 0
        loop k < no:
            let d = parsed[ord.order[k]]
            if len(d.params) > 0:
                # a projection calling a proc (directly or through another
                # projection that does) is itself usable only in actions
                let cp = do callsAnyName(d.expr, procNames)
                let cd = do callsAnyName(d.expr, procDerives)
                let aob = do authorityOnlyBuiltins()
                let ca = do callsAnyName(d.expr, aob)
                if cp || cd || ca:
                    procDerives = append(procDerives, d.name)
            else:
                let pdg = do procCallDiag(d.expr, procNames, procDerives)
                if pdg != "":
                    return DriverDerivesResult{err: pdg, derives: [], ctx: ctx0, procDerives: []}
            let lowered = do lowFull(d.expr, ctx)
            let deps = do driverDepsOf(lowered, stateNames, entityNames)
            if len(d.params) > 0:
                let mut pnames = []
                let mut iparams = []
                let np = len(d.params)
                let mut pi = 0
                loop pi < np:
                    pnames = append(pnames, d.params[pi].name)
                    iparams = append(iparams, IRParam{name: d.params[pi].name, type: d.params[pi].type, optional: d.params[pi].optional, list: false})
                    pi = pi + 1
                out = append(out, IRDerive{name: d.name, params: iparams, type: d.type, expr: [lowered], deps: deps})
                ctx = LowCtx{inlineNames: ctx.inlineNames, inlineExprs: ctx.inlineExprs, enumNames: ctx.enumNames, fns: append(ctx.fns, LowFn{name: d.name, params: pnames, body: lowered, ret: d.type}), textFieldKeys: ctx.textFieldKeys, deriveKeys: ctx.deriveKeys, deriveExprs: ctx.deriveExprs, wireOptKeys: ctx.wireOptKeys, wireNullKeys: ctx.wireNullKeys}
            else:
                out = append(out, IRDerive{name: d.name, params: [], type: d.type, expr: [lowered], deps: deps})
                ctx = LowCtx{inlineNames: append(ctx.inlineNames, d.name), inlineExprs: append(ctx.inlineExprs, lowered), enumNames: ctx.enumNames, fns: ctx.fns, textFieldKeys: ctx.textFieldKeys, deriveKeys: ctx.deriveKeys, deriveExprs: ctx.deriveExprs, wireOptKeys: ctx.wireOptKeys, wireNullKeys: ctx.wireNullKeys}
            k = k + 1
        return DriverDerivesResult{err: "", derives: out, ctx: ctx, procDerives: procDerives}

    # ── the live driver: whole-source in, IR JSON out ───────────────────
    proc compileSrc(src: text) -> text:
        # compile.String: a snippet has no file to resolve imports or a
        # sibling stylesheet against.
        let imps = do driverImportsOf(src)
        if len(imps) > 0:
            return "{\"error\":\"import is only supported when compiling from a file (run `facet \u003ccommand\u003e \u003cfile.fct\u003e`)\"}"
        let p0 = do parseProgramSrc(src)
        let nr = len(p0.rawDecls)
        let mut ri = 0
        loop ri < nr:
            if p0.rawDecls[ri].kw == "cssfrom" && len(p0.parseErrors) == 0:
                return "{\"error\":\"css from \\\"...\\\" is only supported when compiling from a file (run `facet \u003ccommand\u003e \u003cfile.fct\u003e`)\"}"
            ri = ri + 1
        let out = do compileGraph(src)
        if out.err != "":
            let q = do jsonQuote(out.err)
            return "{\"error\":" + q + "}"
        let j = do irGraphJSON(out.graph)
        return j

    # ── imports: compile.File's collectModules + mergeInto ───────────────
    # A whole app is its entry file plus every file it imports, collected
    # depth-first (entry first, a shared module pulled in once, an import
    # cycle refused) and flat-merged into the entry's declarations in that
    # order. Files are read through the io.file capability, so every path
    # here is relative to the runtime's sandboxed data directory; `root` is
    # that directory's absolute path, which import resolution (Go's
    # filepath.Join + Abs) and private-name mangling (an FNV-32a of each
    # module's absolute path) both need.
    proc driverReadFile(path: text) -> text uses io.file:
        let src = readFile(path)
        return src

    proc driverImportsOf(src: text) -> [text]:
        let lines = split(src, "\n")
        let mut out = []
        let n = len(lines)
        let mut i = 0
        loop i < n:
            let raw = lines[i]
            let t = trim(raw)
            let isComment = do vpHasPrefix(t, "#")
            let indented = do vpHasPrefix(raw, " ")
            if t != "" && !isComment && !indented:
                let isImport = do vpHasPrefix(t, "import ")
                if !isImport:
                    break
                let q = trim(slice(t, 7, len(t)))
                let uq = do vpUnquote(q)
                out = append(out, uq)
            i = i + 1
        return out

    # driverCleanPath: filepath.Clean over a slash-separated absolute path.
    proc driverCleanPath(p: text) -> text:
        let parts = split(p, "/")
        let mut out = []
        let n = len(parts)
        let mut i = 0
        loop i < n:
            let seg = parts[i]
            if seg == "" || seg == ".":
                i = i + 1
                continue
            if seg == "..":
                if len(out) > 0:
                    let mut keep = []
                    let mut j = 0
                    loop j < len(out) - 1:
                        keep = append(keep, out[j])
                        j = j + 1
                    out = keep
                i = i + 1
                continue
            out = append(out, seg)
            i = i + 1
        let mut r = ""
        let m = len(out)
        let mut k = 0
        loop k < m:
            r = r + "/" + out[k]
            k = k + 1
        if r == "":
            return "/"
        return r

    proc driverDirOf(p: text) -> text:
        let i = do vpLastIndexOf(p, "/")
        if i <= 0:
            return "/"
        return slice(p, 0, i)

    proc driverBaseOf(p: text) -> text:
        let i = do vpLastIndexOf(p, "/")
        return slice(p, i + 1, len(p))

    # driverFNV32a: hash/fnv's 32-bit FNV-1a over the path's UTF-8 bytes,
    # spelled as fileSuffix spells it (%08x).
    proc driverFNV32a(s: text) -> text:
        let bs = textToBytes(s)
        let n = len(bs)
        let mut h = 2166136261
        let mut i = 0
        loop i < n:
            h = h ^ bs[i]
            h = (h * 16777619) % 4294967296
            i = i + 1
        let digits = "0123456789abcdef"
        let mut out = ""
        let mut k = 0
        loop k < 8:
            let d = h % 16
            out = charAt(digits, d) + out
            h = h / 16
            k = k + 1
        return out

    struct DriverModule:
        abs: text
        src: text

    struct DriverCollect:
        mods: [DriverModule]
        visited: [text]
        err: text

    proc driverCollect(root: text, abs: text, visited0: [text], stack: [text]) -> DriverCollect:
        if abs in stack:
            let b = do driverBaseOf(abs)
            return DriverCollect{mods: [], visited: visited0, err: "import cycle through " + b}
        let pre = root + "/"
        let under = do vpHasPrefix(abs, pre)
        if !under:
            return DriverCollect{mods: [], visited: visited0, err: abs + " is outside the data directory " + root}
        let rel = slice(abs, len(pre), len(abs))
        let src = do driverReadFile(rel)
        let mut mods = [DriverModule{abs: abs, src: src}]
        let mut visited = visited0
        let imports = do driverImportsOf(src)
        let dir = do driverDirOf(abs)
        let n = len(imports)
        let mut i = 0
        loop i < n:
            let imp = imports[i]
            let isAbs = do vpHasPrefix(imp, "/")
            let mut joined = dir + "/" + imp
            if isAbs:
                joined = imp
            let impAbs = do driverCleanPath(joined)
            if impAbs in visited:
                i = i + 1
                continue
            visited = append(visited, impAbs)
            let sub = do driverCollect(root, impAbs, visited, append(stack, abs))
            if sub.err != "":
                return sub
            visited = sub.visited
            let m = len(sub.mods)
            let mut k = 0
            loop k < m:
                mods = append(mods, sub.mods[k])
                k = k + 1
            i = i + 1
        return DriverCollect{mods: mods, visited: visited, err: ""}

    # driverMerge: mergeInto — src's declarations after dst's own. Exactly
    # the kinds Go merges: webhooks/triggers/api/streams and the dark/named
    # palettes stay the entry file's own.
    # driverRouteCollisions: checkRouteCollisions — two modules declaring
    # one HTTP route (an api method+path, a stream path, a webhook path) or
    # a second contract, named with both files.
    proc driverRouteCollisions(mods: [Program], files: [text]) -> text:
        let mut keys = []
        let mut owners = []
        let n = len(mods)
        let mut i = 0
        loop i < n:
            let m = mods[i]
            let src = do driverBaseOf(files[i])
            let mut mine = []
            let mut lines = []
            let nr = len(m.rawDecls)
            let mut r = 0
            loop r < nr:
                let rd = m.rawDecls[r]
                if rd.kw == "api":
                    let ap = do wParseAPI(rd.header)
                    if ap.err == "":
                        mine = append(mine, "api " + ap.method + " " + ap.path)
                        lines = append(lines, rd.line)
                if rd.kw == "stream":
                    let st = do wParseStream(rd.header, rd.bodySrc)
                    if st.err == "":
                        mine = append(mine, "stream " + st.path)
                        lines = append(lines, rd.line)
                r = r + 1
            let nw = len(m.webhooks)
            let mut w = 0
            loop w < nw:
                mine = append(mine, "webhook " + m.webhooks[w].path)
                lines = append(lines, m.webhooks[w].line)
                w = w + 1
            let mut c = 0
            loop c < nr:
                if m.rawDecls[c].kw == "contract":
                    mine = append(mine, "contract")
                    lines = append(lines, m.rawDecls[c].line)
                c = c + 1
            let nm = len(mine)
            let mut k = 0
            loop k < nm:
                let at = do vbFind(keys, mine[k])
                if at >= 0:
                    let prev = split(owners[at], "\t")
                    if prev[0] != src:
                        return src + ":" + lines[k] + ": " + mine[k] + " is already declared in " + prev[0] + ":" + prev[1]
                else:
                    keys = append(keys, mine[k])
                    owners = append(owners, src + "\t" + lines[k])
                k = k + 1
            i = i + 1
        return ""

    private proc driverDupIn(kind: text, names: [text]) -> text:
        let mut seen = []
        let n = len(names)
        let mut i = 0
        loop i < n:
            if names[i] in seen:
                return kind + " \"" + names[i] + "\" is declared more than once (check your imported modules)"
            seen = append(seen, names[i])
            i = i + 1
        return ""

    private proc driverDeclName(line: text, kw: text) -> text:
        let r0 = do vpTrimPrefix(trim(line), kw)
        let r = trim(r0)
        let cs = split(r, "")
        let mut out = ""
        let n = len(cs)
        let mut i = 0
        loop i < n:
            let c = cs[i]
            if c == "(" || c == ":" || c == " " || c == "\t":
                break
            out = out + c
            i = i + 1
        return out

    # driverCheckDuplicates: checkDuplicates — the first name declared twice
    # within a kind across the merged graph.
    proc driverCheckDuplicates(p: Program) -> text:
        let mut a = []
        let n1 = len(p.entities)
        let mut i1 = 0
        loop i1 < n1:
            a = append(a, p.entities[i1].name)
            i1 = i1 + 1
        let e1 = do driverDupIn("entity", a)
        if e1 != "":
            return e1
        let mut b = []
        let n2 = len(p.records)
        let mut i2 = 0
        loop i2 < n2:
            b = append(b, p.records[i2].name)
            i2 = i2 + 1
        let e2 = do driverDupIn("record", b)
        if e2 != "":
            return e2
        let mut c = []
        let n3 = len(p.structs)
        let mut i3 = 0
        loop i3 < n3:
            c = append(c, p.structs[i3].name)
            i3 = i3 + 1
        let e3 = do driverDupIn("struct", c)
        if e3 != "":
            return e3
        let mut d = []
        let n4 = len(p.enums)
        let mut i4 = 0
        loop i4 < n4:
            d = append(d, p.enums[i4].name)
            i4 = i4 + 1
        let e4 = do driverDupIn("enum", d)
        if e4 != "":
            return e4
        let mut e = []
        let n5 = len(p.states)
        let mut i5 = 0
        loop i5 < n5:
            e = append(e, p.states[i5].name)
            i5 = i5 + 1
        let e5 = do driverDupIn("state", e)
        if e5 != "":
            return e5
        let mut f = []
        let n6 = len(p.derives)
        let mut i6 = 0
        loop i6 < n6:
            let dn = do driverDeclName(p.derives[i6].line, "derive")
            f = append(f, dn)
            i6 = i6 + 1
        let e6 = do driverDupIn("derive", f)
        if e6 != "":
            return e6
        let mut g = []
        let n7 = len(p.policies)
        let mut i7 = 0
        loop i7 < n7:
            g = append(g, p.policies[i7].name)
            i7 = i7 + 1
        let e7 = do driverDupIn("policy", g)
        if e7 != "":
            return e7
        let mut h = []
        let n8 = len(p.actions)
        let mut i8 = 0
        loop i8 < n8:
            h = append(h, p.actions[i8].name)
            i8 = i8 + 1
        let e8 = do driverDupIn("action", h)
        if e8 != "":
            return e8
        let mut pr = []
        let n9 = len(p.procs)
        let mut i9 = 0
        loop i9 < n9:
            pr = append(pr, p.procs[i9].name)
            i9 = i9 + 1
        let e9 = do driverDupIn("proc", pr)
        if e9 != "":
            return e9
        let mut jb = []
        let n10 = len(p.jobs)
        let mut i10 = 0
        loop i10 < n10:
            jb = append(jb, p.jobs[i10].name)
            i10 = i10 + 1
        let e10 = do driverDupIn("job", jb)
        if e10 != "":
            return e10
        let mut dm = []
        let n11 = len(p.daemons)
        let mut i11 = 0
        loop i11 < n11:
            dm = append(dm, p.daemons[i11].name)
            i11 = i11 + 1
        let e11 = do driverDupIn("daemon", dm)
        if e11 != "":
            return e11
        let mut cm = []
        let n12 = len(p.components)
        let mut i12 = 0
        loop i12 < n12:
            cm = append(cm, p.components[i12].header.name)
            i12 = i12 + 1
        let e12 = do driverDupIn("component", cm)
        if e12 != "":
            return e12
        let mut ly = []
        let n13 = len(p.layouts)
        let mut i13 = 0
        loop i13 < n13:
            let ln = do driverDeclName(p.layouts[i13].headerLine, "layout")
            ly = append(ly, ln)
            i13 = i13 + 1
        let e13 = do driverDupIn("layout", ly)
        if e13 != "":
            return e13
        let mut vw = []
        let n14 = len(p.views)
        let mut i14 = 0
        loop i14 < n14:
            vw = append(vw, p.views[i14].name)
            i14 = i14 + 1
        let e14 = do driverDupIn("view", vw)
        return e14

    proc driverMerge(dst: Program, src: Program) -> Program:
        let mut themes = dst.themes
        let nt = len(src.themes)
        let mut ti = 0
        loop ti < nt:
            if src.themes[ti].kind == "base":
                themes = append(themes, src.themes[ti])
            ti = ti + 1
        let mut css = dst.css
        if css == "":
            css = src.css
        else:
            if src.css != "":
                css = css + "\n" + src.css
        let entities = do driverCatEntities(dst.entities, src.entities)
        let records = do driverCatRecords(dst.records, src.records)
        let structs = do driverCatStructs(dst.structs, src.structs)
        let enums = do driverCatEnums(dst.enums, src.enums)
        let states = do driverCatStates(dst.states, src.states)
        let derives = do driverCatDerives(dst.derives, src.derives)
        let policies = do driverCatPolicies(dst.policies, src.policies)
        let actions = do driverCatActions(dst.actions, src.actions)
        let procs = do driverCatProcs(dst.procs, src.procs)
        let jobs = do driverCatJobs(dst.jobs, src.jobs)
        let daemons = do driverCatDaemons(dst.daemons, src.daemons)
        let components = do driverCatComponents(dst.components, src.components)
        let views = do driverCatViews(dst.views, src.views)
        let services = do driverCatServices(dst.services, src.services)
        # mergeInto carries types, messages and files across, and the HTTP
        # surface a module declares next to its domain — its api routes,
        # streams, webhooks, triggers and (the first) contract route.
        let mut dstHasContract = false
        let ndc = len(dst.rawDecls)
        let mut dci = 0
        loop dci < ndc:
            if dst.rawDecls[dci].kw == "contract":
                dstHasContract = true
            dci = dci + 1
        let mut rawDecls = dst.rawDecls
        let nrd = len(src.rawDecls)
        let mut rdi = 0
        loop rdi < nrd:
            let rk = src.rawDecls[rdi].kw
            if rk == "type" || rk == "message" || rk == "file" || rk == "api" || rk == "stream":
                rawDecls = append(rawDecls, src.rawDecls[rdi])
            if rk == "contract" && !dstHasContract:
                rawDecls = append(rawDecls, src.rawDecls[rdi])
            rdi = rdi + 1
        let mut webhooks = dst.webhooks
        let nwh = len(src.webhooks)
        let mut whi = 0
        loop whi < nwh:
            webhooks = append(webhooks, src.webhooks[whi])
            whi = whi + 1
        let mut triggers = dst.triggers
        let ntr = len(src.triggers)
        let mut tri = 0
        loop tri < ntr:
            triggers = append(triggers, src.triggers[tri])
            tri = tri + 1
        let mut layouts = dst.layouts
        let nly = len(src.layouts)
        let mut lyi = 0
        loop lyi < nly:
            layouts = append(layouts, src.layouts[lyi])
            lyi = lyi + 1
        let mut parseErrors = dst.parseErrors
        let npe = len(src.parseErrors)
        let mut pei = 0
        loop pei < npe:
            parseErrors = append(parseErrors, src.parseErrors[pei])
            pei = pei + 1
        return Program{name: dst.name, hasAuth: dst.hasAuth || src.hasAuth, entities: entities, records: records, structs: structs, enums: enums, states: states, derives: derives, policies: policies, procs: procs, actions: actions, webhooks: webhooks, jobs: jobs, services: services, components: components, triggers: triggers, views: views, themes: themes, css: css, daemons: daemons, privateProcs: [], parseErrors: parseErrors, layouts: layouts, rawDecls: rawDecls, kind: dst.kind, into: dst.into, mounts: dst.mounts, sockets: dst.sockets, hasFrame: dst.hasFrame, frameSrc: dst.frameSrc, hasContent: dst.hasContent, contentSrc: dst.contentSrc, unknownKeywords: dst.unknownKeywords, shareds: dst.shareds + src.shareds}

