import "runtime_json.fct"

app RuntimeCSS:
    # runtime_css.fct — the app stylesheet as runtime/server.go builds it
    # (Server.stylesheet): baseCSS, then themeCSS's `:root{--fa-…}` blocks
    # (the dark palette under the media query and again under
    # `[data-theme="dark"]`, named palettes in name order), then the
    # author's css with the one sequence that could close the element
    # neutralised (safeStyleBody). Its version is the first 12 hex digits
    # of the SHA-256 of the whole text.
    proc rtThemeVars(theme: JVal) -> text:
        # keys sorted (writeThemeVars sorts); a `}` in a value is dropped.
        let idx = do rtSortedIndex(theme.keys)
        let mut out = ""
        let mut i = 0
        loop i < len(idx):
            let k = theme.keys[idx[i]]
            let v = theme.vals[idx[i]].s
            out = out + "--fa-" + k + ":" + replace(v, "}", "") + ";"
            i = i + 1
        return out

    proc rtThemeCSS(theme: JVal, dark: JVal, named: JVal) -> text:
        if len(theme.keys) == 0 && len(dark.keys) == 0 && len(named.keys) == 0:
            return ""
        let mut out = ""
        if len(theme.keys) > 0:
            let tv = do rtThemeVars(theme)
            out = out + ":root{" + tv + "}"
        if len(dark.keys) > 0:
            let dv = do rtThemeVars(dark)
            out = out + "@media(prefers-color-scheme:dark){:root{" + dv + "}}"
            out = out + "[data-theme=\"dark\"]{" + dv + "}"
        if len(named.keys) > 0:
            let idx = do rtSortedIndex(named.keys)
            let mut i = 0
            loop i < len(idx):
                let nv = do rtThemeVars(named.vals[idx[i]])
                out = out + "[data-theme=\"" + named.keys[idx[i]] + "\"]{" + nv + "}"
                i = i + 1
        return out

    proc rtSafeStyleBody(css: text) -> text:
        if css == "":
            return ""
        let a = replace(css, "</style", "<\\/style")
        let b = replace(a, "</STYLE", "<\\/STYLE")
        return b

    # rtStylesheet: stylesheet — the runtime's own base stylesheet (base,
    # the Go build's assets/facet-base.css as its host hands it over, never a
    # copy kept here), the app's theme, its own CSS.
    proc rtStylesheet(g: IRGraph, base: text) -> text:
        let theme = do rtThemeCSS(g.theme, g.themeDark, g.themes)
        let author = do rtSafeStyleBody(g.css)
        return base + "\n" + theme + "\n" + author

    proc rtStylesheetVersion(css: text) -> text:
        let h = sha256Hex(css)
        return slice(h, 0, 12)

