import "fqtx.fct"
import "http_server.fct"
import "fabric_json.fct"

app FqHttpSelfHost:
    # fqhttp.fct — the HTTP/1.1 and extraction layer the self-hosted
    # facetql server (fqserver.fct) stands on: reading one request off a
    # connection (head, then a Content-Length or chunked body, under a body
    # limit), writing one response, and what axum's extractors do with a
    # request before a handler sees it — Path parameters percent-decoded,
    # Query strings decoded as serde_urlencoded decodes them, and a Json
    # body checked for its content type, parsed, and deserialized field by
    # field with serde's own error messages (a path prefix as
    # serde_path_to_error writes it, then `at line L column C`).

    # ── reading a request ──────────────────────────────────────────────
    # The transport is http_server.fct's (hyper's framing), read in two
    # steps as hyper hands a request to its service: the head, and then —
    # only when the handler asks for it, inside the request's timeout — the
    # body. axum's DefaultBodyLimit is not a gate in front of the router:
    # the request is routed, authenticated and rate limited first, and only
    # a handler that reads the body (the Json extractor) finds it too large
    # or waits on a slow one. A body nobody read is discarded after the
    # answer, as hyper drains it, so the connection can carry the next
    # request.
    struct HHead:
        state: int
        err: text
        req: HttpServerRequest
        framing: text
        length: int

    proc hHeadFail(state: int, err: text) -> HHead:
        let r = do httpServerRequestFailed(state, err)
        return HHead{state: state, err: err, req: r, framing: "none", length: 0}

    # hReadHead: the next request's head. state 1 = a request (req.rest is
    # what was read past the head); 0 = the peer closed between requests;
    # -1 = malformed. framing: "none" | "length" (length bytes) | "chunked".
    proc hReadHead(c: int, pending: [int]) -> HHead uses io.net.listen:
        let mut buf = pending
        let mut end = do httpFindHeadEnd(buf, 0)
        loop end < 0:
            if len(buf) > 65536:
                let f = do hHeadFail(-1, "request head too large")
                return f
            let chunk = readBytes(c, 65536)
            if len(chunk) == 0:
                if len(buf) == 0:
                    let f0 = do hHeadFail(0, "")
                    return f0
                let f1 = do hHeadFail(-1, "connection closed mid-request")
                return f1
            let mut scan = len(buf) - 3
            if scan < 0:
                scan = 0
            buf = buf + chunk
            end = do httpFindHeadEnd(buf, scan)
        let head = do httpServerParseHead(buf, end)
        if head.state != 1:
            return HHead{state: head.state, err: head.err, req: head, framing: "none", length: 0}
        let held = HttpServerRequest{state: 1, err: "", method: head.method, target: head.target, path: head.path, hasQuery: head.hasQuery, query: head.query, version: head.version, headers: head.headers, body: "", rest: httpBytesRange(buf, end, len(buf))}
        let te = lower(httpHeaderValue(head.headers, "transfer-encoding"))
        if contains(te, "chunked"):
            return HHead{state: 1, err: "", req: held, framing: "chunked", length: 0}
        let cl = do httpContentLength(head.headers)
        let mut lengths = []
        let mut h = 0
        loop h < len(head.headers):
            if head.headers[h].name == "content-length" && !(head.headers[h].value in lengths):
                lengths = append(lengths, head.headers[h].value)
            h = h + 1
        if cl == -2 || len(lengths) > 1:
            let f4 = do hHeadFail(-1, "invalid content-length")
            return f4
        if cl <= 0:
            return HHead{state: 1, err: "", req: held, framing: "none", length: 0}
        return HHead{state: 1, err: "", req: held, framing: "length", length: cl}

    # HBodyRead: state 1 = the body read (rest: what follows it); 2 = over
    # maxBody, unread (skip: body bytes to discard, those in rest first;
    # -1 when only reading a chunked body to its end would find it); 0 =
    # the peer closed first; -1 = a malformed chunked body; -3 = the
    # deadline passed.
    struct HBodyRead:
        state: int
        body: text
        rest: [int]
        skip: int

    # hDeadlineRead: readBytes within the deadline (a monoMs instant; < 0
    # none) — [] with timedOut when it passed.
    struct HTimedRead:
        bytes: [int]
        timedOut: bool

    proc hDeadlineRead(c: int, deadline: int) -> HTimedRead uses io.net.listen:
        if deadline >= 0:
            let left = deadline - monoMs()
            if left <= 0:
                return HTimedRead{bytes: [], timedOut: true}
            let mut ms = left
            if ms > 600000:
                ms = 600000
            let set = setTimeoutMs(c, ms)
        let chunk = readBytes(c, 65536)
        if len(chunk) == 0 && deadline >= 0 && monoMs() >= deadline:
            return HTimedRead{bytes: [], timedOut: true}
        return HTimedRead{bytes: chunk, timedOut: false}

    proc hReadBody(c: int, held: [int], framing: text, length: int, maxBody: int, deadline: int) -> HBodyRead uses io.net.listen:
        let mut buf = held
        if framing == "none":
            return HBodyRead{state: 1, body: "", rest: buf, skip: 0}
        if framing == "length":
            if length > maxBody:
                return HBodyRead{state: 2, body: "", rest: buf, skip: length}
            loop len(buf) < length:
                let r = do hDeadlineRead(c, deadline)
                if r.timedOut:
                    return HBodyRead{state: -3, body: "", rest: [], skip: 0}
                if len(r.bytes) == 0:
                    return HBodyRead{state: 0, body: "", rest: [], skip: 0}
                buf = buf + r.bytes
            return HBodyRead{state: 1, body: bytesToText(httpBytesRange(buf, 0, length)), rest: httpBytesRange(buf, length, len(buf)), skip: 0}
        loop true:
            let d = do httpServerDechunk(buf, 0, maxBody)
            if d.state == 1:
                return HBodyRead{state: 1, body: bytesToText(d.bytes), rest: httpBytesRange(buf, d.end, len(buf)), skip: 0}
            if d.state == -1:
                return HBodyRead{state: -1, body: "", rest: [], skip: 0}
            if d.state == -2:
                return HBodyRead{state: 2, body: "", rest: [], skip: -1}
            let r2 = do hDeadlineRead(c, deadline)
            if r2.timedOut:
                return HBodyRead{state: -3, body: "", rest: [], skip: 0}
            if len(r2.bytes) == 0:
                return HBodyRead{state: 0, body: "", rest: [], skip: 0}
            buf = buf + r2.bytes
        return HBodyRead{state: -1, body: "", rest: [], skip: 0}

    # hDiscardBody: the unread body of a request whose answer went out
    # without it, read and dropped (hyper's drain); ok false when the
    # connection cannot carry another request.
    struct HSkipped:
        ok: bool
        rest: [int]

    proc hDiscardBody(c: int, held: [int], framing: text, length: int) -> HSkipped uses io.net.listen:
        if framing == "none":
            return HSkipped{ok: true, rest: held}
        if framing == "chunked":
            let d = do hReadBody(c, held, "chunked", 0, 9223372036854775807, -1)
            return HSkipped{ok: d.state == 1, rest: d.rest}
        let sk = do hSkipBody(c, held, length)
        return sk

    # hSkipBody: discard `skip` body bytes (those in `held` first); what
    # follows them is the next request's start. ok false when the peer
    # closed first.
    proc hSkipBody(c: int, held: [int], skip: int) -> HSkipped uses io.net.listen:
        if len(held) >= skip:
            return HSkipped{ok: true, rest: httpBytesRange(held, skip, len(held))}
        let mut left = skip - len(held)
        loop left > 0:
            let chunk = readBytes(c, 65536)
            if len(chunk) == 0:
                return HSkipped{ok: false, rest: []}
            if len(chunk) > left:
                return HSkipped{ok: true, rest: httpBytesRange(chunk, left, len(chunk))}
            left = left - len(chunk)
        return HSkipped{ok: true, rest: []}

    proc hRange(bs: [int], from: int, to: int) -> [int]:
        let r = do httpBytesRange(bs, from, to)
        return r

    proc hIndexOf(s: text, c: text) -> int:
        let n = len(s)
        let mut i = 0
        loop i < n:
            if charAt(s, i) == c:
                return i
            i = i + 1
        return -1

    proc hHexValue(s: text) -> int:
        if s == "":
            return -1
        let bs = textToBytes(s)
        let n = len(bs)
        let mut v = 0
        let mut i = 0
        loop i < n:
            let d = do httpHexValue(bs[i])
            if d < 0:
                return -1
            v = v * 16 + d
            i = i + 1
        return v

    # ── responses ──────────────────────────────────────────────────────
    # hWriteResponse: http_server.fct's whole-response write with hyper's
    # framing rule for a status that has no body: a 204 (or 304) carries no
    # content-length and no body.
    proc hWriteResponse(c: int, method: text, r: HttpServerResponse, keepAlive: bool) -> bool uses io.net.listen:
        let bodyless = r.status == 204 || r.status == 304
        if !bodyless:
            let ok0 = do httpServerWriteResponse(c, method, r, keepAlive)
            return ok0
        let mut head = do httpServerHead(r.status, r.reason, r.headers)
        if !keepAlive:
            head = head + "connection: close\r\n"
        let ok = writeBytes(c, textToBytes(head + "\r\n"))
        return ok

    # hWriteChunk: one chunk of a streamed body, its size in upper-case hex
    # as hyper writes it (an empty piece writes nothing).
    proc hWriteChunk(c: int, data: [int]) -> bool uses io.net.listen:
        if len(data) == 0:
            return true
        let size = upper(httpServerHex(len(data)))
        let ok = writeBytes(c, textToBytes(size + "\r\n") + data + textToBytes("\r\n"))
        return ok

    # hRefuseMalformed: hyper's answer to a request it cannot parse — a
    # bare 400 — then the connection drained and closed.
    proc hRefuseMalformed(c: int) -> bool uses io.net.listen:
        let head = do httpServerHead(400, "", [HttpHeader{name: "connection", value: "close"}])
        let ok = writeBytes(c, textToBytes(head + "content-length: 0\r\n\r\n"))
        let closed = do httpServerLingerClose(c)
        return ok


    # A response is http_server.fct's HttpServerResponse; these are axum's
    # IntoResponse shapes.
    proc hText(status: int, body: text) -> HttpServerResponse:
        let r = do httpServerPlain(status, body)
        return r

    proc hJson(status: int, body: text) -> HttpServerResponse:
        return HttpServerResponse{status: status, reason: "", headers: [HttpHeader{name: "content-type", value: "application/json"}], body: body}

    proc hEmpty(status: int) -> HttpServerResponse:
        return HttpServerResponse{status: status, reason: "", headers: [], body: ""}

    proc hWithHeader(r: HttpServerResponse, name: text, value: text) -> HttpServerResponse:
        return HttpServerResponse{status: r.status, reason: r.reason, headers: append(r.headers, HttpHeader{name: name, value: value}), body: r.body}

    # ── Path and Query ─────────────────────────────────────────────────
    struct HDecoded:
        ok: bool
        text: text

    # hPercentDecode: percent-decoding as axum's Path does it; `plus`
    # additionally reads '+' as a space (form/query decoding).
    proc hPercentDecode(s: text, plus: bool) -> HDecoded:
        let bs = textToBytes(s)
        let n = len(bs)
        let mut out = []
        let mut i = 0
        loop i < n:
            let c = bs[i]
            if c == 37 && i + 2 < n:
                let h = do hHexValue(bytesToText(hRange(bs, i + 1, i + 3)))
                if h >= 0:
                    out = append(out, h)
                    i = i + 3
                    continue
            if c == 43 && plus:
                out = append(out, 32)
            else:
                out = append(out, c)
            i = i + 1
        let t = bytesToText(out)
        let back = textToBytes(t)
        if len(back) != len(out):
            return HDecoded{ok: false, text: ""}
        let mut k = 0
        loop k < len(out):
            if back[k] != out[k]:
                return HDecoded{ok: false, text: ""}
            k = k + 1
        return HDecoded{ok: true, text: t}

    # hQuery: serde_urlencoded's pairs (a later duplicate wins, as serde's
    # struct visitor does for a map).
    struct HQuery:
        names: [text]
        values: [text]

    proc hParseQuery(q: text) -> HQuery:
        let mut names = []
        let mut values = []
        if q == "":
            return HQuery{names: [], values: []}
        let parts = split(q, "&")
        let n = len(parts)
        let mut i = 0
        loop i < n:
            if parts[i] != "":
                let eq = do hIndexOf(parts[i], "=")
                let mut k = parts[i]
                let mut v = ""
                if eq >= 0:
                    k = slice(parts[i], 0, eq)
                    v = slice(parts[i], eq + 1, len(parts[i]))
                let dk = do hPercentDecode(k, true)
                let dv = do hPercentDecode(v, true)
                names = append(names, dk.text)
                values = append(values, dv.text)
            i = i + 1
        return HQuery{names: names, values: values}

    # hQueryDecode: axum's Query<T> — serde_urlencoded's pairs in order
    # into a struct whose fields are all Option<String> ("text") or
    # Option<usize>/Option<u64> ("uint"); unknown keys ignored, a repeated
    # field refused as serde's derive refuses it. err is the message after
    # "Failed to deserialize query string: ".
    struct HQueryV:
        ok: bool
        err: text
        has: [bool]
        texts: [text]
        ints: [int]

    proc hParseUint(v: text) -> HOptInt:
        if v == "":
            return HOptInt{ok: false, err: "cannot parse integer from empty string", has: false, v: 0}
        let bs = textToBytes(v)
        let mut start = 0
        if bs[0] == 43:
            start = 1
        if start == len(bs):
            return HOptInt{ok: false, err: "invalid digit found in string", has: false, v: 0}
        let mut k = start
        loop k < len(bs):
            if bs[k] < 48 || bs[k] > 57:
                return HOptInt{ok: false, err: "invalid digit found in string", has: false, v: 0}
            k = k + 1
        let digits = slice(v, start, len(v))
        let mut d = 0
        loop d < len(digits) - 1 && charAt(digits, d) == "0":
            d = d + 1
        let trimmed = slice(digits, d, len(digits))
        let fits = do fjDigitsLE(trimmed, "18446744073709551615")
        if !fits:
            return HOptInt{ok: false, err: "number too large to fit in target type", has: false, v: 0}
        let small = do fjDigitsLE(trimmed, "9223372036854775807")
        if !small:
            return HOptInt{ok: true, err: "", has: true, v: 9223372036854775807}
        return HOptInt{ok: true, err: "", has: true, v: toInt(trimmed)}

    struct HOptInt:
        ok: bool
        err: text
        has: bool
        v: int

    proc hQueryDecode(query: text, names: [text], kinds: [text]) -> HQueryV:
        let q = do hParseQuery(query)
        let nf = len(names)
        let mut has = []
        let mut texts = []
        let mut ints = []
        let mut z = 0
        loop z < nf:
            has = append(has, false)
            texts = append(texts, "")
            ints = append(ints, 0)
            z = z + 1
        let n = len(q.names)
        let mut i = 0
        loop i < n:
            let at = do fqwIndexOfText(names, q.names[i])
            if at >= 0:
                if has[at]:
                    return HQueryV{ok: false, err: "duplicate field `" + names[at] + "`", has: [], texts: [], ints: []}
                has[at] = true
                texts[at] = q.values[i]
                if kinds[at] == "uint":
                    let u = do hParseUint(q.values[i])
                    if !u.ok:
                        return HQueryV{ok: false, err: u.err, has: [], texts: [], ints: []}
                    ints[at] = u.v
            i = i + 1
        return HQueryV{ok: true, err: "", has: has, texts: texts, ints: ints}

    # ── Json bodies ────────────────────────────────────────────────────
    # axum's Json<T>: a JSON content type (415 otherwise), a body within
    # the limit (413), then serde_path_to_error::deserialize over
    # serde_json's Deserializer — fabric_json.fct's sjDecode, which is that
    # deserializer driven by a schema table the way serde's derives drive
    # it. A syntax/EOF failure is a 400, a data failure (wrong type,
    # missing/duplicate field, unknown variant) a 422; either names the
    # path serde_path_to_error tracked.
    struct HBody:
        ok: bool
        resp: HttpServerResponse
        v: SjV

    # hJsonPrecheck: Json's checks before it reads the body — a JSON
    # content type (415), then the body within the limit (413).
    proc hJsonPrecheck(req: HttpServerRequest, tooLarge: bool) -> HBody:
        let blank = do sjNull()
        let ct = lower(httpHeaderValue(req.headers, "content-type"))
        let mut mime = ct
        let semi = do hIndexOf(ct, ";")
        if semi >= 0:
            mime = trim(slice(ct, 0, semi))
        let isJson = mime == "application/json" || (hHasPrefixT(mime, "application/") && hHasSuffixT(mime, "+json"))
        if !isJson:
            let r = do hText(415, "Expected request with `Content-Type: application/json`")
            return HBody{ok: false, resp: r, v: blank}
        if tooLarge:
            let r1 = do hText(413, "Failed to buffer the request body: length limit exceeded")
            return HBody{ok: false, resp: r1, v: blank}
        return HBody{ok: true, resp: hEmpty(200), v: blank}

    proc hJsonBody(req: HttpServerRequest, tooLarge: bool, types: [SjType], name: text) -> HBody:
        let blank = do sjNull()
        let pre = do hJsonPrecheck(req, tooLarge)
        if !pre.ok:
            return pre
        # serde_path_to_error::deserialize, and no end(): what follows the
        # value is not looked at (axum's Json::from_bytes)
        let d = do sjDeAny(types, textToBytes(req.body), 0, name, 128)
        if !d.ok:
            let path = do sjPathText(d.path)
            let mut prefix = ""
            if path != "":
                prefix = path + ": "
            if d.cat == "data":
                let r2 = do hText(422, "Failed to deserialize the JSON body into the target type: " + prefix + d.err)
                return HBody{ok: false, resp: r2, v: blank}
            let r3 = do hText(400, "Failed to parse the request body as JSON: " + prefix + d.err)
            return HBody{ok: false, resp: r3, v: blank}
        return HBody{ok: true, resp: hEmpty(200), v: d.v}

    proc hHasPrefixT(s: text, p: text) -> bool:
        return len(s) >= len(p) && slice(s, 0, len(p)) == p

    proc hHasSuffixT(s: text, p: text) -> bool:
        return len(s) >= len(p) && slice(s, len(s) - len(p), len(s)) == p

    # hLineCol: serde_json's position_of_index — line 1-based, column the
    # bytes since the last newline.
    proc hLineCol(bs: [int], offset: int) -> text:
        let mut line = 1
        let mut col = 0
        let mut i = 0
        loop i < offset && i < len(bs):
            if bs[i] == 10:
                line = line + 1
                col = 0
            else:
                col = col + 1
            i = i + 1
        return "line " + line + " column " + col

    # ── the request schemas (routes.rs and schema/facetql_wire.fct) ────
    proc hTypes() -> [SjType]:
        let o = false
        let d = true
        return [sjOptionType("?bool", "bool"), sjOptionType("?string", "string"), sjOptionType("?usize", "usize"), sjOptionType("?f64", "f64"), sjOptionType("?value", "value"), sjOptionType("?Expr", "Expr"), sjOptionType("?values", "values"), sjOptionType("?exprs", "exprs"), sjVecType("strings", "string"), sjVecType("values", "value"), sjVecType("exprs", "Expr"), sjVecType("edgespecs", "EdgeSpec"), sjStructType("EdgeSpec", "struct EdgeSpec", ["to", "kind"], ["string", "string"], [o, o]), sjStructType("Expr", "struct Expr", ["kind", "val", "vtype", "name", "field", "obj", "key", "op", "args", "l", "r", "x", "var", "where"], ["string", "?value", "?string", "?string", "?string", "?Expr", "?Expr", "?string", "?exprs", "?Expr", "?Expr", "?Expr", "?string", "?Expr"], [o, d, d, d, d, d, d, d, d, d, d, d, d, d]), sjStructType("CreateNodeRequest", "struct CreateNodeRequest", ["address", "kind", "x", "y", "z", "q", "data", "public", "edges", "if_absent"], ["string", "string", "u8", "u8", "u8", "u8", "string", "?bool", "edgespecs", "bool"], [o, o, o, o, o, o, o, o, d, d]), sjStructType("UpdateNodeRequest", "struct UpdateNodeRequest", ["data", "public"], ["string", "?bool"], [o, d]), sjStructType("CreateEdgeRequest", "struct CreateEdgeRequest", ["from", "to", "kind"], ["string", "string", "string"], [o, o, o]), sjStructType("DeleteEdgeRequest", "struct DeleteEdgeRequest", ["from", "to", "kind"], ["string", "string", "string"], [o, o, o]), sjStructType("SequenceRequest", "struct SequenceRequest", ["count"], ["u64"], [d]), sjStructType("MultiGetRequest", "struct MultiGetRequest", ["addresses"], ["strings"], [o]), sjStructType("QueryWhereRequest", "struct QueryWhereRequest", ["kind", "owner", "where", "item_var", "order", "desc", "after", "limit", "offset"], ["?string", "?string", "?Expr", "string", "?string", "bool", "?string", "?usize", "?usize"], [o, o, o, d, o, d, o, o, o]), sjStructType("CountRequest", "struct CountRequest", ["kind", "owner", "where", "item_var"], ["?string", "?string", "?Expr", "string"], [o, o, o, d]), sjStructType("CountByRequest", "struct CountByRequest", ["kind", "owner", "where", "item_var", "group_by", "values"], ["?string", "?string", "?Expr", "string", "string", "?values"], [o, o, o, d, o, o]), sjStructType("AggregateRequest", "struct AggregateRequest", ["kind", "owner", "where", "item_var", "func", "field"], ["?string", "?string", "?Expr", "string", "string", "?string"], [o, o, o, d, o, o]), sjStructType("AggregateByRequest", "struct AggregateByRequest", ["kind", "owner", "where", "item_var", "group_by", "values", "func", "field"], ["?string", "?string", "?Expr", "string", "string", "?values", "string", "?string"], [o, o, o, d, o, o, o, o]), sjStructType("PublishRequest", "struct PublishRequest", ["payload"], ["string"], [o]), sjStructType("CreateUserRequest", "struct CreateUserRequest", ["owner", "role"], ["string", "?string"], [o, d]), sjStructType("CreateIndexRequest", "struct CreateIndexRequest", ["name", "kind", "field", "unique", "mode"], ["string", "string", "string", "bool", "?string"], [o, o, o, d, d]), sjStructType("CreateReferenceRequest", "struct CreateReferenceRequest", ["name", "kind", "field", "parent_kind", "parent_field", "on_delete"], ["string", "string", "string", "string", "?string", "ReferentialAction"], [o, o, o, o, d, o]), sjEnumType("ReferentialAction", "enum ReferentialAction", ["cascade", "restrict", "set_null"], ["", "", ""], ["unit", "unit", "unit"]), sjStructType("insert_node", "struct variant TxOpRequest::InsertNode", ["address", "kind", "x", "y", "z", "q", "data", "public", "owner", "claimed_by"], ["string", "string", "u8", "u8", "u8", "u8", "string", "?bool", "?string", "?string"], [o, o, o, o, o, o, o, o, o, o]), sjStructType("insert_edge", "struct variant TxOpRequest::InsertEdge", ["from", "to", "kind"], ["string", "string", "string"], [o, o, o]), sjStructType("delete_edge", "struct variant TxOpRequest::DeleteEdge", ["from", "to", "kind"], ["string", "string", "string"], [o, o, o]), sjStructType("delete_node", "struct variant TxOpRequest::DeleteNode", ["address"], ["string"], [o]), sjStructType("clear_kind", "struct variant TxOpRequest::ClearKind", ["kind"], ["string"], [o]), sjStructType("delete_where", "struct variant TxOpRequest::DeleteWhere", ["kind", "where"], ["string", "?Expr"], [o, o]), sjStructType("set_if", "struct variant TxOpRequest::SetIf", ["address", "field", "expect_le", "expect_eq", "expect_absent", "set"], ["string", "string", "?f64", "?value", "?bool", "value"], [o, o, o, o, o, d])]

    proc hTxVariants() -> [text]:
        return ["insert_node", "insert_edge", "delete_edge", "delete_node", "clear_kind", "delete_where", "set_if"]

    # ── an internally tagged enum: #[serde(tag = "type")] TxOpRequest ──
    # TransactionRequest { operations: Vec<TxOpRequest> } decoded as serde
    # does it, in one pass in document order (so a type error in one
    # operation is reported before a syntax error in a later one): the
    # struct and the Vec as fabric_json.fct decodes them, each operation
    # through serde's TaggedContentVisitor — its members buffered (a JSON
    # value's syntax checked where it stands, repeats kept) while the tag is
    # found and read as a variant identifier, then the variant deserialized
    # from the buffer. Tag errors are positioned where the tag is read; a
    # variant error, raised from the buffer, carries no position and takes
    # the reader's once it reaches the sequence (past end_seq). The sequence
    # form [tag, fields…] is taken too. A decoded operation is its
    # variant's struct value with the variant name in `s`.
    proc hTxVariantOf(bs: [int], i: int, variants: [text]) -> SjD:
        let t = do sjDeString(bs, i, "variant identifier")
        if !t.ok:
            return t
        if !(t.v.s in variants):
            let e = do sjErr(bs, t.i, "unknown variant `" + t.v.s + "`, " + sjOneOf(variants))
            return SjD{ok: false, err: e.err, posd: true, i: t.i, v: sjNull(), cat: "data", path: []}
        return t

    # hTxContent: the buffered variant — ContentDeserializer over the
    # members (or elements) read: its errors are data errors with no
    # position (the buffer has none).
    proc hTxContent(types: [SjType], text0: text, tag: text, i: int) -> SjD:
        let d = do sjDecode(types, text0, tag)
        if !d.ok:
            let mut msg = do hStripPosition(d.err)
            # serde's derive words a one-field struct "with 1 element";
            # fabric_json.fct's sjDeStruct always pluralises
            if hHasSuffixT(msg, " with 1 elements"):
                msg = slice(msg, 0, len(msg) - 1)
            return sjRaw(i, msg)
        let v = d.v
        return sjOk(i, SjV{kind: v.kind, b: v.b, s: tag, num: v.num, u: v.u, f: v.f, items: v.items, keys: v.keys})

    proc hDeTxOp(types: [SjType], bs: [int], i0: int, depth: int) -> SjD:
        let variants = do hTxVariants()
        let n = len(bs)
        let i = sjWs(bs, i0)
        if i >= n:
            return sjPeekErr(bs, i, "EOF while parsing a value")
        let c = bs[i]
        if c != 123 && c != 91:
            let u = do sjPeekInvalidType(bs, i, "internally tagged enum TxOpRequest")
            return u
        if depth - 1 == 0:
            return sjPeekErr(bs, i, "recursion limit exceeded")
        let mut k = i + 1
        let mut ret = sjOk(k, sjNull())
        let mut tag = ""
        let mut hasTag = false
        if c == 91:
            # visit_seq: the tag, then the rest as content
            let mut first = true
            let mut idx = 0
            let mut rest = []
            let mut done = false
            loop !done:
                let nx = sjNextElement(bs, k, first)
                first = false
                if !nx.ok:
                    ret = nx
                    k = nx.i
                    done = true
                else:
                    if nx.v.u < 0:
                        k = nx.i
                        done = true
                    else:
                        let mut el = sjOk(0, sjNull())
                        if idx == 0:
                            el = do hTxVariantOf(bs, nx.v.u, variants)
                        else:
                            el = do sjDeValue(bs, nx.v.u, depth - 1)
                        k = el.i
                        if !el.ok:
                            ret = sjUnder(el, "[" + idx + "]")
                            done = true
                        else:
                            if idx == 0:
                                tag = el.v.s
                                hasTag = true
                            else:
                                let st = sjWs(bs, nx.v.u)
                                rest = append(rest, bytesToText(httpBytesRange(bs, st, el.i)))
                            idx = idx + 1
            if ret.ok && !hasTag:
                ret = sjRaw(k, "missing field `type`")
            let closed = sjClose(bs, ret, sjEndSeq(bs, k))
            if !closed.ok:
                return closed
            let cs = do hTxContent(types, "[" + join(rest, ",") + "]", tag, closed.i)
            return cs
        # visit_map
        let mut first2 = true
        let mut done2 = false
        loop !done2:
            let w = sjWs(bs, k)
            if w >= n:
                ret = sjPeekErr(bs, w, "EOF while parsing an object")
                k = w
                done2 = true
            else:
                let mut p = w
                let mut stop = false
                if bs[w] == 125:
                    k = w
                    done2 = true
                    stop = true
                else:
                    if bs[w] == 44 && !first2:
                        p = sjWs(bs, w + 1)
                    else:
                        if first2:
                            first2 = false
                        else:
                            ret = sjPeekErr(bs, w, "expected `,` or `}`")
                            k = w
                            done2 = true
                            stop = true
                if !stop:
                    if p >= n:
                        ret = sjPeekErr(bs, p, "EOF while parsing a value")
                        k = p
                        done2 = true
                    else:
                        if bs[p] != 34:
                            let mut code = "key must be a string"
                            if bs[p] == 125:
                                code = "trailing comma"
                            ret = sjPeekErr(bs, p, code)
                            k = p
                            done2 = true
                        else:
                            let key = sjStr(bs, p + 1)
                            k = key.i
                            if !key.ok:
                                ret = key
                                done2 = true
                            else:
                                if key.v.s == "type" && hasTag:
                                    ret = sjRaw(k, "duplicate field `type`")
                                    done2 = true
                                else:
                                    let colon = sjParseColon(bs, k)
                                    k = colon.i
                                    if !colon.ok:
                                        ret = colon
                                        done2 = true
                                    else:
                                        let mut val = sjOk(k, sjNull())
                                        if key.v.s == "type":
                                            val = do hTxVariantOf(bs, k, variants)
                                        else:
                                            val = do sjDeValue(bs, k, depth - 1)
                                        k = val.i
                                        if !val.ok:
                                            ret = sjUnder(val, key.v.s)
                                            done2 = true
                                        else:
                                            if key.v.s == "type":
                                                tag = val.v.s
                                                hasTag = true
        if ret.ok && !hasTag:
            ret = sjRaw(k, "missing field `type`")
        let closed2 = sjClose(bs, ret, sjEndMap(bs, k))
        if !closed2.ok:
            return closed2
        let cs2 = do hTxContent(types, bytesToText(httpBytesRange(bs, i, closed2.i)), tag, closed2.i)
        return cs2

    # hDeTxOps: Vec<TxOpRequest>, as sjDeVec reads a Vec.
    proc hDeTxOps(types: [SjType], bs: [int], i0: int, depth: int) -> SjD:
        let n = len(bs)
        let i = sjWs(bs, i0)
        if i >= n:
            return sjPeekErr(bs, i, "EOF while parsing a value")
        if bs[i] != 91:
            let u = do sjPeekInvalidType(bs, i, "a sequence")
            return u
        if depth - 1 == 0:
            return sjPeekErr(bs, i, "recursion limit exceeded")
        let mut k = i + 1
        let mut items = []
        let mut first = true
        let mut idx = 0
        let mut ret = sjOk(k, sjNull())
        let mut done = false
        loop !done:
            let nx = sjNextElement(bs, k, first)
            first = false
            if !nx.ok:
                ret = nx
                k = nx.i
                done = true
            else:
                if nx.v.u < 0:
                    k = nx.i
                    done = true
                else:
                    let el = do hDeTxOp(types, bs, nx.v.u, depth - 1)
                    k = el.i
                    if !el.ok:
                        ret = sjUnder(el, "[" + idx + "]")
                        done = true
                    else:
                        items = append(items, el.v)
                        idx = idx + 1
        if ret.ok:
            ret = sjOk(k, SjV{kind: "arr", b: false, s: "", num: "", u: 0, f: 0.0, items: items, keys: []})
        return sjClose(bs, ret, sjEndSeq(bs, k))

    # hDeTransaction: the TransactionRequest struct — map or sequence form,
    # its one field `operations`.
    proc hDeTransaction(types: [SjType], bs: [int], i0: int, depth: int) -> SjD:
        let n = len(bs)
        let i = sjWs(bs, i0)
        if i >= n:
            return sjPeekErr(bs, i, "EOF while parsing a value")
        if (bs[i] == 91 || bs[i] == 123) && depth - 1 == 0:
            return sjPeekErr(bs, i, "recursion limit exceeded")
        let mut k = i + 1
        let mut ret = sjOk(k, sjNull())
        let mut ops = sjAbsent()
        let mut present = false
        if bs[i] == 91:
            let nx = sjNextElement(bs, k, true)
            if !nx.ok:
                ret = nx
                k = nx.i
            else:
                if nx.v.u < 0:
                    k = nx.i
                    ret = sjRaw(k, "invalid length 0, expected struct TransactionRequest with 1 element")
                else:
                    let el = do hDeTxOps(types, bs, nx.v.u, depth - 1)
                    k = el.i
                    if !el.ok:
                        ret = sjUnder(el, "[0]")
                    else:
                        ops = el.v
            if ret.ok:
                ret = sjOk(k, SjV{kind: "obj", b: false, s: "", num: "", u: 0, f: 0.0, items: [ops], keys: ["operations"]})
            return sjClose(bs, ret, sjEndSeq(bs, k))
        if bs[i] != 123:
            let u = do sjPeekInvalidType(bs, i, "struct TransactionRequest")
            return u
        let mut first = true
        let mut done = false
        loop !done:
            let w = sjWs(bs, k)
            if w >= n:
                ret = sjUnder(sjPeekErr(bs, w, "EOF while parsing an object"), "?")
                k = w
                done = true
            else:
                let mut p = w
                let mut stop = false
                if bs[w] == 125:
                    k = w
                    done = true
                    stop = true
                else:
                    if bs[w] == 44 && !first:
                        p = sjWs(bs, w + 1)
                    else:
                        if first:
                            first = false
                        else:
                            ret = sjUnder(sjPeekErr(bs, w, "expected `,` or `}`"), "?")
                            k = w
                            done = true
                            stop = true
                if !stop:
                    if p >= n:
                        ret = sjUnder(sjPeekErr(bs, p, "EOF while parsing a value"), "?")
                        k = p
                        done = true
                    else:
                        if bs[p] != 34:
                            let mut code = "key must be a string"
                            if bs[p] == 125:
                                code = "trailing comma"
                            ret = sjUnder(sjPeekErr(bs, p, code), "?")
                            k = p
                            done = true
                        else:
                            let key = sjStr(bs, p + 1)
                            k = key.i
                            if !key.ok:
                                ret = sjUnder(key, "?")
                                done = true
                            else:
                                let isOps = key.v.s == "operations"
                                if isOps && present:
                                    ret = sjRaw(k, "duplicate field `operations`")
                                    done = true
                                else:
                                    let colon = sjParseColon(bs, k)
                                    k = colon.i
                                    if !colon.ok:
                                        ret = colon
                                        done = true
                                    else:
                                        let mut val = sjOk(k, sjNull())
                                        if isOps:
                                            val = do hDeTxOps(types, bs, k, depth - 1)
                                        else:
                                            val = do sjIgnoreValue(bs, k)
                                        k = val.i
                                        if !val.ok:
                                            ret = sjUnder(val, key.v.s)
                                            done = true
                                        else:
                                            if isOps:
                                                ops = val.v
                                                present = true
        if ret.ok && !present:
            ret = sjRaw(k, "missing field `operations`")
        if ret.ok:
            ret = sjOk(k, SjV{kind: "obj", b: false, s: "", num: "", u: 0, f: 0.0, items: [ops], keys: ["operations"]})
        return sjClose(bs, ret, sjEndMap(bs, k))

    proc hStripPosition(err: text) -> text:
        let bs = textToBytes(err)
        let pat = textToBytes(" at line ")
        let mut i = len(bs) - len(pat)
        loop i >= 0:
            let mut j = 0
            loop j < len(pat) && bs[i + j] == pat[j]:
                j = j + 1
            if j == len(pat):
                return bytesToText(httpBytesRange(bs, 0, i))
            i = i - 1
        return err

    # hJsonTransaction: Json<TransactionRequest> — hJsonBody's checks, then
    # hDeTransaction and serde_json's end().
    proc hJsonTransaction(req: HttpServerRequest, tooLarge: bool, types: [SjType]) -> HBody:
        let pre = do hJsonPrecheck(req, tooLarge)
        let blank = do sjNull()
        if !pre.ok:
            return pre
        let bs = textToBytes(req.body)
        let d = do hDeTransaction(types, bs, 0, 128)
        let mut err = ""
        let mut cat = ""
        let mut path = ""
        if !d.ok:
            err = d.err
            cat = d.cat
            path = do sjPathText(d.path)
        if err == "":
            return HBody{ok: true, resp: hEmpty(200), v: d.v}
        let mut prefix = ""
        if path != "":
            prefix = path + ": "
        if cat == "data":
            let r = do hText(422, "Failed to deserialize the JSON body into the target type: " + prefix + err)
            return HBody{ok: false, resp: r, v: blank}
        let r2 = do hText(400, "Failed to parse the request body as JSON: " + prefix + err)
        return HBody{ok: false, resp: r2, v: blank}

    # ── reading a decoded value ────────────────────────────────────────
    # A decoded struct is an "obj" whose items follow the declared fields;
    # an absent Option or defaulted field is "absent".
    proc hItem(v: SjV, i: int) -> SjV:
        return v.items[i]

    proc hHas(v: SjV, i: int) -> bool:
        return v.items[i].kind != "absent"

    proc hStr(v: SjV, i: int) -> text:
        return v.items[i].s

    proc hStrOr(v: SjV, i: int, dflt: text) -> text:
        if v.items[i].kind == "absent":
            return dflt
        return v.items[i].s

    proc hBool(v: SjV, i: int) -> bool:
        return v.items[i].kind != "absent" && v.items[i].b

    proc hInt(v: SjV, i: int) -> int:
        return v.items[i].u

    # hFq: a decoded serde_json::Value as fqjson's FqJ.
    proc hFq(v: SjV) -> FqJ:
        if v.kind == "null" || v.kind == "absent":
            let n = do fjNull()
            return n
        if v.kind == "bool":
            return FqJ{kind: "bool", b: v.b, s: "", f: 0.0, items: [], keys: []}
        if v.kind == "str":
            return FqJ{kind: "str", b: false, s: v.s, f: 0.0, items: [], keys: []}
        if v.kind == "num":
            if v.num == "u64":
                let t = do sjU64Text(v.u)
                return FqJ{kind: "int", b: false, s: t, f: sjU64Float(v.u), items: [], keys: []}
            if v.num == "i64":
                return FqJ{kind: "int", b: false, s: "" + v.u, f: toFloat(v.u), items: [], keys: []}
            return FqJ{kind: "float", b: false, s: "", f: v.f, items: [], keys: []}
        let mut items = []
        let n2 = len(v.items)
        let mut i = 0
        loop i < n2:
            let c = do hFq(v.items[i])
            items = append(items, c)
            i = i + 1
        if v.kind == "arr":
            return FqJ{kind: "arr", b: false, s: "", f: 0.0, items: items, keys: []}
        return FqJ{kind: "obj", b: false, s: "", f: 0.0, items: items, keys: v.keys}

    # hExprFq: a decoded Expr struct back as the JSON object predicate.rs
    # would serialize — its present fields by name (fqquery evaluates the
    # predicate as that JSON).
    proc hExprFq(v: SjV) -> FqJ:
        let names = ["kind", "val", "vtype", "name", "field", "obj", "key", "op", "args", "l", "r", "x", "var", "where"]
        let mut keys = []
        let mut items = []
        let mut i = 0
        loop i < 14:
            let it = v.items[i]
            if it.kind != "absent":
                let mut c = do hFq(it)
                if i == 5 || i == 6 || i == 9 || i == 10 || i == 11 || i == 13:
                    c = do hExprFq(it)
                if i == 8:
                    let mut args = []
                    let na = len(it.items)
                    let mut j = 0
                    loop j < na:
                        let a = do hExprFq(it.items[j])
                        args = append(args, a)
                        j = j + 1
                    c = FqJ{kind: "arr", b: false, s: "", f: 0.0, items: args, keys: []}
                keys = append(keys, names[i])
                items = append(items, c)
            i = i + 1
        let sorted = do fjSortMembers(keys, items)
        return sorted

    state fqHttpOut: text = ""

    action runFqHttpNoop():
        fqHttpOut = "ok"

    view FqHttpHome at "/fqhttp":
        text "{fqHttpOut}"
