app HttpClientSelfHost:
    # http_client.fct — an HTTP/1.1 client written in fct over the runtime's
    # raw outbound TCP primitive (connect/readBytes/writeBytes/closeConn/
    # setTimeoutMs/connError, runtime/netconn.go). It is what a fabric
    # client that speaks a real wire contract needs and httpGet/httpPost
    # cannot give: any method, request headers, the response status and
    # headers, and a non-2xx answer as data rather than an abort.
    #
    # What it does, and what reqwest (the Rust clients' HTTP stack) does the
    # same way:
    #   * the URL is parsed as a WHATWG URL for the http/https schemes —
    #     the fragment dropped, the path's dot segments resolved and `\`
    #     read as `/`, the path and query percent-encoded with the URL
    #     standard's path and special-query sets — so a raw string reaches
    #     the wire exactly as `reqwest::Url` would send it;
    #   * `Host` carries the port unless it is the scheme's default;
    #   * a body is framed with Content-Length, and a request without one
    #     (a bodiless POST included) carries no length header at all;
    #   * a response is framed by Transfer-Encoding: chunked, else by
    #     Content-Length, else by the connection closing; 1xx interim
    #     responses are skipped; HEAD/204/304 have no body.
    # Each request is one connection (`connection: close`), so there is no
    # pool to go stale. The body is decoded as UTF-8, the way `.text()`
    # decodes a response without a charset.
    #
    # https is TLS through the runtime's connectTls (runtime/tlsconnect.go):
    # the certificate verified against the URL's host, over the system roots
    # plus, for the *Trust variants, a PEM file of extra trusted roots —
    # reqwest's add_root_certificate. A failed handshake (an untrusted
    # chain, a wrong name, a plain-http peer) is a transport failure like a
    # refused dial.
    #
    # Transport failures are values: `HttpResponse.ok` false with `err`
    # saying what happened (a refused dial, a deadline, a truncated
    # response) — never an abort of the calling proc.

    struct HttpHeader:
        name: text
        value: text

    struct HttpUrl:
        ok: bool
        err: text
        scheme: text
        host: text
        port: int
        # origin-form request target: the normalized path plus `?query`
        target: text

    struct HttpRequest:
        method: text
        url: text
        headers: [HttpHeader]
        body: text
        # per-operation deadline; 0 keeps the runtime's default bound
        timeoutMs: int

    struct HttpResponse:
        ok: bool
        err: text
        status: int
        reason: text
        headers: [HttpHeader]
        body: text

    proc httpFailure(msg: text) -> HttpResponse:
        return HttpResponse{ok: false, err: msg, status: 0, reason: "", headers: [], body: ""}

    # ── percent-encoding ───────────────────────────────────────────────
    proc httpHexUpper(d: int) -> text:
        return charAt("0123456789ABCDEF", d)

    proc httpPctByte(b: int) -> text:
        return "%" + httpHexUpper(b >> 4) + httpHexUpper(b & 15)

    proc httpIsAlnum(b: int) -> bool:
        return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)

    # httpPercentEncode: percent_encoding::utf8_percent_encode with
    # NON_ALPHANUMERIC — every byte but an ASCII letter or digit.
    proc httpPercentEncode(s: text) -> text:
        let bs = textToBytes(s)
        let n = len(bs)
        let mut out = ""
        let mut i = 0
        loop i < n:
            let b = bs[i]
            if httpIsAlnum(b):
                out = out + bytesToText([b])
            else:
                out = out + httpPctByte(b)
            i = i + 1
        return out

    # httpFormEncode: form_urlencoded::byte_serialize — what serde_urlencoded
    # (reqwest's `.query()`) writes for a key or a value: letters, digits and
    # `*-._` as is, a space as `+`, every other byte as %XX.
    proc httpFormEncode(s: text) -> text:
        let bs = textToBytes(s)
        let n = len(bs)
        let mut out = ""
        let mut i = 0
        loop i < n:
            let b = bs[i]
            if httpIsAlnum(b) || b == 42 || b == 45 || b == 46 || b == 95:
                out = out + bytesToText([b])
            else:
                if b == 32:
                    out = out + "+"
                else:
                    out = out + httpPctByte(b)
            i = i + 1
        return out

    # httpQueryString: `key=value&...` for reqwest's `.query(&pairs)`; ""
    # for no pairs, which reqwest turns into no `?` at all.
    proc httpQueryString(pairs: [HttpHeader]) -> text:
        let n = len(pairs)
        let mut out = ""
        let mut i = 0
        loop i < n:
            if i > 0:
                out = out + "&"
            out = out + httpFormEncode(pairs[i].name) + "=" + httpFormEncode(pairs[i].value)
            i = i + 1
        return out

    # The URL standard's percent-encode sets over one byte: C0 controls,
    # DEL and non-ASCII always; the path set adds space " # < > ? ` { };
    # the special-query set adds space " # < > '.
    proc httpInPathSet(b: int) -> bool:
        if b < 32 || b > 126:
            return true
        return b == 32 || b == 34 || b == 35 || b == 60 || b == 62 || b == 63 || b == 96 || b == 123 || b == 125

    proc httpInQuerySet(b: int) -> bool:
        if b < 32 || b > 126:
            return true
        return b == 32 || b == 34 || b == 35 || b == 60 || b == 62 || b == 39

    proc httpEncodeWith(bs: [int], from: int, to: int, path: bool) -> text:
        let mut out = ""
        let mut i = from
        loop i < to:
            let b = bs[i]
            let mut enc = false
            if path:
                enc = httpInPathSet(b)
            else:
                enc = httpInQuerySet(b)
            if enc:
                out = out + httpPctByte(b)
            else:
                out = out + bytesToText([b])
            i = i + 1
        return out

    proc httpIsSingleDot(seg: text) -> bool:
        let l = lower(seg)
        return l == "." || l == "%2e"

    proc httpIsDoubleDot(seg: text) -> bool:
        let l = lower(seg)
        return l == ".." || l == ".%2e" || l == "%2e." || l == "%2e%2e"

    # httpNormalizePath: the WHATWG path state for a special scheme over the
    # raw bytes between the authority and `?`/`#` — `\` is a separator,
    # each segment is percent-encoded with the path set, `.` segments drop
    # and `..` pops (a trailing one leaving the directory, `/`).
    proc httpNormalizePath(bs: [int], from: int, to: int) -> text:
        let mut segs = []
        let mut start = from
        if start < to && (bs[start] == 47 || bs[start] == 92):
            start = start + 1
        let mut i = start
        let mut segStart = start
        let mut done = false
        loop !done:
            let atEnd = i >= to
            let mut isSep = false
            if !atEnd:
                isSep = bs[i] == 47 || bs[i] == 92
            if atEnd || isSep:
                let seg = do httpEncodeWith(bs, segStart, i, true)
                if httpIsDoubleDot(seg):
                    if len(segs) > 0:
                        let mut kept = []
                        let mut k = 0
                        loop k < len(segs) - 1:
                            kept = append(kept, segs[k])
                            k = k + 1
                        segs = kept
                    if atEnd:
                        segs = append(segs, "")
                else:
                    if httpIsSingleDot(seg):
                        if atEnd:
                            segs = append(segs, "")
                    else:
                        segs = append(segs, seg)
                segStart = i + 1
                if atEnd:
                    done = true
            i = i + 1
        return "/" + join(segs, "/")

    # httpBytesRange: bs[from..to] as a new byte buffer.
    proc httpBytesRange(bs: [int], from: int, to: int) -> [int]:
        if to <= from:
            return []
        let mut out = bytes(to - from)
        let mut i = from
        loop i < to:
            out[i - from] = bs[i]
            i = i + 1
        return out

    proc httpFindByte(bs: [int], from: int, to: int, b: int) -> int:
        let mut i = from
        loop i < to:
            if bs[i] == b:
                return i
            i = i + 1
        return -1

    proc httpDigitsValue(s: text) -> int:
        let bs = textToBytes(s)
        let n = len(bs)
        if n == 0 || n > 5:
            return -1
        let mut v = 0
        let mut i = 0
        loop i < n:
            if bs[i] < 48 || bs[i] > 57:
                return -1
            v = v * 10 + (bs[i] - 48)
            i = i + 1
        return v

    # httpParseUrl: an absolute http(s) URL, as reqwest::Url parses it,
    # down to what an HTTP/1.1 request needs.
    proc httpParseUrl(url: text) -> HttpUrl:
        let bad = HttpUrl{ok: false, err: "", scheme: "", host: "", port: 0, target: ""}
        let raw = trim(url)
        let bs = textToBytes(raw)
        let n = len(bs)
        let colon = do httpFindByte(bs, 0, n, 58)
        if colon <= 0:
            return HttpUrl{ok: false, err: "relative URL without a base", scheme: "", host: "", port: 0, target: ""}
        let scheme = lower(bytesToText(httpBytesRange(bs, 0, colon)))
        if scheme != "http" && scheme != "https":
            return HttpUrl{ok: false, err: "URL scheme is not allowed: " + scheme, scheme: scheme, host: "", port: 0, target: ""}
        let mut p = colon + 1
        loop p < n && (bs[p] == 47 || bs[p] == 92):
            p = p + 1
        let mut hostEnd = p
        loop hostEnd < n && bs[hostEnd] != 47 && bs[hostEnd] != 92 && bs[hostEnd] != 63 && bs[hostEnd] != 35:
            hostEnd = hostEnd + 1
        let mut authStart = p
        let at = do httpFindByte(bs, p, hostEnd, 64)
        if at >= 0:
            authStart = at + 1
        let authority = bytesToText(httpBytesRange(bs, authStart, hostEnd))
        let mut host = authority
        let mut portText = ""
        if charAt(authority, 0) == "[":
            let close = do httpFindByte(textToBytes(authority), 0, len(authority), 93)
            if close < 0:
                return HttpUrl{ok: false, err: "invalid IPv6 address", scheme: scheme, host: "", port: 0, target: ""}
            host = slice(authority, 1, close)
            if close + 1 < len(authority):
                portText = slice(authority, close + 2, len(authority))
        else:
            let parts = split(authority, ":")
            host = lower(parts[0])
            if len(parts) > 1:
                portText = slice(authority, len(parts[0]) + 1, len(authority))
        if host == "":
            return HttpUrl{ok: false, err: "empty host", scheme: scheme, host: "", port: 0, target: ""}
        let mut port = 80
        if scheme == "https":
            port = 443
        if portText != "":
            let pv = do httpDigitsValue(portText)
            if pv < 0 || pv > 65535:
                return HttpUrl{ok: false, err: "invalid port number", scheme: scheme, host: host, port: 0, target: ""}
            port = pv
        let mut fragment = do httpFindByte(bs, hostEnd, n, 35)
        if fragment < 0:
            fragment = n
        let mut q = do httpFindByte(bs, hostEnd, fragment, 63)
        let mut pathEnd = fragment
        if q >= 0:
            pathEnd = q
        let path = do httpNormalizePath(bs, hostEnd, pathEnd)
        let mut target = path
        if q >= 0:
            let query = do httpEncodeWith(bs, q + 1, fragment, false)
            target = target + "?" + query
        return HttpUrl{ok: true, err: "", scheme: scheme, host: host, port: port, target: target}

    # ── request ────────────────────────────────────────────────────────
    proc httpHostHeader(u: HttpUrl) -> text:
        let mut host = u.host
        if contains(host, ":"):
            host = "[" + host + "]"
        if (u.scheme == "http" && u.port == 80) || (u.scheme == "https" && u.port == 443):
            return host
        return host + ":" + u.port

    # httpSerialize: the request's bytes on the wire.
    proc httpSerialize(req: HttpRequest, u: HttpUrl) -> [int]:
        let mut head = req.method + " " + u.target + " HTTP/1.1\r\nhost: " + httpHostHeader(u) + "\r\n"
        let n = len(req.headers)
        let mut i = 0
        loop i < n:
            head = head + req.headers[i].name + ": " + req.headers[i].value + "\r\n"
            i = i + 1
        let body = textToBytes(req.body)
        if len(body) > 0:
            head = head + "content-length: " + len(body) + "\r\n"
        head = head + "connection: close\r\n\r\n"
        return textToBytes(head) + body

    # ── response framing ──────────────────────────────────────────────
    struct HttpHead:
        # 0: incomplete, 1: parsed, -1: malformed (see err)
        state: int
        err: text
        status: int
        reason: text
        headers: [HttpHeader]
        bodyStart: int

    # httpFindHeadEnd: the index just past the first CRLFCRLF at or after
    # `from`, or -1.
    proc httpFindHeadEnd(bs: [int], from: int) -> int:
        let n = len(bs)
        let mut i = from
        if i < 0:
            i = 0
        loop i + 3 < n:
            if bs[i] == 13 && bs[i + 1] == 10 && bs[i + 2] == 13 && bs[i + 3] == 10:
                return i + 4
            i = i + 1
        return -1

    proc httpParseHead(bs: [int], from: int) -> HttpHead:
        let end = do httpFindHeadEnd(bs, from)
        if end < 0:
            return HttpHead{state: 0, err: "", status: 0, reason: "", headers: [], bodyStart: 0}
        let text0 = bytesToText(httpBytesRange(bs, from, end - 4))
        let lines = split(text0, "\r\n")
        let statusLine = lines[0]
        let sp = split(statusLine, " ")
        if len(sp) < 2 || slice(statusLine, 0, 5) != "HTTP/":
            return HttpHead{state: -1, err: "invalid HTTP status line: " + statusLine, status: 0, reason: "", headers: [], bodyStart: 0}
        let status = do httpDigitsValue(sp[1])
        if status < 100 || status > 999:
            return HttpHead{state: -1, err: "invalid HTTP status code: " + sp[1], status: 0, reason: "", headers: [], bodyStart: 0}
        let mut reason = ""
        let reasonAt = len(sp[0]) + 1 + len(sp[1]) + 1
        if reasonAt < len(statusLine):
            reason = slice(statusLine, reasonAt, len(statusLine))
        let mut headers = []
        let nl = len(lines)
        let mut i = 1
        loop i < nl:
            let line = lines[i]
            let parts = split(line, ":")
            if len(parts) < 2:
                return HttpHead{state: -1, err: "invalid HTTP header line: " + line, status: 0, reason: "", headers: [], bodyStart: 0}
            let name = lower(trim(parts[0]))
            let value = trim(slice(line, len(parts[0]) + 1, len(line)))
            headers = append(headers, HttpHeader{name: name, value: value})
            i = i + 1
        return HttpHead{state: 1, err: "", status: status, reason: reason, headers: headers, bodyStart: end}

    # httpHeaderValue: the first header of that name (ASCII case-
    # insensitive), or "" when absent.
    proc httpHeaderValue(headers: [HttpHeader], name: text) -> text:
        let want = lower(name)
        let n = len(headers)
        let mut i = 0
        loop i < n:
            if lower(headers[i].name) == want:
                return headers[i].value
            i = i + 1
        return ""

    proc httpHasHeader(headers: [HttpHeader], name: text) -> bool:
        let want = lower(name)
        let n = len(headers)
        let mut i = 0
        loop i < n:
            if lower(headers[i].name) == want:
                return true
            i = i + 1
        return false

    struct HttpBody:
        # 0: need more bytes, 1: complete, -1: malformed (see err)
        state: int
        err: text
        bytes: [int]

    proc httpHexValue(c: int) -> int:
        if c >= 48 && c <= 57:
            return c - 48
        if c >= 97 && c <= 102:
            return c - 87
        if c >= 65 && c <= 70:
            return c - 55
        return -1

    proc httpFindCrlf(bs: [int], from: int) -> int:
        let n = len(bs)
        let mut i = from
        loop i + 1 < n:
            if bs[i] == 13 && bs[i + 1] == 10:
                return i
            i = i + 1
        return -1

    # httpDechunk: a chunked body from `from`: each `size[;ext]CRLF data
    # CRLF`, ending at a zero size and the trailer section's empty line.
    proc httpDechunk(bs: [int], from: int) -> HttpBody:
        let mut out = []
        let mut p = from
        loop true:
            let lineEnd = do httpFindCrlf(bs, p)
            if lineEnd < 0:
                return HttpBody{state: 0, err: "", bytes: []}
            let mut size = 0
            let mut digits = 0
            let mut i = p
            let mut inExt = false
            loop i < lineEnd:
                let c = bs[i]
                if c == 59:
                    inExt = true
                if !inExt && c != 32 && c != 9:
                    let h = do httpHexValue(c)
                    if h < 0:
                        return HttpBody{state: -1, err: "invalid chunk size", bytes: []}
                    size = size * 16 + h
                    digits = digits + 1
                    if digits > 15:
                        return HttpBody{state: -1, err: "chunk size overflow", bytes: []}
                i = i + 1
            if digits == 0:
                return HttpBody{state: -1, err: "invalid chunk size", bytes: []}
            let dataStart = lineEnd + 2
            if size == 0:
                let mut t = dataStart
                loop true:
                    let te = do httpFindCrlf(bs, t)
                    if te < 0:
                        return HttpBody{state: 0, err: "", bytes: []}
                    if te == t:
                        return HttpBody{state: 1, err: "", bytes: out}
                    t = te + 2
            if dataStart + size + 2 > len(bs):
                return HttpBody{state: 0, err: "", bytes: []}
            out = out + httpBytesRange(bs, dataStart, dataStart + size)
            if bs[dataStart + size] != 13 || bs[dataStart + size + 1] != 10:
                return HttpBody{state: -1, err: "chunk not terminated by CRLF", bytes: []}
            p = dataStart + size + 2
        return HttpBody{state: -1, err: "unreachable", bytes: []}

    # httpContentLength: the Content-Length value, -1 when absent, -2 when
    # it is not a plain decimal.
    proc httpContentLength(headers: [HttpHeader]) -> int:
        if !httpHasHeader(headers, "content-length"):
            return -1
        let v = do httpHeaderValue(headers, "content-length")
        let bs = textToBytes(v)
        let n = len(bs)
        if n == 0 || n > 18:
            return -2
        let mut out = 0
        let mut i = 0
        loop i < n:
            if bs[i] < 48 || bs[i] > 57:
                return -2
            out = out * 10 + (bs[i] - 48)
            i = i + 1
        return out

    # httpFrameBody: the body of a response whose head was parsed, given
    # every byte read so far and whether the peer has closed.
    proc httpFrameBody(method: text, head: HttpHead, bs: [int], eof: bool) -> HttpBody:
        if method == "HEAD" || head.status == 204 || head.status == 304:
            return HttpBody{state: 1, err: "", bytes: []}
        let te = lower(httpHeaderValue(head.headers, "transfer-encoding"))
        if contains(te, "chunked"):
            let d = do httpDechunk(bs, head.bodyStart)
            if d.state == 0 && eof:
                return HttpBody{state: -1, err: "connection closed before the chunked body was complete", bytes: []}
            return d
        let cl = do httpContentLength(head.headers)
        if cl == -2:
            return HttpBody{state: -1, err: "invalid content-length", bytes: []}
        if cl >= 0:
            if len(bs) - head.bodyStart >= cl:
                return HttpBody{state: 1, err: "", bytes: httpBytesRange(bs, head.bodyStart, head.bodyStart + cl)}
            if eof:
                return HttpBody{state: -1, err: "connection closed before the body was complete (" + (len(bs) - head.bodyStart) + " of " + cl + " bytes)", bytes: []}
            return HttpBody{state: 0, err: "", bytes: []}
        if eof:
            return HttpBody{state: 1, err: "", bytes: httpBytesRange(bs, head.bodyStart, len(bs))}
        return HttpBody{state: 0, err: "", bytes: []}

    # ── the exchange ──────────────────────────────────────────────────
    # httpExchange: send one request and read its whole response. A
    # non-2xx status is a response like any other; only a transport
    # failure answers ok: false.
    proc httpExchange(req: HttpRequest) -> HttpResponse uses io.net:
        let r = do httpExchangeTrust(req, "")
        return r

    # httpDial: the connection a URL asks for — TLS for https.
    proc httpDial(u: HttpUrl, trustFile: text) -> int uses io.net:
        if u.scheme == "https":
            let t = connectTls(u.host, u.port, "", trustFile)
            return t
        let c = connect(u.host, u.port)
        return c

    # httpExchangeTrust: httpExchange, trusting the roots in trustFile (a
    # PEM file in the data sandbox) as well as the system's for https.
    proc httpExchangeTrust(req: HttpRequest, trustFile: text) -> HttpResponse uses io.net:
        let u = do httpParseUrl(req.url)
        if !u.ok:
            let f = do httpFailure("builder error: " + u.err)
            return f
        let c = do httpDial(u, trustFile)
        if req.timeoutMs > 0:
            let set = setTimeoutMs(c, req.timeoutMs)
        let wire = do httpSerialize(req, u)
        let wrote = writeBytes(c, wire)
        if !wrote:
            let e = connError(c)
            let closed = closeConn(c)
            let f = do httpFailure(e)
            return f
        let mut buf = []
        let mut eof = false
        let mut headFrom = 0
        let mut scanFrom = 0
        let mut have = false
        let mut head = HttpHead{state: 0, err: "", status: 0, reason: "", headers: [], bodyStart: 0}
        let mut result = HttpResponse{ok: false, err: "", status: 0, reason: "", headers: [], body: ""}
        let mut done = false
        loop !done:
            let chunk = readBytes(c, 65536)
            if len(chunk) == 0:
                eof = true
            else:
                buf = buf + chunk
            let mut again = true
            loop again && !done:
                again = false
                if !have:
                    let end = do httpFindHeadEnd(buf, scanFrom)
                    if end >= 0:
                        head = do httpParseHead(buf, headFrom)
                        if head.state == -1:
                            result = do httpFailure(head.err)
                            done = true
                        else:
                            if head.status >= 100 && head.status < 200 && head.status != 101:
                                headFrom = head.bodyStart
                                scanFrom = head.bodyStart
                                again = true
                            else:
                                have = true
                    else:
                        let s = len(buf) - 3
                        if s > scanFrom:
                            scanFrom = s
                if have && !done:
                    let body = do httpFrameBody(req.method, head, buf, eof)
                    if body.state == 1:
                        result = HttpResponse{ok: true, err: "", status: head.status, reason: head.reason, headers: head.headers, body: bytesToText(body.bytes)}
                        done = true
                    if body.state == -1:
                        result = do httpFailure(body.err)
                        done = true
            if eof && !done:
                let e = connError(c)
                if e != "":
                    result = do httpFailure(e)
                else:
                    result = do httpFailure("connection closed before a complete response was received")
                done = true
        let closed = closeConn(c)
        return result

    # ── streaming: a response read as it arrives ───────────────────────
    # For a body that is not meant to end (an SSE subscription): the head is
    # read up front, then the caller pumps whatever has arrived since —
    # between its own other requests — with pollBytes, never blocking on a
    # peer that has nothing to say. `data` is de-framed body bytes the
    # caller has not consumed yet; `raw` is received bytes still inside
    # their framing (a partial chunk). `ended` with `endErr` "" is a clean
    # end of body or close; otherwise endErr names the failure.
    struct HttpStream:
        ok: bool
        err: text
        conn: int
        status: int
        reason: text
        headers: [HttpHeader]
        chunked: bool
        remaining: int
        raw: [int]
        data: [int]
        ended: bool
        endErr: text

    proc httpStreamFailed(msg: text) -> HttpStream:
        return HttpStream{ok: false, err: msg, conn: -1, status: 0, reason: "", headers: [], chunked: false, remaining: -1, raw: [], data: [], ended: true, endErr: msg}

    # httpOpenStream: send the request and read its head. A non-2xx answer
    # is read whole (its body in `data`, ended) — it is an error reply, not
    # a stream.
    proc httpOpenStream(req: HttpRequest) -> HttpStream uses io.net:
        let s = do httpOpenStreamTrust(req, "")
        return s

    proc httpOpenStreamTrust(req: HttpRequest, trustFile: text) -> HttpStream uses io.net:
        let u = do httpParseUrl(req.url)
        if !u.ok:
            let f = do httpStreamFailed("builder error: " + u.err)
            return f
        let c = do httpDial(u, trustFile)
        if req.timeoutMs > 0:
            let set = setTimeoutMs(c, req.timeoutMs)
        let wrote = writeBytes(c, httpSerialize(req, u))
        if !wrote:
            let e = connError(c)
            let closed = closeConn(c)
            let f = do httpStreamFailed(e)
            return f
        let mut buf = []
        let mut eof = false
        let mut from = 0
        let mut done = false
        let mut head = HttpHead{state: 0, err: "", status: 0, reason: "", headers: [], bodyStart: 0}
        loop !done:
            let got = do httpParseHead(buf, from)
            if got.state == 1 && got.status >= 100 && got.status < 200 && got.status != 101:
                from = got.bodyStart
            else:
                if got.state != 0:
                    head = got
                    done = true
                else:
                    if eof:
                        done = true
                    else:
                        let chunk = readBytes(c, 65536)
                        if len(chunk) == 0:
                            eof = true
                        else:
                            buf = buf + chunk
        if head.state != 1:
            let e = connError(c)
            let closed = closeConn(c)
            let mut msg = head.err
            if msg == "":
                msg = e
            if msg == "":
                msg = "connection closed before a complete response was received"
            let f = do httpStreamFailed(msg)
            return f
        let te = lower(httpHeaderValue(head.headers, "transfer-encoding"))
        let cl = do httpContentLength(head.headers)
        let rest = do httpBytesRange(buf, head.bodyStart, len(buf))
        let s0 = HttpStream{ok: true, err: "", conn: c, status: head.status, reason: head.reason, headers: head.headers, chunked: contains(te, "chunked"), remaining: cl, raw: rest, data: [], ended: false, endErr: ""}
        let s1 = do httpStreamDeframe(s0)
        if head.status >= 200 && head.status < 300:
            return s1
        # An error reply: read it to its end, as a whole response.
        let mut s2 = s1
        loop !s2.ended:
            let chunk = readBytes(c, 65536)
            if len(chunk) == 0:
                s2 = httpStreamEnd(s2, connError(c))
            else:
                s2 = httpStreamDeframe(httpStreamWithRaw(s2, s2.raw + chunk))
        return s2

    proc httpStreamWithRaw(s: HttpStream, raw: [int]) -> HttpStream:
        return HttpStream{ok: s.ok, err: s.err, conn: s.conn, status: s.status, reason: s.reason, headers: s.headers, chunked: s.chunked, remaining: s.remaining, raw: raw, data: s.data, ended: s.ended, endErr: s.endErr}

    # httpStreamWithData: the stream with `data` replaced — how a caller
    # hands back what it did not consume.
    proc httpStreamWithData(s: HttpStream, data: [int]) -> HttpStream:
        return HttpStream{ok: s.ok, err: s.err, conn: s.conn, status: s.status, reason: s.reason, headers: s.headers, chunked: s.chunked, remaining: s.remaining, raw: s.raw, data: data, ended: s.ended, endErr: s.endErr}

    proc httpStreamEnd(s: HttpStream, endErr: text) -> HttpStream:
        let mut e = endErr
        if e == "" && (s.chunked || s.remaining > 0):
            e = "connection closed before the body was complete"
        return HttpStream{ok: s.ok, err: s.err, conn: s.conn, status: s.status, reason: s.reason, headers: s.headers, chunked: s.chunked, remaining: s.remaining, raw: s.raw, data: s.data, ended: true, endErr: e}

    # httpStreamDeframe: move every complete piece of body out of `raw`
    # into `data` — whole chunks of a chunked body (the zero chunk ends
    # it), up to Content-Length, or everything for a close-delimited body.
    proc httpStreamDeframe(s: HttpStream) -> HttpStream:
        if s.ended:
            return s
        if !s.chunked:
            if s.remaining < 0:
                return HttpStream{ok: s.ok, err: s.err, conn: s.conn, status: s.status, reason: s.reason, headers: s.headers, chunked: false, remaining: -1, raw: [], data: s.data + s.raw, ended: false, endErr: ""}
            let take = min(s.remaining, len(s.raw))
            let left = s.remaining - take
            return HttpStream{ok: s.ok, err: s.err, conn: s.conn, status: s.status, reason: s.reason, headers: s.headers, chunked: false, remaining: left, raw: [], data: s.data + httpBytesRange(s.raw, 0, take), ended: left == 0, endErr: ""}
        let raw = s.raw
        let mut data = s.data
        let mut p = 0
        let mut ended = false
        let mut bad = ""
        let mut more = true
        loop more:
            more = false
            let lineEnd = do httpFindCrlf(raw, p)
            if lineEnd >= 0:
                let mut size = 0
                let mut digits = 0
                let mut i = p
                let mut inExt = false
                loop i < lineEnd && bad == "":
                    let c = raw[i]
                    if c == 59:
                        inExt = true
                    if !inExt && c != 32 && c != 9:
                        let h = do httpHexValue(c)
                        if h < 0 || digits >= 15:
                            bad = "invalid chunk size"
                        size = size * 16 + h
                        digits = digits + 1
                    i = i + 1
                if digits == 0:
                    bad = "invalid chunk size"
                if bad == "":
                    let dataStart = lineEnd + 2
                    if size == 0:
                        # the trailer section, up to its empty line
                        let mut t = dataStart
                        let mut scanning = true
                        loop scanning:
                            let te = do httpFindCrlf(raw, t)
                            if te < 0:
                                scanning = false
                            else:
                                if te == t:
                                    ended = true
                                    p = te + 2
                                    scanning = false
                                else:
                                    t = te + 2
                    else:
                        if dataStart + size + 2 <= len(raw):
                            data = data + httpBytesRange(raw, dataStart, dataStart + size)
                            p = dataStart + size + 2
                            more = true
        let rest = do httpBytesRange(raw, p, len(raw))
        if bad != "":
            return HttpStream{ok: s.ok, err: s.err, conn: s.conn, status: s.status, reason: s.reason, headers: s.headers, chunked: true, remaining: s.remaining, raw: rest, data: data, ended: true, endErr: bad}
        return HttpStream{ok: s.ok, err: s.err, conn: s.conn, status: s.status, reason: s.reason, headers: s.headers, chunked: true, remaining: s.remaining, raw: rest, data: data, ended: ended, endErr: ""}

    # httpStreamPump: take in whatever has arrived — waiting at most waitMs
    # for the first byte, then only for what is already there.
    proc httpStreamPump(s: HttpStream, waitMs: int) -> HttpStream uses io.net:
        if s.ended || s.conn < 0:
            return s
        let mut cur = s
        let mut wait = waitMs
        let mut more = true
        loop more && !cur.ended:
            let chunk = pollBytes(cur.conn, 65536, wait)
            wait = 0
            if len(chunk) == 0:
                more = false
                if !connOpen(cur.conn):
                    cur = httpStreamEnd(httpStreamDeframe(cur), connError(cur.conn))
            else:
                cur = httpStreamDeframe(httpStreamWithRaw(cur, cur.raw + chunk))
        return cur

    proc httpStreamClose(s: HttpStream) -> bool uses io.net:
        if s.conn < 0:
            return false
        let closed = closeConn(s.conn)
        return closed

    # ── test drivers ──────────────────────────────────────────────────
    # httpOut: one exchange rendered as `status|reason|name=value;...|body`
    # (or `ERR|message`), for http_client_test.go.
    state httpOut: text = ""

    proc httpRender(r: HttpResponse) -> text:
        if !r.ok:
            return "ERR|" + r.err
        let mut hs = ""
        let n = len(r.headers)
        let mut i = 0
        loop i < n:
            if i > 0:
                hs = hs + ";"
            hs = hs + r.headers[i].name + "=" + r.headers[i].value
            i = i + 1
        return "" + r.status + "|" + r.reason + "|" + hs + "|" + r.body

    # headerLines: `name: value` lines separated by "\n".
    proc httpHeadersFromLines(lines: text) -> [HttpHeader]:
        let mut out = []
        if lines == "":
            return out
        let ls = split(lines, "\n")
        let n = len(ls)
        let mut i = 0
        loop i < n:
            let parts = split(ls[i], ": ")
            out = append(out, HttpHeader{name: parts[0], value: slice(ls[i], len(parts[0]) + 2, len(ls[i]))})
            i = i + 1
        return out

    proc httpRunOnce(method: text, url: text, headerLines: text, body: text, timeoutMs: int) -> text uses io.net:
        let hs = do httpHeadersFromLines(headerLines)
        let r = do httpExchange(HttpRequest{method: method, url: url, headers: hs, body: body, timeoutMs: timeoutMs})
        let out = do httpRender(r)
        return out

    proc httpRunTrustOnce(url: text, trustFile: text) -> text uses io.net:
        let r = do httpExchangeTrust(HttpRequest{method: "GET", url: url, headers: [], body: "", timeoutMs: 0}, trustFile)
        let out = do httpRender(r)
        return out

    action httpRunTrust(url: text, trustFile: text):
        let r = do httpRunTrustOnce(url, trustFile)
        httpOut = r

    action httpRun(method: text, url: text, headerLines: text, body: text, timeoutMs: int):
        let r = do httpRunOnce(method, url, headerLines, body, timeoutMs)
        httpOut = r

    # httpUrlParts: `ok|err|scheme|host|port|target` for one URL.
    proc httpUrlPartsText(url: text) -> text:
        let u = do httpParseUrl(url)
        return "" + u.ok + "|" + u.err + "|" + u.scheme + "|" + u.host + "|" + u.port + "|" + u.target

    action httpUrlParts(url: text):
        let r = do httpUrlPartsText(url)
        httpOut = r

    # httpEncodings: `percent|form` for one string.
    action httpEncodings(s: text):
        let p = do httpPercentEncode(s)
        let f = do httpFormEncode(s)
        httpOut = p + "|" + f

    # httpStreamRunOnce: open a stream and pump it until it ends (at most
    # `pumps` times, each waiting up to waitMs), recording each non-empty
    # pump's data as its own `[...]` piece: `status|pieces|ended|endErr`.
    proc httpStreamRunOnce(url: text, pumps: int, waitMs: int) -> text uses io.net:
        let s0 = do httpOpenStream(HttpRequest{method: "GET", url: url, headers: [HttpHeader{name: "accept", value: "text/event-stream"}], body: "", timeoutMs: 0})
        if !s0.ok:
            return "ERR|" + s0.err
        let mut s = s0
        let mut pieces = ""
        if len(s.data) > 0:
            pieces = pieces + "[" + bytesToText(s.data) + "]"
            s = httpStreamWithData(s, [])
        let mut i = 0
        loop i < pumps && !s.ended:
            s = httpStreamPump(s, waitMs)
            if len(s.data) > 0:
                pieces = pieces + "[" + bytesToText(s.data) + "]"
                s = httpStreamWithData(s, [])
            i = i + 1
        let closed = do httpStreamClose(s)
        return "" + s.status + "|" + pieces + "|" + s.ended + "|" + s.endErr

    action httpStreamRun(url: text, pumps: int, waitMs: int):
        let r = do httpStreamRunOnce(url, pumps, waitMs)
        httpOut = r
