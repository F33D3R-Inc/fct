{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Facet Definition Language",
  "scopeName": "source.fct",
  "patterns": [
    { "include": "#comment" },
    { "include": "#facet-decl" },
    { "include": "#block-keyword" },
    { "include": "#when" },
    { "include": "#control" },
    { "include": "#mutation" },
    { "include": "#who" },
    { "include": "#child" },
    { "include": "#interp" },
    { "include": "#string" },
    { "include": "#constant" }
  ],
  "repository": {
    "comment": {
      "match": "(^\\s*#.*$)",
      "name": "comment.line.number-sign.fct"
    },
    "facet-decl": {
      "match": "^\\s*\\b(facet)\\b\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.facet.fct" },
        "2": { "name": "entity.name.type.facet.fct" }
      }
    },
    "block-keyword": {
      "match": "^\\s*\\b(who|what|looks|facet-id|version|author)\\b\\s*:",
      "name": "keyword.control.block.fct"
    },
    "when": {
      "match": "^\\s*\\b(when)\\b",
      "name": "keyword.control.when.fct"
    },
    "control": {
      "match": "^\\s*\\b(if|else|for|in|slot)\\b",
      "name": "keyword.control.flow.fct"
    },
    "mutation": {
      "match": "^\\s*\\b(replace_all|replace|append|prepend|remove)\\b|\\b(with)\\b",
      "name": "keyword.other.mutation.fct"
    },
    "who": {
      "match": "\\b(require|redact|unless|always)\\b",
      "name": "keyword.other.authz.fct"
    },
    "child": {
      "match": "</?([A-Z][A-Za-z0-9_]*)",
      "captures": { "1": { "name": "entity.name.type.child.fct" } }
    },
    "interp": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.embedded.expression.fct",
      "patterns": [
        { "match": "\\b(if|else|end|for|in)\\b", "name": "keyword.control.flow.fct" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.fct" },
        { "include": "#string" }
      ]
    },
    "string": {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.fct"
    },
    "constant": {
      "match": "\\b(true|false|int|float|str|bool)\\b",
      "name": "constant.language.fct"
    }
  }
}
