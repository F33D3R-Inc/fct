{
  "name": "facet-architecture",
  "displayName": "Facet Architecture (FDL)",
  "description": "Syntax highlighting and live diagnostics for .fct (Facet Definition Language).",
  "version": "0.1.0",
  "publisher": "fct",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:fct"],
  "contributes": {
    "languages": [
      {
        "id": "fct",
        "aliases": ["Facet Definition Language", "FDL"],
        "extensions": [".fct"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "fct", "scopeName": "source.fct", "path": "./syntaxes/fct.tmLanguage.json" }
    ],
    "configuration": {
      "title": "Facet Architecture",
      "properties": {
        "fct.serverPath": {
          "type": "string",
          "default": "fct",
          "description": "Path to the fct binary (provides `fct lsp` for diagnostics)."
        }
      }
    }
  },
  "dependencies": { "vscode-languageclient": "^9.0.0" }
}
