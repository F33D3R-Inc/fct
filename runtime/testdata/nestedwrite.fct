app NestedWrite:
    # Writes through several levels of fields and list indexes: each is the
    # one-level writes composed (internal/parser desugarNestedWrite), with a
    # struct value copied on bind, so `keep` never sees them.
    struct Inner:
        c: int
        xs: [int]
    struct Mid:
        inner: Inner
        items: [Inner]
    struct Outer:
        mid: Mid
    proc main(args: [text]) -> int uses io.console:
        let mut o = Outer{mid: Mid{inner: Inner{c: 1, xs: [1, 2]}, items: [Inner{c: 5, xs: []}, Inner{c: 6, xs: [9]}]}}
        let keep = o
        o.mid.inner.c = 42
        o.mid.inner.xs[1] = 7
        o.mid.items[1].c = 60
        o.mid.items[0].xs = [3]
        writeStdout("" + o.mid.inner.c + " " + o.mid.inner.xs[1] + " " + o.mid.items[1].c + " " + len(o.mid.items[0].xs) + " " + keep.mid.inner.c + " " + keep.mid.items[1].c + "\n")
        return 0
