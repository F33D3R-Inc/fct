app ListenerLifecycle:
    # Listener lifecycle as values: a bind that fails answers listenError,
    # closeListener releases the port and ends a parked accept with a failed
    # connection handle — driven by runtime/listener_test.go.
    proc acceptOne(l: int, done: int) -> bool uses io.net.listen:
        let c = accept(l)
        let err = connError(c)
        send(done, "accepted:" + err)
        return true

    proc main(args: [text]) -> int uses io.net.listen, io.console:
        let port = toInt(args[0])
        let a = listenOn("127.0.0.1", port)
        writeStdout("first=" + listenError(a) + "\n")
        let b = listenOn("127.0.0.1", port)
        writeStdout("second=" + listenError(b) + "\n")
        writeStdout("closeFailed=" + closeListener(b) + "\n")
        let done = channel()
        detach acceptOne(a, done)
        sleepMs(100)
        writeStdout("close=" + closeListener(a) + "\n")
        writeStdout(recv(done) + "\n")
        writeStdout("closeAgain=" + closeListener(a) + "\n")
        let c = accept(a)
        writeStdout("later:" + connError(c) + "\n")
        let d = listenOn("127.0.0.1", port)
        writeStdout("rebind=" + listenError(d) + "\n")
        return 0
