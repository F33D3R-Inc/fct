app NestedWriteImmutable:
    struct Inner:
        c: int
    struct Outer:
        inner: Inner
    # The root of a nested write must be `let mut`, as for a one-level write.
    proc main(args: [text]) -> int:
        let o = Outer{inner: Inner{c: 1}}
        o.inner.c = 2
        return o.inner.c
