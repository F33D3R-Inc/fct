app GrantRead:
    # Read grants (runtime/grants.go): a file the operator named — an
    # argument or an environment variable — becomes readable outside the
    # sandbox once main grants it; anything else stays refused.
    proc main(args: [text]) -> int uses io.file, io.env, io.console:
        writeStdout("computed=" + grantRead(args[0] + "") + "\n")
        writeStdout("other=" + grantRead(args[1] + ".nope") + "\n")
        writeStdout("arg=" + grantRead(args[0]) + "\n")
        writeStdout("read=" + readFile(args[0]) + "\n")
        writeStdout("env=" + grantRead(envVar("GRANT_READ_TEST")) + "\n")
        writeStdout("envread=" + fileExists(envVar("GRANT_READ_TEST")) + "\n")
        writeStdout("empty=" + grantRead("") + "\n")
        let secret = readFile(args[1])
        return 0
