app ServiceOnStart:
    # A service (daemons, no main) whose daemon relies on state its `on
    # start` job set up: run by RunDaemons, the job must have run first.
    shared greeting: text

    proc configure():
        greeting = "configured"

    action setup:
        do configure()

    job setupJob on start -> setup

    daemon Report uses io.console:
        let g = greeting
        writeStdout("daemon saw: " + g + "\n")
