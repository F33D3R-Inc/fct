# envSet tells an unset environment variable from one set to "" — the
# distinction std::env::var draws and envVar alone cannot.
app EnvSet:
    state result: text = ""

    proc probe(name: text) -> text uses io.env:
        return "" + envSet(name) + "|" + envVar(name)

    action check(name: text):
        let r = do probe(name)
        result = r

    view Home at "/":
        box:
            text "{result}"
