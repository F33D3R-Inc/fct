app P:
    struct Inner:
        c: int
        tag: text
    struct Mid:
        inner: Inner
    struct Outer:
        a: int
        mid: Mid
    proc bump(o: Outer) -> Outer:
        let mut next = o
        let mut mid = o.mid
        let mut inner = o.mid.inner
        inner.c = inner.c + 10
        inner.tag = inner.tag + "!"
        mid.inner = inner
        next.mid = mid
        return next
    proc run() -> text:
        let o = Outer{a: 1, mid: Mid{inner: Inner{c: 2, tag: "t"}}}
        let b = do bump(o)
        let mut i2 = b.mid.inner
        i2.c = 99
        return "" + o.mid.inner.c + o.mid.inner.tag + " " + b.mid.inner.c + b.mid.inner.tag + " " + i2.c
    state got: text = ""
    action go():
        let r = do run()
        got = r
    view Home at "/":
        text "{got}"
