app StdioMain:
    # A command: echoes its arguments to stdout, reports stdin's size on
    # stderr, and exits with the argument count.
    proc main(args: [text]) -> int uses io.console:
        let input = readStdin()
        let mut i = 0
        loop i < len(args):
            writeStdout("arg " + i + "=" + args[i] + "\n")
            i = i + 1
        writeStderr("stdin:" + input + "\n")
        return len(args)
