app ListenerUnboundAccept:
    # accept() on a listener that never bound is a programming error: it
    # aborts, naming why the bind failed.
    proc main(args: [text]) -> int uses io.net.listen:
        let port = toInt(args[0])
        let a = listenOn("127.0.0.1", port)
        let b = listenOn("127.0.0.1", port)
        let c = accept(b)
        return 0
