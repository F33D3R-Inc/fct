app StdioSignals:
    # A command that waits for a signal, then reports the wall clock in ms.
    proc main(args: [text]) -> int uses io.console:
        let sig = signals()
        let before = nowMs()
        writeStdout("ready\n")
        let got = recv(sig)
        let after = nowMs()
        if after < before:
            return 2
        writeStdout(got + " " + before + "\n")
        return 0
