app StdioServer:
    # A command that serves: main listens, hands each of two connections to a
    # detached handler, then waits for both to report back over a channel.
    proc serve(c: int, done: int) -> bool uses io.net.listen:
        let data = readBytes(c, 64)
        writeBytes(c, data)
        closeConn(c)
        send(done, "served")
        return true

    proc main(args: [text]) -> int uses io.net.listen, io.console:
        let l = listenOn("127.0.0.1", toInt(args[0]))
        writeStdout("listening\n")
        let done = channel()
        let mut n = 0
        loop n < 2:
            let c = accept(l)
            detach serve(c, done)
            n = n + 1
        let a = recv(done)
        let b = recv(done)
        writeStdout(a + " " + b + "\n")
        return 0
