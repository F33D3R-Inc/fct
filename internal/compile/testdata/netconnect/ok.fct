# connect + connection I/O in an ordinary proc declaring io.net; the same
# connection builtins under io.net.listen in a daemon.
app A:
    state result: text = ""
    proc fetch(host: text, port: int) -> text uses io.net:
        let c = connect(host, port)
        let tc = connectTls(host, port, "", "")
        let tclosed = closeConn(tc)
        let t = setTimeoutMs(c, 500)
        let w = writeBytes(c, textToBytes("ping"))
        let b = readBytes(c, 64)
        let more = pollBytes(c, 64, 10)
        let open = connOpen(c)
        let e = connError(c)
        let x = closeConn(c)
        return bytesToText(b) + e
    daemon Echo uses io.net.listen:
        let l = listen(7391)
        loop true:
            let c = accept(l)
            let b = readBytes(c, 64)
            let w = writeBytes(c, b)
            let x = closeConn(c)
    action run(host: text, port: int):
        let r = do fetch(host, port)
        result = r
    view Home at "/":
        box:
            text "{result}"
