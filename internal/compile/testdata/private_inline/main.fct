import "helper.fct"

app PrivateInlineMain:
    # Declares its own file-local `twice`, with a different body: the two
    # private helpers must stay distinct once both files are merged.
    private proc twice(n: int) -> int:
        return n + n + 100

    state result: int = 0

    action run(n: int):
        let r = do helperResult(n)
        result = r + twice(0)
