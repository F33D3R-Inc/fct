app Nested:
    # A chain of detaches from a daemon: outer detaches inner; both are
    # daemon-context, so inner may accept and outer may detach.
    proc handle(c: int) -> bool uses io.net.listen:
        closeConn(c)
        return true

    proc inner(l: int) -> bool uses io.net.listen:
        loop true:
            let c = accept(l)
            detach handle(c)
        return true

    proc outer(port: int) -> bool uses io.net.listen:
        let l = listen(port)
        detach inner(l)
        return true

    daemon Start uses io.net.listen:
        detach outer(7999)
