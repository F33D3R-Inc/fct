app AlsoCalled:
    # acceptLoop is detached from main, but an action also runs it with `do`,
    # so it is an ordinary proc and may not accept.
    proc acceptLoop(l: int) -> bool uses io.net.listen:
        loop true:
            let c = accept(l)
            closeConn(c)
        return true

    action poke(l: int):
        do acceptLoop(l)

    proc main(args: [text]) -> int uses io.net.listen:
        let l = listenOn("127.0.0.1", 1)
        detach acceptLoop(l)
        return 0
